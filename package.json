{
  "name": "company-hub",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "node scripts/start-standalone.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:platform-control-plane": "playwright test --config tests/e2e/platform-control-plane.config.ts",
    "test:e2e:agency": "tsx scripts/run-agency-e2e.ts",
    "test:e2e:restaurant-integrated": "tsx scripts/run-restaurant-e2e.ts",
    "test:e2e:pharmacy-counter": "tsx scripts/run-pharmacy-e2e.ts",
    "test:rls": "tsx scripts/verify-tenant-isolation.ts",
    "report:email-collisions": "tsx scripts/report-email-collisions.ts",
    "db:generate": "bunx prisma generate",
    "db:push": "bun -e \"console.error('Disabled: this schema has migration-only RLS and composite constraints. Use prisma migrate deploy/dev.'); process.exit(1)\"",
    "db:migrate": "bunx prisma migrate dev",
    "db:seed": "bunx prisma db seed",
    "demo:seed": "tsx --tsconfig=scripts/tsconfig.json prisma/seed-demo/restaurant.ts",
    "db:studio": "bunx prisma studio",
    "db:reset": "bunx prisma migrate reset",
    "assistant:eval": "tsx scripts/assistant-eval.ts",
    "assistant:diag": "tsx scripts/assistant-diag.ts",
    "email:smoke": "tsx scripts/email-smoke.ts",
    "platform:jobs": "tsx --tsconfig scripts/tsconfig.json scripts/process-platform-jobs.ts",
    "restaurant:jobs": "tsx --tsconfig scripts/tsconfig.json scripts/run-restaurant-jobs.ts",
    "restaurant:print-bridge": "tsx --tsconfig scripts/tsconfig.json scripts/print-bridge.ts"
  },
  "prisma": {
    "seed": "bunx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@ai-sdk/azure": "^3",
    "@ai-sdk/google": "^3.0.89",
