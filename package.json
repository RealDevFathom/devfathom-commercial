    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@tanstack/react-query": "^5.97.0",
    "@tanstack/react-virtual": "^3.14.3",
    "@testing-library/dom": "^10.4.1",
