{
  "name": "company-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n web,api -c blue,green \"bun run dev:web\" \"bun run dev:api\"",
    "dev:web": "nuxt dev",
    "dev:api": ".venv/bin/python -m uvicorn backend.app.main:app --reload --port 8000",
    "build": "nuxt build && python3 -m compileall -q backend/app",
    "start": "concurrently -n web,api -c blue,green \"node .output/server/index.mjs\" \".venv/bin/python -m uvicorn backend.app.main:app --host 0.0.0.0 --port 8000\"",
    "typecheck": "nuxt typecheck",
    "lint": "nuxt typecheck && .venv/bin/python -m ruff check backend",
    "format": "prettier --write \"app/**/*.{ts,vue,css}\" nuxt.config.ts package.json vercel.json && .venv/bin/python -m ruff format backend",
    "format:check": "prettier --check \"app/**/*.{ts,vue,css}\" nuxt.config.ts package.json vercel.json && .venv/bin/python -m ruff format --check backend",
    "api:install": "python3 -m venv .venv && .venv/bin/python -m pip install -r backend/requirements.txt",
    "api:test": ".venv/bin/python -m pytest backend/tests",
    "api:docs": ".venv/bin/python -m uvicorn backend.app.main:app --port 8000",
    "perf:db-topology": ".venv/bin/python scripts/performance/database/topology_audit.py",
    "perf:db-topology:test": ".venv/bin/python -m pytest tests/performance/database",
    "perf:smoke": "bun scripts/performance/perf-smoke.ts",
    "test": "bun test tests && bun run api:test",
    "verify": "bun run format:check && bun run lint && bun run test && bun run build"
  },
  "dependencies": {
    "@nuxtjs/color-mode": "^4.0.1",
    "ably": "^2.22.1",
    "lucide-vue-next": "^1.0.0",
    "nuxt": "^4.4.8",
    "vue": "^3.5.39"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.1",
    "@types/node": "^26.1.1",
    "concurrently": "^10.0.3",
    "prettier": "^3.9.5",
    "tailwindcss": "^4.3.1",
    "typescript": "~5.9.3",
    "vue-tsc": "^3.3.7"
  }
}
