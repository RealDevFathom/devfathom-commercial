    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "jsdom": "29.0.0",
    "prettier": "^3.8.2",
    "shadcn": "^4.2.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "4.1.10"
