gateway cannot participate in POS/KDS trust relations.\nmodel RestaurantCameraGateway {\n  id                String    @id @default(cuid())\n  organizationId    String    @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId          String\n  name              String\n  gatewaySecretHash String    @unique\n  status            String    @default(\"ACTIVE\")\n  revokedAt         DateTime?\n  lastSeenAt        DateTime?\n  baseUrl           String\n  retentionDays     Int       @default(7)\n  createdAt         DateTime  @default(now())\n  updatedAt         DateTime  @updatedAt\n\n  @@index([organizationId, branchId])\n  @@map(\"restaurant_camera_gateways\")\n}\n\nmodel RestaurantCameraCredential {\n  id             String    @id @default(cuid())\n  organizationId String    @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  sealedValue    String\n  version        Int       @default(1)\n  rotatedAt      DateTime?\n  createdAt      DateTime  @default(now())\n  updatedAt      DateTime  @updatedAt\n\n  @@index([organizationId])\n  @@map(\"restaurant_camera_credentials\")\n}\n\nmodel RestaurantCamera {\n  id             String    @id @default(cuid())\n  organizationId String    @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  gatewayId      String\n  branchId       String\n  credentialId   String\n  name           String\n  sourceRef      String\n  enabled        Boolean   @default(true)\n  lastSeenAt     DateTime?\n  createdAt      DateTime  @default(now())\n  updatedAt      DateTime  @updatedAt\n\n  @@index([organizationId, branchId])\n  @@index([gatewayId])\n  @@map(\"restaurant_cameras\")\n}\n\nmodel RestaurantCameraStreamGrant {\n  id             String    @id @default(cuid())\n  organizationId String    @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  cameraId       String\n  viewerId       String\n  expiresAt      DateTime\n  revokedAt      DateTime?\n  createdAt      DateTime  @default(now())\n\n  @@index([organizationId, cameraId, viewerId])\n  @@index([expiresAt])\n  @@map(\"restaurant_camera_stream_grants\")\n}\n\nmodel PlatformCameraBrandPreset {\n  id                     String   @id @default(cuid())\n  key                    String   @unique\n  familyName             String\n  aliases                String[]\n  iconKey                String\n  rtspPort               Int      @default(554)\n  onvifPort              Int      @default(80)\n  mainStreamPathTemplate String\n  subStreamPathTemplate  String\n  authSchemeHint         String\n  defaultUsernameHint    String?\n  credentialNote         String\n  setupNote              String\n  active                 Boolean  @default(true)\n  sortOrder              Int      @default(0)\n  createdAt              DateTime @default(now())\n  updatedAt              DateTime @updatedAt\n\n  @@index([active, sortOrder])\n  @@map(\"platform_camera_brand_presets\")\n}\n\ndatasource db {\n  provider = \"postgresql\"\n}\n\nenum PharmacyProductFamily {\n  PHARMACEUTICAL\n  BIOLOGICAL\n  DEVICE\n  ALTERNATIVE\n  FRONT_SHOP\n}\n\nenum MedicineProvenanceStatus {\n  UNREVIEWED\n  ACCEPTED\n  CORRECTED\n  REJECTED\n  SUPERSEDED\n}\n\n/// SAFE-01: platform-owned, effective-dated jurisdiction configuration. The\n/// JSON rule fields retain per-value provenance (\\`provisional\\` + \\`toConfirm\\`)\n/// instead of turning unconfirmed counsel assumptions into permissive enums.\nmodel JurisdictionRuleSet {\n  id                        String    @id @default(cuid())\n  code                      String\n  version                   Int\n  effectiveFrom             DateTime\n  effectiveTo               DateTime?\n  licenceCategories         Json\n  permittedSchedules        Json\n  prescriptionOnlyClasses   Json\n  prescriptionRetentionDays Json\n  controlledRegisterFlags   Json\n  pharmacistCoverageRule    Json\n  recordRetentionByClass    Json\n  createdAt                 DateTime  @default(now())\n\n  regulatoryProfiles BranchRegulatoryProfile[]\n\n  @@unique([code, version])\n  @@index([code, effectiveFrom, effectiveTo])\n  @@map(\"pharmacy_jurisdiction_rule_sets\")\n}\n\n/// PLAT-02: an immutable effective-dated snapshot for one branch. PLAT-04 turns\n/// \\`branchId\\` from a bare scope seam into a foreign key onto {@link PharmacyBranch};\n/// it is still never accepted without the tenant-scoped organizationId.\nmodel BranchRegulatoryProfile {\n  id                               String    @id @default(cuid())\n  organizationId                   String    @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId                         String\n  version                          Int\n  effectiveFrom                    DateTime\n  effectiveTo                      DateTime?\n  provinceCode                     String\n  jurisdictionRuleSetId            String\n  premises                         Json\n  licenceCategory                  String\n  licenceNumber                    String\n  licenceValidFrom                 DateTime\n  licenceValidTo                   DateTime\n  licenceEvidenceFileRef           String\n  permittedSchedules               String[]\n  qualifiedPersonRegistration      String\n  qualifiedPersonValidFrom         DateTime\n  qualifiedPersonValidTo           DateTime\n  qualifiedPersonCoverageRosterRef String\n  ntn                              String?\n  strn                             String?\n  fiscalStatus                     String\n  retentionPolicy                  Json\n  createdAt                        DateTime  @default(now())\n\n  jurisdictionRuleSet JurisdictionRuleSet @relation(fields: [jurisdictionRuleSetId], references: [id], onDelete: Restrict)\n  branch              PharmacyBranch      @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)\n\n  @@unique([organizationId, branchId, version])\n  @@index([organizationId, branchId, effectiveFrom, effectiveTo])\n  @@index([jurisdictionRuleSetId])\n  @@map(\"pharmacy_branch_regulatory_profiles\")\n}\n\n/// PLAT-04 \\u2014 the pharmacy branch aggregate. Every branch-owned pharmacy record\n/// (regulatory profile, stock location, inventory lot, requisition, purchase\n/// order) references it by the composite (organizationId, id), so a branch id\n/// borrowed from another tenant fails the foreign key in the database rather\n/// than being filtered out by a router that might forget the predicate.\n/// \\`organizationId\\` remains the tenant boundary under FORCE row-level security;\n/// the branch is a scope *inside* that boundary, never a substitute for it.\nmodel PharmacyBranch {\n  id                     String  @id @default(cuid())\n  organizationId         String  @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  code                   String\n  name                   String\n  addressLine            String\n  city                   String\n  provinceCode           String\n  active                 Boolean @default(true)\n  /// The stock location a branch-scoped operation defaults to. Nullable because\n  /// a branch is created before its locations exist. The database constrains it\n  /// to a location of *this* branch, via a composite foreign key on\n  /// (organizationId, id, defaultStockLocationId) \\u2014 expressed in SQL only,\n  /// because modelling it as a Prisma relation would make \\`id\\` a relation\n  /// scalar of this model and break ordinary writes to it.\n  defaultStockLocationId String?\n\n  createdAt DateTime @default(now())\n  updatedAt DateTime @updatedAt\n\n  regulatoryProfiles       BranchRegulatoryProfile[]\n  stockLocations           PharmacyStockLocation[]           @relation(\"PharmacyBranchStockLocations\")\n  inventoryLots            PharmacyInventoryLot[]\n  requisitions             PharmacyRequisition[]\n  purchaseOrders           PharmacyPurchaseOrder[]\n  onboardingGates          PharmacyOnboardingGateState[]\n  registeredDevices        PharmacyRegisteredDevice[]\n  ownerDigestSettings      PharmacyOwnerDigestSetting[]\n  ownerDigestCaptures      PharmacyOwnerDigestCapture[]\n  refillReminderCaptures   PharmacyRefillReminderCapture[]\n  pharmacovigilanceReports PharmacyPharmacovigilanceReport[]\n  customerOrders           PharmacyCustomerOrder[]\n\n  @@unique([organizationId, id], map: \"pharmacy_branches_org_id_key\")\n  @@unique([organizationId, code], map: \"pharmacy_branches_org_code_key\")\n  @@index([organizationId, active], map: \"pharmacy_branches_org_active_idx\")\n  @@map(\"pharmacy_branches\")\n}\n\n/// INV-10 \\u2014 the deliberately narrow doorway into the chain purchasing view.\n/// A null branch grants this user the organization view; a non-null branch\n/// grants only that branch. It is not consulted by any other pharmacy screen.\nmodel PharmacyCentralPurchasingAccess {\n  id             String   @id @default(cuid())\n  organizationId String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  userId         String\n  branchId       String?\n  grantedById    String\n  createdAt      DateTime @default(now())\n\n  @@unique([organizationId, id], map: \"pharmacy_central_purchasing_access_org_id_key\")\n  @@index([organizationId, userId, branchId], map: \"pharmacy_central_purchasing_access_scope_idx\")\n  @@map(\"pharmacy_central_purchasing_access\")\n}\n\n/// INV-10 \\u2014 allocation evidence only. Physical custody remains exclusively in\n/// the INV-07 transfer and stock-movement tables named here.\nmodel PharmacyCentralPurchaseAllocation {\n  id                  String   @id @default(cuid())\n  organizationId      String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  sourceBranchId      String\n  destinationBranchId String\n  goodsReceiptLineId  String\n  transferId          String\n  transferLineId      String\n  quantityUnits       Int\n  allocatedById       String\n  createdAt           DateTime @default(now())\n\n  @@unique([organizationId, id], map: \"pharmacy_central_purchase_allocations_org_id_key\")\n  @@unique([organizationId, goodsReceiptLineId, destinationBranchId], map: \"pharmacy_central_purchase_allocations_once_key\")\n  @@index([organizationId, sourceBranchId, createdAt], map: \"pharmacy_central_purchase_allocations_source_idx\")\n  @@index([organizationId, destinationBranchId, createdAt], map: \"pharmacy_central_purchase_allocations_destination_idx\")\n  @@map(\"pharmacy_central_purchase_allocations\")\n}\n\n/// PLAT-03 \\u2014 the twelve onboarding steps of PRD \\xA76.1, in the order the operator\n/// walks them.\nenum PharmacyOnboardingGate {\n  ORG_TYPE\n  LEGAL_BUSINESS\n  LAUNCH_JURISDICTION\n  PREMISES_AND_LICENCES\n  BRANCHES_AND_LOCATIONS\n  COMMERCIAL_PACKAGE\n  OWNER_AND_ROLE_TEMPLATES\n  MEDICINE_CATALOG_READINESS\n  OPENING_STOCK_READINESS\n  PARTIES_AND_BALANCES\n  DEVICES_AND_DOCUMENTS\n  READINESS_AND_PARALLEL_RUN\n}\n\nenum PharmacyOnboardingGateStatus {\n  NOT_STARTED\n  IN_PROGRESS\n  PASSED\n  FAILED\n}\n\n/// PLAT-03 \\u2014 one onboarding record per organization. The row itself carries no\n/// readiness verdict: readiness is always recomputed by\n/// \\`evaluatePharmacyReadiness\\`, so a stored row can never assert a readiness the\n/// underlying data does not support.\nmodel PharmacyOnboardingState {\n  id             String   @id @default(cuid())\n  organizationId String   @unique @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  startedAt      DateTime @default(now())\n  updatedAt      DateTime @updatedAt\n\n  organization Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)\n  gates        PharmacyOnboardingGateState[]\n  events       PharmacyOnboardingEvent[]\n\n  @@map(\"pharmacy_onboarding_states\")\n}\n\n/// PLAT-03 \\u2014 the latest recorded status of one gate. This is a *claim*, not a\n/// verdict: \\`evaluatePharmacyReadiness\\` downgrades any PASSED claim the evidence\n/// does not support, which is what stops seed or bootstrap data faking readiness.\nmodel PharmacyOnboardingGateState {\n  id             String                       @id @default(cuid())\n  organizationId String                       @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  gate           PharmacyOnboardingGate\n  status         PharmacyOnboardingGateStatus @default(NOT_STARTED)\n  /// Where the operator's evidence for this claim lives. Required for a PASSED\n  /// claim on a gate the platform cannot verify from data.\n  evidenceRef    String?\n  /// The branch a branch-specific gate was recorded against, if any.\n  branchId       String?\n  actorId        String?\n  recordedAt     DateTime?\n  createdAt      DateTime                     @default(now())\n  updatedAt      DateTime                     @updatedAt\n\n  state  PharmacyOnboardingState @relation(fields: [organizationId], references: [organizationId], onDelete: Cascade)\n  branch PharmacyBranch?         @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)\n\n  @@unique([organizationId, gate], map: \"pharmacy_onboarding_gate_states_org_gate_key\")\n  @@index([organizationId, status], map: \"pharmacy_onboarding_gate_states_org_status_idx\")\n  @@map(\"pharmacy_onboarding_gate_states\")\n}\n\n/// PLAT-03 \\u2014 the append-only transition log. Enforced append-only by trigger, so\n/// an onboarding history cannot be rewritten to look cleaner than it was.\nmodel PharmacyOnboardingEvent {\n  id             String                        @id @default(cuid())\n  organizationId String                        @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  gate           PharmacyOnboardingGate\n  fromStatus     PharmacyOnboardingGateStatus?\n  toStatus       PharmacyOnboardingGateStatus\n  evidenceRef    String?\n  actorId        String\n  note           String?\n  occurredAt     DateTime                      @default(now())\n\n  state PharmacyOnboardingState @relation(fields: [organizationId], references: [organizationId], onDelete: Cascade)\n\n  @@index([organizationId, gate, occurredAt], map: \"pharmacy_onboarding_events_org_gate_occurred_idx\")\n  @@map(\"pharmacy_onboarding_events\")\n}\n\nenum MedicineProvenanceSourceType {\n  REGULATOR\n  MANUFACTURER\n  SCRAPED\n  USER\n  IMPORT\n}\n\nenum MedicineBarcodeType {\n  GTIN\n  MANUFACTURER\n  INTERNAL\n}\n\nenum MedicineAliasType {\n  BRAND\n  GENERIC\n  URDU\n  TRANSLITERATION\n  LEGACY_CODE\n}\n\nenum MedicineReviewAction {\n  ACCEPT\n  CORRECT\n  SPLIT\n  MERGE\n  REJECT\n  DEFER\n}\n\nenum MedicinePublicationBatchStatus {\n  DRAFT\n  PUBLISHED\n  SUPERSEDED\n}\n\nenum PharmacyReferenceConnectorAdapter {\n  MANUAL_FILE\n}\n\nenum PharmacyReferenceConnectorRunStatus {\n  RUNNING\n  COMPLETED\n  FAILED\n}\n\nenum PharmacyReferenceProposalStatus {\n  PENDING\n  CONFIRMED\n  REJECTED\n}\n\nmodel Ingredient {\n  id             String                      @id @default(cuid())\n  organizationId String                      @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  name           String\n  createdAt      DateTime                    @default(now())\n  updatedAt      DateTime                    @updatedAt\n  strengths      MedicineStrengthComponent[]\n\n  @@unique([organizationId, name])\n  @@index([organizationId])\n  @@map(\"pharmacy_ingredients\")\n}\n\nmodel Medicine {\n  id                           String                               @id @default(cuid())\n  organizationId               String                               @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  productName                  String\n  brandName                    String?\n  manufacturer                 String?\n  marketingAuthorizationHolder String?\n  drapRegistrationNumber       String?\n  drapRegistrationStatus       String?\n  drapRegisteredAt             DateTime?\n  productFamily                PharmacyProductFamily\n  rx                           Boolean                              @default(false)\n  otc                          Boolean                              @default(false)\n  restricted                   Boolean                              @default(false)\n  controlled                   Boolean                              @default(false)\n  highAlert                    Boolean                              @default(false)\n  lasa                         Boolean                              @default(false)\n  coldChain                    Boolean                              @default(false)\n  saleable                     Boolean                              @default(false)\n  createdAt                    DateTime                             @default(now())\n  updatedAt                    DateTime                             @updatedAt\n  strengths                    MedicineStrengthComponent[]\n  presentations                Presentation[]\n  provenance                   MedicineProvenance[]\n  requisitionLines             PharmacyRequisitionLine[]\n  purchaseOrderLines           PharmacyPurchaseOrderLine[]\n  prescriptionLines            PrescriptionLine[]\n  aliases                      MedicineAlias[]\n  // PH-INV/INV-01: the manufacturing batches this medicine has been supplied in.\n  batches                      PharmacyManufacturingBatch[]\n  // PUR-02 receiving: the receipt lines this medicine has arrived on.\n  goodsReceiptLines            PharmacyGoodsReceiptLine[]\n  saleLines                    PharmacySaleLine[]\n  unfulfilledDemandEvents      UnfulfilledDemandEvent[]\n  // PUR-07: the approved replenishment policy and the signals it produces.\n  safetyStocks                 PharmacySafetyStock[]\n  stockSignals                 PharmacyStockSignal[]\n  pharmacovigilanceReports     PharmacyPharmacovigilanceReport[]\n  priceChangeProposals         PharmacyPriceChangeProposal[]\n  connectorProposals           PharmacyReferenceConnectorProposal[]\n  customerOrderLines           PharmacyCustomerOrderLine[]\n\n  @@unique([organizationId, id], map: \"pharmacy_medicines_org_id_key\")\n  @@index([organizationId, productName])\n  @@map(\"pharmacy_medicines\")\n}\n\nmodel MedicineStrengthComponent {\n  id             String     @id @default(cuid())\n  organizationId String     @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  medicineId     String\n  ingredientId   String\n  value          Decimal    @db.Decimal(18, 6)\n  unit           String\n  createdAt      DateTime   @default(now())\n  medicine       Medicine   @relation(fields: [medicineId], references: [id], onDelete: Restrict)\n  ingredient     Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)\n\n  @@unique([medicineId, ingredientId, value, unit])\n  @@index([organizationId, medicineId])\n  @@map(\"pharmacy_medicine_strength_components\")\n}\n\nmodel Presentation {\n  id                 String                      @id @default(cuid())\n  organizationId     String                      @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  medicineId         String\n  dosageForm         String?\n  route              String?\n  presentation       String\n  createdAt          DateTime                    @default(now())\n  updatedAt          DateTime                    @updatedAt\n  medicine           Medicine                    @relation(fields: [medicineId], references: [id], onDelete: Restrict)\n  packLevels         PackLevel[]\n  barcodes           MedicineBarcode[]\n  prescriptionLines  PrescriptionLine[]\n  pharmacySaleLines  PharmacySaleLine[]\n  customerOrderLines PharmacyCustomerOrderLine[]\n\n  @@index([organizationId, medicineId])\n  @@map(\"pharmacy_presentations\")\n}\n\nmodel PackLevel {\n  id                    String                      @id @default(cuid())\n  organizationId        String                      @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  presentationId        String\n  parentPackLevelId     String?\n  versionGroupId        String\n  version               Int\n  level                 String\n  unitsPerParent        Int\n  effectiveFrom         DateTime\n  effectiveTo           DateTime?\n  referencedAt          DateTime?\n  supersedesPackLevelId String?\n  createdAt             DateTime                    @default(now())\n  presentation          Presentation                @relation(fields: [presentationId], references: [id], onDelete: Restrict)\n  parent                PackLevel?                  @relation(\"PackHierarchy\", fields: [parentPackLevelId], references: [id], onDelete: Restrict)\n  children              PackLevel[]                 @relation(\"PackHierarchy\")\n  supersedes            PackLevel?                  @relation(\"PackVersions\", fields: [supersedesPackLevelId], references: [id], onDelete: Restrict)\n  supersededBy          PackLevel[]                 @relation(\"PackVersions\")\n  printedMrps           MedicinePackMrp[]\n  requisitionLines      PharmacyRequisitionLine[]\n  purchaseOrderLines    PharmacyPurchaseOrderLine[]\n  goodsReceiptLines     PharmacyGoodsReceiptLine[]\n  barcodes              MedicineBarcode[]\n  // PH-INV/INV-01: receiving a lot against this conversion is what stamps\n  // \\`referencedAt\\` and freezes it (MED-02, \\xA78A invariant 2).\n  inventoryLots         PharmacyInventoryLot[]\n  saleLines             PharmacySaleLine[]\n  customerOrderLines    PharmacyCustomerOrderLine[]\n\n  @@unique([organizationId, id], map: \"pharmacy_pack_levels_org_id_key\")\n  @@unique([organizationId, versionGroupId, version])\n  @@index([organizationId, presentationId])\n  @@map(\"pharmacy_pack_levels\")\n}\n\nmodel MedicinePackMrp {\n  id                     String    @id @default(cuid())\n  organizationId         String    @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  packLevelId            String\n  batchReference         String\n  printedMrpMinor        Int\n  roundingIncrementMinor Int       @default(1)\n  createdAt              DateTime  @default(now())\n  packLevel              PackLevel @relation(fields: [packLevelId], references: [id], onDelete: Restrict)\n\n  @@unique([organizationId, packLevelId, batchReference])\n  @@index([organizationId, batchReference])\n  @@map(\"pharmacy_medicine_pack_mrps\")\n}\n\nmodel MedicineProvenance {\n  id                 String                       @id @default(cuid())\n  organizationId     String                       @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  medicineId         String\n  field              String\n  source             String\n  sourceType         MedicineProvenanceSourceType\n  retrievedAt        DateTime\n  confidence         Decimal?                     @db.Decimal(5, 4)\n  reviewer           String?\n  status             MedicineProvenanceStatus\n  supersedesId       String?\n  assertedValue      Json?\n  createdAt          DateTime                     @default(now())\n  medicine           Medicine                     @relation(fields: [medicineId], references: [id], onDelete: Restrict)\n  supersedes         MedicineProvenance?          @relation(\"ProvenanceVersions\", fields: [supersedesId], references: [id], onDelete: Restrict)\n  supersededBy       MedicineProvenance[]         @relation(\"ProvenanceVersions\")\n  publicationEntries MedicinePublicationEntry[]\n\n  @@index([organizationId, medicineId, field])\n  @@map(\"pharmacy_medicine_provenance\")\n}\n\nmodel MedicineBarcode {\n  id             String              @id @default(cuid())\n  organizationId String              @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  presentationId String\n  packLevelId    String?\n  type           MedicineBarcodeType\n  code           String\n  normalizedCode String\n  createdAt      DateTime            @default(now())\n  presentation   Presentation        @relation(fields: [presentationId], references: [id], onDelete: Restrict)\n  packLevel      PackLevel?          @relation(fields: [packLevelId], references: [id], onDelete: Restrict)\n\n  @@unique([organizationId, normalizedCode])\n  @@index([organizationId, presentationId])\n  @@map(\"pharmacy_medicine_barcodes\")\n}\n\nmodel MedicineAlias {\n  id              String            @id @default(cuid())\n  organizationId  String            @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  medicineId      String\n  type            MedicineAliasType\n  value           String\n  normalizedValue String\n  createdAt       DateTime          @default(now())\n  medicine        Medicine          @relation(fields: [medicineId], references: [id], onDelete: Restrict)\n\n  @@unique([organizationId, medicineId, type, normalizedValue])\n  @@index([organizationId, normalizedValue])\n  @@map(\"pharmacy_medicine_aliases\")\n}\n\nmodel MedicineReviewDecision {\n  id             String               @id @default(cuid())\n  organizationId String               @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  duplicateKey   String\n  action         MedicineReviewAction\n  medicineIds    String[]\n  payload        Json?\n  reviewerId     String\n  createdAt      DateTime             @default(now())\n\n  @@index([organizationId, duplicateKey, createdAt])\n  @@map(\"pharmacy_medicine_review_decisions\")\n}\n\nmodel MedicinePublicationBatch {\n  id             String                         @id @default(cuid())\n  organizationId String                         @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  status         MedicinePublicationBatchStatus @default(DRAFT)\n  publishedBy    String?\n  publishedAt    DateTime?\n  supersedesId   String?\n  createdAt      DateTime                       @default(now())\n  entries        MedicinePublicationEntry[]\n  supersedes     MedicinePublicationBatch?      @relation(\"PublicationBatchVersions\", fields: [supersedesId], references: [id], onDelete: Restrict)\n  supersededBy   MedicinePublicationBatch[]     @relation(\"PublicationBatchVersions\")\n\n  @@index([organizationId, createdAt])\n  @@map(\"pharmacy_medicine_publication_batches\")\n}\n\nmodel MedicinePublicationEntry {\n  id               String                   @id @default(cuid())\n  organizationId   String                   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  batchId          String\n  assertionId      String\n  priorAssertionId String?\n  createdAt        DateTime                 @default(now())\n  batch            MedicinePublicationBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)\n  assertion        MedicineProvenance       @relation(fields: [assertionId], references: [id], onDelete: Restrict)\n\n  @@unique([organizationId, batchId, assertionId])\n  @@index([organizationId, batchId])\n  @@map(\"pharmacy_medicine_publication_entries\")\n}\n\nmodel PharmacyReferenceConnector {\n  id             String                               @id @default(cuid())\n  organizationId String                               @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  key            String\n  label          String\n  adapter        PharmacyReferenceConnectorAdapter    @default(MANUAL_FILE)\n  enabled        Boolean                              @default(true)\n  schedule       Json\n  cursor         Json?\n  lastRunState   PharmacyReferenceConnectorRunStatus?\n  lastRunAt      DateTime?\n  createdBy      String\n  createdAt      DateTime                             @default(now())\n  updatedAt      DateTime                             @updatedAt\n  runs           PharmacyReferenceConnectorRun[]\n\n  @@unique([organizationId, id], map: \"pharmacy_reference_connectors_org_id_key\")\n  @@unique([organizationId, key], map: \"pharmacy_reference_connectors_org_key_key\")\n  @@index([organizationId, enabled], map: \"pharmacy_reference_connectors_org_enabled_idx\")\n  @@map(\"pharmacy_reference_connectors\")\n}\n\nmodel PharmacyReferenceConnectorRun {\n  id                      String                               @id @default(cuid())\n  organizationId          String                               @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  connectorId             String\n  inputDigest             String\n  batchId                 String\n  fileName                String\n  status                  PharmacyReferenceConnectorRunStatus  @default(RUNNING)\n  triggerKind             String\n  triggeredBy             String\n  replayOfRunId           String?\n  cursorStart             Int                                  @default(0)\n  cursorEnd               Int                                  @default(0)\n  rowsSeen                Int                                  @default(0)\n  rowsApplied             Int                                  @default(0)\n  rowsSkipped             Int                                  @default(0)\n  rowsRejected            Int                                  @default(0)\n  directFieldsApplied     Int                                  @default(0)\n  regulatedFieldsProposed Int                                  @default(0)\n  rejectionReasons        Json                                 @default(\"[]\")\n  error                   String?\n  startedAt               DateTime                             @default(now())\n  completedAt             DateTime?\n  connector               PharmacyReferenceConnector           @relation(fields: [organizationId, connectorId], references: [organizationId, id], onDelete: Restrict)\n  proposals               PharmacyReferenceConnectorProposal[]\n\n  @@unique([organizationId, id], map: \"pharmacy_reference_connector_runs_org_id_key\")\n  @@index([organizationId, connectorId, startedAt], map: \"ph_ref_runs_org_connector_started_idx\")\n  @@index([organizationId, connectorId, inputDigest, status], map: \"ph_ref_runs_org_connector_digest_status_idx\")\n  @@map(\"pharmacy_reference_connector_runs\")\n}\n\nmodel PharmacyReferenceConnectorProposal {\n  id               String                          @id @default(cuid())\n  organizationId   String                          @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  runId            String\n  connectorId      String\n  inputDigest      String\n  rowSourceKey     String\n  targetMedicineId String?\n  payload          Json\n  status           PharmacyReferenceProposalStatus @default(PENDING)\n  decidedBy        String?\n  decidedAt        DateTime?\n  createdAt        DateTime                        @default(now())\n  run              PharmacyReferenceConnectorRun   @relation(fields: [organizationId, runId], references: [organizationId, id], onDelete: Restrict)\n  targetMedicine   Medicine?                       @relation(fields: [organizationId, targetMedicineId], references: [organizationId, id], onDelete: Restrict)\n\n  @@unique([organizationId, connectorId, inputDigest, rowSourceKey], map: \"ph_ref_proposals_input_row_key\")\n  @@index([organizationId, status, createdAt], map: \"ph_ref_proposals_org_status_created_idx\")\n  @@index([organizationId, targetMedicineId], map: \"ph_ref_proposals_org_medicine_idx\")\n  @@map(\"pharmacy_reference_connector_proposals\")\n}\n\n// ============================================\n// PH-INV \\u2014 batch/lot stock ledger (INV-01..04)\n// ============================================\n\nenum PharmacyStockLocationKind {\n  STORE\n  RACK_BIN\n  FRIDGE\n  SAFE\n  QUARANTINE\n  TRANSIT\n  RETURNS\n}\n\nenum PharmacyBatchState {\n  ACTIVE\n  RECALLED\n  QUARANTINED\n}\n\nenum PharmacyExpiryPrecision {\n  DAY\n  MONTH\n}\n\nenum PharmacyStockDisposition {\n  AVAILABLE\n  QUARANTINE\n  DAMAGED\n  DESTROYED\n  IN_TRANSIT\n  /// PUR-06: dispatched back to the supplier on a purchase return or expiry\n  /// claim. Terminal for sale purposes \\u2014 the units stay on the ledger so the\n  /// claim remains reconcilable, but nothing may allocate them again.\n  RETURN_TO_SUPPLIER\n}\n\nenum PharmacyStockMovementKind {\n  RECEIPT\n  SALE\n  RETURN\n  TRANSFER_OUT\n  TRANSFER_IN\n  ADJUSTMENT\n  WRITE_OFF\n  BREAK_PACK\n  /// MIG-03: the migrated opening position. Positive, like a RECEIPT, but it is\n  /// not one \\u2014 no supplier delivered it and no invoice backs it, so opening\n  /// stock stays distinguishable from purchased stock for the whole life of the\n  /// ledger and the opening totals remain auditable.\n  OPENING\n}\n\nenum PharmacyInventoryCountStatus {\n  OPEN\n  AWAITING_COAUTH\n  APPROVED\n}\n\nenum PharmacyTransferStatus {\n  /// PUR-07 \\xA78A invariant 29: what a one-click draft action may create. A DRAFT\n  /// transfer holds no stock and cannot be approved (\\`approveTransfer\\` requires\n  /// ALLOCATED), so no signal can reach a stock movement through it.\n  DRAFT\n  ALLOCATED\n  APPROVED\n  DISPATCHED\n  PARTIALLY_RECEIVED\n  RECEIVED\n  EXCEPTION\n}\n\nenum PharmacyRecallStatus {\n  OPEN\n  CLOSED\n}\n\nenum PharmacyDrapNoticeKind {\n  PRICE\n  RECALL\n}\n\nenum PharmacyDrapMatchStatus {\n  MATCHED\n  AMBIGUOUS\n  NO_MATCH\n}\n\nenum PharmacyPriceChangeStatus {\n  PROPOSED\n  CONFIRMED\n}\n\nenum PharmacySupplierClaimStatus {\n  RESERVED\n  RELEASED\n  SUBMITTED\n}\n\nenum PharmacySaleStatus {\n  OPEN\n  HELD\n  QUOTATION\n  COMPLETED\n  VOID\n}\n\nenum PharmacySaleEventKind {\n  CREATED\n  LINE_ADDED\n  HELD\n  RESUMED\n  QUOTATION_CREATED\n  QUOTATION_CONVERTED\n  COMPLETED\n  VOIDED\n  RETURNED\n  EXCHANGED\n}\n\nenum PharmacyFiscalIntegratorMode {\n  OFF\n  SANDBOX\n}\n\nenum PharmacyFiscalDocumentKind {\n  INVOICE\n  CREDIT_NOTE\n  DEBIT_NOTE\n}\n\nenum PharmacyFiscalDocumentStatus {\n  QUEUED\n  SUBMITTING\n  ACCEPTED\n  REJECTED\n  DEAD\n}\n\n/// FIN-05 / D04: tenant selection is deliberately OFF unless explicitly set.\n/// SANDBOX exercises the contract but is never evidence of FBR registration.\nmodel PharmacyFiscalConfiguration {\n  id               String                       @id @default(cuid())\n  organizationId   String                       @unique @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  integratorMode   PharmacyFiscalIntegratorMode @default(OFF)\n  maxAttempts      Int                          @default(5)\n  baseRetrySeconds Int                          @default(60)\n  updatedByActorId String\n  createdAt        DateTime                     @default(now())\n  updatedAt        DateTime                     @updatedAt\n\n  @@map(\"pharmacy_fiscal_configurations\")\n}\n\n/// FIN-05: an append-preserved fiscal document. \\`localReference\\` is DevFathom's\n/// identity; nullable \\`externalReference\\` is an integrator response and never a\n/// replacement. Notes must point at an original invoice in the same tenant and\n/// branch. \\`retentionUntil\\` is fixed at creation and hard deletion is refused in SQL.\nmodel PharmacyFiscalDocument {\n  id                 String                       @id @default(cuid())\n  organizationId     String                       @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId           String\n  saleId             String?\n  kind               PharmacyFiscalDocumentKind\n  originalDocumentId String?\n  localReference     String\n  externalReference  String?\n  externalQr         String?\n  integratorMode     PharmacyFiscalIntegratorMode\n  status             PharmacyFiscalDocumentStatus @default(QUEUED)\n  payload            Json\n  payloadHash        String\n  attempts           Int                          @default(0)\n  maxAttempts        Int\n  nextAttemptAt      DateTime?\n  submittedAt        DateTime?\n  acceptedAt         DateTime?\n  rejectedAt         DateTime?\n  lastError          String?\n  retentionUntil     DateTime\n  createdByActorId   String\n  createdAt          DateTime                     @default(now())\n  updatedAt          DateTime                     @updatedAt\n\n  @@unique([organizationId, id], map: \"pharmacy_fiscal_documents_org_id_key\")\n  @@unique([organizationId, branchId, id], map: \"pharmacy_fiscal_documents_org_branch_id_key\")\n  @@unique([organizationId, localReference], map: \"pharmacy_fiscal_documents_local_ref_key\")\n  @@index([organizationId, branchId, status, nextAttemptAt], map: \"pharmacy_fiscal_documents_queue_idx\")\n  @@index([organizationId, branchId, createdAt], map: \"pharmacy_fiscal_documents_age_idx\")\n  @@map(\"pharmacy_fiscal_documents\")\n}\n\n/// Every queue/lifecycle outcome is immutable evidence. Mutable scheduling\n/// fields live on the document; the history of how they changed lives here.\nmodel PharmacyFiscalDocumentEvent {\n  id             String                        @id @default(cuid())\n  organizationId String                        @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId       String\n  documentId     String\n  fromStatus     PharmacyFiscalDocumentStatus?\n  toStatus       PharmacyFiscalDocumentStatus\n  attempt        Int\n  detail         String?\n  occurredAt     DateTime                      @default(now())\n\n  @@unique([organizationId, id], map: \"pharmacy_fiscal_document_events_org_id_key\")\n  @@index([organizationId, branchId, documentId, occurredAt], map: \"pharmacy_fiscal_document_events_document_idx\")\n  @@map(\"pharmacy_fiscal_document_events\")\n}\n\nenum PharmacySaleUnit {\n  PACK\n  STRIP\n  UNIT\n}\n\nenum PharmacyDiscountKind {\n  DISCOUNT\n  PROMOTION\n  COMPLIMENTARY\n}\n\nenum PharmacyTenderType {\n  CASH\n  CARD\n  BANK_TRANSFER\n  WALLET\n  CREDIT\n  LOYALTY\n}\n\nenum PharmacyLoyaltyEntryKind {\n  EARN\n  REDEEM\n  REFUND\n}\n\nenum PharmacyDrawerSessionStatus {\n  OPEN\n  CLOSED\n}\n\nenum PharmacyDrawerMovementKind {\n  OPENING_FLOAT\n  CASH_SALE\n  CASH_REFUND\n  PAID_IN\n  PAID_OUT\n  CLOSING_COUNT\n}\n\nenum PharmacyDemandReason {\n  STOCKOUT\n  NOT_CARRIED\n  PACK_UNAVAILABLE\n  QUARANTINED_OR_EXPIRED\n  PRICE_REJECTED\n  PRESCRIPTION_RESTRICTION\n  LICENCE_RESTRICTION\n  PHARMACIST_RESTRICTION\n  SUBSTITUTE_DECLINED\n  SEARCH_FAILURE\n  SERVICE_FAILURE\n}\n\nenum PharmacyDemandStatus {\n  OPEN\n  RECOVERED\n  CLOSED\n}\n\nenum PharmacyRestockInterestStatus {\n  OPEN\n  NOTIFIED\n  RECOVERED\n  OPTED_OUT\n}\n\nenum PharmacyRestockReservationStatus {\n  RESERVED\n  CONSUMED\n  RELEASED\n}\n\nenum PharmacyRestockNotificationStatus {\n  CAPTURED\n  CANCELLED\n}\n\nenum PharmacyCustomerOrderFulfillment {\n  COLLECT\n  DELIVER\n}\n\nenum PharmacyCustomerOrderStatus {\n  PROPOSED\n  ACCEPTED\n  PACKING\n  READY_FOR_COLLECTION\n  OUT_FOR_DELIVERY\n  COMPLETED\n  CANCELLED\n  EXPIRED\n}\n\nenum PharmacyCustomerOrderEventKind {\n  PLACED\n  ACCEPTED\n  PACKING_STARTED\n  READY_FOR_COLLECTION\n  OUT_FOR_DELIVERY\n  CHECKOUT_STARTED\n  COMPLETED\n  CANCELLED\n  EXPIRED\n}\n\nmodel PharmacySale {\n  id                        String                       @id @default(cuid())\n  organizationId            String                       @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId                  String\n  status                    PharmacySaleStatus           @default(OPEN)\n  originalSaleId            String?\n  createdByUserId           String\n  completedAt               DateTime?\n  receiptNumber             Int?\n  receiptDeviceId           String?\n  businessDate              DateTime?                    @db.Date\n  customerId                String?\n  createdAt                 DateTime                     @default(now())\n  updatedAt                 DateTime                     @updatedAt\n  originalSale              PharmacySale?                @relation(\"PharmacySaleOriginal\", fields: [organizationId, branchId, originalSaleId], references: [organizationId, branchId, id], onDelete: Restrict)\n  relatedSales              PharmacySale[]               @relation(\"PharmacySaleOriginal\")\n  lines                     PharmacySaleLine[]\n  events                    PharmacySaleEvent[]\n  returns                   PharmacySaleReturn[]         @relation(\"PharmacySaleReturns\")\n  demandEvents              UnfulfilledDemandEvent[]\n  recoveredRestockInterests PharmacyRestockInterest[]    @relation(\"PharmacyRestockRecoverySale\")\n  tenders                   PharmacyTender[]\n  refunds                   PharmacyRefund[]\n  customer                  PharmacyCustomer?            @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: Restrict)\n  loyaltyEntries            PharmacyLoyaltyPointsEntry[]\n  customerOrder             PharmacyCustomerOrder?\n\n  @@unique([organizationId, id])\n  @@unique([organizationId, branchId, id])\n  @@index([organizationId, branchId, status, createdAt])\n  @@map(\"pharmacy_sales\")\n}\n\n/// CRM-L01 retail identity. Clinical identity remains in PharmacyPatient and is\n/// joined only server-side after a current LOYALTY consent check.\nmodel PharmacyCustomer {\n  id               String   @id @default(cuid())\n  organizationId   String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  patientId        String\n  displayName      String\n  phoneLast4       String?\n  creditLimitMinor Int      @default(0)\n  active           Boolean  @default(true)\n  userId           String?\n  createdAt        DateTime @default(now())\n  updatedAt        DateTime @updatedAt\n\n  patient            PharmacyPatient              @relation(fields: [organizationId, patientId], references: [organizationId, id], onDelete: Restrict)\n  sales              PharmacySale[]\n  pointsEntries      PharmacyLoyaltyPointsEntry[]\n  paidFamilyAccounts PharmacyFamilyAccount[]      @relation(\"PharmacyFamilyPayer\")\n  familyMemberships  PharmacyFamilyMember[]\n  user               User?                        @relation(\"PharmacyCustomerUser\", fields: [organizationId, userId], references: [organizationId, id], onDelete: Restrict)\n  orders             PharmacyCustomerOrder[]\n\n  @@unique([organizationId, id])\n  @@unique([organizationId, patientId])\n  @@unique([organizationId, userId])\n  @@index([organizationId, displayName])\n  @@map(\"pharmacy_customers\")\n}\n\nenum PharmacyKhataEventKind {\n  CHARGE\n  PAYMENT\n  DISHONOURED_CHEQUE\n}\n\nenum PharmacyKhataLimitDecisionKind {\n  ACCEPTED\n  OVERRIDDEN\n}\n\n/// CRM-L02 retail payer grouping. Clinical records remain attached to each\n/// member's PharmacyPatient and are never copied onto this account.\nmodel PharmacyFamilyAccount {\n  id               String   @id @default(cuid())\n  organizationId   String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId         String\n  payerCustomerId  String\n  displayName      String\n  creditLimitMinor Int      @default(0)\n  active           Boolean  @default(true)\n  createdAt        DateTime @default(now())\n  updatedAt        DateTime @updatedAt\n\n  payer          PharmacyCustomer             @relation(\"PharmacyFamilyPayer\", fields: [organizationId, payerCustomerId], references: [organizationId, id], onDelete: Restrict)\n  members        PharmacyFamilyMember[]\n  khataEvents    PharmacyKhataEvent[]\n  limitDecisions PharmacyKhataLimitDecision[]\n\n  @@unique([organizationId, branchId, id])\n  @@index([organizationId, branchId, payerCustomerId])\n  @@map(\"pharmacy_family_accounts\")\n}\n\nmodel PharmacyFamilyMember {\n  id              String   @id @default(cuid())\n  organizationId  String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId        String\n  familyAccountId String\n  customerId      String\n  createdAt       DateTime @default(now())\n\n  familyAccount PharmacyFamilyAccount @relation(fields: [organizationId, branchId, familyAccountId], references: [organizationId, branchId, id], onDelete: Restrict)\n  customer      PharmacyCustomer      @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: Restrict)\n  khataEvents   PharmacyKhataEvent[]\n\n  @@unique([organizationId, branchId, familyAccountId, customerId])\n  @@unique([organizationId, branchId, id])\n  @@index([organizationId, customerId])\n  @@map(\"pharmacy_family_members\")\n}\n\n/// Append-only history used for both the balance and explainable score.\nmodel PharmacyKhataEvent {\n  id              String                 @id @default(cuid())\n  organizationId  String                 @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId        String\n  familyAccountId String\n  memberId        String?\n  kind            PharmacyKhataEventKind\n  amountMinor     Int\n  occurredAt      DateTime               @default(now())\n  dueAt           DateTime?\n  settlesChargeId String?\n  actorId         String\n  note            String?\n\n  familyAccount PharmacyFamilyAccount @relation(fields: [organizationId, branchId, familyAccountId], references: [organizationId, branchId, id], onDelete: Restrict)\n  member        PharmacyFamilyMember? @relation(fields: [organizationId, branchId, memberId], references: [organizationId, branchId, id], onDelete: Restrict)\n\n  @@unique([organizationId, branchId, id])\n  @@index([organizationId, branchId, familyAccountId, occurredAt])\n  @@map(\"pharmacy_khata_events\")\n}\n\n/// Human owner decision. Score calculation never mutates the account limit.\nmodel PharmacyKhataLimitDecision {\n  id                  String                         @id @default(cuid())\n  organizationId      String                         @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId            String\n  familyAccountId     String\n  kind                PharmacyKhataLimitDecisionKind\n  score               Int\n  method              String\n  windowStart         DateTime\n  windowEnd           DateTime\n  suggestedLimitMinor Int\n  appliedLimitMinor   Int\n  reasons             Json\n  ownerActorId        String\n  createdAt           DateTime                       @default(now())\n\n  familyAccount PharmacyFamilyAccount @relation(fields: [organizationId, branchId, familyAccountId], references: [organizationId, branchId, id], onDelete: Restrict)\n\n  @@unique([organizationId, branchId, id])\n  @@index([organizationId, branchId, familyAccountId, createdAt])\n  @@map(\"pharmacy_khata_limit_decisions\")\n}\n\n/// Append-only, signed whole-point ledger. Branch is stamped at posting time;\n/// sale and idempotency constraints make settlement replay safe.\nmodel PharmacyLoyaltyPointsEntry {\n  id              String                   @id @default(cuid())\n  organizationId  String                   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId        String\n  customerId      String\n  saleId          String\n  tenderId        String?\n  refundId        String?\n  kind            PharmacyLoyaltyEntryKind\n  points          Int\n  requestedPoints Int?\n  netPaidMinor    Int?\n  actorId         String\n  idempotencyKey  String\n  occurredAt      DateTime                 @default(now())\n\n  customer PharmacyCustomer @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: Restrict)\n  sale     PharmacySale     @relation(fields: [organizationId, branchId, saleId], references: [organizationId, branchId, id], onDelete: Restrict)\n  tender   PharmacyTender?  @relation(fields: [organizationId, tenderId], references: [organizationId, id], onDelete: Restrict)\n  refund   PharmacyRefund?  @relation(fields: [organizationId, refundId], references: [organizationId, id], onDelete: Restrict)\n\n  @@unique([organizationId, id])\n  @@unique([organizationId, idempotencyKey])\n  @@index([organizationId, branchId, customerId, occurredAt])\n  @@index([organizationId, saleId])\n  @@index([organizationId, refundId])\n  @@map(\"pharmacy_loyalty_points_entries\")\n}\n\nmodel PharmacyMoneyIdempotencyKey {\n  id             String   @id @default(cuid())\n  organizationId String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  deviceId       String\n  key            String\n  commandType    String\n  payloadHash    String\n  resultPayload  Json?\n  createdAt      DateTime @default(now())\n\n  @@unique([organizationId, id])\n  @@unique([organizationId, deviceId, key])\n  @@map(\"pharmacy_money_idempotency_keys\")\n}\n\nmodel PharmacyTender {\n  id                String                       @id @default(cuid())\n  organizationId    String                       @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId          String\n  saleId            String\n  type              PharmacyTenderType\n  amountMinor       Int\n  cashReceivedMinor Int?\n  changeGivenMinor  Int?\n  provider          String?\n  providerRef       String?\n  drawerSessionId   String?\n  businessDate      DateTime                     @db.Date\n  actorId           String\n  deviceId          String\n  createdAt         DateTime                     @default(now())\n  sale              PharmacySale                 @relation(fields: [organizationId, branchId, saleId], references: [organizationId, branchId, id], onDelete: Restrict)\n  drawerSession     PharmacyDrawerSession?       @relation(fields: [organizationId, drawerSessionId], references: [organizationId, id], onDelete: Restrict)\n  refunds           PharmacyRefund[]\n  settlementMembers PharmacySettlementTender[]\n  loyaltyEntries    PharmacyLoyaltyPointsEntry[]\n\n  @@unique([organizationId, id])\n  @@index([organizationId, branchId, businessDate])\n  @@map(\"pharmacy_tenders\")\n}\n\nmodel PharmacyRefund {\n  id               String                       @id @default(cuid())\n  organizationId   String                       @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId         String\n  saleId           String\n  originalTenderId String\n  amountMinor      Int\n  providerRef      String?\n  drawerSessionId  String?\n  businessDate     DateTime                     @db.Date\n  reason           String\n  actorId          String\n  createdAt        DateTime                     @default(now())\n  sale             PharmacySale                 @relation(fields: [organizationId, branchId, saleId], references: [organizationId, branchId, id], onDelete: Restrict)\n  originalTender   PharmacyTender               @relation(fields: [organizationId, originalTenderId], references: [organizationId, id], onDelete: Restrict)\n  loyaltyEntries   PharmacyLoyaltyPointsEntry[]\n\n  @@unique([organizationId, id])\n  @@index([organizationId, branchId, businessDate])\n  @@map(\"pharmacy_refunds\")\n}\n\nmodel PharmacyDrawerSession {\n  id                  String                      @id @default(cuid())\n  organizationId      String                      @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId            String\n  deviceId            String\n  businessDate        DateTime                    @db.Date\n  status              PharmacyDrawerSessionStatus @default(OPEN)\n  openingFloatMinor   Int\n  countedCashMinor    Int?\n  controlledCountHook Json?\n  openedByActorId     String\n  closedByActorId     String?\n  openedAt            DateTime                    @default(now())\n  closedAt            DateTime?\n  movements           PharmacyDrawerMovement[]\n  tenders             PharmacyTender[]\n\n  @@unique([organizationId, id])\n  @@index([organizationId, branchId, businessDate])\n  @@map(\"pharmacy_drawer_sessions\")\n}\n\nmodel PharmacyDrawerMovement {\n  id              String                     @id @default(cuid())\n  organizationId  String                     @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  drawerSessionId String\n  kind            PharmacyDrawerMovementKind\n  amountMinor     Int\n  reason          String?\n  actorId         String\n  createdAt       DateTime                   @default(now())\n  drawerSession   PharmacyDrawerSession      @relation(fields: [organizationId, drawerSessionId], references: [organizationId, id], onDelete: Restrict)\n\n  @@unique([organizationId, id])\n  @@index([organizationId, drawerSessionId, createdAt])\n  @@map(\"pharmacy_drawer_movements\")\n}\n\nmodel PharmacyDailyClose {\n  id                  String   @id @default(cuid())\n  organizationId      String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId            String\n  businessDate        DateTime @db.Date\n  sequence            Int\n  supersedesCloseId   String?\n  reason              String?\n  grossSalesMinor     Int\n  refundTotalMinor    Int\n  netSalesMinor       Int\n  cashExpectedMinor   Int\n  cashCountedMinor    Int\n  cashVarianceMinor   Int\n  controlledCountHook Json?\n  sourceHash          String\n  actorId             String\n  /// MIG-05 \\u2014 whether this close is final. False while the branch is still\n  /// switching: the first DevFathom close only becomes final once the\n  /// parallel-run comparison for it reconciles against the D05 threshold.\n  /// Recorded on the close itself so the verdict is evidence, not a recomputation\n  /// against thresholds that may since have moved.\n  isFinal             Boolean  @default(false)\n  createdAt           DateTime @default(now())\n\n  @@unique([organizationId, id])\n  @@unique([organizationId, branchId, businessDate, sequence])\n  @@map(\"pharmacy_daily_closes\")\n}\n\nmodel PharmacyReceiptNumberSequence {\n  id             String   @id @default(cuid())\n  organizationId String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId       String\n  deviceId       String\n  nextNumber     Int      @default(1)\n  updatedAt      DateTime @updatedAt\n\n  @@unique([organizationId, id])\n  @@unique([organizationId, branchId, deviceId])\n  @@map(\"pharmacy_receipt_number_sequences\")\n}\n\n/// POS-01: one counter operator's configurable shortcut map. Organization- and\n/// user-scoped rather than branch-scoped, because muscle memory belongs to the\n/// cashier and follows them between counters. \\`overrides\\` is a JSON map from\n/// counter action to chord; it is validated by \\`resolveCounterKeymap\\` before it\n/// is stored, so an unknown action or a duplicate chord never reaches a row.\nmodel PharmacyCounterKeymapPreference {\n  id             String   @id @default(cuid())\n  organizationId String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  userId         String\n  preset         String   @default(\"devfathom\")\n  overrides      Json     @default(\"{}\")\n  createdAt      DateTime @default(now())\n  updatedAt      DateTime @updatedAt\n\n  @@unique([organizationId, id])\n  @@unique([organizationId, userId])\n  @@map(\"pharmacy_counter_keymap_preferences\")\n}\n\nmodel PharmacySaleLine {\n  id                        String                       @id @default(cuid())\n  organizationId            String                       @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId                  String\n  saleId                    String\n  medicineId                String\n  presentationId            String\n  packLevelId               String\n  saleUnit                  PharmacySaleUnit\n  quantity                  Int\n  canonicalUnitsPerSaleUnit Int\n  canonicalUnits            Int\n  unitPriceMinor            Int\n  proRataCeilingMinor       Int\n  unitCostMinor             Int\n  discountKind              PharmacyDiscountKind?\n  discountMinor             Int                          @default(0)\n  approvalPolicy            String?\n  approvedByUserId          String?\n  idempotencyKey            String\n  createdAt                 DateTime                     @default(now())\n  sale                      PharmacySale                 @relation(fields: [organizationId, branchId, saleId], references: [organizationId, branchId, id], onDelete: Restrict)\n  medicine                  Medicine                     @relation(fields: [medicineId], references: [id], onDelete: Restrict)\n  presentation              Presentation                 @relation(fields: [presentationId], references: [id], onDelete: Restrict)\n  packLevel                 PackLevel                    @relation(fields: [packLevelId], references: [id], onDelete: Restrict)\n  allocations               PharmacySaleLineAllocation[]\n  returnLines               PharmacySaleReturnLine[]\n\n  @@unique([organizationId, id])\n  @@unique([organizationId, idempotencyKey])\n  @@index([organizationId, branchId, saleId])\n  @@map(\"pharmacy_sale_lines\")\n}\n\nmodel PharmacySaleLineAllocation {\n  id              String               @id @default(cuid())\n  organizationId  String               @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId        String\n  saleLineId      String\n  inventoryLotId  String\n  stockLocationId String\n  canonicalUnits  Int\n  stockMovementId String\n  createdAt       DateTime             @default(now())\n  saleLine        PharmacySaleLine     @relation(fields: [organizationId, saleLineId], references: [organizationId, id], onDelete: Restrict)\n  lot             PharmacyInventoryLot @relation(fields: [organizationId, branchId, inventoryLotId], references: [organizationId, branchId, id], onDelete: Restrict)\n\n  @@unique([organizationId, id])\n  @@unique([organizationId, stockMovementId])\n  @@index([organizationId, saleLineId])\n  @@map(\"pharmacy_sale_line_allocations\")\n}\n\nmodel PharmacySaleEvent {\n  id             String                @id @default(cuid())\n  organizationId String                @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId       String\n  saleId         String\n  kind           PharmacySaleEventKind\n  actorId        String\n  reason         String?\n  payload        Json?\n  occurredAt     DateTime              @default(now())\n  sale           PharmacySale          @relation(fields: [organizationId, branchId, saleId], references: [organizationId, branchId, id], onDelete: Restrict)\n\n  @@unique([organizationId, id])\n  @@index([organizationId, branchId, saleId, occurredAt])\n  @@map(\"pharmacy_sale_events\")\n}\n\nmodel PharmacySaleReturn {\n  id             String                   @id @default(cuid())\n  organizationId String                   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId       String\n  originalSaleId String\n  actorId        String\n  reason         String\n  createdAt      DateTime                 @default(now())\n  originalSale   PharmacySale             @relation(\"PharmacySaleReturns\", fields: [organizationId, branchId, originalSaleId], references: [organizationId, branchId, id], onDelete: Restrict)\n  lines          PharmacySaleReturnLine[]\n\n  @@unique([organizationId, id])\n  @@unique([organizationId, branchId, id])\n  @@index([organizationId, branchId, originalSaleId])\n  @@map(\"pharmacy_sale_returns\")\n}\n\nmodel PharmacySaleReturnLine {\n  id                String               @id @default(cuid())\n  organizationId    String               @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId          String\n  returnId          String\n  saleLineId        String\n  inventoryLotId    String\n  stockLocationId   String\n  canonicalUnits    Int\n  integrityDecision String\n  stockMovementId   String\n  createdAt         DateTime             @default(now())\n  saleReturn        PharmacySaleReturn   @relation(fields: [organizationId, branchId, returnId], references: [organizationId, branchId, id], onDelete: Restrict)\n  saleLine          PharmacySaleLine     @relation(fields: [organizationId, saleLineId], references: [organizationId, id], onDelete: Restrict)\n  lot               PharmacyInventoryLot @relation(fields: [organizationId, branchId, inventoryLotId], references: [organizationId, branchId, id], onDelete: Restrict)\n\n  @@unique([organizationId, id])\n  @@unique([organizationId, stockMovementId])\n  @@index([organizationId, saleLineId])\n  @@map(\"pharmacy_sale_return_lines\")\n}\n\nmodel UnfulfilledDemandEvent {\n  id                    String                    @id @default(cuid())\n  organizationId        String                    @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId              String\n  saleId                String?\n  requestedMedicineId   String?\n  requestedText         String?\n  strength              String?\n  form                  String?\n  presentation          String?\n  saleUnit              PharmacySaleUnit\n  quantity              Int\n  reason                PharmacyDemandReason\n  inventoryRuleSnapshot Json\n  estimatedValueMinor   Int?\n  estimatedMarginMinor  Int?\n  customerId            String?\n  consentRecorded       Boolean                   @default(false)\n  status                PharmacyDemandStatus      @default(OPEN)\n  recoveredSaleLineId   String?\n  recoveredAt           DateTime?\n  closedAt              DateTime?\n  capturedByUserId      String\n  createdAt             DateTime                  @default(now())\n  sale                  PharmacySale?             @relation(fields: [organizationId, branchId, saleId], references: [organizationId, branchId, id], onDelete: Restrict)\n  medicine              Medicine?                 @relation(fields: [requestedMedicineId], references: [id], onDelete: Restrict)\n  customer              PharmacyPatient?          @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: Restrict)\n  restockInterests      PharmacyRestockInterest[]\n\n  @@unique([organizationId, id])\n  @@index([organizationId, branchId, createdAt, reason])\n  @@map(\"pharmacy_unfulfilled_demand_events\")\n}\n\n/// DEM-03: an operator-created follow-up to one explicit POS-10 demand event.\nmodel PharmacyRestockInterest {\n  id                  String                        @id @default(cuid())\n  organizationId      String                        @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId            String\n  demandEventId       String\n  patientId           String?\n  channel             PatientConsentChannel?\n  reserveOnArrival    Boolean                       @default(false)\n  quantityUnits       Int\n  campaignKey         String?\n  orderLineId         String?\n  status              PharmacyRestockInterestStatus @default(OPEN)\n  recoveredSaleId     String?\n  recoveredSaleLineId String?\n  recoveredAt         DateTime?\n  createdByUserId     String\n  createdAt           DateTime                      @default(now())\n  updatedAt           DateTime                      @updatedAt\n\n  demandEvent   UnfulfilledDemandEvent        @relation(fields: [organizationId, demandEventId], references: [organizationId, id], onDelete: Restrict)\n  patient       PharmacyPatient?              @relation(fields: [organizationId, patientId], references: [organizationId, id], onDelete: Restrict)\n  recoveredSale PharmacySale?                 @relation(\"PharmacyRestockRecoverySale\", fields: [organizationId, branchId, recoveredSaleId], references: [organizationId, branchId, id], onDelete: Restrict)\n  reservation   PharmacyRestockReservation?\n  notifications PharmacyRestockNotification[]\n  orderLine     PharmacyCustomerOrderLine?    @relation(fields: [organizationId, branchId, orderLineId], references: [organizationId, branchId, id], onDelete: Restrict)\n\n  @@unique([organizationId, id])\n  @@unique([organizationId, branchId, demandEventId])\n  @@unique([organizationId, branchId, id])\n  @@index([organizationId, branchId, status, createdAt])\n  @@index([organizationId, branchId, campaignKey, status])\n  @@index([organizationId, branchId, orderLineId, status])\n  @@map(\"pharmacy_restock_interests\")\n}\n\nmodel PharmacyRestockReservation {\n  id              String                           @id @default(cuid())\n  organizationId  String                           @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId        String\n  interestId      String\n  inventoryLotId  String\n  stockLocationId String\n  reservedUnits   Int\n  status          PharmacyRestockReservationStatus @default(RESERVED)\n  createdAt       DateTime                         @default(now())\n  settledAt       DateTime?\n  interest        PharmacyRestockInterest          @relation(fields: [organizationId, branchId, interestId], references: [organizationId, branchId, id], onDelete: Restrict)\n\n  @@unique([organizationId, id])\n  @@unique([organizationId, branchId, interestId])\n  @@index([organizationId, branchId, inventoryLotId, stockLocationId, status])\n  @@map(\"pharmacy_restock_reservations\")\n}\n\nmodel PharmacyRestockNotification {\n  id             String                            @id @default(cuid())\n  organizationId String                            @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId       String\n  interestId     String\n  channel        PatientConsentChannel\n  destination    String\n  status         PharmacyRestockNotificationStatus @default(CAPTURED)\n  consentId      String\n  inventoryLotId String\n  idempotencyKey String\n  queuedAt       DateTime                          @default(now())\n  cancelledAt    DateTime?\n  interest       PharmacyRestockInterest           @relation(fields: [organizationId, branchId, interestId], references: [organizationId, branchId, id], onDelete: Restrict)\n\n  @@unique([organizationId, id])\n  @@unique([organizationId, idempotencyKey])\n  @@index([organizationId, branchId, status, queuedAt])\n  @@map(\"pharmacy_restock_notifications\")\n}\n\n/// MKT-03/MKT-05: one authenticated customer proposal with either collection\n/// or staff-runner delivery. Stock remains held by DEM-03 reservations until a\n/// staff member explicitly starts the existing counter-sale checkout.\nmodel PharmacyCustomerOrder {\n  id                    String                           @id @default(cuid())\n  organizationId        String                           @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId              String\n  customerId            String\n  placedByUserId        String\n  fulfillment           PharmacyCustomerOrderFulfillment\n  status                PharmacyCustomerOrderStatus      @default(PROPOSED)\n  intendedPaymentMethod PharmacyTenderType\n  addressLine           String?\n  city                  String?\n  deliveryInstructions  String?\n  runnerUserId          String?\n  reservationExpiresAt  DateTime\n  counterSaleId         String?\n  acceptedAt            DateTime?\n  packedAt              DateTime?\n  readyAt               DateTime?\n  outForDeliveryAt      DateTime?\n  completedAt           DateTime?\n  cancelledAt           DateTime?\n  expiredAt             DateTime?\n  createdAt             DateTime                         @default(now())\n  updatedAt             DateTime                         @updatedAt\n\n  branch      PharmacyBranch               @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)\n  customer    PharmacyCustomer             @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: Restrict)\n  placedBy    User                         @relation(\"PharmacyOrderPlacedBy\", fields: [organizationId, placedByUserId], references: [organizationId, id], onDelete: Restrict)\n  runner      User?                        @relation(\"PharmacyOrderRunner\", fields: [organizationId, runnerUserId], references: [organizationId, id], onDelete: Restrict)\n  counterSale PharmacySale?                @relation(fields: [organizationId, branchId, counterSaleId], references: [organizationId, branchId, id], onDelete: Restrict)\n  lines       PharmacyCustomerOrderLine[]\n  events      PharmacyCustomerOrderEvent[]\n\n  @@unique([organizationId, id])\n  @@unique([organizationId, branchId, id])\n  @@unique([organizationId, branchId, counterSaleId])\n  @@index([organizationId, customerId, createdAt])\n  @@index([organizationId, branchId, status, createdAt])\n  @@index([organizationId, reservationExpiresAt, status])\n  @@map(\"pharmacy_customer_orders\")\n}\n\nmodel PharmacyCustomerOrderLine {\n  id                        String           @id @default(cuid())\n  organizationId            String           @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId                  String\n  orderId                   String\n  medicineId                String\n  presentationId            String\n  packLevelId               String\n  saleUnit                  PharmacySaleUnit\n  quantity                  Int\n  canonicalUnitsPerSaleUnit Int\n  canonicalUnits            Int\n  unitPriceMinor            Int\n  lineTotalMinor            Int\n  createdAt                 DateTime         @default(now())\n\n  order        PharmacyCustomerOrder     @relation(fields: [organizationId, branchId, orderId], references: [organizationId, branchId, id], onDelete: Restrict)\n  medicine     Medicine                  @relation(fields: [organizationId, medicineId], references: [organizationId, id], onDelete: Restrict)\n  presentation Presentation              @relation(fields: [presentationId], references: [id], onDelete: Restrict)\n  packLevel    PackLevel                 @relation(fields: [packLevelId], references: [id], onDelete: Restrict)\n  interests    PharmacyRestockInterest[]\n\n  @@unique([organizationId, id])\n  @@unique([organizationId, branchId, id])\n  @@index([organizationId, branchId, orderId])\n  @@map(\"pharmacy_customer_order_lines\")\n}\n\nmodel PharmacyCustomerOrderEvent {\n  id             String                         @id @default(cuid())\n  organizationId String                         @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId       String\n  orderId        String\n  kind           PharmacyCustomerOrderEventKind\n  fromStatus     PharmacyCustomerOrderStatus?\n  toStatus       PharmacyCustomerOrderStatus\n  actorUserId    String\n  detail         Json?\n  occurredAt     DateTime                       @default(now())\n\n  order PharmacyCustomerOrder @relation(fields: [organizationId, branchId, orderId], references: [organizationId, branchId, id], onDelete: Restrict)\n  actor User                  @relation(\"PharmacyOrderEventActor\", fields: [organizationId, actorUserId], references: [organizationId, id], onDelete: Restrict)\n\n  @@unique([organizationId, id])\n  @@index([organizationId, branchId, orderId, occurredAt])\n  @@map(\"pharmacy_customer_order_events\")\n}\n\n/// INV-05 seam / INV-01: a branch-owned storage place. \\`coldChain\\` marks the\n/// validated cold-chain zones a cold-chain medicine may be put away into.\nmodel PharmacyStockLocation {\n  id                                        String                    @id @default(cuid())\n  organizationId                            String                    @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId                                  String\n  code                                      String\n  name                                      String\n  kind                                      PharmacyStockLocationKind\n  coldChain                                 Boolean                   @default(false)\n  minimumTemperatureC                       Float?\n  maximumTemperatureC                       Float?\n  expectedTemperatureReadingIntervalMinutes Int                       @default(15)\n  temperatureExcursionDurationMinutes       Int                       @default(30)\n  active                                    Boolean                   @default(true)\n  createdAt                                 DateTime                  @default(now())\n  updatedAt                                 DateTime                  @updatedAt\n\n  purchaseReturnLines     PharmacyPurchaseReturnLine[]\n  stockSignals            PharmacyStockSignal[]\n  receiptLines            PharmacyGoodsReceiptLine[]   @relation(\"PharmacyReceiptStock\")\n  quarantinedReceiptLines PharmacyGoodsReceiptLine[]   @relation(\"PharmacyReceiptQuarantine\")\n  branch                  PharmacyBranch               @relation(\"PharmacyBranchStockLocations\", fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)\n  movements               PharmacyStockMovement[]\n  balances                PharmacyStockBalance[]\n  discrepancies           PharmacyStockDiscrepancy[]\n  deviceQuotas            PharmacyDeviceLotQuota[]\n  temperatureLogs         PharmacyTemperatureLog[]\n\n  @@unique([organizationId, id], map: \"pharmacy_stock_locations_org_id_key\")\n  @@unique([organizationId, branchId, id], map: \"pharmacy_stock_locations_org_branch_id_key\")\n  @@unique([organizationId, branchId, code], map: \"pharmacy_stock_locations_org_branch_code_key\")\n  @@index([organizationId, branchId], map: \"pharmacy_stock_locations_org_branch_idx\")\n  @@map(\"pharmacy_stock_locations\")\n}\n\nenum PharmacyTemperatureReadingSource {\n  MANUAL\n  IMPORT\n}\n\n/// INV-05: immutable storage-zone temperature evidence. Staff entry and\n/// data-logger files append through the same source seam; live devices remain\n/// outside this boundary.\nmodel PharmacyTemperatureLog {\n  id               String                           @id @default(cuid())\n  organizationId   String                           @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId         String\n  stockLocationId  String\n  actorId          String\n  temperatureC     Float\n  recordedAt       DateTime\n  outOfRange       Boolean\n  source           PharmacyTemperatureReadingSource @default(MANUAL)\n  deviceIdentifier String?\n  createdAt        DateTime                         @default(now())\n\n  location PharmacyStockLocation @relation(fields: [organizationId, branchId, stockLocationId], references: [organizationId, branchId, id], onDelete: Restrict)\n\n  @@unique([organizationId, id], map: \"pharmacy_temperature_logs_org_id_key\")\n  @@index([organizationId, branchId, stockLocationId, recordedAt], map: \"pharmacy_temperature_logs_zone_time_idx\")\n  @@map(\"pharmacy_temperature_logs\")\n}\n\n/// \\xA78A invariant 18: the manufacturer's batch. Organization-scoped, not\n/// branch-scoped, because recall and batch-level quarantine apply globally at\n/// batch/product scope while quarantine and damage may apply to part of one lot.\nmodel PharmacyManufacturingBatch {\n  id              String                  @id @default(cuid())\n  organizationId  String                  @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  medicineId      String\n  batchNumber     String\n  expiresAt       DateTime\n  expiryPrecision PharmacyExpiryPrecision @default(DAY)\n  state           PharmacyBatchState      @default(ACTIVE)\n  stateReason     String?\n  stateChangedAt  DateTime?\n  createdAt       DateTime                @default(now())\n  updatedAt       DateTime                @updatedAt\n\n  medicine Medicine               @relation(fields: [organizationId, medicineId], references: [organizationId, id], onDelete: Restrict)\n  lots     PharmacyInventoryLot[]\n\n  @@unique([organizationId, id], map: \"pharmacy_manufacturing_batches_org_id_key\")\n  @@unique([organizationId, medicineId, batchNumber], map: \"pharmacy_manufacturing_batches_org_medicine_number_key\")\n  @@index([organizationId, expiresAt], map: \"pharmacy_manufacturing_batches_org_expiry_idx\")\n  @@map(\"pharmacy_manufacturing_batches\")\n}\n\n/// INV-01: the receipt-specific lot \\u2014 one supplier, one invoice, one landed\n/// cost, one printed MRP, one received expiry precision. \\`receivedAt\\` is null\n/// until the goods actually arrive, and unreceived stock cannot move (INV-03).\nmodel PharmacyInventoryLot {\n  id                      String                  @id @default(cuid())\n  organizationId          String                  @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId                String\n  manufacturingBatchId    String\n  packLevelId             String\n  /// Canonical base units in one sealed pack of this lot, resolved from the\n  /// MED-02 pack hierarchy at receipt and frozen with it.\n  unitsPerPack            Int\n  supplierName            String\n  supplierInvoiceRef      String\n  unitCostMinor           Int\n  printedMrpMinor         Int\n  receivedExpiresAt       DateTime\n  receivedExpiryPrecision PharmacyExpiryPrecision\n  receivedAt              DateTime?\n  createdAt               DateTime                @default(now())\n  updatedAt               DateTime                @updatedAt\n\n  batch     PharmacyManufacturingBatch @relation(fields: [organizationId, manufacturingBatchId], references: [organizationId, id], onDelete: Restrict)\n  packLevel PackLevel                  @relation(fields: [organizationId, packLevelId], references: [organizationId, id], onDelete: Restrict)\n  branch    PharmacyBranch             @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)\n\n  saleAllocations PharmacySaleLineAllocation[]\n  returnLines     PharmacySaleReturnLine[]\n\n  movements                PharmacyStockMovement[]\n  balances                 PharmacyStockBalance[]\n  discrepancies            PharmacyStockDiscrepancy[]\n  recommendedBy            PharmacyAllocationOverride[]      @relation(\"PharmacyAllocationRecommended\")\n  selectedBy               PharmacyAllocationOverride[]      @relation(\"PharmacyAllocationSelected\")\n  receiptLines             PharmacyGoodsReceiptLine[]\n  countLines               PharmacyInventoryCountLine[]\n  transferLines            PharmacyInterbranchTransferLine[] @relation(\"PharmacyTransferSourceLot\")\n  supplierClaims           PharmacySupplierClaim[]\n  purchaseReturnLines      PharmacyPurchaseReturnLine[]\n  deviceQuotas             PharmacyDeviceLotQuota[]\n  pharmacovigilanceReports PharmacyPharmacovigilanceReport[]\n\n  @@unique([organizationId, id], map: \"pharmacy_inventory_lots_org_id_key\")\n  @@unique([organizationId, branchId, id], map: \"pharmacy_inventory_lots_org_branch_id_key\")\n  @@unique([organizationId, supplierName, supplierInvoiceRef, manufacturingBatchId], map: \"pharmacy_inventory_lots_org_invoice_key\")\n  @@index([organizationId, branchId, manufacturingBatchId], map: \"pharmacy_inventory_lots_org_branch_batch_idx\")\n  @@map(\"pharmacy_inventory_lots\")\n}\n\nmodel PharmacyInventoryCount {\n  id                String                       @id @default(cuid())\n  organizationId    String                       @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId          String\n  status            PharmacyInventoryCountStatus @default(OPEN)\n  varianceThreshold Int\n  createdById       String\n  approvedById      String?\n  createdAt         DateTime                     @default(now())\n  approvedAt        DateTime?\n  lines             PharmacyInventoryCountLine[]\n\n  @@unique([organizationId, id])\n  @@index([organizationId, branchId, createdAt])\n  @@map(\"pharmacy_inventory_counts\")\n}\n\nmodel PharmacyInventoryCountLine {\n  id                  String                 @id @default(cuid())\n  organizationId      String                 @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  countId             String\n  branchId            String\n  inventoryLotId      String\n  stockLocationId     String\n  expectedUnits       Int\n  expectedSealedPacks Int\n  expectedLooseUnits  Int\n  countedSealedPacks  Int?\n  countedLooseUnits   Int?\n  countedUnits        Int?\n  varianceUnits       Int?\n  count               PharmacyInventoryCount @relation(fields: [organizationId, countId], references: [organizationId, id], onDelete: Restrict)\n  lot                 PharmacyInventoryLot   @relation(fields: [organizationId, branchId, inventoryLotId], references: [organizationId, branchId, id], onDelete: Restrict)\n\n  @@unique([organizationId, countId, inventoryLotId, stockLocationId])\n  @@index([organizationId, branchId])\n  @@map(\"pharmacy_inventory_count_lines\")\n}\n\nmodel PharmacyInterbranchTransfer {\n  id             String                            @id @default(cuid())\n  organizationId String                            @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  fromBranchId   String\n  toBranchId     String\n  status         PharmacyTransferStatus            @default(ALLOCATED)\n  allocatedById  String\n  approvedById   String?\n  dispatchedById String?\n  createdAt      DateTime                          @default(now())\n  dispatchedAt   DateTime?\n  receivedAt     DateTime?\n  lines          PharmacyInterbranchTransferLine[]\n  signalActions  PharmacyStockSignalAction[]\n\n  @@unique([organizationId, id])\n  @@index([organizationId, fromBranchId, status])\n  @@index([organizationId, toBranchId, status])\n  @@map(\"pharmacy_interbranch_transfers\")\n}\n\nmodel PharmacyInterbranchTransferLine {\n  id                         String                      @id @default(cuid())\n  organizationId             String                      @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  transferId                 String\n  sourceBranchId             String\n  sourceLotId                String\n  sourceStockLocationId      String\n  destinationStockLocationId String\n  quantityUnits              Int\n  receivedUnits              Int                         @default(0)\n  transfer                   PharmacyInterbranchTransfer @relation(fields: [organizationId, transferId], references: [organizationId, id], onDelete: Restrict)\n  sourceLot                  PharmacyInventoryLot        @relation(\"PharmacyTransferSourceLot\", fields: [organizationId, sourceBranchId, sourceLotId], references: [organizationId, branchId, id], onDelete: Restrict)\n\n  @@unique([organizationId, transferId, sourceLotId, sourceStockLocationId])\n  @@map(\"pharmacy_interbranch_transfer_lines\")\n}\n\nmodel PharmacyRecallNotice {\n  id                String                           @id @default(cuid())\n  organizationId    String                           @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  batchId           String?\n  medicineId        String?\n  reference         String\n  reason            String\n  status            PharmacyRecallStatus             @default(OPEN)\n  createdById       String\n  createdAt         DateTime                         @default(now())\n  closedById        String?\n  closedAt          DateTime?\n  acknowledgements  PharmacyRecallAcknowledgement[]\n  drapIngest        PharmacyDrapIngest?\n  quarantineActions PharmacyRecallQuarantineAction[]\n\n  @@unique([organizationId, id])\n  @@unique([organizationId, reference])\n  @@index([organizationId, status])\n  @@map(\"pharmacy_recall_notices\")\n}\n\n/// ECO-01: immutable receipt of a regulator notice. \\`adapter\\` is deliberately\n/// limited to FILE or MANUAL until the licensed-feed owner decision is made.\nmodel PharmacyDrapIngest {\n  id                String                           @id @default(cuid())\n  organizationId    String                           @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  sourceReference   String\n  adapter           String\n  kind              PharmacyDrapNoticeKind\n  payloadHash       String\n  matchStatus       PharmacyDrapMatchStatus\n  matchDetails      Json\n  recallNoticeId    String?\n  ingestedById      String\n  createdAt         DateTime                         @default(now())\n  recallNotice      PharmacyRecallNotice?            @relation(fields: [organizationId, recallNoticeId], references: [organizationId, id], onDelete: Restrict)\n  priceChanges      PharmacyPriceChangeProposal[]\n  quarantineActions PharmacyRecallQuarantineAction[]\n\n  @@unique([organizationId, id])\n  @@unique([organizationId, sourceReference, kind])\n  @@unique([organizationId, recallNoticeId])\n  @@map(\"pharmacy_drap_ingests\")\n}\n\nmodel PharmacyPriceChangeProposal {\n  id                 String                    @id @default(cuid())\n  organizationId     String                    @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  ingestId           String\n  medicineId         String\n  currentPriceMinor  Int\n  notifiedPriceMinor Int\n  effectiveDate      DateTime\n  status             PharmacyPriceChangeStatus @default(PROPOSED)\n  confirmedById      String?\n  confirmedAt        DateTime?\n  createdAt          DateTime                  @default(now())\n  ingest             PharmacyDrapIngest        @relation(fields: [organizationId, ingestId], references: [organizationId, id], onDelete: Restrict)\n  medicine           Medicine                  @relation(fields: [organizationId, medicineId], references: [organizationId, id], onDelete: Restrict)\n\n  @@unique([organizationId, id])\n  @@unique([organizationId, ingestId, medicineId])\n  @@map(\"pharmacy_price_change_proposals\")\n}\n\nmodel PharmacyRecallQuarantineAction {\n  id                String               @id @default(cuid())\n  organizationId    String               @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  ingestId          String\n  recallNoticeId    String\n  branchId          String\n  inventoryLotId    String\n  stockLocationId   String\n  quantityUnits     Int\n  removedMovementId String\n  heldMovementId    String\n  reversedById      String?\n  reversedAt        DateTime?\n  reversalReason    String?\n  createdAt         DateTime             @default(now())\n  ingest            PharmacyDrapIngest   @relation(fields: [organizationId, ingestId], references: [organizationId, id], onDelete: Restrict)\n  recallNotice      PharmacyRecallNotice @relation(fields: [organizationId, recallNoticeId], references: [organizationId, id], onDelete: Restrict)\n\n  @@unique([organizationId, id])\n  @@unique([organizationId, ingestId, inventoryLotId, stockLocationId])\n  @@index([organizationId, branchId, recallNoticeId])\n  @@map(\"pharmacy_recall_quarantine_actions\")\n}\n\nmodel PharmacyRecallAcknowledgement {\n  id             String               @id @default(cuid())\n  organizationId String               @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  recallNoticeId String\n  branchId       String\n  actorId        String\n  createdAt      DateTime             @default(now())\n  notice         PharmacyRecallNotice @relation(fields: [organizationId, recallNoticeId], references: [organizationId, id], onDelete: Restrict)\n\n  @@unique([organizationId, recallNoticeId, branchId])\n  @@map(\"pharmacy_recall_acknowledgements\")\n}\n\nmodel PharmacyCustodyRecord {\n  id             String   @id @default(cuid())\n  organizationId String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId       String\n  movementId     String\n  actorId        String\n  witnessId      String\n  reason         String\n  evidenceRef    String\n  createdAt      DateTime @default(now())\n\n  @@unique([organizationId, movementId])\n  @@index([organizationId, branchId, createdAt])\n  @@map(\"pharmacy_custody_records\")\n}\n\nmodel PharmacySupplierClaim {\n  id             String                       @id @default(cuid())\n  organizationId String                       @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId       String\n  inventoryLotId String\n  reservedUnits  Int\n  returnBy       DateTime\n  status         PharmacySupplierClaimStatus  @default(RESERVED)\n  createdById    String\n  createdAt      DateTime                     @default(now())\n  lot            PharmacyInventoryLot         @relation(fields: [organizationId, branchId, inventoryLotId], references: [organizationId, branchId, id], onDelete: Restrict)\n  /// PUR-06: the return line that reserved this quantity, when the reservation\n  /// came from a purchase return or expiry claim rather than a bare INV-09 hold.\n  returnLines    PharmacyPurchaseReturnLine[]\n\n  @@unique([organizationId, id], map: \"pharmacy_supplier_claims_org_id_key\")\n  @@index([organizationId, branchId, returnBy])\n  @@map(\"pharmacy_supplier_claims\")\n}\n\n/// INV-02 / \\xA78A invariant 5: the evidence a non-FEFO selection leaves behind.\n/// Append-only.\nmodel PharmacyAllocationOverride {\n  id               String   @id @default(cuid())\n  organizationId   String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId         String\n  actorId          String\n  reason           String\n  approvalPolicy   String\n  recommendedLotId String\n  selectedLotId    String\n  createdAt        DateTime @default(now())\n\n  recommendedLot PharmacyInventoryLot    @relation(\"PharmacyAllocationRecommended\", fields: [organizationId, branchId, recommendedLotId], references: [organizationId, branchId, id], onDelete: Restrict)\n  selectedLot    PharmacyInventoryLot    @relation(\"PharmacyAllocationSelected\", fields: [organizationId, branchId, selectedLotId], references: [organizationId, branchId, id], onDelete: Restrict)\n  movements      PharmacyStockMovement[]\n\n  @@unique([organizationId, id], map: \"pharmacy_allocation_overrides_org_id_key\")\n  @@index([organizationId, branchId, createdAt], map: \"pharmacy_allocation_overrides_org_branch_created_idx\")\n  @@map(\"pharmacy_allocation_overrides\")\n}\n\n/// INV-01: the append-only ledger. \\`quantityUnits\\` is a SIGNED integer count of\n/// canonical base units whose sign is fixed by \\`kind\\`; \\`sealedPackDelta\\` and\n/// \\`looseUnitDelta\\` carry the physical arrangement so a BREAK_PACK (INV-04) is\n/// an explicit movement with a zero canonical total.\nmodel PharmacyStockMovement {\n  id                   String                    @id @default(cuid())\n  organizationId       String                    @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId             String\n  inventoryLotId       String\n  stockLocationId      String\n  kind                 PharmacyStockMovementKind\n  disposition          PharmacyStockDisposition\n  quantityUnits        Int\n  sealedPackDelta      Int                       @default(0)\n  looseUnitDelta       Int                       @default(0)\n  actorId              String\n  reason               String?\n  idempotencyKey       String\n  allocationOverrideId String?\n  /// PUR-04 / \\xA78A invariant 8: a correction is a linked compensating movement,\n  /// never an edit. A reversal must be the exact negation of the movement it\n  /// names, in the same lot, location and disposition, and each posting can be\n  /// reversed at most once.\n  reversesMovementId   String?\n  occurredAt           DateTime                  @default(now())\n  createdAt            DateTime                  @default(now())\n\n  lot      PharmacyInventoryLot        @relation(fields: [organizationId, branchId, inventoryLotId], references: [organizationId, branchId, id], onDelete: Restrict)\n  location PharmacyStockLocation       @relation(fields: [organizationId, stockLocationId], references: [organizationId, id], onDelete: Restrict)\n  override PharmacyAllocationOverride? @relation(fields: [organizationId, allocationOverrideId], references: [organizationId, id], onDelete: Restrict)\n  reverses PharmacyStockMovement?      @relation(\"PharmacyMovementReversal\", fields: [organizationId, reversesMovementId], references: [organizationId, id], onDelete: Restrict, map: \"pharmacy_stock_movements_reverses_fkey\")\n  reversal PharmacyStockMovement[]     @relation(\"PharmacyMovementReversal\")\n\n  @@unique([organizationId, id], map: \"pharmacy_stock_movements_org_id_key\")\n  @@unique([organizationId, idempotencyKey], map: \"pharmacy_stock_movements_org_idempotency_key\")\n  @@index([organizationId, branchId, inventoryLotId, occurredAt], map: \"pharmacy_stock_movements_org_branch_lot_idx\")\n  @@map(\"pharmacy_stock_movements\")\n}\n\n/// INV-01 acceptance (\"product quantity is a projection\"). Derived state,\n/// maintained only by the ledger trigger and constrained non-negative, so a\n/// negative balance is unrepresentable. Never written by application code.\nmodel PharmacyStockBalance {\n  organizationId  String\n  branchId        String\n  inventoryLotId  String\n  stockLocationId String\n  disposition     PharmacyStockDisposition\n  onHandUnits     Int\n  sealedPacks     Int\n  looseUnits      Int\n  updatedAt       DateTime                 @default(now())\n\n  lot      PharmacyInventoryLot  @relation(fields: [organizationId, branchId, inventoryLotId], references: [organizationId, branchId, id], onDelete: Restrict)\n  location PharmacyStockLocation @relation(fields: [organizationId, stockLocationId], references: [organizationId, id], onDelete: Restrict)\n\n  @@id([organizationId, inventoryLotId, stockLocationId, disposition], map: \"pharmacy_stock_balances_pkey\")\n  @@index([organizationId, branchId, disposition], map: \"pharmacy_stock_balances_org_branch_idx\")\n  @@map(\"pharmacy_stock_balances\")\n}\n\n/// \\xA78A invariant 6: what the emergency path records instead of driving a\n/// balance below zero. Append-only; closure belongs to INV-06.\nmodel PharmacyStockDiscrepancy {\n  id              String   @id @default(cuid())\n  organizationId  String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId        String\n  inventoryLotId  String?\n  stockLocationId String?\n  requestedUnits  Int\n  allocatedUnits  Int\n  shortfallUnits  Int\n  actorId         String\n  reason          String\n  createdAt       DateTime @default(now())\n\n  lot      PharmacyInventoryLot?  @relation(fields: [organizationId, branchId, inventoryLotId], references: [organizationId, branchId, id], onDelete: Restrict)\n  location PharmacyStockLocation? @relation(fields: [organizationId, stockLocationId], references: [organizationId, id], onDelete: Restrict)\n\n  @@unique([organizationId, id], map: \"pharmacy_stock_discrepancies_org_id_key\")\n  @@index([organizationId, branchId, createdAt], map: \"pharmacy_stock_discrepancies_org_branch_created_idx\")\n  @@map(\"pharmacy_stock_discrepancies\")\n}\n\n// ============================================\n// ENUMS\n// ============================================\n\nenum Role {\n  ADMIN\n  EMPLOYEE\n  HR\n}\n\nenum ResignationStatus {\n  PENDING\n  APPROVED\n  DECLINED\n  WITHDRAWN\n}\n\nenum UserStatus {\n  ACTIVE\n  INACTIVE\n  ON_LEAVE\n  INVITED\n}\n\nenum ProjectStatus {\n  ACTIVE\n  COMPLETED\n  ON_HOLD\n  CANCELLED\n  IN_DEVELOPMENT\n}\n\nenum ProjectType {\n  CLIENT\n  INTERNAL\n}\n\nenum Priority {\n  LOW\n  MEDIUM\n  HIGH\n  URGENT\n}\n\nenum InvoiceStatus {\n  DRAFT\n  SENT\n  PAID\n  OVERDUE\n  CANCELLED\n}\n\nenum Currency {\n  USD\n  PKR\n}\n\nenum TransactionType {\n  INCOME\n  EXPENSE\n}\n\nenum FinanceJournalSide {\n  DEBIT\n  CREDIT\n}\n\n/// FIN-01: the accounts the posting adapters use. Deliberately the smallest set\n/// that lets every event listed in FIN-01 balance and every FIN-03 read be a\n/// query rather than a special case \\u2014 there is no account here that no adapter\n/// posts to.\nenum FinanceAccountCode {\n  /// Asset. Perpetual stock value, carried per lot and location.\n  INVENTORY\n  /// Asset. Stock that has left a branch and not yet been received.\n  INVENTORY_IN_TRANSIT\n  /// Liability. Goods received and owed for; FIN-02 settles it.\n  GOODS_RECEIVED_ACCRUAL\n  /// Asset. What the sale is owed, before FIN-02 tender/khata settlement.\n  SALES_CLEARING\n  /// Income. Recognised GROSS, so a discount never hides inside revenue.\n  SALES_REVENUE\n  /// Contra-revenue. The explicit commercial treatment of a discount,\n  /// promotion or complimentary line.\n  SALES_DISCOUNT\n  /// Expense. Recognised at the exact landed cost of the allocated lot.\n  COST_OF_GOODS_SOLD\n  /// Expense. Expiry and damage.\n  INVENTORY_WRITE_OFF\n  /// Expense (or gain, when counted stock exceeds the book). Count variance.\n  INVENTORY_SHRINKAGE\n  OPERATING_EXPENSE\n  /// Asset. Value claimed back from a supplier for returned goods.\n  SUPPLIER_CLAIM_RECEIVABLE\n  CASH\n  BANK\n  ACCOUNTS_RECEIVABLE\n  LOYALTY_REDEMPTION\n  ACCOUNTS_PAYABLE\n  CASH_OVER_SHORT\n  OPENING_BALANCE_EQUITY\n}\n\n/// FIN-01 traceability: the operational table an entry accounts for. \\`sourceId\\`\n/// is a row id in that table.\nenum FinanceSourceKind {\n  PHARMACY_GOODS_RECEIPT\n  PHARMACY_SALE_LINE\n  PHARMACY_SALE_RETURN_LINE\n  PHARMACY_STOCK_WRITE_OFF\n  PHARMACY_SUPPLIER_CLAIM\n  PHARMACY_INTERBRANCH_TRANSFER_LINE\n  PHARMACY_INVENTORY_COUNT_LINE\n  PHARMACY_TENDER\n  PHARMACY_REFUND\n  PHARMACY_DAILY_CLOSE\n  PHARMACY_OPENING_STOCK\n  PHARMACY_OPENING_LEDGER\n  PHARMACY_BOOKKEEPING_TRANSACTION\n}\n\nenum PharmacyBookkeepingKind {\n  SUPPLIER_PAYMENT\n  CUSTOMER_RECEIPT\n  EXPENSE\n  PETTY_CASH\n  BANK_DEPOSIT\n  SETTLEMENT\n  VOUCHER\n  CHEQUE\n}\n\nenum PharmacyBookkeepingStatus {\n  PENDING\n  POSTED\n  REVERSED\n}\n\nenum PharmacyAllocationSourceKind {\n  PURCHASE_INVOICE\n  SUPPLIER_CREDIT\n  CUSTOMER_KHATA\n  EXPENSE\n}\n\nenum PharmacyChequeStatus {\n  NONE\n  PDC\n  CLEARED\n  BOUNCED\n}\n\nenum PharmacyAccountingPeriodStatus {\n  OPEN\n  CLOSED\n  REOPENED\n}\n\nenum PharmacyBankLineStatus {\n  UNMATCHED\n  MATCHED\n  REVERSED\n}\n\nenum PharmacyTaxProductClass {\n  MEDICINE\n  FRONT_SHOP\n}\n\nenum PharmacyTaxPriceMode {\n  EXCLUSIVE\n  INCLUSIVE\n}\n\nenum PharmacyTaxProfileStatus {\n  DRAFT\n  PUBLISHED\n  RETIRED\n}\n\nenum ExpenseCategory {\n  SALARIES\n  SUBSCRIPTIONS\n  OFFICE\n  MARKETING\n  HOSTING\n  SOFTWARE\n  HARDWARE\n  TRAVEL\n  UTILITIES\n  MISCELLANEOUS\n}\n\nenum ChannelType {\n  DM\n  GROUP\n  PROJECT\n}\n\nenum LeaveType {\n  VACATION\n  SICK\n  REMOTE\n}\n\nenum LeaveStatus {\n  PENDING\n  APPROVED\n  REJECTED\n}\n\nenum ClientStatus {\n  ACTIVE\n  INACTIVE\n  PROSPECT\n}\n\nenum ContractStatus {\n  DRAFT\n  SENT\n  SIGNED\n  EXPIRED\n  TERMINATED\n}\n\nenum NoteVisibility {\n  PRIVATE // only the author\n  SHARED // author + explicit users in NoteShare\n  TEAM // everyone in the company\n}\n\nenum NotePermission {\n  VIEW\n  EDIT\n}\n\n// ============================================\n// AUDIT LOG (admin-only, append-only)\n// ============================================\n\nenum AuditActorType {\n  USER // a logged-in session user\n  API_TOKEN // a df_ REST API token acting on behalf of a user\n  ANONYMOUS // no authenticated identity (e.g. a failed login attempt)\n  SYSTEM // an automated/internal process\n  RESTAURANT_OPERATOR // a restaurant staff operator acting at a terminal (M2 \\u2014 not a User)\n}\n\nenum AuditSource {\n  TRPC // a tRPC procedure call (the in-app UI)\n  REST_API // a /api/v1 call made with a df_ token\n  AUTH // an authentication event (login/logout)\n  SYSTEM // an internal/automated event\n}\n\nenum AuditOperation {\n  CREATE\n  READ\n  UPDATE\n  DELETE\n  LOGIN\n  LOGOUT\n  LOGIN_FAILED\n  EXECUTE\n  OTHER\n}\n\nenum AuditOutcome {\n  SUCCESS\n  FAILURE\n}\n\n// ============================================\n// PLATFORM CONTROL PLANE\n// ============================================\n\nenum PlatformRole {\n  SUPER_ADMIN\n  OPERATIONS\n  SALES\n  FINANCE\n  SUPPORT\n  AUDITOR\n}\n\nenum OrganizationStatus {\n  PROSPECT\n  ONBOARDING\n  ACTIVE\n  GRACE\n  SUSPENDED\n  TERMINATED\n  PURGING\n  PURGED\n}\n\nenum OrganizationDeploymentMode {\n  SHARED\n  DEDICATED\n}\n\nenum OrganizationModuleStatus {\n  ENABLED\n  DISABLED\n  TRIAL\n  EXPIRED\n}\n\nenum PermissionEffect {\n  ALLOW\n  DENY\n}\n\nenum LeadStatus {\n  NEW\n  QUALIFIED\n  DISQUALIFIED\n  CONVERTED\n}\n\nenum OpportunityStage {\n  DISCOVERY\n  QUALIFIED\n  PROPOSAL\n  NEGOTIATION\n  WON\n  LOST\n}\n\nenum ProposalStatus {\n  DRAFT\n  SENT\n  ACCEPTED\n  REJECTED\n  EXPIRED\n}\n\nenum FollowUpStatus {\n  OPEN\n  COMPLETED\n  CANCELLED\n}\n\nenum CommercialContractStatus {\n  DRAFT\n  ACTIVE\n  GRACE\n  EXPIRED\n  TERMINATED\n  RENEWAL_DUE\n}\n\nenum BillingInterval {\n  MONTHLY\n  QUARTERLY\n  ANNUAL\n  CUSTOM\n}\n\nenum PlatformInvoiceStatus {\n  DRAFT\n  ISSUED\n  PARTIALLY_PAID\n  PAID\n  OVERDUE\n  VOID\n}\n\nenum PlatformPaymentStatus {\n  PENDING\n  SUCCEEDED\n  FAILED\n  REFUNDED\n  PARTIALLY_REFUNDED\n}\n\nenum RenewalStatus {\n  UPCOMING\n  IN_PROGRESS\n  RENEWED\n  LOST\n}\n\nenum DomainVerificationStatus {\n  PENDING\n  VERIFIED\n  FAILED\n}\n\nenum IdentityProtocol {\n  OIDC\n  SAML\n}\n\nenum IdentityConnectionStatus {\n  DRAFT\n  ACTIVE\n  DISABLED\n  ERROR\n}\n\nenum DeploymentStatus {\n  PENDING\n  PROVISIONING\n  READY\n  DEGRADED\n  FAILED\n  DECOMMISSIONED\n}\n\nenum PlatformJobType {\n  PROVISION_SHARED\n  PROVISION_DEDICATED\n  CONFIGURE_DOMAIN\n  APPLY_BRAND\n  SYNC_IDENTITY\n  EXPORT_DATA\n  PURGE_DATA\n  SUSPEND\n  RESUME\n}\n\nenum PlatformJobStatus {\n  QUEUED\n  RUNNING\n  SUCCEEDED\n  FAILED\n  CANCELLED\n}\n\nenum SupportSessionStatus {\n  ACTIVE\n  ENDED\n  REVOKED\n  EXPIRED\n}\n\nenum LifecycleAction {\n  CREATED\n  ACTIVATED\n  ENTERED_GRACE\n  SUSPENDED\n  RESUMED\n  TERMINATED\n  PURGE_SCHEDULED\n  PURGED\n}\n\n/// Lifecycle of one materialised meeting instance. DRAFT is a slot the\n/// organizer has not published; SCHEDULED is published but not joinable;\n/// OPEN means the join window is open; ACTIVE means the media room has\n/// participants; ENDING is the drain phase; ENDED and CANCELLED are terminal.\nenum MeetingOccurrenceStatus {\n  DRAFT\n  SCHEDULED\n  OPEN\n  ACTIVE\n  ENDING\n  ENDED\n  CANCELLED\n}\n\nenum MeetingParticipantRole {\n  HOST\n  COHOST\n  PRESENTER\n  ATTENDEE\n  OBSERVER\n}\n\nenum MeetingInviteStatus {\n  PENDING\n  ACCEPTED\n  DECLINED\n  TENTATIVE\n}\n\nenum MeetingLobbyStatus {\n  NOT_REQUIRED\n  WAITING\n  ADMITTED\n  DENIED\n}\n\n/// Provenance of a participant session row. WEBHOOK rows are signed by the\n/// media provider and are the only ones that may be treated as evidence.\n/// LEGACY_CLIENT rows were reported by the browser before webhooks existed \\u2014\n/// they were backfilled from MeetingAttendanceLog and are self-reported.\nenum MeetingSessionSource {\n  WEBHOOK\n  LEGACY_CLIENT\n  MANUAL\n}\n\n// ============================================\n// AUTH & USERS\n// ============================================\n\nmodel User {\n  id                 String     @id @default(cuid())\n  organizationId     String     @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  organizationRoleId String?\n  name               String\n  email              String\n  password           String?\n  role               Role       @default(EMPLOYEE)\n  department         String\n  title              String\n  avatar             String?\n  phone              String?\n  bio                String?\n  skills             String[]   @default([])\n  startDate          DateTime   @default(now())\n  status             UserStatus @default(ACTIVE)\n  lastActiveAt       DateTime?\n  // AUTH-01 / IMP-AUTH-03: bumped on password change, admin reset, and lay-off so\n  // all other live JWT sessions are invalidated on the next jwt() revalidation.\n  // \"Sign out everywhere\" bumps it too. passwordChangedAt is kept for display/audit.\n  tokenVersion       Int        @default(0)\n  passwordChangedAt  DateTime?\n  // IMP-DASH-02: per-user dashboard widget layout/visibility prefs (JSON blob).\n  preferences        Json?\n  // IMP-AUTH-04: per-type/channel notification opt-outs, honored by notify().\n  notificationPrefs  Json?\n  // IMP-AUTH-02: TOTP 2FA. Secret is base32; enabledAt null = 2FA off (the secret\n  // may exist transiently during enrolment before the first verify).\n  twoFactorSecret    String?\n  twoFactorEnabledAt DateTime?\n  createdAt          DateTime   @default(now())\n  updatedAt          DateTime   @updatedAt\n\n  // Relations\n  organization                Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)\n  organizationDepartment      OrganizationDepartment         @relation(fields: [organizationId, department], references: [organizationId, key])\n  organizationRole            OrganizationRole?              @relation(fields: [organizationRoleId], references: [id], onDelete: SetNull)\n  permissionOverrides         UserPermissionOverride[]\n  projectMembers              ProjectMember[]\n  assignedTasks               TaskAssignee[]\n  taskComments                TaskComment[]\n  createdTasks                Task[]                         @relation(\"TaskCreator\")\n  sentMessages                Message[]\n  channelMembers              ChannelMember[]\n  createdChannels             Channel[]\n  messageMentions             MessageMention[]\n  pinnedMessages              PinnedMessage[]\n  savedMessages               SavedMessage[]\n  leaveRequests               LeaveRequest[]                 @relation(\"LeaveRequester\")\n  approvedLeaves              LeaveRequest[]                 @relation(\"LeaveApprover\")\n  performanceNotes            PerformanceNote[]              @relation(\"NoteSubject\")\n  writtenNotes                PerformanceNote[]              @relation(\"NoteAuthor\")\n  activities                  Activity[]\n  notifications               Notification[]\n  pharmacyOwnerDigestSettings PharmacyOwnerDigestSetting[]\n  pharmacyOwnerDigestCaptures PharmacyOwnerDigestCapture[]\n  uploadedFiles               ProjectFile[]\n  uploadedDocs                Document[]\n  timeEntries                 TimeEntry[]\n  meetingAttendees            MeetingAttendee[]\n  apiTokens                   ApiToken[]\n  authoredNotes               Note[]                         @relation(\"NoteAuthor\")\n  noteShares                  NoteShare[]\n  columnDefaults              ColumnDefaultAssignee[]\n  attendanceLog               MeetingAttendanceLog[]\n  invitation                  Invitation?                    @relation(\"UserInvitation\")\n  invitationsSent             Invitation[]                   @relation(\"InvitationsSent\")\n  passwordResetTokens         PasswordResetToken[]\n  // IMP-HR-04 performance reviews + IMP-NOTE-02 note mentions\n  reviewCyclesCreated         ReviewCycle[]                  @relation(\"ReviewCycleCreator\")\n  reviewsAbout                Review[]                       @relation(\"ReviewSubject\")\n  reviewsWritten              Review[]                       @relation(\"ReviewReviewer\")\n  noteMentions                NoteMention[]\n  // Big Bets: NOTE-01 versioning, HR-01 leave balances, AUTH-02 recovery codes\n  noteRevisions               NoteRevision[]                 @relation(\"NoteRevisionEditor\")\n  leaveBalances               LeaveBalance[]                 @relation(\"UserLeaveBalances\")\n  recoveryCodes               TwoFactorRecoveryCode[]\n  webhooksCreated             Webhook[]                      @relation(\"WebhookCreator\")\n  auditLogs                   AuditLog[]                     @relation(\"UserAuditLogs\")\n  resignations                Resignation[]                  @relation(\"UserResignations\")\n  resignationsReviewed        Resignation[]                  @relation(\"ResignationsReviewed\")\n  // Email integration: connected Gmail/Outlook mailboxes feeding the unified inbox.\n  mailboxes                   Mailbox[]\n  ssoTickets                  TenantSsoTicket[]\n  // MEET-01\n  meetingParticipants         MeetingParticipant[]\n  meetingAdmissions           MeetingOccurrenceParticipant[]\n  meetingSessions             MeetingParticipantSession[]\n  // \\xA74.1: restaurant branch assignments (branch-level authorization seam).\n  restaurantBranchAssignments RestaurantBranchAssignment[]\n  // M2-L1/C3: optional one-way link from an operator staff profile back to a\n  // web-login User. A User may back zero or many staff profiles; a staff\n  // profile need not have one at all.\n  restaurantStaffProfiles     RestaurantStaffProfile[]       @relation(\"RestaurantStaffUser\")\n  pharmacyCustomer            PharmacyCustomer?              @relation(\"PharmacyCustomerUser\")\n  pharmacyOrdersPlaced        PharmacyCustomerOrder[]        @relation(\"PharmacyOrderPlacedBy\")\n  pharmacyOrdersRun           PharmacyCustomerOrder[]        @relation(\"PharmacyOrderRunner\")\n  pharmacyOrderEvents         PharmacyCustomerOrderEvent[]   @relation(\"PharmacyOrderEventActor\")\n\n  @@unique([organizationId, id])\n  @@unique([organizationId, email])\n  @@index([organizationId])\n  @@map(\"users\")\n}\n\n// A self-service \"quit the company\" request. An employee submits one (reason +\n// proposed last working day); it sits PENDING until an HR or ADMIN reviewer\n// approves/declines it. Approval records the confirmed lastWorkingDay but does\n// NOT itself deactivate the account \\u2014 offboarding happens on/after that day\n// (e.g. via the Lay-off action), so access is not pulled out from under someone\n// who is still working their notice period.\nmodel Resignation {\n  id              String            @id @default(cuid())\n  organizationId  String            @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  userId          String\n  reason          String\n  proposedLastDay DateTime\n  status          ResignationStatus @default(PENDING)\n  reviewedById    String?\n  reviewedAt      DateTime?\n  reviewNote      String?\n  lastWorkingDay  DateTime?\n  createdAt       DateTime          @default(now())\n  updatedAt       DateTime          @updatedAt\n\n  user       User  @relation(\"UserResignations\", fields: [userId], references: [id], onDelete: Cascade)\n  reviewedBy User? @relation(\"ResignationsReviewed\", fields: [reviewedById], references: [id], onDelete: SetNull)\n\n  @@index([status])\n  @@index([userId])\n  @@index([organizationId])\n  @@map(\"resignations\")\n}\n\n// A pending invitation for a User created in the INVITED state. The raw token is\n// emailed to the invitee; only its SHA-256 hash is stored here. Accepting the\n// invite sets the user's password, flips status to ACTIVE, and stamps acceptedAt.\nmodel Invitation {\n  id             String    @id @default(cuid())\n  organizationId String    @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  userId         String    @unique\n  user           User      @relation(\"UserInvitation\", fields: [userId], references: [id], onDelete: Cascade)\n  email          String\n  tokenHash      String    @unique\n  invitedById    String?\n  invitedBy      User?     @relation(\"InvitationsSent\", fields: [invitedById], references: [id], onDelete: SetNull)\n  expiresAt      DateTime\n  acceptedAt     DateTime?\n  createdAt      DateTime  @default(now())\n  updatedAt      DateTime  @updatedAt\n\n  @@index([organizationId])\n  @@map(\"invitations\")\n}\n\n// IMP-AUTH-01: self-service password reset. Single-use, expiring token; only the\n// SHA-256 hash is stored (raw token is emailed once), mirroring Invitation.\nmodel PasswordResetToken {\n  id             String    @id @default(cuid())\n  organizationId String    @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  userId         String\n  tokenHash      String    @unique\n  expiresAt      DateTime\n  usedAt         DateTime?\n  createdAt      DateTime  @default(now())\n\n  user User @relation(fields: [userId], references: [id], onDelete: Cascade)\n\n  @@index([userId])\n  @@index([organizationId])\n  @@map(\"password_reset_tokens\")\n}\n\n// IMP-HR-04: a real performance-review process (cycles + per-subject reviews),\n// distinct from the freeform PerformanceNote table.\nmodel ReviewCycle {\n  id             String   @id @default(cuid())\n  organizationId String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  name           String\n  startDate      DateTime\n  endDate        DateTime\n  status         String   @default(\"OPEN\") // OPEN | CLOSED\n  createdById    String\n  createdAt      DateTime @default(now())\n  updatedAt      DateTime @updatedAt\n\n  createdBy User     @relation(\"ReviewCycleCreator\", fields: [createdById], references: [id])\n  reviews   Review[]\n\n  @@index([organizationId])\n  @@map(\"review_cycles\")\n}\n\nmodel Review {\n  id             String    @id @default(cuid())\n  organizationId String    @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  cycleId        String\n  subjectId      String\n  reviewerId     String\n  rating         Int? // 1..5\n  strengths      String?\n  improvements   String?\n  comments       String?\n  status         String    @default(\"DRAFT\") // DRAFT | SUBMITTED\n  submittedAt    DateTime?\n  createdAt      DateTime  @default(now())\n  updatedAt      DateTime  @updatedAt\n\n  cycle    ReviewCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)\n  subject  User        @relation(\"ReviewSubject\", fields: [subjectId], references: [id], onDelete: Cascade)\n  reviewer User        @relation(\"ReviewReviewer\", fields: [reviewerId], references: [id], onDelete: Cascade)\n\n  @@unique([cycleId, subjectId, reviewerId])\n  @@index([subjectId])\n  @@index([reviewerId])\n  @@index([organizationId])\n  @@map(\"reviews\")\n}\n\n// ============================================\n// CLIENTS\n// ============================================\n\nmodel Client {\n  id             String       @id @default(cuid())\n  organizationId String       @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  name           String\n  logo           String?\n  website        String?\n  industry       String?\n  location       String?\n  timezone       String?\n  notes          String?\n  status         ClientStatus @default(ACTIVE)\n  createdAt      DateTime     @default(now())\n  updatedAt      DateTime     @updatedAt\n\n  // Relations\n  contacts     ClientContact[]\n  projects     Project[]\n  invoices     Invoice[]\n  documents    Document[]\n  transactions Transaction[]\n  richNotes    Note[]\n  contracts    Contract[]\n  meetingLinks MeetingEntityLink[]\n\n  @@index([organizationId])\n  @@map(\"clients\")\n}\n\nmodel ClientContact {\n  id             String   @id @default(cuid())\n  organizationId String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  clientId       String\n  name           String\n  email          String?\n  phone          String?\n  role           String?\n  isPrimary      Boolean  @default(false)\n  createdAt      DateTime @default(now())\n  updatedAt      DateTime @updatedAt\n\n  client              Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)\n  meetingParticipants MeetingParticipant[]\n\n  @@index([organizationId])\n  @@map(\"client_contacts\")\n}\n\nmodel Contract {\n  id             String         @id @default(cuid())\n  organizationId String         @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  clientId       String\n  title          String\n  fileUrl        String? // link to the signed document\n  value          Decimal?       @db.Decimal(12, 2)\n  currency       Currency       @default(USD)\n  status         ContractStatus @default(DRAFT)\n  startDate      DateTime?\n  endDate        DateTime?\n  signedAt       DateTime?\n  notes          String?\n  // IMP-CLI-05: optionally tie a contract to the delivery project it funds.\n  projectId      String?\n  createdAt      DateTime       @default(now())\n  updatedAt      DateTime       @updatedAt\n\n  client  Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)\n  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)\n\n  @@index([clientId])\n  @@index([status])\n  @@index([projectId])\n  @@index([organizationId])\n  @@map(\"contracts\")\n}\n\n// ============================================\n// PROJECTS\n// ============================================\n\nmodel Project {\n  id             String        @id @default(cuid())\n  organizationId String        @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  name           String\n  description    String?\n  status         ProjectStatus @default(ACTIVE)\n  type           ProjectType\n  startDate      DateTime?\n  endDate        DateTime?\n  techStack      String[]      @default([])\n  budget         Decimal?      @db.Decimal(12, 2)\n  clientId       String?\n  createdAt      DateTime      @default(now())\n  updatedAt      DateTime      @updatedAt\n\n  // Relations\n  client       Client?             @relation(fields: [clientId], references: [id], onDelete: SetNull)\n  members      ProjectMember[]\n  boards       Board[]\n  milestones   Milestone[]\n  files        ProjectFile[]\n  invoices     Invoice[]\n  transactions Transaction[]\n  timeEntries  TimeEntry[]\n  notes        Note[]\n  contracts    Contract[] // IMP-CLI-05: contracts linked to this delivery project\n  meetingLinks MeetingEntityLink[]\n\n  @@index([organizationId])\n  @@map(\"projects\")\n}\n\nmodel ProjectMember {\n  id             String @id @default(cuid())\n  organizationId String @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  projectId      String\n  userId         String\n  role           String @default(\"MEMBER\") // LEAD, MEMBER\n\n  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)\n  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)\n\n  @@unique([projectId, userId])\n  @@index([userId])\n  @@index([organizationId])\n  @@map(\"project_members\")\n}\n\n// ============================================\n// KANBAN BOARDS\n// ============================================\n\nmodel Board {\n  id             String   @id @default(cuid())\n  organizationId String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  name           String\n  description    String?\n  projectId      String\n  trelloBoardId  String?  @unique\n  createdAt      DateTime @default(now())\n  updatedAt      DateTime @updatedAt\n\n  // Relations\n  project Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)\n  columns Column[]\n  labels  Label[]\n\n  @@index([organizationId])\n  @@map(\"boards\")\n}\n\nmodel Column {\n  id             String   @id @default(cuid())\n  organizationId String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  name           String\n  boardId        String\n  order          Int\n  // IMP-PROJ-07: optional work-in-progress limit; the board warns/blocks past it.\n  wipLimit       Int?\n  createdAt      DateTime @default(now())\n  updatedAt      DateTime @updatedAt\n\n  // Relations\n  board            Board                   @relation(fields: [boardId], references: [id], onDelete: Cascade)\n  tasks            Task[]\n  defaultAssignees ColumnDefaultAssignee[]\n\n  @@index([organizationId])\n  @@map(\"columns\")\n}\n\n// When a task enters this column (created here or moved in), each user in\n// this list is added to the task's assignees (additively, via skipDuplicates).\nmodel ColumnDefaultAssignee {\n  id             String   @id @default(cuid())\n  organizationId String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  columnId       String\n  userId         String\n  createdAt      DateTime @default(now())\n\n  column Column @relation(fields: [columnId], references: [id], onDelete: Cascade)\n  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)\n\n  @@unique([columnId, userId])\n  @@index([userId])\n  @@index([organizationId])\n  @@map(\"column_default_assignees\")\n}\n\nmodel Label {\n  id             String @id @default(cuid())\n  organizationId String @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  name           String\n  color          String // hex color\n  boardId        String\n\n  // Relations\n  board Board       @relation(fields: [boardId], references: [id], onDelete: Cascade)\n  tasks TaskLabel[]\n\n  @@index([organizationId])\n  @@map(\"labels\")\n}\n\nmodel Task {\n  id             String    @id @default(cuid())\n  organizationId String    @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  title          String\n  description    String?\n  columnId       String\n  order          Int\n  priority       Priority  @default(MEDIUM)\n  dueDate        DateTime?\n  createdById    String\n  // IMP-PROJ-06: optional parent for subtasks (self-relation).\n  parentId       String?\n  createdAt      DateTime  @default(now())\n  updatedAt      DateTime  @updatedAt\n\n  // Relations\n  column       Column              @relation(fields: [columnId], references: [id], onDelete: Cascade)\n  createdBy    User                @relation(\"TaskCreator\", fields: [createdById], references: [id])\n  parent       Task?               @relation(\"TaskSubtasks\", fields: [parentId], references: [id], onDelete: SetNull)\n  subtasks     Task[]              @relation(\"TaskSubtasks\")\n  blockedBy    TaskBlocker[]       @relation(\"BlockedTask\")\n  blocking     TaskBlocker[]       @relation(\"BlockingTask\")\n  assignees    TaskAssignee[]\n  labels       TaskLabel[]\n  checklists   TaskChecklist[]\n  comments     TaskComment[]\n  attachments  TaskAttachment[]\n  timeEntries  TimeEntry[]\n  meetingLinks MeetingEntityLink[]\n\n  @@index([columnId, order])\n  @@index([createdById])\n  @@index([parentId])\n  @@index([organizationId])\n  @@map(\"tasks\")\n}\n\n// IMP-PROJ-06: a \"blocked-by\" edge between two tasks. Cycle prevention lives in\n// the router (reject an edge that would close a loop), not the DB.\nmodel TaskBlocker {\n  id             String   @id @default(cuid())\n  organizationId String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  blockedTaskId  String\n  blockingTaskId String\n  createdAt      DateTime @default(now())\n\n  blockedTask  Task @relation(\"BlockedTask\", fields: [blockedTaskId], references: [id], onDelete: Cascade)\n  blockingTask Task @relation(\"BlockingTask\", fields: [blockingTaskId], references: [id], onDelete: Cascade)\n\n  @@unique([blockedTaskId, blockingTaskId])\n  @@index([blockingTaskId])\n  @@index([organizationId])\n  @@map(\"task_blockers\")\n}\n\nmodel TaskAssignee {\n  id             String @id @default(cuid())\n  organizationId String @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  taskId         String\n  userId         String\n\n  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)\n  user User @relation(fields: [userId], references: [id], onDelete: Cascade)\n\n  @@unique([taskId, userId])\n  @@index([userId])\n  @@index([organizationId])\n  @@map(\"task_assignees\")\n}\n\nmodel TaskLabel {\n  id             String @id @default(cuid())\n  organizationId String @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  taskId         String\n  labelId        String\n\n  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)\n  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)\n\n  @@unique([taskId, labelId])\n  @@index([organizationId])\n  @@map(\"task_labels\")\n}\n\nmodel TaskChecklist {\n  id             String @id @default(cuid())\n  organizationId String @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  name           String\n  taskId         String\n  order          Int    @default(0)\n\n  task  Task                @relation(fields: [taskId], references: [id], onDelete: Cascade)\n  items TaskChecklistItem[]\n\n  @@index([organizationId])\n  @@map(\"task_checklists\")\n}\n\nmodel TaskChecklistItem {\n  id             String  @id @default(cuid())\n  organizationId String  @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  text           String\n  completed      Boolean @default(false)\n  checklistId    String\n  order          Int     @default(0)\n\n  checklist TaskChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)\n\n  @@index([organizationId])\n  @@map(\"task_checklist_items\")\n}\n\nmodel TaskComment {\n  id             String   @id @default(cuid())\n  organizationId String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  content        String\n  taskId         String\n  userId         String\n  parentId       String?\n  createdAt      DateTime @default(now())\n  updatedAt      DateTime @updatedAt\n\n  task    Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)\n  user    User          @relation(fields: [userId], references: [id])\n  parent  TaskComment?  @relation(\"CommentThread\", fields: [parentId], references: [id])\n  replies TaskComment[] @relation(\"CommentThread\")\n\n  @@index([taskId])\n  @@index([userId, createdAt])\n  @@index([organizationId])\n  @@map(\"task_comments\")\n}\n\nmodel TaskAttachment {\n  id             String   @id @default(cuid())\n  organizationId String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  name           String\n  url            String\n  type           String?\n  size           Int?\n  taskId         String\n  createdAt      DateTime @default(now())\n\n  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)\n\n  @@index([organizationId])\n  @@map(\"task_attachments\")\n}\n\n// ============================================\n// TIME TRACKING\n// ============================================\n\nmodel TimeEntry {\n  id             String   @id @default(cuid())\n  organizationId String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  userId         String\n  taskId         String?\n  projectId      String\n  description    String?\n  hours          Decimal  @db.Decimal(5, 2)\n  date           DateTime\n  createdAt      DateTime @default(now())\n  updatedAt      DateTime @updatedAt\n\n  user    User    @relation(fields: [userId], references: [id])\n  task    Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)\n  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)\n\n  @@index([organizationId])\n  @@map(\"time_entries\")\n}\n\n// ============================================\n// FINANCE\n// ============================================\n\nmodel Invoice {\n  id             String        @id @default(cuid())\n  organizationId String        @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  invoiceNumber  String        @unique\n  clientId       String\n  projectId      String?\n  items          Json // [{description, quantity, rate, amount}]\n  subtotal       Decimal       @db.Decimal(12, 2)\n  tax            Decimal       @default(0) @db.Decimal(12, 2)\n  total          Decimal       @db.Decimal(12, 2)\n  currency       Currency      @default(USD)\n  status         InvoiceStatus @default(DRAFT)\n  dueDate        DateTime\n  paidAt         DateTime?\n  sentAt         DateTime?\n  notes          String?\n  createdAt      DateTime      @default(now())\n  updatedAt      DateTime      @updatedAt\n\n  client   Client    @relation(fields: [clientId], references: [id])\n  project  Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)\n  payments Payment[] // IMP-FIN-04: partial payments recorded against this invoice\n\n  @@index([status])\n  @@index([clientId])\n  @@index([projectId])\n  @@index([organizationId])\n  @@map(\"invoices\")\n}\n\n// IMP-FIN-04: a (partial) payment against an invoice. Invoice flips to PAID when\n// the sum of payments covers the total; OVERDUE automation is in the finance router.\nmodel Payment {\n  id             String   @id @default(cuid())\n  organizationId String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  invoiceId      String\n  amount         Decimal  @db.Decimal(12, 2)\n  currency       Currency @default(USD)\n  method         String?\n  note           String?\n  paidAt         DateTime @default(now())\n  createdAt      DateTime @default(now())\n\n  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)\n\n  @@index([invoiceId])\n  @@index([organizationId])\n  @@map(\"payments\")\n}\n\nmodel Transaction {\n  id             String           @id @default(cuid())\n  organizationId String           @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  type           TransactionType\n  amount         Decimal          @db.Decimal(12, 2)\n  currency       Currency         @default(USD)\n  category       ExpenseCategory?\n  description    String\n  projectId      String?\n  clientId       String?\n  receiptUrl     String?\n  date           DateTime\n  createdAt      DateTime         @default(now())\n  updatedAt      DateTime         @updatedAt\n\n  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)\n  client  Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)\n\n  @@index([clientId])\n  @@index([date])\n  @@index([type])\n  @@index([organizationId])\n  @@map(\"transactions\")\n}\n\nmodel RecurringExpense {\n  id             String          @id @default(cuid())\n  organizationId String          @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  name           String\n  amount         Decimal         @db.Decimal(12, 2)\n  currency       Currency        @default(USD)\n  category       ExpenseCategory\n  interval       String // monthly, yearly, quarterly\n  nextDueDate    DateTime\n  vendorName     String?\n  active         Boolean         @default(true)\n  createdAt      DateTime        @default(now())\n  updatedAt      DateTime        @updatedAt\n\n  @@index([organizationId])\n  @@map(\"recurring_expenses\")\n}\n\n/// FIN-01 / \\xA78A invariant 15 \\u2014 the shared double-entry journal. One entry per\n/// operational event, named by \\`sourceKind\\` + \\`sourceId\\` so every posting is\n/// traceable back to the row that caused it, and balanced by a DEFERRABLE\n/// constraint trigger (debits = credits at COMMIT, not per statement, so an\n/// adapter may write its legs one at a time).\n///\n/// APPEND-ONLY. Entries and lines are never updated or deleted (trigger). A\n/// correction is a new entry whose \\`reversesEntryId\\` names the original and\n/// whose lines are the originals with their sides swapped \\u2014 additive, linked,\n/// and at most once per entry.\nmodel FinanceJournalEntry {\n  id              String            @id @default(cuid())\n  organizationId  String            @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  /// Null for an organization-level event. Line-level \\`branchId\\` is what the\n  /// FIN-03 reads group by, because one entry (an inter-branch transfer) can\n  /// legitimately span two branches.\n  branchId        String?\n  sourceKind      FinanceSourceKind\n  /// The primary key of the operational row this entry accounts for.\n  sourceId        String\n  description     String\n  currency        Currency          @default(PKR)\n  actorId         String\n  occurredAt      DateTime\n  idempotencyKey  String\n  reversesEntryId String?\n  reversalReason  String?\n  createdAt       DateTime          @default(now())\n\n  reverses FinanceJournalEntry?  @relation(\"FinanceEntryReversal\", fields: [organizationId, reversesEntryId], references: [organizationId, id], onDelete: Restrict, map: \"finance_journal_entries_reverses_fkey\")\n  reversal FinanceJournalEntry[] @relation(\"FinanceEntryReversal\")\n  lines    FinanceJournalLine[]\n\n  @@unique([organizationId, id], map: \"finance_journal_entries_org_id_key\")\n  @@unique([organizationId, idempotencyKey], map: \"finance_journal_entries_org_idempotency_key\")\n  @@unique([organizationId, reversesEntryId], map: \"finance_journal_entries_org_reverses_key\")\n  @@index([organizationId, sourceKind, sourceId], map: \"finance_journal_entries_org_source_idx\")\n  @@index([organizationId, branchId, occurredAt], map: \"finance_journal_entries_org_branch_occurred_idx\")\n  @@map(\"finance_journal_entries\")\n}\n\n/// One leg of a journal entry. \\`amountMinor\\` is a NON-NEGATIVE integer in minor\n/// units; direction lives in \\`side\\`, so no leg is ever a signed amount whose\n/// sign has to be interpreted. The dimension columns are deliberately plain\n/// identifiers with no foreign key: the journal is shared across verticals and\n/// must not depend on any one vertical's tables.\nmodel FinanceJournalLine {\n  id             String             @id @default(cuid())\n  organizationId String             @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  entryId        String\n  accountCode    FinanceAccountCode\n  side           FinanceJournalSide\n  amountMinor    Int\n  branchId       String?\n  /// FIN-03 analysis dimensions: product, stock lot, stock location, and the\n  /// operational line this leg belongs to (a sale line, a receipt line).\n  productId      String?\n  lotId          String?\n  locationId     String?\n  sourceLineId   String?\n  memo           String?\n  createdAt      DateTime           @default(now())\n\n  entry FinanceJournalEntry @relation(fields: [organizationId, entryId], references: [organizationId, id], onDelete: Restrict, map: \"finance_journal_lines_entry_fkey\")\n\n  @@unique([organizationId, id], map: \"finance_journal_lines_org_id_key\")\n  @@index([organizationId, entryId], map: \"finance_journal_lines_org_entry_idx\")\n  @@index([organizationId, accountCode, branchId], map: \"finance_journal_lines_org_account_branch_idx\")\n  @@index([organizationId, lotId, locationId], map: \"finance_journal_lines_org_lot_location_idx\")\n  @@map(\"finance_journal_lines\")\n}\n\n/// FIN-02 \\u2014 one operator-entered money movement. All posted rows have a\n/// balanced \\`FinanceJournalEntry\\`; reversal is additive and links that entry.\nmodel PharmacyBookkeepingTransaction {\n  id               String                    @id @default(cuid())\n  organizationId   String                    @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId         String\n  reference        String\n  kind             PharmacyBookkeepingKind\n  status           PharmacyBookkeepingStatus @default(PENDING)\n  counterpartyName String?\n  amountMinor      Int\n  currency         Currency                  @default(PKR)\n  occurredAt       DateTime\n  memo             String?\n  chequeNumber     String?\n  chequeDueAt      DateTime?\n  chequeStatus     PharmacyChequeStatus      @default(NONE)\n  bankReference    String?\n  idempotencyKey   String\n  createdByUserId  String\n  postedAt         DateTime?\n  reversedAt       DateTime?\n  reversalReason   String?\n  journalEntryId   String?\n  reversalEntryId  String?\n  createdAt        DateTime                  @default(now())\n\n  allocations PharmacyBookkeepingAllocation[]\n  bankMatches PharmacyBankReconciliation[]\n\n  @@unique([organizationId, id])\n  @@unique([organizationId, reference])\n  @@unique([organizationId, idempotencyKey])\n  @@index([organizationId, branchId, occurredAt])\n  @@index([organizationId, status, kind])\n  @@map(\"pharmacy_bookkeeping_transactions\")\n}\n\n/// Allocation remains explicit so partial supplier/customer settlement and\n/// its reversal can be reconciled without mutating the source invoice/khata.\nmodel PharmacyBookkeepingAllocation {\n  id              String                       @id @default(cuid())\n  organizationId  String                       @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  transactionId   String\n  sourceKind      PharmacyAllocationSourceKind\n  sourceId        String\n  sourceReference String\n  amountMinor     Int\n  createdAt       DateTime                     @default(now())\n\n  transaction PharmacyBookkeepingTransaction @relation(fields: [organizationId, transactionId], references: [organizationId, id], onDelete: Restrict)\n\n  @@unique([organizationId, id])\n  @@unique([organizationId, transactionId, sourceKind, sourceId])\n  @@index([organizationId, sourceKind, sourceId])\n  @@map(\"pharmacy_bookkeeping_allocations\")\n}\n\nmodel PharmacyAccountingPeriod {\n  id               String                         @id @default(cuid())\n  organizationId   String                         @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId         String\n  startsAt         DateTime\n  endsAt           DateTime\n  status           PharmacyAccountingPeriodStatus @default(OPEN)\n  closedAt         DateTime?\n  closedByUserId   String?\n  reopenedAt       DateTime?\n  reopenedByUserId String?\n  reopenReason     String?\n  createdAt        DateTime                       @default(now())\n\n  @@unique([organizationId, id])\n  @@unique([organizationId, branchId, startsAt, endsAt])\n  @@index([organizationId, branchId, status])\n  @@map(\"pharmacy_accounting_periods\")\n}\n\nmodel PharmacySettlementBatch {\n  id              String             @id @default(cuid())\n  organizationId  String             @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId        String\n  reference       String\n  provider        String\n  tenderType      PharmacyTenderType\n  businessDate    DateTime           @db.Date\n  expectedMinor   Int\n  settledMinor    Int?\n  settledAt       DateTime?\n  bankReference   String?\n  createdByUserId String\n  createdAt       DateTime           @default(now())\n\n  tenders PharmacySettlementTender[]\n\n  @@unique([organizationId, id])\n  @@unique([organizationId, reference])\n  @@index([organizationId, branchId, businessDate])\n  @@map(\"pharmacy_settlement_batches\")\n}\n\nmodel PharmacySettlementTender {\n  id                String @id @default(cuid())\n  organizationId    String @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  settlementBatchId String\n  tenderId          String\n  amountMinor       Int\n\n  settlementBatch PharmacySettlementBatch @relation(fields: [organizationId, settlementBatchId], references: [organizationId, id], onDelete: Restrict)\n  tender          PharmacyTender          @relation(fields: [organizationId, tenderId], references: [organizationId, id], onDelete: Restrict)\n\n  @@unique([organizationId, id])\n  @@unique([organizationId, settlementBatchId, tenderId])\n  @@unique([organizationId, tenderId])\n  @@map(\"pharmacy_settlement_tenders\")\n}\n\nmodel PharmacyBankStatementLine {\n  id             String                 @id @default(cuid())\n  organizationId String                 @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId       String\n  statementRef   String\n  lineReference  String\n  bookedAt       DateTime\n  amountMinor    Int\n  description    String\n  status         PharmacyBankLineStatus @default(UNMATCHED)\n  createdAt      DateTime               @default(now())\n\n  matches PharmacyBankReconciliation[]\n\n  @@unique([organizationId, id])\n  @@unique([organizationId, statementRef, lineReference])\n  @@index([organizationId, branchId, bookedAt])\n  @@map(\"pharmacy_bank_statement_lines\")\n}\n\nmodel PharmacyBankReconciliation {\n  id              String    @id @default(cuid())\n  organizationId  String    @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  statementLineId String\n  transactionId   String\n  amountMinor     Int\n  matchedByUserId String\n  matchedAt       DateTime  @default(now())\n  reversedAt      DateTime?\n  reversalReason  String?\n\n  statementLine PharmacyBankStatementLine      @relation(fields: [organizationId, statementLineId], references: [organizationId, id], onDelete: Restrict)\n  transaction   PharmacyBookkeepingTransaction @relation(fields: [organizationId, transactionId], references: [organizationId, id], onDelete: Restrict)\n\n  @@unique([organizationId, id])\n  @@unique([organizationId, statementLineId, transactionId])\n  @@index([organizationId, transactionId])\n  @@map(\"pharmacy_bank_reconciliations\")\n}\n\n/// FIN-04 \\u2014 pharmacy-specific metadata around the neutral tax calculation\n/// contract. Published versions are immutable and non-overlapping per branch.\nmodel PharmacyTaxProfileVersion {\n  id                String                   @id @default(cuid())\n  organizationId    String                   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId          String\n  versionNumber     Int\n  name              String\n  status            PharmacyTaxProfileStatus @default(DRAFT)\n  effectiveFrom     DateTime\n  effectiveTo       DateTime?\n  approvalReference String?\n  approvedAt        DateTime?\n  approvedByUserId  String?\n  idempotencyKey    String\n  createdAt         DateTime                 @default(now())\n\n  rules PharmacyTaxRuleVersion[]\n\n  @@unique([organizationId, id])\n  @@unique([organizationId, idempotencyKey])\n  @@unique([organizationId, branchId, versionNumber])\n  @@index([organizationId, branchId, status, effectiveFrom])\n  @@map(\"pharmacy_tax_profile_versions\")\n}\n\nmodel PharmacyTaxRuleVersion {\n  id               String                  @id @default(cuid())\n  organizationId   String                  @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  profileVersionId String\n  productClass     PharmacyTaxProductClass\n  pctHsCode        String\n  sroReference     String?\n  sroProvisional   Boolean                 @default(true)\n  exemptionCode    String?\n  priceMode        PharmacyTaxPriceMode\n  rate             Decimal                 @db.Decimal(9, 6)\n  roundingScale    Int                     @default(2)\n  createdAt        DateTime                @default(now())\n\n  profile PharmacyTaxProfileVersion @relation(fields: [organizationId, profileVersionId], references: [organizationId, id], onDelete: Restrict)\n\n  @@unique([organizationId, id])\n  @@unique([organizationId, profileVersionId, productClass, pctHsCode])\n  @@index([organizationId, profileVersionId])\n  @@map(\"pharmacy_tax_rule_versions\")\n}\n\n// ============================================\n// CHAT & MESSAGING\n// ============================================\n\nmodel Channel {\n  id             String      @id @default(cuid())\n  organizationId String      @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  name           String?\n  description    String?\n  topic          String?\n  type           ChannelType\n  isPrivate      Boolean     @default(true)\n  isArchived     Boolean     @default(false)\n  createdById    String?\n  createdAt      DateTime    @default(now())\n  updatedAt      DateTime    @updatedAt\n\n  createdBy    User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)\n  members      ChannelMember[]\n  messages     Message[]\n  pins         PinnedMessage[]\n  meetingLinks MeetingEntityLink[]\n\n  @@index([type])\n  @@index([organizationId])\n  @@map(\"channels\")\n}\n\nmodel ChannelMember {\n  id             String    @id @default(cuid())\n  organizationId String    @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  channelId      String\n  userId         String\n  lastReadAt     DateTime?\n  muted          Boolean   @default(false)\n  role           String    @default(\"MEMBER\") // OWNER, ADMIN, MEMBER\n  joinedAt       DateTime  @default(now())\n\n  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)\n  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)\n\n  @@unique([channelId, userId])\n  @@index([userId])\n  @@index([organizationId])\n  @@map(\"channel_members\")\n}\n\nmodel Message {\n  id             String    @id @default(cuid())\n  organizationId String    @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  content        String\n  contentJson    Json?\n  channelId      String\n  senderId       String\n  parentId       String?\n  isEdited       Boolean   @default(false)\n  editedAt       DateTime?\n  deletedAt      DateTime?\n  createdAt      DateTime  @default(now())\n  updatedAt      DateTime  @updatedAt\n\n  channel     Channel             @relation(fields: [channelId], references: [id], onDelete: Cascade)\n  sender      User                @relation(fields: [senderId], references: [id])\n  parent      Message?            @relation(\"MessageThread\", fields: [parentId], references: [id])\n  replies     Message[]           @relation(\"MessageThread\")\n  attachments MessageAttachment[]\n  reactions   MessageReaction[]\n  mentions    MessageMention[]\n  pins        PinnedMessage[]\n  savedBy     SavedMessage[]\n  edits       MessageEdit[] // IMP-RT-02: prior-content snapshots per edit\n\n  @@index([channelId, createdAt])\n  @@index([parentId])\n  @@index([organizationId])\n  @@map(\"messages\")\n}\n\n// IMP-RT-02: a snapshot of a message's content taken just before each edit, so\n// the edit history can be reconstructed.\nmodel MessageEdit {\n  id                  String   @id @default(cuid())\n  organizationId      String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  messageId           String\n  previousContent     String\n  previousContentJson Json?\n  editedAt            DateTime @default(now())\n\n  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)\n\n  @@index([messageId])\n  @@index([organizationId])\n  @@map(\"message_edits\")\n}\n\nmodel MessageAttachment {\n  id             String   @id @default(cuid())\n  organizationId String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  messageId      String\n  name           String\n  url            String\n  type           String?\n  size           Int?\n  // Playback length in milliseconds \\u2014 set for audio/voice attachments only.\n  duration       Int?\n  createdAt      DateTime @default(now())\n\n  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)\n\n  @@index([organizationId])\n  @@map(\"message_attachments\")\n}\n\nmodel MessageReaction {\n  id             String @id @default(cuid())\n  organizationId String @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  messageId      String\n  userId         String\n  emoji          String\n\n  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)\n\n  @@unique([messageId, userId, emoji])\n  @@index([messageId])\n  @@index([organizationId])\n  @@map(\"message_reactions\")\n}\n\nmodel MessageMention {\n  id             String   @id @default(cuid())\n  organizationId String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  messageId      String\n  userId         String\n  createdAt      DateTime @default(now())\n\n  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)\n  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)\n\n  @@unique([messageId, userId])\n  @@index([userId])\n  @@index([organizationId])\n  @@map(\"message_mentions\")\n}\n\nmodel PinnedMessage {\n  id             String   @id @default(cuid())\n  organizationId String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  messageId      String\n  channelId      String\n  pinnedById     String\n  createdAt      DateTime @default(now())\n\n  message  Message @relation(fields: [messageId], references: [id], onDelete: Cascade)\n  channel  Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)\n  pinnedBy User    @relation(fields: [pinnedById], references: [id], onDelete: Cascade)\n\n  @@unique([messageId])\n  @@index([channelId])\n  @@index([organizationId])\n  @@map(\"pinned_messages\")\n}\n\nmodel SavedMessage {\n  id             String   @id @default(cuid())\n  organizationId String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  messageId      String\n  userId         String\n  createdAt      DateTime @default(now())\n\n  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)\n  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)\n\n  @@unique([messageId, userId])\n  @@index([userId, createdAt])\n  @@index([organizationId])\n  @@map(\"saved_messages\")\n}\n\n// ============================================\n// HR & LEAVE MANAGEMENT\n// ============================================\n\nmodel LeaveRequest {\n  id             String      @id @default(cuid())\n  organizationId String      @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  userId         String\n  type           LeaveType\n  startDate      DateTime\n  endDate        DateTime\n  status         LeaveStatus @default(PENDING)\n  approvedById   String?\n  reason         String?\n  createdAt      DateTime    @default(now())\n  updatedAt      DateTime    @updatedAt\n\n  user       User  @relation(\"LeaveRequester\", fields: [userId], references: [id])\n  approvedBy User? @relation(\"LeaveApprover\", fields: [approvedById], references: [id])\n\n  @@index([status])\n  @@index([userId])\n  @@index([organizationId])\n  @@map(\"leave_requests\")\n}\n\nmodel PerformanceNote {\n  id             String   @id @default(cuid())\n  organizationId String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  userId         String\n  authorId       String\n  content        String\n  createdAt      DateTime @default(now())\n  updatedAt      DateTime @updatedAt\n\n  user   User @relation(\"NoteSubject\", fields: [userId], references: [id])\n  author User @relation(\"NoteAuthor\", fields: [authorId], references: [id])\n\n  @@index([organizationId])\n  @@map(\"performance_notes\")\n}\n\n// ============================================\n// DOCUMENTS & FILES\n// ============================================\n\nmodel Document {\n  id             String   @id @default(cuid())\n  organizationId String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  name           String\n  url            String\n  type           String?\n  size           Int?\n  clientId       String?\n  uploadedById   String\n  createdAt      DateTime @default(now())\n\n  client     Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)\n  uploadedBy User    @relation(fields: [uploadedById], references: [id])\n\n  @@index([organizationId])\n  @@map(\"documents\")\n}\n\nmodel ProjectFile {\n  id             String   @id @default(cuid())\n  organizationId String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  name           String\n  url            String\n  type           String?\n  size           Int?\n  projectId      String\n  uploadedById   String\n  createdAt      DateTime @default(now())\n\n  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)\n  uploadedBy User    @relation(fields: [uploadedById], references: [id])\n\n  @@index([organizationId])\n  @@map(\"project_files\")\n}\n\n// ============================================\n// MILESTONES\n// ============================================\n\nmodel Milestone {\n  id             String    @id @default(cuid())\n  organizationId String    @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  name           String\n  description    String?\n  projectId      String\n  dueDate        DateTime\n  completedAt    DateTime?\n  createdAt      DateTime  @default(now())\n  updatedAt      DateTime  @updatedAt\n\n  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)\n\n  @@index([projectId])\n  @@index([organizationId])\n  @@map(\"milestones\")\n}\n\n// ============================================\n// ACTIVITY LOG & NOTIFICATIONS\n// ============================================\n\nmodel Activity {\n  id             String   @id @default(cuid())\n  organizationId String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  type           String // task_created, invoice_sent, project_updated, etc.\n  message        String\n  userId         String\n  entityType     String? // Project, Task, Invoice, etc.\n  entityId       String?\n  metadata       Json?\n  createdAt      DateTime @default(now())\n\n  user User @relation(fields: [userId], references: [id])\n\n  @@index([createdAt])\n  @@index([entityType, entityId])\n  @@index([organizationId])\n  @@map(\"activities\")\n}\n\nmodel Notification {\n  id             String   @id @default(cuid())\n  organizationId String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  userId         String\n  title          String\n  message        String\n  type           String // task_assigned, mention, invoice_paid, etc.\n  isRead         Boolean  @default(false)\n  entityType     String?\n  entityId       String?\n  createdAt      DateTime @default(now())\n\n  user User @relation(fields: [userId], references: [id], onDelete: Cascade)\n\n  @@index([userId, isRead])\n  @@index([createdAt])\n  @@index([organizationId])\n  @@map(\"notifications\")\n}\n\n// ============================================\n// AUDIT LOG\n// ============================================\n\n/// Extreme-granular, admin-only audit trail. Every mutation (tRPC + REST),\n/// every authentication event, and every sensitive read appends one immutable\n/// row here. Actor identity is *snapshotted* (name/email/role) so the trail\n/// stays meaningful even after the user is deleted (actor relation is SetNull).\n/// Sensitive input fields (passwords, tokens) are redacted before storage.\nmodel AuditLog {\n  id             String   @id @default(cuid())\n  organizationId String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  createdAt      DateTime @default(now()) // WHEN\n\n  // WHO \\u2014 snapshotted at the time of the action for durability\n  actorType           AuditActorType @default(USER)\n  actorId             String? // the acting User (FK -> users). null for anonymous (e.g. failed login)\n  // A restaurant terminal operator is a staff profile, NOT a User (C2/C3), so its\n  // audit rows attribute here instead of \\`actorId\\` \\u2014 the two are mutually exclusive\n  // and a RESTAURANT_OPERATOR row must set this one (enforced by a DB CHECK). Used\n  // by the M2 terminal mutations (unlock/switch/co-authorize/lock).\n  actorStaffProfileId String? // the acting RestaurantStaffProfile, when actorType = RESTAURANT_OPERATOR\n  actorName           String?\n  actorEmail          String?\n  actorRole           String?\n  tokenId             String? // the ApiToken used, when actorType = API_TOKEN\n  tokenName           String?\n\n  // WHAT\n  source      AuditSource\n  category    String // TEAM, FINANCE, PROJECT, TASK, CLIENT, CHAT, NOTE, MEETING, API_TOKEN, AUTH, SYSTEM\n  operation   AuditOperation @default(OTHER)\n  action      String // \"team.updateMember\", \"POST /api/v1/tasks\", \"auth.login\"\n  description String?\n\n  // WHAT WAS ACTED ON\n  targetType  String? // Project, Task, User, Invoice, ...\n  targetId    String?\n  targetLabel String? // human-readable name snapshot\n\n  // HOW (full payloads \\u2014 redacted)\n  input    Json? // the request arguments / body\n  changes  Json? // field-level before -> after diff, where instrumented\n  result   Json? // a summary of what was returned/created\n  metadata Json? // any extra structured context\n\n  // WHERE / CONTEXT\n  ip         String?\n  userAgent  String?\n  httpMethod String?\n  path       String?\n  statusCode Int?\n\n  // OUTCOME\n  outcome      AuditOutcome @default(SUCCESS)\n  errorCode    String?\n  errorMessage String?\n  durationMs   Int?\n\n  actor             User?                   @relation(\"UserAuditLogs\", fields: [actorId], references: [id], onDelete: SetNull)\n  actorStaffProfile RestaurantStaffProfile? @relation(\"StaffProfileAuditLogs\", fields: [actorStaffProfileId], references: [id], onDelete: SetNull)\n\n  @@index([createdAt])\n  @@index([actorId, createdAt])\n  @@index([actorStaffProfileId, createdAt])\n  @@index([category, createdAt])\n  @@index([source, createdAt])\n  @@index([operation, createdAt])\n  @@index([outcome, createdAt])\n  @@index([action])\n  @@index([targetType, targetId])\n  @@index([organizationId])\n  @@map(\"audit_logs\")\n}\n\n// ============================================\n// MEETINGS\n// ============================================\n\n/// A meeting SERIES. \\`startTime\\`/\\`endTime\\` describe the first instance and the\n/// duration; every joinable instance is a MeetingOccurrence. A Meeting has no\n/// public identifier on purpose \\u2014 see MeetingOccurrence.publicId.\nmodel Meeting {\n  id                  String    @id @default(cuid())\n  organizationId      String    @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  title               String\n  description         String?\n  startTime           DateTime\n  endTime             DateTime\n  location            String? // \"Google Meet\", \"Office\", URL, etc.\n  /// DEPRECATED (MEET-01): superseded by \\`recurrenceRule\\`. Still written and\n  /// read during the migration window so a rollback to pre-MEET-01 application\n  /// code keeps working; it drops in a later PR once nothing reads it.\n  recurrence          String? // \"daily\", \"weekly\", \"biweekly\", \"monthly\", null = one-time\n  /// RFC 5545 RRULE, without the \"RRULE:\" prefix \\u2014 e.g. \"FREQ=WEEKLY;INTERVAL=2\".\n  /// Null means a one-time meeting. Interpreted in \\`timezone\\`.\n  recurrenceRule      String?\n  /// IANA zone the series recurs in, validated against pg_timezone_names by a\n  /// CHECK constraint. A recurring series is anchored to wall-clock time, so\n  /// the zone \\u2014 not a UTC offset \\u2014 is what survives a DST transition.\n  ///\n  /// The empty-string default is a placeholder, never a stored value: a\n  /// BEFORE INSERT OR UPDATE trigger replaces a blank zone with the owning\n  /// organization's, or raises. It exists so Prisma treats the field as\n  /// optional, which is what lets MEET-01 add a NOT NULL column without\n  /// editing the callers that create meetings today. Deriving beats\n  /// defaulting \\u2014 UTC is not a safe guess for a recurring series.\n  timezone            String    @default(dbgenerated(\"''\"))\n  /// Watermark for lazy occurrence materialisation: every instance up to this\n  /// instant already exists as a row. Null means nothing is materialised yet.\n  /// The materialiser only ever advances this to now() + the rolling window\n  /// (see MeetingOccurrence) so a daily series never expands unbounded.\n  materializedThrough DateTime?\n  createdById         String\n  createdAt           DateTime  @default(now())\n  updatedAt           DateTime  @updatedAt\n\n  attendees     MeetingAttendee[]\n  attendanceLog MeetingAttendanceLog[]\n  occurrences   MeetingOccurrence[]\n  participants  MeetingParticipant[]\n  entityLinks   MeetingEntityLink[]\n\n  @@index([startTime])\n  @@index([organizationId])\n  @@index([organizationId, materializedThrough])\n  @@map(\"meetings\")\n}\n\nmodel MeetingAttendee {\n  id             String    @id @default(cuid())\n  organizationId String    @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  meetingId      String\n  userId         String\n  // DEPRECATED: kept for backwards-compat during rollout. Real attendance\n  // tracking is in MeetingAttendanceLog, which records per-occurrence joins.\n  // This field will be removed in a future change.\n  joinedAt       DateTime?\n\n  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)\n  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)\n\n  @@unique([meetingId, userId])\n  @@index([userId, joinedAt])\n  @@index([organizationId])\n  @@map(\"meeting_attendees\")\n}\n\n/// Per-occurrence attendance. For a recurring meeting, each occurrence the\n/// user attends gets its own row keyed by occurrenceStart (the wall-clock\n/// start of that specific instance). Single-shot meetings get exactly one\n/// row per user-who-joined.\nmodel MeetingAttendanceLog {\n  id              String    @id @default(cuid())\n  organizationId  String    @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  meetingId       String\n  userId          String\n  occurrenceStart DateTime\n  joinedAt        DateTime\n  // Stamped when the user leaves the in-app video call (videoConferenceLeft /\n  // readyToClose). Null while the call is still open or for joins recorded\n  // outside the embedded call.\n  leftAt          DateTime?\n  createdAt       DateTime  @default(now())\n\n  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)\n  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)\n\n  @@unique([meetingId, userId, occurrenceStart])\n  @@index([userId, occurrenceStart])\n  @@index([meetingId, occurrenceStart])\n  @@index([organizationId])\n  @@map(\"meeting_attendance_log\")\n}\n\n/// One materialised instance of a meeting series \\u2014 the unit people actually\n/// join, and the unit every piece of evidence hangs off.\n///\n/// MATERIALISATION IS LAZY AND BOUNDED. Occurrences are never expanded for a\n/// whole series: the materialiser walks the RRULE forward only to\n/// now() + MEETING_MATERIALISATION_WINDOW (30 days) and records how far it got\n/// in Meeting.materializedThrough. An infinite RRULE therefore produces a\n/// bounded, rolling set of rows. The window is a database-independent constant\n/// consumed by the materialiser; the schema enforces the *shape* (one row per\n/// series slot) rather than the horizon.\n///\n/// EXCEPTIONS LIVE HERE, NOT ON THE SERIES. \\`seriesSlotStart\\` is the instant\n/// the RRULE produced and never changes, so it is the stable identity of this\n/// instance. A reschedule moves \\`scheduledStart\\`/\\`scheduledEnd\\` away from it;\n/// a cancellation sets the cancellation columns; a one-off retitle sets\n/// \\`titleOverride\\`. Editing the series can therefore never silently rewrite\n/// what already happened.\n///\n/// MATERIALISATION MUST NEVER DELETE A HISTORICAL OCCURRENCE. This table is\n/// NOT \"the set the current RRULE generates\". It is that set UNION every\n/// instant historical attendance has already named. The MEET-01 backfill\n/// produced 215 occurrences from 210 meetings precisely because five\n/// attendance rows named an instant the series' recurrence rule does not\n/// generate; those five rows are durable evidence that a meeting happened,\n/// not drift to be reconciled away.\n///\n/// A materialiser reconciling this table against a series may therefore only\n/// ADD missing slots, and may only mark a FUTURE slot cancelled when it leaves\n/// the rule. It must never DELETE a row, and must never treat a past\n/// occurrence that no longer matches the current RRULE as garbage to collect:\n/// changing a recurrence rule does not un-happen the meetings already held,\n/// and the sessions hanging off such an occurrence are the only record that\n/// they were.\nmodel MeetingOccurrence {\n  id             String @id @default(cuid())\n  organizationId String @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  meetingId      String\n\n  /// GLOBALLY unique, cryptographically random UUIDv4 (PostgreSQL\n  /// gen_random_uuid()). This is the third anonymous tenant-resolution key\n  /// alongside Invitation.tokenHash and PasswordResetToken.tokenHash: the\n  /// shared public join URL supplies no tenant context by product design, so\n  /// publicId must resolve exactly one organization before tenant scope is\n  /// entered \\u2014 hence global, not per-tenant, uniqueness. See\n  /// src/lib/auth/anonymous-tenant.ts.\n  ///\n  /// It is a LOCATOR, NOT AUTHORIZATION. Holding it proves nothing; the guest\n  /// credential lives on MeetingOccurrenceParticipant. It lives on the\n  /// occurrence and not on the series because a series-level identifier would\n  /// be an indefinitely reusable join link, and would force the application to\n  /// guess which instance a joiner meant.\n  publicId String @unique @default(dbgenerated(\"gen_random_uuid()::text\"))\n\n  /// The RRULE instant that identifies this instance within the series.\n  /// Immutable \\u2014 a reschedule changes \\`scheduledStart\\`, never this.\n  seriesSlotStart DateTime\n  scheduledStart  DateTime\n  scheduledEnd    DateTime\n  /// First and last media activity, stamped from provider webhooks.\n  actualStart     DateTime?\n  actualEnd       DateTime?\n\n  status MeetingOccurrenceStatus @default(SCHEDULED)\n\n  /// \\`mtg_\\` + 26 base32 characters over 16 CSPRNG bytes, defaulted in the\n  /// database so it cannot be forgotten by a caller. Deliberately DISTINCT\n  /// from and underivable from \\`publicId\\`: if the room name could be computed\n  /// from the join link, a link-holder could address the media room directly\n  /// and bypass the lobby.\n  providerRoomName String @unique @default(dbgenerated(\"meeting_provider_room_name()\"))\n\n  /// Join window. Outside it the occurrence is not joinable regardless of\n  /// credential; enforced by the join path, bounded here so the bound is data.\n  joinOpensAt  DateTime\n  joinClosesAt DateTime\n\n  /// Per-occurrence exceptions.\n  titleOverride      String?\n  cancelledAt        DateTime?\n  cancelledById      String?\n  cancellationReason String?\n\n  createdAt DateTime @default(now())\n  updatedAt DateTime @updatedAt\n\n  meeting        Meeting                        @relation(fields: [meetingId], references: [id], onDelete: Cascade)\n  participants   MeetingOccurrenceParticipant[]\n  sessions       MeetingParticipantSession[]\n  providerEvents MeetingProviderEvent[]\n\n  @@unique([meetingId, seriesSlotStart])\n  @@index([organizationId])\n  @@index([organizationId, scheduledStart])\n  @@index([organizationId, status, scheduledStart])\n  @@index([meetingId, scheduledStart])\n  @@map(\"meeting_occurrences\")\n}\n\n/// SERIES-LEVEL INVITEE METADATA ONLY.\n///\n/// This row says \"these people are on the invite list for this series\". It is\n/// NOT a guest identity and MUST NOT gain a token hash, secret, expiry, or any\n/// other credential column: nothing credential-bearing may span a recurring\n/// series, because a secret that outlives one occurrence is a permanent key to\n/// every future one. Guest credentials live on\n/// MeetingOccurrenceParticipant, occurrence-scoped. scripts/verify-tenant-isolation.ts\n/// asserts this table has no credential-shaped column, because it is a\n/// boundary that will otherwise erode.\nmodel MeetingParticipant {\n  id             String @id @default(cuid())\n  organizationId String @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  meetingId      String\n\n  /// Exactly one contact reference must be present (CHECK constraint):\n  /// an internal user, a client contact, or a bare email for an outsider.\n  userId          String?\n  clientContactId String?\n  email           String?\n\n  displayName      String\n  defaultRole      MeetingParticipantRole @default(ATTENDEE)\n  invitationStatus MeetingInviteStatus    @default(PENDING)\n  respondedAt      DateTime?\n\n  createdAt DateTime @default(now())\n  updatedAt DateTime @updatedAt\n\n  meeting       Meeting                        @relation(fields: [meetingId], references: [id], onDelete: Cascade)\n  user          User?                          @relation(fields: [userId], references: [id], onDelete: Cascade)\n  clientContact ClientContact?                 @relation(fields: [clientContactId], references: [id], onDelete: Cascade)\n  occurrences   MeetingOccurrenceParticipant[]\n\n  @@unique([meetingId, userId])\n  @@unique([meetingId, clientContactId])\n  @@unique([meetingId, email])\n  @@index([organizationId])\n  @@index([organizationId, userId])\n  @@map(\"meeting_participants\")\n}\n\n/// The occurrence-scoped access grant: admission state for one person at one\n/// instance, AND the only place a guest credential may live. Everything here\n/// expires with the occurrence it belongs to.\nmodel MeetingOccurrenceParticipant {\n  id             String  @id @default(cuid())\n  organizationId String  @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  occurrenceId   String\n  /// Null for someone who joined without being on the series invite list.\n  participantId  String?\n  userId         String?\n  displayName    String\n\n  lobbyStatus  MeetingLobbyStatus      @default(NOT_REQUIRED)\n  roleOverride MeetingParticipantRole?\n\n  /// Tri-state: null = never asked, true/false = the recorded answer.\n  recordingConsent   Boolean?\n  recordingConsentAt DateTime?\n\n  admittedAt   DateTime?\n  admittedById String?\n  removedAt    DateTime?\n  removedById  String?\n\n  /// GUEST CREDENTIAL \\u2014 occurrence-scoped, never series-scoped. SHA-256 of a\n  /// token handed out once, mirroring Invitation.tokenHash. Globally unique so\n  /// a stray collision is a database error rather than a cross-tenant hit.\n  /// A CHECK constraint requires an expiry whenever a hash is present: a guest\n  /// credential with no expiry is a permanent one.\n  guestTokenHash      String?   @unique\n  guestTokenExpiresAt DateTime?\n  guestTokenRevokedAt DateTime?\n\n  createdAt DateTime @default(now())\n  updatedAt DateTime @updatedAt\n\n  occurrence  MeetingOccurrence           @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)\n  participant MeetingParticipant?         @relation(fields: [participantId], references: [id], onDelete: SetNull)\n  user        User?                       @relation(fields: [userId], references: [id], onDelete: Cascade)\n  sessions    MeetingParticipantSession[]\n\n  @@unique([occurrenceId, participantId])\n  @@unique([occurrenceId, userId])\n  @@index([organizationId])\n  @@index([organizationId, occurrenceId, lobbyStatus])\n  @@index([guestTokenExpiresAt])\n  @@map(\"meeting_occurrence_participants\")\n}\n\n/// One connection to the media room. A person who drops and rejoins produces\n/// two rows; this is the join/leave ledger, not a presence flag.\nmodel MeetingParticipantSession {\n  id                      String  @id @default(cuid())\n  organizationId          String  @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  occurrenceId            String\n  occurrenceParticipantId String?\n  userId                  String?\n\n  /// The media provider's participant SID. Null on rows that predate webhook\n  /// verification \\u2014 always paired with source = LEGACY_CLIENT.\n  providerParticipantSid String?\n  /// Provenance. Backfilled rows are LEGACY_CLIENT and can never be mistaken\n  /// for webhook-verified evidence.\n  source                 MeetingSessionSource\n\n  joinedAt         DateTime\n  leftAt           DateTime?\n  disconnectReason String?\n\n  /// Provider event IDs that produced the join and the leave, so a session can\n  /// be traced back to the signed webhook that asserted it.\n  joinEventId  String?\n  leaveEventId String?\n\n  createdAt DateTime @default(now())\n\n  occurrence            MeetingOccurrence             @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)\n  occurrenceParticipant MeetingOccurrenceParticipant? @relation(fields: [occurrenceParticipantId], references: [id], onDelete: SetNull)\n  user                  User?                         @relation(fields: [userId], references: [id], onDelete: Cascade)\n\n  @@unique([organizationId, providerParticipantSid])\n  @@index([organizationId])\n  @@index([occurrenceId, joinedAt])\n  @@index([userId, joinedAt])\n  @@map(\"meeting_participant_sessions\")\n}\n\n/// Raw provider webhook receipts, for idempotency and for auditing what the\n/// provider actually said.\nmodel MeetingProviderEvent {\n  id             String  @id @default(cuid())\n  organizationId String  @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  occurrenceId   String?\n\n  /// The provider's own event identifier. Unique PER TENANT, deliberately not\n  /// globally: a global unique key would let one tenant's insert fail because\n  /// another tenant had already received that event id, which leaks the\n  /// existence of another tenant's event.\n  providerEventId String\n  eventType       String\n  payload         Json\n\n  receivedAt    DateTime  @default(now())\n  processedAt   DateTime?\n  /// Set when handling failed; kept so a poison event is visible instead of\n  /// silently retried forever.\n  failureReason String?\n\n  occurrence MeetingOccurrence? @relation(fields: [occurrenceId], references: [id], onDelete: SetNull)\n\n  @@unique([organizationId, providerEventId])\n  @@index([organizationId, receivedAt])\n  @@index([occurrenceId, receivedAt])\n  @@map(\"meeting_provider_events\")\n}\n\n/// Links a meeting series to whatever else it is about. Typed nullable columns\n/// rather than a polymorphic (type, id) pair, so every link carries a real\n/// foreign key and a composite same-organization constraint. A CHECK requires\n/// exactly one target.\nmodel MeetingEntityLink {\n  id             String @id @default(cuid())\n  organizationId String @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  meetingId      String\n\n  projectId String?\n  clientId  String?\n  channelId String?\n  noteId    String?\n  taskId    String?\n\n  createdById String?\n  createdAt   DateTime @default(now())\n\n  meeting Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)\n  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)\n  client  Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)\n  channel Channel? @relation(fields: [channelId], references: [id], onDelete: Cascade)\n  note    Note?    @relation(fields: [noteId], references: [id], onDelete: Cascade)\n  task    Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)\n\n  @@unique([meetingId, projectId])\n  @@unique([meetingId, clientId])\n  @@unique([meetingId, channelId])\n  @@unique([meetingId, noteId])\n  @@unique([meetingId, taskId])\n  @@index([organizationId])\n  @@index([projectId])\n  @@index([clientId])\n  @@index([channelId])\n  @@index([noteId])\n  @@index([taskId])\n  @@map(\"meeting_entity_links\")\n}\n\n// ============================================\n// API TOKENS\n// ============================================\n\nmodel ApiToken {\n  id             String    @id @default(cuid())\n  organizationId String    @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  name           String\n  prefix         String // First 12 chars for display, e.g. \"df_a1b2c3d4\"\n  tokenHash      String    @unique // bcrypt hash of the full token\n  scopes         String[]  @default([]) // [\"tasks:read\", \"finance:write\", etc.]\n  userId         String // The user this token acts on behalf of\n  lastUsedAt     DateTime?\n  expiresAt      DateTime?\n  createdAt      DateTime  @default(now())\n\n  user User @relation(fields: [userId], references: [id], onDelete: Cascade)\n\n  @@index([userId])\n  @@index([prefix])\n  @@index([organizationId])\n  @@map(\"api_tokens\")\n}\n\n// ============================================\n// NOTES (Obsidian-style with backlinks)\n// ============================================\n\nmodel Note {\n  id             String         @id @default(cuid())\n  organizationId String         @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  title          String\n  contentJson    Json // Tiptap JSON document\n  contentText    String         @default(\"\") // Plain text extract for search\n  authorId       String\n  visibility     NoteVisibility @default(PRIVATE)\n  projectId      String? // Optional: attach to a project\n  clientId       String? // Optional: attach to a client\n  createdAt      DateTime       @default(now())\n  updatedAt      DateTime       @updatedAt\n\n  author       User                @relation(\"NoteAuthor\", fields: [authorId], references: [id], onDelete: Cascade)\n  project      Project?            @relation(fields: [projectId], references: [id], onDelete: Cascade)\n  client       Client?             @relation(fields: [clientId], references: [id], onDelete: Cascade)\n  shares       NoteShare[]\n  linksFrom    NoteLink[]          @relation(\"LinksFrom\") // outgoing links from this note\n  linksTo      NoteLink[]          @relation(\"LinksTo\") // incoming backlinks to this note\n  mentions     NoteMention[] // IMP-NOTE-02: @mentioned people on this note\n  revisions    NoteRevision[] // IMP-NOTE-01: version history\n  meetingLinks MeetingEntityLink[]\n\n  @@index([authorId])\n  @@index([projectId])\n  @@index([clientId])\n  @@index([updatedAt])\n  @@index([organizationId])\n  @@map(\"notes\")\n}\n\n// IMP-NOTE-01: an immutable snapshot of a note taken before each edit, so changes\n// can be diffed and restored. Bounded retention is enforced in the router.\nmodel NoteRevision {\n  id             String   @id @default(cuid())\n  organizationId String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  noteId         String\n  title          String\n  contentJson    Json\n  contentText    String   @default(\"\")\n  editedById     String?\n  createdAt      DateTime @default(now())\n\n  note     Note  @relation(fields: [noteId], references: [id], onDelete: Cascade)\n  editedBy User? @relation(\"NoteRevisionEditor\", fields: [editedById], references: [id], onDelete: SetNull)\n\n  @@index([noteId])\n  @@index([organizationId])\n  @@map(\"note_revisions\")\n}\n\n// IMP-HR-01: per-user, per-year, per-type leave entitlement. \"Used\" days are\n// derived from APPROVED LeaveRequests; this stores the allowance to compare against.\nmodel LeaveBalance {\n  id             String    @id @default(cuid())\n  organizationId String    @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  userId         String\n  year           Int\n  type           LeaveType\n  entitledDays   Int\n  createdAt      DateTime  @default(now())\n  updatedAt      DateTime  @updatedAt\n\n  user User @relation(\"UserLeaveBalances\", fields: [userId], references: [id], onDelete: Cascade)\n\n  @@unique([userId, year, type])\n  @@index([userId])\n  @@index([organizationId])\n  @@map(\"leave_balances\")\n}\n\n// IMP-REST-03: outbound webhook subscription. \\`secret\\` signs the payload (HMAC).\nmodel Webhook {\n  id             String   @id @default(cuid())\n  organizationId String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  url            String\n  secret         String\n  events         String[] @default([]) // e.g. [\"invoice.paid\", \"task.created\"]\n  active         Boolean  @default(true)\n  createdById    String\n  createdAt      DateTime @default(now())\n  updatedAt      DateTime @updatedAt\n\n  createdBy  User              @relation(\"WebhookCreator\", fields: [createdById], references: [id], onDelete: Cascade)\n  deliveries WebhookDelivery[]\n\n  @@index([organizationId])\n  @@map(\"webhooks\")\n}\n\n// IMP-REST-03: a single delivery attempt for an event \\u2192 webhook (for observability).\nmodel WebhookDelivery {\n  id             String   @id @default(cuid())\n  organizationId String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  webhookId      String\n  event          String\n  payload        Json\n  statusCode     Int?\n  success        Boolean  @default(false)\n  error          String?\n  attemptedAt    DateTime @default(now())\n\n  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)\n\n  @@index([webhookId])\n  @@index([organizationId])\n  @@map(\"webhook_deliveries\")\n}\n\n// IMP-AUTH-02: single-use TOTP recovery codes. Only the hash is stored.\nmodel TwoFactorRecoveryCode {\n  id             String    @id @default(cuid())\n  organizationId String    @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  userId         String\n  codeHash       String\n  usedAt         DateTime?\n  createdAt      DateTime  @default(now())\n\n  user User @relation(fields: [userId], references: [id], onDelete: Cascade)\n\n  @@index([userId])\n  @@index([organizationId])\n  @@map(\"two_factor_recovery_codes\")\n}\n\n// IMP-NOTE-02: a person @mentioned in a note (scoped to the note's visibility),\n// used to notify them and surface \"notes that mention me\".\nmodel NoteMention {\n  id             String   @id @default(cuid())\n  organizationId String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  noteId         String\n  userId         String\n  createdAt      DateTime @default(now())\n\n  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)\n  user User @relation(fields: [userId], references: [id], onDelete: Cascade)\n\n  @@unique([noteId, userId])\n  @@index([userId])\n  @@index([organizationId])\n  @@map(\"note_mentions\")\n}\n\nmodel NoteShare {\n  id             String         @id @default(cuid())\n  organizationId String         @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  noteId         String\n  userId         String\n  permission     NotePermission @default(VIEW)\n  createdAt      DateTime       @default(now())\n\n  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)\n  user User @relation(fields: [userId], references: [id], onDelete: Cascade)\n\n  @@unique([noteId, userId])\n  @@index([organizationId])\n  @@map(\"note_shares\")\n}\n\nmodel NoteLink {\n  id             String   @id @default(cuid())\n  organizationId String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  fromNoteId     String\n  toNoteId       String\n  createdAt      DateTime @default(now())\n\n  fromNote Note @relation(\"LinksFrom\", fields: [fromNoteId], references: [id], onDelete: Cascade)\n  toNote   Note @relation(\"LinksTo\", fields: [toNoteId], references: [id], onDelete: Cascade)\n\n  @@unique([fromNoteId, toNoteId])\n  @@index([toNoteId])\n  @@index([organizationId])\n  @@map(\"note_links\")\n}\n\n// ===========================================================================\n// EMAIL INTEGRATION \\u2014 unified inbox over a Mailbox abstraction with per-provider\n// adapters. GMAIL/OUTLOOK are implemented now; HOSTED (@domain) is reserved for\n// a future self-hosted mailbox and must plug in WITHOUT touching the router/UI.\n// ===========================================================================\n\nenum MailboxType {\n  GMAIL\n  OUTLOOK\n  HOSTED // reserved \\u2014 not implemented\n}\n\n// A connected email account. \\`credentials\\` holds the AES-256-GCM ciphertext of\n// the OAuth refresh token (NEVER plaintext, NEVER sent to the client). Decryption\n// happens server-side only, in the adapter layer.\nmodel Mailbox {\n  id             String      @id @default(cuid())\n  organizationId String      @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  userId         String\n  type           MailboxType\n  emailAddress   String\n  displayName    String?\n  credentials    String // AES-256-GCM ciphertext of the OAuth refresh token\n  status         String      @default(\"active\")\n  lastSyncedAt   DateTime?\n  createdAt      DateTime    @default(now())\n  updatedAt      DateTime    @updatedAt\n\n  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)\n  messages EmailMessage[]\n\n  @@index([userId])\n  @@index([organizationId])\n  @@map(\"mailboxes\")\n}\n\n// A synced message belonging to a Mailbox. Provider-agnostic shape; bodies are\n// backfilled lazily on first open to keep the initial inbox paint fast.\nmodel EmailMessage {\n  id                String   @id @default(cuid())\n  organizationId    String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  mailboxId         String\n  providerMessageId String\n  threadId          String?\n  fromAddr          String\n  toAddrs           Json\n  ccAddrs           Json?\n  subject           String?\n  snippet           String?\n  bodyHtml          String?\n  bodyText          String?\n  isRead            Boolean  @default(false)\n  hasAttachments    Boolean  @default(false)\n  sentAt            DateTime\n  createdAt         DateTime @default(now())\n\n  mailbox Mailbox @relation(fields: [mailboxId], references: [id], onDelete: Cascade)\n\n  @@unique([mailboxId, providerMessageId])\n  @@index([mailboxId, sentAt])\n  @@index([organizationId])\n  @@map(\"email_messages\")\n}\n\n// ===========================================================================\n// PLATFORM CONTROL PLANE \\u2014 commercial, tenant configuration, identity and ops\n// ===========================================================================\n\n/// \\xA72: the operating model an organization runs under. Deliberately a two-value\n/// enum, not a generic vertical builder \\u2014 a new vertical still needs purpose-built\n/// routes, models, authorization, and dashboards. Existing organizations and\n/// packages are migrated to AGENCY (\\xA72.2). The single server-owned catalog in\n/// src/lib/vertical-catalog.ts (\\xA72.3) \\u2014 not per-screen conditionals \\u2014 decides\n/// package/module/route compatibility from this enum.\nenum OrganizationVertical {\n  AGENCY\n  RESTAURANT\n  PHARMACY\n}\n\nenum PlatformModuleBand {\n  BASELINE\n  PLATFORM\n  VERTICAL_CORE\n  VERTICAL_OPTIONAL\n}\n\nenum RestaurantActivationAcknowledgementKind {\n  TAX\n  PAYMENT\n  DEVICE\n  OPERATOR\n}\n\nmodel Organization {\n  id                  String                     @id @default(cuid())\n  slug                String                     @unique\n  legalName           String\n  displayName         String\n  vertical            OrganizationVertical       @default(AGENCY)\n  status              OrganizationStatus         @default(ONBOARDING)\n  deploymentMode      OrganizationDeploymentMode @default(SHARED)\n  packageId           String?\n  timezone            String                     @default(\"UTC\")\n  locale              String                     @default(\"en\")\n  currency            String                     @default(\"USD\")\n  seatLimit           Int                        @default(1)\n  gracePeriodDays     Int                        @default(0)\n  activatedAt         DateTime?\n  suspendedAt         DateTime?\n  terminatedAt        DateTime?\n  purgeScheduledAt    DateTime?\n  dataResidency       String?\n  primaryContactName  String?\n  primaryContactEmail String?\n  notes               String?\n  createdAt           DateTime                   @default(now())\n  updatedAt           DateTime                   @updatedAt\n\n  package                              PlatformPackage?                      @relation(fields: [packageId], references: [id], onDelete: SetNull)\n  users                                User[]\n  roles                                OrganizationRole[]\n  departments                          OrganizationDepartment[]\n  pharmacyOnboarding                   PharmacyOnboardingState?\n  permissionOverrides                  UserPermissionOverride[]\n  modules                              OrganizationModule[]\n  limits                               OrganizationLimit[]\n  usageCounters                        OrganizationUsageCounter[]\n  brand                                OrganizationBrand?\n  emailSettings                        OrganizationEmailSettings?\n  domains                              OrganizationDomain[]\n  identityConnections                  OrganizationIdentityConnection[]\n  scimTokens                           OrganizationScimToken[]\n  scimEvents                           OrganizationScimEvent[]\n  accounts                             PlatformAccount[]\n  convertedOpportunities               PlatformOpportunity[]\n  contracts                            PlatformContract[]\n  invoices                             PlatformInvoice[]\n  payments                             PlatformPayment[]\n  renewals                             PlatformRenewal[]\n  deployments                          OrganizationDeployment[]\n  jobs                                 PlatformJob[]\n  lifecycleEvents                      OrganizationLifecycleEvent[]\n  supportSessions                      PlatformSupportSession[]\n  auditLogs                            PlatformAuditLog[]\n  ssoStates                            OrganizationSsoState[]\n  ssoTickets                           TenantSsoTicket[]\n  insightLoyaltyLiabilities            InsightLoyaltyLiability[]\n  restaurantNotificationWebhook        RestaurantNotificationWebhook?\n  restaurantActivationAcknowledgements RestaurantActivationAcknowledgement[]\n  pharmacyOwnerDigestSettings          PharmacyOwnerDigestSetting[]\n  pharmacyOwnerDigestCaptures          PharmacyOwnerDigestCapture[]\n\n  @@index([status])\n  @@index([deploymentMode])\n  @@index([packageId])\n  @@index([vertical])\n  @@map(\"organizations\")\n}\n\nmodel RestaurantActivationAcknowledgement {\n  id               String                                  @id @default(cuid())\n  organizationId   String\n  kind             RestaurantActivationAcknowledgementKind\n  policyReference  String\n  acknowledgedById String\n  acknowledgedAt   DateTime                                @default(now())\n\n  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)\n  acknowledgedBy PlatformUser @relation(fields: [acknowledgedById], references: [id], onDelete: Restrict)\n\n  @@unique([organizationId, kind])\n  @@index([organizationId, acknowledgedAt])\n  @@index([acknowledgedById, acknowledgedAt])\n  @@map(\"restaurant_activation_acknowledgements\")\n}\n\n/// \\xA74/\\xA74.1: branch-first schema. A restaurant company is one organization; its\n/// operating locations are branches beneath it. Modeled from the first restaurant\n/// release even when a package allows one branch only. Tenant-scoped exactly like\n/// the operational tables (bare RLS-guarded organizationId, no cross-org\n/// aggregation \\u2014 D09); a partial unique index enforces one default branch per org.\nmodel RestaurantBranch {\n  id                  String   @id @default(cuid())\n  organizationId      String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  name                String\n  /// Stable operator-facing identifier. Database ids remain internal.\n  code                String   @default(dbgenerated(\"('BR-'::text || nextval('restaurant_branch_code_seq'::regclass)::text)\"))\n  timezone            String   @default(\"UTC\")\n  // M4-L1/C5: the branch-local wall-clock time (24h \"HH:MM\") at which one\n  // business day rolls into the next. Additive with a conservative \"00:00\"\n  // default (midnight = calendar day); the order business date is resolved from\n  // timezone + this cutoff (src/lib/restaurant/business-date.ts) and stamped\n  // explicitly, never recomputed later from UTC (\\xA711.1 / BUILD-ASSUMPTIONS).\n  businessDayCutoff   String   @default(\"00:00\")\n  // Completion wave: when true, an operator may only sign in at this branch's\n  // terminals while holding an active, eligible \\`RestaurantShift\\`. Opt-in with a\n  // conservative \\`false\\` default so a branch that does not roster keeps its\n  // existing M2 sign-in behaviour untouched.\n  shiftSignInEnforced Boolean  @default(false)\n  address             String?\n  active              Boolean  @default(true)\n  isDefault           Boolean  @default(false)\n  createdAt           DateTime @default(now())\n  updatedAt           DateTime @updatedAt\n\n  assignments                 RestaurantBranchAssignment[]\n  // M2-L1: staff pinned to this branch as their primary, and devices registered\n  // to this branch. Both are org-scoped and branch-scoped seams (\\xA74.1/D12).\n  staffProfiles               RestaurantStaffProfile[]               @relation(\"RestaurantStaffPrimaryBranch\")\n  registeredDevices           RestaurantRegisteredDevice[]\n  // M3-L1: branch-menu publications binding this branch to a brand-owned menu\n  // (\\xA76.3). Publications are the only branch-linked catalog surface (C2); the\n  // canonical catalog itself carries no branchId.\n  menuPublications            RestaurantBranchMenuPublication[]\n  // M4-L1: floor/service, section, kitchen-station, order, and number-sequence\n  // aggregates hanging off the branch (all org-scoped under forced RLS, C1).\n  floors                      RestaurantFloor[]\n  serverSections              RestaurantServerSection[]\n  kitchenStations             RestaurantKitchenStation[]\n  orders                      RestaurantOrder[]\n  orderNumberSequences        RestaurantOrderNumberSequence[]\n  bills                       RestaurantBill[]\n  drawerSessions              RestaurantDrawerSession[]\n  dailyCloses                 RestaurantDailyClose[]\n  receiptNumberSequences      RestaurantReceiptNumberSequence[]\n  // M6-L1: branch-scoped inventory stock locations and the purchasing surfaces\n  // (POs, receipts) delivered to this branch. All org-scoped under forced RLS.\n  stockLocations              RestaurantStockLocation[]\n  purchaseOrders              RestaurantPurchaseOrder[]\n  purchaseReceipts            RestaurantPurchaseReceipt[]\n  // M7-L1: branch-scoped SOP assignments/occurrences, branch-scoped escalation\n  // policies, and branch-scoped notifications + channel-setting overrides. All\n  // org-scoped under forced RLS.\n  sopAssignments              RestaurantSopAssignment[]\n  sopOccurrences              RestaurantSopOccurrence[]\n  sopEscalationPolicies       RestaurantSopEscalationPolicy[]\n  notifications               RestaurantNotification[]\n  notificationChannelSettings RestaurantNotificationChannelSetting[]\n  customerInteractions        CustomerInteraction[]\n  insightDailyRollups         InsightDailyRollup[]\n  insightItemMixRollups       InsightItemMixRollup[]\n  labourCostFacts             LabourCostFact[]\n  // Completion wave: the branch's rostered shifts (scheduling only).\n  shifts                      RestaurantShift[]\n  taxProfileVersions          RestaurantTaxProfileVersion[]\n  serviceChargePolicyVersions RestaurantServiceChargePolicyVersion[]\n  taxTransactionSnapshots     RestaurantTaxTransactionSnapshot[]\n  // SOP-1: job-role holdings and direct capability grants are branch-scoped.\n  staffJobRoles               RestaurantStaffJobRole[]\n  staffCapabilityGrants       RestaurantStaffCapabilityGrant[]\n  // B1/WHA-285: so is the append-only trail of per-person overrides.\n  staffCapabilityAudits       RestaurantStaffCapabilityAudit[]\n  terminalProviderConfigs     RestaurantTerminalProviderConfig[]\n  terminalReconciliations     RestaurantTerminalReconciliation[]\n  printRoutes                 RestaurantPrintRoute[]\n  printJobs                   RestaurantPrintJob[]\n  deliveryZones               RestaurantDeliveryZone[]\n  deliveryFulfillments        RestaurantDeliveryFulfillment[]\n  cateringOrders              RestaurantCateringOrder[]\n\n  @@unique([organizationId, id])\n  @@index([organizationId])\n  @@map(\"restaurant_branches\")\n}\n\nenum RestaurantTaxVersionStatus {\n  DRAFT\n  PUBLISHED\n  SUPERSEDED\n}\n\nenum RestaurantTaxPriceMode {\n  EXCLUSIVE\n  INCLUSIVE\n}\n\nenum RestaurantTaxDiscountTreatment {\n  BEFORE_TAX\n  AFTER_TAX\n}\n\n/// Jurisdiction-neutral, immutable evidence describing the official source used\n/// to author a tax rule. This lane intentionally contains synthetic data only.\nmodel RestaurantTaxOfficialSource {\n  id             String    @id @default(cuid())\n  organizationId String    @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  authorityCode  String\n  documentTitle  String\n  sourceUrl      String\n  contentHash    String\n  retrievedAt    DateTime\n  expiresAt      DateTime?\n  createdAt      DateTime  @default(now())\n\n  rules RestaurantTaxRuleVersion[]\n\n  @@unique([organizationId, contentHash])\n  @@unique([organizationId, id])\n  @@index([organizationId])\n  @@map(\"restaurant_tax_official_sources\")\n}\n\nmodel RestaurantTaxProfileVersion {\n  id                       String                     @id @default(cuid())\n  organizationId           String                     @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId                 String\n  versionNumber            Int\n  status                   RestaurantTaxVersionStatus @default(DRAFT)\n  effectiveFrom            DateTime\n  effectiveTo              DateTime?\n  approvalReference        String?\n  approvedAt               DateTime?\n  publishedAt              DateTime?\n  presetId                 String?\n  activationIdempotencyKey String?\n  activationPayloadHash    String?\n  eligibilityEvidence      Json?\n  profileName              String?\n  jurisdictionCode         String?\n  priceMode                RestaurantTaxPriceMode?\n  evidenceKind             String?\n  createdAt                DateTime                   @default(now())\n  updatedAt                DateTime                   @updatedAt\n\n  branch               RestaurantBranch                   @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Cascade)\n  rules                RestaurantTaxRuleVersion[]\n  transactionSnapshots RestaurantTaxTransactionSnapshot[]\n\n  @@unique([branchId, versionNumber])\n  @@unique([organizationId, activationIdempotencyKey], map: \"restaurant_tax_profiles_org_activation_key\")\n  @@unique([organizationId, branchId, effectiveFrom], map: \"restaurant_tax_profiles_org_branch_effective_key\")\n  @@unique([organizationId, id])\n  @@index([organizationId])\n  @@index([branchId, status, effectiveFrom])\n  @@map(\"restaurant_tax_profile_versions\")\n}\n\nmodel RestaurantTaxRuleVersion {\n  id                String                         @id @default(cuid())\n  organizationId    String                         @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  profileVersionId  String\n  officialSourceId  String\n  ruleCode          String\n  paymentCategory   String\n  priceMode         RestaurantTaxPriceMode\n  discountTreatment RestaurantTaxDiscountTreatment @default(BEFORE_TAX)\n  rate              Decimal                        @db.Decimal(9, 6)\n  status            RestaurantTaxVersionStatus     @default(DRAFT)\n  effectiveFrom     DateTime\n  effectiveTo       DateTime?\n  approvalReference String?\n  approvedAt        DateTime?\n  publishedAt       DateTime?\n  createdAt         DateTime                       @default(now())\n  updatedAt         DateTime                       @updatedAt\n\n  profile        RestaurantTaxProfileVersion       @relation(fields: [organizationId, profileVersionId], references: [organizationId, id], onDelete: Cascade)\n  officialSource RestaurantTaxOfficialSource       @relation(fields: [organizationId, officialSourceId], references: [organizationId, id], onDelete: Restrict)\n  buckets        RestaurantTaxRateBucketSnapshot[]\n\n  @@unique([profileVersionId, ruleCode])\n  @@unique([organizationId, id])\n  @@index([organizationId])\n  @@index([profileVersionId, paymentCategory, effectiveFrom])\n  @@map(\"restaurant_tax_rule_versions\")\n}\n\nmodel RestaurantTaxTransactionSnapshot {\n  id                      String   @id @default(cuid())\n  organizationId          String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId                String\n  billId                  String?\n  transactionReference    String\n  profileVersionId        String\n  currency                String\n  subtotal                Decimal  @db.Decimal(12, 2)\n  discountTotal           Decimal  @default(0) @db.Decimal(12, 2)\n  serviceChargeTotal      Decimal  @default(0) @db.Decimal(12, 2)\n  taxTotal                Decimal  @db.Decimal(12, 2)\n  grandTotal              Decimal  @db.Decimal(12, 2)\n  settledAt               DateTime\n  reversesSnapshotId      String?\n  reversalReason          String?\n  promotionEvaluationId   String?\n  promotionEvaluationHash String?\n  evidenceVersion         Int      @default(0)\n  evidencePayload         Json?\n  createdAt               DateTime @default(now())\n\n  branch             RestaurantBranch                        @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)\n  bill               RestaurantBill?                         @relation(fields: [organizationId, billId], references: [organizationId, id], onDelete: Restrict)\n  profile            RestaurantTaxProfileVersion             @relation(fields: [organizationId, profileVersionId], references: [organizationId, id], onDelete: Restrict)\n  reversedSnapshot   RestaurantTaxTransactionSnapshot?       @relation(\"TaxSnapshotReversal\", fields: [organizationId, reversesSnapshotId], references: [organizationId, id], onDelete: Restrict)\n  reversals          RestaurantTaxTransactionSnapshot[]      @relation(\"TaxSnapshotReversal\")\n  fullReversalRefund RestaurantRefund?                       @relation(\"TaxRefundFullReversal\")\n  buckets            RestaurantTaxRateBucketSnapshot[]\n  tenderAllocations  RestaurantTaxTenderAllocationSnapshot[]\n\n  @@unique([organizationId, transactionReference])\n  @@unique([organizationId, id])\n  @@unique([organizationId, id, billId])\n  @@index([organizationId])\n  @@index([reversesSnapshotId])\n  @@map(\"restaurant_tax_transaction_snapshots\")\n}\n\nmodel RestaurantTaxRateBucketSnapshot {\n  id                      String                 @id @default(cuid())\n  organizationId          String                 @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  snapshotId              String\n  ruleVersionId           String\n  paymentCategory         String\n  priceMode               RestaurantTaxPriceMode\n  rate                    Decimal                @db.Decimal(9, 6)\n  taxableAmount           Decimal                @db.Decimal(12, 2)\n  taxAmount               Decimal                @db.Decimal(12, 2)\n  grossAmount             Decimal                @db.Decimal(12, 2)\n  preDiscountGrossAmount  Decimal                @default(0) @db.Decimal(12, 2)\n  beforeTaxDiscountAmount Decimal                @default(0) @db.Decimal(12, 2)\n  afterTaxDiscountAmount  Decimal                @default(0) @db.Decimal(12, 2)\n  evidenceVersion         Int                    @default(0)\n  allocationKind          String?\n  billLineId              String?\n  unitOrdinal             Int?\n  createdAt               DateTime               @default(now())\n\n  snapshot          RestaurantTaxTransactionSnapshot        @relation(fields: [organizationId, snapshotId], references: [organizationId, id], onDelete: Restrict)\n  rule              RestaurantTaxRuleVersion                @relation(fields: [organizationId, ruleVersionId], references: [organizationId, id], onDelete: Restrict)\n  tenderAllocations RestaurantTaxTenderAllocationSnapshot[]\n\n  // Legacy-v0 and per-unit-v1 uniqueness are partial migration-managed indexes.\n  @@unique([organizationId, snapshotId, id])\n  @@index([organizationId])\n  @@map(\"restaurant_tax_rate_bucket_snapshots\")\n}\n\n/// Immutable v1 evidence assigning each frozen tax-rate bucket's cents to the\n/// original tender that funded them. Bucket allocationKind/billLineId/unitOrdinal\n/// retain the authoritative merchandise-unit versus service-charge semantics.\nmodel RestaurantTaxTenderAllocationSnapshot {\n  id                   String               @id @default(cuid())\n  organizationId       String               @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  snapshotId           String\n  billId               String\n  rateBucketSnapshotId String\n  originalTenderId     String\n  paymentCategory      RestaurantTenderType\n  cents                BigInt\n  createdAt            DateTime             @default(now())\n\n  snapshot          RestaurantTaxTransactionSnapshot @relation(fields: [organizationId, snapshotId, billId], references: [organizationId, id, billId], onDelete: Restrict, map: \"restaurant_tax_tender_allocation_snapshot_bill_fkey\")\n  rateBucket        RestaurantTaxRateBucketSnapshot  @relation(fields: [organizationId, snapshotId, rateBucketSnapshotId], references: [organizationId, snapshotId, id], onDelete: Restrict, map: \"restaurant_tax_tender_allocation_bucket_fkey\")\n  originalTender    RestaurantTender                 @relation(fields: [organizationId, billId, originalTenderId, paymentCategory], references: [organizationId, billId, id, type], onDelete: Restrict, map: \"restaurant_tax_tender_allocation_tender_bill_category_fkey\")\n  refundAllocations RestaurantTaxRefundAllocation[]\n\n  @@unique([snapshotId, rateBucketSnapshotId, originalTenderId])\n  @@unique([organizationId, billId, originalTenderId, paymentCategory, snapshotId, rateBucketSnapshotId, id])\n  @@index([organizationId])\n  @@index([originalTenderId])\n  @@index([snapshotId])\n  @@map(\"restaurant_tax_tender_allocation_snapshots\")\n}\n\n/// Append-only refund cents bound to one exact frozen tender-allocation fact.\nmodel RestaurantTaxRefundAllocation {\n  id                           String               @id @default(cuid())\n  organizationId               String               @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  billId                       String\n  refundId                     String\n  originalTenderId             String\n  paymentCategory              RestaurantTenderType\n  originalSnapshotId           String\n  originalRateBucketSnapshotId String\n  originalTenderAllocationId   String\n  cents                        BigInt\n  createdAt                    DateTime             @default(now())\n\n  refund             RestaurantRefund                      @relation(fields: [organizationId, billId, originalTenderId, refundId], references: [organizationId, billId, originalTenderId, id], onDelete: Restrict, map: \"restaurant_tax_refund_allocation_refund_fkey\")\n  originalAllocation RestaurantTaxTenderAllocationSnapshot @relation(fields: [organizationId, billId, originalTenderId, paymentCategory, originalSnapshotId, originalRateBucketSnapshotId, originalTenderAllocationId], references: [organizationId, billId, originalTenderId, paymentCategory, snapshotId, rateBucketSnapshotId, id], onDelete: Restrict, map: \"restaurant_tax_refund_allocation_original_fkey\")\n\n  @@unique([refundId, originalTenderAllocationId])\n  @@index([organizationId])\n  @@index([originalTenderAllocationId])\n  @@map(\"restaurant_tax_refund_allocations\")\n}\n\nmodel RestaurantTerminalProviderConfig {\n  id                 String                         @id @default(cuid())\n  organizationId     String                         @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId           String\n  source             String\n  externalTerminalId String\n  deviceId           String\n  mode               RestaurantTerminalProviderMode @default(DISABLED)\n  createdAt          DateTime                       @default(now())\n  updatedAt          DateTime                       @updatedAt\n\n  branch          RestaurantBranch                   @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Cascade)\n  device          RestaurantRegisteredDevice         @relation(fields: [organizationId, deviceId], references: [organizationId, id], onDelete: Restrict)\n  reconciliations RestaurantTerminalReconciliation[]\n\n  @@unique([organizationId, source, externalTerminalId])\n  @@unique([organizationId, id])\n  @@index([organizationId])\n  @@index([branchId])\n  @@map(\"restaurant_terminal_provider_configs\")\n}\n\nmodel RestaurantTerminalReconciliation {\n  id                String                        @id @default(cuid())\n  organizationId    String                        @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  configId          String\n  branchId          String\n  externalEventId   String\n  source            String\n  eventStatus       RestaurantTerminalEventStatus\n  externalReference String\n  amount            Decimal                       @db.Decimal(12, 2)\n  tipAmount         Decimal                       @default(0) @db.Decimal(12, 2)\n  billId            String?\n  paymentId         String?\n  tenderId          String?\n  outcome           String\n  failureReason     String?\n  processedAt       DateTime                      @default(now())\n  createdAt         DateTime                      @default(now())\n\n  config  RestaurantTerminalProviderConfig @relation(fields: [organizationId, configId], references: [organizationId, id], onDelete: Restrict)\n  branch  RestaurantBranch                 @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)\n  bill    RestaurantBill?                  @relation(fields: [organizationId, billId], references: [organizationId, id], onDelete: Restrict)\n  payment RestaurantPayment?               @relation(fields: [organizationId, paymentId], references: [organizationId, id], onDelete: Restrict)\n  tender  RestaurantTender?                @relation(fields: [organizationId, tenderId], references: [organizationId, id], onDelete: Restrict)\n\n  @@unique([organizationId, source, externalEventId])\n  @@unique([organizationId, id])\n  @@index([organizationId])\n  @@index([branchId, processedAt])\n  @@map(\"restaurant_terminal_reconciliations\")\n}\n\n/// \\xA74.1/\\xA78/D12: branch authorization is an additional boundary above organization\n/// RLS, expressed as explicit user-to-branch assignment rows enforced server-side.\n/// The branchId column and this table are the policy-ready seams for a later\n/// branch-scope DB decision (D12); no branch-level DB policy is invented here.\nmodel RestaurantBranchAssignment {\n  id             String   @id @default(cuid())\n  organizationId String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId       String\n  userId         String\n  createdAt      DateTime @default(now())\n  updatedAt      DateTime @updatedAt\n\n  branch RestaurantBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)\n  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)\n\n  @@unique([branchId, userId])\n  @@index([organizationId])\n  @@index([userId])\n  @@map(\"restaurant_branch_assignments\")\n}\n\n// ===========================================================================\n// M2 \\u2014 Restaurant staff, operator credentials, devices, terminal sessions and\n// co-authorization. Every model below is org-scoped under forced RLS (C1); the\n// credential/token/secret material is stored hashed-at-rest only (C2/C4/C5);\n// the co-authorization record is the C7 evidence primitive shared by the L2\n// back-office and L3 terminal paths.\n// ===========================================================================\n\n/// M2/C4/\\xA79: lifecycle of a staff operator profile. A profile is never a User \\u2014\n/// suspension and archival gate operator sign-in without touching any web login.\nenum RestaurantStaffStatus {\n  ACTIVE\n  SUSPENDED\n  ARCHIVED\n}\n\n/// M2/C4: the two operator credential kinds. PIN is a short numeric secret;\n/// BADGE is a scanned/tapped token. Both are stored only as a salted slow hash.\n/// No WebAuthn/biometric kind exists (C4 \\u2014 deferred).\nenum RestaurantOperatorCredentialType {\n  PIN\n  BADGE\n}\n\n/// M2/C5: a registered device is either trusted (ACTIVE) or de-authorized\n/// (REVOKED). Revocation is re-checked in the DB on every terminal call.\nenum RestaurantRegisteredDeviceStatus {\n  ACTIVE\n  REVOKED\n}\n\n/// \\xA74.1/\\xA79/C3: a restaurant staff operator. Deliberately NOT a \\`User\\`: an\n/// operator can exist with no web-login identity at all, so \\`userId\\` is an\n/// optional, one-way link and \\`email\\` is optional (unique within the\n/// organization only when present \\u2014 a partial unique index enforces that in the\n/// migration, since Prisma cannot express a filtered unique). Org-scoped under\n/// forced RLS; the operator's credentials and sessions hang off this row.\nmodel RestaurantStaffProfile {\n  id              String                @id @default(cuid())\n  organizationId  String                @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  userId          String?\n  email           String?\n  displayName     String\n  primaryBranchId String?\n  status          RestaurantStaffStatus @default(ACTIVE)\n  createdAt       DateTime              @default(now())\n  updatedAt       DateTime              @updatedAt\n\n  user                   User?                               @relation(\"RestaurantStaffUser\", fields: [userId], references: [id], onDelete: SetNull)\n  primaryBranch          RestaurantBranch?                   @relation(\"RestaurantStaffPrimaryBranch\", fields: [primaryBranchId], references: [id], onDelete: SetNull)\n  credentials            RestaurantOperatorCredential[]\n  terminalSessions       RestaurantTerminalSession[]         @relation(\"TerminalSessionActiveStaff\")\n  actingCoAuths          RestaurantCoAuthorization[]         @relation(\"CoAuthActingStaff\")\n  approvingCoAuths       RestaurantCoAuthorization[]         @relation(\"CoAuthApprovingStaff\")\n  auditLogs              AuditLog[]                          @relation(\"StaffProfileAuditLogs\")\n  // M4-L1: section assignments (per business date) and order/kitchen attribution\n  // (the operator who opened an order, the assigned server, and the acting\n  // operator on an order event). Attribution is preserved on archival (\\xA711.6).\n  sectionAssignments     RestaurantServerSectionAssignment[]\n  ordersOpened           RestaurantOrder[]                   @relation(\"OrderOpeningStaff\")\n  ordersServed           RestaurantOrder[]                   @relation(\"OrderServerStaff\")\n  actedOrderEvents       RestaurantOrderEvent[]              @relation(\"OrderEventActorStaff\")\n  billsOpened            RestaurantBill[]\n  payments               RestaurantPayment[]\n  tenders                RestaurantTender[]\n  refunds                RestaurantRefund[]\n  drawerSessions         RestaurantDrawerSession[]\n  drawerMovements        RestaurantDrawerMovement[]\n  dailyClosesCut         RestaurantDailyClose[]\n  // M6-L1: best-effort inventory attribution (nullable on the child rows) \\u2014 the\n  // operator who posted a movement, ran a count/transfer or received goods, and\n  // the creator/approver of a purchase order.\n  stockMovements         RestaurantStockMovement[]\n  stockCounts            RestaurantStockCount[]\n  stockTransfers         RestaurantStockTransfer[]\n  purchaseReceipts       RestaurantPurchaseReceipt[]\n  purchaseOrdersCreated  RestaurantPurchaseOrder[]           @relation(\"PurchaseOrderCreatedBy\")\n  purchaseOrdersApproved RestaurantPurchaseOrder[]           @relation(\"PurchaseOrderApprovedBy\")\n  // M7-L1: best-effort SOP attribution (nullable on the child rows) \\u2014 the\n  // operator who completed a step, uploaded evidence, verified an occurrence, or\n  // is named on an escalation event \\u2014 plus the operator a notification is for.\n  sopStepsCompleted      RestaurantSopOccurrenceStep[]\n  sopEvidenceUploaded    RestaurantSopEvidence[]\n  sopVerifications       RestaurantSopVerification[]\n  sopEscalationEvents    RestaurantSopEscalationEvent[]\n  notifications          RestaurantNotification[]\n  // SOP-1: branch-scoped job-role holdings (many-to-many), the direct capability\n  // grants that union with them, the append-only membership audit (as subject,\n  // actor, or grantor), and the two SOP assignee paths \\u2014 a PERSON-target\n  // assignment, an occurrence assigned directly, and an occurrence this operator\n  // claimed out of a role pool.\n  jobRoles               RestaurantStaffJobRole[]            @relation(\"StaffJobRoleHolder\")\n  jobRolesGranted        RestaurantStaffJobRole[]            @relation(\"StaffJobRoleGrantor\")\n  directCapabilityGrants RestaurantStaffCapabilityGrant[]    @relation(\"StaffDirectCapabilityGrant\")\n  jobRoleAudits          RestaurantStaffJobRoleAudit[]       @relation(\"StaffJobRoleAuditSubject\")\n  jobRoleAuditsActed     RestaurantStaffJobRoleAudit[]       @relation(\"StaffJobRoleAuditActor\")\n  // B1/WHA-285: the append-only trail of this person's capability overrides, and\n  // the ones they set on somebody else.\n  capabilityAudits       RestaurantStaffCapabilityAudit[]    @relation(\"StaffCapabilityAuditSubject\")\n  capabilityAuditsActed  RestaurantStaffCapabilityAudit[]    @relation(\"StaffCapabilityAuditActor\")\n  sopAssignmentsTargeted RestaurantSopAssignment[]           @relation(\"SopAssignmentAssignee\")\n  sopOccurrencesAssigned RestaurantSopOccurrence[]           @relation(\"SopOccurrenceAssignee\")\n  sopOccurrencesClaimed  RestaurantSopOccurrence[]           @relation(\"SopOccurrenceClaimer\")\n  cateringOrdersCreated  RestaurantCateringOrder[]           @relation(\"CateringOrderCreator\")\n  cateringDeliveries     RestaurantCateringDelivery[]        @relation(\"CateringDeliveryDriver\")\n  cateringEvents         RestaurantCateringEvent[]           @relation(\"CateringEventActor\")\n\n  // Completion wave: rostered shifts for this operator. A profile may hold many\n  // shifts in different roles; they may never overlap in time (shifts.ts).\n  shifts                RestaurantShift[]\n  shiftSwapRequests     RestaurantShiftSwapRequest[] @relation(\"ShiftSwapRequester\")\n  shiftSwapReplacements RestaurantShiftSwapRequest[] @relation(\"ShiftSwapReplacement\")\n\n  @@index([organizationId])\n  @@index([userId])\n  @@index([primaryBranchId])\n  @@map(\"restaurant_staff_profiles\")\n}\n\n/// \\xA79/C2/C4: an operator credential. Structurally unreachable from web login \\u2014\n/// it references a staff profile, never a \\`User\\`, and carries no plaintext\n/// column: only \\`credentialHash\\` (a salted slow hash) is stored. \\`deviceId\\` is\n/// the optional device scope (null = valid across the organization's terminals\n/// for this operator). The lockout counters (\\`failedAttempts\\`, \\`lockedUntil\\`)\n/// and \\`revokedAt\\` are durable on the row (C4 \\u2014 never a per-instance cache);\n/// exactly one active (non-revoked) credential may exist per\n/// (organization, staff, type, device) \\u2014 enforced by a partial unique index in\n/// the migration.\nmodel RestaurantOperatorCredential {\n  id             String                           @id @default(cuid())\n  organizationId String                           @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  staffProfileId String\n  deviceId       String?\n  type           RestaurantOperatorCredentialType\n  credentialHash String\n  failedAttempts Int                              @default(0)\n  lockedUntil    DateTime?\n  revokedAt      DateTime?\n  createdAt      DateTime                         @default(now())\n  updatedAt      DateTime                         @updatedAt\n\n  staffProfile RestaurantStaffProfile      @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)\n  device       RestaurantRegisteredDevice? @relation(fields: [deviceId], references: [id], onDelete: Cascade)\n\n  @@index([organizationId])\n  @@index([staffProfileId])\n  @@index([deviceId])\n  @@map(\"restaurant_operator_credentials\")\n}\n\n/// \\xA75/C5: a device trusted to act as a POS/KDS terminal. Enrollment mints a\n/// high-entropy device secret; only its hash (\\`deviceSecretHash\\`, globally\n/// unique like other secret hashes) is stored. A device belongs to one branch;\n/// \\`status\\`/\\`revokedAt\\` are re-checked in the DB on every terminal call so a\n/// revoked device cannot keep operating from a stale client cache.\nmodel RestaurantRegisteredDevice {\n  id               String                           @id @default(cuid())\n  organizationId   String                           @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId         String\n  name             String\n  deviceSecretHash String                           @unique\n  status           RestaurantRegisteredDeviceStatus @default(ACTIVE)\n  // M4-L1 (additive): what kind of terminal this device acts as. Defaults to POS\n  // so every M2-enrolled device keeps its existing behaviour; a KDS device is\n  // bound to exactly one kitchen station via the nullable \\`stationId\\` seam (C8).\n  kind             RestaurantDeviceKind             @default(POS)\n  stationId        String?\n  lastSeenAt       DateTime?\n  revokedAt        DateTime?\n  createdAt        DateTime                         @default(now())\n  updatedAt        DateTime                         @updatedAt\n\n  branch                    RestaurantBranch                    @relation(fields: [branchId], references: [id], onDelete: Cascade)\n  station                   RestaurantKitchenStation?           @relation(fields: [stationId], references: [id], onDelete: SetNull)\n  credentials               RestaurantOperatorCredential[]\n  terminalSessions          RestaurantTerminalSession[]\n  coAuthorizations          RestaurantCoAuthorization[]\n  // M4-L1: orders opened from this terminal, order events attributed to it, and\n  // the device-scoped idempotency keys guarding its command replays (C7).\n  ordersOpened              RestaurantOrder[]                   @relation(\"OrderOpeningDevice\")\n  actedOrderEvents          RestaurantOrderEvent[]              @relation(\"OrderEventActorDevice\")\n  idempotencyKeys           RestaurantOrderIdempotencyKey[]\n  bills                     RestaurantBill[]\n  payments                  RestaurantPayment[]\n  tenders                   RestaurantTender[]\n  terminalProviderConfigs   RestaurantTerminalProviderConfig[]\n  refunds                   RestaurantRefund[]\n  drawerSessions            RestaurantDrawerSession[]\n  drawerMovements           RestaurantDrawerMovement[]\n  dailyCloses               RestaurantDailyClose[]\n  moneyIdempotencyKeys      RestaurantMoneyIdempotencyKey[]\n  // M6-L1: terminal-attributed inventory movements/receipts and the separate\n  // inventory idempotency-key replay domain (all nullable device refs).\n  stockMovements            RestaurantStockMovement[]\n  inventoryPurchaseReceipts RestaurantPurchaseReceipt[]\n  inventoryIdempotencyKeys  RestaurantInventoryIdempotencyKey[]\n\n  @@unique([organizationId, id])\n  @@index([organizationId])\n  @@index([branchId])\n  @@index([status])\n  @@index([stationId])\n  @@map(\"restaurant_registered_devices\")\n}\n\n/// \\xA75/C5: an established terminal session on a registered device. The session\n/// token is stored only as a hash (\\`tokenHash\\`, globally unique for lookup).\n/// \\`activeStaffProfileId\\` is nullable \\u2014 a terminal can be established and locked\n/// with no operator bound. Validity is re-derived in the DB every call from the\n/// device status, session end state, and credential revocation; client time is\n/// never trusted (C5).\nmodel RestaurantTerminalSession {\n  id                   String    @id @default(cuid())\n  organizationId       String    @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  deviceId             String\n  activeStaffProfileId String?\n  tokenHash            String    @unique\n  establishedAt        DateTime  @default(now())\n  lastActivityAt       DateTime  @default(now())\n  endedAt              DateTime?\n  updatedAt            DateTime  @updatedAt\n\n  device             RestaurantRegisteredDevice  @relation(fields: [deviceId], references: [id], onDelete: Cascade)\n  activeStaffProfile RestaurantStaffProfile?     @relation(\"TerminalSessionActiveStaff\", fields: [activeStaffProfileId], references: [id], onDelete: SetNull)\n  coAuthorizations   RestaurantCoAuthorization[]\n\n  @@index([organizationId])\n  @@index([deviceId])\n  @@index([activeStaffProfileId])\n  @@index([endedAt])\n  @@map(\"restaurant_terminal_sessions\")\n}\n\n/// C6/C7: the co-authorization evidence record. A sensitive action taken by the\n/// acting operator is authorized by a distinct approving manager \\u2014 approval\n/// ADDS the manager's identity, it never replaces the actor (C6). The record\n/// pins both staff identities, the capability/action, the target, the reason,\n/// the device and terminal session (present for the L3 terminal path, null for\n/// the L2 back-office path), and a SERVER timestamp (\\`createdAt\\` \\u2014 client time\n/// is untrusted). The two staff foreign keys use ON DELETE RESTRICT so this\n/// evidence cannot be silently erased by deleting a profile (archival is the\n/// intended path). Append-only by contract; L1 owns no mutation of it.\nmodel RestaurantCoAuthorization {\n  id                      String   @id @default(cuid())\n  organizationId          String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  actingStaffProfileId    String\n  approvingStaffProfileId String\n  capability              String\n  targetType              String?\n  targetId                String?\n  reason                  String\n  deviceId                String?\n  terminalSessionId       String?\n  createdAt               DateTime @default(now())\n\n  actingStaffProfile    RestaurantStaffProfile      @relation(\"CoAuthActingStaff\", fields: [actingStaffProfileId], references: [id], onDelete: Restrict)\n  approvingStaffProfile RestaurantStaffProfile      @relation(\"CoAuthApprovingStaff\", fields: [approvingStaffProfileId], references: [id], onDelete: Restrict)\n  device                RestaurantRegisteredDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)\n  terminalSession       RestaurantTerminalSession?  @relation(fields: [terminalSessionId], references: [id], onDelete: SetNull)\n  billVoids             RestaurantBill[]\n  billLineComps         RestaurantBillLine[]\n  refunds               RestaurantRefund[]\n  dailyCloses           RestaurantDailyClose[]\n  // M7-L1: co-authorization optionally pinned on a sensitive SOP verification\n  // (VERIFY/REJECT/WAIVE) \\u2014 single-column FK, the M5 refund/close precedent.\n  sopVerifications      RestaurantSopVerification[]\n\n  @@index([organizationId])\n  @@index([actingStaffProfileId])\n  @@index([approvingStaffProfileId])\n  @@index([targetType, targetId])\n  @@index([createdAt])\n  @@map(\"restaurant_co_authorizations\")\n}\n\n// ===========================================================================\n// M3-L1 \\u2014 Brands, canonical catalog, recipes/BOM, effective-dated pricing,\n// brand-owned menus and branch-menu publications for the Restaurant vertical.\n//\n// Binding design constraints realised in this model set:\n//   C1  Every table is org-scoped (bare RLS-guarded organizationId defaulting\n//       from the transaction-local setting) and gets forced org RLS in the\n//       migration.\n//   C2  Structural shadow-copy prevention: canonical tables (brand, category,\n//       product, variant, modifier group/option, combo seam, unit, conversion,\n//       ingredient, allergen, recipe + versions + lines, price list + versions\n//       + entries, menu + sections + items) carry NO branchId. Branch linkage\n//       lives only on the publication side, which references canonical rows by\n//       FK. Override rows carry only availability + price \\u2014 never content.\n//   C3  Versioned records (recipe versions, price-list versions) are immutable\n//       once ACTIVE; editing forks a new version (DRAFT -> ACTIVE -> SUPERSEDED)\n//       and superseded versions stay readable forever. The transition/immutability\n//       primitives live in src/lib/restaurant/effective-dating.ts.\n//   C4  All monetary values are Decimal(12,2); no floats in catalog pricing.\n//   C5  Availability windows are branch-local wall-clock (minutes-of-day + a\n//       day-of-week set) evaluated server-side against RestaurantBranch.timezone;\n//       exception rows are branch-local calendar dates. Channel is an additive\n//       enum (D06 seam).\n//   C6  Exactly one default RestaurantBrand per organization (partial unique\n//       index in the migration); the default brand is ensured lazily by the\n//       catalog server (no onboarding edit, no SQL backfill).\n// ===========================================================================\n\n/// M3/C6: brand lifecycle. Archived brands are retained (history), not deleted.\nenum RestaurantBrandStatus {\n  ACTIVE\n  ARCHIVED\n}\n\n/// M3: a product is a simple ITEM or a COMBO (whose component structure lives in\n/// RestaurantComboComponentGroup). Additive enum (A08 seam).\nenum RestaurantProductType {\n  ITEM\n  COMBO\n}\n\n/// M3: product lifecycle. A referenced product is ARCHIVED, never hard-deleted.\nenum RestaurantProductStatus {\n  ACTIVE\n  ARCHIVED\n}\n\n/// M3/C3: shared lifecycle for immutable versioned records (recipe versions and\n/// price-list versions). A version is editable only while DRAFT; activation makes\n/// it immutable; a new active version SUPERSEDES the prior one, which stays\n/// readable forever (GOV-2).\nenum RestaurantVersionStatus {\n  DRAFT\n  ACTIVE\n  SUPERSEDED\n}\n\n/// M3/\\xA76.3: branch-menu publication lifecycle. RETIRED publications keep their\n/// history (GOV-2).\nenum RestaurantBranchMenuPublicationStatus {\n  DRAFT\n  PUBLISHED\n  RETIRED\n}\n\n/// M3/C5/D06: order-channel dimension for publications and availability. Additive\n/// seam \\u2014 extended, never renumbered.\nenum RestaurantOrderChannel {\n  DINE_IN\n  TAKEAWAY\n  DELIVERY\n}\n\nenum RestaurantDeliveryPaymentMode {\n  PREPAID\n  COD\n}\n\nenum RestaurantDeliveryFulfillmentStatus {\n  PENDING\n  DISPATCHED\n  DELIVERED\n  CANCELLED\n  FAILED\n}\n\n/// M3/C6: a customer-facing restaurant/virtual brand. A brand owns menus (\\xA76.3);\n/// the canonical catalog itself is organization-owned, not brand-owned. Exactly\n/// one default brand exists per organization (a partial unique index enforces it\n/// in the migration, since Prisma cannot express a filtered unique); the catalog\n/// server ensures the default lazily and idempotently.\nmodel RestaurantBrand {\n  id             String                @id @default(cuid())\n  organizationId String                @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  name           String\n  nameLocalized  Json?\n  status         RestaurantBrandStatus @default(ACTIVE)\n  isDefault      Boolean               @default(false)\n  createdAt      DateTime              @default(now())\n  updatedAt      DateTime              @updatedAt\n\n  menus RestaurantMenu[]\n\n  @@index([organizationId])\n  @@map(\"restaurant_brands\")\n}\n\n/// M3: a catalog category. \\`parentId\\` is a nullable self-reference for\n/// subcategories; deleting a parent detaches (SetNull), it does not cascade a\n/// subtree away. Organization-owned \\u2014 NO branchId (C2).\nmodel RestaurantCategory {\n  id             String   @id @default(cuid())\n  organizationId String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  parentId       String?\n  name           String\n  nameLocalized  Json?\n  sortOrder      Int      @default(0)\n  createdAt      DateTime @default(now())\n  updatedAt      DateTime @updatedAt\n\n  parent              RestaurantCategory?            @relation(\"RestaurantCategoryTree\", fields: [parentId], references: [id], onDelete: SetNull)\n  children            RestaurantCategory[]           @relation(\"RestaurantCategoryTree\")\n  products            RestaurantProduct[]\n  // M4-L1: station routing rules that target this category (category-level\n  // routing is the fallback below a product-level rule, above the branch default).\n  stationRoutingRules RestaurantStationRoutingRule[]\n\n  @@index([organizationId])\n  @@index([parentId])\n  @@map(\"restaurant_categories\")\n}\n\n/// M3: a sellable catalog product. \\`type\\` distinguishes a simple ITEM from a\n/// COMBO (whose component structure lives in RestaurantComboComponentGroup).\n/// Customer-facing text carries D20 locale-keyed JSON companions\n/// (\\`nameLocalized\\`, \\`descriptionLocalized\\`). Organization-owned \\u2014 NO branchId\n/// (C2). Products are archived (status ARCHIVED), not deleted, once referenced.\nmodel RestaurantProduct {\n  id                   String                  @id @default(cuid())\n  organizationId       String                  @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  categoryId           String?\n  type                 RestaurantProductType   @default(ITEM)\n  status               RestaurantProductStatus @default(ACTIVE)\n  name                 String\n  nameLocalized        Json?\n  description          String?\n  descriptionLocalized Json?\n  sortOrder            Int                     @default(0)\n  createdAt            DateTime                @default(now())\n  updatedAt            DateTime                @updatedAt\n\n  category              RestaurantCategory?              @relation(fields: [categoryId], references: [id], onDelete: SetNull)\n  variants              RestaurantProductVariant[]\n  modifierGroups        RestaurantProductModifierGroup[]\n  comboComponentGroups  RestaurantComboComponentGroup[]\n  comboUsages           RestaurantComboComponentOption[]\n  allergens             RestaurantProductAllergen[]\n  recipes               RestaurantRecipe[]\n  menuItems             RestaurantMenuItem[]\n  priceListEntries      RestaurantPriceListEntry[]\n  // M4-L1: order items snapshotted from this product, and station routing rules\n  // that target it (product-level routing outranks category-level, C-list).\n  orderItems            RestaurantOrderItem[]\n  stationRoutingRules   RestaurantStationRoutingRule[]\n  insightItemMixRollups InsightItemMixRollup[]\n  cateringLines         RestaurantCateringOrderLine[]\n\n  @@index([organizationId])\n  @@index([categoryId])\n  @@index([type])\n  @@index([status])\n  @@map(\"restaurant_products\")\n}\n\n/// M3: a size/variant of a product (e.g. Small/Large). Carries no price \\u2014 the\n/// price of a (product, variant) pair lives in effective-dated price-list\n/// entries (C4). Organization-owned \\u2014 NO branchId (C2).\nmodel RestaurantProductVariant {\n  id             String   @id @default(cuid())\n  organizationId String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  productId      String\n  name           String\n  nameLocalized  Json?\n  sortOrder      Int      @default(0)\n  createdAt      DateTime @default(now())\n  updatedAt      DateTime @updatedAt\n\n  product          RestaurantProduct                @relation(fields: [productId], references: [id], onDelete: Cascade)\n  priceListEntries RestaurantPriceListEntry[]\n  menuItems        RestaurantMenuItem[]\n  comboUsages      RestaurantComboComponentOption[]\n  recipes          RestaurantRecipe[]\n  // M4-L1: order items snapshotted from this variant.\n  orderItems       RestaurantOrderItem[]\n\n  @@index([organizationId])\n  @@index([productId])\n  @@map(\"restaurant_product_variants\")\n}\n\n/// M3: a modifier group (e.g. \"Choose a sauce\") with min/max selection rules\n/// (\\`maxSelect\\` null = unbounded). Attached to products via the join table.\n/// Organization-owned \\u2014 NO branchId (C2).\nmodel RestaurantModifierGroup {\n  id             String   @id @default(cuid())\n  organizationId String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  name           String\n  nameLocalized  Json?\n  minSelect      Int      @default(0)\n  maxSelect      Int?\n  createdAt      DateTime @default(now())\n  updatedAt      DateTime @updatedAt\n\n  options            RestaurantModifierOption[]\n  productAttachments RestaurantProductModifierGroup[]\n\n  @@index([organizationId])\n  @@map(\"restaurant_modifier_groups\")\n}\n\n/// M3: an option within a modifier group, with a Decimal price delta (C4).\nmodel RestaurantModifierOption {\n  id              String   @id @default(cuid())\n  organizationId  String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  modifierGroupId String\n  name            String\n  nameLocalized   Json?\n  priceDelta      Decimal  @default(0) @db.Decimal(12, 2)\n  sortOrder       Int      @default(0)\n  createdAt       DateTime @default(now())\n  updatedAt       DateTime @updatedAt\n\n  modifierGroup      RestaurantModifierGroup       @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)\n  // M4-L1: order-item modifier snapshots that were selected from this option.\n  // The snapshot copies name + price delta; the option link is a nullable\n  // convenience ref (SetNull) \\u2014 the frozen snapshot is authoritative (C4).\n  orderItemModifiers RestaurantOrderItemModifier[]\n\n  @@index([organizationId])\n  @@index([modifierGroupId])\n  @@map(\"restaurant_modifier_options\")\n}\n\n/// M3: attachment of a modifier group to a product (many-to-many with ordering).\nmodel RestaurantProductModifierGroup {\n  id              String   @id @default(cuid())\n  organizationId  String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  productId       String\n  modifierGroupId String\n  sortOrder       Int      @default(0)\n  createdAt       DateTime @default(now())\n  updatedAt       DateTime @updatedAt\n\n  product       RestaurantProduct       @relation(fields: [productId], references: [id], onDelete: Cascade)\n  modifierGroup RestaurantModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)\n\n  @@unique([productId, modifierGroupId])\n  @@index([organizationId])\n  @@index([modifierGroupId])\n  @@map(\"restaurant_product_modifier_groups\")\n}\n\n/// M3/A08 (combo seam \\u2014 schema + minimal CRUD only, no UI): a choose-group on a\n/// COMBO product (e.g. \"Choose a side\", choose 1..N).\nmodel RestaurantComboComponentGroup {\n  id             String   @id @default(cuid())\n  organizationId String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  comboProductId String\n  name           String\n  nameLocalized  Json?\n  minChoose      Int      @default(1)\n  maxChoose      Int?\n  sortOrder      Int      @default(0)\n  createdAt      DateTime @default(now())\n  updatedAt      DateTime @updatedAt\n\n  comboProduct RestaurantProduct                @relation(fields: [comboProductId], references: [id], onDelete: Cascade)\n  options      RestaurantComboComponentOption[]\n\n  @@index([organizationId])\n  @@index([comboProductId])\n  @@map(\"restaurant_combo_component_groups\")\n}\n\n/// M3/A08: a selectable component within a combo group, referencing a component\n/// product (and optional variant) with a Decimal price delta (C4). Referenced\n/// catalog rows are protected from deletion (Restrict); archival is the path.\nmodel RestaurantComboComponentOption {\n  id               String   @id @default(cuid())\n  organizationId   String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  componentGroupId String\n  productId        String\n  variantId        String?\n  priceDelta       Decimal  @default(0) @db.Decimal(12, 2)\n  sortOrder        Int      @default(0)\n  createdAt        DateTime @default(now())\n  updatedAt        DateTime @updatedAt\n\n  componentGroup RestaurantComboComponentGroup @relation(fields: [componentGroupId], references: [id], onDelete: Cascade)\n  product        RestaurantProduct             @relation(fields: [productId], references: [id], onDelete: Restrict)\n  variant        RestaurantProductVariant?     @relation(fields: [variantId], references: [id], onDelete: SetNull)\n\n  @@index([organizationId])\n  @@index([componentGroupId])\n  @@index([productId])\n  @@map(\"restaurant_combo_component_options\")\n}\n\n/// M3: a unit of measure (e.g. gram, each). Conversions between units are\n/// separate rows. Organization-owned.\nmodel RestaurantUnit {\n  id             String   @id @default(cuid())\n  organizationId String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  name           String\n  abbreviation   String?\n  createdAt      DateTime @default(now())\n  updatedAt      DateTime @updatedAt\n\n  conversionsFrom      RestaurantUnitConversion[]      @relation(\"RestaurantUnitConversionFrom\")\n  conversionsTo        RestaurantUnitConversion[]      @relation(\"RestaurantUnitConversionTo\")\n  ingredients          RestaurantIngredient[]\n  recipeLines          RestaurantRecipeLine[]\n  recipeVersions       RestaurantRecipeVersion[]\n  // M6-L1: canonical stock unit for stock items, and the ordering/receiving units\n  // recorded on purchase-order / receipt lines (converted to canonical at post).\n  stockItems           RestaurantStockItem[]\n  purchaseOrderLines   RestaurantPurchaseOrderLine[]\n  purchaseReceiptLines RestaurantPurchaseReceiptLine[]\n\n  @@index([organizationId])\n  @@map(\"restaurant_units\")\n}\n\n/// M3: a directed unit conversion (\\`factor\\` such that 1 fromUnit = factor toUnit),\n/// stored as a high-precision Decimal. The consistency/cycle guard is server-side\n/// (L2). One row per ordered (fromUnit, toUnit) pair.\nmodel RestaurantUnitConversion {\n  id             String   @id @default(cuid())\n  organizationId String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  fromUnitId     String\n  toUnitId       String\n  factor         Decimal  @db.Decimal(18, 6)\n  createdAt      DateTime @default(now())\n  updatedAt      DateTime @updatedAt\n\n  fromUnit RestaurantUnit @relation(\"RestaurantUnitConversionFrom\", fields: [fromUnitId], references: [id], onDelete: Cascade)\n  toUnit   RestaurantUnit @relation(\"RestaurantUnitConversionTo\", fields: [toUnitId], references: [id], onDelete: Cascade)\n\n  @@unique([fromUnitId, toUnitId])\n  @@index([organizationId])\n  @@index([toUnitId])\n  @@map(\"restaurant_unit_conversions\")\n}\n\n/// M3: an allergen the organization tracks. Attached to products and ingredients\n/// via join tables.\nmodel RestaurantAllergen {\n  id             String   @id @default(cuid())\n  organizationId String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  name           String\n  nameLocalized  Json?\n  createdAt      DateTime @default(now())\n  updatedAt      DateTime @updatedAt\n\n  productAllergens    RestaurantProductAllergen[]\n  ingredientAllergens RestaurantIngredientAllergen[]\n\n  @@index([organizationId])\n  @@map(\"restaurant_allergens\")\n}\n\n/// M3: product-to-allergen link (declared allergens on a product).\nmodel RestaurantProductAllergen {\n  id             String   @id @default(cuid())\n  organizationId String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  productId      String\n  allergenId     String\n  createdAt      DateTime @default(now())\n\n  product  RestaurantProduct  @relation(fields: [productId], references: [id], onDelete: Cascade)\n  allergen RestaurantAllergen @relation(fields: [allergenId], references: [id], onDelete: Cascade)\n\n  @@unique([productId, allergenId])\n  @@index([organizationId])\n  @@index([allergenId])\n  @@map(\"restaurant_product_allergens\")\n}\n\n/// M3: ingredient-to-allergen link (allergens carried by an ingredient).\nmodel RestaurantIngredientAllergen {\n  id             String   @id @default(cuid())\n  organizationId String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  ingredientId   String\n  allergenId     String\n  createdAt      DateTime @default(now())\n\n  ingredient RestaurantIngredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)\n  allergen   RestaurantAllergen   @relation(fields: [allergenId], references: [id], onDelete: Cascade)\n\n  @@unique([ingredientId, allergenId])\n  @@index([organizationId])\n  @@index([allergenId])\n  @@map(\"restaurant_ingredient_allergens\")\n}\n\n/// M3: a catalog-side ingredient identity. \\`referenceCost\\` is a nullable Decimal\n/// seam only (theoretical costing arrives with the Inventory/Purchasing\n/// milestone); NO stock fields (movements/counts/batches) exist here.\nmodel RestaurantIngredient {\n  id             String   @id @default(cuid())\n  organizationId String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  name           String\n  nameLocalized  Json?\n  baseUnitId     String\n  referenceCost  Decimal? @db.Decimal(12, 4)\n  createdAt      DateTime @default(now())\n  updatedAt      DateTime @updatedAt\n\n  baseUnit              RestaurantUnit                   @relation(fields: [baseUnitId], references: [id], onDelete: Restrict)\n  allergens             RestaurantIngredientAllergen[]\n  recipeLines           RestaurantRecipeLine[]\n  recipeLineSubstitutes RestaurantRecipeLineSubstitute[]\n  // M6-L1: the ingredient's stockable identity (one per ingredient). NO stock\n  // columns land on the ingredient itself \\u2014 inventory lives on RestaurantStockItem.\n  stockItem             RestaurantStockItem?\n\n  @@index([organizationId])\n  @@index([baseUnitId])\n  @@map(\"restaurant_ingredients\")\n}\n\n/// M3/C3: a recipe attached to a product (nullable variant seam). Its content\n/// lives in immutable versions; the recipe row is the stable identity that\n/// versions hang off. Sub-recipe references from other recipes' lines point at\n/// this row.\nmodel RestaurantRecipe {\n  id             String   @id @default(cuid())\n  organizationId String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  productId      String\n  variantId      String?\n  name           String\n  createdAt      DateTime @default(now())\n  updatedAt      DateTime @updatedAt\n\n  product        RestaurantProduct             @relation(fields: [productId], references: [id], onDelete: Cascade)\n  variant        RestaurantProductVariant?     @relation(fields: [variantId], references: [id], onDelete: SetNull)\n  versions       RestaurantRecipeVersion[]\n  subRecipeLines RestaurantRecipeLine[]        @relation(\"RecipeLineSubRecipe\")\n  cateringLines  RestaurantCateringOrderLine[]\n\n  @@index([organizationId])\n  @@index([productId])\n  @@index([variantId])\n  @@map(\"restaurant_recipes\")\n}\n\n/// M3/C3: an immutable-once-ACTIVE recipe version. Editing an ACTIVE version\n/// forks a new DRAFT (see effective-dating.ts); a partial unique index in the\n/// migration enforces at most one ACTIVE version per recipe. Superseded versions\n/// remain readable forever (GOV-2).\nmodel RestaurantRecipeVersion {\n  id             String                  @id @default(cuid())\n  organizationId String                  @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  recipeId       String\n  versionNumber  Int\n  status         RestaurantVersionStatus @default(DRAFT)\n  yieldQuantity  Decimal?                @db.Decimal(12, 3)\n  yieldUnitId    String?\n  portionCount   Int?\n  notes          String?\n  activatedAt    DateTime?\n  supersededAt   DateTime?\n  createdAt      DateTime                @default(now())\n  updatedAt      DateTime                @updatedAt\n\n  recipe    RestaurantRecipe       @relation(fields: [recipeId], references: [id], onDelete: Cascade)\n  yieldUnit RestaurantUnit?        @relation(fields: [yieldUnitId], references: [id], onDelete: SetNull)\n  lines     RestaurantRecipeLine[]\n\n  @@unique([recipeId, versionNumber])\n  @@index([organizationId])\n  @@index([recipeId])\n  @@index([status])\n  @@map(\"restaurant_recipe_versions\")\n}\n\n/// M3/C3: a version-owned bill-of-materials line. Exactly one of \\`ingredientId\\`\n/// or \\`subRecipeId\\` is set (a CHECK enforces the XOR in the migration); cycle\n/// detection over sub-recipes is server-side (L2). Quantity + unit are the BOM\n/// measure.\nmodel RestaurantRecipeLine {\n  id              String   @id @default(cuid())\n  organizationId  String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  recipeVersionId String\n  ingredientId    String?\n  subRecipeId     String?\n  quantity        Decimal  @db.Decimal(12, 4)\n  unitId          String\n  sortOrder       Int      @default(0)\n  createdAt       DateTime @default(now())\n  updatedAt       DateTime @updatedAt\n\n  recipeVersion       RestaurantRecipeVersion          @relation(fields: [recipeVersionId], references: [id], onDelete: Cascade)\n  ingredient          RestaurantIngredient?            @relation(fields: [ingredientId], references: [id], onDelete: Restrict)\n  subRecipe           RestaurantRecipe?                @relation(\"RecipeLineSubRecipe\", fields: [subRecipeId], references: [id], onDelete: Restrict)\n  unit                RestaurantUnit                   @relation(fields: [unitId], references: [id], onDelete: Restrict)\n  approvedSubstitutes RestaurantRecipeLineSubstitute[]\n\n  @@unique([organizationId, id])\n  @@index([organizationId])\n  @@index([recipeVersionId])\n  @@index([ingredientId])\n  @@index([subRecipeId])\n  @@map(\"restaurant_recipe_lines\")\n}\n\n/// Approved ingredient alternatives for an ingredient-backed recipe line. This\n/// is configuration only: fulfilment, costing, and allergen consequences remain\n/// server-owned by the later order-execution seam.\nmodel RestaurantRecipeLineSubstitute {\n  id                     String   @id @default(cuid())\n  organizationId         String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  recipeLineId           String\n  substituteIngredientId String\n  createdAt              DateTime @default(now())\n\n  recipeLine           RestaurantRecipeLine @relation(fields: [recipeLineId], references: [id], onDelete: Cascade)\n  substituteIngredient RestaurantIngredient @relation(fields: [substituteIngredientId], references: [id], onDelete: Restrict)\n\n  @@unique([recipeLineId, substituteIngredientId])\n  @@index([organizationId])\n  @@index([substituteIngredientId])\n  @@map(\"restaurant_recipe_line_substitutes\")\n}\n\n/// M3/C4: a named price list. \\`isDefault\\` marks the organization's base list\n/// (the fallback in the winning-price precedence item override > publication\n/// price list > base list); a partial unique index enforces one default per org.\nmodel RestaurantPriceList {\n  id             String   @id @default(cuid())\n  organizationId String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  name           String\n  isDefault      Boolean  @default(false)\n  createdAt      DateTime @default(now())\n  updatedAt      DateTime @updatedAt\n\n  versions     RestaurantPriceListVersion[]\n  publications RestaurantBranchMenuPublication[]\n\n  @@index([organizationId])\n  @@map(\"restaurant_price_lists\")\n}\n\n/// M3/C3/C4: an effective-dated, immutable-once-ACTIVE price-list version. The\n/// active version at an instant T is the ACTIVE version with the greatest\n/// \\`effectiveFrom <= T\\` (see effective-dating.ts); superseded versions remain\n/// readable. One version per (list, effectiveFrom).\nmodel RestaurantPriceListVersion {\n  id             String                  @id @default(cuid())\n  organizationId String                  @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  priceListId    String\n  versionNumber  Int\n  effectiveFrom  DateTime\n  status         RestaurantVersionStatus @default(DRAFT)\n  activatedAt    DateTime?\n  supersededAt   DateTime?\n  createdAt      DateTime                @default(now())\n  updatedAt      DateTime                @updatedAt\n\n  priceList RestaurantPriceList        @relation(fields: [priceListId], references: [id], onDelete: Cascade)\n  entries   RestaurantPriceListEntry[]\n  // M4-L1/C4: orders that snapshotted this price-list version as the price\n  // configuration used for calculation (\\xA711.1). SetNull on removal \\u2014 the item\n  // unit-price snapshots are authoritative, never rewritten by later edits.\n  orders    RestaurantOrder[]\n\n  @@unique([priceListId, effectiveFrom])\n  @@index([organizationId])\n  @@index([priceListId])\n  @@index([status])\n  @@map(\"restaurant_price_list_versions\")\n}\n\n/// M3/C4: a version-owned price for a (product, optional variant) pair. Money is\n/// Decimal(12,2). A migration-only COALESCE unique index enforces one entry per\n/// (version, product, variant) including the null-variant (base) row.\nmodel RestaurantPriceListEntry {\n  id                 String   @id @default(cuid())\n  organizationId     String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  priceListVersionId String\n  productId          String\n  variantId          String?\n  price              Decimal  @db.Decimal(12, 2)\n  createdAt          DateTime @default(now())\n  updatedAt          DateTime @updatedAt\n\n  priceListVersion RestaurantPriceListVersion @relation(fields: [priceListVersionId], references: [id], onDelete: Cascade)\n  product          RestaurantProduct          @relation(fields: [productId], references: [id], onDelete: Restrict)\n  variant          RestaurantProductVariant?  @relation(fields: [variantId], references: [id], onDelete: Restrict)\n\n  @@index([organizationId])\n  @@index([priceListVersionId])\n  @@index([productId])\n  @@map(\"restaurant_price_list_entries\")\n}\n\n/// M3/\\xA76.3: a brand-owned menu. Sections and items are its canonical structure;\n/// branches publish a menu via RestaurantBranchMenuPublication. NO branchId (C2).\nmodel RestaurantMenu {\n  id             String   @id @default(cuid())\n  organizationId String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  brandId        String\n  name           String\n  nameLocalized  Json?\n  description    String?\n  createdAt      DateTime @default(now())\n  updatedAt      DateTime @updatedAt\n\n  brand        RestaurantBrand                   @relation(fields: [brandId], references: [id], onDelete: Cascade)\n  sections     RestaurantMenuSection[]\n  publications RestaurantBranchMenuPublication[]\n\n  @@index([organizationId])\n  @@index([brandId])\n  @@map(\"restaurant_menus\")\n}\n\n/// M3: a section within a menu (ordered grouping of items).\nmodel RestaurantMenuSection {\n  id             String   @id @default(cuid())\n  organizationId String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  menuId         String\n  name           String\n  nameLocalized  Json?\n  sortOrder      Int      @default(0)\n  createdAt      DateTime @default(now())\n  updatedAt      DateTime @updatedAt\n\n  menu  RestaurantMenu       @relation(fields: [menuId], references: [id], onDelete: Cascade)\n  items RestaurantMenuItem[]\n\n  @@index([organizationId])\n  @@index([menuId])\n  @@map(\"restaurant_menu_sections\")\n}\n\n/// M3: a menu item scoping a product (and optional variant) into a section.\n/// \\`displayName\\`/\\`nameLocalized\\` are optional menu-specific naming; the referenced\n/// product is protected from deletion (Restrict).\nmodel RestaurantMenuItem {\n  id             String   @id @default(cuid())\n  organizationId String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  sectionId      String\n  productId      String\n  variantId      String?\n  displayName    String?\n  nameLocalized  Json?\n  sortOrder      Int      @default(0)\n  createdAt      DateTime @default(now())\n  updatedAt      DateTime @updatedAt\n\n  section   RestaurantMenuSection              @relation(fields: [sectionId], references: [id], onDelete: Cascade)\n  product   RestaurantProduct                  @relation(fields: [productId], references: [id], onDelete: Restrict)\n  variant   RestaurantProductVariant?          @relation(fields: [variantId], references: [id], onDelete: Restrict)\n  windows   RestaurantMenuAvailabilityWindow[]\n  overrides RestaurantBranchMenuItemOverride[]\n\n  @@index([organizationId])\n  @@index([sectionId])\n  @@index([productId])\n  @@map(\"restaurant_menu_items\")\n}\n\n/// M3/\\xA76.3/C5: a publication binding one branch to one brand-owned menu, with an\n/// optional price-list reference and a set of order channels (D06). Its status\n/// lifecycle is DRAFT -> PUBLISHED -> RETIRED; retired publications keep their\n/// history (GOV-2). Availability windows/exceptions and item overrides hang off\n/// it \\u2014 the only branch-linked catalog surface (C2).\nmodel RestaurantBranchMenuPublication {\n  id             String                                @id @default(cuid())\n  organizationId String                                @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId       String\n  menuId         String\n  priceListId    String?\n  status         RestaurantBranchMenuPublicationStatus @default(DRAFT)\n  channels       RestaurantOrderChannel[]              @default([])\n  publishedAt    DateTime?\n  retiredAt      DateTime?\n  createdAt      DateTime                              @default(now())\n  updatedAt      DateTime                              @updatedAt\n\n  branch        RestaurantBranch                      @relation(fields: [branchId], references: [id], onDelete: Cascade)\n  menu          RestaurantMenu                        @relation(fields: [menuId], references: [id], onDelete: Cascade)\n  priceList     RestaurantPriceList?                  @relation(fields: [priceListId], references: [id], onDelete: SetNull)\n  windows       RestaurantMenuAvailabilityWindow[]\n  exceptions    RestaurantMenuAvailabilityException[]\n  itemOverrides RestaurantBranchMenuItemOverride[]\n  // M4-L1/C4: orders that snapshotted this publication as the effective-menu\n  // source used for calculation (\\xA711.1). SetNull keeps the order if the\n  // publication is later retired/removed \\u2014 the snapshot columns are authoritative.\n  orders        RestaurantOrder[]\n\n  @@index([organizationId])\n  @@index([branchId])\n  @@index([menuId])\n  @@index([status])\n  @@map(\"restaurant_branch_menu_publications\")\n}\n\n/// M3/C5: a publication-owned availability window. Stored as branch-local\n/// wall-clock minutes-of-day (\\`startMinutes\\`/\\`endMinutes\\`) plus a day-of-week set\n/// (\\`daysOfWeek\\`, 0=Sunday..6=Saturday); a cross-midnight window has\n/// endMinutes <= startMinutes. Evaluated server-side against the branch timezone\n/// (client time is untrusted). Optional \\`menuItemId\\` scopes the window to a single\n/// item; null = whole publication.\nmodel RestaurantMenuAvailabilityWindow {\n  id             String   @id @default(cuid())\n  organizationId String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  publicationId  String\n  menuItemId     String?\n  label          String?\n  daysOfWeek     Int[]    @default([])\n  startMinutes   Int\n  endMinutes     Int\n  createdAt      DateTime @default(now())\n  updatedAt      DateTime @updatedAt\n\n  publication RestaurantBranchMenuPublication @relation(fields: [publicationId], references: [id], onDelete: Cascade)\n  menuItem    RestaurantMenuItem?             @relation(fields: [menuItemId], references: [id], onDelete: Cascade)\n\n  @@index([organizationId])\n  @@index([publicationId])\n  @@index([menuItemId])\n  @@map(\"restaurant_menu_availability_windows\")\n}\n\n/// M3/C5: a publication-owned exception for a single branch-local calendar date.\n/// \\`isClosed\\` true closes an otherwise-open date; false opens an otherwise-closed\n/// one. One exception per (publication, date).\nmodel RestaurantMenuAvailabilityException {\n  id             String   @id @default(cuid())\n  organizationId String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  publicationId  String\n  date           DateTime @db.Date\n  isClosed       Boolean  @default(true)\n  label          String?\n  createdAt      DateTime @default(now())\n  updatedAt      DateTime @updatedAt\n\n  publication RestaurantBranchMenuPublication @relation(fields: [publicationId], references: [id], onDelete: Cascade)\n\n  @@unique([publicationId, date])\n  @@index([organizationId])\n  @@index([publicationId])\n  @@map(\"restaurant_menu_availability_exceptions\")\n}\n\n/// M3/C2: a per-publication override of a menu item. Carries ONLY an availability\n/// flag and a nullable Decimal price override \\u2014 never content (name/composition).\n/// One override per (publication, menuItem).\nmodel RestaurantBranchMenuItemOverride {\n  id             String   @id @default(cuid())\n  organizationId String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  publicationId  String\n  menuItemId     String\n  isAvailable    Boolean  @default(true)\n  priceOverride  Decimal? @db.Decimal(12, 2)\n  createdAt      DateTime @default(now())\n  updatedAt      DateTime @updatedAt\n\n  publication RestaurantBranchMenuPublication @relation(fields: [publicationId], references: [id], onDelete: Cascade)\n  menuItem    RestaurantMenuItem              @relation(fields: [menuItemId], references: [id], onDelete: Cascade)\n\n  @@unique([publicationId, menuItemId])\n  @@index([organizationId])\n  @@index([publicationId])\n  @@index([menuItemId])\n  @@map(\"restaurant_branch_menu_item_overrides\")\n}\n\n// ===========================================================================\n// M4-L1 \\u2014 Orders, kitchen (KOT/KDS), floor & service sections/stations, the\n// append-only order event ledger + transactional outbox, device idempotency,\n// and per-branch business-day order numbering for the Restaurant vertical\n// (restaurant/m4).\n//\n// Binding design constraints realised in this model set:\n//   C1  Every table is org-scoped (bare RLS-guarded organizationId defaulting\n//       from the transaction-local setting) and gets forced org RLS in the\n//       migration. No M4 table lives outside tenant RLS.\n//   C2  Ledger-first: every order/item state change appends a\n//       RestaurantOrderEvent (append-only, per-order monotonic \\`sequence\\`) and a\n//       RestaurantEventOutbox row in the SAME transaction as the change (see\n//       src/lib/restaurant/outbox.ts). KOT/KDS read models derive from durable\n//       rows (events + tickets + item states), never from process-local\n//       emission. The outbox dispatcher is a seam (interface + PENDING/\n//       DISPATCHED/DEAD + attempt fields); no external consumer ships in M4.\n//   C3  Single-authority state machines: the exact RestaurantOrderStatus and\n//       RestaurantOrderItemStatus enums live here; transition maps + \\xA711.1\n//       invariants live in src/lib/restaurant/order-state-machine.ts; only the\n//       L2 command layer writes the status columns. No stored aggregate/total on\n//       the order \\u2014 order aggregates are derived (governance-testable).\n//   C4  Snapshot-on-write: an order item freezes name, unit\n//       price, quantity, and tax/service-charge fields (structurally present,\n//       zero-valued until the tax milestone), plus the publication +\n//       price-list-version references used. All money is Decimal; no floats.\n//       Modifier selections snapshot name + price delta. A nullable seatNumber\n//       is the \\xA711.2 seat seam.\n//   C5  Business date is stamped explicitly at creation from branch timezone +\n//       businessDayCutoff (Intl-based, DST-safe); the human order number is\n//       allocated transactionally from a per-(branch, businessDate) sequence\n//       row (uniqueness + monotonicity guaranteed; gap-free NOT promised). Order\n//       numbers are not receipt numbers.\n//   C6  Attribution: every order/item command records the acting operator\n//       (staffProfileId) and terminal (deviceId); server time (createdAt) is\n//       authoritative. Post-preparation void / cancel-with-prepared-items\n//       require a co-authorization (M2 primitive) + reason + wastage\n//       disposition; the disposition is recorded with NO inventory mutation in\n//       M4 (BUILD-ASSUMPTIONS).\n//   C7  Every terminal-submitted mutating command carries a device-scoped\n//       idempotency key (unique (deviceId, key)); replays return the original\n//       result and create nothing.\n// ===========================================================================\n\n/// M4/C3/\\xA711.1: the EXACT order status domain (no additions, renames, or\n/// omissions). The four kitchen-facing states (SENT/IN_PREPARATION/READY/SERVED)\n/// are DERIVED from item facts by the single derivation function in\n/// order-state-machine.ts and written only by the L2 command layer.\nenum RestaurantOrderStatus {\n  DRAFT\n  OPEN\n  SENT\n  IN_PREPARATION\n  READY\n  SERVED\n  PAYMENT_PENDING\n  CLOSED\n  CANCELLED\n}\n\n/// M4/C3/\\xA711.1: the EXACT order-item status domain. VOIDED is the single\n/// terminal state; KDS display statuses are a fixed mapping onto these\n/// (order-state-machine.ts), never a third authoritative machine.\nenum RestaurantOrderItemStatus {\n  HELD\n  QUEUED\n  FIRING\n  PREPARED\n  SERVED\n  REMAKE_REQUESTED\n  VOIDED\n}\n\n/// M4/C6: the stock policy hook recorded on a post-preparation void/waste. The\n/// disposition + outbox event are persisted; NO inventory mutation exists until\n/// the inventory milestone (BUILD-ASSUMPTIONS). NONE = no stock effect recorded.\nenum RestaurantWastageDisposition {\n  WASTE\n  RESTOCK\n  NONE\n}\n\n/// M4/\\xA711.2: why a table was linked to an order \\u2014 the guest was seated, an order\n/// was moved to a different table, or two tables were merged under one order.\nenum RestaurantOrderTableLinkReason {\n  SEATED\n  MOVE\n  MERGE\n}\n\n/// M4/C2: transactional-outbox dispatch lifecycle. PENDING awaits dispatch,\n/// DISPATCHED has been handed to a consumer, DEAD has exhausted its attempts\n/// (dead-letter). The dispatcher itself is a seam in M4 \\u2014 no external consumer\n/// ships (\\xA712.2 debt flagged, not claimed).\nenum RestaurantOutboxStatus {\n  PENDING\n  DISPATCHED\n  DEAD\n}\n\n/// M4/C8: what role a registered device plays. POS is a register/terminal; KDS\n/// is a kitchen display bound to one station. Additive seam \\u2014 extended, never\n/// renumbered.\nenum RestaurantDeviceKind {\n  POS\n  KDS\n}\n\n/// M4/\\xA74: a physical floor/area within a branch that holds tables. Org-scoped\n/// under forced RLS (C1).\nmodel RestaurantFloor {\n  id             String   @id @default(cuid())\n  organizationId String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId       String\n  name           String\n  sortOrder      Int      @default(0)\n  active         Boolean  @default(true)\n  createdAt      DateTime @default(now())\n  updatedAt      DateTime @updatedAt\n\n  branch RestaurantBranch  @relation(fields: [branchId], references: [id], onDelete: Cascade)\n  tables RestaurantTable[]\n\n  @@index([organizationId])\n  @@index([branchId])\n  @@map(\"restaurant_floors\")\n}\n\n/// M4/\\xA74: a table on a floor. \\`code\\` is the human table label, unique within its\n/// floor. \\`capacity\\` is the seat count. Org-scoped under forced RLS (C1).\nmodel RestaurantTable {\n  id             String   @id @default(cuid())\n  organizationId String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  floorId        String\n  code           String\n  capacity       Int\n  active         Boolean  @default(true)\n  createdAt      DateTime @default(now())\n  updatedAt      DateTime @updatedAt\n\n  floor        RestaurantFloor                @relation(fields: [floorId], references: [id], onDelete: Cascade)\n  sectionLinks RestaurantServerSectionTable[]\n  orderLinks   RestaurantOrderTable[]\n\n  @@unique([floorId, code])\n  @@index([organizationId])\n  @@index([floorId])\n  @@map(\"restaurant_tables\")\n}\n\n/// M4 (Restaurant Core): a server section \\u2014 a grouping of tables assigned to a\n/// server. Membership is a join table; per-business-date staffing is a separate\n/// assignment table. Org-scoped under forced RLS (C1).\nmodel RestaurantServerSection {\n  id             String   @id @default(cuid())\n  organizationId String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId       String\n  name           String\n  active         Boolean  @default(true)\n  createdAt      DateTime @default(now())\n  updatedAt      DateTime @updatedAt\n\n  branch      RestaurantBranch                    @relation(fields: [branchId], references: [id], onDelete: Cascade)\n  tableLinks  RestaurantServerSectionTable[]\n  assignments RestaurantServerSectionAssignment[]\n  orders      RestaurantOrder[]\n\n  @@index([organizationId])\n  @@index([branchId])\n  @@map(\"restaurant_server_sections\")\n}\n\n/// M4: section \\u2194 table membership. One row per (section, table).\nmodel RestaurantServerSectionTable {\n  id             String   @id @default(cuid())\n  organizationId String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  sectionId      String\n  tableId        String\n  createdAt      DateTime @default(now())\n  updatedAt      DateTime @updatedAt\n\n  section RestaurantServerSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)\n  table   RestaurantTable         @relation(fields: [tableId], references: [id], onDelete: Cascade)\n\n  // Membership is a plain join (no (sectionId, tableId) unique): a section may be\n  // re-seeded and L2 dedups at the command layer; the batteries probe a second\n  // membership row referencing the same parents.\n  @@index([organizationId])\n  @@index([sectionId])\n  @@index([tableId])\n  @@map(\"restaurant_server_section_tables\")\n}\n\n/// M4: the staff operator assigned to a section for a given business date. Shift\n/// granularity is deferred (BUILD-ASSUMPTIONS); one assignment per\n/// (section, staff, businessDate).\nmodel RestaurantServerSectionAssignment {\n  id             String   @id @default(cuid())\n  organizationId String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  sectionId      String\n  staffProfileId String\n  businessDate   DateTime @db.Date\n  createdAt      DateTime @default(now())\n  updatedAt      DateTime @updatedAt\n\n  section      RestaurantServerSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)\n  staffProfile RestaurantStaffProfile  @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)\n\n  @@unique([sectionId, staffProfileId, businessDate])\n  @@index([organizationId])\n  @@index([sectionId])\n  @@index([staffProfileId])\n  @@index([businessDate])\n  @@map(\"restaurant_server_section_assignments\")\n}\n\n/// M4 (Restaurant Core): a kitchen/prep station (grill, bar, expo). Exactly one\n/// default station per branch is enforced by a partial unique index in the\n/// migration (Prisma cannot express a filtered unique). Order items route to a\n/// station via the routing rules; unmatched items fall through to the default.\nmodel RestaurantKitchenStation {\n  id             String   @id @default(cuid())\n  organizationId String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId       String\n  name           String\n  active         Boolean  @default(true)\n  isDefault      Boolean  @default(false)\n  createdAt      DateTime @default(now())\n  updatedAt      DateTime @updatedAt\n\n  branch       RestaurantBranch               @relation(fields: [branchId], references: [id], onDelete: Cascade)\n  routingRules RestaurantStationRoutingRule[]\n  tickets      RestaurantKitchenTicket[]\n  devices      RestaurantRegisteredDevice[]\n  printRoutes  RestaurantPrintRoute[]\n\n  @@unique([organizationId, id])\n  @@index([organizationId])\n  @@index([branchId])\n  @@map(\"restaurant_kitchen_stations\")\n}\n\nenum RestaurantPrintDocumentType {\n  KITCHEN_TICKET\n  BAR_TICKET\n  RECEIPT\n}\n\nenum RestaurantPrintJobStatus {\n  PENDING\n  OFFLINE\n  NO_PRINTER\n  PRINTED\n}\n\n/// Durable, vendor-neutral branch/station/document routing. Printer identifiers\n/// are opaque adapter inputs; no hardware vendor contract is persisted here.\nmodel RestaurantPrintRoute {\n  id             String                      @id @default(cuid())\n  organizationId String                      @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId       String\n  stationId      String?\n  documentType   RestaurantPrintDocumentType\n  printerId      String\n  enabled        Boolean                     @default(true)\n  createdAt      DateTime                    @default(now())\n  updatedAt      DateTime                    @updatedAt\n\n  branch  RestaurantBranch          @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Cascade)\n  station RestaurantKitchenStation? @relation(fields: [organizationId, stationId], references: [organizationId, id], onDelete: Cascade)\n\n  @@unique([organizationId, branchId, stationId, documentType])\n  @@index([organizationId, branchId])\n  @@map(\"restaurant_print_routes\")\n}\n\n/// Append-only print intent and retry state. The unique tenant/branch key is the\n/// durable replay boundary; attempts update only delivery state, never payload.\nmodel RestaurantPrintJob {\n  id             String                      @id @default(cuid())\n  organizationId String                      @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId       String\n  stationId      String?\n  idempotencyKey String\n  documentType   RestaurantPrintDocumentType\n  document       Json\n  status         RestaurantPrintJobStatus    @default(PENDING)\n  printerId      String?\n  byteCount      Int?\n  attemptCount   Int                         @default(0)\n  lastAttemptAt  DateTime?\n  printedAt      DateTime?\n  createdAt      DateTime                    @default(now())\n  updatedAt      DateTime                    @updatedAt\n\n  branch RestaurantBranch @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)\n\n  @@unique([organizationId, branchId, idempotencyKey])\n  @@index([organizationId, status, createdAt])\n  @@map(\"restaurant_print_jobs\")\n}\n\n/// M4: a routing rule targeting a station. Exactly one of \\`productId\\` or\n/// \\`categoryId\\` is set (a CHECK enforces the XOR in the migration). Resolution is\n/// most-specific-wins (product rule > category rule > branch default) with\n/// \\`priority\\` breaking ties within a level (src/lib/restaurant/station-routing.ts).\nmodel RestaurantStationRoutingRule {\n  id             String   @id @default(cuid())\n  organizationId String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  stationId      String\n  productId      String?\n  categoryId     String?\n  priority       Int      @default(0)\n  createdAt      DateTime @default(now())\n  updatedAt      DateTime @updatedAt\n\n  station  RestaurantKitchenStation @relation(fields: [stationId], references: [id], onDelete: Cascade)\n  product  RestaurantProduct?       @relation(fields: [productId], references: [id], onDelete: Cascade)\n  category RestaurantCategory?      @relation(fields: [categoryId], references: [id], onDelete: Cascade)\n\n  @@index([organizationId])\n  @@index([stationId])\n  @@index([productId])\n  @@index([categoryId])\n  @@map(\"restaurant_station_routing_rules\")\n}\n\n/// M4/\\xA711.1: an order \\u2014 the kitchen & fulfilment scope (the financial Bill/Check\n/// scope is a later milestone). Immutable \\`id\\`; the human \\`orderNumber\\` is\n/// allocated per (branch, businessDate); \\`businessDate\\` is stamped explicitly\n/// (C5). The opening operator + terminal are recorded (C6); the effective-menu\n/// publication and price-list-version used for calculation are snapshotted (C4).\n/// There is NO stored total/aggregate column \\u2014 aggregates are derived (C3).\nmodel RestaurantOrder {\n  id                           String                 @id @default(cuid())\n  organizationId               String                 @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId                     String\n  orderNumber                  Int\n  businessDate                 DateTime               @db.Date\n  status                       RestaurantOrderStatus  @default(DRAFT)\n  channel                      RestaurantOrderChannel\n  coverCount                   Int?\n  sectionId                    String?\n  serverStaffProfileId         String?\n  staffProfileId               String\n  deviceId                     String\n  publicationId                String?\n  priceListVersionId           String?\n  serviceChargePolicyVersionId String?\n  customerId                   String?\n  openedAt                     DateTime?\n  closedAt                     DateTime?\n  cancelledAt                  DateTime?\n  createdAt                    DateTime               @default(now())\n  updatedAt                    DateTime               @updatedAt\n\n  branch                     RestaurantBranch                      @relation(fields: [branchId], references: [id], onDelete: Cascade)\n  section                    RestaurantServerSection?              @relation(fields: [sectionId], references: [id], onDelete: SetNull)\n  serverStaff                RestaurantStaffProfile?               @relation(\"OrderServerStaff\", fields: [serverStaffProfileId], references: [id], onDelete: SetNull)\n  openingStaff               RestaurantStaffProfile                @relation(\"OrderOpeningStaff\", fields: [staffProfileId], references: [id], onDelete: Restrict)\n  openingDevice              RestaurantRegisteredDevice            @relation(\"OrderOpeningDevice\", fields: [deviceId], references: [id], onDelete: Restrict)\n  publication                RestaurantBranchMenuPublication?      @relation(fields: [publicationId], references: [id], onDelete: SetNull)\n  priceListVersion           RestaurantPriceListVersion?           @relation(fields: [priceListVersionId], references: [id], onDelete: SetNull)\n  serviceChargePolicyVersion RestaurantServiceChargePolicyVersion? @relation(fields: [organizationId, serviceChargePolicyVersionId], references: [organizationId, id], onDelete: Restrict)\n  customer                   RestaurantCustomer?                   @relation(fields: [customerId], references: [id], onDelete: SetNull)\n  items                      RestaurantOrderItem[]\n  orderTables                RestaurantOrderTable[]\n  events                     RestaurantOrderEvent[]\n  kitchenTickets             RestaurantKitchenTicket[]\n  bills                      RestaurantBill[]\n  // M6-L1: RECIPE_CONSUMPTION / SALE_REVERSAL movements posted at order close and\n  // for post-close corrections reference the originating order (nullable, SetNull).\n  stockMovements             RestaurantStockMovement[]\n  customerInteractions       CustomerInteraction[]\n  deliveryFulfillment        RestaurantDeliveryFulfillment?\n\n  @@unique([branchId, businessDate, orderNumber])\n  @@unique([organizationId, branchId, id])\n  @@index([organizationId])\n  @@index([branchId])\n  @@index([status])\n  @@index([businessDate])\n  @@index([sectionId])\n  @@index([serverStaffProfileId])\n  @@index([staffProfileId])\n  @@index([deviceId])\n  @@index([customerId])\n  @@map(\"restaurant_orders\")\n}\n\n/// M4/C4/\\xA711.1: an order item with SNAPSHOT columns frozen at add time \\u2014\n/// \\`name\\`, \\`unitPrice\\`, \\`quantity\\`, and zero-valued tax/service-charge\n/// fields (structurally present; the tax milestone fills them). \\`course\\` and the\n/// nullable \\`seatNumber\\` (\\xA711.2 seat seam) support hold-and-fire table service.\n/// \\`remakeOfItemId\\` keeps a remake linked to its original (must resolve before\n/// the order's terminal condition, \\xA711.1). Post-preparation void records the\n/// post-prep flag, wastage disposition (C6 \\u2014 no stock mutation in M4), the\n/// co-authorization reference, and a reason.\nmodel RestaurantOrderItem {\n  id                    String                        @id @default(cuid())\n  organizationId        String                        @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  orderId               String\n  course                Int                           @default(1)\n  seatNumber            Int?\n  productId             String\n  variantId             String?\n  name                  String\n  unitPrice             Decimal                       @db.Decimal(12, 2)\n  quantity              Int                           @default(1)\n  taxAmount             Decimal                       @default(0) @db.Decimal(12, 2)\n  serviceChargeAmount   Decimal                       @default(0) @db.Decimal(12, 2)\n  status                RestaurantOrderItemStatus     @default(HELD)\n  remakeOfItemId        String?\n  voidedPostPrep        Boolean                       @default(false)\n  wastageDisposition    RestaurantWastageDisposition?\n  voidCoAuthorizationId String?\n  voidReason            String?\n  createdAt             DateTime                      @default(now())\n  updatedAt             DateTime                      @updatedAt\n\n  order       RestaurantOrder               @relation(fields: [orderId], references: [id], onDelete: Cascade)\n  product     RestaurantProduct             @relation(fields: [productId], references: [id], onDelete: Restrict)\n  variant     RestaurantProductVariant?     @relation(fields: [variantId], references: [id], onDelete: SetNull)\n  remakeOf    RestaurantOrderItem?          @relation(\"OrderItemRemake\", fields: [remakeOfItemId], references: [id], onDelete: SetNull)\n  remakes     RestaurantOrderItem[]         @relation(\"OrderItemRemake\")\n  modifiers   RestaurantOrderItemModifier[]\n  ticketItems RestaurantKitchenTicketItem[]\n  billLines   RestaurantBillLine[]\n\n  @@index([organizationId])\n  @@index([orderId])\n  @@index([productId])\n  @@index([variantId])\n  @@index([status])\n  @@index([remakeOfItemId])\n  @@map(\"restaurant_order_items\")\n}\n\n/// M4/C4: an item-owned modifier SNAPSHOT. Copies the option's name\n/// (\\`name\\`) and \\`priceDelta\\` at add time; the \\`modifierOptionId\\` link is\n/// a nullable convenience reference (SetNull) \\u2014 the snapshot is authoritative and\n/// is never rewritten by later catalog edits. (No composite tenant FK: the M3\n/// modifier-option table carries no (organizationId, id) unique and is consumed,\n/// never modified \\u2014 C9.)\nmodel RestaurantOrderItemModifier {\n  id               String   @id @default(cuid())\n  organizationId   String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  orderItemId      String\n  modifierOptionId String?\n  name             String\n  priceDelta       Decimal  @db.Decimal(12, 2)\n  createdAt        DateTime @default(now())\n  updatedAt        DateTime @updatedAt\n\n  orderItem      RestaurantOrderItem       @relation(fields: [orderItemId], references: [id], onDelete: Cascade)\n  modifierOption RestaurantModifierOption? @relation(fields: [modifierOptionId], references: [id], onDelete: SetNull)\n\n  @@index([organizationId])\n  @@index([orderItemId])\n  @@index([modifierOptionId])\n  @@map(\"restaurant_order_item_modifiers\")\n}\n\n/// M4/\\xA711.2: order \\u2194 table link history. \\`active\\` marks the current link; the\n/// \\`linkReason\\` records why it was made (seated, moved, merged). Merge = several\n/// active table links under one order; combining two OPEN orders into one is\n/// deferred (BUILD-ASSUMPTIONS). At most one active link per (order, table) is\n/// enforced by a partial unique index in the migration.\nmodel RestaurantOrderTable {\n  id             String                         @id @default(cuid())\n  organizationId String                         @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  orderId        String\n  tableId        String\n  active         Boolean                        @default(true)\n  linkReason     RestaurantOrderTableLinkReason @default(SEATED)\n  linkedAt       DateTime                       @default(now())\n  unlinkedAt     DateTime?\n  createdAt      DateTime                       @default(now())\n  updatedAt      DateTime                       @updatedAt\n\n  order RestaurantOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)\n  table RestaurantTable @relation(fields: [tableId], references: [id], onDelete: Cascade)\n\n  @@index([organizationId])\n  @@index([orderId])\n  @@index([tableId])\n  @@map(\"restaurant_order_tables\")\n}\n\n/// M4/C2/\\xA712.1: the append-only order event ledger. Each order/item state change\n/// appends one row with a per-order monotonically increasing \\`sequence\\` (unique\n/// (orderId, sequence)) inside the same transaction as the change. The acting\n/// operator/terminal are recorded; server \\`createdAt\\` is authoritative. This\n/// model has no updatedAt \\u2014 rows are append-only by contract (L1 owns no\n/// mutation of it); the KDS read model is derived from these rows + tickets +\n/// item states, never from process-local emission.\nmodel RestaurantOrderEvent {\n  id                  String   @id @default(cuid())\n  organizationId      String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  orderId             String\n  sequence            Int\n  eventType           String\n  actorStaffProfileId String?\n  actorDeviceId       String?\n  payload             Json\n  createdAt           DateTime @default(now())\n\n  order       RestaurantOrder             @relation(fields: [orderId], references: [id], onDelete: Cascade)\n  actorStaff  RestaurantStaffProfile?     @relation(\"OrderEventActorStaff\", fields: [actorStaffProfileId], references: [id], onDelete: SetNull)\n  actorDevice RestaurantRegisteredDevice? @relation(\"OrderEventActorDevice\", fields: [actorDeviceId], references: [id], onDelete: SetNull)\n\n  @@unique([orderId, sequence])\n  @@index([organizationId])\n  @@index([orderId])\n  @@index([actorStaffProfileId])\n  @@index([actorDeviceId])\n  @@map(\"restaurant_order_events\")\n}\n\n/// M4/C2/\\xA712.1: the transactional event outbox. Written in the same transaction\n/// as the durable state change it advertises; a dispatcher (a SEAM in M4 \\u2014 no\n/// external consumer ships) later moves PENDING rows to DISPATCHED or, after\n/// exhausting attempts, DEAD (dead-letter). \\`aggregateType\\`/\\`aggregateId\\` are a\n/// soft reference (the outbox outlives its aggregate and spans aggregate kinds);\n/// \\`nextAttemptAt\\` carries the backoff schedule.\nmodel RestaurantEventOutbox {\n  id             String                 @id @default(cuid())\n  organizationId String                 @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  eventType      String\n  aggregateType  String\n  aggregateId    String\n  payload        Json\n  status         RestaurantOutboxStatus @default(PENDING)\n  attempts       Int                    @default(0)\n  nextAttemptAt  DateTime?\n  lastError      String?\n  createdAt      DateTime               @default(now())\n  updatedAt      DateTime               @updatedAt\n\n  @@index([organizationId])\n  @@index([status, nextAttemptAt])\n  @@index([aggregateType, aggregateId])\n  @@map(\"restaurant_event_outbox\")\n}\n\n/// M4/C7/\\xA712.1: a device-scoped idempotency key. A terminal-submitted mutating\n/// command carries a \\`key\\`; the first occurrence records the \\`commandType\\` and\n/// the \\`resultRef\\` of what it created, and any replay of the same (deviceId, key)\n/// returns that original result and creates nothing. Unique (deviceId, key).\nmodel RestaurantOrderIdempotencyKey {\n  id             String   @id @default(cuid())\n  organizationId String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  deviceId       String\n  key            String\n  commandType    String\n  resultRef      String?\n  createdAt      DateTime @default(now())\n  updatedAt      DateTime @updatedAt\n\n  device RestaurantRegisteredDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)\n\n  @@unique([deviceId, key])\n  @@index([organizationId])\n  @@index([deviceId])\n  @@map(\"restaurant_order_idempotency_keys\")\n}\n\n/// M4 (KOT): a kitchen ticket routed to one station for one order. \\`ticketNumber\\`\n/// is sequential per (station, businessDate). The KDS read model derives its\n/// display from these tickets + the linked item states (C2/\\xA712.5); realtime is\n/// only a nudge to read this durable state \\u2014 no external channel ships in M4.\nmodel RestaurantKitchenTicket {\n  id             String   @id @default(cuid())\n  organizationId String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  orderId        String\n  stationId      String\n  businessDate   DateTime @db.Date\n  ticketNumber   Int\n  createdAt      DateTime @default(now())\n  updatedAt      DateTime @updatedAt\n\n  order   RestaurantOrder               @relation(fields: [orderId], references: [id], onDelete: Cascade)\n  station RestaurantKitchenStation      @relation(fields: [stationId], references: [id], onDelete: Restrict)\n  items   RestaurantKitchenTicketItem[]\n\n  @@unique([stationId, businessDate, ticketNumber])\n  @@index([organizationId])\n  @@index([orderId])\n  @@index([stationId])\n  @@map(\"restaurant_kitchen_tickets\")\n}\n\n/// M4 (KOT): a ticket line linking a kitchen ticket to an order item with the\n/// quantity fired to that station. One line per (ticket, orderItem).\nmodel RestaurantKitchenTicketItem {\n  id             String   @id @default(cuid())\n  organizationId String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  ticketId       String\n  orderItemId    String\n  quantity       Int\n  createdAt      DateTime @default(now())\n\n  ticket    RestaurantKitchenTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)\n  orderItem RestaurantOrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)\n\n  // Plain ticket line (no (ticketId, orderItemId) unique): a fired quantity may\n  // be split across lines and L2 composes them; the batteries probe a second\n  // line referencing the same ticket + item.\n  @@index([organizationId])\n  @@index([ticketId])\n  @@index([orderItemId])\n  @@map(\"restaurant_kitchen_ticket_items\")\n}\n\n/// M4/C5: the per-(branch, businessDate) order-number sequence. \\`nextNumber\\`\n/// holds the most recently allocated number; allocation is a transactional\n/// row-locked upsert (INSERT \\u2026 ON CONFLICT DO UPDATE SET nextNumber = nextNumber\n/// + 1 RETURNING) \\u2014 see src/lib/restaurant/order-numbers.ts. Uniqueness +\n/// monotonicity are guaranteed; gap-free is NOT promised (BUILD-ASSUMPTIONS).\nmodel RestaurantOrderNumberSequence {\n  id             String   @id @default(cuid())\n  organizationId String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId       String\n  businessDate   DateTime @db.Date\n  nextNumber     Int\n  createdAt      DateTime @default(now())\n  updatedAt      DateTime @updatedAt\n\n  branch RestaurantBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)\n\n  @@unique([branchId, businessDate])\n  @@index([organizationId])\n  @@index([branchId])\n  @@map(\"restaurant_order_number_sequences\")\n}\n\n// ===========================================================================\n// M5-L1 \\u2014 Money: bills & splits, tenders & tips, a capability-shaped MOCK\n// payment adapter, refunds, register drawer sessions, the immutable daily\n// close, and the receipt-number seam for the Restaurant vertical\n// (restaurant/m5-money).\n//\n// Additive and org-scoped. Every new table carries a bare, RLS-guarded\n// organizationId (defaulting from the transaction-local setting) and gets\n// forced org-level RLS with the exact clause used since M1-L1. No pre-M5 table\n// gains a column; the only edits to earlier models are virtual back-relation\n// fields (which emit no DDL), matching the M4 precedent.\n//\n// Binding design constraints (WHA-52 plan) realised here:\n//   C1  Forced org RLS on ALL 12 new tables.\n//   C2  Every monetary column is Decimal(12,2); ALL arithmetic goes through\n//       src/lib/restaurant/money.ts (no floats anywhere).\n//   C3  Append-only ledgers \\u2014 restaurant_tenders, restaurant_payment_events,\n//       restaurant_refunds, restaurant_drawer_movements, restaurant_daily_closes,\n//       restaurant_daily_close_tender_totals \\u2014 are DB-enforced append-only: the\n//       migration grants them SELECT+INSERT RLS policies ONLY (no UPDATE/DELETE\n//       policy \\u21D2 forced RLS denies mutation). These six models carry NO\n//       updatedAt. Corrections are NEW records referencing the original.\n//   C4  A bill belongs to exactly one order; split kinds NONE|BY_ITEM|BY_SEAT|\n//       FRACTIONAL; a comp nets a line to zero via compAmount while retaining the\n//       original snapshot price. Totals snapshot at bill-cut time.\n//   C5  tipAmount lives on tenders/refunds only, never merged into the\n//       (still-zero) service-charge snapshot; the close reports tipTotal and\n//       serviceChargeTotal separately.\n//   C10 Receipt numbers allocate from restaurant_receipt_number_sequences,\n//       unique (branchId, businessDate) \\u2014 a seam SEPARATE from order numbers.\n//   C11 Money commands carry a device-scoped idempotency key in\n//       restaurant_money_idempotency_keys (unique (deviceId, key)); every money\n//       record carries operator (staffProfile) + device attribution.\n// ===========================================================================\n\n/// M5/C4: bill lifecycle. OPEN checks accept splits/comps/tenders; a bill flips\n/// to SETTLED (receipt allocated) once covered, or VOID (reason + co-auth). A\n/// financial amount is never rewritten after SETTLED \\u2014 corrections are new\n/// records (C3).\nenum RestaurantBillStatus {\n  OPEN\n  SETTLED\n  VOID\n}\n\n/// M5/C4/\\xA711.2: how an order's items/total are divided into bills. NONE = one\n/// bill for the whole order; BY_ITEM/BY_SEAT allocate whole non-voided items to\n/// bills (per-quantity fractioning deferred \\u2014 BUILD-ASSUMPTIONS); FRACTIONAL\n/// divides the order total by integer fraction pairs via the money.ts\n/// largest-remainder allocation.\nenum RestaurantBillSplitKind {\n  NONE\n  BY_ITEM\n  BY_SEAT\n  FRACTIONAL\n}\n\n/// M5/\\xA711.2: the settlement channel of a tender. CASH carries change + a drawer\n/// movement; CARD carries a payment (adapter) reference; OTHER is the seam for\n/// non-cash/non-card (gift/voucher/loyalty deferred).\nenum RestaurantTenderType {\n  CASH\n  CARD\n  OTHER\n}\n\n/// M5/C6: the payment adapter provider registry \\u2014 MOCK only in M5 (no real PSP\n/// network I/O; D23 not built).\nenum RestaurantPaymentProvider {\n  MOCK\n  TERMINAL\n}\n\nenum RestaurantTerminalProviderMode {\n  DISABLED\n  SIMULATION\n  WEBHOOK\n}\n\nenum RestaurantTerminalEventStatus {\n  INITIATED\n  APPROVED\n  DECLINED\n  VOIDED\n}\n\n/// M5/C6: the capability set a provider declares and an operation exercises. The\n/// MOCK provider implements all six.\nenum RestaurantPaymentCapability {\n  SALE\n  AUTH\n  CAPTURE\n  ADJUST\n  VOID\n  REFUND\n}\n\n/// M5/C6: the normalized payment status the adapter maps every provider outcome\n/// onto. Transitions run through the command layer (C3); a settled amount is\n/// never rewritten.\nenum RestaurantPaymentStatus {\n  PENDING\n  AUTHORIZED\n  CAPTURED\n  VOIDED\n  REFUNDED\n  PARTIALLY_REFUNDED\n  DECLINED\n  FAILED\n}\n\n/// M5/C7: a refund is a NEW record referencing the original tender. REFUND is a\n/// post-capture return; VOID_REVERSAL reverses an uncaptured/same-day full\n/// tender via the adapter VOID path.\nenum RestaurantRefundKind {\n  REFUND\n  VOID_REVERSAL\n}\n\n/// M5/C8: a register drawer session is OPEN (one per register) or CLOSED\n/// (counted cash + variance written once at close).\nenum RestaurantDrawerSessionStatus {\n  OPEN\n  CLOSED\n}\n\n/// M5/C8: the append-only drawer ledger kinds. expectedCash is DERIVED by\n/// folding these: opening float + cash sales \\u2212 cash refunds + paid-ins \\u2212\n/// paid-outs \\u2212 drops.\nenum RestaurantDrawerMovementKind {\n  OPENING_FLOAT\n  CASH_SALE\n  CASH_REFUND\n  PAID_IN\n  PAID_OUT\n  DROP\n  CLOSING_COUNT\n}\n\n/// M5/C4/\\xA711.2: a bill (check) cut from exactly one order. Totals are SNAPSHOT\n/// columns frozen at bill-cut time from the order-item snapshots (tax/service\n/// charge carry through structurally at zero until the tax milestone; discounts\n/// are zero in M5). \\`splitKind\\` records how the order was divided;\n/// \\`fractionNumerator\\`/\\`fractionDenominator\\` are set only for FRACTIONAL bills.\n/// \\`roundingAdjustment\\` records this bill's share of the deterministic\n/// largest-remainder remainder so \\u03A3(grandTotal) \\u2261 the order derived total\n/// exactly (C4). A settled bill receives its \\`receiptNumber\\` exactly once, from\n/// the separate receipt seam (C10); uniqueness lives on a partial unique\n/// (branchId, businessDate, receiptNumber) in the migration. Void records a\n/// reason + co-authorization (C4). Opener operator + device attribute the cut.\nmodel RestaurantBill {\n  id                           String                  @id @default(cuid())\n  organizationId               String                  @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  orderId                      String\n  branchId                     String\n  businessDate                 DateTime                @db.Date\n  status                       RestaurantBillStatus    @default(OPEN)\n  splitKind                    RestaurantBillSplitKind @default(NONE)\n  fractionNumerator            Int?\n  fractionDenominator          Int?\n  subtotal                     Decimal                 @default(0) @db.Decimal(12, 2)\n  taxTotal                     Decimal                 @default(0) @db.Decimal(12, 2)\n  serviceChargeTotal           Decimal                 @default(0) @db.Decimal(12, 2)\n  deliveryFeeTotal             Decimal                 @default(0) @db.Decimal(12, 2)\n  serviceChargePolicyVersionId String?\n  serviceChargeRate            Decimal?                @db.Decimal(9, 6)\n  serviceChargeBasis           Decimal                 @default(0) @db.Decimal(12, 2)\n  serviceChargeTaxTreatment    String?                 @db.VarChar(24)\n  compTotal                    Decimal                 @default(0) @db.Decimal(12, 2)\n  discountTotal                Decimal                 @default(0) @db.Decimal(12, 2)\n  roundingAdjustment           Decimal                 @default(0) @db.Decimal(12, 2)\n  grandTotal                   Decimal                 @default(0) @db.Decimal(12, 2)\n  receiptNumber                Int?\n  settledAt                    DateTime?\n  voidReason                   String?\n  voidCoAuthorizationId        String?\n  openerStaffProfileId         String\n  deviceId                     String\n  createdAt                    DateTime                @default(now())\n  updatedAt                    DateTime                @updatedAt\n\n  order                      RestaurantOrder                       @relation(fields: [orderId], references: [id], onDelete: Cascade)\n  branch                     RestaurantBranch                      @relation(fields: [branchId], references: [id], onDelete: Cascade)\n  openerStaff                RestaurantStaffProfile                @relation(fields: [openerStaffProfileId], references: [id], onDelete: Restrict)\n  device                     RestaurantRegisteredDevice            @relation(fields: [deviceId], references: [id], onDelete: Restrict)\n  voidCoAuthorization        RestaurantCoAuthorization?            @relation(fields: [voidCoAuthorizationId], references: [id], onDelete: SetNull)\n  lines                      RestaurantBillLine[]\n  payments                   RestaurantPayment[]\n  tenders                    RestaurantTender[]\n  refunds                    RestaurantRefund[]\n  loyaltyPointsEntries       LoyaltyPointsEntry[]\n  terminalReconciliations    RestaurantTerminalReconciliation[]\n  taxTransactionSnapshots    RestaurantTaxTransactionSnapshot[]\n  serviceChargePolicyVersion RestaurantServiceChargePolicyVersion? @relation(fields: [organizationId, serviceChargePolicyVersionId], references: [organizationId, id], onDelete: Restrict)\n\n  @@unique([organizationId, id])\n  @@index([organizationId])\n  @@index([orderId])\n  @@index([branchId])\n  @@index([status])\n  @@index([businessDate])\n  @@map(\"restaurant_bills\")\n}\n\n/// M5/C4: a bill line places ONE non-voided order item on ONE bill and SNAPSHOTS\n/// its charge (name, unitPrice, quantity, line totals; tax/service-charge carry\n/// through at zero). A comp retains the original \\`unitPrice\\`/\\`lineSubtotal\\` and\n/// records \\`compAmount\\` (bringing the effective \\`lineTotal\\` to zero) with a\n/// reason + co-authorization (C4). No DB unique on orderItemId: void-and-recut\n/// leaves old lines behind; the command layer (L2) asserts the one-bill-per-item\n/// partition across a bill set's OPEN bills.\nmodel RestaurantBillLine {\n  id                    String   @id @default(cuid())\n  organizationId        String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  billId                String\n  orderItemId           String\n  name                  String\n  quantity              Int      @default(1)\n  unitPrice             Decimal  @db.Decimal(12, 2)\n  lineSubtotal          Decimal  @db.Decimal(12, 2)\n  taxAmount             Decimal  @default(0) @db.Decimal(12, 2)\n  serviceChargeAmount   Decimal  @default(0) @db.Decimal(12, 2)\n  compAmount            Decimal  @default(0) @db.Decimal(12, 2)\n  lineTotal             Decimal  @db.Decimal(12, 2)\n  compReason            String?\n  compCoAuthorizationId String?\n  createdAt             DateTime @default(now())\n  updatedAt             DateTime @updatedAt\n\n  bill                RestaurantBill             @relation(fields: [billId], references: [id], onDelete: Cascade)\n  orderItem           RestaurantOrderItem        @relation(fields: [orderItemId], references: [id], onDelete: Cascade)\n  compCoAuthorization RestaurantCoAuthorization? @relation(fields: [compCoAuthorizationId], references: [id], onDelete: SetNull)\n\n  @@index([organizationId])\n  @@index([billId])\n  @@index([orderItemId])\n  @@map(\"restaurant_bill_lines\")\n}\n\n/// M5/C6: the adapter-side payment record for a CARD tender. \\`provider\\` is MOCK;\n/// \\`capability\\` records which operation opened it; \\`status\\` is the normalized\n/// outcome (transitions via the command layer). \\`tipAmount\\` is DISTINCT from any\n/// service charge (C5). \\`providerRef\\` holds the provider's reference only \\u2014 never\n/// PAN/CVV/track data (C6). The event trail is append-only.\nmodel RestaurantPayment {\n  id             String                      @id @default(cuid())\n  organizationId String                      @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  billId         String\n  provider       RestaurantPaymentProvider   @default(MOCK)\n  capability     RestaurantPaymentCapability\n  status         RestaurantPaymentStatus     @default(PENDING)\n  amount         Decimal                     @db.Decimal(12, 2)\n  tipAmount      Decimal                     @default(0) @db.Decimal(12, 2)\n  providerRef    String?\n  staffProfileId String\n  deviceId       String\n  createdAt      DateTime                    @default(now())\n  updatedAt      DateTime                    @updatedAt\n\n  bill                    RestaurantBill                     @relation(fields: [billId], references: [id], onDelete: Cascade)\n  staff                   RestaurantStaffProfile             @relation(fields: [staffProfileId], references: [id], onDelete: Restrict)\n  device                  RestaurantRegisteredDevice         @relation(fields: [deviceId], references: [id], onDelete: Restrict)\n  events                  RestaurantPaymentEvent[]\n  tenders                 RestaurantTender[]\n  refunds                 RestaurantRefund[]\n  terminalReconciliations RestaurantTerminalReconciliation[]\n\n  @@unique([organizationId, id])\n  @@index([organizationId])\n  @@index([billId])\n  @@index([status])\n  @@index([providerRef])\n  @@map(\"restaurant_payments\")\n}\n\n/// M5/C3/C6: the APPEND-ONLY payment event trail. Every adapter operation appends\n/// one row (capability, eventType, optional amount, providerRef, sanitized\n/// payload \\u2014 never PAN/CVV/track data). No updatedAt; DB-enforced append-only\n/// (SELECT+INSERT RLS only). Corrections are new events/records, never edits.\nmodel RestaurantPaymentEvent {\n  id             String                      @id @default(cuid())\n  organizationId String                      @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  paymentId      String\n  capability     RestaurantPaymentCapability\n  eventType      String\n  amount         Decimal?                    @db.Decimal(12, 2)\n  providerRef    String?\n  payload        Json\n  createdAt      DateTime                    @default(now())\n\n  payment RestaurantPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)\n\n  @@index([organizationId])\n  @@index([paymentId])\n  @@map(\"restaurant_payment_events\")\n}\n\n/// M5/C3/\\xA711.2: an APPEND-ONLY tender applied to a bill. CASH carries\n/// \\`cashReceived\\`/\\`changeGiven\\` and a \\`drawerSessionId\\` (required-for-CASH at the\n/// command layer) with a paired CASH_SALE drawer movement in the SAME\n/// transaction; CARD carries a \\`paymentId\\` (required-for-CARD). \\`tipAmount\\` is\n/// recorded here, distinct from service charges (C5). No updatedAt; DB-enforced\n/// append-only. Business date + operator + device are stamped server-side.\nmodel RestaurantTender {\n  id              String               @id @default(cuid())\n  organizationId  String               @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  billId          String\n  type            RestaurantTenderType\n  amount          Decimal              @db.Decimal(12, 2)\n  tipAmount       Decimal              @default(0) @db.Decimal(12, 2)\n  cashReceived    Decimal?             @db.Decimal(12, 2)\n  changeGiven     Decimal?             @db.Decimal(12, 2)\n  drawerSessionId String?\n  paymentId       String?\n  businessDate    DateTime             @db.Date\n  staffProfileId  String\n  deviceId        String\n  createdAt       DateTime             @default(now())\n\n  bill                    RestaurantBill                          @relation(fields: [billId], references: [id], onDelete: Cascade)\n  drawerSession           RestaurantDrawerSession?                @relation(fields: [drawerSessionId], references: [id], onDelete: SetNull)\n  payment                 RestaurantPayment?                      @relation(fields: [paymentId], references: [id], onDelete: SetNull)\n  staff                   RestaurantStaffProfile                  @relation(fields: [staffProfileId], references: [id], onDelete: Restrict)\n  device                  RestaurantRegisteredDevice              @relation(fields: [deviceId], references: [id], onDelete: Restrict)\n  refunds                 RestaurantRefund[]\n  drawerMovements         RestaurantDrawerMovement[]\n  terminalReconciliations RestaurantTerminalReconciliation[]\n  taxAllocations          RestaurantTaxTenderAllocationSnapshot[]\n\n  @@unique([organizationId, id])\n  @@unique([organizationId, id, type])\n  @@unique([organizationId, billId, id, type])\n  @@index([organizationId])\n  @@index([billId])\n  @@index([businessDate])\n  @@index([drawerSessionId])\n  @@index([paymentId])\n  @@index([type])\n  @@map(\"restaurant_tenders\")\n}\n\n/// M5/C3/C7: an APPEND-ONLY refund referencing the original tender (and bill).\n/// Requires a reason + manager co-authorization; the command layer caps\n/// \\u03A3(refunds) \\u2264 the tender amount. \\`businessDate\\` is the PROCESSING date \\u2014 a\n/// cross-business-date correction posts to the current day and NEVER mutates a\n/// prior day's close (C7). Cash refunds carry a \\`drawerSessionId\\` + a CASH_REFUND\n/// movement; card refunds carry a \\`paymentId\\`. No updatedAt; DB-enforced\n/// append-only.\nmodel RestaurantRefund {\n  id                        String               @id @default(cuid())\n  organizationId            String               @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  originalTenderId          String\n  billId                    String\n  amount                    Decimal              @db.Decimal(12, 2)\n  tipRefundAmount           Decimal              @default(0) @db.Decimal(12, 2)\n  serviceChargeRefundAmount Decimal              @default(0) @db.Decimal(12, 2)\n  deliveryFeeRefundAmount   Decimal              @default(0) @db.Decimal(12, 2)\n  taxRefundAmount           Decimal              @default(0) @db.Decimal(12, 2)\n  kind                      RestaurantRefundKind\n  businessDate              DateTime             @db.Date\n  reason                    String\n  coAuthorizationId         String\n  drawerSessionId           String?\n  paymentId                 String?\n  staffProfileId            String\n  deviceId                  String\n  fullReversalSnapshotId    String?              @unique\n  createdAt                 DateTime             @default(now())\n\n  originalTender       RestaurantTender                  @relation(fields: [originalTenderId], references: [id], onDelete: Cascade)\n  bill                 RestaurantBill                    @relation(fields: [billId], references: [id], onDelete: Cascade)\n  coAuthorization      RestaurantCoAuthorization         @relation(fields: [coAuthorizationId], references: [id], onDelete: Restrict)\n  drawerSession        RestaurantDrawerSession?          @relation(fields: [drawerSessionId], references: [id], onDelete: SetNull)\n  payment              RestaurantPayment?                @relation(fields: [paymentId], references: [id], onDelete: SetNull)\n  staff                RestaurantStaffProfile            @relation(fields: [staffProfileId], references: [id], onDelete: Restrict)\n  device               RestaurantRegisteredDevice        @relation(fields: [deviceId], references: [id], onDelete: Restrict)\n  drawerMovements      RestaurantDrawerMovement[]\n  loyaltyPointsEntries LoyaltyPointsEntry[]\n  taxAllocations       RestaurantTaxRefundAllocation[]\n  fullReversalSnapshot RestaurantTaxTransactionSnapshot? @relation(\"TaxRefundFullReversal\", fields: [organizationId, billId, fullReversalSnapshotId], references: [organizationId, billId, id], onDelete: Restrict, map: \"restaurant_refund_full_reversal_snapshot_fkey\")\n\n  @@unique([organizationId, billId, originalTenderId, id])\n  @@unique([organizationId, billId, fullReversalSnapshotId])\n  @@index([organizationId])\n  @@index([originalTenderId])\n  @@index([billId])\n  @@index([businessDate])\n  @@index([drawerSessionId])\n  @@index([paymentId])\n  @@map(\"restaurant_refunds\")\n}\n\n/// Immutable, branch-scoped v1 DINE_IN service-charge configuration. Published\n/// intervals are migration-constrained not to overlap; tax treatment is frozen\n/// to NON_TAXABLE by the database.\nmodel RestaurantServiceChargePolicyVersion {\n  id                 String    @id @default(cuid())\n  organizationId     String    @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId           String\n  rate               Decimal   @db.Decimal(9, 6)\n  effectiveFrom      DateTime\n  effectiveTo        DateTime?\n  acknowledgedAt     DateTime\n  acknowledgementRef String\n  idempotencyKey     String\n  payloadHash        String\n  endIdempotencyKey  String?\n  endPayloadHash     String?\n  createdAt          DateTime  @default(now())\n\n  branch RestaurantBranch  @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)\n  orders RestaurantOrder[]\n  bills  RestaurantBill[]\n\n  @@unique([organizationId, id], map: \"restaurant_service_charge_policy_org_id_key\")\n  @@unique([organizationId, idempotencyKey], map: \"restaurant_service_charge_policy_org_idem_key\")\n  @@unique([organizationId, endIdempotencyKey], map: \"restaurant_service_charge_policy_org_end_idem_key\")\n  @@index([organizationId])\n  @@index([branchId, effectiveFrom])\n  @@map(\"restaurant_service_charge_policy_versions\")\n}\n\n/// M5/C8: a register(device) \\xD7 operator \\xD7 business-date drawer session. At most\n/// one OPEN session per register (partial unique in the migration). Opened with\n/// an opening float (and an OPENING_FLOAT movement); \\`expectedCash\\` is DERIVED by\n/// folding the movement ledger; close writes \\`countedCash\\`/\\`variance\\` once. This\n/// row legitimately transitions OPEN\\u2192CLOSED, so it keeps UPDATE (it is NOT one of\n/// the append-only ledgers) \\u2014 but a settled/closed session's counts are written\n/// exactly once by the command layer.\nmodel RestaurantDrawerSession {\n  id             String                        @id @default(cuid())\n  organizationId String                        @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId       String\n  deviceId       String\n  staffProfileId String\n  businessDate   DateTime                      @db.Date\n  status         RestaurantDrawerSessionStatus @default(OPEN)\n  openedAt       DateTime                      @default(now())\n  closedAt       DateTime?\n  openingFloat   Decimal                       @db.Decimal(12, 2)\n  expectedCash   Decimal?                      @db.Decimal(12, 2)\n  countedCash    Decimal?                      @db.Decimal(12, 2)\n  variance       Decimal?                      @db.Decimal(12, 2)\n  createdAt      DateTime                      @default(now())\n  updatedAt      DateTime                      @updatedAt\n\n  branch    RestaurantBranch           @relation(fields: [branchId], references: [id], onDelete: Cascade)\n  device    RestaurantRegisteredDevice @relation(fields: [deviceId], references: [id], onDelete: Restrict)\n  operator  RestaurantStaffProfile     @relation(fields: [staffProfileId], references: [id], onDelete: Restrict)\n  movements RestaurantDrawerMovement[]\n  tenders   RestaurantTender[]\n  refunds   RestaurantRefund[]\n\n  @@index([organizationId])\n  @@index([branchId])\n  @@index([deviceId])\n  @@index([staffProfileId])\n  @@index([businessDate])\n  @@index([status])\n  @@map(\"restaurant_drawer_sessions\")\n}\n\n/// M5/C3/C8: the APPEND-ONLY drawer ledger. Every cash event writes exactly one\n/// movement (OPENING_FLOAT/CASH_SALE/CASH_REFUND/PAID_IN/PAID_OUT/DROP/\n/// CLOSING_COUNT); paid-in/out require a reason (+ cash:adjust). \\`amount\\` is a\n/// non-negative magnitude \\u2014 the fold in daily-close/drawer code applies the sign\n/// by \\`kind\\`. Optional \\`tenderId\\`/\\`refundId\\` link the movement to the money\n/// record that produced it. No updatedAt; DB-enforced append-only.\nmodel RestaurantDrawerMovement {\n  id              String                       @id @default(cuid())\n  organizationId  String                       @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  drawerSessionId String\n  kind            RestaurantDrawerMovementKind\n  amount          Decimal                      @db.Decimal(12, 2)\n  reason          String?\n  tenderId        String?\n  refundId        String?\n  staffProfileId  String\n  deviceId        String\n  createdAt       DateTime                     @default(now())\n\n  drawerSession RestaurantDrawerSession    @relation(fields: [drawerSessionId], references: [id], onDelete: Cascade)\n  tender        RestaurantTender?          @relation(fields: [tenderId], references: [id], onDelete: SetNull)\n  refund        RestaurantRefund?          @relation(fields: [refundId], references: [id], onDelete: SetNull)\n  staff         RestaurantStaffProfile     @relation(fields: [staffProfileId], references: [id], onDelete: Restrict)\n  device        RestaurantRegisteredDevice @relation(fields: [deviceId], references: [id], onDelete: Restrict)\n\n  @@index([organizationId])\n  @@index([drawerSessionId])\n  @@index([tenderId])\n  @@index([refundId])\n  @@index([kind])\n  @@map(\"restaurant_drawer_movements\")\n}\n\n/// M5/C3/C9/\\xA711.3: the IMMUTABLE daily close \\u2014 a branch \\xD7 businessDate snapshot\n/// of gross/net sales, tax, service charge, tips, comps, discounts\n/// (structurally-zero in M5), refunds, voids, and cash expectation/counted/\n/// variance. Cutting requires every drawer session for the date CLOSED and every\n/// bill SETTLED or VOID. Once cut the row is immutable (append-only,\n/// SELECT+INSERT RLS only, no updatedAt). \"Reopen\"/correction = a NEW row with\n/// \\`supersedesCloseId\\` + \\`correctionReason\\` + manager co-authorization; the chain\n/// tip is authoritative in every read.\nmodel RestaurantDailyClose {\n  id                  String   @id @default(cuid())\n  organizationId      String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId            String\n  businessDate        DateTime @db.Date\n  supersedesCloseId   String?\n  correctionReason    String?\n  coAuthorizationId   String?\n  cutByStaffProfileId String\n  deviceId            String?\n  grossSales          Decimal  @default(0) @db.Decimal(12, 2)\n  netSales            Decimal  @default(0) @db.Decimal(12, 2)\n  deliveryFeeSales    Decimal  @default(0) @db.Decimal(12, 2)\n  deliveryFeeRefunds  Decimal  @default(0) @db.Decimal(12, 2)\n  taxTotal            Decimal  @default(0) @db.Decimal(12, 2)\n  serviceChargeTotal  Decimal  @default(0) @db.Decimal(12, 2)\n  tipTotal            Decimal  @default(0) @db.Decimal(12, 2)\n  compTotal           Decimal  @default(0) @db.Decimal(12, 2)\n  discountTotal       Decimal  @default(0) @db.Decimal(12, 2)\n  refundTotal         Decimal  @default(0) @db.Decimal(12, 2)\n  voidTotal           Decimal  @default(0) @db.Decimal(12, 2)\n  cashExpected        Decimal  @default(0) @db.Decimal(12, 2)\n  cashCounted         Decimal  @default(0) @db.Decimal(12, 2)\n  cashVariance        Decimal  @default(0) @db.Decimal(12, 2)\n  createdAt           DateTime @default(now())\n\n  branch                RestaurantBranch                  @relation(fields: [branchId], references: [id], onDelete: Cascade)\n  supersedesClose       RestaurantDailyClose?             @relation(\"DailyCloseSupersede\", fields: [supersedesCloseId], references: [id], onDelete: SetNull)\n  supersededBy          RestaurantDailyClose[]            @relation(\"DailyCloseSupersede\")\n  coAuthorization       RestaurantCoAuthorization?        @relation(fields: [coAuthorizationId], references: [id], onDelete: SetNull)\n  cutByStaff            RestaurantStaffProfile            @relation(fields: [cutByStaffProfileId], references: [id], onDelete: Restrict)\n  device                RestaurantRegisteredDevice?       @relation(fields: [deviceId], references: [id], onDelete: SetNull)\n  tenderTotals          RestaurantDailyCloseTenderTotal[]\n  insightDailyRollups   InsightDailyRollup[]\n  insightItemMixRollups InsightItemMixRollup[]\n\n  @@index([organizationId])\n  @@index([branchId])\n  @@index([businessDate])\n  @@index([supersedesCloseId])\n  @@map(\"restaurant_daily_closes\")\n}\n\n/// M5/C3/C9: the APPEND-ONLY per-tender-type child of a daily close (amount,\n/// tips, count per CASH/CARD/OTHER). No updatedAt; DB-enforced append-only.\nmodel RestaurantDailyCloseTenderTotal {\n  id             String               @id @default(cuid())\n  organizationId String               @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  dailyCloseId   String\n  tenderType     RestaurantTenderType\n  amount         Decimal              @default(0) @db.Decimal(12, 2)\n  tipAmount      Decimal              @default(0) @db.Decimal(12, 2)\n  count          Int                  @default(0)\n  createdAt      DateTime             @default(now())\n\n  dailyClose RestaurantDailyClose @relation(fields: [dailyCloseId], references: [id], onDelete: Cascade)\n\n  @@index([organizationId])\n  @@index([dailyCloseId])\n  @@map(\"restaurant_daily_close_tender_totals\")\n}\n\n/// M5/C10/\\xA711.1: the per-(branch, businessDate) receipt-number sequence \\u2014 a seam\n/// SEPARATE from restaurant_order_number_sequences. \\`nextNumber\\` holds the most\n/// recently allocated receipt number; allocation is a transactional row-locked\n/// upsert (see src/lib/restaurant/receipt-numbers.ts). Uniqueness + monotonicity\n/// are guaranteed; gap-free is NOT promised; non-fiscal (BUILD-ASSUMPTIONS).\nmodel RestaurantReceiptNumberSequence {\n  id             String   @id @default(cuid())\n  organizationId String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId       String\n  businessDate   DateTime @db.Date\n  nextNumber     Int\n  createdAt      DateTime @default(now())\n  updatedAt      DateTime @updatedAt\n\n  branch RestaurantBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)\n\n  @@unique([branchId, businessDate])\n  @@index([organizationId])\n  @@index([branchId])\n  @@map(\"restaurant_receipt_number_sequences\")\n}\n\n/// M5/C11: a device-scoped idempotency key for money commands \\u2014 a SEPARATE replay\n/// domain from restaurant_order_idempotency_keys. The first occurrence records\n/// the commandType + resultRef; any replay of the same (deviceId, key) returns\n/// that original result and creates nothing. Unique (deviceId, key).\nmodel RestaurantMoneyIdempotencyKey {\n  id                   String    @id @default(cuid())\n  organizationId       String    @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  deviceId             String\n  key                  String\n  commandType          String\n  resultRef            String?\n  canonicalPayloadHash String?\n  resultPayload        Json?\n  completedAt          DateTime?\n  createdAt            DateTime  @default(now())\n  updatedAt            DateTime  @updatedAt\n\n  device RestaurantRegisteredDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)\n\n  @@unique([deviceId, key])\n  @@index([organizationId])\n  @@index([deviceId])\n  @@map(\"restaurant_money_idempotency_keys\")\n}\n\n// ===========================================================================\n// M6 \\u2014 Inventory & purchasing (restaurant/m6-inventory-purchasing). Every model\n// below is org-scoped under forced RLS (C1) with a bare, RLS-guarded\n// organizationId that defaults from the transaction-local setting. Quantities\n// and costs are Decimal (never float). The single source of stock truth is the\n// APPEND-ONLY movement ledger (RestaurantStockMovement, DB-enforced SELECT+INSERT\n// RLS only); NO model carries a mutable on-hand balance column \\u2014 balances are\n// DERIVED by folding the ledger (D07). Costing is read-time weighted-average from\n// intrinsic-cost movements; negative derived stock is permitted and flagged, not\n// blocked at posting (D07 conservative defaults \\u2014 BUILD-ASSUMPTIONS \\xA7M6).\n// ===========================================================================\n\n/// M6/\\xA711.4: the ten canonical stock-movement reasons \\u2014 the CLOSED set of ways a\n/// signed quantity enters or leaves a (stockItem, location). Intrinsic-cost\n/// movements (PURCHASE_RECEIPT, SUPPLIER_RETURN) carry a \\`unitCost\\` that feeds the\n/// read-time weighted-average cost; the rest carry none (D07). RECIPE_CONSUMPTION\n/// posts transactionally at order close; SALE_REVERSAL covers post-close\n/// corrections.\nenum RestaurantStockMovementReason {\n  PURCHASE_RECEIPT\n  RECIPE_CONSUMPTION\n  SALE_REVERSAL\n  TRANSFER\n  PHYSICAL_COUNT_ADJUSTMENT\n  WASTAGE\n  SPOILAGE\n  STAFF_MEAL\n  SUPPLIER_RETURN\n  MANUAL_CORRECTION\n}\n\n/// M6/\\xA711.4: a physical stock count's lifecycle. DRAFT accumulates counted lines;\n/// SUBMITTED freezes the counted quantities + derived snapshot; POSTED writes the\n/// PHYSICAL_COUNT_ADJUSTMENT movements that reconcile derived to counted.\nenum RestaurantStockCountStatus {\n  DRAFT\n  SUBMITTED\n  POSTED\n}\n\n/// M6/\\xA76.4: an inter-location stock transfer's lifecycle. DRAFT accumulates lines;\n/// DISPATCHED posts the out-of-source TRANSFER movements; RECEIVED posts the\n/// into-destination TRANSFER movements; CANCELLED abandons a DRAFT.\nenum RestaurantStockTransferStatus {\n  DRAFT\n  DISPATCHED\n  RECEIVED\n  CANCELLED\n}\n\n/// M6/\\xA76.5/\\xA711.4: a purchase order's lifecycle. DRAFT while edited, SUBMITTED for\n/// approval, APPROVED to order, PARTIALLY_RECEIVED / RECEIVED as goods arrive,\n/// CLOSED when done, or CANCELLED. Received quantity is DERIVED from receipt\n/// lines \\u2014 never stored as a mutable column on the line.\nenum RestaurantPurchaseOrderStatus {\n  DRAFT\n  SUBMITTED\n  APPROVED\n  PARTIALLY_RECEIVED\n  RECEIVED\n  CLOSED\n  CANCELLED\n}\n\n/// M6/\\xA76.5: a goods-receiving discrepancy category. SHORTAGE/OVERAGE record a\n/// received-vs-expected quantity mismatch; DAMAGED/EXPIRED/REJECTED record\n/// unusable goods; OTHER + a note is the escape hatch. The signed correction to\n/// stock is always a movement, never a mutation of this evidence row.\nenum RestaurantReceivingDiscrepancyKind {\n  SHORTAGE\n  OVERAGE\n  DAMAGED\n  EXPIRED\n  REJECTED\n  OTHER\n}\n\n/// M6/\\xA76.4: a physical stock-holding location inside a branch (kitchen line, dry\n/// store, walk-in, bar\\u2026). Branch-scoped (\\xA78 \"transfers within the branch\");\n/// balances are derived per (stockItem, location) from the movement ledger. The\n/// \\`inventory.stockLocations.max\\` limit key lives in vertical-catalog (untouched).\nmodel RestaurantStockLocation {\n  id             String   @id @default(cuid())\n  organizationId String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId       String\n  name           String\n  code           String?\n  isActive       Boolean  @default(true)\n  createdAt      DateTime @default(now())\n  updatedAt      DateTime @updatedAt\n\n  branch           RestaurantBranch            @relation(fields: [branchId], references: [id], onDelete: Cascade)\n  movements        RestaurantStockMovement[]\n  lowStockRules    RestaurantLowStockRule[]\n  counts           RestaurantStockCount[]\n  transfersFrom    RestaurantStockTransfer[]   @relation(\"StockTransferSource\")\n  transfersTo      RestaurantStockTransfer[]   @relation(\"StockTransferDestination\")\n  purchaseOrders   RestaurantPurchaseOrder[]\n  purchaseReceipts RestaurantPurchaseReceipt[]\n\n  @@index([organizationId])\n  @@index([branchId])\n  @@map(\"restaurant_stock_locations\")\n}\n\n/// M6/\\xA76.4: the stockable identity of a catalog ingredient (M3 seam) \\u2014 one per\n/// ingredient. \\`canonicalUnitId\\` is the unit every movement quantity is stored in\n/// (ordering/receiving units are converted to it by the L1 ledger primitive).\n/// \\`trackBatches\\` toggles the optional batch/lot seam (D07 \\u2014 recordable, never\n/// enforced). NO on-hand balance column: balances are derived from the ledger.\nmodel RestaurantStockItem {\n  id              String   @id @default(cuid())\n  organizationId  String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  ingredientId    String   @unique\n  canonicalUnitId String\n  isActive        Boolean  @default(true)\n  trackBatches    Boolean  @default(false)\n  createdAt       DateTime @default(now())\n  updatedAt       DateTime @updatedAt\n\n  ingredient           RestaurantIngredient             @relation(fields: [ingredientId], references: [id], onDelete: Cascade)\n  canonicalUnit        RestaurantUnit                   @relation(fields: [canonicalUnitId], references: [id], onDelete: Restrict)\n  movements            RestaurantStockMovement[]\n  batches              RestaurantStockBatch[]\n  countLines           RestaurantStockCountLine[]\n  transferLines        RestaurantStockTransferLine[]\n  lowStockRules        RestaurantLowStockRule[]\n  purchaseOrderLines   RestaurantPurchaseOrderLine[]\n  purchaseReceiptLines RestaurantPurchaseReceiptLine[]\n  discrepancies        RestaurantReceivingDiscrepancy[]\n\n  @@index([organizationId])\n  @@index([canonicalUnitId])\n  @@map(\"restaurant_stock_items\")\n}\n\n/// M6/\\xA711.4: the APPEND-ONLY stock movement ledger \\u2014 the SINGLE source of stock\n/// truth. Every row is a signed \\`quantity\\` (canonical unit; positive = in,\n/// negative = out) at a (stockItem, location) for one of the ten reasons.\n/// Intrinsic-cost movements carry \\`unitCost\\` (weighted-average cost is derived at\n/// read time; D07). \\`occurredAt\\` is the economic time (backdatable); \\`recordedAt\\`\n/// is the immutable system record time. Nullable refs tie a movement to the\n/// order/receipt/transfer/count/batch that produced it. Actor attribution is\n/// best-effort (nullable) \\u2014 system postings (recipe consumption at order close)\n/// carry the order's operator when known. No updatedAt; DB-enforced append-only\n/// (SELECT+INSERT RLS only) \\u2014 a correction is a NEW movement, never an edit.\nmodel RestaurantStockMovement {\n  id             String                        @id @default(cuid())\n  organizationId String                        @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  stockItemId    String\n  locationId     String\n  reason         RestaurantStockMovementReason\n  quantity       Decimal                       @db.Decimal(18, 6)\n  unitCost       Decimal?                      @db.Decimal(18, 6)\n  occurredAt     DateTime                      @default(now())\n  recordedAt     DateTime                      @default(now())\n  orderId        String?\n  receiptId      String?\n  transferId     String?\n  countId        String?\n  batchId        String?\n  staffProfileId String?\n  deviceId       String?\n\n  stockItem RestaurantStockItem         @relation(fields: [stockItemId], references: [id], onDelete: Cascade)\n  location  RestaurantStockLocation     @relation(fields: [locationId], references: [id], onDelete: Cascade)\n  order     RestaurantOrder?            @relation(fields: [orderId], references: [id], onDelete: SetNull)\n  receipt   RestaurantPurchaseReceipt?  @relation(fields: [receiptId], references: [id], onDelete: SetNull)\n  transfer  RestaurantStockTransfer?    @relation(fields: [transferId], references: [id], onDelete: SetNull)\n  count     RestaurantStockCount?       @relation(fields: [countId], references: [id], onDelete: SetNull)\n  batch     RestaurantStockBatch?       @relation(fields: [batchId], references: [id], onDelete: SetNull)\n  staff     RestaurantStaffProfile?     @relation(fields: [staffProfileId], references: [id], onDelete: SetNull)\n  device    RestaurantRegisteredDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)\n\n  @@index([organizationId])\n  @@index([stockItemId, locationId])\n  @@index([locationId])\n  @@index([reason])\n  @@index([occurredAt])\n  @@index([locationId, occurredAt, stockItemId], map: \"restaurant_stock_movements_location_occurred_item_idx\")\n  @@index([reason, occurredAt, locationId], map: \"restaurant_stock_movements_reason_occurred_location_idx\")\n  @@index([orderId])\n  @@index([receiptId])\n  @@index([transferId])\n  @@index([countId])\n  @@index([batchId])\n  @@map(\"restaurant_stock_movements\")\n}\n\n/// M6/\\xA76.4/D07: an optional batch/lot recorded at receiving (\\`code\\`, expiry) and\n/// referenced by movements. Seam only \\u2014 recordable, never enforced (no expiry\n/// gating, no FEFO). One code per stock item.\nmodel RestaurantStockBatch {\n  id             String    @id @default(cuid())\n  organizationId String    @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  stockItemId    String\n  receiptId      String?\n  code           String\n  expiryDate     DateTime? @db.Date\n  createdAt      DateTime  @default(now())\n  updatedAt      DateTime  @updatedAt\n\n  stockItem    RestaurantStockItem             @relation(fields: [stockItemId], references: [id], onDelete: Cascade)\n  receipt      RestaurantPurchaseReceipt?      @relation(fields: [receiptId], references: [id], onDelete: SetNull)\n  movements    RestaurantStockMovement[]\n  receiptLines RestaurantPurchaseReceiptLine[]\n\n  @@unique([stockItemId, code])\n  @@index([organizationId])\n  @@index([stockItemId])\n  @@index([receiptId])\n  @@map(\"restaurant_stock_batches\")\n}\n\n/// M6/\\xA76.4/\\xA711.4: a physical stock count at a location. DRAFT\\u2192SUBMITTED\\u2192POSTED;\n/// posting writes the reconciling PHYSICAL_COUNT_ADJUSTMENT movements. Counted vs\n/// derived and the variance live on the lines (a frozen snapshot, not a live\n/// balance).\nmodel RestaurantStockCount {\n  id             String                     @id @default(cuid())\n  organizationId String                     @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  locationId     String\n  status         RestaurantStockCountStatus @default(DRAFT)\n  reference      String?\n  countedAt      DateTime?\n  submittedAt    DateTime?\n  postedAt       DateTime?\n  staffProfileId String?\n  createdAt      DateTime                   @default(now())\n  updatedAt      DateTime                   @updatedAt\n\n  location  RestaurantStockLocation    @relation(fields: [locationId], references: [id], onDelete: Cascade)\n  staff     RestaurantStaffProfile?    @relation(fields: [staffProfileId], references: [id], onDelete: SetNull)\n  lines     RestaurantStockCountLine[]\n  movements RestaurantStockMovement[]\n\n  @@index([organizationId])\n  @@index([locationId])\n  @@index([status])\n  @@map(\"restaurant_stock_counts\")\n}\n\n/// M6/\\xA711.4: one counted line of a stock count. \\`countedQuantity\\` is physically\n/// counted; \\`snapshotQuantity\\` is the derived on-hand FROZEN at submit time (the\n/// counted-vs-derived pairing); \\`varianceQuantity\\` = counted \\u2212 snapshot. All are\n/// immutable snapshots (evidence), never a live balance. One line per stock item.\nmodel RestaurantStockCountLine {\n  id               String   @id @default(cuid())\n  organizationId   String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  stockCountId     String\n  stockItemId      String\n  countedQuantity  Decimal  @db.Decimal(18, 6)\n  snapshotQuantity Decimal  @db.Decimal(18, 6)\n  varianceQuantity Decimal  @db.Decimal(18, 6)\n  createdAt        DateTime @default(now())\n  updatedAt        DateTime @updatedAt\n\n  stockCount RestaurantStockCount @relation(fields: [stockCountId], references: [id], onDelete: Cascade)\n  stockItem  RestaurantStockItem  @relation(fields: [stockItemId], references: [id], onDelete: Restrict)\n\n  @@unique([stockCountId, stockItemId])\n  @@index([organizationId])\n  @@index([stockCountId])\n  @@index([stockItemId])\n  @@map(\"restaurant_stock_count_lines\")\n}\n\n/// M6/\\xA76.4: an inter-location stock transfer within a branch. DRAFT\\u2192DISPATCHED\\u2192\n/// RECEIVED (or CANCELLED). Dispatch posts negative TRANSFER movements at the\n/// source; receipt posts positive TRANSFER movements at the destination. Source\n/// and destination must differ (DB CHECK).\nmodel RestaurantStockTransfer {\n  id                    String                        @id @default(cuid())\n  organizationId        String                        @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  sourceLocationId      String\n  destinationLocationId String\n  status                RestaurantStockTransferStatus @default(DRAFT)\n  reference             String?\n  dispatchedAt          DateTime?\n  receivedAt            DateTime?\n  staffProfileId        String?\n  createdAt             DateTime                      @default(now())\n  updatedAt             DateTime                      @updatedAt\n\n  sourceLocation      RestaurantStockLocation       @relation(\"StockTransferSource\", fields: [sourceLocationId], references: [id], onDelete: Cascade)\n  destinationLocation RestaurantStockLocation       @relation(\"StockTransferDestination\", fields: [destinationLocationId], references: [id], onDelete: Cascade)\n  staff               RestaurantStaffProfile?       @relation(fields: [staffProfileId], references: [id], onDelete: SetNull)\n  lines               RestaurantStockTransferLine[]\n  movements           RestaurantStockMovement[]\n\n  @@index([organizationId])\n  @@index([sourceLocationId])\n  @@index([destinationLocationId])\n  @@index([status])\n  @@map(\"restaurant_stock_transfers\")\n}\n\n/// M6/\\xA76.4: one line of a stock transfer \\u2014 a positive \\`quantity\\` (canonical unit)\n/// of a stock item to move. The signed source/destination movements are derived\n/// from this at dispatch/receipt.\nmodel RestaurantStockTransferLine {\n  id              String   @id @default(cuid())\n  organizationId  String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  stockTransferId String\n  stockItemId     String\n  quantity        Decimal  @db.Decimal(18, 6)\n  createdAt       DateTime @default(now())\n  updatedAt       DateTime @updatedAt\n\n  stockTransfer RestaurantStockTransfer @relation(fields: [stockTransferId], references: [id], onDelete: Cascade)\n  stockItem     RestaurantStockItem     @relation(fields: [stockItemId], references: [id], onDelete: Restrict)\n\n  @@unique([stockTransferId, stockItemId])\n  @@index([organizationId])\n  @@index([stockTransferId])\n  @@index([stockItemId])\n  @@map(\"restaurant_stock_transfer_lines\")\n}\n\n/// M6/\\xA76.4: a low-stock threshold for a (stockItem, location). When the derived\n/// on-hand falls below \\`threshold\\` (canonical unit) the item is surfaced as\n/// low/reorder in reads. One rule per (item, location).\nmodel RestaurantLowStockRule {\n  id             String   @id @default(cuid())\n  organizationId String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  stockItemId    String\n  locationId     String\n  threshold      Decimal  @db.Decimal(18, 6)\n  createdAt      DateTime @default(now())\n  updatedAt      DateTime @updatedAt\n\n  stockItem RestaurantStockItem     @relation(fields: [stockItemId], references: [id], onDelete: Cascade)\n  location  RestaurantStockLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)\n\n  @@unique([stockItemId, locationId])\n  @@index([organizationId])\n  @@index([stockItemId])\n  @@index([locationId])\n  @@map(\"restaurant_low_stock_rules\")\n}\n\n/// M6/\\xA76.5: a purchasing supplier \\u2014 the identity POs and receipts reference.\n/// Contacts/item-mappings/price-history are downstream seams. Supplier payment\n/// execution stays in Finance (\\xA76.5) \\u2014 no accounts-payable ledger here.\nmodel RestaurantSupplier {\n  id             String   @id @default(cuid())\n  organizationId String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  name           String\n  code           String?\n  contactName    String?\n  contactEmail   String?\n  contactPhone   String?\n  isActive       Boolean  @default(true)\n  createdAt      DateTime @default(now())\n  updatedAt      DateTime @updatedAt\n\n  purchaseOrders   RestaurantPurchaseOrder[]\n  purchaseReceipts RestaurantPurchaseReceipt[]\n\n  @@index([organizationId])\n  @@map(\"restaurant_suppliers\")\n}\n\n/// M6/\\xA76.5/\\xA711.4: a purchase order to a supplier, delivered to a branch, with the\n/// \\xA711.4 lifecycle. Received quantity is DERIVED from receipt lines \\u2014 never a\n/// mutable column. \\`locationId\\` is the default receiving-location seam.\nmodel RestaurantPurchaseOrder {\n  id                       String                        @id @default(cuid())\n  organizationId           String                        @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  supplierId               String\n  branchId                 String\n  locationId               String?\n  status                   RestaurantPurchaseOrderStatus @default(DRAFT)\n  reference                String?\n  expectedDate             DateTime?                     @db.Date\n  submittedAt              DateTime?\n  approvedAt               DateTime?\n  closedAt                 DateTime?\n  cancelledAt              DateTime?\n  createdByStaffProfileId  String?\n  approvedByStaffProfileId String?\n  createdAt                DateTime                      @default(now())\n  updatedAt                DateTime                      @updatedAt\n\n  supplier        RestaurantSupplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)\n  branch          RestaurantBranch              @relation(fields: [branchId], references: [id], onDelete: Cascade)\n  location        RestaurantStockLocation?      @relation(fields: [locationId], references: [id], onDelete: SetNull)\n  createdByStaff  RestaurantStaffProfile?       @relation(\"PurchaseOrderCreatedBy\", fields: [createdByStaffProfileId], references: [id], onDelete: SetNull)\n  approvedByStaff RestaurantStaffProfile?       @relation(\"PurchaseOrderApprovedBy\", fields: [approvedByStaffProfileId], references: [id], onDelete: SetNull)\n  lines           RestaurantPurchaseOrderLine[]\n  receipts        RestaurantPurchaseReceipt[]\n\n  @@index([organizationId])\n  @@index([supplierId])\n  @@index([branchId])\n  @@index([locationId])\n  @@index([status])\n  @@map(\"restaurant_purchase_orders\")\n}\n\n/// M6/\\xA76.5: one ordered line of a purchase order \\u2014 \\`orderedQuantity\\` in \\`unit\\`\n/// (converted to the item's canonical unit at receipt) at an expected \\`unitCost\\`.\n/// Received quantity is DERIVED from the receipt lines that reference this line.\nmodel RestaurantPurchaseOrderLine {\n  id              String   @id @default(cuid())\n  organizationId  String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  purchaseOrderId String\n  stockItemId     String\n  orderedQuantity Decimal  @db.Decimal(18, 6)\n  unitId          String\n  unitCost        Decimal  @db.Decimal(18, 6)\n  createdAt       DateTime @default(now())\n  updatedAt       DateTime @updatedAt\n\n  purchaseOrder RestaurantPurchaseOrder         @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)\n  stockItem     RestaurantStockItem             @relation(fields: [stockItemId], references: [id], onDelete: Restrict)\n  unit          RestaurantUnit                  @relation(fields: [unitId], references: [id], onDelete: Restrict)\n  receiptLines  RestaurantPurchaseReceiptLine[]\n\n  @@index([organizationId])\n  @@index([purchaseOrderId])\n  @@index([stockItemId])\n  @@index([unitId])\n  @@map(\"restaurant_purchase_order_lines\")\n}\n\n/// M6/\\xA76.5: a goods-receiving event (against a PO or ad-hoc) into a location. Its\n/// lines drive the PURCHASE_RECEIPT movements (carrying \\`unitCost\\` \\u2192 weighted-\n/// average cost) in one transaction; discrepancies and batches hang off it.\n/// Receiving retries are idempotent via RestaurantInventoryIdempotencyKey.\nmodel RestaurantPurchaseReceipt {\n  id              String   @id @default(cuid())\n  organizationId  String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  purchaseOrderId String?\n  supplierId      String\n  branchId        String\n  locationId      String\n  reference       String?\n  receivedAt      DateTime @default(now())\n  staffProfileId  String?\n  deviceId        String?\n  createdAt       DateTime @default(now())\n  updatedAt       DateTime @updatedAt\n\n  purchaseOrder RestaurantPurchaseOrder?         @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)\n  supplier      RestaurantSupplier               @relation(fields: [supplierId], references: [id], onDelete: Restrict)\n  branch        RestaurantBranch                 @relation(fields: [branchId], references: [id], onDelete: Cascade)\n  location      RestaurantStockLocation          @relation(fields: [locationId], references: [id], onDelete: Restrict)\n  staff         RestaurantStaffProfile?          @relation(fields: [staffProfileId], references: [id], onDelete: SetNull)\n  device        RestaurantRegisteredDevice?      @relation(fields: [deviceId], references: [id], onDelete: SetNull)\n  lines         RestaurantPurchaseReceiptLine[]\n  movements     RestaurantStockMovement[]\n  batches       RestaurantStockBatch[]\n  discrepancies RestaurantReceivingDiscrepancy[]\n\n  @@index([organizationId])\n  @@index([purchaseOrderId])\n  @@index([supplierId])\n  @@index([branchId])\n  @@index([locationId])\n  @@map(\"restaurant_purchase_receipts\")\n}\n\n/// M6/\\xA76.5: one received line \\u2014 \\`receivedQuantity\\` in \\`unit\\` at the actual\n/// \\`unitCost\\` (the intrinsic cost that feeds weighted-average costing via the\n/// PURCHASE_RECEIPT movement). Optionally links its PO line and a batch.\nmodel RestaurantPurchaseReceiptLine {\n  id                  String   @id @default(cuid())\n  organizationId      String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  purchaseReceiptId   String\n  purchaseOrderLineId String?\n  stockItemId         String\n  receivedQuantity    Decimal  @db.Decimal(18, 6)\n  unitId              String\n  unitCost            Decimal  @db.Decimal(18, 6)\n  batchId             String?\n  createdAt           DateTime @default(now())\n  updatedAt           DateTime @updatedAt\n\n  purchaseReceipt   RestaurantPurchaseReceipt        @relation(fields: [purchaseReceiptId], references: [id], onDelete: Cascade)\n  purchaseOrderLine RestaurantPurchaseOrderLine?     @relation(fields: [purchaseOrderLineId], references: [id], onDelete: SetNull)\n  stockItem         RestaurantStockItem              @relation(fields: [stockItemId], references: [id], onDelete: Restrict)\n  unit              RestaurantUnit                   @relation(fields: [unitId], references: [id], onDelete: Restrict)\n  batch             RestaurantStockBatch?            @relation(fields: [batchId], references: [id], onDelete: SetNull)\n  discrepancies     RestaurantReceivingDiscrepancy[]\n\n  @@index([organizationId])\n  @@index([purchaseReceiptId])\n  @@index([purchaseOrderLineId])\n  @@index([stockItemId])\n  @@index([unitId])\n  @@index([batchId])\n  @@map(\"restaurant_purchase_receipt_lines\")\n}\n\n/// M6/\\xA76.5: a goods-receiving discrepancy (shortage/overage/damaged/\\u2026) recorded\n/// against a receipt (and optionally a line). Evidence only \\u2014 the signed stock\n/// correction is always a movement, never a mutation of this row.\nmodel RestaurantReceivingDiscrepancy {\n  id                    String                             @id @default(cuid())\n  organizationId        String                             @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  purchaseReceiptId     String\n  purchaseReceiptLineId String?\n  stockItemId           String\n  kind                  RestaurantReceivingDiscrepancyKind\n  expectedQuantity      Decimal                            @db.Decimal(18, 6)\n  receivedQuantity      Decimal                            @db.Decimal(18, 6)\n  note                  String?\n  createdAt             DateTime                           @default(now())\n  updatedAt             DateTime                           @updatedAt\n\n  purchaseReceipt     RestaurantPurchaseReceipt      @relation(fields: [purchaseReceiptId], references: [id], onDelete: Cascade)\n  purchaseReceiptLine RestaurantPurchaseReceiptLine? @relation(fields: [purchaseReceiptLineId], references: [id], onDelete: SetNull)\n  stockItem           RestaurantStockItem            @relation(fields: [stockItemId], references: [id], onDelete: Restrict)\n\n  @@index([organizationId])\n  @@index([purchaseReceiptId])\n  @@index([purchaseReceiptLineId])\n  @@index([stockItemId])\n  @@map(\"restaurant_receiving_discrepancies\")\n}\n\n/// M6/\\xA711.4: an idempotency key for inventory/purchasing commands (receiving,\n/// transfers, count posting, adjustments) \\u2014 the M5 money-key pattern applied to a\n/// SEPARATE replay domain. Org-scoped (not device-scoped): inventory commands\n/// include back-office flows with no device. A replay of the same (org, key)\n/// returns the original result and creates nothing. Unique (organizationId, key).\nmodel RestaurantInventoryIdempotencyKey {\n  id             String   @id @default(cuid())\n  organizationId String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  key            String\n  commandType    String\n  resultRef      String?\n  deviceId       String?\n  createdAt      DateTime @default(now())\n  updatedAt      DateTime @updatedAt\n\n  device RestaurantRegisteredDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)\n\n  @@unique([organizationId, key])\n  @@index([organizationId])\n  @@index([deviceId])\n  @@map(\"restaurant_inventory_idempotency_keys\")\n}\n\n// ===========================================================================\n// M7-L1 \\u2014 Scheduler primitive, SOP compliance engine, and notifications for the\n// Restaurant vertical (restaurant/m7-scheduler-sop-notifications).\n//\n// Binding design constraints realised in this model set:\n//   C1  Every table is org-scoped (a bare, RLS-guarded organizationId defaulting\n//       from the transaction-local setting) and gets forced org RLS in the\n//       migration. No pre-M7 table is altered except additive back-relations.\n//   C-append-only  Five tables are DB-enforced APPEND-ONLY (SELECT+INSERT RLS\n//       policies only, no UPDATE/DELETE) \\u2014 RestaurantJobExecution,\n//       RestaurantSopEvidence, RestaurantSopVerification,\n//       RestaurantSopEscalationEvent, RestaurantNotificationDelivery. A\n//       correction is a NEW row, never an edit (the M5/M6 ledger pattern).\n//   C-scheduler   RestaurantJob is the org-scoped durable work queue; the\n//       scheduler primitive (src/lib/restaurant/scheduler.ts) claims due jobs\n//       with FOR UPDATE SKIP LOCKED and appends one immutable\n//       RestaurantJobExecution per attempt. Bounded retries with backoff move a\n//       terminally-failing job to DEAD (D13).\n//   UTC   Every timestamp is stored UTC; branch-local rendering (SOP due windows,\n//       quiet hours) is derived at read time from the branch timezone\n//       (business-date.ts) \\u2014 never recomputed from a stored local value.\n// ===========================================================================\n\n/// M7/D13: a durable background job's lifecycle. QUEUED is claimable when due;\n/// RUNNING is claimed by a worker; SUCCEEDED is a completed attempt; FAILED is a\n/// permanent (handler-declared, non-retryable) failure; DEAD is the terminal\n/// state once maxAttempts bounded retries are exhausted.\nenum RestaurantJobStatus {\n  QUEUED\n  RUNNING\n  SUCCEEDED\n  FAILED\n  DEAD\n}\n\n/// M7/D13: the immutable outcome of ONE job attempt in the append-only execution\n/// history. SUCCEEDED/FAILED describe that single attempt, not the job.\nenum RestaurantJobExecutionOutcome {\n  SUCCEEDED\n  FAILED\n}\n\n/// M7/D21: verification state of an inbound webhook payload. PENDING until the\n/// signature is checked; VERIFIED once the source signature validates; FAILED\n/// when it does not (the payload is retained for audit, never processed).\nenum RestaurantWebhookVerificationStatus {\n  PENDING\n  VERIFIED\n  FAILED\n}\n\n/// M7/D21: processing state of an inbound webhook envelope, independent of its\n/// signature verification. Dedup is by (organization, source, externalEventId).\nenum RestaurantWebhookInboxStatus {\n  PENDING\n  PROCESSED\n  FAILED\n  DISCARDED\n}\n\n/// M7/\\xA711.5: an SOP template VERSION's lifecycle. DRAFT is editable; PUBLISHED is\n/// immutable and the only version an assignment may pin; RETIRED is withdrawn\n/// from new assignments but retained (occurrences that pinned it stay readable).\nenum RestaurantSopTemplateStatus {\n  DRAFT\n  PUBLISHED\n  RETIRED\n}\n\n/// M7/\\xA711.5: the EXACTLY eight occurrence states. SCHEDULED (generated, not yet\n/// worked); IN_PROGRESS (an operator began); SUBMITTED (completed, awaiting\n/// verification); VERIFIED / REJECTED (a verifier's decision); LATE (submitted\n/// past the due window); MISSED (window elapsed with no submission); WAIVED.\nenum RestaurantSopOccurrenceStatus {\n  SCHEDULED\n  IN_PROGRESS\n  SUBMITTED\n  VERIFIED\n  REJECTED\n  LATE\n  MISSED\n  WAIVED\n}\n\n/// M7/\\xA711.5: a verifier's decision on a submitted occurrence. VERIFY accepts;\n/// REJECT sends it back; WAIVE excuses it. A sensitive decision may pin an M2\n/// co-authorization record (co-auth field) \\u2014 additive, never enforced at L1.\nenum RestaurantSopVerificationAction {\n  VERIFY\n  REJECT\n  WAIVE\n}\n\n/// M7/\\xA711.5: how an assignment recurs. ONCE is a single dated occurrence; DAILY /\n/// WEEKLY / MONTHLY generate occurrences on a branch-local schedule. DST is\n/// handled by generating against the branch wall-clock, never a fixed UTC offset.\nenum RestaurantSopRecurrenceFrequency {\n  ONCE\n  DAILY\n  WEEKLY\n  MONTHLY\n  INTERVAL\n}\n\n/// SOP-1: how an assignment names WHO owes the work. PERSON pins one named staff\n/// profile (\\`assigneeStaffProfileId\\`) and every generated occurrence is assigned\n/// directly. ROLE pins one job role (\\`assigneeJobRoleId\\`) and every generated\n/// occurrence becomes an unclaimed, branch-scoped POOL item any eligible holder\n/// of that role may claim. A CHECK constraint in the migration enforces that\n/// exactly the matching column is set, so the two modes never overlap on one\n/// assignment row. The modes coexist ACROSS assignments: the same template may\n/// carry a ROLE assignment and a PERSON assignment on the same branch, and the\n/// per-staff resolver unions and de-duplicates the two paths.\nenum RestaurantSopAssigneeTargetType {\n  PERSON\n  ROLE\n}\n\n/// SOP-1: an audited job-role membership change. GRANTED adds a (staff, role,\n/// branch) holding; REVOKED removes it. Both are appended to an append-only\n/// trail so an immediately-effective multi-select edit stays reconstructible\n/// after the membership row itself is gone.\nenum RestaurantStaffJobRoleChangeKind {\n  GRANTED\n  REVOKED\n}\n\n/// B1/WHA-285: the direction of a per-person capability override. ALLOW adds a\n/// capability the person's roles did not grant; DENY removes one they did \\u2014 for\n/// that person only, leaving the role untouched. DENY is evaluated LAST, so it\n/// beats both the role union and any direct ALLOW.\nenum RestaurantStaffCapabilityEffect {\n  ALLOW\n  DENY\n}\n\n/// B1/WHA-285: an audited per-person capability-override change. ALLOWED and\n/// DENIED name the effect the override was set to; CLEARED means the override\n/// itself was removed and the person fell back to what their roles grant.\nenum RestaurantStaffCapabilityAuditKind {\n  ALLOWED\n  DENIED\n  CLEARED\n}\n\n/// M7/\\xA711.5: the scope an escalation policy applies to. ORG applies org-wide;\n/// BRANCH narrows to one branch (branchId set).\nenum RestaurantSopEscalationScope {\n  ORG\n  BRANCH\n}\n\n/// M7/\\xA711.5: an append-only escalation-event kind. FIRED when a step triggers;\n/// ACKNOWLEDGED when a recipient responds; STOPPED when a stop condition ends the\n/// chain. Each is an immutable record; the current state is folded from events.\nenum RestaurantSopEscalationEventKind {\n  FIRED\n  ACKNOWLEDGED\n  STOPPED\n}\n\n/// M7/D21: notification delivery channels. IN_APP is real; EMAIL / SMS / PUSH /\n/// WHATSAPP are STUBBED adapters in M7 (recorded, never actually sent).\nenum RestaurantNotificationChannel {\n  IN_APP\n  WEBHOOK\n  EMAIL\n  SMS\n  PUSH\n  WHATSAPP\n}\n\n/// M7/D21: the append-only outcome of one delivery attempt on one channel.\n/// DELIVERED_IN_APP is the real in-app delivery; STUBBED records a non-in-app\n/// channel whose adapter is a stub; FAILED records an attempt that errored.\nenum RestaurantNotificationDeliveryStatus {\n  DELIVERED_IN_APP\n  DELIVERED_WEBHOOK\n  STUBBED\n  FAILED\n}\n\n/// M7/D13: the org-scoped durable work queue. A job is claimed when QUEUED and\n/// \\`nextAttemptAt <= now\\` via FOR UPDATE SKIP LOCKED; the scheduler primitive\n/// increments \\`attempts\\`, stamps \\`claimedAt\\`/\\`claimedBy\\`, and appends one\n/// immutable execution row per attempt. \\`idempotencyKey\\` deduplicates enqueues\n/// within the organization (a null key is never deduplicated). \\`payload\\` is an\n/// opaque handler input; the handler type is a plain string resolved through the\n/// job-handlers registry so later lanes register independently.\nmodel RestaurantJob {\n  id             String              @id @default(cuid())\n  organizationId String              @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  type           String\n  payload        Json                @default(\"{}\")\n  status         RestaurantJobStatus @default(QUEUED)\n  attempts       Int                 @default(0)\n  maxAttempts    Int                 @default(5)\n  scheduledAt    DateTime            @default(now())\n  nextAttemptAt  DateTime            @default(now())\n  claimedAt      DateTime?\n  claimedBy      String?\n  lastError      String?\n  idempotencyKey String?\n  createdAt      DateTime            @default(now())\n  updatedAt      DateTime            @updatedAt\n\n  executions RestaurantJobExecution[]\n\n  @@unique([organizationId, idempotencyKey])\n  @@index([organizationId])\n  @@index([status, nextAttemptAt])\n  @@map(\"restaurant_jobs\")\n}\n\n/// M7/D13: the APPEND-ONLY execution history of the job queue \\u2014 one immutable row\n/// per attempt (DB-enforced SELECT+INSERT RLS; no updatedAt). \\`workerId\\` is the\n/// claimer that ran the attempt; \\`outcome\\` is that attempt's result. Exact\n/// counts of these rows are the concurrency battery's exactly-once evidence.\nmodel RestaurantJobExecution {\n  id             String                        @id @default(cuid())\n  organizationId String                        @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  jobId          String\n  workerId       String\n  attempt        Int\n  startedAt      DateTime\n  finishedAt     DateTime\n  outcome        RestaurantJobExecutionOutcome\n  error          String?\n  createdAt      DateTime                      @default(now())\n\n  job RestaurantJob @relation(fields: [jobId], references: [id], onDelete: Cascade)\n\n  @@index([organizationId])\n  @@index([jobId])\n  @@map(\"restaurant_job_executions\")\n}\n\n/// M7/D21: an inbound webhook envelope, deduplicated by (organization, source,\n/// externalEventId). \\`verificationStatus\\` records the signature check; \\`status\\`\n/// records processing. The raw \\`payload\\` is retained for audit; a failed\n/// verification is never processed. This is the ingress seam a provider adapter\n/// consumes \\u2014 no provider-specific columns are invented here.\nmodel RestaurantWebhookInbox {\n  id                 String                              @id @default(cuid())\n  organizationId     String                              @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  source             String\n  externalEventId    String\n  eventType          String?\n  payload            Json                                @default(\"{}\")\n  verificationStatus RestaurantWebhookVerificationStatus @default(PENDING)\n  status             RestaurantWebhookInboxStatus        @default(PENDING)\n  attempts           Int                                 @default(0)\n  lastError          String?\n  receivedAt         DateTime                            @default(now())\n  processedAt        DateTime?\n  createdAt          DateTime                            @default(now())\n  updatedAt          DateTime                            @updatedAt\n\n  @@unique([organizationId, source, externalEventId])\n  @@index([organizationId])\n  @@index([status])\n  @@map(\"restaurant_webhook_inbox\")\n}\n\n/// M7/\\xA711.5: an SOP template FAMILY (the unit counted by \\`sop.templates.max\\` in\n/// vertical-catalog \\u2014 not immutable historical versions). Content lives on the\n/// versions; a family is org-scoped and carries no branchId (branch binding lives\n/// on the assignment, mirroring the M3 catalog/publication split).\nmodel RestaurantSopTemplate {\n  id             String   @id @default(cuid())\n  organizationId String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  name           String\n  description    String?\n  category       String?\n  isActive       Boolean  @default(true)\n  createdAt      DateTime @default(now())\n  updatedAt      DateTime @updatedAt\n\n  versions    RestaurantSopTemplateVersion[]\n  assignments RestaurantSopAssignment[]\n\n  @@index([organizationId])\n  @@map(\"restaurant_sop_templates\")\n}\n\n/// M7/\\xA711.5: an immutable-once-PUBLISHED template version. DRAFT is editable;\n/// PUBLISHED freezes the step set and is the only version an assignment may pin;\n/// RETIRED withdraws it from new assignments. Occurrences pin a specific version\n/// so a later edit never rewrites recorded compliance history (C3-style).\nmodel RestaurantSopTemplateVersion {\n  id             String                      @id @default(cuid())\n  organizationId String                      @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  templateId     String\n  versionNumber  Int\n  status         RestaurantSopTemplateStatus @default(DRAFT)\n  publishedAt    DateTime?\n  retiredAt      DateTime?\n  createdAt      DateTime                    @default(now())\n  updatedAt      DateTime                    @updatedAt\n\n  template    RestaurantSopTemplate       @relation(fields: [templateId], references: [id], onDelete: Cascade)\n  steps       RestaurantSopTemplateStep[]\n  occurrences RestaurantSopOccurrence[]\n\n  @@unique([templateId, versionNumber])\n  @@index([organizationId])\n  @@index([templateId])\n  @@index([status])\n  @@map(\"restaurant_sop_template_versions\")\n}\n\n/// M7/\\xA711.5: one ordered step of a template version, with per-step evidence\n/// requirement flags (photo / signature / note). Steps are frozen when the\n/// version is PUBLISHED; occurrence steps reference them by FK.\nmodel RestaurantSopTemplateStep {\n  id                String   @id @default(cuid())\n  organizationId    String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  templateVersionId String\n  stepOrder         Int\n  title             String\n  instructions      String?\n  requiresPhoto     Boolean  @default(false)\n  requiresSignature Boolean  @default(false)\n  requiresNote      Boolean  @default(false)\n  createdAt         DateTime @default(now())\n  updatedAt         DateTime @updatedAt\n\n  templateVersion RestaurantSopTemplateVersion  @relation(fields: [templateVersionId], references: [id], onDelete: Cascade)\n  occurrenceSteps RestaurantSopOccurrenceStep[]\n\n  @@unique([templateVersionId, stepOrder])\n  @@index([organizationId])\n  @@index([templateVersionId])\n  @@map(\"restaurant_sop_template_steps\")\n}\n\n/// M7/\\xA711.5: a branch-scoped recurring assignment of a template. Recurrence is\n/// expressed as a frequency + interval (+ daysOfWeek for WEEKLY, monthDay for\n/// MONTHLY, or an inclusive branch-local start/end time for INTERVAL) over the\n/// effective-date window [startDate, endDate], with a due/completion window.\n/// The occurrence generator (an L-domain lane) folds this into dated occurrences;\n/// L1 only stores the recurrence seam and pins nothing about a specific version.\nmodel RestaurantSopAssignment {\n  id                     String                           @id @default(cuid())\n  organizationId         String                           @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId               String\n  templateId             String\n  frequency              RestaurantSopRecurrenceFrequency @default(DAILY)\n  interval               Int                              @default(1)\n  daysOfWeek             Int[]\n  monthDay               Int?\n  startDate              DateTime                         @db.Date\n  endDate                DateTime?                        @db.Date\n  dueTimeMinutes         Int                              @default(0)\n  intervalEndTimeMinutes Int?\n  windowMinutes          Int                              @default(1440)\n  graceMinutes           Int                              @default(0)\n  active                 Boolean                          @default(true)\n  supersedesAssignmentId String?                          @unique\n  supersededAt           DateTime?\n  createdAt              DateTime                         @default(now())\n  updatedAt              DateTime                         @updatedAt\n\n  // SOP-1: the assignee target. Exactly one of the two id columns is set, and it\n  // must be the one matching \\`assigneeTargetType\\` \\u2014 a CHECK constraint in the\n  // migration enforces both halves, so an inconsistent row cannot exist even if\n  // a caller bypasses the domain module. Pre-existing rows migrate to a PERSON\n  // target only when they already name a person; the backfill defaults them to\n  // ROLE with a seeded fallback role so no row is left violating the CHECK.\n  assigneeTargetType     RestaurantSopAssigneeTargetType @default(ROLE)\n  assigneeStaffProfileId String?\n  assigneeJobRoleId      String?\n\n  branch          RestaurantBranch          @relation(fields: [branchId], references: [id], onDelete: Cascade)\n  template        RestaurantSopTemplate     @relation(fields: [templateId], references: [id], onDelete: Cascade)\n  assigneeStaff   RestaurantStaffProfile?   @relation(\"SopAssignmentAssignee\", fields: [assigneeStaffProfileId], references: [id], onDelete: Cascade)\n  assigneeJobRole RestaurantJobRole?        @relation(fields: [assigneeJobRoleId], references: [id], onDelete: Cascade)\n  occurrences     RestaurantSopOccurrence[]\n  supersedes      RestaurantSopAssignment?  @relation(\"SopAssignmentSuccessors\", fields: [supersedesAssignmentId], references: [id], onDelete: Restrict)\n  supersededBy    RestaurantSopAssignment?  @relation(\"SopAssignmentSuccessors\")\n\n  @@index([organizationId])\n  @@index([branchId])\n  @@index([templateId])\n  @@index([active])\n  @@index([assigneeStaffProfileId])\n  @@index([assigneeJobRoleId])\n  @@index([supersededAt])\n  @@map(\"restaurant_sop_assignments\")\n}\n\n/// M7/\\xA711.5: one dated instance of an assignment, pinning the template VERSION it\n/// was generated against (immutable history). \\`businessDate\\` is the branch-local\n/// business day (business-date.ts); \\`dueAt\\`/\\`windowEndsAt\\` are the derived UTC\n/// instants. \\`status\\` is exactly one of the eight \\xA711.5 states. A unique\n/// (assignment, dueAt) slot makes generation idempotent while allowing\n/// INTERVAL assignments to materialize multiple occurrences per business date.\nmodel RestaurantSopOccurrence {\n  id                String                        @id @default(cuid())\n  organizationId    String                        @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  assignmentId      String\n  templateVersionId String\n  branchId          String\n  businessDate      DateTime                      @db.Date\n  status            RestaurantSopOccurrenceStatus @default(SCHEDULED)\n  dueAt             DateTime\n  windowEndsAt      DateTime\n  startedAt         DateTime?\n  submittedAt       DateTime?\n  resolvedAt        DateTime?\n  createdAt         DateTime                      @default(now())\n  updatedAt         DateTime                      @updatedAt\n\n  // SOP-1: WHO owes this occurrence, frozen at generation time so a later edit to\n  // the assignment never rewrites recorded history (the same C3 rule the pinned\n  // templateVersionId follows).\n  //   PERSON target \\u2192 \\`assignedStaffProfileId\\` is set and \\`poolJobRoleId\\` is null.\n  //   ROLE   target \\u2192 \\`poolJobRoleId\\` is set and the occurrence starts UNCLAIMED.\n  // The first claim is an atomic conditional UPDATE guarded by\n  // \\`claimedByStaffProfileId IS NULL\\`, so exactly one concurrent claimer wins;\n  // re-claiming by the same holder is idempotent rather than an error.\n  assignedStaffProfileId  String?\n  poolJobRoleId           String?\n  claimedByStaffProfileId String?\n  claimedAt               DateTime?\n\n  assignment       RestaurantSopAssignment        @relation(fields: [assignmentId], references: [id], onDelete: Cascade)\n  templateVersion  RestaurantSopTemplateVersion   @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)\n  branch           RestaurantBranch               @relation(fields: [branchId], references: [id], onDelete: Cascade)\n  assignedStaff    RestaurantStaffProfile?        @relation(\"SopOccurrenceAssignee\", fields: [assignedStaffProfileId], references: [id], onDelete: SetNull)\n  poolJobRole      RestaurantJobRole?             @relation(fields: [poolJobRoleId], references: [id], onDelete: SetNull)\n  claimedBy        RestaurantStaffProfile?        @relation(\"SopOccurrenceClaimer\", fields: [claimedByStaffProfileId], references: [id], onDelete: SetNull)\n  steps            RestaurantSopOccurrenceStep[]\n  evidence         RestaurantSopEvidence[]\n  verifications    RestaurantSopVerification[]\n  escalationEvents RestaurantSopEscalationEvent[]\n\n  @@unique([assignmentId, dueAt])\n  @@index([organizationId])\n  @@index([assignmentId])\n  @@index([templateVersionId])\n  @@index([branchId])\n  @@index([status])\n  @@index([businessDate])\n  @@index([dueAt])\n  @@index([assignedStaffProfileId])\n  @@index([claimedByStaffProfileId])\n  // The pool query: unclaimed ROLE-target occurrences for one role at one branch.\n  @@index([poolJobRoleId, branchId, claimedByStaffProfileId])\n  @@map(\"restaurant_sop_occurrences\")\n}\n\n/// M7/\\xA711.5: per-step completion state of an occurrence, referencing the pinned\n/// template step. \\`completedBy\\` is best-effort operator attribution (nullable).\n/// Evidence hangs off the occurrence and (optionally) a specific step.\nmodel RestaurantSopOccurrenceStep {\n  id                        String    @id @default(cuid())\n  organizationId            String    @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  occurrenceId              String\n  templateStepId            String\n  completed                 Boolean   @default(false)\n  completedAt               DateTime?\n  completedByStaffProfileId String?\n  note                      String?\n  createdAt                 DateTime  @default(now())\n  updatedAt                 DateTime  @updatedAt\n\n  occurrence   RestaurantSopOccurrence   @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)\n  templateStep RestaurantSopTemplateStep @relation(fields: [templateStepId], references: [id], onDelete: Restrict)\n  completedBy  RestaurantStaffProfile?   @relation(fields: [completedByStaffProfileId], references: [id], onDelete: SetNull)\n  evidence     RestaurantSopEvidence[]\n\n  @@unique([occurrenceId, templateStepId])\n  @@index([organizationId])\n  @@index([occurrenceId])\n  @@index([templateStepId])\n  @@index([completedByStaffProfileId])\n  @@map(\"restaurant_sop_occurrence_steps\")\n}\n\n/// M7/\\xA711.5: APPEND-ONLY evidence captured for an occurrence (and optionally a\n/// specific step). \\`contentHash\\` + \\`storageRef\\` are the content-addressed seam\n/// (storageRef is nullable until a blob store is wired). \\`sizeBytes\\` is a\n/// non-negative magnitude (CHECK). DB-enforced append-only (SELECT+INSERT RLS,\n/// no updatedAt) \\u2014 evidence is never edited, only superseded by new evidence.\nmodel RestaurantSopEvidence {\n  id                     String   @id @default(cuid())\n  organizationId         String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  occurrenceId           String\n  occurrenceStepId       String?\n  contentHash            String\n  mimeType               String\n  sizeBytes              Int\n  storageRef             String?\n  uploaderStaffProfileId String?\n  capturedAt             DateTime @default(now())\n  createdAt              DateTime @default(now())\n\n  occurrence     RestaurantSopOccurrence      @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)\n  occurrenceStep RestaurantSopOccurrenceStep? @relation(fields: [occurrenceStepId], references: [id], onDelete: SetNull)\n  uploader       RestaurantStaffProfile?      @relation(fields: [uploaderStaffProfileId], references: [id], onDelete: SetNull)\n\n  @@unique([organizationId, occurrenceId, occurrenceStepId, uploaderStaffProfileId, contentHash, mimeType], map: \"restaurant_sop_evidence_retry_identity_key\")\n  @@index([organizationId])\n  @@index([occurrenceId])\n  @@index([occurrenceStepId])\n  @@index([contentHash])\n  @@index([uploaderStaffProfileId])\n  @@map(\"restaurant_sop_evidence\")\n}\n\n/// M7/\\xA711.5: APPEND-ONLY verification decision on a submitted occurrence. \\`action\\`\n/// is VERIFY/REJECT/WAIVE; \\`actor\\` is the deciding operator (nullable, best\n/// effort); \\`coAuthorization\\` optionally pins an M2 co-authorization record for a\n/// sensitive decision (single-column FK, the M5 precedent). DB-enforced\n/// append-only (SELECT+INSERT RLS) \\u2014 the occurrence status is folded from these.\nmodel RestaurantSopVerification {\n  id                  String                          @id @default(cuid())\n  organizationId      String                          @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  occurrenceId        String\n  action              RestaurantSopVerificationAction\n  actorStaffProfileId String?\n  coAuthorizationId   String?\n  reason              String?\n  createdAt           DateTime                        @default(now())\n\n  occurrence      RestaurantSopOccurrence    @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)\n  actor           RestaurantStaffProfile?    @relation(fields: [actorStaffProfileId], references: [id], onDelete: SetNull)\n  coAuthorization RestaurantCoAuthorization? @relation(fields: [coAuthorizationId], references: [id], onDelete: SetNull)\n\n  @@index([organizationId])\n  @@index([occurrenceId])\n  @@index([actorStaffProfileId])\n  @@index([coAuthorizationId])\n  @@map(\"restaurant_sop_verifications\")\n}\n\n/// M7/\\xA711.5: an escalation policy \\u2014 a scope (ORG or a specific BRANCH), stop\n/// conditions, and optional branch-local quiet hours. Its ordered steps fire on a\n/// delay when an occurrence is overdue; L1 stores the policy seam only.\nmodel RestaurantSopEscalationPolicy {\n  id                     String                       @id @default(cuid())\n  organizationId         String                       @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  name                   String\n  scope                  RestaurantSopEscalationScope @default(ORG)\n  branchId               String?\n  stopOnAcknowledged     Boolean                      @default(true)\n  stopOnVerified         Boolean                      @default(true)\n  quietHoursStartMinutes Int?\n  quietHoursEndMinutes   Int?\n  active                 Boolean                      @default(true)\n  createdAt              DateTime                     @default(now())\n  updatedAt              DateTime                     @updatedAt\n\n  branch RestaurantBranch?             @relation(fields: [branchId], references: [id], onDelete: Cascade)\n  steps  RestaurantSopEscalationStep[]\n\n  @@index([organizationId])\n  @@index([branchId])\n  @@index([active])\n  @@map(\"restaurant_sop_escalation_policies\")\n}\n\n/// M7/\\xA711.5: one ordered step of an escalation policy \\u2014 a delay, a target\n/// (role/operator/address string), a channel, and a bounded attempt count. Events\n/// reference the step that fired them.\nmodel RestaurantSopEscalationStep {\n  id             String                        @id @default(cuid())\n  organizationId String                        @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  policyId       String\n  stepOrder      Int\n  delayMinutes   Int                           @default(0)\n  target         String\n  channel        RestaurantNotificationChannel @default(IN_APP)\n  maxAttempts    Int                           @default(1)\n  createdAt      DateTime                      @default(now())\n  updatedAt      DateTime                      @updatedAt\n\n  policy RestaurantSopEscalationPolicy  @relation(fields: [policyId], references: [id], onDelete: Cascade)\n  events RestaurantSopEscalationEvent[]\n\n  @@unique([policyId, stepOrder])\n  @@index([organizationId])\n  @@index([policyId])\n  @@map(\"restaurant_sop_escalation_steps\")\n}\n\n/// M7/\\xA711.5: APPEND-ONLY escalation event \\u2014 FIRED/ACKNOWLEDGED/STOPPED against an\n/// occurrence (and the step that fired, when applicable). \\`actor\\` is nullable\n/// (system-fired events carry none). DB-enforced append-only (SELECT+INSERT RLS);\n/// the live escalation state is folded from these immutable rows.\nmodel RestaurantSopEscalationEvent {\n  id                  String                           @id @default(cuid())\n  organizationId      String                           @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  occurrenceId        String\n  escalationStepId    String?\n  kind                RestaurantSopEscalationEventKind\n  actorStaffProfileId String?\n  detail              String?\n  createdAt           DateTime                         @default(now())\n\n  occurrence     RestaurantSopOccurrence      @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)\n  escalationStep RestaurantSopEscalationStep? @relation(fields: [escalationStepId], references: [id], onDelete: SetNull)\n  actor          RestaurantStaffProfile?      @relation(fields: [actorStaffProfileId], references: [id], onDelete: SetNull)\n\n  @@index([organizationId])\n  @@index([occurrenceId])\n  @@index([escalationStepId])\n  @@index([actorStaffProfileId])\n  @@map(\"restaurant_sop_escalation_events\")\n}\n\n/// SOP-1: a restaurant JOB ROLE (barista, cashier, kitchen, manager, \\u2026) as a\n/// first-class record. This is deliberately a SEPARATE concept from the platform\n/// \\`OrganizationRole\\`, and the audit that produced it is recorded here rather\n/// than repeated in prose: \\`OrganizationRole\\` is keyed to a \\`User\\` through the\n/// SINGULAR \\`User.organizationRoleId\\` column, so it can express neither \"this\n/// operator has no web login\" (C3 \\u2014 a staff profile need not be a \\`User\\`) nor\n/// \"this person is a barista AND a cashier\". Job roles are therefore keyed to the\n/// STAFF PROFILE and held many-to-many, per branch. There is still exactly ONE\n/// role concept for restaurant job duties \\u2014 this one; nothing else grants a\n/// restaurant job role, and the platform role continues to govern back-office\n/// web permissions untouched.\nmodel RestaurantJobRole {\n  id             String   @id @default(cuid())\n  organizationId String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  key            String\n  name           String\n  description    String?\n  isSystem       Boolean  @default(false)\n  active         Boolean  @default(true)\n  createdAt      DateTime @default(now())\n  updatedAt      DateTime @updatedAt\n\n  capabilities    RestaurantJobRoleCapability[]\n  holdings        RestaurantStaffJobRole[]\n  auditEntries    RestaurantStaffJobRoleAudit[]\n  sopAssignments  RestaurantSopAssignment[]\n  poolOccurrences RestaurantSopOccurrence[]\n\n  @@unique([organizationId, key])\n  @@index([organizationId])\n  @@index([active])\n  @@map(\"restaurant_job_roles\")\n}\n\n/// SOP-1: one capability granted by a job role. A staff profile's effective\n/// capability set is the UNION over every role they hold (in scope) plus their\n/// direct per-staff grants \\u2014 never the intersection, and never \"the last role\n/// wins\". A capability appearing on several held roles resolves once.\nmodel RestaurantJobRoleCapability {\n  id             String   @id @default(cuid())\n  organizationId String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  jobRoleId      String\n  capability     String\n  createdAt      DateTime @default(now())\n\n  jobRole RestaurantJobRole @relation(fields: [jobRoleId], references: [id], onDelete: Cascade)\n\n  @@unique([jobRoleId, capability])\n  @@index([organizationId])\n  @@index([jobRoleId])\n  @@map(\"restaurant_job_role_capabilities\")\n}\n\n/// SOP-1: the many-to-many holding \\u2014 this staff profile holds this job role AT\n/// THIS BRANCH. \\`branchId\\` is NOT NULL on purpose: a nullable \"all branches\"\n/// sentinel would defeat the unique index (PostgreSQL treats NULLs as distinct,\n/// so the same org-wide holding could be inserted twice). Org-wide duty is\n/// expressed as one holding per branch, which keeps pool eligibility a plain\n/// branch-equality lookup.\nmodel RestaurantStaffJobRole {\n  id               String   @id @default(cuid())\n  organizationId   String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  staffProfileId   String\n  jobRoleId        String\n  branchId         String\n  grantedByStaffId String?\n  grantedAt        DateTime @default(now())\n\n  staffProfile RestaurantStaffProfile  @relation(\"StaffJobRoleHolder\", fields: [staffProfileId], references: [id], onDelete: Cascade)\n  jobRole      RestaurantJobRole       @relation(fields: [jobRoleId], references: [id], onDelete: Cascade)\n  branch       RestaurantBranch        @relation(fields: [branchId], references: [id], onDelete: Cascade)\n  grantedBy    RestaurantStaffProfile? @relation(\"StaffJobRoleGrantor\", fields: [grantedByStaffId], references: [id], onDelete: SetNull)\n\n  @@unique([staffProfileId, jobRoleId, branchId])\n  @@index([organizationId])\n  @@index([staffProfileId])\n  @@index([jobRoleId])\n  @@index([branchId])\n  @@index([jobRoleId, branchId])\n  @@map(\"restaurant_staff_job_roles\")\n}\n\n/// SOP-1 + B1: a per-person capability OVERRIDE at one branch, outside any role.\n///\n/// \\`effect = ALLOW\\` is the original \"plus direct grants\" half of resolution: it\n/// unions on top of the held-role capabilities. \\`effect = DENY\\` (B1/WHA-285) is\n/// its subtractive twin: it removes an INHERITED capability from one person\n/// without touching the role, so the role keeps meaning what it means for\n/// everyone else who holds it.\n///\n/// The table keeps its \\`..._grants\\` name on purpose. Renaming it would be a\n/// breaking DDL across every existing reference for zero functional gain; the\n/// \\`effect\\` discriminant carries the meaning instead.\n///\n/// PRECEDENCE IS STRUCTURAL, NOT A RUNTIME TIEBREAK. The unique index is\n/// (staffProfileId, branchId, capability) with NO \\`effect\\` in it, so one person\n/// cannot simultaneously hold an ALLOW and a DENY for the same capability at the\n/// same branch \\u2014 the ambiguity is impossible to store, not merely resolved late.\n/// What remains is a single ordering: DENY beats what a ROLE inherited.\nmodel RestaurantStaffCapabilityGrant {\n  id             String                          @id @default(cuid())\n  organizationId String                          @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  staffProfileId String\n  branchId       String\n  capability     String\n  effect         RestaurantStaffCapabilityEffect @default(ALLOW)\n  createdAt      DateTime                        @default(now())\n  updatedAt      DateTime                        @default(now()) @updatedAt\n\n  staffProfile RestaurantStaffProfile @relation(\"StaffDirectCapabilityGrant\", fields: [staffProfileId], references: [id], onDelete: Cascade)\n  branch       RestaurantBranch       @relation(fields: [branchId], references: [id], onDelete: Cascade)\n\n  @@unique([staffProfileId, branchId, capability])\n  @@index([organizationId])\n  @@index([staffProfileId])\n  @@index([branchId])\n  @@map(\"restaurant_staff_capability_grants\")\n}\n\n/// B1/WHA-285: the APPEND-ONLY audit trail for per-person capability overrides,\n/// the exact counterpart of \\`restaurant_staff_job_role_audits\\` for the other half\n/// of resolution. It is a SEPARATE table rather than extra rows in the membership\n/// trail because that trail's subject is a (role, branch) holding and its\n/// \\`jobRoleKey\\` is NOT NULL; overloading it would have meant relaxing a live\n/// invariant to store a different subject.\n///\n/// ALLOWED/DENIED record the effect an override was set to; CLEARED records its\n/// removal, and is written BEFORE the delete so \"this person stopped being denied\n/// refunds on the 4th\" survives the row it removed.\nmodel RestaurantStaffCapabilityAudit {\n  id                  String                             @id @default(cuid())\n  organizationId      String                             @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  staffProfileId      String\n  branchId            String\n  capability          String\n  change              RestaurantStaffCapabilityAuditKind\n  actorStaffProfileId String?\n  createdAt           DateTime                           @default(now())\n\n  staffProfile RestaurantStaffProfile  @relation(\"StaffCapabilityAuditSubject\", fields: [staffProfileId], references: [id], onDelete: Cascade)\n  branch       RestaurantBranch        @relation(fields: [branchId], references: [id], onDelete: Cascade)\n  actor        RestaurantStaffProfile? @relation(\"StaffCapabilityAuditActor\", fields: [actorStaffProfileId], references: [id], onDelete: SetNull)\n\n  @@index([organizationId])\n  @@index([staffProfileId])\n  @@index([branchId])\n  @@index([createdAt])\n  @@map(\"restaurant_staff_capability_audits\")\n}\n\n/// SOP-1: the APPEND-ONLY audit trail for job-role membership. The migration\n/// grants SELECT + INSERT policies only (the M5/M6 append-only pattern \\u2014 UPDATE\n/// and DELETE are denied by policy omission under FORCE RLS), so a revoke can\n/// never be erased. \\`jobRoleId\\` is \\`SetNull\\` rather than \\`Cascade\\` because\n/// deleting a role must not delete the record that people once held it; the\n/// denormalised \\`jobRoleKey\\` keeps the entry readable afterwards.\nmodel RestaurantStaffJobRoleAudit {\n  id                  String                           @id @default(cuid())\n  organizationId      String                           @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  staffProfileId      String\n  jobRoleId           String?\n  jobRoleKey          String\n  branchId            String\n  change              RestaurantStaffJobRoleChangeKind\n  actorStaffProfileId String?\n  createdAt           DateTime                         @default(now())\n\n  staffProfile RestaurantStaffProfile  @relation(\"StaffJobRoleAuditSubject\", fields: [staffProfileId], references: [id], onDelete: Cascade)\n  jobRole      RestaurantJobRole?      @relation(fields: [jobRoleId], references: [id], onDelete: SetNull)\n  actor        RestaurantStaffProfile? @relation(\"StaffJobRoleAuditActor\", fields: [actorStaffProfileId], references: [id], onDelete: SetNull)\n\n  @@index([organizationId])\n  @@index([staffProfileId])\n  @@index([jobRoleId])\n  @@index([branchId])\n  @@index([createdAt])\n  @@map(\"restaurant_staff_job_role_audits\")\n}\n\n/// M7/D21: an in-app notification addressed to a staff operator, optionally\n/// scoped to a branch and tied to a source entity (entityType/entityId \\u2014 a loose\n/// reference, never a cross-table FK). \\`isRead\\`/\\`readAt\\` track read state; the\n/// per-channel delivery record is append-only (below).\nmodel RestaurantNotification {\n  id                      String    @id @default(cuid())\n  organizationId          String    @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  recipientStaffProfileId String\n  branchId                String?\n  category                String\n  title                   String\n  body                    String?\n  entityType              String?\n  entityId                String?\n  isRead                  Boolean   @default(false)\n  readAt                  DateTime?\n  createdAt               DateTime  @default(now())\n  updatedAt               DateTime  @updatedAt\n\n  recipient  RestaurantStaffProfile           @relation(fields: [recipientStaffProfileId], references: [id], onDelete: Cascade)\n  branch     RestaurantBranch?                @relation(fields: [branchId], references: [id], onDelete: Cascade)\n  deliveries RestaurantNotificationDelivery[]\n\n  @@index([organizationId])\n  @@index([recipientStaffProfileId])\n  @@index([branchId])\n  @@index([category])\n  @@index([isRead])\n  @@map(\"restaurant_notifications\")\n}\n\n/// M7/D21: the event-category \\xD7 channel delivery matrix. A row enables/disables a\n/// channel for a category; a null \\`branchId\\` is the org default, a set \\`branchId\\`\n/// is a branch override (the L-domain lane resolves the branch-override-then-org\n/// precedence in app code).\nmodel RestaurantNotificationChannelSetting {\n  id             String                        @id @default(cuid())\n  organizationId String                        @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId       String?\n  category       String\n  channel        RestaurantNotificationChannel\n  enabled        Boolean                       @default(true)\n  createdAt      DateTime                      @default(now())\n  updatedAt      DateTime                      @updatedAt\n\n  branch RestaurantBranch? @relation(fields: [branchId], references: [id], onDelete: Cascade)\n\n  @@unique([organizationId, branchId, category, channel])\n  @@index([organizationId])\n  @@index([branchId])\n  @@map(\"restaurant_notification_channel_settings\")\n}\n\n/// One tenant-owned outbound SOP webhook. The signing secret is envelope\n/// encrypted by the application and is never selected by public read contracts.\nmodel RestaurantNotificationWebhook {\n  id                     String    @id @default(cuid())\n  organizationId         String    @unique @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  endpointUrl            String\n  encryptedSigningSecret String\n  enabled                Boolean   @default(false)\n  lastSuccessAt          DateTime?\n  lastFailureAt          DateTime?\n  lastFailure            String?\n  createdAt              DateTime  @default(now())\n  updatedAt              DateTime  @updatedAt\n\n  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)\n\n  @@index([organizationId])\n  @@map(\"restaurant_notification_webhooks\")\n}\n\n/// M7/D21: APPEND-ONLY record of ONE delivery attempt of a notification on ONE\n/// channel. DELIVERED_IN_APP is the real in-app delivery; STUBBED records a\n/// non-in-app channel whose adapter is a stub; FAILED records an errored attempt.\n/// DB-enforced append-only (SELECT+INSERT RLS, no updatedAt).\nmodel RestaurantNotificationDelivery {\n  id             String                               @id @default(cuid())\n  organizationId String                               @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  notificationId String\n  channel        RestaurantNotificationChannel\n  status         RestaurantNotificationDeliveryStatus\n  attempt        Int                                  @default(1)\n  error          String?\n  createdAt      DateTime                             @default(now())\n\n  notification RestaurantNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)\n\n  @@index([organizationId])\n  @@index([notificationId])\n  @@index([channel])\n  @@map(\"restaurant_notification_deliveries\")\n}\n\n// ===========================================================================\n// M8 \\u2014 Restaurant customers, loyalty and insight read models. Customer PII is\n// isolated from agency Client records; consent and loyalty history are event\n// ledgers; insight rows are rebuildable projections. Every model is org-scoped\n// under forced RLS in the M8 migration.\n// ===========================================================================\n\nenum CustomerIdentifierKind {\n  EMAIL\n  PHONE\n}\n\nenum CustomerConsentChannel {\n  EMAIL\n  SMS\n  PHONE\n  WHATSAPP\n  PUSH\n}\n\nenum LoyaltyPointsEntryKind {\n  EARN\n  REDEEM\n  REVERSAL\n  EXPIRY\n  ADJUSTMENT\n}\n\n/// D08: the organization-owned restaurant customer surrogate. Contact identity\n/// lives in CustomerIdentifier, never agency Client. Anonymization clears the\n/// nullable profile fields and stamps anonymizedAt while retained history keeps\n/// referencing this non-PII surrogate.\nmodel RestaurantCustomer {\n  id             String    @id @default(cuid())\n  organizationId String    @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  displayName    String?\n  givenName      String?\n  familyName     String?\n  birthDate      DateTime? @db.Date\n  notes          String?\n  anonymizedAt   DateTime?\n  createdAt      DateTime  @default(now())\n  updatedAt      DateTime  @updatedAt\n\n  identifiers          CustomerIdentifier[]\n  interactions         CustomerInteraction[]\n  tagAssignments       CustomerTagAssignment[]\n  consentEvents        CustomerConsent[]\n  loyaltyAccount       LoyaltyAccount?\n  orders               RestaurantOrder[]\n  addresses            RestaurantCustomerAddress[]\n  deliveryFulfillments RestaurantDeliveryFulfillment[]\n  cateringOrders       RestaurantCateringOrder[]\n\n  @@unique([organizationId, id])\n  @@index([organizationId])\n  @@index([anonymizedAt])\n  @@map(\"restaurant_customers\")\n}\n\n/// Direct-delivery configuration owned by one branch. The fee is authoritative\n/// server data; clients may identify a zone, but fulfillment creation validates\n/// the active zone and copies these values into historical snapshots.\nmodel RestaurantDeliveryZone {\n  id              String   @id @default(cuid())\n  organizationId  String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId        String\n  name            String\n  active          Boolean  @default(true)\n  fixedFee        Decimal  @db.Decimal(12, 2)\n  minimumSubtotal Decimal  @default(0) @db.Decimal(12, 2)\n  promisedMinutes Int\n  sortOrder       Int      @default(0)\n  areaPostalLabel String?\n  createdAt       DateTime @default(now())\n  updatedAt       DateTime @updatedAt\n\n  branch RestaurantBranch @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Cascade)\n\n  @@unique([organizationId, branchId, id])\n  @@index([organizationId, branchId, active, sortOrder])\n  @@map(\"restaurant_delivery_zones\")\n}\n\n/// Reusable restaurant-customer address. Soft deletion preserves prior records;\n/// completed deliveries retain independent snapshots rather than referring here.\nmodel RestaurantCustomerAddress {\n  id                 String    @id @default(cuid())\n  organizationId     String    @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  customerId         String\n  label              String\n  recipientName      String\n  normalizedPhone    String\n  addressLine1       String\n  addressLine2       String?\n  locality           String\n  administrativeArea String?\n  postalCode         String?\n  countryCode        String\n  latitude           Decimal?  @db.Decimal(9, 6)\n  longitude          Decimal?  @db.Decimal(9, 6)\n  isDefault          Boolean   @default(false)\n  deletedAt          DateTime?\n  createdAt          DateTime  @default(now())\n  updatedAt          DateTime  @updatedAt\n\n  customer       RestaurantCustomer        @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: Cascade)\n  cateringOrders RestaurantCateringOrder[]\n\n  @@unique([organizationId, customerId, id])\n  @@index([organizationId, customerId, deletedAt])\n  @@map(\"restaurant_customer_addresses\")\n}\n\nenum RestaurantCateringOrderStatus {\n  DRAFT\n  QUOTED\n  CONFIRMED\n  IN_PRODUCTION\n  READY\n  DELIVERED\n  CLOSED\n  CANCELLED\n}\n\nenum RestaurantCateringExtraCostKind {\n  LABOUR\n  TRANSPORT\n  RENTAL\n  OTHER\n}\n\nmodel RestaurantCateringOrder {\n  id                String                        @id @default(cuid())\n  organizationId    String                        @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId          String\n  customerId        String?\n  eventName         String\n  eventDate         DateTime                      @db.Date\n  serviceTime       DateTime?                     @db.Time(0)\n  headcount         Int\n  venueAddress      String?\n  deliveryAddressId String?\n  status            RestaurantCateringOrderStatus @default(DRAFT)\n  quotedTotal       Decimal?                      @db.Decimal(12, 2)\n  depositAmount     Decimal?                      @db.Decimal(12, 2)\n  notes             String?\n  createdByStaffId  String?\n  createdAt         DateTime                      @default(now())\n  updatedAt         DateTime                      @updatedAt\n\n  branch          RestaurantBranch              @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)\n  customer        RestaurantCustomer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)\n  deliveryAddress RestaurantCustomerAddress?    @relation(fields: [deliveryAddressId], references: [id], onDelete: SetNull)\n  createdBy       RestaurantStaffProfile?       @relation(\"CateringOrderCreator\", fields: [createdByStaffId], references: [id], onDelete: SetNull)\n  lines           RestaurantCateringOrderLine[]\n  extraCosts      RestaurantCateringExtraCost[]\n  delivery        RestaurantCateringDelivery?\n  events          RestaurantCateringEvent[]\n\n  @@unique([organizationId, id])\n  @@index([organizationId, branchId, eventDate])\n  @@index([organizationId, status])\n  @@index([customerId])\n  @@map(\"restaurant_catering_orders\")\n}\n\nmodel RestaurantCateringOrderLine {\n  id                     String   @id @default(cuid())\n  organizationId         String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  orderId                String\n  productId              String?\n  recipeId               String?\n  description            String\n  portions               Decimal  @db.Decimal(12, 3)\n  unitPrice              Decimal  @db.Decimal(12, 2)\n  costPerPortionSnapshot Decimal? @db.Decimal(12, 4)\n  sortOrder              Int      @default(0)\n  createdAt              DateTime @default(now())\n  updatedAt              DateTime @updatedAt\n\n  order   RestaurantCateringOrder @relation(fields: [organizationId, orderId], references: [organizationId, id], onDelete: Cascade)\n  product RestaurantProduct?      @relation(fields: [productId], references: [id], onDelete: Restrict)\n  recipe  RestaurantRecipe?       @relation(fields: [recipeId], references: [id], onDelete: Restrict)\n\n  @@index([organizationId, orderId, sortOrder])\n  @@index([productId])\n  @@index([recipeId])\n  @@map(\"restaurant_catering_order_lines\")\n}\n\nmodel RestaurantCateringExtraCost {\n  id             String                          @id @default(cuid())\n  organizationId String                          @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  orderId        String\n  kind           RestaurantCateringExtraCostKind\n  label          String\n  amount         Decimal                         @db.Decimal(12, 2)\n  createdAt      DateTime                        @default(now())\n  updatedAt      DateTime                        @updatedAt\n\n  order RestaurantCateringOrder @relation(fields: [organizationId, orderId], references: [organizationId, id], onDelete: Cascade)\n\n  @@index([organizationId, orderId])\n  @@map(\"restaurant_catering_extra_costs\")\n}\n\nmodel RestaurantCateringDelivery {\n  id             String    @id @default(cuid())\n  organizationId String    @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  orderId        String    @unique\n  scheduledAt    DateTime\n  dispatchedAt   DateTime?\n  deliveredAt    DateTime?\n  driverStaffId  String?\n  vehicle        String?\n  notes          String?\n  createdAt      DateTime  @default(now())\n  updatedAt      DateTime  @updatedAt\n\n  order       RestaurantCateringOrder @relation(fields: [organizationId, orderId], references: [organizationId, id], onDelete: Cascade)\n  driverStaff RestaurantStaffProfile? @relation(\"CateringDeliveryDriver\", fields: [driverStaffId], references: [id], onDelete: SetNull)\n\n  @@unique([organizationId, orderId])\n  @@index([organizationId, orderId])\n  @@index([driverStaffId])\n  @@map(\"restaurant_catering_deliveries\")\n}\n\nmodel RestaurantCateringEvent {\n  id                  String   @id @default(cuid())\n  organizationId      String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  orderId             String\n  sequence            Int\n  eventType           String\n  actorStaffProfileId String?\n  payload             Json\n  createdAt           DateTime @default(now())\n\n  order      RestaurantCateringOrder @relation(fields: [organizationId, orderId], references: [organizationId, id], onDelete: Cascade)\n  actorStaff RestaurantStaffProfile? @relation(\"CateringEventActor\", fields: [actorStaffProfileId], references: [id], onDelete: SetNull)\n\n  @@unique([orderId, sequence])\n  @@index([organizationId, orderId])\n  @@index([actorStaffProfileId])\n  @@map(\"restaurant_catering_events\")\n}\n\n/// One direct-delivery record per DELIVERY order. All address, contact, zone,\n/// price, tax and promise fields are immutable snapshots after insertion.\nmodel RestaurantDeliveryFulfillment {\n  id                          String                              @id @default(cuid())\n  organizationId              String                              @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId                    String\n  customerId                  String\n  orderId                     String\n  paymentMode                 RestaurantDeliveryPaymentMode?\n  status                      RestaurantDeliveryFulfillmentStatus @default(PENDING)\n  recipientNameSnapshot       String\n  normalizedPhoneSnapshot     String\n  addressLine1Snapshot        String\n  addressLine2Snapshot        String?\n  localitySnapshot            String\n  administrativeAreaSnapshot  String?\n  postalCodeSnapshot          String?\n  countryCodeSnapshot         String\n  latitudeSnapshot            Decimal?                            @db.Decimal(9, 6)\n  longitudeSnapshot           Decimal?                            @db.Decimal(9, 6)\n  zoneIdSnapshot              String?\n  zoneNameSnapshot            String?\n  zoneAreaPostalLabelSnapshot String?\n  deliveryFeeSnapshot         Decimal                             @db.Decimal(12, 2)\n  deliveryTaxSnapshot         Decimal                             @default(0) @db.Decimal(12, 2)\n  promisedMinutesSnapshot     Int\n  promisedAt                  DateTime\n  instructions                String?\n  dispatchedAt                DateTime?\n  deliveredAt                 DateTime?\n  cancelledAt                 DateTime?\n  failedAt                    DateTime?\n  createdAt                   DateTime                            @default(now())\n  updatedAt                   DateTime                            @updatedAt\n\n  branch   RestaurantBranch   @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)\n  customer RestaurantCustomer @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: Restrict)\n  order    RestaurantOrder    @relation(fields: [organizationId, branchId, orderId], references: [organizationId, branchId, id], onDelete: Restrict)\n\n  @@unique([organizationId, orderId])\n  @@unique([organizationId, branchId, orderId])\n  @@index([organizationId, branchId, status])\n  @@index([organizationId, customerId, createdAt])\n  @@map(\"restaurant_delivery_fulfillments\")\n}\n\n/// D08: normalized EMAIL/PHONE identity. EMAIL normalization is also pinned by\n/// a migration CHECK; PHONE canonicalization is supplied and validated at the\n/// API boundary. The org-scoped unique is the only local dedupe authority.\nmodel CustomerIdentifier {\n  id              String                 @id @default(cuid())\n  organizationId  String                 @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  customerId      String\n  kind            CustomerIdentifierKind\n  normalizedValue String\n  verifiedAt      DateTime?\n  createdAt       DateTime               @default(now())\n  updatedAt       DateTime               @updatedAt\n\n  customer RestaurantCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)\n\n  @@unique([organizationId, kind, normalizedValue])\n  @@index([organizationId])\n  @@index([customerId])\n  @@map(\"restaurant_customer_identifiers\")\n}\n\n/// D08: APPEND-ONLY customer timeline event. Branch and order references make\n/// branch interactions directly queryable; payload is metadata only and must\n/// never copy customer PII. The org idempotency key deduplicates retries.\nmodel CustomerInteraction {\n  id             String   @id @default(cuid())\n  organizationId String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  customerId     String\n  branchId       String\n  orderId        String?\n  type           String\n  payload        Json     @default(\"{}\")\n  occurredAt     DateTime @default(now())\n  idempotencyKey String\n  createdAt      DateTime @default(now())\n\n  customer RestaurantCustomer @relation(fields: [customerId], references: [id], onDelete: Restrict)\n  branch   RestaurantBranch   @relation(fields: [branchId], references: [id], onDelete: Restrict)\n  order    RestaurantOrder?   @relation(fields: [orderId], references: [id], onDelete: Restrict)\n\n  @@unique([organizationId, idempotencyKey])\n  @@index([organizationId])\n  @@index([customerId, occurredAt])\n  @@index([branchId, occurredAt])\n  @@index([orderId])\n  @@map(\"restaurant_customer_interactions\")\n}\n\n/// D08: static tag vocabulary used only as the future segmentation seam. M8\n/// deliberately carries no dynamic segment-rule language.\nmodel CustomerTag {\n  id             String   @id @default(cuid())\n  organizationId String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  name           String\n  color          String?\n  createdAt      DateTime @default(now())\n  updatedAt      DateTime @updatedAt\n\n  assignments CustomerTagAssignment[]\n\n  @@index([organizationId])\n  @@map(\"restaurant_customer_tags\")\n}\n\nmodel CustomerTagAssignment {\n  id             String   @id @default(cuid())\n  organizationId String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  customerId     String\n  tagId          String\n  createdAt      DateTime @default(now())\n\n  customer RestaurantCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)\n  tag      CustomerTag        @relation(fields: [tagId], references: [id], onDelete: Cascade)\n\n  @@unique([customerId, tagId])\n  @@index([organizationId])\n  @@index([tagId])\n  @@map(\"restaurant_customer_tag_assignments\")\n}\n\n/// D08: APPEND-ONLY channel consent event. Current state is the latest event;\n/// absence means denied. Source, actor and policyVersion retain provenance while\n/// the idempotency key makes event ingestion retry-safe.\nmodel CustomerConsent {\n  id             String                 @id @default(cuid())\n  organizationId String                 @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  customerId     String\n  channel        CustomerConsentChannel\n  granted        Boolean\n  source         String\n  actorId        String\n  policyVersion  String\n  occurredAt     DateTime               @default(now())\n  idempotencyKey String\n  createdAt      DateTime               @default(now())\n\n  customer RestaurantCustomer @relation(fields: [customerId], references: [id], onDelete: Restrict)\n\n  @@unique([organizationId, idempotencyKey])\n  @@index([organizationId])\n  @@index([customerId, channel, occurredAt])\n  @@map(\"restaurant_customer_consents\")\n}\n\n/// D08: one organization-wide loyalty configuration timeline. At time T, the\n/// effective version is the greatest effectiveFrom <= T. The migration prevents\n/// UPDATE/DELETE once effective, so configuration changes append a new version.\nmodel LoyaltyProgramVersion {\n  id              String   @id @default(cuid())\n  organizationId  String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  versionNumber   Int\n  effectiveFrom   DateTime\n  earnRate        Decimal  @db.Decimal(18, 6)\n  redemptionValue Decimal  @db.Decimal(18, 6)\n  expiryDays      Int?\n  createdAt       DateTime @default(now())\n  updatedAt       DateTime @updatedAt\n\n  pointsEntries      LoyaltyPointsEntry[]\n  insightLiabilities InsightLoyaltyLiability[]\n\n  @@unique([organizationId, id])\n  @@unique([organizationId, versionNumber])\n  @@unique([organizationId, effectiveFrom])\n  @@index([organizationId])\n  @@index([effectiveFrom])\n  @@map(\"restaurant_loyalty_program_versions\")\n}\n\n/// D08: at most one loyalty account per customer. Balance is never stored; it is\n/// the exact SUM(points) over LoyaltyPointsEntry at read time.\nmodel LoyaltyAccount {\n  id             String    @id @default(cuid())\n  organizationId String    @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  customerId     String    @unique\n  active         Boolean   @default(true)\n  enrolledAt     DateTime  @default(now())\n  deactivatedAt  DateTime?\n  createdAt      DateTime  @default(now())\n  updatedAt      DateTime  @updatedAt\n\n  customer      RestaurantCustomer   @relation(fields: [customerId], references: [id], onDelete: Restrict)\n  pointsEntries LoyaltyPointsEntry[]\n\n  @@unique([organizationId, customerId])\n  @@index([organizationId])\n  @@index([active])\n  @@map(\"restaurant_loyalty_accounts\")\n}\n\n/// D08: APPEND-ONLY signed whole-points ledger. EARN pins the settled bill and\n/// effective program version; REDEEM/REVERSAL/EXPIRY are negative entries;\n/// reversesEntryId links corrections/lot consumption to the original earn.\nmodel LoyaltyPointsEntry {\n  id               String                 @id @default(cuid())\n  organizationId   String                 @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  accountId        String\n  programVersionId String\n  kind             LoyaltyPointsEntryKind\n  points           Int\n  billId           String?\n  refundId         String?\n  reversesEntryId  String?\n  actorId          String?\n  reason           String?\n  expiresAt        DateTime?\n  occurredAt       DateTime               @default(now())\n  idempotencyKey   String\n  createdAt        DateTime               @default(now())\n\n  account        LoyaltyAccount        @relation(fields: [accountId], references: [id], onDelete: Restrict)\n  programVersion LoyaltyProgramVersion @relation(fields: [programVersionId], references: [id], onDelete: Restrict)\n  bill           RestaurantBill?       @relation(fields: [billId], references: [id], onDelete: SetNull)\n  refund         RestaurantRefund?     @relation(fields: [refundId], references: [id], onDelete: SetNull)\n  reversesEntry  LoyaltyPointsEntry?   @relation(\"LoyaltyPointsReversal\", fields: [reversesEntryId], references: [id], onDelete: Restrict)\n  reversedBy     LoyaltyPointsEntry[]  @relation(\"LoyaltyPointsReversal\")\n\n  @@unique([organizationId, idempotencyKey])\n  @@index([organizationId])\n  @@index([accountId, occurredAt])\n  @@index([programVersionId])\n  @@index([billId])\n  @@index([refundId])\n  @@index([reversesEntryId])\n  @@map(\"restaurant_loyalty_points_entries\")\n}\n\n/// D22: rebuildable daily branch projection pinned to the authoritative latest\n/// daily-close chain tip used for reconciliation. All monetary values are Decimal.\nmodel InsightDailyRollup {\n  id                 String   @id @default(cuid())\n  organizationId     String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId           String\n  businessDate       DateTime @db.Date\n  sourceDailyCloseId String\n  orderCount         Int      @default(0)\n  coverCount         Int      @default(0)\n  grossSales         Decimal  @default(0) @db.Decimal(12, 2)\n  netSales           Decimal  @default(0) @db.Decimal(12, 2)\n  deliveryFeeSales   Decimal  @default(0) @db.Decimal(12, 2)\n  deliveryFeeRefunds Decimal  @default(0) @db.Decimal(12, 2)\n  compTotal          Decimal  @default(0) @db.Decimal(12, 2)\n  refundTotal        Decimal  @default(0) @db.Decimal(12, 2)\n  voidTotal          Decimal  @default(0) @db.Decimal(12, 2)\n  drawerVariance     Decimal  @default(0) @db.Decimal(12, 2)\n  loyaltyLiability   Decimal  @default(0) @db.Decimal(12, 2)\n  projectionVersion  Int      @default(1)\n  computedAt         DateTime @default(now())\n  createdAt          DateTime @default(now())\n  updatedAt          DateTime @updatedAt\n\n  branch           RestaurantBranch     @relation(fields: [branchId], references: [id], onDelete: Cascade)\n  sourceDailyClose RestaurantDailyClose @relation(fields: [sourceDailyCloseId], references: [id], onDelete: Restrict)\n\n  @@unique([organizationId, branchId, businessDate])\n  @@index([organizationId])\n  @@index([sourceDailyCloseId])\n  @@map(\"restaurant_insight_daily_rollups\")\n}\n\n/// Organization-wide daily loyalty liability. Unlike branch rollups this fact is\n/// stored once per tenant/date, with every historical input pinned for replay.\nmodel InsightLoyaltyLiability {\n  id                String   @id @default(cuid())\n  organizationId    String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  businessDate      DateTime @db.Date\n  cutoffAt          DateTime\n  programVersionId  String?\n  redemptionValue   Decimal  @default(0) @db.Decimal(18, 6)\n  positivePoints    BigInt   @default(0)\n  signedPoints      BigInt   @default(0)\n  liability         Decimal  @default(0) @db.Decimal(12, 2)\n  projectionVersion Int      @default(1)\n  computedAt        DateTime @default(now())\n  createdAt         DateTime @default(now())\n  updatedAt         DateTime @updatedAt\n\n  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)\n  programVersion LoyaltyProgramVersion? @relation(fields: [organizationId, programVersionId], references: [organizationId, id], onDelete: Restrict)\n\n  @@unique([organizationId, businessDate])\n  @@index([organizationId])\n  @@index([programVersionId])\n  @@map(\"restaurant_insight_loyalty_liabilities\")\n}\n\n/// D22: rebuildable product-level item-mix projection. Key adds product to the\n/// daily branch key; product identity stays canonical and branch-free.\nmodel InsightItemMixRollup {\n  id                 String   @id @default(cuid())\n  organizationId     String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId           String\n  businessDate       DateTime @db.Date\n  productId          String\n  sourceDailyCloseId String\n  quantity           Int      @default(0)\n  grossSales         Decimal  @default(0) @db.Decimal(12, 2)\n  netSales           Decimal  @default(0) @db.Decimal(12, 2)\n  compTotal          Decimal  @default(0) @db.Decimal(12, 2)\n  projectionVersion  Int      @default(1)\n  computedAt         DateTime @default(now())\n  createdAt          DateTime @default(now())\n  updatedAt          DateTime @updatedAt\n\n  branch           RestaurantBranch     @relation(fields: [branchId], references: [id], onDelete: Cascade)\n  product          RestaurantProduct    @relation(fields: [productId], references: [id], onDelete: Restrict)\n  sourceDailyClose RestaurantDailyClose @relation(fields: [sourceDailyCloseId], references: [id], onDelete: Restrict)\n\n  @@unique([organizationId, branchId, businessDate, productId])\n  @@index([organizationId])\n  @@index([productId])\n  @@index([sourceDailyCloseId])\n  @@map(\"restaurant_insight_item_mix_rollups\")\n}\n\n/// D22: APPEND-ONLY imported daily labour fact. It stores aggregate hours/cost,\n/// never employee wage or payroll data. Read/export requires reports:financial\n/// plus workforce:rates in the later report lane.\nmodel LabourCostFact {\n  id             String   @id @default(cuid())\n  organizationId String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId       String\n  businessDate   DateTime @db.Date\n  labourHours    Decimal  @db.Decimal(12, 2)\n  labourCost     Decimal  @db.Decimal(12, 2)\n  source         String\n  idempotencyKey String\n  importedAt     DateTime @default(now())\n  createdAt      DateTime @default(now())\n\n  branch RestaurantBranch @relation(fields: [branchId], references: [id], onDelete: Restrict)\n\n  @@unique([organizationId, idempotencyKey])\n  @@index([organizationId])\n  @@index([branchId, businessDate])\n  @@map(\"restaurant_labour_cost_facts\")\n}\n\n// ===========================================================================\n// R-lane / WHA-194 \\u2014 OCR menu import. A restaurant uploads the menu it already\n// has; extraction fills a REVIEW QUEUE; only rows a human confirms become\n// catalog records. Nothing here is ever a live catalog row: an import holds\n// untrusted, adapter-produced candidates until someone accepts them.\n//\n// Org-scoped under forced RLS in the accompanying migration, like every other\n// restaurant table.\n// ===========================================================================\n\nenum RestaurantMenuImportStatus {\n  PENDING_EXTRACTION\n  EXTRACTING\n  AWAITING_REVIEW\n  EXTRACTION_FAILED\n  COMMITTED\n  DISCARDED\n}\n\nenum RestaurantMenuImportAdapter {\n  FIXTURE\n  VISION\n}\n\nenum RestaurantMenuImportLineStatus {\n  PENDING\n  ACCEPTED\n  REJECTED\n  MERGED\n}\n\n/// One uploaded menu working its way from bytes to reviewed catalog rows.\n/// \\`checksum\\` anchors idempotency: re-uploading identical bytes resumes the\n/// existing draft instead of paying for a second extraction. The source file is\n/// retained ONLY while a reviewer still needs to compare against it \\u2014\n/// \\`sourceDeletedAt\\` records that the retention obligation has been discharged\n/// on commit, discard, or the 14-day purge.\nmodel RestaurantMenuImport {\n  id                          String                      @id @default(cuid())\n  organizationId              String                      @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  status                      RestaurantMenuImportStatus  @default(PENDING_EXTRACTION)\n  adapter                     RestaurantMenuImportAdapter\n  adapterVersion              String?\n  fileName                    String\n  mimeType                    String\n  byteSize                    Int\n  pageCount                   Int\n  checksum                    String\n  storageObjectName           String?\n  sourceDeletedAt             DateTime?\n  /// The org's currency at upload time, used only to flag a mismatched price.\n  defaultCurrency             String?\n  idempotencyKey              String\n  extractionJobId             String?\n  extractionStartedAt         DateTime?\n  extractionCompletedAt       DateTime?\n  failureReason               String?\n  createdById                 String\n  committedAt                 DateTime?\n  committedById               String?\n  /// Ids-only commit evidence. Intentionally NOT foreign keys \\u2014 audit evidence\n  /// must survive a later catalog or menu deletion rather than block it.\n  committedMenuId             String?\n  committedPriceListVersionId String?\n  discardedAt                 DateTime?\n  discardedById               String?\n  createdAt                   DateTime                    @default(now())\n  updatedAt                   DateTime                    @updatedAt\n\n  pages RestaurantMenuImportPage[]\n  lines RestaurantMenuImportLine[]\n\n  @@unique([organizationId, idempotencyKey])\n  @@index([organizationId])\n  @@index([status, createdAt])\n  @@index([organizationId, checksum])\n  @@map(\"restaurant_menu_imports\")\n}\n\n/// A page of the upload. Present even for a single image so multi-page PDFs and\n/// photos share one review shape.\nmodel RestaurantMenuImportPage {\n  id             String   @id @default(cuid())\n  organizationId String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  importId       String\n  pageNumber     Int\n  /// Adapter legibility notes (\"glare on lower third\"). Data, never directives.\n  warnings       String[]\n  createdAt      DateTime @default(now())\n\n  import RestaurantMenuImport       @relation(fields: [importId], references: [id], onDelete: Cascade)\n  lines  RestaurantMenuImportLine[]\n\n  @@unique([importId, pageNumber])\n  @@index([organizationId])\n  @@map(\"restaurant_menu_import_pages\")\n}\n\n/// One candidate menu row awaiting a human decision.\n///\n/// The \\`extracted*\\` fields are what the adapter reported and are never\n/// overwritten \\u2014 a reviewer's correction lands in the matching \\`reviewed*\\`\n/// field, so the queue always shows both what the menu said and what a person\n/// decided. A null \\`reviewed*\\` means \"the extracted value stands\".\nmodel RestaurantMenuImportLine {\n  id             String @id @default(cuid())\n  organizationId String @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  importId       String\n  pageId         String\n  sortOrder      Int    @default(0)\n\n  extractedCategoryName String?\n  extractedProductName  String?\n  extractedDescription  String?\n  extractedIngredients  String[]\n  extractedPriceAmount  Decimal? @db.Decimal(12, 2)\n  extractedCurrency     String?\n  extractedPriceRaw     String?\n  extractedVariants     Json     @default(\"[]\")\n  extractedModifiers    Json     @default(\"[]\")\n  /// Per-field score in [0,1] as reported by the adapter and clamped on ingest.\n  confidence            Json     @default(\"{}\")\n  /// Review signals: LOW_CONFIDENCE, MISSING_PRICE, SUSPECTED_INJECTION, ...\n  flags                 String[]\n  /// Case/punctuation-folded product name used for duplicate and collision hits.\n  matchKey              String?\n\n  reviewStatus         RestaurantMenuImportLineStatus @default(PENDING)\n  reviewedCategoryName String?\n  reviewedProductName  String?\n  reviewedDescription  String?\n  reviewedPriceAmount  Decimal?                       @db.Decimal(12, 2)\n  reviewedCurrency     String?\n  reviewNote           String?\n  /// Merge target while the import is open. Tenant-checked by composite FK in\n  /// the migration and cleared once the import commits.\n  mergeProductId       String?\n  mergeVariantId       String?\n  reviewedById         String?\n  reviewedAt           DateTime?\n\n  /// Ids-only commit evidence \\u2014 see the note on RestaurantMenuImport.\n  committedCategoryId   String?\n  committedProductId    String?\n  committedVariantId    String?\n  committedMenuItemId   String?\n  committedPriceEntryId String?\n\n  createdAt DateTime @default(now())\n  updatedAt DateTime @updatedAt\n\n  import RestaurantMenuImport     @relation(fields: [importId], references: [id], onDelete: Cascade)\n  page   RestaurantMenuImportPage @relation(fields: [pageId], references: [id], onDelete: Cascade)\n\n  @@index([organizationId])\n  @@index([importId, sortOrder])\n  @@index([importId, reviewStatus])\n  @@index([pageId])\n  @@index([organizationId, matchKey])\n  @@map(\"restaurant_menu_import_lines\")\n}\n\n// ---------------------------------------------------------------------------\n// WHA-288 / promotions Lane A \\u2014 the checkout discount layer specified by\n// docs/specs/restaurant-promotions.md (WHA-279).\n//\n// Shape of this block, and why:\n//   - A mutable \\`RestaurantPromotion\\` identity owns immutable published\n//     \\`RestaurantPromotionVersion\\` rows (\\xA73.1). Only DRAFT rows mutate; the\n//     migration enforces that with a trigger Prisma cannot express.\n//   - Checkout appends ONE \\`RestaurantPromotionEvaluationSnapshot\\` per accepted\n//     evaluation, carrying every candidate (accepted AND rejected, \\xA75.1) plus\n//     the unit-level allocations. Reconstruction reads snapshots only \\u2014 it never\n//     joins live promotion, catalog, branch or tax configuration (\\xA75.2).\n//   - Caps are a locked counter + append-only reservation ledger (\\xA76). No\n//     read-then-write counter authorizes a capped benefit.\n//\n// Deliberate modelling decisions:\n//   - \\`orderId\\`, \\`billId\\`, \\`branchId\\`, \\`priceListVersionId\\`, \\`terminalDeviceId\\`\n//     and the actor columns are SCALAR, with no Prisma relation. A relation\n//     would require a back-relation field on RestaurantOrder/RestaurantBill/\n//     RestaurantBranch, and this lane owns promotion symbols only. Same-tenant\n//     integrity for those references is enforced in the migration by\n//     \\`guard_promotion_tenant_ref()\\` triggers, which is what \\xA710 actually asks\n//     for; \\xA75.2 already rules that snapshot payloads \\u2014 not FKs \\u2014 are\n//     authoritative for reconstruction.\n//   - Every promotion-owned table carries \\`@@unique([organizationId, id])\\` so\n//     the FKs BETWEEN these tables are composite and same-tenant by\n//     construction (\\xA710).\n//   - \\`offlinePolicy\\`, \\`setRevisionId/Hash\\`, \\`source\\` and \\`taxTreatment\\` are\n//     declared seams for the offline (WHA-282) and tax/loyalty (WHA-281) lanes.\n//     Lane A writes and validates them; it implements no cache, queue or tax\n//     integration.\n// ---------------------------------------------------------------------------\n\nenum RestaurantPromotionStatus {\n  ACTIVE\n  ARCHIVED\n}\n\nenum RestaurantPromotionVersionStatus {\n  DRAFT\n  PUBLISHED\n  SUPERSEDED\n}\n\n/// \\xA73.1 authority. AUTOMATIC needs no actor; COUPON_CODE matches a keyed hash;\n/// STAFF/MANAGER additionally snapshot the acting staff and authorization.\nenum RestaurantPromotionActivationMode {\n  AUTOMATIC\n  COUPON_CODE\n  STAFF\n  MANAGER\n}\n\n/// \\xA73.3. One version carries exactly one target expression.\nenum RestaurantPromotionTargetKind {\n  ITEM\n  CATEGORY\n  ORDER\n}\n\n/// \\xA73.4 \\u2014 the closed initial benefit set.\nenum RestaurantPromotionBenefitKind {\n  PERCENT_OFF\n  AMOUNT_OFF\n  FIXED_PRICE\n  BUY_X_GET_Y_PERCENT\n  BUY_X_GET_Y_AMOUNT\n  BUY_X_GET_Y_FREE\n  BUNDLE_PRICE\n}\n\nenum RestaurantPromotionApplicationBasis {\n  LINE\n  UNIT\n  ORDER\n}\n\n/// \\xA74.2 stacking. EXCLUSIVE rejects every other candidate once accepted;\n/// GROUP_EXCLUSIVE admits at most one identity per \\`stackingGroup\\`.\nenum RestaurantPromotionStackingMode {\n  EXCLUSIVE\n  GROUP_EXCLUSIVE\n  STACKABLE\n}\n\n/// \\xA77 seam. A capped, segmented or manager-authorized rule is ONLINE_ONLY and\n/// may never be quoted from an offline cache.\nenum RestaurantPromotionOfflinePolicy {\n  ALLOW\n  ONLINE_ONLY\n}\n\nenum RestaurantPromotionEvaluationSource {\n  ONLINE\n  OFFLINE_RECONCILED\n}\n\n/// \\xA76. Per-order limits are settled inside the evaluation and need no ledger;\n/// these three scopes do.\nenum RestaurantPromotionCapScopeKind {\n  GLOBAL\n  CUSTOMER\n  BUDGET\n}\n\nenum RestaurantPromotionReservationState {\n  RESERVED\n  CONSUMED\n  RELEASED\n}\n\n/// \\xA75.1 \\u2014 rejected candidates are retained, so the outcome is explicit.\nenum RestaurantPromotionCandidateOutcome {\n  ACCEPTED\n  REJECTED\n}\n\n/// \\xA710 append-only audit surface.\nenum RestaurantPromotionAuditAction {\n  DRAFT_CREATED\n  DRAFT_EDITED\n  PUBLISHED\n  SUPERSEDED\n  ARCHIVED\n  EMERGENCY_DISABLED\n  EVALUATED\n  CAP_RESERVED\n  CAP_CONSUMED\n  CAP_RELEASED\n  OFFLINE_MISMATCH\n  REVERSED\n}\n\n/// \\xA73.1 stable identity. \\`code\\` is unique per tenant and never reused; the\n/// identity itself carries no schedule, benefit or money \\u2014 those live on the\n/// immutable versions it owns.\nmodel RestaurantPromotion {\n  id             String                    @id @default(cuid())\n  organizationId String                    @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  code           String\n  name           String\n  status         RestaurantPromotionStatus @default(ACTIVE)\n  archivedAt     DateTime?\n  createdAt      DateTime                  @default(now())\n  updatedAt      DateTime                  @updatedAt\n\n  versions RestaurantPromotionVersion[]\n\n  @@unique([organizationId, code], map: \"promo_org_code_key\")\n  @@unique([organizationId, id], map: \"promo_org_id_key\")\n  @@index([organizationId], map: \"promo_org_idx\")\n  @@index([organizationId, status], map: \"promo_org_status_idx\")\n  @@map(\"restaurant_promotions\")\n}\n\n/// \\xA73.1 immutable-after-publication version. Every field the evaluator reads is\n/// normalized here; \\`ruleSnapshot\\`/\\`ruleHash\\` are the canonical reconstruction\n/// and audit boundary over the same content.\nmodel RestaurantPromotionVersion {\n  id             String                           @id @default(cuid())\n  organizationId String                           @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  promotionId    String\n  versionNumber  Int\n  status         RestaurantPromotionVersionStatus @default(DRAFT)\n\n  // \\xA73.2 schedule. \\`dayMask\\` bit 0 = Monday .. bit 6 = Sunday. A null minute\n  // window means the whole selected local day; \\`startMinute > endMinute\\` is an\n  // overnight window anchored on the selected day.\n  effectiveFrom DateTime\n  effectiveTo   DateTime?\n  timezone      String\n  dayMask       Int       @default(127)\n  startMinute   Int?\n  endMinute     Int?\n\n  // \\xA73.1 authority. Coupon plaintext is NEVER stored (\\xA710) \\u2014 only a keyed hash.\n  activationMode          RestaurantPromotionActivationMode @default(AUTOMATIC)\n  couponCodeHash          String?\n  requiredPermission      String?\n  requiresCoAuthorization Boolean                           @default(false)\n  approvedByStaffId       String?\n  approvalReference       String?\n  publishedAt             DateTime?\n  supersededAt            DateTime?\n\n  // \\xA73.3 target expression.\n  targetKind         RestaurantPromotionTargetKind\n  targetProductIds   String[]                      @default([])\n  targetVariantIds   String[]                      @default([])\n  targetCategoryIds  String[]                      @default([])\n  includeDescendants Boolean                       @default(false)\n  componentTargeting Boolean                       @default(false)\n\n  // \\xA73.3 filters common to every target.\n  allowedBranchIds   String[]                 @default([])\n  allowedChannels    RestaurantOrderChannel[] @default([])\n  customerSegmentRef String?\n  minimumQuantity    Int?\n  minimumAmount      Decimal?                 @db.Decimal(12, 2)\n\n  // \\xA73.4 benefit. \\`benefitBasisPoints\\` is 1500 for 15%; FIXED_PRICE/BUNDLE_PRICE\n  // use \\`benefitAmount\\` as the stated total, never a surcharge.\n  benefitKind        RestaurantPromotionBenefitKind\n  benefitBasisPoints Int?\n  benefitAmount      Decimal?                            @db.Decimal(12, 2)\n  buyQuantity        Int?\n  getQuantity        Int?\n  applicationBasis   RestaurantPromotionApplicationBasis @default(ORDER)\n  maxBenefitAmount   Decimal?                            @db.Decimal(12, 2)\n  currency           String\n\n  // \\xA74.2 canonical ordering and stacking.\n  priority                Int                             @default(0)\n  stackingGroup           String                          @default(\"\")\n  stackingMode            RestaurantPromotionStackingMode @default(STACKABLE)\n  stopFurtherProcessing   Boolean                         @default(false)\n  maxApplicationsPerOrder Int?\n\n  // \\xA76 caps. Per-order is evaluated in-memory; the other three reserve.\n  perOrderCap    Int?\n  globalCap      Int?\n  perCustomerCap Int?\n  budgetAmount   Decimal? @db.Decimal(12, 2)\n\n  // \\xA77 seam.\n  offlinePolicy RestaurantPromotionOfflinePolicy @default(ONLINE_ONLY)\n\n  // \\xA73.1 canonical snapshot + hash over its canonical serialization.\n  ruleSnapshot Json\n  ruleHash     String\n\n  createdAt DateTime @default(now())\n  updatedAt DateTime @updatedAt\n\n  promotion    RestaurantPromotion                      @relation(fields: [organizationId, promotionId], references: [organizationId, id], onDelete: Cascade, map: \"promo_version_promotion_fkey\")\n  components   RestaurantPromotionRuleComponent[]\n  candidates   RestaurantPromotionCandidateSnapshot[]\n  applications RestaurantPromotionApplicationSnapshot[]\n  capCounters  RestaurantPromotionCapCounter[]\n\n  @@unique([organizationId, promotionId, versionNumber], map: \"promo_version_org_promo_number_key\")\n  @@unique([organizationId, id], map: \"promo_version_org_id_key\")\n  @@index([organizationId], map: \"promo_version_org_idx\")\n  @@index([organizationId, status, effectiveFrom], map: \"promo_version_org_status_effective_idx\")\n  @@index([organizationId, promotionId, status], map: \"promo_version_org_promo_status_idx\")\n  @@map(\"restaurant_promotion_versions\")\n}\n\n/// \\xA73.4/\\xA78 BUNDLE_PRICE components. A promotion bundle owns its own immutable\n/// requirement rows because combo composition carries no quantities-with-\n/// alternatives, benefit allocation, versioning or audit semantics.\nmodel RestaurantPromotionRuleComponent {\n  id                 String   @id @default(cuid())\n  organizationId     String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  promotionVersionId String\n  ordinal            Int\n  productIds         String[] @default([])\n  variantIds         String[] @default([])\n  categoryIds        String[] @default([])\n  quantity           Int      @default(1)\n  createdAt          DateTime @default(now())\n\n  version RestaurantPromotionVersion @relation(fields: [organizationId, promotionVersionId], references: [organizationId, id], onDelete: Cascade, map: \"promo_component_version_fkey\")\n\n  @@unique([organizationId, promotionVersionId, ordinal], map: \"promo_component_org_version_ordinal_key\")\n  @@unique([organizationId, id], map: \"promo_component_org_id_key\")\n  @@index([organizationId], map: \"promo_component_org_idx\")\n  @@map(\"restaurant_promotion_rule_components\")\n}\n\n/// \\xA75.1 the append-only order evaluation snapshot: everything required to\n/// reproduce the result WITHOUT reading current configuration.\nmodel RestaurantPromotionEvaluationSnapshot {\n  id             String @id @default(cuid())\n  organizationId String @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n\n  orderId        String\n  branchId       String\n  channel        RestaurantOrderChannel\n  currency       String\n  idempotencyKey String\n\n  // \\xA73.2 resolved schedule facts, so an auditor never re-reads a branch timezone.\n  evaluatedAt      DateTime\n  timezone         String\n  localDate        String\n  localMinute      Int\n  utcOffsetMinutes Int\n\n  engineVersion String\n  moneyVersion  String\n\n  // \\xA77 seam: which promotion-set revision produced this, and from where.\n  setRevisionId    String\n  setRevisionHash  String\n  source           RestaurantPromotionEvaluationSource @default(ONLINE)\n  terminalDeviceId String?\n\n  priceListVersionId String?\n\n  /// Complete pre-discount input lines (\\xA75.1): item, product/variant, category\n  /// ancestry, quantity, unit price, modifier deltas, comp allocation, extended.\n  inputLines        Json\n  /// The rest of the canonical evaluation input \\u2014 customer segments, coupon\n  /// fingerprints, authority actor, online flag. Kept separate so \\`inputLines\\`\n  /// stays exactly the payload \\xA75.1 enumerates, while a replay still holds\n  /// every input it needs WITHOUT reading live configuration.\n  evaluationContext Json\n  inputHash         String\n  outputHash        String\n\n  discountTotal Decimal @default(0) @db.Decimal(12, 2)\n\n  // \\xA75.2 corrections append a reversal that negates the original.\n  reversesSnapshotId String?\n  reversalReason     String?\n\n  createdAt DateTime @default(now())\n\n  candidates       RestaurantPromotionCandidateSnapshot[]\n  applications     RestaurantPromotionApplicationSnapshot[]\n  billApplications RestaurantPromotionBillApplicationSnapshot[]\n  reservations     RestaurantPromotionCapReservation[]\n  reversedSnapshot RestaurantPromotionEvaluationSnapshot?       @relation(\"PromotionEvaluationReversal\", fields: [organizationId, reversesSnapshotId], references: [organizationId, id], onDelete: Restrict, map: \"promo_eval_reversedsnapshot_fkey\")\n  reversals        RestaurantPromotionEvaluationSnapshot[]      @relation(\"PromotionEvaluationReversal\")\n\n  @@unique([organizationId, idempotencyKey], map: \"promo_eval_org_key_key\")\n  @@unique([organizationId, id], map: \"promo_eval_org_id_key\")\n  @@index([organizationId], map: \"promo_eval_org_idx\")\n  @@index([organizationId, orderId], map: \"promo_eval_org_order_idx\")\n  @@index([organizationId, branchId, evaluatedAt], map: \"promo_eval_org_branch_time_idx\")\n  @@map(\"restaurant_promotion_evaluation_snapshots\")\n}\n\n/// \\xA75.1 every CONSIDERED candidate in canonical order, accepted or not \\u2014\n/// explaining why a lower-priority rule won is part of reconstruction.\nmodel RestaurantPromotionCandidateSnapshot {\n  id                 String @id @default(cuid())\n  organizationId     String @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  evaluationId       String\n  ordinal            Int\n  promotionId        String\n  promotionVersionId String\n  versionNumber      Int\n  ruleHash           String\n\n  /// The full canonical rule content as it stood at evaluation time.\n  ruleSnapshot Json\n\n  activationMode     RestaurantPromotionActivationMode\n  authorityActorId   String?\n  authorityReference String?\n  /// Non-reversible fingerprint only \\u2014 coupon plaintext is never stored (\\xA710).\n  couponFingerprint  String?\n\n  outcome    RestaurantPromotionCandidateOutcome\n  reasonCode String\n  createdAt  DateTime                            @default(now())\n\n  evaluation RestaurantPromotionEvaluationSnapshot @relation(fields: [organizationId, evaluationId], references: [organizationId, id], onDelete: Restrict, map: \"promo_candidate_evaluation_fkey\")\n  version    RestaurantPromotionVersion            @relation(fields: [organizationId, promotionVersionId], references: [organizationId, id], onDelete: Restrict, map: \"promo_candidate_version_fkey\")\n\n  @@unique([organizationId, evaluationId, ordinal], map: \"promo_candidate_org_eval_ordinal_key\")\n  @@unique([organizationId, id], map: \"promo_candidate_org_id_key\")\n  @@index([organizationId], map: \"promo_candidate_org_idx\")\n  @@index([organizationId, promotionVersionId], map: \"promo_candidate_org_version_idx\")\n  @@map(\"restaurant_promotion_candidate_snapshots\")\n}\n\n/// \\xA75.1 an ACCEPTED application: unrounded and rounded benefit, the cap\n/// reservation that authorized it, and its per-unit allocation rows.\nmodel RestaurantPromotionApplicationSnapshot {\n  id                 String                         @id @default(cuid())\n  organizationId     String                         @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  evaluationId       String\n  applicationOrdinal Int\n  promotionId        String\n  promotionVersionId String\n  ruleHash           String\n  benefitKind        RestaurantPromotionBenefitKind\n  /// The exact pre-rounding benefit, retained so the rounding is auditable.\n  unroundedBenefit   Decimal                        @db.Decimal(18, 6)\n  roundedBenefit     Decimal                        @db.Decimal(12, 2)\n  qualifyingAmount   Decimal                        @db.Decimal(12, 2)\n  discountedQuantity Int                            @default(0)\n  reservationId      String?\n\n  createdAt DateTime @default(now())\n\n  evaluation       RestaurantPromotionEvaluationSnapshot        @relation(fields: [organizationId, evaluationId], references: [organizationId, id], onDelete: Restrict, map: \"promo_app_evaluation_fkey\")\n  version          RestaurantPromotionVersion                   @relation(fields: [organizationId, promotionVersionId], references: [organizationId, id], onDelete: Restrict, map: \"promo_app_version_fkey\")\n  allocations      RestaurantPromotionUnitAllocation[]\n  billApplications RestaurantPromotionBillApplicationSnapshot[]\n\n  @@unique([organizationId, evaluationId, applicationOrdinal], map: \"promo_app_org_eval_ordinal_key\")\n  @@unique([organizationId, id], map: \"promo_app_org_id_key\")\n  @@index([organizationId], map: \"promo_app_org_idx\")\n  @@index([organizationId, promotionVersionId], map: \"promo_app_org_version_idx\")\n  @@map(\"restaurant_promotion_application_snapshots\")\n}\n\n/// \\xA74.1/\\xA74.2 the stable unit key \\`(orderItemId, unitOrdinal)\\` and the cents this\n/// application put on it. Item-mix and refunds read these rows; they are never\n/// guessed during projection (\\xA79).\nmodel RestaurantPromotionUnitAllocation {\n  id              String   @id @default(cuid())\n  organizationId  String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  applicationId   String\n  orderItemId     String\n  unitOrdinal     Int\n  allocatedAmount Decimal  @db.Decimal(12, 2)\n  createdAt       DateTime @default(now())\n\n  application RestaurantPromotionApplicationSnapshot @relation(fields: [organizationId, applicationId], references: [organizationId, id], onDelete: Restrict, map: \"promo_alloc_application_fkey\")\n\n  @@unique([organizationId, applicationId, orderItemId, unitOrdinal], map: \"promo_alloc_org_app_item_unit_key\")\n  @@unique([organizationId, id], map: \"promo_alloc_org_id_key\")\n  @@index([organizationId], map: \"promo_alloc_org_idx\")\n  @@index([organizationId, orderItemId], map: \"promo_alloc_org_item_idx\")\n  @@map(\"restaurant_promotion_unit_allocations\")\n}\n\n/// \\xA75.2 the per-bill immutable application. \\`taxTreatment\\` is written by this\n/// lane and consumed by the tax lane (WHA-281); re-split or void-and-recut\n/// appends NEW rows against the same evaluation and rewrites no settled history.\nmodel RestaurantPromotionBillApplicationSnapshot {\n  id                 String  @id @default(cuid())\n  organizationId     String  @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  billId             String\n  orderId            String\n  evaluationId       String\n  applicationId      String\n  promotionId        String\n  promotionVersionId String\n  ruleHash           String\n  authorityActorId   String?\n  applicationOrdinal Int\n  subtotalBasis      Decimal @db.Decimal(12, 2)\n  computedAmount     Decimal @db.Decimal(12, 2)\n  /// BEFORE_TAX | AFTER_TAX, pinned from the governing tax rule (\\xA74.3).\n  taxTreatment       String?\n\n  reversesBillApplicationId String?\n  reversalReason            String?\n\n  createdAt DateTime @default(now())\n\n  evaluation      RestaurantPromotionEvaluationSnapshot        @relation(fields: [organizationId, evaluationId], references: [organizationId, id], onDelete: Restrict, map: \"promo_bill_app_evaluation_fkey\")\n  application     RestaurantPromotionApplicationSnapshot       @relation(fields: [organizationId, applicationId], references: [organizationId, id], onDelete: Restrict, map: \"promo_bill_app_application_fkey\")\n  reversedApplied RestaurantPromotionBillApplicationSnapshot?  @relation(\"PromotionBillApplicationReversal\", fields: [organizationId, reversesBillApplicationId], references: [organizationId, id], onDelete: Restrict, map: \"promo_bill_app_reversedapplied_fkey\")\n  reversals       RestaurantPromotionBillApplicationSnapshot[] @relation(\"PromotionBillApplicationReversal\")\n\n  @@unique([organizationId, id], map: \"promo_bill_app_org_id_key\")\n  @@index([organizationId], map: \"promo_bill_app_org_idx\")\n  @@index([organizationId, billId], map: \"promo_bill_app_org_bill_idx\")\n  @@index([organizationId, orderId], map: \"promo_bill_app_org_order_idx\")\n  @@map(\"restaurant_promotion_bill_application_snapshots\")\n}\n\n/// \\xA76 the locked counter. Committed consumption lives here; live reservations\n/// live in the ledger below. Authorization reads BOTH under one row lock.\nmodel RestaurantPromotionCapCounter {\n  id                 String                          @id @default(cuid())\n  organizationId     String                          @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  promotionVersionId String\n  scopeKind          RestaurantPromotionCapScopeKind\n  /// \"\" for GLOBAL/BUDGET; the customer identifier for CUSTOMER.\n  scopeKey           String                          @default(\"\")\n  capCount           Int?\n  capAmount          Decimal?                        @db.Decimal(12, 2)\n  consumedCount      Int                             @default(0)\n  consumedAmount     Decimal                         @default(0) @db.Decimal(12, 2)\n  createdAt          DateTime                        @default(now())\n  updatedAt          DateTime                        @updatedAt\n\n  version      RestaurantPromotionVersion          @relation(fields: [organizationId, promotionVersionId], references: [organizationId, id], onDelete: Restrict, map: \"promo_cap_ctr_version_fkey\")\n  reservations RestaurantPromotionCapReservation[]\n\n  @@unique([organizationId, promotionVersionId, scopeKind, scopeKey], map: \"promo_cap_ctr_org_version_scope_scopekey_key\")\n  @@unique([organizationId, id], map: \"promo_cap_ctr_org_id_key\")\n  @@index([organizationId], map: \"promo_cap_ctr_org_idx\")\n  @@map(\"restaurant_promotion_cap_counters\")\n}\n\n/// \\xA76 the append-only reservation/consumption ledger, keyed by\n/// \\`(promotionVersionId, scopeKey, evaluationId, applicationOrdinal)\\` so a\n/// replay of the same evaluation returns the ORIGINAL reservation.\nmodel RestaurantPromotionCapReservation {\n  id                 String                              @id @default(cuid())\n  organizationId     String                              @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  counterId          String\n  promotionVersionId String\n  scopeKind          RestaurantPromotionCapScopeKind\n  scopeKey           String                              @default(\"\")\n  evaluationId       String\n  applicationOrdinal Int\n  reservedCount      Int                                 @default(1)\n  reservedAmount     Decimal                             @default(0) @db.Decimal(12, 2)\n  state              RestaurantPromotionReservationState @default(RESERVED)\n  expiresAt          DateTime?\n  settledAt          DateTime?\n  releasedAt         DateTime?\n  createdAt          DateTime                            @default(now())\n\n  counter    RestaurantPromotionCapCounter         @relation(fields: [organizationId, counterId], references: [organizationId, id], onDelete: Restrict, map: \"promo_cap_res_counter_fkey\")\n  evaluation RestaurantPromotionEvaluationSnapshot @relation(fields: [organizationId, evaluationId], references: [organizationId, id], onDelete: Restrict, map: \"promo_cap_res_evaluation_fkey\")\n\n  @@unique([organizationId, promotionVersionId, scopeKind, scopeKey, evaluationId, applicationOrdinal], map: \"promo_cap_res_org_version_scope_scopekey_eval_ordinal_key\")\n  @@unique([organizationId, id], map: \"promo_cap_res_org_id_key\")\n  @@index([organizationId], map: \"promo_cap_res_org_idx\")\n  @@index([organizationId, counterId, state], map: \"promo_cap_res_org_counter_state_idx\")\n  @@map(\"restaurant_promotion_cap_reservations\")\n}\n\n/// \\xA710 append-only audit. Records IDs, hashes, reason codes, actor/device and\n/// timestamps \\u2014 never sensitive rule inputs or coupon plaintext.\nmodel RestaurantPromotionAuditEvent {\n  id                 String                         @id @default(cuid())\n  organizationId     String                         @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  action             RestaurantPromotionAuditAction\n  promotionId        String?\n  promotionVersionId String?\n  evaluationId       String?\n  reasonCode         String?\n  actorUserId        String?\n  actorStaffId       String?\n  deviceId           String?\n  payloadHash        String?\n  occurredAt         DateTime                       @default(now())\n  createdAt          DateTime                       @default(now())\n\n  @@index([organizationId], map: \"promo_audit_org_idx\")\n  @@index([organizationId, action, occurredAt], map: \"promo_audit_org_action_time_idx\")\n  @@index([organizationId, promotionVersionId], map: \"promo_audit_org_version_idx\")\n  @@map(\"restaurant_promotion_audit_events\")\n}\n\n// ===========================================================================\n// Completion wave \\u2014 branch scheduling and employee timekeeping.\n// Org-scoped under forced RLS (C1) and branch-scoped like every other operating\n// surface. This bounded workforce record does not introduce payroll, pay rates,\n// labour optimization, or another financial source of truth.\n// ===========================================================================\n\n/// A scheduled shift is either still on the roster (SCHEDULED) or withdrawn\n/// (CANCELLED). Cancellation is a soft, auditable state rather than a delete, so\n/// a roster that has already been published never silently loses a row; a\n/// cancelled shift never grants sign-in and never blocks a replacement shift.\nenum RestaurantShiftStatus {\n  SCHEDULED\n  CANCELLED\n}\n\nenum RestaurantShiftSwapDecisionKind {\n  APPROVED\n  REJECTED\n}\n\nenum RestaurantShiftEventKind {\n  PUBLISHED\n  UPDATED\n  CANCELLED\n  SWAP_REQUESTED\n  SWAP_APPROVED\n  SWAP_REJECTED\n}\n\nenum RestaurantTimeAdjustmentKind {\n  CLOCK_IN\n  CLOCK_OUT\n  BREAK_START\n  BREAK_END\n}\n\nenum RestaurantWorkforceCommandKind {\n  CLOCK_IN\n  CLOCK_OUT\n  BREAK_START\n  BREAK_END\n  SWAP_REQUEST\n  SWAP_APPROVE\n  SWAP_REJECT\n}\n\n/// A branch-scoped rostered shift for ONE staff operator.\n///\n/// \\`businessDate\\` is stamped ONCE at create/reschedule time from the branch's\n/// timezone + \\`businessDayCutoff\\` (\\`src/lib/restaurant/business-date.ts\\`, \\xA711.1)\n/// so a 01:30 shift on a 04:00-cutoff branch belongs to the operating day that\n/// has not yet closed \\u2014 it is never recomputed later from \\`startAt\\`.\n/// \\`startAt\\`/\\`endAt\\` are UTC instants; branch-local rendering happens at read\n/// time (the M7 convention).\n///\n/// \\`role\\` is a free-text roster label (Cashier, Kitchen, Shift Manager \\u2026), NOT\n/// an authorization input: permissions keep coming from ABAC and the org role.\n/// It exists so one staff profile can hold several different roles across the\n/// week; the overlap rule below is role-agnostic, because a person cannot work\n/// two shifts at once whatever the labels say.\nmodel RestaurantShift {\n  id             String                @id @default(cuid())\n  organizationId String                @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId       String\n  staffProfileId String\n  businessDate   DateTime              @db.Date\n  startAt        DateTime\n  endAt          DateTime\n  role           String?\n  notes          String?\n  status         RestaurantShiftStatus @default(SCHEDULED)\n  cancelledAt    DateTime?\n  cancelReason   String?\n  clockedInAt    DateTime?\n  clockedOutAt   DateTime?\n  version        Int                   @default(1)\n  createdAt      DateTime              @default(now())\n  updatedAt      DateTime              @updatedAt\n\n  branch          RestaurantBranch             @relation(fields: [branchId], references: [id], onDelete: Cascade)\n  staffProfile    RestaurantStaffProfile       @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)\n  breaks          RestaurantShiftBreak[]\n  swapRequests    RestaurantShiftSwapRequest[]\n  workforceEvents RestaurantShiftEvent[]\n  adjustments     RestaurantTimeAdjustment[]\n  commands        RestaurantWorkforceCommand[]\n\n  @@index([organizationId])\n  @@index([branchId, businessDate])\n  @@index([staffProfileId, startAt])\n  @@map(\"restaurant_shifts\")\n}\n\n/// A break is opened and closed with server timestamps. The database permits at\n/// most one open break per shift; corrections are separate immutable adjustments.\nmodel RestaurantShiftBreak {\n  id             String    @id @default(cuid())\n  organizationId String    @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  shiftId        String\n  startedAt      DateTime  @default(now())\n  endedAt        DateTime?\n  createdAt      DateTime  @default(now())\n  updatedAt      DateTime  @updatedAt\n\n  shift       RestaurantShift              @relation(fields: [shiftId], references: [id], onDelete: Cascade)\n  adjustments RestaurantTimeAdjustment[]\n  commands    RestaurantWorkforceCommand[]\n\n  @@index([organizationId])\n  @@index([shiftId, startedAt])\n  @@map(\"restaurant_shift_breaks\")\n}\n\n/// The employee-authored request is immutable. A manager appends exactly one\n/// decision instead of rewriting request history.\nmodel RestaurantShiftSwapRequest {\n  id                        String   @id @default(cuid())\n  organizationId            String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  shiftId                   String\n  requestedByStaffProfileId String\n  replacementStaffProfileId String\n  note                      String?\n  createdAt                 DateTime @default(now())\n\n  shift       RestaurantShift              @relation(fields: [shiftId], references: [id], onDelete: Cascade)\n  requestedBy RestaurantStaffProfile       @relation(\"ShiftSwapRequester\", fields: [requestedByStaffProfileId], references: [id], onDelete: Restrict)\n  replacement RestaurantStaffProfile       @relation(\"ShiftSwapReplacement\", fields: [replacementStaffProfileId], references: [id], onDelete: Restrict)\n  decision    RestaurantShiftSwapDecision?\n  commands    RestaurantWorkforceCommand[]\n\n  @@index([organizationId])\n  @@index([shiftId, createdAt])\n  @@index([requestedByStaffProfileId, createdAt])\n  @@map(\"restaurant_shift_swap_requests\")\n}\n\nmodel RestaurantShiftSwapDecision {\n  id                      String                          @id @default(cuid())\n  organizationId          String                          @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  requestId               String                          @unique\n  decision                RestaurantShiftSwapDecisionKind\n  decidedByUserId         String\n  decidedByStaffProfileId String?\n  reason                  String?\n  decidedAt               DateTime                        @default(now())\n\n  request RestaurantShiftSwapRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)\n\n  @@index([organizationId])\n  @@index([decidedAt])\n  @@map(\"restaurant_shift_swap_decisions\")\n}\n\n/// Immutable transition trail for published roster changes and swap decisions.\nmodel RestaurantShiftEvent {\n  id                 String                   @id @default(cuid())\n  organizationId     String                   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  shiftId            String\n  kind               RestaurantShiftEventKind\n  actorUserId        String\n  fromStaffProfileId String?\n  toStaffProfileId   String?\n  reason             String?\n  occurredAt         DateTime                 @default(now())\n\n  shift RestaurantShift @relation(fields: [shiftId], references: [id], onDelete: Restrict)\n\n  @@index([organizationId])\n  @@index([shiftId, occurredAt])\n  @@map(\"restaurant_shift_events\")\n}\n\n/// A manager correction never rewrites the original server timestamp. Reads\n/// apply the latest append-only adjustment and retain both values and a reason.\nmodel RestaurantTimeAdjustment {\n  id                       String                       @id @default(cuid())\n  organizationId           String                       @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  shiftId                  String\n  breakId                  String?\n  kind                     RestaurantTimeAdjustmentKind\n  originalAt               DateTime\n  correctedAt              DateTime\n  reason                   String\n  adjustedByUserId         String\n  adjustedByStaffProfileId String?\n  createdAt                DateTime                     @default(now())\n\n  shift RestaurantShift       @relation(fields: [shiftId], references: [id], onDelete: Restrict)\n  break RestaurantShiftBreak? @relation(fields: [breakId], references: [id], onDelete: Restrict)\n\n  @@index([organizationId])\n  @@index([shiftId, kind, createdAt])\n  @@index([breakId, kind, createdAt])\n  @@map(\"restaurant_time_adjustments\")\n}\n\n/// Command receipts make employee punches and swap decisions retry-safe. They\n/// are immutable and tenant-scoped; the idempotency key is never a source of truth.\nmodel RestaurantWorkforceCommand {\n  id             String                         @id @default(cuid())\n  organizationId String                         @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  idempotencyKey String\n  kind           RestaurantWorkforceCommandKind\n  shiftId        String\n  breakId        String?\n  swapRequestId  String?\n  createdAt      DateTime                       @default(now())\n\n  shift       RestaurantShift             @relation(fields: [shiftId], references: [id], onDelete: Restrict)\n  break       RestaurantShiftBreak?       @relation(fields: [breakId], references: [id], onDelete: Restrict)\n  swapRequest RestaurantShiftSwapRequest? @relation(fields: [swapRequestId], references: [id], onDelete: Restrict)\n\n  @@unique([organizationId, idempotencyKey])\n  @@index([shiftId, createdAt])\n  @@map(\"restaurant_workforce_commands\")\n}\n\nmodel PlatformUser {\n  id                  String       @id @default(cuid())\n  name                String\n  email               String       @unique\n  passwordHash        String\n  role                PlatformRole @default(AUDITOR)\n  active              Boolean      @default(true)\n  mfaRequired         Boolean      @default(false)\n  encryptedTotpSecret String?\n  mfaEnabledAt        DateTime?\n  lastLoginAt         DateTime?\n  createdAt           DateTime     @default(now())\n  updatedAt           DateTime     @updatedAt\n\n  sessions                             PlatformSession[]\n  recoveryCodes                        PlatformRecoveryCode[]\n  restaurantActivationAcknowledgements RestaurantActivationAcknowledgement[]\n\n  @@index([role, active])\n  @@map(\"platform_users\")\n}\n\nmodel PlatformRecoveryCode {\n  id             String    @id @default(cuid())\n  platformUserId String\n  codeHash       String\n  usedAt         DateTime?\n  createdAt      DateTime  @default(now())\n\n  platformUser PlatformUser @relation(fields: [platformUserId], references: [id], onDelete: Cascade)\n\n  @@unique([platformUserId, codeHash])\n  @@index([platformUserId, usedAt])\n  @@map(\"platform_recovery_codes\")\n}\n\nmodel PlatformSession {\n  id             String    @id @default(cuid())\n  platformUserId String\n  tokenHash      String    @unique\n  expiresAt      DateTime\n  revokedAt      DateTime?\n  ip             String?\n  userAgent      String?\n  createdAt      DateTime  @default(now())\n  lastSeenAt     DateTime  @default(now())\n\n  platformUser PlatformUser @relation(fields: [platformUserId], references: [id], onDelete: Cascade)\n\n  @@index([platformUserId, expiresAt])\n  @@index([expiresAt, revokedAt])\n  @@map(\"platform_sessions\")\n}\n\n/// D8 \\u2014 a pending shared-host login, between \"the password is proven\" and\n/// \"an organization has been chosen\".\n///\n/// Control plane, not tenant scope: the row deliberately SPANS organizations\n/// before one is chosen, so there is no single \\`organizationId\\` for a tenant RLS\n/// policy to compare against. It carries no tenant business data \\u2014 only the\n/// candidate set the server itself computed \\u2014 and is written and read solely by\n/// the authentication path in the explicitly privileged platform scope.\n///\n/// Modelled on \\`TenantSsoTicket\\`: 32 random bytes stored only as a SHA-256 hash,\n/// short TTL, single use via a conditional update. \\`candidates\\` holds the\n/// server-computed \\`{ organizationId, userId }\\` set; a submitted organization id\n/// is authority only if it is a member of THAT set.\nmodel PendingLoginIntent {\n  id         String    @id @default(cuid())\n  tokenHash  String    @unique\n  email      String\n  /// The host the intent was minted on. Consumption on any other host is refused,\n  /// so an intent cannot be replayed across the shared, tenant, or admin hosts.\n  host       String\n  /// [{ organizationId, userId }] \\u2014 the eligible organizations, server-computed.\n  candidates Json\n  expiresAt  DateTime\n  usedAt     DateTime?\n  ip         String?\n  userAgent  String?\n  createdAt  DateTime  @default(now())\n\n  @@index([expiresAt, usedAt])\n  @@map(\"pending_login_intents\")\n}\n\nmodel PlatformSetting {\n  id          String   @id @default(cuid())\n  key         String   @unique\n  category    String\n  value       Json\n  description String?\n  sensitive   Boolean  @default(false)\n  updatedById String?\n  createdAt   DateTime @default(now())\n  updatedAt   DateTime @updatedAt\n\n  @@index([category])\n  @@map(\"platform_settings\")\n}\n\nmodel PlatformModule {\n  id          String                @id @default(cuid())\n  key         String                @unique\n  name        String\n  description String?\n  category    String\n  band        PlatformModuleBand\n  vertical    OrganizationVertical?\n  routePrefix String?\n  icon        String?\n  active      Boolean               @default(true)\n  sortOrder   Int                   @default(0)\n  createdAt   DateTime              @default(now())\n  updatedAt   DateTime              @updatedAt\n\n  packageLinks  PlatformPackageModule[]\n  organizations OrganizationModule[]\n  contracts     PlatformContractModule[]\n\n  @@index([band, vertical, active])\n  @@index([category, active])\n  @@map(\"platform_modules\")\n}\n\nmodel PlatformPackage {\n  id           String               @id @default(cuid())\n  key          String               @unique\n  name         String\n  description  String?\n  // \\xA72.3: package stamping. Onboarding shows only packages whose vertical matches\n  // the organization type, and the server rejects a mismatched package even if the\n  // UI is bypassed. Existing packages migrate to AGENCY.\n  vertical     OrganizationVertical @default(AGENCY)\n  version      Int                  @default(1)\n  active       Boolean              @default(true)\n  defaultSeats Int                  @default(1)\n  createdAt    DateTime             @default(now())\n  updatedAt    DateTime             @updatedAt\n\n  moduleLinks   PlatformPackageModule[]\n  organizations Organization[]\n\n  @@index([active])\n  @@map(\"platform_packages\")\n}\n\nmodel PlatformPackageModule {\n  id        String  @id @default(cuid())\n  packageId String\n  moduleId  String\n  enabled   Boolean @default(true)\n  limits    Json?\n\n  package PlatformPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)\n  module  PlatformModule  @relation(fields: [moduleId], references: [id], onDelete: Cascade)\n\n  @@unique([packageId, moduleId])\n  @@index([moduleId])\n  @@map(\"platform_package_modules\")\n}\n\nmodel OrganizationModule {\n  id             String                   @id @default(cuid())\n  organizationId String                   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  moduleId       String\n  status         OrganizationModuleStatus @default(ENABLED)\n  seatLimit      Int?\n  startsAt       DateTime                 @default(now())\n  expiresAt      DateTime?\n  overrides      Json?\n  reason         String?\n  changedById    String?\n  createdAt      DateTime                 @default(now())\n  updatedAt      DateTime                 @updatedAt\n\n  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)\n  module       PlatformModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)\n\n  @@unique([organizationId, moduleId])\n  @@index([organizationId, status])\n  @@index([moduleId])\n  @@map(\"organization_modules\")\n}\n\nmodel OrganizationLimit {\n  id             String    @id @default(cuid())\n  organizationId String    @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  key            String\n  value          Int\n  period         String?\n  source         String    @default(\"CONTRACT\")\n  expiresAt      DateTime?\n  createdAt      DateTime  @default(now())\n  updatedAt      DateTime  @updatedAt\n\n  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)\n\n  @@unique([organizationId, key])\n  @@index([organizationId])\n  @@map(\"organization_limits\")\n}\n\nmodel OrganizationUsageCounter {\n  id             String   @id @default(cuid())\n  organizationId String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  key            String\n  periodStart    DateTime\n  periodEnd      DateTime\n  value          BigInt   @default(0)\n  updatedAt      DateTime @updatedAt\n\n  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)\n\n  @@unique([organizationId, key, periodStart, periodEnd])\n  @@index([organizationId, key])\n  @@map(\"organization_usage_counters\")\n}\n\nmodel OrganizationRole {\n  id             String   @id @default(cuid())\n  organizationId String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  key            String\n  name           String\n  description    String?\n  isSystem       Boolean  @default(false)\n  createdAt      DateTime @default(now())\n  updatedAt      DateTime @updatedAt\n\n  organization Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)\n  permissions  OrganizationRolePermission[]\n  users        User[]\n\n  @@unique([organizationId, key])\n  @@index([organizationId])\n  @@map(\"organization_roles\")\n}\n\nmodel OrganizationDepartment {\n  id             String   @id @default(cuid())\n  organizationId String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  key            String\n  name           String\n  active         Boolean  @default(true)\n  sortOrder      Int      @default(0)\n  createdAt      DateTime @default(now())\n  updatedAt      DateTime @updatedAt\n\n  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)\n  users        User[]\n\n  @@unique([organizationId, key])\n  @@unique([organizationId, name])\n  @@index([organizationId, active, sortOrder])\n  @@map(\"organization_departments\")\n}\n\nmodel OrganizationRolePermission {\n  id                 String           @id @default(cuid())\n  organizationId     String           @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  organizationRoleId String\n  capability         String\n  effect             PermissionEffect @default(ALLOW)\n  createdAt          DateTime         @default(now())\n\n  role OrganizationRole @relation(fields: [organizationRoleId], references: [id], onDelete: Cascade)\n\n  @@unique([organizationRoleId, capability])\n  @@index([organizationId])\n  @@map(\"organization_role_permissions\")\n}\n\nmodel UserPermissionOverride {\n  id             String           @id @default(cuid())\n  organizationId String           @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  userId         String\n  capability     String\n  effect         PermissionEffect\n  reason         String\n  expiresAt      DateTime?\n  createdById    String?\n  createdAt      DateTime         @default(now())\n  updatedAt      DateTime         @updatedAt\n\n  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)\n  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)\n\n  @@unique([userId, capability])\n  @@index([organizationId])\n  @@map(\"user_permission_overrides\")\n}\n\nmodel PlatformAccount {\n  id             String   @id @default(cuid())\n  organizationId String?\n  name           String\n  legalName      String?\n  website        String?\n  industry       String?\n  country        String?\n  ownerId        String?\n  status         String   @default(\"PROSPECT\")\n  source         String?\n  notes          String?\n  createdAt      DateTime @default(now())\n  updatedAt      DateTime @updatedAt\n\n  organization  Organization?         @relation(fields: [organizationId], references: [id], onDelete: SetNull)\n  contacts      PlatformContact[]\n  leads         PlatformLead[]\n  opportunities PlatformOpportunity[]\n  followUps     PlatformFollowUp[]\n\n  @@index([organizationId])\n  @@index([status])\n  @@map(\"platform_accounts\")\n}\n\nmodel PlatformLead {\n  id          String     @id @default(cuid())\n  accountId   String?\n  name        String\n  email       String?\n  phone       String?\n  companyName String?\n  status      LeadStatus @default(NEW)\n  source      String?\n  ownerId     String?\n  notes       String?\n  convertedAt DateTime?\n  createdAt   DateTime   @default(now())\n  updatedAt   DateTime   @updatedAt\n\n  account   PlatformAccount?   @relation(fields: [accountId], references: [id], onDelete: SetNull)\n  followUps PlatformFollowUp[]\n\n  @@index([status, createdAt])\n  @@index([accountId])\n  @@map(\"platform_leads\")\n}\n\nmodel PlatformContact {\n  id        String   @id @default(cuid())\n  accountId String\n  name      String\n  email     String?\n  phone     String?\n  title     String?\n  isPrimary Boolean  @default(false)\n  createdAt DateTime @default(now())\n  updatedAt DateTime @updatedAt\n\n  account PlatformAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)\n\n  @@index([accountId])\n  @@map(\"platform_contacts\")\n}\n\nmodel PlatformOpportunity {\n  id                      String           @id @default(cuid())\n  accountId               String\n  convertedOrganizationId String?\n  name                    String\n  stage                   OpportunityStage @default(DISCOVERY)\n  estimatedValue          Decimal?         @db.Decimal(14, 2)\n  currency                String           @default(\"USD\")\n  probability             Int              @default(10)\n  ownerId                 String?\n  expectedCloseAt         DateTime?\n  wonAt                   DateTime?\n  lostAt                  DateTime?\n  lossReason              String?\n  notes                   String?\n  createdAt               DateTime         @default(now())\n  updatedAt               DateTime         @updatedAt\n\n  account               PlatformAccount                 @relation(fields: [accountId], references: [id], onDelete: Cascade)\n  convertedOrganization Organization?                   @relation(fields: [convertedOrganizationId], references: [id], onDelete: SetNull)\n  stageEvents           PlatformOpportunityStageEvent[]\n  proposals             PlatformProposal[]\n  followUps             PlatformFollowUp[]\n  contracts             PlatformContract[]\n\n  @@index([accountId, stage])\n  @@index([convertedOrganizationId])\n  @@index([expectedCloseAt])\n  @@map(\"platform_opportunities\")\n}\n\nmodel PlatformOpportunityStageEvent {\n  id            String            @id @default(cuid())\n  opportunityId String\n  fromStage     OpportunityStage?\n  toStage       OpportunityStage\n  reason        String?\n  changedById   String?\n  createdAt     DateTime          @default(now())\n\n  opportunity PlatformOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)\n\n  @@index([opportunityId, createdAt])\n  @@map(\"platform_opportunity_stage_events\")\n}\n\nmodel PlatformProposal {\n  id            String         @id @default(cuid())\n  opportunityId String\n  number        String         @unique\n  title         String\n  status        ProposalStatus @default(DRAFT)\n  currency      String         @default(\"USD\")\n  total         Decimal        @db.Decimal(14, 2)\n  lineItems     Json\n  validUntil    DateTime?\n  fileUrl       String?\n  sentAt        DateTime?\n  acceptedAt    DateTime?\n  createdById   String?\n  createdAt     DateTime       @default(now())\n  updatedAt     DateTime       @updatedAt\n\n  opportunity PlatformOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)\n\n  @@index([opportunityId, status])\n  @@map(\"platform_proposals\")\n}\n\nmodel PlatformFollowUp {\n  id            String         @id @default(cuid())\n  accountId     String?\n  leadId        String?\n  opportunityId String?\n  ownerId       String?\n  title         String\n  notes         String?\n  dueAt         DateTime\n  status        FollowUpStatus @default(OPEN)\n  completedAt   DateTime?\n  createdAt     DateTime       @default(now())\n  updatedAt     DateTime       @updatedAt\n\n  account     PlatformAccount?     @relation(fields: [accountId], references: [id], onDelete: Cascade)\n  lead        PlatformLead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)\n  opportunity PlatformOpportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)\n\n  @@index([ownerId, status, dueAt])\n  @@index([accountId])\n  @@index([leadId])\n  @@index([opportunityId])\n  @@map(\"platform_follow_ups\")\n}\n\nmodel PlatformContract {\n  id              String                   @id @default(cuid())\n  organizationId  String\n  opportunityId   String?\n  number          String                   @unique\n  title           String\n  status          CommercialContractStatus @default(DRAFT)\n  currency        String                   @default(\"USD\")\n  value           Decimal                  @db.Decimal(14, 2)\n  billingInterval BillingInterval          @default(ANNUAL)\n  seatLimit       Int                      @default(1)\n  startDate       DateTime\n  endDate         DateTime\n  graceUntil      DateTime?\n  autoRenew       Boolean                  @default(false)\n  signedAt        DateTime?\n  ownerId         String?\n  notes           String?\n  createdAt       DateTime                 @default(now())\n  updatedAt       DateTime                 @updatedAt\n\n  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)\n  opportunity  PlatformOpportunity?     @relation(fields: [opportunityId], references: [id], onDelete: SetNull)\n  modules      PlatformContractModule[]\n  invoices     PlatformInvoice[]\n  renewals     PlatformRenewal[]\n\n  @@index([organizationId, status])\n  @@index([endDate])\n  @@map(\"platform_contracts\")\n}\n\nmodel PlatformContractModule {\n  id         String @id @default(cuid())\n  contractId String\n  moduleId   String\n  seatLimit  Int?\n  limits     Json?\n\n  contract PlatformContract @relation(fields: [contractId], references: [id], onDelete: Cascade)\n  module   PlatformModule   @relation(fields: [moduleId], references: [id], onDelete: Restrict)\n\n  @@unique([contractId, moduleId])\n  @@index([moduleId])\n  @@map(\"platform_contract_modules\")\n}\n\nmodel PlatformInvoice {\n  id             String                @id @default(cuid())\n  organizationId String\n  contractId     String?\n  number         String                @unique\n  status         PlatformInvoiceStatus @default(DRAFT)\n  currency       String                @default(\"USD\")\n  subtotal       Decimal               @db.Decimal(14, 2)\n  tax            Decimal               @default(0) @db.Decimal(14, 2)\n  total          Decimal               @db.Decimal(14, 2)\n  lineItems      Json\n  issuedAt       DateTime?\n  dueAt          DateTime\n  paidAt         DateTime?\n  notes          String?\n  createdAt      DateTime              @default(now())\n  updatedAt      DateTime              @updatedAt\n\n  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)\n  contract     PlatformContract? @relation(fields: [contractId], references: [id], onDelete: SetNull)\n  payments     PlatformPayment[]\n\n  @@index([organizationId, status])\n  @@index([contractId])\n  @@index([dueAt])\n  @@map(\"platform_invoices\")\n}\n\nmodel PlatformPayment {\n  id             String                @id @default(cuid())\n  organizationId String\n  invoiceId      String\n  status         PlatformPaymentStatus @default(PENDING)\n  amount         Decimal               @db.Decimal(14, 2)\n  currency       String                @default(\"USD\")\n  method         String?\n  externalRef    String?\n  idempotencyKey String?               @unique\n  paidAt         DateTime?\n  failureReason  String?\n  createdAt      DateTime              @default(now())\n  updatedAt      DateTime              @updatedAt\n\n  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)\n  invoice      PlatformInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)\n\n  @@index([organizationId, status])\n  @@index([invoiceId])\n  @@map(\"platform_payments\")\n}\n\nmodel PlatformRenewal {\n  id             String        @id @default(cuid())\n  organizationId String\n  contractId     String\n  status         RenewalStatus @default(UPCOMING)\n  dueAt          DateTime\n  ownerId        String?\n  proposedValue  Decimal?      @db.Decimal(14, 2)\n  proposedSeats  Int?\n  notes          String?\n  completedAt    DateTime?\n  createdAt      DateTime      @default(now())\n  updatedAt      DateTime      @updatedAt\n\n  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)\n  contract     PlatformContract @relation(fields: [contractId], references: [id], onDelete: Cascade)\n\n  @@index([organizationId, status])\n  @@index([dueAt])\n  @@map(\"platform_renewals\")\n}\n\nmodel OrganizationBrand {\n  id             String   @id @default(cuid())\n  organizationId String   @unique\n  logoUrl        String?\n  markUrl        String?\n  primaryColor   String   @default(\"#111110\")\n  accentColor    String   @default(\"#FF684F\")\n  supportEmail   String?\n  fromName       String?\n  faviconUrl     String?\n  tokens         Json?\n  customCss      String?\n  updatedById    String?\n  createdAt      DateTime @default(now())\n  updatedAt      DateTime @updatedAt\n\n  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)\n\n  @@map(\"organization_brands\")\n}\n\nmodel OrganizationEmailSettings {\n  id               String    @id @default(cuid())\n  organizationId   String    @unique\n  provider         String    @default(\"PLATFORM\")\n  fromName         String?\n  fromAddress      String?\n  replyTo          String?\n  encryptedApiKey  String?\n  domainVerifiedAt DateTime?\n  configuration    Json?\n  createdAt        DateTime  @default(now())\n  updatedAt        DateTime  @updatedAt\n\n  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)\n\n  @@map(\"organization_email_settings\")\n}\n\nmodel OrganizationDomain {\n  id                 String                   @id @default(cuid())\n  organizationId     String\n  host               String                   @unique\n  kind               String                   @default(\"APP\")\n  verificationStatus DomainVerificationStatus @default(PENDING)\n  verificationToken  String                   @unique\n  isPrimary          Boolean                  @default(false)\n  verifiedAt         DateTime?\n  lastCheckedAt      DateTime?\n  failureReason      String?\n  createdAt          DateTime                 @default(now())\n  updatedAt          DateTime                 @updatedAt\n\n  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)\n\n  @@index([organizationId, verificationStatus])\n  @@map(\"organization_domains\")\n}\n\nmodel OrganizationIdentityConnection {\n  id                    String                   @id @default(cuid())\n  organizationId        String\n  name                  String\n  protocol              IdentityProtocol\n  status                IdentityConnectionStatus @default(DRAFT)\n  issuer                String?\n  clientId              String?\n  encryptedClientSecret String?\n  discoveryUrl          String?\n  ssoUrl                String?\n  entityId              String?\n  certificate           String?\n  domains               String[]                 @default([])\n  allowJit              Boolean                  @default(true)\n  enforceSso            Boolean                  @default(false)\n  roleMappings          Json?\n  configuration         Json?\n  lastTestedAt          DateTime?\n  lastError             String?\n  createdAt             DateTime                 @default(now())\n  updatedAt             DateTime                 @updatedAt\n\n  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)\n  scimEvents   OrganizationScimEvent[]\n  ssoStates    OrganizationSsoState[]\n\n  @@index([organizationId, status])\n  @@map(\"organization_identity_connections\")\n}\n\nmodel OrganizationSsoState {\n  id                   String    @id @default(cuid())\n  organizationId       String    @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  identityConnectionId String\n  key                  String    @unique\n  kind                 String\n  payload              Json\n  expiresAt            DateTime\n  usedAt               DateTime?\n  createdAt            DateTime  @default(now())\n\n  organization       Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)\n  identityConnection OrganizationIdentityConnection @relation(fields: [identityConnectionId], references: [id], onDelete: Cascade)\n\n  @@index([organizationId, expiresAt])\n  @@index([identityConnectionId, expiresAt])\n  @@map(\"organization_sso_states\")\n}\n\nmodel TenantSsoTicket {\n  id             String    @id @default(cuid())\n  organizationId String    @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  userId         String\n  tokenHash      String    @unique\n  expiresAt      DateTime\n  usedAt         DateTime?\n  createdAt      DateTime  @default(now())\n\n  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)\n  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)\n\n  @@index([organizationId, expiresAt])\n  @@index([userId, expiresAt])\n  @@map(\"tenant_sso_tickets\")\n}\n\nmodel OrganizationScimToken {\n  id             String    @id @default(cuid())\n  organizationId String\n  name           String\n  prefix         String\n  tokenHash      String    @unique\n  expiresAt      DateTime?\n  lastUsedAt     DateTime?\n  revokedAt      DateTime?\n  createdAt      DateTime  @default(now())\n\n  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)\n\n  @@index([organizationId])\n  @@index([prefix])\n  @@map(\"organization_scim_tokens\")\n}\n\nmodel OrganizationScimEvent {\n  id                   String   @id @default(cuid())\n  organizationId       String\n  identityConnectionId String?\n  externalId           String?\n  idempotencyKey       String?  @unique\n  operation            String\n  resourceType         String\n  status               String\n  payload              Json?\n  error                String?\n  createdAt            DateTime @default(now())\n\n  organization       Organization                    @relation(fields: [organizationId], references: [id], onDelete: Cascade)\n  identityConnection OrganizationIdentityConnection? @relation(fields: [identityConnectionId], references: [id], onDelete: SetNull)\n\n  @@index([organizationId, createdAt])\n  @@index([externalId])\n  @@map(\"organization_scim_events\")\n}\n\nmodel OrganizationDeployment {\n  id             String                     @id @default(cuid())\n  organizationId String\n  environment    String                     @default(\"production\")\n  mode           OrganizationDeploymentMode\n  status         DeploymentStatus           @default(PENDING)\n  provider       String                     @default(\"VERCEL\")\n  projectId      String?\n  region         String?\n  url            String?\n  databaseRef    String?\n  edgeConfigRef  String?\n  version        String?\n  health         Json?\n  lastHealthyAt  DateTime?\n  createdAt      DateTime                   @default(now())\n  updatedAt      DateTime                   @updatedAt\n\n  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)\n\n  @@unique([organizationId, environment])\n  @@index([status])\n  @@map(\"organization_deployments\")\n}\n\nmodel PlatformJob {\n  id             String            @id @default(cuid())\n  organizationId String?\n  type           PlatformJobType\n  status         PlatformJobStatus @default(QUEUED)\n  payload        Json?\n  result         Json?\n  error          String?\n  attempts       Int               @default(0)\n  maxAttempts    Int               @default(3)\n  idempotencyKey String?           @unique\n  requestedById  String?\n  scheduledAt    DateTime          @default(now())\n  startedAt      DateTime?\n  finishedAt     DateTime?\n  createdAt      DateTime          @default(now())\n  updatedAt      DateTime          @updatedAt\n\n  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)\n\n  @@index([status, scheduledAt])\n  @@index([organizationId])\n  @@map(\"platform_jobs\")\n}\n\nmodel OrganizationLifecycleEvent {\n  id             String              @id @default(cuid())\n  organizationId String\n  action         LifecycleAction\n  fromStatus     OrganizationStatus?\n  toStatus       OrganizationStatus\n  reason         String\n  metadata       Json?\n  actorId        String?\n  createdAt      DateTime            @default(now())\n\n  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)\n\n  @@index([organizationId, createdAt])\n  @@map(\"organization_lifecycle_events\")\n}\n\nmodel PlatformSupportSession {\n  id              String               @id @default(cuid())\n  organizationId  String\n  platformUserId  String\n  tenantUserId    String?\n  tokenHash       String               @unique\n  tokenCiphertext String?              @db.Text\n  launchTokenHash String?              @unique\n  launchUsedAt    DateTime?\n  reason          String\n  status          SupportSessionStatus @default(ACTIVE)\n  expiresAt       DateTime\n  endedAt         DateTime?\n  createdAt       DateTime             @default(now())\n\n  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)\n\n  @@index([organizationId, status])\n  @@index([platformUserId, status])\n  @@map(\"platform_support_sessions\")\n}\n\nmodel PlatformAuditLog {\n  id                  String   @id @default(cuid())\n  organizationId      String?\n  actorPlatformUserId String?\n  actorTenantUserId   String?\n  action              String\n  targetType          String?\n  targetId            String?\n  before              Json?\n  after               Json?\n  metadata            Json?\n  requestId           String?\n  reason              String?\n  success             Boolean  @default(true)\n  error               String?\n  ip                  String?\n  userAgent           String?\n  createdAt           DateTime @default(now())\n\n  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)\n\n  @@index([organizationId, createdAt])\n  @@index([actorPlatformUserId, createdAt])\n  @@index([action, createdAt])\n  @@index([requestId])\n  @@map(\"platform_audit_logs\")\n}\n\n// ============================================\n// PH-MIG \\u2014 pharmacy migration (PRD \\xA76.10 MIG-01, MIG-02)\n// ============================================\n\nenum PharmacyMigrationSourceKind {\n  ABUZAR\n  EXCEL_CSV\n}\n\nenum PharmacyMigrationBatchStatus {\n  PROFILING\n  PROFILED\n  FAILED\n}\n\nenum PharmacyMigrationExceptionBucket {\n  MISSING_BATCH\n  MISSING_EXPIRY\n  MISSING_MRP\n  UNIT_AMBIGUOUS\n  DUPLICATE_PRODUCT\n  PARTY_UNMATCHED\n  BALANCE_MISMATCH\n}\n\nenum PharmacyMigrationExceptionSeverity {\n  BLOCKING\n  WARNING\n}\n\nenum PharmacyMigrationExceptionStatus {\n  OPEN\n  SIGNED_OFF\n}\n\n/// MIG-01 \\u2014 immutable evidence of one incumbent export. The file bytes are NOT\n/// stored; \\`contentHash\\` proves the profiled bytes are the handed-over bytes.\n/// A trigger and SELECT/INSERT-only policies both forbid UPDATE and DELETE.\nmodel PharmacyMigrationSource {\n  id             String                      @id @default(cuid())\n  organizationId String                      @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  kind           PharmacyMigrationSourceKind\n  fileName       String\n  byteSize       BigInt\n  contentHash    String\n  capturedAt     DateTime                    @default(now())\n  createdAt      DateTime                    @default(now())\n\n  batches PharmacyMigrationBatch[]\n\n  @@unique([organizationId, id])\n  @@unique([organizationId, contentHash])\n  @@index([organizationId, kind, capturedAt])\n  @@map(\"pharmacy_migration_sources\")\n}\n\n/// One profiling pass over a source. Re-profiling creates a NEW batch; rows are\n/// never edited in place.\nmodel PharmacyMigrationBatch {\n  id              String                       @id @default(cuid())\n  organizationId  String                       @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  sourceId        String\n  label           String\n  status          PharmacyMigrationBatchStatus @default(PROFILING)\n  rowCount        Int                          @default(0)\n  exceptionCount  Int                          @default(0)\n  profilerVersion String\n  profiledAt      DateTime?\n  createdAt       DateTime                     @default(now())\n  updatedAt       DateTime                     @updatedAt\n\n  source     PharmacyMigrationSource      @relation(fields: [organizationId, sourceId], references: [organizationId, id], onDelete: Restrict)\n  rows       PharmacyMigrationRow[]\n  exceptions PharmacyMigrationException[]\n\n  @@unique([organizationId, id])\n  @@index([organizationId, sourceId, status])\n  @@map(\"pharmacy_migration_batches\")\n}\n\n/// MIG-01 \\u2014 every imported row keeps its incumbent source key and its import\n/// batch. Every parsed column is nullable and has NO default: a value the\n/// incumbent did not supply stays missing and raises an exception instead.\nmodel PharmacyMigrationRow {\n  id                String    @id @default(cuid())\n  organizationId    String    @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  batchId           String\n  sourceKey         String\n  rowNumber         Int\n  rawPayload        Json\n  targetModelKey    String\n  targetNaturalKey  String?\n  productName       String?\n  packLabel         String?\n  packFactor        BigInt?\n  barcode           String?\n  batchNumber       String?\n  expiryDate        DateTime? @db.Date\n  mrpMinor          BigInt?\n  costMinor         BigInt?\n  quantityCanonical BigInt?\n  supplierName      String?\n  customerName      String?\n  balanceMinor      BigInt?\n  createdAt         DateTime  @default(now())\n\n  batch      PharmacyMigrationBatch       @relation(fields: [organizationId, batchId], references: [organizationId, id], onDelete: Restrict)\n  exceptions PharmacyMigrationException[]\n\n  @@unique([organizationId, id])\n  @@unique([organizationId, batchId, sourceKey])\n  @@index([organizationId, batchId, targetModelKey])\n  @@index([organizationId, targetModelKey, targetNaturalKey])\n  @@map(\"pharmacy_migration_rows\")\n}\n\n/// MIG-02 \\u2014 the exception workbench. Identity is immutable and sign-off is\n/// one-way, both DB-enforced. \\`signedOffByUserId\\` carries a composite tenant\n/// foreign key onto \\`users\\` declared in the migration, matching the existing\n/// SQL-only composite tenant foreign keys elsewhere in this schema.\nmodel PharmacyMigrationException {\n  id                String                             @id @default(cuid())\n  organizationId    String                             @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  batchId           String\n  rowId             String?\n  bucket            PharmacyMigrationExceptionBucket\n  severity          PharmacyMigrationExceptionSeverity\n  status            PharmacyMigrationExceptionStatus   @default(OPEN)\n  detail            String\n  signedOffByUserId String?\n  signedOffAt       DateTime?\n  signOffNote       String?\n  createdAt         DateTime                           @default(now())\n  updatedAt         DateTime                           @updatedAt\n\n  batch PharmacyMigrationBatch @relation(fields: [organizationId, batchId], references: [organizationId, id], onDelete: Restrict)\n  row   PharmacyMigrationRow?  @relation(fields: [organizationId, rowId], references: [organizationId, id], onDelete: Restrict)\n\n  @@index([organizationId, batchId, bucket])\n  @@index([organizationId, batchId, status, severity])\n  @@index([organizationId, rowId])\n  @@map(\"pharmacy_migration_exceptions\")\n}\n\n// ============================================\n// PH-PUR \\u2014 pharmacy procurement (PRD \\xA76.3 PUR-01, PUR-02, PUR-03)\n// ============================================\n\nenum PharmacyRequisitionStatus {\n  DRAFT\n  SUBMITTED\n  APPROVED\n  CANCELLED\n}\n\n/// PUR-02: DRAFT \\u2192 SUBMITTED \\u2192 APPROVED \\u2192 SENT \\u2192 RECEIVING. RECEIVING is the\n/// hand-off point; the receipt itself belongs to the PH-INV ledger lane.\nenum PharmacyPurchaseOrderStatus {\n  DRAFT\n  SUBMITTED\n  APPROVED\n  SENT\n  RECEIVING\n  CANCELLED\n}\n\nenum PharmacyApprovalDecision {\n  APPROVED\n  REJECTED\n}\n\n/// PUR-02 receiving / PUR-04. DRAFT \\u2192 POSTED \\u2192 REVERSED, with cancellation\n/// available only while the receipt has posted nothing. A posted receipt is\n/// corrected by reversal, never by being moved back to DRAFT (\\xA78A invariant 8).\nenum PharmacyGoodsReceiptStatus {\n  DRAFT\n  POSTED\n  REVERSED\n  CANCELLED\n}\n\n/// PUR-04 \\u2014 the three-way match failures that become review exceptions.\nenum PharmacyReceivingExceptionKind {\n  SHORTAGE\n  OVERAGE\n  DAMAGE\n  PRICE_CONFLICT\n  PACK_CONFLICT\n}\n\nenum PharmacyReceivingExceptionStatus {\n  OPEN\n  RESOLVED\n}\n\n/// PUR-01 \\u2014 a licensed supplier or distributor. \\`authorized\\` is the operator's\n/// standing decision to trade; the licence evidence beneath decides whether\n/// that decision is currently usable. Both are checked before a PO is created\n/// and again before it is sent, because either can lapse in between.\nmodel PharmacySupplier {\n  id               String   @id @default(cuid())\n  organizationId   String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  name             String\n  legalName        String?\n  authorized       Boolean  @default(false)\n  /// Free-text districts/cities this distributor delivers to.\n  serviceArea      String?\n  contactName      String?\n  contactPhone     String?\n  /// Net payment terms in days; 0 is cash on delivery.\n  paymentTermsDays Int      @default(0)\n  creditLimitMinor Int      @default(0)\n  active           Boolean  @default(true)\n  createdAt        DateTime @default(now())\n  updatedAt        DateTime @updatedAt\n\n  licences        PharmacySupplierLicence[]\n  quotes          PharmacyQuote[]\n  purchaseOrders  PharmacyPurchaseOrder[]\n  goodsReceipts   PharmacyGoodsReceipt[]\n  purchaseReturns PharmacyPurchaseReturn[]\n  debitNotes      PharmacyDebitNote[]\n  credits         PharmacySupplierCredit[]\n  relationships   PharmacySupplierRelationship[]\n\n  @@unique([organizationId, id])\n  @@unique([organizationId, name])\n  @@index([organizationId, authorized, active])\n  @@map(\"pharmacy_suppliers\")\n}\n\n/// PUR-01 \\u2014 licence evidence. Append-only (trigger): a licence filing is a\n/// regulated record, so a correction supersedes rather than rewrites.\nmodel PharmacySupplierLicence {\n  id               String    @id @default(cuid())\n  organizationId   String    @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  supplierId       String\n  licenceType      String\n  licenceNumber    String\n  issuingAuthority String\n  issuedAt         DateTime\n  expiresAt        DateTime\n  /// Where the scanned licence lives; evidence, not the licence itself.\n  evidenceUri      String?\n  verifiedAt       DateTime?\n  verifiedByUserId String?\n  supersedesId     String?\n  createdAt        DateTime  @default(now())\n\n  supplier     PharmacySupplier          @relation(fields: [organizationId, supplierId], references: [organizationId, id], onDelete: Restrict)\n  supersedes   PharmacySupplierLicence?  @relation(\"SupplierLicenceVersions\", fields: [organizationId, supersedesId], references: [organizationId, id], onDelete: Restrict)\n  supersededBy PharmacySupplierLicence[] @relation(\"SupplierLicenceVersions\")\n\n  @@unique([organizationId, id])\n  @@index([organizationId, supplierId, expiresAt])\n  @@map(\"pharmacy_supplier_licences\")\n}\n\n/// PUR-02 \\u2014 the demand that starts the cycle. \\`branchId\\` is the branch-owned\n/// scope seam required by PLAT-04; the pharmacy branch entity itself lands with\n/// PLAT-03, so the column carries no foreign key yet and the tenant boundary\n/// remains \\`organizationId\\` under forced RLS.\nmodel PharmacyRequisition {\n  id                String                    @id @default(cuid())\n  organizationId    String                    @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId          String?\n  reference         String\n  status            PharmacyRequisitionStatus @default(DRAFT)\n  requestedByUserId String\n  neededBy          DateTime?\n  note              String?\n  submittedAt       DateTime?\n  approvedAt        DateTime?\n  approvedByUserId  String?\n  createdAt         DateTime                  @default(now())\n  updatedAt         DateTime                  @updatedAt\n\n  branch         PharmacyBranch?             @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)\n  lines          PharmacyRequisitionLine[]\n  quotes         PharmacyQuote[]\n  purchaseOrders PharmacyPurchaseOrder[]\n  signalActions  PharmacyStockSignalAction[]\n\n  @@unique([organizationId, id])\n  @@unique([organizationId, reference])\n  @@index([organizationId, status, createdAt])\n  @@index([organizationId, branchId, status], map: \"pharmacy_requisitions_org_branch_status_idx\")\n  @@map(\"pharmacy_requisitions\")\n}\n\nmodel PharmacyRequisitionLine {\n  id                    String   @id @default(cuid())\n  organizationId        String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  requisitionId         String\n  lineNumber            Int\n  medicineId            String\n  packLevelId           String\n  /// Demand is stated at a pack level and mirrored in integer canonical units.\n  quantityPacks         Int\n  canonicalUnitsPerPack Int\n  canonicalUnits        Int\n  note                  String?\n  createdAt             DateTime @default(now())\n\n  requisition PharmacyRequisition @relation(fields: [organizationId, requisitionId], references: [organizationId, id], onDelete: Restrict)\n  medicine    Medicine            @relation(fields: [medicineId], references: [id], onDelete: Restrict)\n  packLevel   PackLevel           @relation(fields: [packLevelId], references: [id], onDelete: Restrict)\n  quoteLines  PharmacyQuoteLine[]\n\n  @@unique([organizationId, id])\n  @@unique([organizationId, requisitionId, lineNumber])\n  @@index([organizationId, medicineId])\n  @@map(\"pharmacy_requisition_lines\")\n}\n\n/// PUR-02 \\u2014 one supplier's offer against one requisition. Quotes are compared\n/// and explained, never auto-awarded.\nmodel PharmacyQuote {\n  id             String   @id @default(cuid())\n  organizationId String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  requisitionId  String\n  supplierId     String\n  reference      String?\n  quotedAt       DateTime\n  validUntil     DateTime\n  note           String?\n  createdAt      DateTime @default(now())\n\n  requisition    PharmacyRequisition     @relation(fields: [organizationId, requisitionId], references: [organizationId, id], onDelete: Restrict)\n  supplier       PharmacySupplier        @relation(fields: [organizationId, supplierId], references: [organizationId, id], onDelete: Restrict)\n  lines          PharmacyQuoteLine[]\n  purchaseOrders PharmacyPurchaseOrder[]\n\n  @@unique([organizationId, id])\n  @@unique([organizationId, requisitionId, supplierId])\n  @@index([organizationId, supplierId, validUntil])\n  @@map(\"pharmacy_quotes\")\n}\n\nmodel PharmacyQuoteLine {\n  id                    String   @id @default(cuid())\n  organizationId        String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  quoteId               String\n  requisitionLineId     String\n  pricePerPackMinor     Int\n  /// Buy \\`schemeBuyPacks\\`, get \\`schemeFreePacks\\` free. Both zero = no scheme.\n  schemeBuyPacks        Int      @default(0)\n  schemeFreePacks       Int      @default(0)\n  discountBps           Int      @default(0)\n  moqPacks              Int      @default(1)\n  leadTimeDays          Int      @default(0)\n  /// Shortest remaining shelf life the supplier will ship, in days.\n  minimumExpiryDays     Int      @default(0)\n  canonicalUnitsPerPack Int\n  createdAt             DateTime @default(now())\n\n  quote           PharmacyQuote           @relation(fields: [organizationId, quoteId], references: [organizationId, id], onDelete: Restrict)\n  requisitionLine PharmacyRequisitionLine @relation(fields: [organizationId, requisitionLineId], references: [organizationId, id], onDelete: Restrict)\n\n  @@unique([organizationId, id])\n  @@unique([organizationId, quoteId, requisitionLineId])\n  @@map(\"pharmacy_quote_lines\")\n}\n\n/// PUR-02/PUR-03 \\u2014 the order itself. Batch, expiry and printed MRP are absent\n/// by design: they are unknown until the goods are received, and inventing them\n/// here would let unreceived stock look saleable.\nmodel PharmacyPurchaseOrder {\n  id                 String                      @id @default(cuid())\n  organizationId     String                      @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId           String?\n  reference          String\n  status             PharmacyPurchaseOrderStatus @default(DRAFT)\n  supplierId         String\n  requisitionId      String?\n  quoteId            String?\n  createdByUserId    String\n  expectedDeliveryAt DateTime?\n  freightMinor       Int                         @default(0)\n  otherChargesMinor  Int                         @default(0)\n  note               String?\n  submittedAt        DateTime?\n  approvedAt         DateTime?\n  approvedByUserId   String?\n  sentAt             DateTime?\n  createdAt          DateTime                    @default(now())\n  updatedAt          DateTime                    @updatedAt\n\n  goodsReceipts       PharmacyGoodsReceipt[]\n  supplier            PharmacySupplier                @relation(fields: [organizationId, supplierId], references: [organizationId, id], onDelete: Restrict)\n  requisition         PharmacyRequisition?            @relation(fields: [organizationId, requisitionId], references: [organizationId, id], onDelete: Restrict)\n  quote               PharmacyQuote?                  @relation(fields: [organizationId, quoteId], references: [organizationId, id], onDelete: Restrict)\n  branch              PharmacyBranch?                 @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)\n  lines               PharmacyPurchaseOrderLine[]\n  approvals           PharmacyPurchaseOrderApproval[]\n  supplierActionLinks PharmacySupplierActionLink[]\n\n  @@unique([organizationId, id])\n  @@unique([organizationId, reference])\n  @@index([organizationId, status, createdAt])\n  @@index([organizationId, supplierId, status])\n  @@index([organizationId, branchId, status], map: \"pharmacy_purchase_orders_org_branch_status_idx\")\n  @@map(\"pharmacy_purchase_orders\")\n}\n\n/// PUR-03 \\u2014 money terms in the order they are applied: list \\u2192 discount \\u2192\n/// rebate \\u2192 tax, with freight allocated at the order level. \\`bonusPacks\\` is a\n/// quantity term only and never appears in a money column, so scheme units\n/// lower the landed unit cost and can never create revenue.\nmodel PharmacyPurchaseOrderLine {\n  id                    String   @id @default(cuid())\n  organizationId        String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  purchaseOrderId       String\n  lineNumber            Int\n  medicineId            String\n  packLevelId           String\n  orderedPacks          Int\n  bonusPacks            Int      @default(0)\n  canonicalUnitsPerPack Int\n  orderedCanonicalUnits Int\n  bonusCanonicalUnits   Int      @default(0)\n  listPricePerPackMinor Int\n  discountBps           Int      @default(0)\n  rebateBps             Int      @default(0)\n  taxBps                Int      @default(0)\n  /// A creditable input tax is recovered and so is not stock cost.\n  taxCreditable         Boolean  @default(false)\n  createdAt             DateTime @default(now())\n\n  purchaseOrder       PharmacyPurchaseOrder        @relation(fields: [organizationId, purchaseOrderId], references: [organizationId, id], onDelete: Restrict)\n  medicine            Medicine                     @relation(fields: [medicineId], references: [id], onDelete: Restrict)\n  packLevel           PackLevel                    @relation(fields: [packLevelId], references: [id], onDelete: Restrict)\n  goodsReceiptLines   PharmacyGoodsReceiptLine[]\n  receivingExceptions PharmacyReceivingException[]\n\n  @@unique([organizationId, id])\n  @@unique([organizationId, purchaseOrderId, lineNumber])\n  @@index([organizationId, medicineId])\n  @@map(\"pharmacy_purchase_order_lines\")\n}\n\n/// PUR-02 \\u2014 the approval event. Append-only (trigger): who decided, under which\n/// policy, and between which two states. A rejection is recorded, not erased.\nmodel PharmacyPurchaseOrderApproval {\n  id              String                      @id @default(cuid())\n  organizationId  String                      @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  purchaseOrderId String\n  actorUserId     String\n  policy          String\n  decision        PharmacyApprovalDecision\n  fromStatus      PharmacyPurchaseOrderStatus\n  toStatus        PharmacyPurchaseOrderStatus\n  reason          String?\n  createdAt       DateTime                    @default(now())\n\n  purchaseOrder PharmacyPurchaseOrder @relation(fields: [organizationId, purchaseOrderId], references: [organizationId, id], onDelete: Restrict)\n\n  @@unique([organizationId, id])\n  @@index([organizationId, purchaseOrderId, createdAt])\n  @@map(\"pharmacy_purchase_order_approvals\")\n}\n\nenum PharmacySupplierSubmissionKind {\n  ACKNOWLEDGEMENT\n  REJECTION\n  PARTIAL_ACCEPTANCE\n  ETA\n  SUBSTITUTION_PROPOSAL\n  DOCUMENT\n}\n\nenum PharmacySupplierSubmissionSource {\n  SIGNED_LINK\n  PHONE\n  WHATSAPP\n}\n\n/// SUP-01/SUP-03 \\u2014 the active commercial relationship is the supplier's entire\n/// external authorization boundary. It is deliberately narrower than Supplier.\nmodel PharmacySupplierRelationship {\n  id                     String    @id @default(cuid())\n  organizationId         String    @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId               String\n  supplierId             String\n  active                 Boolean   @default(true)\n  createdAt              DateTime  @default(now())\n  revokedAt              DateTime?\n  /// AI-02: number of days before printed expiry when this supplier accepts an\n  /// expiry claim. Null means the relationship has no recorded return window.\n  expiryReturnWindowDays Int?\n\n  supplier PharmacySupplier             @relation(fields: [organizationId, supplierId], references: [organizationId, id], onDelete: Restrict)\n  links    PharmacySupplierActionLink[]\n\n  @@unique([organizationId, id])\n  @@unique([organizationId, branchId, supplierId])\n  @@index([organizationId, branchId, active])\n  @@map(\"pharmacy_supplier_relationships\")\n}\n\n/// Raw link secrets are never stored. A link grants access to exactly one\n/// relationship/PO pair and remains independently expirable and revocable.\nmodel PharmacySupplierActionLink {\n  id                     String    @id @default(cuid())\n  organizationId         String    @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId               String\n  supplierRelationshipId String\n  purchaseOrderId        String\n  tokenHash              String    @unique\n  expiresAt              DateTime\n  revokedAt              DateTime?\n  createdByUserId        String\n  createdAt              DateTime  @default(now())\n\n  relationship  PharmacySupplierRelationship @relation(fields: [organizationId, supplierRelationshipId], references: [organizationId, id], onDelete: Restrict)\n  purchaseOrder PharmacyPurchaseOrder        @relation(fields: [organizationId, purchaseOrderId], references: [organizationId, id], onDelete: Restrict)\n  submissions   PharmacySupplierSubmission[]\n\n  @@unique([organizationId, id])\n  @@unique([organizationId, supplierRelationshipId, purchaseOrderId])\n  @@index([organizationId, branchId, expiresAt])\n  @@map(\"pharmacy_supplier_action_links\")\n}\n\n/// Every inbound answer is append-only evidence/a proposal. Corrections link\n/// to the prior version; pharmacy approval is a separate event below.\nmodel PharmacySupplierSubmission {\n  id             String                           @id @default(cuid())\n  organizationId String                           @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId       String\n  actionLinkId   String\n  versionGroupId String\n  version        Int\n  supersedesId   String?\n  kind           PharmacySupplierSubmissionKind\n  source         PharmacySupplierSubmissionSource\n  idempotencyKey String\n  payload        Json\n  sourceEvidence String?\n  submittedAt    DateTime                         @default(now())\n\n  actionLink   PharmacySupplierActionLink           @relation(fields: [organizationId, actionLinkId], references: [organizationId, id], onDelete: Restrict)\n  supersedes   PharmacySupplierSubmission?          @relation(\"PharmacySupplierSubmissionVersions\", fields: [organizationId, supersedesId], references: [organizationId, id], onDelete: Restrict)\n  supersededBy PharmacySupplierSubmission[]         @relation(\"PharmacySupplierSubmissionVersions\")\n  documents    PharmacySupplierDocument[]\n  approvals    PharmacySupplierSubmissionApproval[]\n\n  @@unique([organizationId, id])\n  @@unique([organizationId, actionLinkId, idempotencyKey])\n  @@unique([organizationId, versionGroupId, version])\n  @@index([organizationId, branchId, submittedAt])\n  @@map(\"pharmacy_supplier_submissions\")\n}\n\nmodel PharmacySupplierDocument {\n  id             String   @id @default(cuid())\n  organizationId String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId       String\n  submissionId   String\n  fileName       String\n  mimeType       String\n  byteSize       Int\n  sha256         String\n  storageUri     String\n  scanMode       String\n  malwareChecked Boolean  @default(false)\n  createdAt      DateTime @default(now())\n\n  submission PharmacySupplierSubmission @relation(fields: [organizationId, submissionId], references: [organizationId, id], onDelete: Restrict)\n\n  @@unique([organizationId, id])\n  @@unique([organizationId, submissionId, sha256])\n  @@index([organizationId, branchId, createdAt])\n  @@map(\"pharmacy_supplier_documents\")\n}\n\nmodel PharmacySupplierSubmissionApproval {\n  id             String   @id @default(cuid())\n  organizationId String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId       String\n  submissionId   String\n  actorUserId    String\n  approved       Boolean\n  reason         String?\n  createdAt      DateTime @default(now())\n\n  submission PharmacySupplierSubmission @relation(fields: [organizationId, submissionId], references: [organizationId, id], onDelete: Restrict)\n\n  @@unique([organizationId, id])\n  @@index([organizationId, branchId, submissionId, createdAt])\n  @@map(\"pharmacy_supplier_submission_approvals\")\n}\n\nenum PatientConsentPurpose {\n  DISPENSING\n  REMINDERS\n  LOYALTY\n  MARKETING\n}\n\nenum PatientConsentChannel {\n  IN_PERSON\n  PHONE\n  SMS\n  WHATSAPP\n  EMAIL\n}\n\nenum PrescriptionSourceKind {\n  PAPER_IMAGE\n  WHATSAPP_PHOTO\n}\n\nenum PrescriptionCustodyState {\n  NOT_HELD\n  HELD_AT_PHARMACY\n  RETURNED_TO_PATIENT\n  TRANSFERRED\n}\n\nenum PharmacyPharmacovigilanceKind {\n  ADVERSE_DRUG_REACTION\n  MEDICATION_ERROR\n  PRODUCT_QUALITY_COMPLAINT\n}\n\nenum PharmacyPharmacovigilanceState {\n  DRAFT\n  UNDER_REVIEW\n  READY\n  SUBMITTED\n  CLOSED\n}\n\nenum PharmacyExternalSubmissionState {\n  NOT_SUBMITTED\n  PENDING\n  SUBMITTED\n  FAILED\n}\n\nmodel PharmacyPatient {\n  controlledRegisterEntries PharmacyControlledRegisterEntry[]\n  id                        String                            @id @default(cuid())\n  organizationId            String                            @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  displayName               String\n  cnic                      String?\n  phone                     String?\n  dateOfBirth               DateTime?                         @db.Date\n  createdAt                 DateTime                          @default(now())\n  updatedAt                 DateTime                          @updatedAt\n  consents                  PatientConsent[]\n  prescriptions             Prescription[]\n  unfulfilledDemandEvents   UnfulfilledDemandEvent[]\n  restockInterests          PharmacyRestockInterest[]\n  retailCustomers           PharmacyCustomer[]\n  refillReminderCaptures    PharmacyRefillReminderCapture[]\n  pharmacovigilanceReports  PharmacyPharmacovigilanceReport[]\n\n  @@unique([organizationId, id])\n  @@map(\"pharmacy_patients\")\n}\n\nmodel PatientConsent {\n  id               String                          @id @default(cuid())\n  organizationId   String                          @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  patientId        String\n  purpose          PatientConsentPurpose\n  channel          PatientConsentChannel\n  version          Int\n  granted          Boolean\n  recordedByUserId String\n  recordedAt       DateTime                        @default(now())\n  revokedAt        DateTime?\n  supersedesId     String?\n  patient          PharmacyPatient                 @relation(fields: [organizationId, patientId], references: [organizationId, id], onDelete: Restrict)\n  supersedes       PatientConsent?                 @relation(\"ConsentVersions\", fields: [organizationId, supersedesId], references: [organizationId, id], onDelete: Restrict)\n  supersededBy     PatientConsent[]                @relation(\"ConsentVersions\")\n  reminderCaptures PharmacyRefillReminderCapture[]\n\n  @@unique([organizationId, id])\n  @@unique([organizationId, patientId, purpose, channel, version])\n  @@map(\"pharmacy_patient_consents\")\n}\n\nmodel PharmacyPrescriber {\n  controlledRegisterEntries PharmacyControlledRegisterEntry[]\n  id                        String                            @id @default(cuid())\n  organizationId            String                            @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  name                      String\n  registrationNumber        String\n  phone                     String?\n  facility                  String?\n  createdAt                 DateTime                          @default(now())\n  prescriptions             Prescription[]\n  pharmacovigilanceReports  PharmacyPharmacovigilanceReport[]\n\n  @@unique([organizationId, id])\n  @@unique([organizationId, registrationNumber])\n  @@map(\"pharmacy_prescribers\")\n}\n\n/// RX-08: human-asserted safety report. Internal lifecycle and external\n/// submission state are intentionally independent.\nmodel PharmacyPharmacovigilanceReport {\n  id                      String                          @id @default(cuid())\n  organizationId          String                          @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId                String\n  kind                    PharmacyPharmacovigilanceKind\n  state                   PharmacyPharmacovigilanceState  @default(DRAFT)\n  externalSubmissionState PharmacyExternalSubmissionState @default(NOT_SUBMITTED)\n  patientId               String?\n  medicineId              String?\n  inventoryLotId          String?\n  prescriberId            String?\n  occurredAt              DateTime\n  assertedDescription     String\n  externalReference       String?\n  externalFailureReason   String?\n  createdByUserId         String\n  reviewedByUserId        String?\n  createdAt               DateTime                        @default(now())\n  updatedAt               DateTime                        @updatedAt\n\n  branch     PharmacyBranch        @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict, map: \"pharmacy_pv_branch_fkey\")\n  patient    PharmacyPatient?      @relation(fields: [organizationId, patientId], references: [organizationId, id], onDelete: Restrict)\n  medicine   Medicine?             @relation(fields: [organizationId, medicineId], references: [organizationId, id], onDelete: Restrict)\n  lot        PharmacyInventoryLot? @relation(fields: [organizationId, branchId, inventoryLotId], references: [organizationId, branchId, id], onDelete: Restrict, map: \"pharmacy_pv_lot_fkey\")\n  prescriber PharmacyPrescriber?   @relation(fields: [organizationId, prescriberId], references: [organizationId, id], onDelete: Restrict)\n\n  @@unique([organizationId, branchId, id])\n  @@index([organizationId, branchId, occurredAt])\n  @@map(\"pharmacy_pharmacovigilance_reports\")\n}\n\nmodel Prescription {\n  controlledRegisterEntries PharmacyControlledRegisterEntry[]\n  id                        String                            @id @default(cuid())\n  organizationId            String                            @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  patientId                 String\n  prescriberId              String\n  sourceKind                PrescriptionSourceKind\n  sourceFileRef             String\n  custodyState              PrescriptionCustodyState          @default(NOT_HELD)\n  validFrom                 DateTime\n  validUntil                DateTime\n  authorizedRepeats         Int                               @default(0)\n  capturedByUserId          String\n  capturedAt                DateTime                          @default(now())\n  patient                   PharmacyPatient                   @relation(fields: [organizationId, patientId], references: [organizationId, id], onDelete: Restrict)\n  prescriber                PharmacyPrescriber                @relation(fields: [organizationId, prescriberId], references: [organizationId, id], onDelete: Restrict)\n  lines                     PrescriptionLine[]\n\n  @@unique([organizationId, id])\n  @@map(\"pharmacy_prescriptions\")\n}\n\nmodel PrescriptionLine {\n  pharmacistReviewItems     PharmacyPharmacistReviewItem[]\n  substitutionRecords       PharmacySubstitutionRecord[]\n  controlledRegisterEntries PharmacyControlledRegisterEntry[]\n  id                        String                            @id @default(cuid())\n  organizationId            String                            @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  prescriptionId            String\n  lineNumber                Int\n  medicineId                String\n  presentationId            String\n  authorizedCanonicalUnits  Int\n  directions                String\n  createdAt                 DateTime                          @default(now())\n  prescription              Prescription                      @relation(fields: [organizationId, prescriptionId], references: [organizationId, id], onDelete: Restrict)\n  medicine                  Medicine                          @relation(fields: [medicineId], references: [id], onDelete: Restrict)\n  presentation              Presentation                      @relation(fields: [presentationId], references: [id], onDelete: Restrict)\n  fills                     PrescriptionFill[]\n\n  @@unique([organizationId, id])\n  @@unique([organizationId, prescriptionId, lineNumber])\n  @@map(\"pharmacy_prescription_lines\")\n}\n\nmodel PrescriptionFill {\n  id                     String                         @id @default(cuid())\n  organizationId         String                         @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  prescriptionLineId     String\n  fillSequence           Int\n  quantityCanonicalUnits Int\n  dispensedByUserId      String\n  dispensedAt            DateTime                       @default(now())\n  idempotencyKey         String\n  line                   PrescriptionLine               @relation(fields: [organizationId, prescriptionLineId], references: [organizationId, id], onDelete: Restrict)\n  reminderCapture        PharmacyRefillReminderCapture?\n\n  @@unique([organizationId, id])\n  @@unique([organizationId, prescriptionLineId, fillSequence])\n  @@unique([organizationId, idempotencyKey])\n  @@map(\"pharmacy_prescription_fills\")\n}\n\n/// RX-07: a patient-context, capture-only refill reminder draft. The immutable\n/// row snapshots the dispensed quantity and reviewed bilingual directions so a\n/// later card never drifts from what the pharmacist approved. No delivery state\n/// exists here; CRM-W03 owns delivery in a separate purpose boundary.\nmodel PharmacyRefillReminderCapture {\n  id                   String                            @id @default(cuid())\n  organizationId       String                            @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId             String\n  prescriptionFillId   String\n  patientId            String\n  channel              PatientConsentChannel\n  consentEventId       String\n  pharmacistDecisionId String?\n  medicineName         String\n  strength             String\n  dosageForm           String\n  directionsEnglish    String\n  directionsUrdu       String\n  quantityDispensed    Int\n  dosesPerDay          Decimal                           @db.Decimal(10, 4)\n  expectedExhaustionAt DateTime\n  reminderAt           DateTime\n  status               String                            @default(\"CAPTURED\")\n  captureMode          Boolean                           @default(true)\n  capturedByUserId     String\n  capturedAt           DateTime                          @default(now())\n  idempotencyKey       String\n  branch               PharmacyBranch                    @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)\n  fill                 PrescriptionFill                  @relation(fields: [organizationId, prescriptionFillId], references: [organizationId, id], onDelete: Restrict)\n  patient              PharmacyPatient                   @relation(fields: [organizationId, patientId], references: [organizationId, id], onDelete: Restrict)\n  consentEvent         PatientConsent                    @relation(fields: [organizationId, consentEventId], references: [organizationId, id], onDelete: Restrict)\n  pharmacistDecision   PharmacyPharmacistReviewDecision? @relation(fields: [organizationId, pharmacistDecisionId], references: [organizationId, id], onDelete: Restrict)\n\n  @@unique([organizationId, id])\n  @@unique([organizationId, prescriptionFillId])\n  @@unique([organizationId, idempotencyKey])\n  @@index([organizationId, branchId, reminderAt])\n  @@index([organizationId, patientId, capturedAt])\n  @@map(\"pharmacy_refill_reminder_captures\")\n}\n\nenum PharmacyReviewDecisionKind {\n  VERIFY\n  CLARIFY\n  REFUSE\n  OVERRIDE\n  COUNSEL\n  SIGN\n}\n\nenum PharmacyRegisterIncidentStatus {\n  OPEN\n  APPROVED\n}\n\n/// RX-03: one immutable queue item for the POS sale line requiring pharmacist review.\nmodel PharmacyPharmacistReviewItem {\n  id                 String                             @id @default(cuid())\n  organizationId     String                             @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  prescriptionLineId String\n  saleLineId         String\n  requestedByUserId  String\n  requestedAt        DateTime                           @default(now())\n  line               PrescriptionLine                   @relation(fields: [organizationId, prescriptionLineId], references: [organizationId, id], onDelete: Restrict)\n  decisions          PharmacyPharmacistReviewDecision[]\n\n  @@unique([organizationId, id])\n  @@unique([organizationId, saleLineId])\n  @@map(\"pharmacy_pharmacist_review_items\")\n}\n\n/// RX-03: append-only clinical decisions. SIGN is the sole sale-release event.\nmodel PharmacyPharmacistReviewDecision {\n  id               String                          @id @default(cuid())\n  organizationId   String                          @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  reviewItemId     String\n  kind             PharmacyReviewDecisionKind\n  actorUserId      String\n  reason           String?\n  signedAt         DateTime?\n  createdAt        DateTime                        @default(now())\n  reviewItem       PharmacyPharmacistReviewItem    @relation(fields: [organizationId, reviewItemId], references: [organizationId, id], onDelete: Restrict)\n  reminderCaptures PharmacyRefillReminderCapture[]\n\n  @@unique([organizationId, id])\n  @@index([organizationId, reviewItemId, createdAt])\n  @@map(\"pharmacy_pharmacist_review_decisions\")\n}\n\n/// RX-04: mandatory, immutable evidence whenever supplied presentation differs.\nmodel PharmacySubstitutionRecord {\n  id                       String           @id @default(cuid())\n  organizationId           String           @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  prescriptionLineId       String\n  saleLineId               String\n  prescribedPresentationId String\n  suppliedPresentationId   String\n  equivalenceBasis         String\n  actorUserId              String\n  patientCommunication     String\n  jurisdictionRuleRef      String\n  createdAt                DateTime         @default(now())\n  line                     PrescriptionLine @relation(fields: [organizationId, prescriptionLineId], references: [organizationId, id], onDelete: Restrict)\n\n  @@unique([organizationId, id])\n  @@unique([organizationId, saleLineId])\n  @@map(\"pharmacy_substitution_records\")\n}\n\n/// RX-05: append-only controlled-drug register, reconciled to a linked SALE movement.\nmodel PharmacyControlledRegisterEntry {\n  id                     String                     @id @default(cuid())\n  organizationId         String                     @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId               String\n  serial                 Int\n  prescriptionId         String\n  prescriptionLineId     String\n  patientId              String\n  prescriberId           String\n  inventoryLotId         String\n  stockMovementId        String\n  batchNumber            String\n  quantityCanonicalUnits Int\n  runningBalance         Int\n  recordedByUserId       String\n  witnessedByUserId      String\n  createdAt              DateTime                   @default(now())\n  prescription           Prescription               @relation(fields: [organizationId, prescriptionId], references: [organizationId, id], onDelete: Restrict, map: \"pharmacy_controlled_register_prescription_fkey\")\n  line                   PrescriptionLine           @relation(fields: [organizationId, prescriptionLineId], references: [organizationId, id], onDelete: Restrict, map: \"pharmacy_controlled_register_line_fkey\")\n  patient                PharmacyPatient            @relation(fields: [organizationId, patientId], references: [organizationId, id], onDelete: Restrict)\n  prescriber             PharmacyPrescriber         @relation(fields: [organizationId, prescriberId], references: [organizationId, id], onDelete: Restrict, map: \"pharmacy_controlled_register_prescriber_fkey\")\n  incidents              PharmacyRegisterIncident[]\n\n  @@unique([organizationId, id])\n  @@unique([organizationId, branchId, serial])\n  @@unique([organizationId, stockMovementId])\n  @@index([organizationId, branchId, inventoryLotId, createdAt])\n  @@map(\"pharmacy_controlled_register_entries\")\n}\n\nmodel PharmacyRegisterIncident {\n  id              String                             @id @default(cuid())\n  organizationId  String                             @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId        String\n  registerEntryId String\n  expectedBalance Int\n  actualBalance   Int\n  status          PharmacyRegisterIncidentStatus     @default(OPEN)\n  openedAt        DateTime                           @default(now())\n  entry           PharmacyControlledRegisterEntry    @relation(fields: [organizationId, registerEntryId], references: [organizationId, id], onDelete: Restrict)\n  approvals       PharmacyRegisterIncidentApproval[]\n\n  @@unique([organizationId, id])\n  @@index([organizationId, branchId, status])\n  @@map(\"pharmacy_register_incidents\")\n}\n\nmodel PharmacyRegisterIncidentApproval {\n  id               String                   @id @default(cuid())\n  organizationId   String                   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  incidentId       String\n  approvedByUserId String\n  reason           String\n  approvedAt       DateTime                 @default(now())\n  incident         PharmacyRegisterIncident @relation(fields: [organizationId, incidentId], references: [organizationId, id], onDelete: Restrict)\n\n  @@unique([organizationId, id])\n  @@unique([organizationId, incidentId])\n  @@map(\"pharmacy_register_incident_approvals\")\n}\n\n/// PUR-02 receiving / PUR-05 \\u2014 the document that turns an order or a supplier\n/// invoice into stock. It holds no quantity of its own: posting it writes an\n/// inventory lot and RECEIPT movements into the PH-INV ledger, which stays the\n/// only on-hand truth. \\`directPurchase\\` is the PUR-05 path \\u2014 no order, and a\n/// named bypass reason and approver instead.\nmodel PharmacyGoodsReceipt {\n  id                     String                     @id @default(cuid())\n  organizationId         String                     @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId               String\n  reference              String\n  status                 PharmacyGoodsReceiptStatus @default(DRAFT)\n  supplierId             String\n  purchaseOrderId        String?\n  /// PUR-02: the source-invoice and warranty evidence without which the goods\n  /// are not saleable. Required on the row, not only at the router.\n  supplierInvoiceRef     String\n  supplierInvoiceDate    DateTime\n  warrantyEvidenceRef    String\n  receivedByUserId       String\n  receivedAt             DateTime\n  directPurchase         Boolean                    @default(false)\n  bypassReason           String?\n  bypassApprovedByUserId String?\n  bypassApprovedAt       DateTime?\n  postedAt               DateTime?\n  reversedAt             DateTime?\n  reversedByUserId       String?\n  reversalReason         String?\n  note                   String?\n  /// AI-03: document-level OCR proposals and their source boxes.\n  ocrDraftEvidence       Json?\n  createdAt              DateTime                   @default(now())\n  updatedAt              DateTime                   @updatedAt\n\n  supplier      PharmacySupplier             @relation(fields: [organizationId, supplierId], references: [organizationId, id], onDelete: Restrict, map: \"pharmacy_goods_receipts_supplier_fkey\")\n  purchaseOrder PharmacyPurchaseOrder?       @relation(fields: [organizationId, purchaseOrderId], references: [organizationId, id], onDelete: Restrict, map: \"pharmacy_goods_receipts_order_fkey\")\n  lines         PharmacyGoodsReceiptLine[]\n  exceptions    PharmacyReceivingException[]\n\n  @@unique([organizationId, id], map: \"pharmacy_goods_receipts_org_id_key\")\n  @@unique([organizationId, branchId, id], map: \"pharmacy_goods_receipts_org_branch_id_key\")\n  @@unique([organizationId, reference], map: \"pharmacy_goods_receipts_org_reference_key\")\n  @@unique([organizationId, supplierId, supplierInvoiceRef], map: \"pharmacy_goods_receipts_org_invoice_key\")\n  @@index([organizationId, branchId, status, receivedAt], map: \"pharmacy_goods_receipts_org_branch_status_idx\")\n  @@index([organizationId, purchaseOrderId], map: \"pharmacy_goods_receipts_org_order_idx\")\n  @@map(\"pharmacy_goods_receipts\")\n}\n\n/// PUR-02 receiving \\u2014 what actually arrived, at batch granularity. Every field\n/// the PH-INV lot needs is here, because the lot is built from this row: a lot\n/// that could not name its batch, expiry, printed MRP or pack conversion would\n/// be stock nobody may sell (\\xA78A invariants 2, 18). \\`acceptedCanonicalUnits\\`\n/// and \\`rejectedCanonicalUnits\\` are the PUR-04 split; rejected units post to a\n/// QUARANTINE or RETURNS location and never to AVAILABLE.\nmodel PharmacyGoodsReceiptLine {\n  id                        String                  @id @default(cuid())\n  organizationId            String                  @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId                  String\n  goodsReceiptId            String\n  lineNumber                Int\n  /// Null on the PUR-05 direct path: there is no ordered line to match against.\n  purchaseOrderLineId       String?\n  medicineId                String\n  packLevelId               String\n  batchNumber               String\n  printedExpiry             DateTime\n  expiryPrecision           PharmacyExpiryPrecision\n  printedMrpMinor           Int\n  canonicalUnitsPerPack     Int\n  receivedPacks             Int\n  bonusPacks                Int                     @default(0)\n  receivedCanonicalUnits    Int\n  bonusCanonicalUnits       Int                     @default(0)\n  acceptedCanonicalUnits    Int\n  rejectedCanonicalUnits    Int                     @default(0)\n  rejectionReason           String?\n  invoicedPricePerPackMinor Int\n  discountBps               Int                     @default(0)\n  taxBps                    Int                     @default(0)\n  taxCreditable             Boolean                 @default(false)\n  /// Landed cost of one canonical unit, carried onto the lot. Bonus units\n  /// divide the same money over more units and never add any (PUR-03).\n  unitCostMinor             Int\n  stockLocationId           String\n  quarantineLocationId      String?\n  /// Stamped when the receipt posts; the join from this document to the ledger.\n  inventoryLotId            String?\n  /// AI-03 / MED-04: confidence and source box for every extracted field.\n  ocrFieldEvidence          Json?\n  /// A human, never OCR confidence, confirms the regulated facts before posting.\n  ocrRegulatedConfirmedAt   DateTime?\n  ocrRegulatedConfirmedById String?\n  createdAt                 DateTime                @default(now())\n\n  goodsReceipt       PharmacyGoodsReceipt         @relation(fields: [organizationId, branchId, goodsReceiptId], references: [organizationId, branchId, id], onDelete: Restrict, map: \"pharmacy_grl_receipt_fkey\")\n  purchaseOrderLine  PharmacyPurchaseOrderLine?   @relation(fields: [organizationId, purchaseOrderLineId], references: [organizationId, id], onDelete: Restrict, map: \"pharmacy_grl_order_line_fkey\")\n  medicine           Medicine                     @relation(fields: [organizationId, medicineId], references: [organizationId, id], onDelete: Restrict, map: \"pharmacy_grl_medicine_fkey\")\n  packLevel          PackLevel                    @relation(fields: [organizationId, packLevelId], references: [organizationId, id], onDelete: Restrict, map: \"pharmacy_grl_pack_level_fkey\")\n  stockLocation      PharmacyStockLocation        @relation(\"PharmacyReceiptStock\", fields: [organizationId, stockLocationId], references: [organizationId, id], onDelete: Restrict, map: \"pharmacy_grl_location_fkey\")\n  quarantineLocation PharmacyStockLocation?       @relation(\"PharmacyReceiptQuarantine\", fields: [organizationId, quarantineLocationId], references: [organizationId, id], onDelete: Restrict, map: \"pharmacy_grl_quarantine_fkey\")\n  inventoryLot       PharmacyInventoryLot?        @relation(fields: [organizationId, branchId, inventoryLotId], references: [organizationId, branchId, id], onDelete: Restrict, map: \"pharmacy_grl_lot_fkey\")\n  exceptions         PharmacyReceivingException[]\n\n  @@unique([organizationId, id], map: \"pharmacy_grl_org_id_key\")\n  @@unique([organizationId, branchId, id], map: \"pharmacy_grl_org_branch_id_key\")\n  @@unique([organizationId, goodsReceiptId, lineNumber], map: \"pharmacy_grl_org_receipt_line_key\")\n  @@index([organizationId, goodsReceiptId], map: \"pharmacy_grl_org_receipt_idx\")\n  @@index([organizationId, purchaseOrderLineId], map: \"pharmacy_grl_org_order_line_idx\")\n  @@index([organizationId, medicineId], map: \"pharmacy_grl_org_medicine_idx\")\n  @@map(\"pharmacy_goods_receipt_lines\")\n}\n\n/// PUR-04 \\u2014 the three-way match result a human still has to close. Raised at\n/// posting and OPEN, and therefore visible, until somebody records who resolved\n/// it and why. Only the resolution columns may ever change (trigger), so a\n/// shortage cannot shrink on its way to being closed.\nmodel PharmacyReceivingException {\n  id                  String                           @id @default(cuid())\n  organizationId      String                           @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId            String\n  goodsReceiptId      String\n  goodsReceiptLineId  String\n  purchaseOrderLineId String?\n  kind                PharmacyReceivingExceptionKind\n  status              PharmacyReceivingExceptionStatus @default(OPEN)\n  detail              String\n  /// Quantity terms for SHORTAGE/OVERAGE/DAMAGE and for a pack conflict; money\n  /// terms for a price conflict.\n  expectedUnits       Int?\n  observedUnits       Int?\n  expectedMinor       Int?\n  observedMinor       Int?\n  raisedAt            DateTime                         @default(now())\n  resolvedAt          DateTime?\n  resolvedByUserId    String?\n  resolutionNote      String?\n\n  goodsReceipt      PharmacyGoodsReceipt       @relation(fields: [organizationId, branchId, goodsReceiptId], references: [organizationId, branchId, id], onDelete: Restrict, map: \"pharmacy_rex_receipt_fkey\")\n  goodsReceiptLine  PharmacyGoodsReceiptLine   @relation(fields: [organizationId, branchId, goodsReceiptLineId], references: [organizationId, branchId, id], onDelete: Restrict, map: \"pharmacy_rex_line_fkey\")\n  purchaseOrderLine PharmacyPurchaseOrderLine? @relation(fields: [organizationId, purchaseOrderLineId], references: [organizationId, id], onDelete: Restrict, map: \"pharmacy_rex_order_line_fkey\")\n\n  @@unique([organizationId, id], map: \"pharmacy_rex_org_id_key\")\n  @@unique([organizationId, goodsReceiptLineId, kind], map: \"pharmacy_rex_org_line_kind_key\")\n  @@index([organizationId, branchId, status, raisedAt], map: \"pharmacy_rex_org_branch_status_idx\")\n  @@index([organizationId, goodsReceiptId], map: \"pharmacy_rex_org_receipt_idx\")\n  @@map(\"pharmacy_receiving_exceptions\")\n}\n\n// ===========================================================================\n// PH-PUR/PH-INV \\u2014 supplier returns and the stock action centre\n// (PRD \\xA76.3 PUR-06, PUR-07; \\xA78A invariants 9 and 29)\n// ===========================================================================\n\n/// PUR-06 \\u2014 why stock is going back. The two kinds share one document because\n/// they share one settlement path; they differ only in what opened the return\n/// window (a commercial agreement vs the printed expiry).\nenum PharmacyPurchaseReturnKind {\n  PURCHASE_RETURN\n  EXPIRY_CLAIM\n}\n\n/// PUR-06 / \\xA78A invariant 29. DRAFT holds nothing: it neither reserves stock nor\n/// moves it, which is what makes it safe for a one-click signal action. SUBMITTED\n/// takes the INV-09 reservation, so the quantity stops being saleable. DISPATCHED\n/// posts the RETURN_TO_SUPPLIER movements. SETTLED means credit has been\n/// allocated against every debit note the return raised.\nenum PharmacyPurchaseReturnStatus {\n  DRAFT\n  SUBMITTED\n  DISPATCHED\n  SETTLED\n  CANCELLED\n}\n\nenum PharmacyDebitNoteStatus {\n  OPEN\n  PARTIALLY_SETTLED\n  SETTLED\n  CANCELLED\n}\n\n/// PUR-06 \\u2014 the return or claim document. Branch-scoped like the rest of PH-INV;\n/// the pharmacy branch entity itself lands with PLAT-03, so \\`branchId\\` carries no\n/// foreign key and \\`organizationId\\` under FORCE RLS remains the tenant boundary.\nmodel PharmacyPurchaseReturn {\n  id                 String                       @id @default(cuid())\n  organizationId     String                       @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId           String\n  supplierId         String\n  kind               PharmacyPurchaseReturnKind\n  status             PharmacyPurchaseReturnStatus @default(DRAFT)\n  reference          String\n  note               String?\n  createdByUserId    String\n  submittedByUserId  String?\n  submittedAt        DateTime?\n  dispatchedByUserId String?\n  dispatchedAt       DateTime?\n  settledAt          DateTime?\n  cancelledAt        DateTime?\n  createdAt          DateTime                     @default(now())\n  updatedAt          DateTime                     @updatedAt\n\n  supplier      PharmacySupplier             @relation(fields: [organizationId, supplierId], references: [organizationId, id], onDelete: Restrict)\n  lines         PharmacyPurchaseReturnLine[]\n  debitNotes    PharmacyDebitNote[]\n  signalActions PharmacyStockSignalAction[]\n\n  @@unique([organizationId, id], map: \"pharmacy_purchase_returns_org_id_key\")\n  @@unique([organizationId, branchId, id], map: \"pharmacy_purchase_returns_org_branch_id_key\")\n  @@unique([organizationId, reference], map: \"pharmacy_purchase_returns_org_reference_key\")\n  @@index([organizationId, branchId, status], map: \"pharmacy_purchase_returns_org_branch_status_idx\")\n  @@index([organizationId, supplierId, status], map: \"pharmacy_purchase_returns_org_supplier_status_idx\")\n  @@map(\"pharmacy_purchase_returns\")\n}\n\n/// PUR-06 \\u2014 one lot going back. \\`quantityUnits\\` is an integer count of canonical\n/// base units (\\xA78A invariant 1). \\`returnWindowEndsAt\\` is the supplier's deadline;\n/// \\`expectedCreditMinor\\` is what the pharmacy expects to be credited, which is\n/// deliberately separate from what a supplier eventually pays.\nmodel PharmacyPurchaseReturnLine {\n  id                  String   @id @default(cuid())\n  organizationId      String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId            String\n  purchaseReturnId    String\n  lineNumber          Int\n  inventoryLotId      String\n  stockLocationId     String\n  quantityUnits       Int\n  reason              String\n  returnWindowEndsAt  DateTime\n  expectedCreditMinor Int\n  /// The INV-09 reservation this line takes at submission. Null while the line\n  /// is still on a DRAFT return, which is precisely why a draft holds no stock.\n  supplierClaimId     String?\n  createdAt           DateTime @default(now())\n\n  purchaseReturn PharmacyPurchaseReturn @relation(fields: [organizationId, branchId, purchaseReturnId], references: [organizationId, branchId, id], onDelete: Restrict)\n  lot            PharmacyInventoryLot   @relation(fields: [organizationId, branchId, inventoryLotId], references: [organizationId, branchId, id], onDelete: Restrict)\n  location       PharmacyStockLocation  @relation(fields: [organizationId, stockLocationId], references: [organizationId, id], onDelete: Restrict)\n  supplierClaim  PharmacySupplierClaim? @relation(fields: [organizationId, supplierClaimId], references: [organizationId, id], onDelete: Restrict)\n\n  @@unique([organizationId, id], map: \"pharmacy_purchase_return_lines_org_id_key\")\n  @@unique([organizationId, purchaseReturnId, lineNumber], map: \"pharmacy_purchase_return_lines_org_return_line_key\")\n  @@index([organizationId, branchId, inventoryLotId], map: \"pharmacy_purchase_return_lines_org_branch_lot_idx\")\n  @@map(\"pharmacy_purchase_return_lines\")\n}\n\n/// PUR-06 \\u2014 the pharmacy's claim on the supplier's account. \\`expectedCreditMinor\\`\n/// is frozen from the return lines at issue time; what actually arrives is the\n/// sum of the credit allocations beneath it, so expected and received are two\n/// separately sourced numbers that can be compared rather than one that has been\n/// overwritten (\\xA78A invariant 27).\nmodel PharmacyDebitNote {\n  id                  String                  @id @default(cuid())\n  organizationId      String                  @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId            String\n  supplierId          String\n  purchaseReturnId    String\n  reference           String\n  status              PharmacyDebitNoteStatus @default(OPEN)\n  expectedCreditMinor Int\n  issuedByUserId      String\n  issuedAt            DateTime                @default(now())\n  cancelledAt         DateTime?\n  createdAt           DateTime                @default(now())\n  updatedAt           DateTime                @updatedAt\n\n  supplier       PharmacySupplier                   @relation(fields: [organizationId, supplierId], references: [organizationId, id], onDelete: Restrict)\n  purchaseReturn PharmacyPurchaseReturn             @relation(fields: [organizationId, branchId, purchaseReturnId], references: [organizationId, branchId, id], onDelete: Restrict)\n  allocations    PharmacySupplierCreditAllocation[]\n\n  @@unique([organizationId, id], map: \"pharmacy_debit_notes_org_id_key\")\n  @@unique([organizationId, reference], map: \"pharmacy_debit_notes_org_reference_key\")\n  @@unique([organizationId, purchaseReturnId], map: \"pharmacy_debit_notes_org_return_key\")\n  @@index([organizationId, branchId, status], map: \"pharmacy_debit_notes_org_branch_status_idx\")\n  @@index([organizationId, supplierId, status], map: \"pharmacy_debit_notes_org_supplier_status_idx\")\n  @@map(\"pharmacy_debit_notes\")\n}\n\n/// PUR-06 \\u2014 a credit note the supplier actually issued. Recorded once, then\n/// allocated across debit notes; the credit itself is never edited down.\nmodel PharmacySupplierCredit {\n  id               String   @id @default(cuid())\n  organizationId   String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId         String\n  supplierId       String\n  reference        String\n  amountMinor      Int\n  receivedAt       DateTime\n  recordedByUserId String\n  createdAt        DateTime @default(now())\n\n  supplier    PharmacySupplier                   @relation(fields: [organizationId, supplierId], references: [organizationId, id], onDelete: Restrict)\n  allocations PharmacySupplierCreditAllocation[]\n\n  @@unique([organizationId, id], map: \"pharmacy_supplier_credits_org_id_key\")\n  @@unique([organizationId, supplierId, reference], map: \"pharmacy_supplier_credits_org_supplier_reference_key\")\n  @@index([organizationId, branchId, receivedAt], map: \"pharmacy_supplier_credits_org_branch_received_idx\")\n  @@map(\"pharmacy_supplier_credits\")\n}\n\n/// PUR-06 \\u2014 settlement. Append-only (trigger): reallocating money is a new\n/// allocation, never a rewritten one (\\xA78A invariant 15).\nmodel PharmacySupplierCreditAllocation {\n  id                String   @id @default(cuid())\n  organizationId    String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  supplierCreditId  String\n  debitNoteId       String\n  amountMinor       Int\n  allocatedByUserId String\n  createdAt         DateTime @default(now())\n\n  credit    PharmacySupplierCredit @relation(fields: [organizationId, supplierCreditId], references: [organizationId, id], onDelete: Restrict)\n  debitNote PharmacyDebitNote      @relation(fields: [organizationId, debitNoteId], references: [organizationId, id], onDelete: Restrict)\n\n  @@unique([organizationId, id], map: \"pharmacy_credit_allocations_org_id_key\")\n  @@unique([organizationId, supplierCreditId, debitNoteId], map: \"pharmacy_credit_allocations_org_credit_note_key\")\n  @@index([organizationId, debitNoteId], map: \"pharmacy_credit_allocations_org_note_idx\")\n  @@map(\"pharmacy_supplier_credit_allocations\")\n}\n\n// \\u2500\\u2500 PUR-07 \\u2014 deterministic stock action centre \\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\n\nenum PharmacyStockSignalKind {\n  LOW_STOCK\n  STOCKOUT\n  PROJECTED_STOCKOUT\n  INBOUND_COVERAGE\n  NEAR_EXPIRY\n  RETURN_WINDOW\n  RECALL\n  QUARANTINE\n  COLD_CHAIN\n  COUNT_VARIANCE\n}\n\n/// STALE is not a human decision \\u2014 it is what the freshness policy does to a\n/// signal whose evidence has aged out, so the operator is never asked to act on\n/// a number the evaluator can no longer vouch for.\nenum PharmacyStockSignalStatus {\n  OPEN\n  ACKNOWLEDGED\n  SNOOZED\n  DISMISSED\n  CLOSED\n  STALE\n}\n\n/// EXACT when every input behind the signal is settled ledger fact. PARTIAL when\n/// an open count or an unresolved discrepancy means the on-hand number is itself\n/// still in dispute \\u2014 a deterministic statement about the inputs, not a forecast.\nenum PharmacyStockSignalConfidence {\n  EXACT\n  PARTIAL\n}\n\nenum PharmacyStockSignalEventKind {\n  RAISED\n  REFRESHED\n  ACKNOWLEDGED\n  SNOOZED\n  DISMISSED\n  CLOSED\n  MARKED_STALE\n  DRAFT_ACTION\n}\n\n/// \\xA78A invariant 29 \\u2014 the complete set of things a one-click action may create.\n/// Every member is a draft document; none of them is an order or a movement.\nenum PharmacyStockSignalActionKind {\n  DRAFT_REQUISITION\n  DRAFT_TRANSFER\n  DRAFT_CLAIM\n}\n\n/// PUR-07 \\u2014 the approved replenishment policy a signal is measured against.\n/// A signal that needs a safety-stock number is not raised at all until an\n/// approved one exists, so the evaluator never invents a threshold.\nmodel PharmacySafetyStock {\n  id               String   @id @default(cuid())\n  organizationId   String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId         String\n  medicineId       String\n  safetyStockUnits Int\n  /// The deterministic projection horizon in days: how far ahead expiry-driven\n  /// depletion is looked at. Not a forecast \\u2014 PUR-09 is out of scope here.\n  coverageDays     Int      @default(30)\n  approvedByUserId String\n  approvedAt       DateTime\n  createdAt        DateTime @default(now())\n  updatedAt        DateTime @updatedAt\n\n  medicine Medicine @relation(fields: [organizationId, medicineId], references: [organizationId, id], onDelete: Restrict)\n\n  @@unique([organizationId, id], map: \"pharmacy_safety_stocks_org_id_key\")\n  @@unique([organizationId, branchId, medicineId], map: \"pharmacy_safety_stocks_org_branch_medicine_key\")\n  @@map(\"pharmacy_safety_stocks\")\n}\n\n/// PUR-07 \\u2014 one deduplicated call to act. \\`dedupKey\\` is the (kind, product,\n/// location, cause) identity the evaluator recomputes on every run; a partial\n/// unique index keeps at most one live signal per key, so re-evaluating refreshes\n/// the existing row instead of burying the operator in duplicates.\n///\n/// \\`neededUnits\\` / \\`onHandUnits\\` / \\`inboundUnits\\` are the exact numbers the\n/// explanation was written from, kept so the decision stays auditable after the\n/// underlying ledger has moved on (\\xA78A invariant 29).\nmodel PharmacyStockSignal {\n  id                   String                        @id @default(cuid())\n  organizationId       String                        @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId             String\n  kind                 PharmacyStockSignalKind\n  dedupKey             String\n  status               PharmacyStockSignalStatus     @default(OPEN)\n  medicineId           String\n  stockLocationId      String?\n  inventoryLotId       String?\n  cause                String\n  ownerUserId          String\n  dueAt                DateTime\n  explanation          String\n  dataWindowStart      DateTime\n  dataWindowEnd        DateTime\n  /// The newest ledger fact the evaluator read for this signal.\n  sourceObservedAt     DateTime\n  /// The freshness policy in force when the signal was computed, in seconds. The\n  /// signal becomes STALE once \\`computedAt\\` is older than this.\n  freshnessSeconds     Int\n  confidence           PharmacyStockSignalConfidence\n  neededUnits          Int\n  onHandUnits          Int\n  inboundUnits         Int\n  computedAt           DateTime\n  acknowledgedAt       DateTime?\n  acknowledgedByUserId String?\n  snoozedUntil         DateTime?\n  snoozeReason         String?\n  dismissedAt          DateTime?\n  dismissedByUserId    String?\n  dismissReason        String?\n  closedAt             DateTime?\n  markedStaleAt        DateTime?\n  createdAt            DateTime                      @default(now())\n  updatedAt            DateTime                      @updatedAt\n\n  medicine Medicine                    @relation(fields: [organizationId, medicineId], references: [organizationId, id], onDelete: Restrict)\n  location PharmacyStockLocation?      @relation(fields: [organizationId, stockLocationId], references: [organizationId, id], onDelete: Restrict)\n  events   PharmacyStockSignalEvent[]\n  actions  PharmacyStockSignalAction[]\n\n  @@unique([organizationId, id], map: \"pharmacy_stock_signals_org_id_key\")\n  @@unique([organizationId, branchId, id], map: \"pharmacy_stock_signals_org_branch_id_key\")\n  @@index([organizationId, branchId, status, dueAt], map: \"pharmacy_stock_signals_org_branch_status_due_idx\")\n  @@index([organizationId, ownerUserId, status, dueAt], map: \"pharmacy_stock_signals_org_owner_status_due_idx\")\n  @@index([organizationId, branchId, kind, status], map: \"pharmacy_stock_signals_org_branch_kind_idx\")\n  @@map(\"pharmacy_stock_signals\")\n}\n\n/// PUR-07 / \\xA78A invariant 29 \\u2014 the audit trail behind every human decision on a\n/// signal. Append-only (trigger).\nmodel PharmacyStockSignalEvent {\n  id             String                       @id @default(cuid())\n  organizationId String                       @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId       String\n  signalId       String\n  kind           PharmacyStockSignalEventKind\n  actorId        String\n  reason         String?\n  detail         String?\n  createdAt      DateTime                     @default(now())\n\n  signal PharmacyStockSignal @relation(fields: [organizationId, branchId, signalId], references: [organizationId, branchId, id], onDelete: Restrict)\n\n  @@unique([organizationId, id], map: \"pharmacy_stock_signal_events_org_id_key\")\n  @@index([organizationId, branchId, signalId, createdAt], map: \"pharmacy_stock_signal_events_org_signal_idx\")\n  @@map(\"pharmacy_stock_signal_events\")\n}\n\n/// PUR-07 / \\xA78A invariant 29 \\u2014 the link from a signal to the DRAFT document one\n/// click created. Exactly one of the three references is set, and all three point\n/// at documents that are inert until a human advances them. Append-only.\nmodel PharmacyStockSignalAction {\n  id               String                        @id @default(cuid())\n  organizationId   String                        @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId         String\n  signalId         String\n  kind             PharmacyStockSignalActionKind\n  actorId          String\n  requisitionId    String?\n  transferId       String?\n  purchaseReturnId String?\n  createdAt        DateTime                      @default(now())\n\n  signal         PharmacyStockSignal          @relation(fields: [organizationId, branchId, signalId], references: [organizationId, branchId, id], onDelete: Restrict)\n  requisition    PharmacyRequisition?         @relation(fields: [organizationId, requisitionId], references: [organizationId, id], onDelete: Restrict)\n  transfer       PharmacyInterbranchTransfer? @relation(fields: [organizationId, transferId], references: [organizationId, id], onDelete: Restrict)\n  purchaseReturn PharmacyPurchaseReturn?      @relation(fields: [organizationId, purchaseReturnId], references: [organizationId, id], onDelete: Restrict)\n\n  @@unique([organizationId, id], map: \"pharmacy_stock_signal_actions_org_id_key\")\n  @@index([organizationId, branchId, signalId, createdAt], map: \"pharmacy_stock_signal_actions_org_signal_idx\")\n  @@map(\"pharmacy_stock_signal_actions\")\n}\n\n// ============================================\n// PH-MIG \\u2014 opening stock, parallel run and cutover\n// (PRD \\xA76.10 MIG-03, MIG-04, MIG-05)\n//\n// References to tables owned by earlier lanes (branches, migration batches and\n// rows, manufacturing batches, stock locations, inventory lots, stock movements)\n// are composite \\`(organizationId, \\u2026)\\` foreign keys declared in the migration SQL\n// only, matching the SQL-only composite tenant foreign keys already used across\n// this schema. Modelling them as Prisma relations would add relation scalars to\n// models this lane does not own.\n// ============================================\n\nenum PharmacyOpeningSessionStatus {\n  DRAFT\n  COUNTED\n  POSTED\n  SIGNED_OFF\n}\n\n/// A line is READY only once every attribute an opening lot needs is present.\n/// EXCEPTION is the state MIG-02's \"never silently defaulted\" rule produces: the\n/// missing value stays NULL and the line cannot post.\nenum PharmacyOpeningLineStatus {\n  PENDING\n  READY\n  EXCEPTION\n  POSTED\n}\n\nenum PharmacyOpeningExceptionBucket {\n  MISSING_BATCH\n  MISSING_EXPIRY\n  MISSING_MRP\n  MISSING_COST\n  MISSING_LOCATION\n  MISSING_SOURCE_REF\n  MISSING_COUNT\n}\n\nenum PharmacyOpeningLedgerAccount {\n  ACCOUNTS_PAYABLE\n  ACCOUNTS_RECEIVABLE\n  CASH\n  BANK\n}\n\nenum PharmacyParallelRunStatus {\n  OPEN\n  CLOSED\n}\n\nenum PharmacyParallelRunMetric {\n  SALES\n  CASH\n  STOCK_VALUE\n}\n\nenum PharmacyCutoverEventKind {\n  CUTOVER\n  ROLLBACK\n}\n\n/// Who owns receipt numbering. Absent any cutover event the incumbent still owns\n/// it, so the resolved default is LEGACY rather than a stored row.\nenum PharmacySequenceOwner {\n  LEGACY\n  DEVFATHOM\n}\n\n/// MIG-03 / MIG-05 decision D05 \\u2014 the contract materiality threshold. Unset is\n/// not \"no threshold\": with no row the resolved threshold is 0, so every variance\n/// is material until the contract sets one.\nmodel PharmacyMaterialityThreshold {\n  id             String   @id @default(cuid())\n  organizationId String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId       String\n  thresholdMinor BigInt   @default(0)\n  thresholdUnits Int      @default(0)\n  setByActorId   String\n  setAt          DateTime @default(now())\n  createdAt      DateTime @default(now())\n  updatedAt      DateTime @updatedAt\n\n  @@unique([organizationId, id], map: \"pharmacy_materiality_thresholds_org_id_key\")\n  @@unique([organizationId, branchId], map: \"pharmacy_materiality_thresholds_org_branch_key\")\n  @@map(\"pharmacy_materiality_thresholds\")\n}\n\n/// MIG-03 \\u2014 one opening-stock reconciliation for one branch: the mapped\n/// migration rows on one side, a physical count on the other. Modelled on the\n/// INV-06 count session (expected / counted / variance per line, threshold on\n/// the session, co-authored sign-off) because an opening count IS a count \\u2014 the\n/// difference is only that its expected side comes from the incumbent's export\n/// rather than from a balance this system already holds.\nmodel PharmacyOpeningSession {\n  id               String                       @id @default(cuid())\n  organizationId   String                       @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId         String\n  migrationBatchId String?\n  /// The instant the opening position is taken. Becomes the lot \\`receivedAt\\` and\n  /// the movement \\`occurredAt\\`, so opening stock is receivable and movable.\n  openingAt        DateTime\n  status           PharmacyOpeningSessionStatus @default(DRAFT)\n  createdByActorId String\n  postedByActorId  String?\n  postedAt         DateTime?\n  signedOffBy      String?\n  signedOffAt      DateTime?\n  createdAt        DateTime                     @default(now())\n  updatedAt        DateTime                     @updatedAt\n\n  lines      PharmacyOpeningStockLine[]\n  exceptions PharmacyOpeningException[]\n  totals     PharmacyOpeningTotal[]\n  ledgers    PharmacyOpeningLedgerEntry[]\n\n  @@unique([organizationId, id], map: \"pharmacy_opening_sessions_org_id_key\")\n  @@unique([organizationId, branchId, id], map: \"pharmacy_opening_sessions_org_branch_id_key\")\n  @@index([organizationId, branchId, status], map: \"pharmacy_opening_sessions_org_branch_status_idx\")\n  @@map(\"pharmacy_opening_sessions\")\n}\n\n/// One opening lot candidate. Every attribute an opening lot needs \\u2014 batch,\n/// expiry, printed MRP, cost, location, source ref \\u2014 is NULLABLE and has NO\n/// default: a value the incumbent did not supply stays missing and raises an\n/// exception. A CHECK forbids POSTED while any of them is still NULL, so the\n/// \"never defaulted\" rule survives a caller that skips the service.\nmodel PharmacyOpeningStockLine {\n  id                   String                    @id @default(cuid())\n  organizationId       String                    @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  sessionId            String\n  branchId             String\n  migrationRowId       String?\n  sourceRef            String?\n  manufacturingBatchId String?\n  batchNumber          String?\n  expiryDate           DateTime?                 @db.Date\n  expiryPrecision      PharmacyExpiryPrecision?\n  printedMrpMinor      Int?\n  unitCostMinor        Int?\n  stockLocationId      String?\n  packLevelId          String?\n  unitsPerPack         Int?\n  /// The incumbent's quantity for this lot, in canonical base units.\n  expectedUnits        Int?\n  /// What the physical count found, in canonical base units.\n  countedUnits         Int?\n  /// countedUnits - expectedUnits. The counted side is what posts.\n  varianceUnits        Int?\n  /// Why the variance is accepted. A material variance without one is\n  /// UNEXPLAINED and blocks sign-off.\n  varianceNote         String?\n  status               PharmacyOpeningLineStatus @default(PENDING)\n  postedLotId          String?\n  postedMovementId     String?\n  createdAt            DateTime                  @default(now())\n  updatedAt            DateTime                  @updatedAt\n\n  session    PharmacyOpeningSession     @relation(fields: [organizationId, sessionId], references: [organizationId, id], onDelete: Restrict)\n  exceptions PharmacyOpeningException[]\n\n  @@unique([organizationId, id], map: \"pharmacy_opening_stock_lines_org_id_key\")\n  @@index([organizationId, sessionId, status], map: \"pharmacy_opening_stock_lines_org_session_status_idx\")\n  @@index([organizationId, branchId], map: \"pharmacy_opening_stock_lines_org_branch_idx\")\n  @@map(\"pharmacy_opening_stock_lines\")\n}\n\n/// MIG-03 \\u2014 the gap that stopped a line posting. Written in the same transaction\n/// as the line it describes, so a line can never carry a gap without the\n/// exception naming it. Resolution is one-way and never writes a value into the\n/// line: a gap is repaired by re-stating the line from better source data.\nmodel PharmacyOpeningException {\n  id             String                         @id @default(cuid())\n  organizationId String                         @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  sessionId      String\n  lineId         String?\n  bucket         PharmacyOpeningExceptionBucket\n  detail         String\n  resolvedBy     String?\n  resolvedAt     DateTime?\n  resolutionNote String?\n  createdAt      DateTime                       @default(now())\n  updatedAt      DateTime                       @updatedAt\n\n  session PharmacyOpeningSession    @relation(fields: [organizationId, sessionId], references: [organizationId, id], onDelete: Restrict)\n  line    PharmacyOpeningStockLine? @relation(fields: [organizationId, lineId], references: [organizationId, id], onDelete: Restrict)\n\n  @@unique([organizationId, id], map: \"pharmacy_opening_exceptions_org_id_key\")\n  @@index([organizationId, sessionId, bucket], map: \"pharmacy_opening_exceptions_org_session_bucket_idx\")\n  @@index([organizationId, lineId], map: \"pharmacy_opening_exceptions_org_line_idx\")\n  @@map(\"pharmacy_opening_exceptions\")\n}\n\n/// MIG-03 \\u2014 the signed opening totals for one branch: what quantity and what\n/// value this branch opened with. Signed, because a correcting opening session\n/// may open a branch with a negative adjustment. Append-only: an opening total\n/// is what was posted, not what is currently believed.\nmodel PharmacyOpeningTotal {\n  id              String   @id @default(cuid())\n  organizationId  String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId        String\n  sessionId       String\n  totalUnits      Int\n  totalValueMinor BigInt\n  lineCount       Int\n  actorId         String\n  postedAt        DateTime @default(now())\n  createdAt       DateTime @default(now())\n\n  session PharmacyOpeningSession @relation(fields: [organizationId, sessionId], references: [organizationId, id], onDelete: Restrict)\n\n  @@unique([organizationId, id], map: \"pharmacy_opening_totals_org_id_key\")\n  @@unique([organizationId, sessionId], map: \"pharmacy_opening_totals_org_session_key\")\n  @@index([organizationId, branchId, postedAt], map: \"pharmacy_opening_totals_org_branch_idx\")\n  @@map(\"pharmacy_opening_totals\")\n}\n\n/// MIG-03 \\u2014 opening AP / AR / cash / bank as signed totals with actor and time.\n/// The FIN lane reads these through the exported opening-ledger interface rather\n/// than forking its own opening-balance path; this table is the interface's\n/// storage, not a second chart of accounts.\nmodel PharmacyOpeningLedgerEntry {\n  id             String                       @id @default(cuid())\n  organizationId String                       @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId       String\n  sessionId      String\n  account        PharmacyOpeningLedgerAccount\n  /// Signed minor units: a credit balance is negative, a debit balance positive.\n  balanceMinor   BigInt\n  sourceRef      String\n  actorId        String\n  postedAt       DateTime                     @default(now())\n  createdAt      DateTime                     @default(now())\n\n  session PharmacyOpeningSession @relation(fields: [organizationId, sessionId], references: [organizationId, id], onDelete: Restrict)\n\n  @@unique([organizationId, id], map: \"pharmacy_opening_ledger_entries_org_id_key\")\n  @@unique([organizationId, sessionId, account], map: \"pharmacy_opening_ledger_entries_org_session_account_key\")\n  @@index([organizationId, branchId, account], map: \"pharmacy_opening_ledger_entries_org_branch_account_idx\")\n  @@map(\"pharmacy_opening_ledger_entries\")\n}\n\n/// MIG-04 \\u2014 the window during which the branch enters every transaction into\n/// both systems and this one is read-only evidence.\nmodel PharmacyParallelRunWindow {\n  id              String                    @id @default(cuid())\n  organizationId  String                    @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId        String\n  startDate       DateTime                  @db.Date\n  endDate         DateTime                  @db.Date\n  status          PharmacyParallelRunStatus @default(OPEN)\n  openedByActorId String\n  closedByActorId String?\n  closedAt        DateTime?\n  createdAt       DateTime                  @default(now())\n  updatedAt       DateTime                  @updatedAt\n\n  entries     PharmacyParallelRunDailyEntry[]\n  comparisons PharmacyParallelRunComparison[]\n\n  @@unique([organizationId, id], map: \"pharmacy_parallel_run_windows_org_id_key\")\n  @@unique([organizationId, branchId, startDate], map: \"pharmacy_parallel_run_windows_org_branch_start_key\")\n  @@index([organizationId, branchId, status], map: \"pharmacy_parallel_run_windows_org_branch_status_idx\")\n  @@map(\"pharmacy_parallel_run_windows\")\n}\n\n/// MIG-04 \\u2014 the incumbent's totals for one business date, typed in by the\n/// operator. This is the only side of the comparison a human supplies, so it\n/// carries its own actor and time and is never derived.\nmodel PharmacyParallelRunDailyEntry {\n  id                    String   @id @default(cuid())\n  organizationId        String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId              String\n  windowId              String\n  businessDate          DateTime @db.Date\n  legacySalesMinor      BigInt\n  legacyCashMinor       BigInt\n  legacyStockValueMinor BigInt\n  enteredByActorId      String\n  enteredAt             DateTime @default(now())\n  createdAt             DateTime @default(now())\n  updatedAt             DateTime @updatedAt\n\n  window PharmacyParallelRunWindow @relation(fields: [organizationId, windowId], references: [organizationId, id], onDelete: Restrict)\n\n  @@unique([organizationId, id], map: \"pharmacy_parallel_run_daily_entries_org_id_key\")\n  @@unique([organizationId, windowId, businessDate], map: \"pharmacy_parallel_run_daily_entries_org_window_date_key\")\n  @@index([organizationId, branchId, businessDate], map: \"pharmacy_parallel_run_daily_entries_org_branch_date_idx\")\n  @@map(\"pharmacy_parallel_run_daily_entries\")\n}\n\n/// MIG-04 \\u2014 one metric compared for one business date. \\`diffMinor\\` is stored\n/// rather than derived on read so the comparison a human explained is the\n/// comparison that stays explained. \\`explained\\` is only meaningful when the diff\n/// is material; an immaterial diff needs no note.\nmodel PharmacyParallelRunComparison {\n  id             String                    @id @default(cuid())\n  organizationId String                    @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId       String\n  windowId       String\n  businessDate   DateTime                  @db.Date\n  metric         PharmacyParallelRunMetric\n  devfathomMinor BigInt\n  legacyMinor    BigInt\n  diffMinor      BigInt\n  thresholdMinor BigInt\n  material       Boolean\n  explained      Boolean                   @default(false)\n  note           String?\n  actorId        String\n  comparedAt     DateTime                  @default(now())\n  createdAt      DateTime                  @default(now())\n  updatedAt      DateTime                  @updatedAt\n\n  window PharmacyParallelRunWindow @relation(fields: [organizationId, windowId], references: [organizationId, id], onDelete: Restrict)\n\n  @@unique([organizationId, id], map: \"pharmacy_parallel_run_comparisons_org_id_key\")\n  @@unique([organizationId, windowId, businessDate, metric], map: \"pharmacy_parallel_run_comparisons_org_window_date_metric_key\")\n  @@index([organizationId, branchId, businessDate], map: \"pharmacy_parallel_run_comparisons_org_branch_date_idx\")\n  @@map(\"pharmacy_parallel_run_comparisons\")\n}\n\n/// MIG-04 \\u2014 the immutable reference to the incumbent's archived data. The bytes\n/// are NOT stored: the hash proves the archive handed over is the archive\n/// referenced, exactly as MIG-01 treats a profiled source.\nmodel PharmacyLegacyArchive {\n  id                String   @id @default(cuid())\n  organizationId    String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId          String\n  label             String\n  /// SHA-256 of the archive, lowercase hex.\n  contentHash       String\n  /// Where the archive physically lives \\u2014 a URI, a vault path, a shelf.\n  storageLocation   String\n  byteSize          BigInt\n  archivedByActorId String\n  archivedAt        DateTime @default(now())\n  createdAt         DateTime @default(now())\n\n  cutoverEvents PharmacyCutoverEvent[]\n\n  @@unique([organizationId, id], map: \"pharmacy_legacy_archives_org_id_key\")\n  @@unique([organizationId, contentHash], map: \"pharmacy_legacy_archives_org_hash_key\")\n  @@index([organizationId, branchId, archivedAt], map: \"pharmacy_legacy_archives_org_branch_idx\")\n  @@map(\"pharmacy_legacy_archives\")\n}\n\n/// MIG-04 \\u2014 cutover and rollback as APPEND-ONLY events. Ownership of receipt\n/// numbering is the LATEST event's \\`sequenceOwner\\`, never a mutable flag: that is\n/// what makes \"rollback loses no cutover-window transactions\" structural rather\n/// than procedural. A rollback adds a row returning ownership to LEGACY; it\n/// deletes nothing, rewinds no sequence, and the sales issued while DevFathom\n/// owned the sequence keep their numbers.\nmodel PharmacyCutoverEvent {\n  id               String                   @id @default(cuid())\n  organizationId   String                   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId         String\n  kind             PharmacyCutoverEventKind\n  sequenceOwner    PharmacySequenceOwner\n  effectiveAt      DateTime\n  /// Only a CUTOVER defines one: the instant after which rollback is refused.\n  rollbackDeadline DateTime?\n  /// A ROLLBACK names the CUTOVER it reverses.\n  cutoverEventId   String?\n  legacyArchiveId  String?\n  actorId          String\n  reason           String\n  createdAt        DateTime                 @default(now())\n\n  legacyArchive PharmacyLegacyArchive? @relation(fields: [organizationId, legacyArchiveId], references: [organizationId, id], onDelete: Restrict)\n\n  @@unique([organizationId, id], map: \"pharmacy_cutover_events_org_id_key\")\n  @@index([organizationId, branchId, effectiveAt], map: \"pharmacy_cutover_events_org_branch_effective_idx\")\n  @@map(\"pharmacy_cutover_events\")\n}\n\nenum PharmacyRecordClass {\n  PRESCRIPTION\n  CONTROLLED_REGISTER\n  FISCAL\n  AUDIT\n}\n\nenum PharmacyLegalHoldEventKind {\n  PLACED\n  RELEASED\n}\n\n/// SAFE-04: effective-dated, append-only retention requirements by pharmacy record class.\nmodel PharmacyRetentionClass {\n  id              String              @id @default(cuid())\n  organizationId  String              @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  recordClass     PharmacyRecordClass\n  retentionDays   Int\n  effectiveFrom   DateTime\n  reason          String\n  createdByUserId String\n  createdAt       DateTime            @default(now())\n\n  @@unique([organizationId, recordClass, effectiveFrom])\n  @@index([organizationId, recordClass, effectiveFrom])\n  @@map(\"pharmacy_retention_classes\")\n}\n\n/// SAFE-04: append-only event stream; latest event determines whether a record is held.\nmodel PharmacyLegalHoldEvent {\n  id             String                     @id @default(cuid())\n  organizationId String                     @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  holdKey        String\n  recordClass    PharmacyRecordClass\n  recordId       String\n  kind           PharmacyLegalHoldEventKind\n  reason         String\n  actorUserId    String\n  createdAt      DateTime                   @default(now())\n\n  @@unique([organizationId, holdKey, createdAt])\n  @@index([organizationId, recordClass, recordId, createdAt])\n  @@map(\"pharmacy_legal_hold_events\")\n}\n\n// \\u2500\\u2500 PH-OFF \\u2014 the enrolled offline counter runtime (PRD \\xA76.9 OFF-01..03) \\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\n\n/// OFF-02: the actions the offline action matrix decides on. The allow/deny\n/// rule itself is a table in code (\\`src/lib/pharmacy/offline-action-matrix.ts\\`)\n/// with one test per row; this enum only names what that table must cover, and\n/// a test asserts the two lists are the same set.\nenum PharmacyOfflineAction {\n  SEARCH_CATALOG\n  SCAN_BARCODE\n  CASH_OTC_SALE\n  KHATA_SALE_WITHIN_CACHED_LIMIT\n  PERMITTED_REFUND\n  PROVISIONAL_CLOSE\n  CONTROLLED_MEDICINE_SALE\n  CATALOG_CHANGE\n  PRICE_CHANGE\n  RULE_CHANGE\n  UNVERIFIED_PRESCRIPTION_FILL\n}\n\nenum PharmacyDeviceKind {\n  PHARMACY_COUNTER\n}\n\nenum PharmacyDeviceStatus {\n  ACTIVE\n  REVOKED\n}\n\n/// OFF-01: what a signed snapshot covers. One kind per independently versioned\n/// payload, so a price refresh does not invalidate the cached licence state.\nenum PharmacyOfflineSnapshotKind {\n  CATALOG\n  PRICES\n  TAX\n  RULES\n  LICENCE\n  STAFF\n  LOT_BALANCES\n  CUSTOMER_CREDIT\n}\n\nenum PharmacyOfflineCommandStatus {\n  PENDING\n  ACCEPTED\n  REJECTED\n  DEAD\n}\n\n/// OFF-01 \\u2014 an enrolled pharmacy counter. Only the SHA-256 hash of the device\n/// secret is stored, and it is globally unique so the transport resolves the\n/// device in one indexed lookup before it knows the tenant. Revocation is a\n/// state, never a deletion.\nmodel PharmacyRegisteredDevice {\n  id                String               @id @default(cuid())\n  organizationId    String               @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId          String\n  name              String\n  kind              PharmacyDeviceKind   @default(PHARMACY_COUNTER)\n  deviceSecretHash  String               @unique(map: \"pharmacy_registered_devices_secret_hash_key\")\n  status            PharmacyDeviceStatus @default(ACTIVE)\n  revokedAt         DateTime?\n  lastSeenAt        DateTime?\n  enrolledByActorId String\n  createdAt         DateTime             @default(now())\n  updatedAt         DateTime             @updatedAt\n\n  branch    PharmacyBranch               @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)\n  snapshots PharmacyOfflineSnapshot[]\n  commands  PharmacyOfflineCommand[]\n  leases    PharmacyReceiptNumberLease[]\n  quotas    PharmacyDeviceLotQuota[]\n\n  @@unique([organizationId, id], map: \"pharmacy_registered_devices_org_id_key\")\n  @@unique([organizationId, branchId, id], map: \"pharmacy_registered_devices_org_branch_id_key\")\n  @@index([organizationId, branchId, status], map: \"pharmacy_registered_devices_org_branch_status_idx\")\n  @@map(\"pharmacy_registered_devices\")\n}\n\n/// OFF-01 \\u2014 a signed snapshot issued to one counter. Append-only: a refresh is a\n/// new version, never an edit, so a device can always say which envelope it\n/// verified. \\`payloadHash\\` binds the signature to an exact payload and the\n/// issued/expires window bounds how long the device may keep trusting it.\nmodel PharmacyOfflineSnapshot {\n  id              String                      @id @default(cuid())\n  organizationId  String                      @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId        String\n  deviceId        String\n  kind            PharmacyOfflineSnapshotKind\n  version         Int\n  payloadHash     String\n  signature       String\n  signingKeyId    String\n  issuedByActorId String\n  issuedAt        DateTime                    @default(now())\n  expiresAt       DateTime\n  createdAt       DateTime                    @default(now())\n\n  device PharmacyRegisteredDevice @relation(fields: [organizationId, branchId, deviceId], references: [organizationId, branchId, id], onDelete: Restrict)\n\n  @@unique([organizationId, id], map: \"pharmacy_offline_snapshots_org_id_key\")\n  @@unique([organizationId, deviceId, kind, version], map: \"pharmacy_offline_snapshots_device_version_key\")\n  @@index([organizationId, deviceId, kind, version(sort: Desc)], map: \"pharmacy_offline_snapshots_device_kind_idx\")\n  @@map(\"pharmacy_offline_snapshots\")\n}\n\n/// OFF-01 \\u2014 one entry of the append-only offline command log. \\`sequence\\` is the\n/// device's FIFO position and \\`idempotencyKey\\` is minted once at compose time\n/// and reused on every attempt, so a lost response resolves to one server-side\n/// effect. The identity columns are immutable and no row is ever deleted; only\n/// the replay bookkeeping advances, and only away from PENDING.\nmodel PharmacyOfflineCommand {\n  id              String                       @id @default(cuid())\n  organizationId  String                       @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId        String\n  deviceId        String\n  sequence        Int\n  idempotencyKey  String\n  action          PharmacyOfflineAction\n  payload         Json\n  payloadHash     String\n  /// Client-origin UTC instant, metadata only \\u2014 never an ordering input.\n  clientOriginAt  DateTime\n  receivedAt      DateTime                     @default(now())\n  status          PharmacyOfflineCommandStatus @default(PENDING)\n  attempts        Int                          @default(0)\n  nextAttemptAt   DateTime?\n  settledAt       DateTime?\n  serverRef       String?\n  /// The lease-issued number this command carried, if any. Immutable once set.\n  receiptNumber   Int?\n  rejectionReason String?\n  lastError       String?\n\n  device PharmacyRegisteredDevice @relation(fields: [organizationId, branchId, deviceId], references: [organizationId, branchId, id], onDelete: Restrict)\n\n  @@unique([organizationId, id], map: \"pharmacy_offline_commands_org_id_key\")\n  @@unique([organizationId, deviceId, idempotencyKey], map: \"pharmacy_offline_commands_device_key_key\")\n  @@unique([organizationId, deviceId, sequence], map: \"pharmacy_offline_commands_device_sequence_key\")\n  @@index([organizationId, deviceId, status, sequence], map: \"pharmacy_offline_commands_replay_idx\")\n  @@map(\"pharmacy_offline_commands\")\n}\n\n/// OFF-01 / \\xA78A invariant 16 \\u2014 a block of receipt numbers reserved for one\n/// counter BEFORE it goes offline, drawn from the same per-device sequence the\n/// online settlement path uses. \\`nextNumber\\` is the cursor within the block and\n/// only ever advances; \\`blockEnd + 1\\` marks an exhausted lease. Reconnect\n/// replays numbers that were already issued rather than assigning new ones.\nmodel PharmacyReceiptNumberLease {\n  id              String   @id @default(cuid())\n  organizationId  String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId        String\n  deviceId        String\n  blockStart      Int\n  blockEnd        Int\n  nextNumber      Int\n  issuedToActorId String\n  issuedAt        DateTime @default(now())\n\n  device PharmacyRegisteredDevice @relation(fields: [organizationId, branchId, deviceId], references: [organizationId, branchId, id], onDelete: Restrict)\n\n  @@unique([organizationId, id], map: \"pharmacy_receipt_number_leases_org_id_key\")\n  @@unique([organizationId, branchId, deviceId, blockStart], map: \"pharmacy_receipt_number_leases_block_key\")\n  @@map(\"pharmacy_receipt_number_leases\")\n}\n\n/// OFF-03 \\u2014 the units of one (lot, location) bucket a single counter owns while\n/// offline. The database guard keeps the sum of every device's OUTSTANDING quota\n/// for a bucket at or below what the bucket actually holds, so quotas partition\n/// branch stock instead of each counter holding an independent full-stock\n/// snapshot. A released quota keeps its row: what a counter was permitted to\n///