zationId], references: [id], onDelete: Cascade)\n  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)\n  branch       PharmacyBranch @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Cascade)\n\n  @@unique([organizationId, userId, branchId], map: \"pharmacy_owner_digest_settings_org_user_branch_key\")\n  @@index([enabled, nextDueAt], map: \"pharmacy_owner_digest_settings_due_idx\")\n  @@map(\"pharmacy_owner_digest_settings\")\n}\n\n/// Persistent CaptureChannel delivery. Unique business-date key makes cron\n/// retries idempotent while retaining exact RPT-01 metric keys and contracts.\nmodel PharmacyOwnerDigestCapture {\n  id             String   @id @default(cuid())\n  organizationId String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  userId         String\n  branchId       String\n  businessDate   String\n  rendered       String\n  metrics        Json\n  capturedAt     DateTime @default(now())\n\n  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)\n  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)\n  branch       PharmacyBranch @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Cascade)\n\n  @@unique([organizationId, userId, branchId, businessDate], map: \"pharmacy_owner_digest_captures_daily_key\")\n  @@index([organizationId, userId, capturedAt(sort: Desc)], map: \"pharmacy_owner_digest_captures_history_idx\")\n  @@map(\"pharmacy_owner_digest_captures\")\n}\n\nenum PharmacyMarketingChannel {\n  SMS\n  WHATSAPP\n  EMAIL\n}\n\nenum PharmacyCampaignStatus {\n  DRAFT\n  APPROVED\n  CAPTURED\n  REFUSED\n}\n\n/// MKT-01 \\u2014 operator-visible, versioned rule data. Application validation uses\n/// a retail-only allowlist and rejects every clinical/medicine key before write.\nmodel PharmacyMarketingSegment {\n  id              String   @id @default(cuid())\n  organizationId  String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId        String\n  name            String\n  definition      Json\n  version         Int      @default(1)\n  createdByUserId String\n  createdAt       DateTime @default(now())\n\n  @@unique([organizationId, id])\n  @@unique([organizationId, branchId, name, version])\n  @@map(\"pharmacy_marketing_segments\")\n}\n\nmodel PharmacyMarketingTemplate {\n  id               String                   @id @default(cuid())\n  organizationId   String                   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId         String\n  name             String\n  channel          PharmacyMarketingChannel\n  body             String\n  approvedByUserId String\n  approvedAt       DateTime\n  createdAt        DateTime                 @default(now())\n\n  @@unique([organizationId, id])\n  @@map(\"pharmacy_marketing_templates\")\n}\n\nmodel PharmacyCampaign {\n  id                    String                 @id @default(cuid())\n  organizationId        String                 @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId              String\n  name                  String\n  segmentId             String\n  templateId            String\n  scheduledAt           DateTime\n  quietHours            Json\n  frequencyCap          Json\n  promotesRegulatedItem Boolean                @default(false)\n  status                PharmacyCampaignStatus @default(DRAFT)\n  ownerApprovedByUserId String?\n  ownerApprovedAt       DateTime?\n  refusalReason         String?\n  createdAt             DateTime               @default(now())\n\n  @@unique([organizationId, id])\n  @@index([organizationId, branchId, scheduledAt])\n  @@map(\"pharmacy_campaigns\")\n}\n\n/// Capture mode only: records intended delivery; no provider delivery state exists.\nmodel PharmacyCampaignCapture {\n  id             String                   @id @default(cuid())\n  organizationId String                   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId       String\n  campaignId     String\n  customerId     String\n  channel        PharmacyMarketingChannel\n  idempotencyKey String\n  capturedAt     DateTime                 @default(now())\n\n  @@unique([organizationId, id])\n  @@unique([organizationId, idempotencyKey])\n  @@index([organizationId, branchId, campaignId, capturedAt])\n  @@map(\"pharmacy_campaign_captures\")\n}\n\nmodel PharmacyCampaignExclusion {\n  id             String   @id @default(cuid())\n  organizationId String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId       String\n  campaignId     String\n  customerId     String\n  reason         String\n  evidence       Json\n  evaluatedAt    DateTime @default(now())\n\n  @@unique([organizationId, id])\n  @@unique([organizationId, campaignId, customerId])\n  @@map(\"pharmacy_campaign_exclusions\")\n}\n\n/// MKT-02 / invariant 22 \\u2014 an explicitly estimated campaign\\u2192visit\\u2192receipt link.\nmodel PharmacyCampaignAttribution {\n  id                   String   @id @default(cuid())\n  organizationId       String   @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId             String\n  campaignId           String\n  visitId              String\n  receiptId            String\n  method               String\n  windowDays           Int\n  exclusions           Json\n  confidence           String\n  recoveredSalesMinor  Int\n  recoveredMarginMinor Int\n  messageCostMinor     Int\n  attributedAt         DateTime @default(now())\n\n  @@unique([organizationId, id])\n  @@unique([organizationId, campaignId, visitId, receiptId])\n  @@map(\"pharmacy_campaign_attributions\")\n}\n\nenum PharmacyAnomalySignalKind {\n  SHRINKAGE\n  DISCOUNT_OVERRIDE\n  GHOST_RETURN\n  CASH_VARIANCE\n  PURCHASE_PRICE_DRIFT\n}\n\nenum PharmacyAnomalySignalStatus {\n  OPEN\n  ACKNOWLEDGED\n  SNOOZED\n  CLOSED\n  STALE\n}\n\nenum PharmacyAnomalySignalSeverity {\n  NOTICE\n  REVIEW\n  URGENT\n}\n\nenum PharmacyAnomalySignalEventKind {\n  RAISED\n  REFRESHED\n  ACKNOWLEDGED\n  SNOOZED\n  CLOSED\n  MARKED_STALE\n}\n\n/// AI-04 / RPT-03 \\u2014 a deterministic review signal, never a staff score or an\n/// operational command. \\`scope\\`, \\`exactNumbers\\`, and the estimate metadata keep\n/// the evidence that produced the explanation auditable after ledgers advance.\nmodel PharmacyAnomalySignal {\n  id                   String                        @id @default(cuid())\n  organizationId       String                        @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId             String\n  kind                 PharmacyAnomalySignalKind\n  dedupKey             String\n  status               PharmacyAnomalySignalStatus   @default(OPEN)\n  severity             PharmacyAnomalySignalSeverity\n  scope                Json\n  policyVersion        String\n  exactNumbers         Json\n  explanation          String\n  dataWindowStart      DateTime\n  dataWindowEnd        DateTime\n  sourceObservedAt     DateTime\n  freshnessSeconds     Int\n  estimateMethod       String?\n  estimateWindow       String?\n  estimateExclusions   String?\n  estimateConfidence   String?\n  computedAt           DateTime\n  acknowledgedAt       DateTime?\n  acknowledgedByUserId String?\n  snoozedUntil         DateTime?\n  snoozeReason         String?\n  closedAt             DateTime?\n  markedStaleAt        DateTime?\n  createdAt            DateTime                      @default(now())\n  updatedAt            DateTime                      @updatedAt\n  events               PharmacyAnomalySignalEvent[]\n\n  @@unique([organizationId, id], map: \"pharmacy_anomaly_signals_org_id_key\")\n  @@unique([organizationId, branchId, id], map: \"pharmacy_anomaly_signals_org_branch_id_key\")\n  @@index([organizationId, branchId, status, computedAt(sort: Desc)], map: \"pharmacy_anomaly_signals_org_branch_status_idx\")\n  @@index([organizationId, branchId, kind, status], map: \"pharmacy_anomaly_signals_org_branch_kind_idx\")\n  @@map(\"pharmacy_anomaly_signals\")\n}\n\n/// Append-only human-decision and evaluator history for one AI-04 signal.\nmodel PharmacyAnomalySignalEvent {\n  id             String                         @id @default(cuid())\n  organizationId String                         @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId       String\n  signalId       String\n  kind           PharmacyAnomalySignalEventKind\n  actorId        String\n  reason         String?\n  detail         String?\n  createdAt      DateTime                       @default(now())\n  signal         PharmacyAnomalySignal          @relation(fields: [organizationId, branchId, signalId], references: [organizationId, branchId, id], onDelete: Restrict)\n\n  @@unique([organizationId, id], map: \"pharmacy_anomaly_signal_events_org_id_key\")\n  @@index([organizationId, branchId, signalId, createdAt], map: \"pharmacy_anomaly_signal_events_org_signal_idx\")\n  @@map(\"pharmacy_anomaly_signal_events\")\n}\n\nenum PharmacyPackAuthenticationSource {\n  RECEIVING\n  DISPENSING\n}\n\nenum PharmacyPackAuthenticationStatus {\n  VERIFIED\n  FLAGGED\n  NOT_VERIFIABLE\n  BLOCKED_RECALL\n}\n\n/// SAFE-05 \\u2014 one branch-scoped scan verdict. Non-recall failures are advisory;\n/// reasoned acknowledgement is retained on the immutable scan evidence.\nmodel PharmacyPackAuthenticationScan {\n  id                    String                            @id @default(cuid())\n  organizationId        String                            @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId              String\n  source                PharmacyPackAuthenticationSource\n  status                PharmacyPackAuthenticationStatus\n  gtin                  String?\n  batchNumber           String?\n  expiresOn             String?\n  serial                String?\n  medicineId            String?\n  manufacturingBatchId  String?\n  issues                String[]\n  explanation           String\n  advisory              Boolean\n  scannedByUserId       String\n  acknowledgedAt        DateTime?\n  acknowledgedByUserId  String?\n  acknowledgementReason String?\n  createdAt             DateTime                          @default(now())\n  events                PharmacyPackAuthenticationEvent[]\n\n  @@unique([organizationId, id], map: \"pharmacy_pack_authentication_scans_org_id_key\")\n  @@unique([organizationId, branchId, id], map: \"pharmacy_pack_authentication_scans_org_branch_id_key\")\n  @@index([organizationId, branchId, status, createdAt(sort: Desc)], map: \"pharmacy_pack_auth_scans_org_branch_status_idx\")\n  @@index([organizationId, serial], map: \"pharmacy_pack_auth_scans_org_serial_idx\")\n  @@map(\"pharmacy_pack_authentication_scans\")\n}\n\nenum PharmacyPackAuthenticationEventKind {\n  SCANNED\n  ACKNOWLEDGED\n}\n\nmodel PharmacyPackAuthenticationEvent {\n  id             String                              @id @default(cuid())\n  organizationId String                              @default(dbgenerated(\"current_setting('app.current_organization_id', true)\"))\n  branchId       String\n  scanId         String\n  kind           PharmacyPackAuthenticationEventKind\n  actorId        String\n  reason         String?\n  createdAt      DateTime                            @default(now())\n  scan           PharmacyPackAuthenticationScan      @relation(fields: [organizationId, branchId, scanId], references: [organizationId, branchId, id], onDelete: Restrict)\n\n  @@unique([organizationId, id], map: \"pharmacy_pack_authentication_events_org_id_key\")\n  @@index([organizationId, branchId, scanId, createdAt], map: \"pharmacy_pack_authentication_events_org_scan_idx\")\