/// FIN-01 / §8A invariant 15 — the shared double-entry journal. One entry per
/// operational event, named by `sourceKind` + `sourceId` so every posting is
/// traceable back to the row that caused it, and balanced by a DEFERRABLE
/// constraint trigger (debits = credits at COMMIT, not per statement, so an
/// adapter may write its legs one at a time).
///
/// APPEND-ONLY. Entries and lines are never updated or deleted (trigger). A
/// correction is a new entry whose `reversesEntryId` names the original and
/// whose lines are the originals with their sides swapped — additive, linked,
/// and at most once per entry.
model FinanceJournalEntry {
  id              String            @id @default(cuid())
  organizationId  String            @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  /// Null for an organization-level event. Line-level `branchId` is what the
  /// FIN-03 reads group by, because one entry (an inter-branch transfer) can
  /// legitimately span two branches.
  branchId        String?
  sourceKind      FinanceSourceKind
  /// The primary key of the operational row this entry accounts for.
  sourceId        String
  description     String
  currency        Currency          @default(PKR)
  actorId         String
  occurredAt      DateTime
  idempotencyKey  String
  reversesEntryId String?
  reversalReason  String?
  createdAt       DateTime          @default(now())

  reverses         FinanceJournalEntry?  @relation("FinanceEntryReversal", fields: [organizationId, reversesEntryId], references: [organizationId, id], onDelete: Restrict, map: "finance_journal_entries_reverses_fkey")
  reversal         FinanceJournalEntry[] @relation("FinanceEntryReversal")
  lines            FinanceJournalLine[]
  visibilityAnchor Organization          @relation("FinanceJournalEntryVisibilityAnchor", fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "finance_journal_entries_visibility_fkey")

  @@unique([organizationId, id], map: "finance_journal_entries_org_id_key")
  @@unique([organizationId, idempotencyKey], map: "finance_journal_entries_org_idempotency_key")
  @@unique([organizationId, reversesEntryId], map: "finance_journal_entries_org_reverses_key")
  @@index([organizationId, sourceKind, sourceId], map: "finance_journal_entries_org_source_idx")
  @@index([organizationId, branchId, occurredAt], map: "finance_journal_entries_org_branch_occurred_idx")
  @@map("finance_journal_entries")
}

/// One leg of a journal entry. `amountMinor` is a NON-NEGATIVE integer in minor
/// units; direction lives in `side`, so no leg is ever a signed amount whose
/// sign has to be interpreted. The dimension columns are deliberately plain
/// identifiers with no foreign key: the journal is shared across verticals and
/// must not depend on any one vertical's tables.
model FinanceJournalLine {
  id             String             @id @default(cuid())
  organizationId String             @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  entryId        String
  accountCode    FinanceAccountCode
  side           FinanceJournalSide
  amountMinor    Int
  branchId       String?
  /// FIN-03 analysis dimensions: product, stock lot, stock location, and the
  /// operational line this leg belongs to (a sale line, a receipt line).
  productId      String?
  lotId          String?
  locationId     String?
  sourceLineId   String?
  memo           String?
  createdAt      DateTime           @default(now())

  entry FinanceJournalEntry @relation(fields: [organizationId, entryId], references: [organizationId, id], onDelete: Restrict, map: "finance_journal_lines_entry_fkey")

  @@unique([organizationId, id], map: "finance_journal_lines_org_id_key")
  @@index([organizationId, entryId], map: "finance_journal_lines_org_entry_idx")
  @@index([organizationId, accountCode, branchId], map: "finance_journal_lines_org_account_branch_idx")
  @@index([organizationId, lotId, locationId], map: "finance_journal_lines_org_lot_location_idx")
  @@map("finance_journal_lines")
}

/// FIN-02 — one operator-entered money movement. All posted rows have a
/// balanced `FinanceJournalEntry`; reversal is additive and links that entry.
model PharmacyBookkeepingTransaction {
  id               String                    @id @default(cuid())
  organizationId   String                    @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  branchId         String
  reference        String
  kind             PharmacyBookkeepingKind
  status           PharmacyBookkeepingStatus @default(PENDING)
  counterpartyName String?
  amountMinor      Int
  currency         Currency                  @default(PKR)
  occurredAt       DateTime
  memo             String?
  chequeNumber     String?
  chequeDueAt      DateTime?
  chequeStatus     PharmacyChequeStatus      @default(NONE)
  bankReference    String?
  idempotencyKey   String
  createdByUserId  String
  postedAt         DateTime?
  reversedAt       DateTime?
  reversalReason   String?
  journalEntryId   String?
  reversalEntryId  String?
  createdAt        DateTime                  @default(now())

  allocations      PharmacyBookkeepingAllocation[]
  bankMatches      PharmacyBankReconciliation[]
  visibilityAnchor PharmacyBranch                  @relation("PharmacyBookkeepingTransactionVisibilityAnchor", fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "pharmacy_bookkeeping_transactions_visibility_fkey")

  @@unique([organizationId, id])
  @@unique([organizationId, reference])
  @@unique([organizationId, idempotencyKey])
