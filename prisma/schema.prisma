  ANONYMOUS // no authenticated identity (e.g. a failed login attempt)
  SYSTEM // an automated/internal process
}

enum AuditSource {
  TRPC // a tRPC procedure call (the in-app UI)
  REST_API // a /api/v1 call made with a df_ token
  AUTH // an authentication event (login/logout)
  SYSTEM // an internal/automated event
}

enum AuditOperation {
  CREATE
  READ
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  LOGIN_FAILED
  EXECUTE
  OTHER
}

enum AuditOutcome {
  SUCCESS
  FAILURE
}

