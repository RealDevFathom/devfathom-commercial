model PharmacyDailyClose {
  id                  String         @id @default(cuid())
  organizationId      String         @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  branchId            String
  businessDate        DateTime       @db.Date
  sequence            Int
  supersedesCloseId   String?
  reason              String?
  grossSalesMinor     Int
  refundTotalMinor    Int
  netSalesMinor       Int
  cashExpectedMinor   Int
  cashCountedMinor    Int
  cashVarianceMinor   Int
  controlledCountHook Json?
  sourceHash          String
  actorId             String
  /// MIG-05 — whether this close is final. False while the branch is still
  /// switching: the first DevFathom close only becomes final once the
  /// parallel-run comparison for it reconciles against the D05 threshold.
  /// Recorded on the close itself so the verdict is evidence, not a recomputation
  /// against thresholds that may since have moved.
  isFinal             Boolean        @default(false)
  createdAt           DateTime       @default(now())
  visibilityAnchor    PharmacyBranch @relation("PharmacyDailyCloseVisibilityAnchor", fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "pharmacy_daily_closes_visibility_fkey")

  @@unique([organizationId, id])
  @@unique([organizationId, branchId, businessDate, sequence])
  @@map("pharmacy_daily_closes")
}

