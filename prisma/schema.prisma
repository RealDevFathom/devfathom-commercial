/// Physical returns whose lot identity is unknown. Never part of AVAILABLE stock.
model PharmacyUnidentifiedReturnHold {
  id                   String                          @id @default(cuid())
  organizationId       String                          @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  branchId             String
  returnId             String
  saleLineId           String
  quarantineLocationId String
  canonicalUnits       Int
  integrityDecision    String
  actorId              String
  createdAt            DateTime                        @default(now())
  saleReturn           PharmacySaleReturn              @relation(fields: [organizationId, branchId, returnId], references: [organizationId, branchId, id], onDelete: Restrict, map: "return_hold_return_fk")
  saleLine             PharmacySaleLine                @relation(fields: [organizationId, branchId, saleLineId], references: [organizationId, branchId, id], onDelete: Restrict, map: "return_hold_line_fk")
  location             PharmacyStockLocation           @relation(fields: [organizationId, branchId, quarantineLocationId], references: [organizationId, branchId, id], onDelete: Restrict, map: "return_hold_location_fk")
  verificationTask     PharmacyReturnVerificationTask?

  @@unique([organizationId, branchId, id])
  @@unique([organizationId, returnId])
  @@index([organizationId, branchId, saleLineId])
  @@map("pharmacy_unidentified_return_holds")
}

/// One pharmacist task per physical holding, including repeated OTC returns.
/// Separate from the prescription sale-release queue; no uniqueness by sale line.
model PharmacyReturnVerificationTask {
  id                String                         @id @default(cuid())
  organizationId    String                         @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  branchId          String
  holdingId         String
  requestedByUserId String
  requestedAt       DateTime                       @default(now())
  holding           PharmacyUnidentifiedReturnHold @relation(fields: [organizationId, branchId, holdingId], references: [organizationId, branchId, id], onDelete: Restrict, map: "return_task_hold_fk")

  @@unique([organizationId, branchId, holdingId], map: "return_task_hold_key")
  @@index([organizationId, branchId, requestedAt])
  @@map("pharmacy_return_verification_tasks")
}

model UnfulfilledDemandEvent {
  id                    String                    @id @default(cuid())
  organizationId        String                    @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  branchId              String
  saleId                String?
  requestedMedicineId   String?
  requestedText         String?
  strength              String?
  form                  String?
  presentation          String?
  saleUnit              PharmacySaleUnit
  quantity              Int
  reason                PharmacyDemandReason
  inventoryRuleSnapshot Json
  estimatedValueMinor   Int?
  estimatedMarginMinor  Int?
  customerId            String?
  consentRecorded       Boolean                   @default(false)
  status                PharmacyDemandStatus      @default(OPEN)
  recoveredSaleLineId   String?
  recoveredAt           DateTime?
  closedAt              DateTime?
  capturedByUserId      String
  createdAt             DateTime                  @default(now())
  sale                  PharmacySale?             @relation(fields: [organizationId, branchId, saleId], references: [organizationId, branchId, id], onDelete: Restrict)
  medicine              Medicine?                 @relation(fields: [requestedMedicineId], references: [id], onDelete: Restrict)
  customer              PharmacyPatient?          @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: Restrict)
  restockInterests      PharmacyRestockInterest[]
  visibilityAnchor      PharmacyBranch            @relation("UnfulfilledDemandEventVisibilityAnchor", fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "pharmacy_unfulfilled_demand_events_visibility_fkey")

  @@unique([organizationId, id])
  @@index([organizationId, branchId, createdAt, reason])
  @@map("pharmacy_unfulfilled_demand_events")
}

/// DEM-03: an operator-created follow-up to one explicit POS-10 demand event.
model PharmacyRestockInterest {
  id                  String                        @id @default(cuid())
  organizationId      String                        @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  branchId            String
  demandEventId       String
  patientId           String?
  channel             PatientConsentChannel?
  reserveOnArrival    Boolean                       @default(false)
  quantityUnits       Int
  campaignKey         String?
  orderLineId         String?
  status              PharmacyRestockInterestStatus @default(OPEN)
  recoveredSaleId     String?
  recoveredSaleLineId String?
  recoveredAt         DateTime?
  createdByUserId     String
  createdAt           DateTime                      @default(now())
  updatedAt           DateTime                      @updatedAt

  demandEvent      UnfulfilledDemandEvent        @relation(fields: [organizationId, demandEventId], references: [organizationId, id], onDelete: Restrict)
  patient          PharmacyPatient?              @relation(fields: [organizationId, patientId], references: [organizationId, id], onDelete: Restrict)
  recoveredSale    PharmacySale?                 @relation("PharmacyRestockRecoverySale", fields: [organizationId, branchId, recoveredSaleId], references: [organizationId, branchId, id], onDelete: Restrict)
  reservation      PharmacyRestockReservation?
  notifications    PharmacyRestockNotification[]
  orderLine        PharmacyCustomerOrderLine?    @relation(fields: [organizationId, branchId, orderLineId], references: [organizationId, branchId, id], onDelete: Restrict)
  visibilityAnchor PharmacyBranch                @relation("PharmacyRestockInterestVisibilityAnchor", fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "pharmacy_restock_interests_visibility_fkey")

  @@unique([organizationId, id])
  @@unique([organizationId, branchId, demandEventId])
  @@unique([organizationId, branchId, id])
  @@index([organizationId, branchId, status, createdAt])
  @@index([organizationId, branchId, campaignKey, status])
  @@index([organizationId, branchId, orderLineId, status])
  @@map("pharmacy_restock_interests")
}

model PharmacyRestockReservation {
  id              String                           @id @default(cuid())
  organizationId  String                           @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  branchId        String
  interestId      String
  inventoryLotId  String
  stockLocationId String
  reservedUnits   Int
  status          PharmacyRestockReservationStatus @default(RESERVED)
  createdAt       DateTime                         @default(now())
  settledAt       DateTime?
  interest        PharmacyRestockInterest          @relation(fields: [organizationId, branchId, interestId], references: [organizationId, branchId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, branchId, interestId])
  @@index([organizationId, branchId, inventoryLotId, stockLocationId, status])
  @@map("pharmacy_restock_reservations")
}

model PharmacyRestockNotification {
  id             String                            @id @default(cuid())
  organizationId String                            @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  branchId       String
  interestId     String
  channel        PatientConsentChannel
  destination    String
  status         PharmacyRestockNotificationStatus @default(CAPTURED)
  consentId      String
  inventoryLotId String
  idempotencyKey String
  queuedAt       DateTime                          @default(now())
  sentAt         DateTime?
  providerMessageId String?
  lastError      String?
  cancelledAt    DateTime?
  interest       PharmacyRestockInterest           @relation(fields: [organizationId, branchId, interestId], references: [organizationId, branchId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, branchId, status, queuedAt])
  @@map("pharmacy_restock_notifications")
}

/// MKT-03/MKT-05: one authenticated customer proposal with either collection
/// or staff-runner delivery. Stock remains held by DEM-03 reservations until a
/// staff member explicitly starts the existing counter-sale checkout.
model PharmacyCustomerOrder {
  id                    String                           @id @default(cuid())
  organizationId        String                           @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  branchId              String
  customerId            String
  placedByUserId        String
  fulfillment           PharmacyCustomerOrderFulfillment
  status                PharmacyCustomerOrderStatus      @default(PROPOSED)
  intendedPaymentMethod PharmacyTenderType
  addressLine           String?
  city                  String?
  deliveryInstructions  String?
  runnerUserId          String?
  reservationExpiresAt  DateTime
  counterSaleId         String?
  acceptedAt            DateTime?
  packedAt              DateTime?
  readyAt               DateTime?
  outForDeliveryAt      DateTime?
  completedAt           DateTime?
  cancelledAt           DateTime?
  expiredAt             DateTime?
  createdAt             DateTime                         @default(now())
  updatedAt             DateTime                         @updatedAt

  branch      PharmacyBranch               @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)
  customer    PharmacyCustomer             @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: Restrict)
  placedBy    User                         @relation("PharmacyOrderPlacedBy", fields: [organizationId, placedByUserId], references: [organizationId, id], onDelete: Restrict)
  runner      User?                        @relation("PharmacyOrderRunner", fields: [organizationId, runnerUserId], references: [organizationId, id], onDelete: Restrict)
  counterSale PharmacySale?                @relation(fields: [organizationId, branchId, counterSaleId], references: [organizationId, branchId, id], onDelete: Restrict)
  lines       PharmacyCustomerOrderLine[]
  events      PharmacyCustomerOrderEvent[]

  deliveryEvidence PharmacyOrderDeliveryEvidence[]

  @@unique([organizationId, id])
  @@unique([organizationId, branchId, id])
  @@unique([organizationId, branchId, counterSaleId])
  @@index([organizationId, customerId, createdAt])
  @@index([organizationId, branchId, status, createdAt])
  @@index([organizationId, reservationExpiresAt, status])
  @@map("pharmacy_customer_orders")
}

model PharmacyCustomerOrderLine {
  id                        String           @id @default(cuid())
  organizationId            String           @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  branchId                  String
  orderId                   String
  medicineId                String
  presentationId            String
  packLevelId               String
  saleUnit                  PharmacySaleUnit
  quantity                  Int
  canonicalUnitsPerSaleUnit Int
  canonicalUnits            Int
  unitPriceMinor            Int
  lineTotalMinor            Int
  createdAt                 DateTime         @default(now())

  order        PharmacyCustomerOrder     @relation(fields: [organizationId, branchId, orderId], references: [organizationId, branchId, id], onDelete: Restrict)
  medicine     Medicine                  @relation(fields: [organizationId, medicineId], references: [organizationId, id], onDelete: Restrict)
  presentation Presentation              @relation(fields: [presentationId], references: [id], onDelete: Restrict)
  packLevel    PackLevel                 @relation(fields: [packLevelId], references: [id], onDelete: Restrict)
  interests    PharmacyRestockInterest[]

  @@unique([organizationId, id])
  @@unique([organizationId, branchId, id])
  @@index([organizationId, branchId, orderId])
  @@map("pharmacy_customer_order_lines")
}

model PharmacyCustomerOrderEvent {
  id             String                         @id @default(cuid())
  organizationId String                         @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  branchId       String
  orderId        String
  kind           PharmacyCustomerOrderEventKind
  fromStatus     PharmacyCustomerOrderStatus?
  toStatus       PharmacyCustomerOrderStatus
  actorUserId    String
  detail         Json?
  occurredAt     DateTime                       @default(now())

  order PharmacyCustomerOrder @relation(fields: [organizationId, branchId, orderId], references: [organizationId, branchId, id], onDelete: Restrict)
  actor User                  @relation("PharmacyOrderEventActor", fields: [organizationId, actorUserId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, branchId, orderId, occurredAt])
  @@map("pharmacy_customer_order_events")
}

/// INV-05 seam / INV-01: a branch-owned storage place. `coldChain` marks the
/// validated cold-chain zones a cold-chain medicine may be put away into.
model PharmacyStockLocation {
  id                                        String                    @id @default(cuid())
  organizationId                            String                    @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  branchId                                  String
  code                                      String
  name                                      String
  kind                                      PharmacyStockLocationKind
  coldChain                                 Boolean                   @default(false)
  minimumTemperatureC                       Float?
  maximumTemperatureC                       Float?
  expectedTemperatureReadingIntervalMinutes Int                       @default(15)
  temperatureExcursionDurationMinutes       Int                       @default(30)
  active                                    Boolean                   @default(true)
  createdAt                                 DateTime                  @default(now())
  updatedAt                                 DateTime                  @updatedAt

  purchaseReturnLines     PharmacyPurchaseReturnLine[]
  stockSignals            PharmacyStockSignal[]
  receiptLines            PharmacyGoodsReceiptLine[]   @relation("PharmacyReceiptStock")
  quarantinedReceiptLines PharmacyGoodsReceiptLine[]   @relation("PharmacyReceiptQuarantine")
  branch                  PharmacyBranch               @relation("PharmacyBranchStockLocations", fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)
  movements               PharmacyStockMovement[]
  balances                PharmacyStockBalance[]
  discrepancies           PharmacyStockDiscrepancy[]
  deviceQuotas            PharmacyDeviceLotQuota[]
  temperatureLogs         PharmacyTemperatureLog[]
  unidentifiedReturnHolds PharmacyUnidentifiedReturnHold[]

  @@unique([organizationId, id], map: "pharmacy_stock_locations_org_id_key")
  @@unique([organizationId, branchId, id], map: "pharmacy_stock_locations_org_branch_id_key")
  @@unique([organizationId, branchId, code], map: "pharmacy_stock_locations_org_branch_code_key")
  @@index([organizationId, branchId], map: "pharmacy_stock_locations_org_branch_idx")
  @@map("pharmacy_stock_locations")
}

enum PharmacyTemperatureReadingSource {
  MANUAL
  IMPORT
}

/// INV-05: immutable storage-zone temperature evidence. Staff entry and
/// data-logger files append through the same source seam; live devices remain
/// outside this boundary.
model PharmacyTemperatureLog {
  id               String                           @id @default(cuid())
  organizationId   String                           @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  branchId         String
  stockLocationId  String
  actorId          String
  temperatureC     Float
  recordedAt       DateTime
  outOfRange       Boolean
  source           PharmacyTemperatureReadingSource @default(MANUAL)
  deviceIdentifier String?
  createdAt        DateTime                         @default(now())

  location PharmacyStockLocation @relation(fields: [organizationId, branchId, stockLocationId], references: [organizationId, branchId, id], onDelete: Restrict)

  @@unique([organizationId, id], map: "pharmacy_temperature_logs_org_id_key")
  @@index([organizationId, branchId, stockLocationId, recordedAt], map: "pharmacy_temperature_logs_zone_time_idx")
  @@map("pharmacy_temperature_logs")
}

/// §8A invariant 18: the manufacturer's batch. Organization-scoped, not
/// branch-scoped, because recall and batch-level quarantine apply globally at
/// batch/product scope while quarantine and damage may apply to part of one lot.
model PharmacyManufacturingBatch {
  id              String                  @id @default(cuid())
  organizationId  String                  @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  medicineId      String
  batchNumber     String
  expiresAt       DateTime
  expiryPrecision PharmacyExpiryPrecision @default(DAY)
  state           PharmacyBatchState      @default(ACTIVE)
  stateReason     String?
  stateChangedAt  DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  medicine Medicine               @relation(fields: [organizationId, medicineId], references: [organizationId, id], onDelete: Restrict)
  lots     PharmacyInventoryLot[]

  @@unique([organizationId, id], map: "pharmacy_manufacturing_batches_org_id_key")
  @@unique([organizationId, medicineId, batchNumber], map: "pharmacy_manufacturing_batches_org_medicine_number_key")
  @@index([organizationId, expiresAt], map: "pharmacy_manufacturing_batches_org_expiry_idx")
  @@map("pharmacy_manufacturing_batches")
}

/// INV-01: the receipt-specific lot — one supplier, one invoice, one landed
/// cost, one printed MRP, one received expiry precision. `receivedAt` is null
/// until the goods actually arrive, and unreceived stock cannot move (INV-03).
model PharmacyInventoryLot {
  id                      String                  @id @default(cuid())
  organizationId          String                  @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  branchId                String
  manufacturingBatchId    String
  packLevelId             String
  /// Canonical base units in one sealed pack of this lot, resolved from the
  /// MED-02 pack hierarchy at receipt and frozen with it.
  unitsPerPack            Int
  supplierName            String
  supplierInvoiceRef      String
  unitCostMinor           Int
  printedMrpMinor         Int
  receivedExpiresAt       DateTime
  receivedExpiryPrecision PharmacyExpiryPrecision
  receivedAt              DateTime?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  batch     PharmacyManufacturingBatch @relation(fields: [organizationId, manufacturingBatchId], references: [organizationId, id], onDelete: Restrict)
  packLevel PackLevel                  @relation(fields: [organizationId, packLevelId], references: [organizationId, id], onDelete: Restrict)
  branch    PharmacyBranch             @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)

  saleAllocations PharmacySaleLineAllocation[]
  returnLines     PharmacySaleReturnLine[]

  movements                PharmacyStockMovement[]
  balances                 PharmacyStockBalance[]
  discrepancies            PharmacyStockDiscrepancy[]
  recommendedBy            PharmacyAllocationOverride[]      @relation("PharmacyAllocationRecommended")
  selectedBy               PharmacyAllocationOverride[]      @relation("PharmacyAllocationSelected")
  receiptLines             PharmacyGoodsReceiptLine[]
  countLines               PharmacyInventoryCountLine[]
  transferLines            PharmacyInterbranchTransferLine[] @relation("PharmacyTransferSourceLot")
  supplierClaims           PharmacySupplierClaim[]
  purchaseReturnLines      PharmacyPurchaseReturnLine[]
  deviceQuotas             PharmacyDeviceLotQuota[]
  pharmacovigilanceReports PharmacyPharmacovigilanceReport[]

  @@unique([organizationId, id], map: "pharmacy_inventory_lots_org_id_key")
  @@unique([organizationId, branchId, id], map: "pharmacy_inventory_lots_org_branch_id_key")
  @@unique([organizationId, supplierName, supplierInvoiceRef, manufacturingBatchId], map: "pharmacy_inventory_lots_org_invoice_key")
  @@index([organizationId, branchId, manufacturingBatchId], map: "pharmacy_inventory_lots_org_branch_batch_idx")
  @@map("pharmacy_inventory_lots")
}

model PharmacyInventoryCount {
  id                String                       @id @default(cuid())
  organizationId    String                       @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  branchId          String
  status            PharmacyInventoryCountStatus @default(OPEN)
  varianceThreshold Int
  createdById       String
  approvedById      String?
  createdAt         DateTime                     @default(now())
  approvedAt        DateTime?
  lines             PharmacyInventoryCountLine[]

  @@unique([organizationId, id])
  @@index([organizationId, branchId, createdAt])
  @@map("pharmacy_inventory_counts")
}

model PharmacyInventoryCountLine {
  id                  String                 @id @default(cuid())
  organizationId      String                 @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  countId             String
  branchId            String
  inventoryLotId      String
  stockLocationId     String
  expectedUnits       Int
  expectedSealedPacks Int
  expectedLooseUnits  Int
  countedSealedPacks  Int?
  countedLooseUnits   Int?
  countedUnits        Int?
  varianceUnits       Int?
  count               PharmacyInventoryCount @relation(fields: [organizationId, countId], references: [organizationId, id], onDelete: Restrict)
  lot                 PharmacyInventoryLot   @relation(fields: [organizationId, branchId, inventoryLotId], references: [organizationId, branchId, id], onDelete: Restrict)

