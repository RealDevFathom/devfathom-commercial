// ============================================
// HOSPITALITY — PROP-01 property registry
// ============================================

/// HSP-MODE (PRD §5.16 / MODE-01). The mode selects DEFAULTS — inventory kinds,
/// billing cycles, day-use, function spaces, booking-engine layout, report set.
/// It is configuration: no code path outside the defaults/packaging layer may
/// branch on it, and any mode can enable any feature it is licensed for.
enum HotelPropertyMode {
  HOTEL
  HOSTEL
  APARTMENT
  RESORT
  VENUE
}

/// PROP-01 (`05-data-model` §1.1). In hospitality the **branch IS the property**,
/// so this row is both: `branchId` is the property's own identity and every other
/// hotel table hangs off it, exactly as `pharmacy_branches` anchors the pharmacy
/// vertical. There is deliberately no separate `hotel_branches` table — a second
/// row per property would let the branch registry and the property facts disagree.
///
/// `name`, `addressLine`, `city` and `timezone` are not in the pack's column list
/// because the pack assumes a branch row already carries them; since this table is
/// that row, it carries them. Everything else is the pack's §1.1 list verbatim.
///
/// Money is PKR minor units across the vertical, so `currency` defaults to PKR and
/// is recorded here rather than inferred from the organization.
model HotelProperty {
  /// The property's identity. Named `branchId` because every branch-scoped hotel
  /// table references it as its branch, and no id is generated twice.
  branchId       String            @id @default(cuid())
  organizationId String            @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  name           String
  addressLine    String
  city           String
  /// IANA zone. A property dates its own business days, audits and cut-offs.
  timezone       String
  mode           HotelPropertyMode @default(HOTEL)
  /// Explicit configuration only; null keeps the selected mode's defaults.
  modeOverrides  Json?
  /// 1–7 where the property publishes one; null while it is unrated (H-D14).
  starCategory   Int?
  /// 24-hour local times, as `HH:MM`, in this property's timezone.
  checkInTime    String            @default("14:00")
  checkOutTime   String            @default("12:00")
  /// When the night audit rolls the business date (HSP-NA).
  auditTime      String            @default("03:00")
  currency       String            @default("PKR")
  /// The platform tax profile the property posts against. Nullable because a
  /// property is created before it is attached — and the onboarding checklist
  /// refuses go-live while it is null.
  taxProfileId   String?
  languages      String[]          @default(["en", "ur"])
  /// RATE-03 overbook allowance policy. `{}` until a rates lane writes it.
  overbookPolicy Json              @default("{}")
  /// The public booking-engine path segment. Unique per organization so two
  /// properties of one chain can never publish the same direct-booking URL.
  bookingEngineSlug String
  /// UPS-04 journey template settings (quiet hours, consent, per-language copy).
  journeySettings      Json @default("{}")
  /// MEAL-01 reporting allocation between room and F&B revenue. Reporting only —
  /// postings never change (metric contract §5).
  mealAllocationPolicy Json @default("{}")
  /// HSP-NA business-date policy (roll rule, late-arrival handling).
  businessDatePolicy   Json @default("{}")
  active               Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  extras HotelExtra[]
  assignments HotelPropertyAssignment[]
  roomTypes        HotelRoomType[]
  rooms            HotelRoom[]
  beds             HotelBed[]
  roomStatusEvents HotelRoomStatusEvent[]
  roomBlocks       HotelRoomBlock[]
  mealPlans        HotelMealPlan[]
  functionSpaces   HotelFunctionSpace[]
  journeyTemplates HotelJourneyTemplate[]

  @@unique([organizationId, branchId], map: "hotel_properties_org_branch_key")
  @@unique([organizationId, bookingEngineSlug], map: "hotel_properties_org_slug_key")
  @@index([organizationId, active], map: "hotel_properties_org_active_idx")
  @@map("hotel_properties")
}

/// PROP-04: an explicit, revocable role at one property. No implied Owner scope.
model HotelPropertyAssignment {
  id                 String   @id @default(cuid())
  organizationId     String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  branchId           String
  userId             String
  organizationRoleId String
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  property HotelProperty    @relation(fields: [organizationId, branchId], references: [organizationId, branchId], onDelete: Cascade, map: "hotel_property_assignments_property_fkey")
  user     User             @relation(fields: [organizationId, userId], references: [organizationId, id], onDelete: Cascade, map: "hotel_property_assignments_user_fkey")
  role     OrganizationRole @relation(fields: [organizationId, organizationRoleId], references: [organizationId, id], onDelete: Restrict, map: "hotel_property_assignments_role_fkey")

  @@unique([organizationId, branchId, userId], map: "hotel_property_assignments_org_branch_user_key")
  @@index([organizationId, userId, active])
  @@map("hotel_property_assignments")
}

// ============================================
// HOSPITALITY — PROP-05 extras and services catalog
// ============================================

/// The posting department a hospitality charge belongs to. One closed vocabulary
/// for the whole vertical, because three contracts group by it: "revenue by
/// department" on the owner dashboard, the month-end pack's revenue split, and
/// the API-03 GL mapping (`department/tax_class/tender_kind → gl_account`). A
/// free-text department would let one typo split a report line in two.
///
/// The names come from the pack rather than from a generic ledger: `DAY_USE` is
/// its own department and never enters ADR/RevPAR (metric contract §5), `NO_SHOW`
/// and `CANCELLATION` are their own revenue departments, and `UTILITIES` is what
/// RSV-09's recurring long-stay charges post to.
enum HotelDepartment {
  ROOMS
  DAY_USE
  FOOD_BEVERAGE
  MINIBAR
  LAUNDRY
  SPA
  TRANSPORT
  TELEPHONE
  BUSINESS_CENTRE
  BANQUET
  UTILITIES
  NO_SHOW
  CANCELLATION
  MISCELLANEOUS
}

/// PROP-05 ★ — how often a catalog item posts against a stay. `NONE` is a one-off
/// charge an operator posts by hand; the rest are the shapes RSV-09's periodic
/// posting understands. `PER_PERIOD` follows the rate plan's billing cycle
/// (weekly/monthly), which is why it is meaningless against a nightly one.
enum HotelExtraRecurrence {
  NONE
  PER_NIGHT
  PER_STAY
  PER_PERSON
  PER_PERIOD
}

/// PROP-05 (`05-data-model` §1.1). The catalog every folio charge references —
/// "every folio charge references a catalog item or a manual reason" is PROP-05's
/// acceptance criterion, so this table is the named half of that rule.
///
/// Scoped to a property (`branchId`) rather than to the organization: a chain's
/// two properties price their laundry differently and post it to their own
/// departments, and `code` is unique per property for exactly that reason.
///
/// Money is PKR minor units. `upsellPriceMinor` is the pre-arrival offer price of
/// UPS-01 and is null when the offer is made at the shelf price; the database
/// refuses it on an item that is not `upsellable` at all, so a catalog cannot
/// carry an offer price nothing can ever offer.
model HotelExtra {
  id             String @id @default(cuid())
  organizationId String @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  /// The property this catalog belongs to — `hotel_properties.branchId`.
  branchId       String
  /// The operator-visible short code, unique within the property.
  code           String
  name           String
  /// Urdu name, where the property publishes one (the vertical is bilingual).
  nameUr         String?
  /// Shelf price in PKR minor units.
  priceMinor     Int
  /// The tax class the property's tax profile prices this charge at. A free code
  /// rather than an enum because the classes belong to the tax profile, which is
  /// per-jurisdiction and effective-dated; the catalog only names one.
  taxClass       String
  department     HotelDepartment
  /// FOL-01 posting instructions (folio target, when the charge lands, whether
  /// the price includes tax). Shape owned by the folio lane; `{}` until then.
  postingRule    Json    @default("{}")
  /// UPS-01: may this item be offered before arrival?
  upsellable     Boolean @default(false)
  /// The offer price, when it differs from the shelf price. Requires `upsellable`.
  upsellPriceMinor Int?
  recurring        HotelExtraRecurrence @default(NONE)
  active           Boolean              @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  property HotelProperty @relation(fields: [organizationId, branchId], references: [organizationId, branchId], onDelete: Cascade, map: "hotel_extras_property_fkey")

  @@unique([organizationId, id], map: "hotel_extras_org_id_key")
  @@unique([organizationId, branchId, code], map: "hotel_extras_org_branch_code_key")
  @@index([organizationId, branchId, active], map: "hotel_extras_org_branch_active_idx")
  @@index([organizationId, branchId, department], map: "hotel_extras_org_branch_department_idx")
  @@map("hotel_extras")
}

// ============================================
// HOSPITALITY — PROP-02 / PROP-03 / HK-03 inventory (H1-03)
// ============================================

/// PROP-02. What a type sells: a whole room, one berth in a shared room, or a
/// self-contained unit. A BED type declares `bedsPerRoom`; the others must not.
enum HotelInventoryKind {
  ROOM
  BED
  UNIT
}

/// PROP-03's six room states, exactly as the PRD lists them. `OCCUPIED` is owned
/// by the stay: it is reached by checking a guest in and left by checking out or
/// moving, never from the housekeeping board — the database refuses it too.
enum HotelRoomStatus {
  VACANT_CLEAN
  VACANT_DIRTY
  OCCUPIED
  INSPECTED
  OUT_OF_ORDER
  OUT_OF_SERVICE
}

/// HK-03. Out of order is broken; out of service is deliberately withheld. Both
/// reduce availability; the distinction tells an incident from a decision.
enum HotelRoomBlockKind {
  OUT_OF_ORDER
  OUT_OF_SERVICE
}

/// MODE-02 dorm policy. `ANY` means "no restriction", not "not yet decided".
enum HotelGenderPolicy {
  ANY
  MALE
  FEMALE
}

/// PROP-02 (`05-data-model` §1.1). A sellable class of inventory: its occupancy
/// limits, its bed configuration, where it sits in the upgrade ladder and, for a
/// HOSTEL, how many berths a room of this type holds.
///
/// `@@unique([id, inventoryKind])` exists only to be a foreign-key target: a room
/// carries its type's kind as a column and keys into the pair, so the two can
/// never drift apart and `HotelBed` can require a BED room structurally. The
/// migration's structure guard keeps `inventoryKind` and `bedsPerRoom` immutable
/// once the type exists, and the CHECKs on code, occupancy and bed count are
/// SQL-only.
model HotelRoomType {
  id             String             @id @default(cuid())
  organizationId String             @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  branchId       String
  /// Upper-case token, unique within the property. It travels to rate plans,
  /// channel mappings and imports.
  code           String
  name           String
  /// Bilingual per the pack; optional so an untranslated type is still sellable.
  nameUr         String?
  inventoryKind  HotelInventoryKind @default(ROOM)
  /// Berths per room. Required for BED, forbidden otherwise (DB CHECK).
  bedsPerRoom    Int?
  description    String?
  baseAdults     Int                @default(1)
  maxAdults      Int                @default(2)
  maxChildren    Int                @default(0)
  /// Free text, e.g. "1 king" or "2 twin". Rendered, never parsed.
  bedConfig      String?
  amenities      String[]           @default([])
  images         String[]           @default([])
  /// Upgrade ladder position; higher is better, equal ranks are the same tier.
  upgradeRank    Int                @default(0)
  sort           Int                @default(0)
  /// Retired types keep their rooms and their history; they take no new rooms.
  active         Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  property    HotelProperty @relation(fields: [organizationId, branchId], references: [organizationId, branchId], onDelete: Restrict, map: "hotel_room_types_property_fkey")
  rooms       HotelRoom[]   @relation("HotelRoomTypeScoped")
  roomsByKind HotelRoom[]   @relation("HotelRoomTypeKind")

  @@unique([organizationId, branchId, id], map: "hotel_room_types_scope_key")
  @@unique([organizationId, branchId, code], map: "hotel_room_types_org_branch_code_key")
  @@unique([id, inventoryKind], map: "hotel_room_types_id_kind_key")
  @@map("hotel_room_types")
}

/// PROP-03. One table for rooms, dorm rooms and units: they differ by their
/// type's `inventoryKind`, not by being different entities.
///
/// `status` is the current state only; its history is `HotelRoomStatusEvent`,
/// which the database writes itself on every change. The status triggers take
/// the actor from `app.current_user_id` and the reason from
/// `app.hotel_inventory_reason`, so `statusChangedBy` is never caller-chosen,
/// and the transition matrix (`hotel_inventory_transition_allowed`) is enforced
/// in SQL as well as in `src/lib/hotel/inventory.ts`.
model HotelRoom {
  id               String             @id @default(cuid())
  organizationId   String             @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  branchId         String
  roomTypeId       String
  /// Denormalized from the type and held there by the composite foreign key.
  /// Never written on its own.
  inventoryKind    HotelInventoryKind
  number           String
  floor            String?
  features         String[]           @default([])
  connectingRoomId String?
  /// Only meaningful for BED inventory; the DB refuses anything else.
  genderPolicy     HotelGenderPolicy  @default(ANY)
  /// A room is commissioned dirty: nothing is sellable until housekeeping says so.
  status           HotelRoomStatus    @default(VACANT_DIRTY)
  statusChangedAt  DateTime           @default(now())
  /// The acting user behind the current status, set by the status trigger.
  statusChangedBy  String
  active           Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  property       HotelProperty          @relation(fields: [organizationId, branchId], references: [organizationId, branchId], onDelete: Restrict, map: "hotel_rooms_property_fkey")
  roomType       HotelRoomType          @relation("HotelRoomTypeScoped", fields: [organizationId, branchId, roomTypeId], references: [organizationId, branchId, id], onDelete: Restrict, map: "hotel_rooms_type_fkey")
  /// The kind pin: `(roomTypeId, inventoryKind)` must be a real type row.
  roomTypeKind   HotelRoomType          @relation("HotelRoomTypeKind", fields: [roomTypeId, inventoryKind], references: [id, inventoryKind], onDelete: Restrict, map: "hotel_rooms_type_kind_fkey")
  connectingRoom HotelRoom?             @relation("HotelConnectingRooms", fields: [organizationId, branchId, connectingRoomId], references: [organizationId, branchId, id], onDelete: Restrict, map: "hotel_rooms_connecting_fkey")
  connectedRooms HotelRoom[]            @relation("HotelConnectingRooms")
  beds           HotelBed[]             @relation("HotelBedRoomScoped")
  bedsByKind     HotelBed[]             @relation("HotelBedRoomKind")
  statusEvents   HotelRoomStatusEvent[]
  blocks         HotelRoomBlock[]

  @@unique([organizationId, branchId, id], map: "hotel_rooms_scope_key")
  @@unique([organizationId, branchId, number], map: "hotel_rooms_org_branch_number_key")
  @@unique([id, inventoryKind], map: "hotel_rooms_id_kind_key")
  @@index([organizationId, branchId, roomTypeId], map: "hotel_rooms_type_idx")
  @@index([organizationId, branchId, status], map: "hotel_rooms_branch_status_idx")
  @@map("hotel_rooms")
}

/// MODE-02. A berth in a dorm room. Exists only under a BED room type —
/// `roomInventoryKind` is pinned to BED by a CHECK and is half of the key into
/// the room, so the database, not a resolver, is what enforces that — and never
/// beyond the type's `bedsPerRoom` (the structure guard counts under the room's
/// lock). A room's occupancy is **derived** by counting these (invariant 22).
model HotelBed {
  id                String             @id @default(cuid())
  organizationId    String             @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  branchId          String
  roomId            String
  roomInventoryKind HotelInventoryKind @default(BED)
  label             String
  status            HotelRoomStatus    @default(VACANT_DIRTY)
  statusChangedAt   DateTime           @default(now())
  statusChangedBy   String
  active            Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  property     HotelProperty          @relation(fields: [organizationId, branchId], references: [organizationId, branchId], onDelete: Restrict, map: "hotel_beds_property_fkey")
  room         HotelRoom              @relation("HotelBedRoomScoped", fields: [organizationId, branchId, roomId], references: [organizationId, branchId, id], onDelete: Cascade, map: "hotel_beds_room_fkey")
  roomKind     HotelRoom              @relation("HotelBedRoomKind", fields: [roomId, roomInventoryKind], references: [id, inventoryKind], onDelete: Cascade, map: "hotel_beds_room_kind_fkey")
  statusEvents HotelRoomStatusEvent[]

  @@unique([organizationId, branchId, roomId, id], map: "hotel_beds_scope_key")
  @@unique([roomId, label], map: "hotel_beds_room_label_key")
  @@map("hotel_beds")
}

/// PROP-03 / HK-01 — the append-only status ledger. Written only by the status
/// triggers (so `id` has a database default), never updated, and deleted only by
/// the sanctioned tenant purge. The client has no reason to create one: a
/// direct insert is refused by the event guard whatever the tenant.
model HotelRoomStatusEvent {
  id             String           @id @default(dbgenerated("(gen_random_uuid())::text"))
  organizationId String           @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  branchId       String
  roomId         String
  /// Set when one berth changed rather than the whole room.
  bedId          String?
  /// Null on the line that records the state a room was created in.
  fromStatus     HotelRoomStatus?
  toStatus       HotelRoomStatus
  /// The acting user. Never null — HK-01 is "every change attributed".
  actorId        String
  reason         String
  createdAt      DateTime         @default(now())

  property HotelProperty @relation(fields: [organizationId, branchId], references: [organizationId, branchId], onDelete: Restrict, map: "hotel_room_status_events_property_fkey")
  room     HotelRoom     @relation(fields: [organizationId, branchId, roomId], references: [organizationId, branchId, id], onDelete: Cascade, map: "hotel_room_status_events_room_fkey")
  bed      HotelBed?     @relation(fields: [organizationId, branchId, roomId, bedId], references: [organizationId, branchId, roomId, id], onDelete: Cascade, map: "hotel_room_status_events_bed_fkey")

  @@index([organizationId, branchId, roomId, createdAt], map: "hotel_room_status_events_history_idx")
  @@map("hotel_room_status_events")
}

/// HK-03. An out-of-order or out-of-service range on one room, half-open
/// `[startDate, endDate)`. Two *live* blocks may not overlap on a room — a gist
/// exclusion constraint the migration declares and Prisma cannot express — so
/// availability can subtract them without deduplicating first.
///
/// Releasing sets the three `release*` columns (all or none, by CHECK) and leaves
/// the row in place; the block guard attributes creation and release to the
/// acting user and refuses every other change and every delete outside the
/// sanctioned purge.
model HotelRoomBlock {
  id             String             @id @default(cuid())
  organizationId String             @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  branchId       String
  roomId         String
  kind           HotelRoomBlockKind
  startDate      DateTime           @db.Date
  endDate        DateTime           @db.Date
  reason         String
  /// MNT-03's link to the work order that caused the block. Text, because work
  /// orders arrive in a later lane.
  workOrderRef   String?
  createdBy      String
  createdAt      DateTime           @default(now())
  releasedAt     DateTime?
  releasedBy     String?
  releaseReason  String?

  property HotelProperty @relation(fields: [organizationId, branchId], references: [organizationId, branchId], onDelete: Restrict, map: "hotel_room_blocks_property_fkey")
  room     HotelRoom     @relation(fields: [organizationId, branchId, roomId], references: [organizationId, branchId, id], onDelete: Restrict, map: "hotel_room_blocks_room_fkey")

  @@index([organizationId, branchId, roomId], map: "hotel_room_blocks_room_idx")
  @@map("hotel_room_blocks")
}

/// MEAL-01 (`05-data-model` §1.2). The meal plans a property sells: EP, CP, MAP,
/// AP and any custom plan it invents. A rate plan will carry exactly one of
/// these (H1-08), and a reservation freezes a copy of the one it was sold under,
/// which is why this row may be edited in place — "changing a meal plan never
/// changes a confirmed reservation" is a property of that snapshot.
///
/// `code` is text, not an enum: the pack's list ends in "custom", and an enum
/// would need a migration for every property that names its own plan. The
/// standard four are data in `src/lib/hotel/meal-plans.ts`.
model HotelMealPlan {
  id             String  @id @default(cuid())
  organizationId String  @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  /// The property, which in hospitality is the branch (`hotel_properties`).
  branchId       String
  /// EP / CP / MAP / AP or the property's own. Uppercase, unique per property.
  code           String
  name           String
  /// The pack's `name_ur`. Null while a custom plan has no Urdu name; never an
  /// empty string, which would read as a translation that exists.
  nameUr         String?
  /// `[{ meal, outlets[], cutoff_time, per_person }]` — the pack's shape, in the
  /// pack's spelling, because this document is copied verbatim into the
  /// reservation's meal snapshot and pushed to channel managers. Every column of
  /// this schema is camelCase; everything *inside* a hotel JSONB document is
  /// snake_case, so a snapshot is a literal copy and never a re-spelling.
  /// The database validates the shape (`hotel_meal_plan_meals_valid`).
  meals          Json    @default("[]")
  active         Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  property HotelProperty @relation(fields: [organizationId, branchId], references: [organizationId, branchId], onDelete: Cascade, map: "hotel_meal_plans_property_fkey")

  @@unique([organizationId, id], map: "hotel_meal_plans_org_id_key")
  @@unique([organizationId, branchId, code], map: "hotel_meal_plans_org_branch_code_key")
  @@index([organizationId, branchId, active], map: "hotel_meal_plans_org_branch_active_idx")
  @@map("hotel_meal_plans")
}

/// PROP-07 / 05 §1.7. What holds a function space's time. `HOLD` is a tentative
/// event's claim (05 §2: TENTATIVE holds functions with expiry); `FUNCTION` is a
/// confirmed function. Both block the space, because a space double-sold to a
/// tentative wedding and a confirmed one is the failure invariant 25 exists to
/// prevent. The banquet lane (H6) owns what creates each kind.
enum HotelSpaceBookingKind {
  HOLD
  FUNCTION
}

/// PROP-07 (`05-data-model` §1.1, PRD §5.5 / §5.20). A sellable function space —
/// a hall, a lawn, a boardroom — with the layouts it can be set in, what it costs
/// and how long it takes to turn around.
///
/// `layouts` is `[{ layout, capacity }]` and `pricing` is an object of PKR **minor
/// unit** amounts; both are validated in the database by the immutable helpers the
/// creating migration installs, so the shape is a constraint rather than a comment.
///
/// `setupMinutes` / `teardownMinutes` are the turnaround buffers PROP-07 requires.
/// They are properties of the *space*, not of a booking, which is why the buffered
/// range that invariant 25's exclusion constraint arbitrates is maintained on
/// `HotelSpaceBooking` by trigger rather than generated inline (see that model).
model HotelFunctionSpace {
  id             String @id @default(cuid())
  organizationId String @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  /// The property this space belongs to — `hotel_properties.branchId`.
  branchId       String
  name           String
  /// Bilingual name (05: `name_ur`). Null until an operator supplies one.
  nameUr         String?
  /// `[{ layout: 'Theatre', capacity: 300 }, …]`. At least one, because a space
  /// with no layout has no capacity and cannot be sold — so no column default:
  /// `[]` would fail the database CHECK anyway.
  layouts        Json
  /// PROP-07 pricing. Every money member is PKR minor units, never a decimal.
  pricing        Json    @default("{}")
  /// Turnaround buffers in minutes, applied on both sides of every booking.
  setupMinutes    Int     @default(0)
  teardownMinutes Int     @default(0)
  active          Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  property HotelProperty       @relation(fields: [organizationId, branchId], references: [organizationId, branchId], onDelete: Restrict, map: "hotel_function_spaces_org_branch_fkey")
  bookings HotelSpaceBooking[]

  @@unique([organizationId, id], map: "hotel_function_spaces_org_id_key")
  @@unique([organizationId, branchId, id], map: "hotel_function_spaces_org_branch_id_key")
  @@unique([organizationId, branchId, name], map: "hotel_function_spaces_org_branch_name_key")
  @@index([organizationId, branchId, active], map: "hotel_function_spaces_org_branch_active_idx")
  @@map("hotel_function_spaces")
}

/// PROP-07 / invariant 25 — the booking skeleton that makes a function space
/// exclusive. H6 owns events and the diary; this table owns only the claim on a
/// space's time, so exclusivity is settled once, in the database, before any
/// banquet code exists to get it wrong.
///
/// **The buffered range is trigger-maintained, not generated.** A generated column
/// cannot read another table, and the buffers live on `hotel_function_spaces`; a
/// `BEFORE INSERT OR UPDATE` trigger therefore reads the space's setup/teardown and
/// writes `bufferedRange = tstzrange(startsAt − setup, endsAt + teardown, '[)')`,
/// and an `AFTER UPDATE` trigger on the space recomputes every one of its bookings
/// when a buffer changes — so widening a buffer into a collision is refused rather
/// than silently leaving the constraint stale.
///
/// Prisma has no range type, so `bufferedRange` is `Unsupported` and REQUIRED, as
/// the column is `NOT NULL`. A required `Unsupported` column removes `create`,
/// `createMany` and `upsert` from this model's client API on purpose: every
/// booking is inserted in SQL (the router's hold, the DB suite, the verifier)
/// with the id the database generates, and only the trigger ever fills the
/// range. Reads go through the client; `bufferedRange` is not selectable there.
model HotelSpaceBooking {
  id             String @id @default(dbgenerated("(gen_random_uuid())::text"))
  organizationId String @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  branchId       String
  spaceId        String
  /// Absolute instants — a booking spans a property's timezone rules, so these are
  /// `timestamptz` and the exclusion constraint compares them as such.
  startsAt DateTime              @db.Timestamptz(3)
  endsAt   DateTime              @db.Timestamptz(3)
  kind     HotelSpaceBookingKind
  /// What this claim is for, as the owning lane knows it (`{ eventId, … }`); a
  /// hold placed from the spaces page carries `{ label }`. Deliberately not a
  /// foreign key: H6's tables do not exist yet.
  ref       Json    @default("{}")
  /// The platform user who made the claim. Nullable for system-made holds.
  createdBy String?

  /// Trigger-maintained. See the model comment: never written by application code.
  bufferedRange Unsupported("tstzrange")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Pinned to the space AND its property: a booking's branch is its space's branch.
  space HotelFunctionSpace @relation(fields: [organizationId, branchId, spaceId], references: [organizationId, branchId, id], onDelete: Restrict, map: "hotel_space_bookings_space_fkey")

  @@index([organizationId, spaceId, startsAt], map: "hotel_space_bookings_org_space_start_idx")
  @@index([organizationId, branchId, startsAt], map: "hotel_space_bookings_org_branch_start_idx")
  @@map("hotel_space_bookings")
}

/// UPS-04 §5.17 — the eight moments of the guest journey, in the order a stay
/// runs, so a list rendered in enum order reads correctly.
enum HotelJourneyMoment {
  BOOKING_CONFIRMED
  PRE_ARRIVAL_UPSELL
  SELF_CHECKIN
  WELCOME
  IN_STAY
  EXPRESS_CHECKOUT
  INVOICE
  REVIEW_REQUEST
}

enum HotelJourneyChannel {
  WHATSAPP
  EMAIL
  SMS
}

/// EN/UR only: the property's `languages` default is ["en","ur"] and the pack is
/// explicit that the guest journey is Urdu/English.
enum HotelJourneyLanguage {
  EN
  UR
}

enum HotelJourneyTemplateStatus {
  DRAFT
  APPROVED
  RETIRED
}

/// UPS-04 (H1-14) — one row is one **version** of one message: a moment, a
/// channel, a language. Versioned rather than editable in place because the
/// acceptance is "template approval before use": changing words a property
/// already approved must produce a new version to approve, never a silent
/// rewrite of the approved one. Sending is H4's lane; nothing here sends.
///
/// The database holds the rules a surface could get wrong: `version >= 1`, a
/// non-blank body, a subject only on e-mail (and never blank), and the approval
/// facts agreeing with the status (an APPROVED row names its approver and the
/// moment, a DRAFT names neither, a RETIRED row keeps what it had). The partial
/// unique index that allows at most one APPROVED version per (property, moment,
/// channel, language) lives in the migration — Prisma's schema language has no
/// partial-unique syntax, so it is SQL-only by necessity and is pinned by
/// `src/lib/hotel/journey-templates.db.test.ts` rather than by this schema.
model HotelJourneyTemplate {
  id               String                     @id @default(cuid())
  organizationId   String                     @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  /// In hospitality the branch IS the property (H1-01).
  branchId         String
  moment           HotelJourneyMoment
  channel          HotelJourneyChannel
  language         HotelJourneyLanguage
  /// E-mail only; the database CHECK refuses a subject on WhatsApp and SMS.
  subject          String?
  body             String
  version          Int                        @default(1)
  status           HotelJourneyTemplateStatus @default(DRAFT)
  /// Set together with `approvedAt`, and only once the row leaves DRAFT.
  approvedByUserId String?
  approvedAt       DateTime?
  createdByUserId  String
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  property HotelProperty @relation(fields: [organizationId, branchId], references: [organizationId, branchId], onDelete: Restrict, map: "hotel_journey_templates_property_fkey")

  @@unique([organizationId, id], map: "hotel_journey_templates_org_id_key")
  @@unique([organizationId, branchId, moment, channel, language, version], map: "hotel_journey_templates_version_key")
  @@index([organizationId, branchId, moment, status], map: "hotel_journey_templates_board_idx")
  @@map("hotel_journey_templates")
}

/// One-use bridge enrollment; the hash snapshot invalidates codes after rotation.
model RestaurantPrintBridgeEnrollmentCode {
  id                     String   @id @default(cuid())
  organizationId         String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  deviceId               String
  codeHash               String   @unique
  issuedDeviceSecretHash String
  expiresAt              DateTime
  usedAt                 DateTime?
  createdAt              DateTime @default(now())

  device RestaurantRegisteredDevice @relation(fields: [organizationId, deviceId], references: [organizationId, id], onDelete: Cascade, onUpdate: NoAction, map: "restaurant_print_bridge_enrollment_codes_device_fkey")

  @@index([organizationId, deviceId], map: "restaurant_print_bridge_enrollment_codes_org_device_idx")
  @@map("restaurant_print_bridge_enrollment_codes")
}


// Inventory is separate from address-valued print job/route targets.
enum RestaurantPrinterConnectionKind {
  TCP
  DEVICE_PATH
  QUEUE
}
enum RestaurantPrinterStatus {
  ONLINE
  OFFLINE
}
model RestaurantPrinter {
  id             String @id @default(cuid())
  organizationId String @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  branchId       String
  bridgeId       String
  name           String
  connectionKind RestaurantPrinterConnectionKind
  address        String
  paperWidthMm   Int
  status         RestaurantPrinterStatus @default(OFFLINE)
  lastSeenAt     DateTime?
  lastError      String?
  retiredAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  branch RestaurantBranch @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Cascade, onUpdate: NoAction, map: "restaurant_printers_branch_fkey")
  bridge RestaurantRegisteredDevice @relation(fields: [organizationId, branchId, bridgeId], references: [organizationId, branchId, id], onDelete: Cascade, onUpdate: NoAction, map: "restaurant_printers_bridge_fkey")
  printRoutes RestaurantPrintRoute[]
  printJobs RestaurantPrintJob[]
  @@unique([organizationId, branchId, id])
  @@unique([organizationId, id])
  @@index([organizationId, bridgeId])
  @@index([organizationId, branchId])
  @@map("restaurant_printers")
}

enum WalletPassPlatform {
  APPLE
  GOOGLE
}

enum WalletPassStatus {
  ACTIVE
  REVOKED
}

enum WalletPassUpdateReason {
  LEDGER
  PROGRAM
  REVOKE
  RECONCILE
}

enum WalletPassUpdateStatus {
  PENDING
  SENT
  FAILED
}

model WalletPass {
  id                 String             @id @default(cuid())
  organizationId     String             @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  customerId         String
  loyaltyAccountId   String
  platform           WalletPassPlatform
  serialNumber       String             @unique
  status             WalletPassStatus   @default(ACTIVE)
  appleAuthTokenHash String?
  lastPushedBalance  Int?
  lastPushedAt       DateTime?
  contentRevision    Int                @default(1)
  issuedAt           DateTime           @default(now())
  revokedAt          DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  customer       RestaurantCustomer       @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: Restrict)
  loyaltyAccount LoyaltyAccount           @relation(fields: [organizationId, loyaltyAccountId], references: [organizationId, id], onDelete: Restrict)
  registrations  WalletPassRegistration[]
  updates        WalletPassUpdate[]

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([customerId])
  @@index([loyaltyAccountId])
  @@map("restaurant_wallet_passes")
}

model WalletPassRegistration {
  id                      String   @id @default(cuid())
  organizationId          String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  passId                  String
  deviceLibraryIdentifier String
  pushToken               String
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  pass WalletPass @relation(fields: [organizationId, passId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, id])
  @@unique([passId, deviceLibraryIdentifier])
  @@index([organizationId])
  @@index([passId])
  @@map("restaurant_wallet_pass_registrations")
}

model WalletPassUpdate {
  id             String                 @id @default(cuid())
  organizationId String                 @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  passId         String
  reason         WalletPassUpdateReason
  status         WalletPassUpdateStatus @default(PENDING)
  attempts       Int                    @default(0)
  nextAttemptAt  DateTime
  lastError      String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  pass WalletPass @relation(fields: [organizationId, passId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([passId])
  @@index([status, nextAttemptAt])
  @@map("restaurant_wallet_pass_updates")
}

model WalletTenantConfig {
  id                 String   @id @default(cuid())
  organizationId     String   @unique @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  programDisplayName String
  logoFileId         String?
  backgroundColor    String?
  foregroundColor    String?
  googleClassSuffix  String   @unique
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([organizationId, id])
  @@map("restaurant_wallet_tenant_config")
}

model WalletEnrollmentLink {
  id             String    @id @default(cuid())
  organizationId String    @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  branchId       String
  tokenHash      String    @unique
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  revokedAt      DateTime?

  branch RestaurantBranch @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([branchId])
  @@map("restaurant_wallet_enrollment_links")
}

model WalletEnrollmentAttempt {
  id              String                 @id @default(cuid())
  organizationId  String                 @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  branchId        String
  identifierKind  CustomerIdentifierKind
  normalizedValue String
  otpHash         String
  expiresAt       DateTime
  consumedAt      DateTime?
  failedAttempts  Int                    @default(0)
  createdAt       DateTime               @default(now())

  branch RestaurantBranch @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([branchId])
  @@index([expiresAt])
  @@map("restaurant_wallet_enrollment_attempts")
}

/// Effective-dated regulatory and selling policy, never historical batch MRP.
/// Tenant/pack/branch foreign keys and partial uniqueness are migration enforced.
model PharmacyPackPrice {
  id String @id @default(cuid())
  organizationId String @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  presentationId String
  packLevelId String
  branchId String?
  isOverride Boolean @default(false)
  mrpMinor Int
  sellingPriceMinor Int?
  effectiveFrom DateTime
  source String
  proposalId String?
  reviewedOrgPriceId String?
  createdById String
  createdAt DateTime @default(now())

  @@unique([organizationId, id])
  @@unique([organizationId, proposalId])
  @@index([organizationId, packLevelId, effectiveFrom])
  @@map("pharmacy_pack_prices")
}

/// Cross-instance fixed-window counters. Not tenant data and not under RLS:
/// a limit is taken before a tenant scope exists. Startup still refuses a
/// SUPERUSER or BYPASSRLS application role.
model RateLimitBucket {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
  @@map("rate_limit_buckets")
}

/// Work committed with a tenant mutation and delivered after that transaction.
/// SMTP and outbound HTTP must not run on the request's pooled connection.
model OutboundEffect {
  id             String   @id @default(cuid())
  organizationId String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  kind           String
  payload        Json
  status         String   @default("PENDING")
  attempts       Int      @default(0)
  lastError      String?
  availableAt    DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, status, createdAt])
  @@index([status, availableAt])
  @@map("outbound_effects")
}
