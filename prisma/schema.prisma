// ============================================
// AUDIT LOG (admin-only, append-only)
// ============================================

enum AuditActorType {
  USER // a logged-in session user
  API_TOKEN // a df_ REST API token acting on behalf of a user
  ANONYMOUS // no authenticated identity (e.g. a failed login attempt)
  SYSTEM // an automated/internal process
  RESTAURANT_OPERATOR // a restaurant staff operator acting at a terminal (M2 — not a User)
}

enum AuditSource {
  TRPC // a tRPC procedure call (the in-app UI)
  REST_API // a /api/v1 call made with a df_ token
  AUTH // an authentication event (login/logout)
  SYSTEM // an internal/automated event
}

enum AuditOperation {
  CREATE
  READ
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  LOGIN_FAILED
  EXECUTE
  OTHER
}

enum AuditOutcome {
  SUCCESS
  FAILURE
}

