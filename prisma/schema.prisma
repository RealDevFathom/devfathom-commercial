  DAY
  MONTH
}

enum PharmacyStockDisposition {
  AVAILABLE
  QUARANTINE
  DAMAGED
  DESTROYED
  IN_TRANSIT
  /// PUR-06: dispatched back to the supplier on a purchase return or expiry
  /// claim. Terminal for sale purposes — the units stay on the ledger so the
  /// claim remains reconcilable, but nothing may allocate them again.
  RETURN_TO_SUPPLIER
}

enum PharmacyStockMovementKind {
  RECEIPT
  SALE
  RETURN
  TRANSFER_OUT
  TRANSFER_IN
  ADJUSTMENT
  WRITE_OFF
  BREAK_PACK
  /// MIG-03: the migrated opening position. Positive, like a RECEIPT, but it is
  /// not one — no supplier delivered it and no invoice backs it, so opening
  /// stock stays distinguishable from purchased stock for the whole life of the
  /// ledger and the opening totals remain auditable.
  OPENING
}

enum PharmacyInventoryCountStatus {
  OPEN
  AWAITING_COAUTH
  APPROVED
}

enum PharmacyTransferStatus {
  /// PUR-07 §8A invariant 29: what a one-click draft action may create. A DRAFT
  /// transfer holds no stock and cannot be approved (`approveTransfer` requires
  /// ALLOCATED), so no signal can reach a stock movement through it.
  DRAFT
  ALLOCATED
  APPROVED
  DISPATCHED
  PARTIALLY_RECEIVED
  RECEIVED
  EXCEPTION
}

enum PharmacyRecallStatus {
  OPEN
  CLOSED
}

enum PharmacyDrapNoticeKind {
