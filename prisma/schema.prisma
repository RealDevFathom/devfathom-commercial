// IMP-NOTE-02: a person @mentioned in a note (scoped to the note's visibility),
// used to notify them and surface "notes that mention me".
model NoteMention {
  id             String   @id @default(cuid())
  organizationId String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
