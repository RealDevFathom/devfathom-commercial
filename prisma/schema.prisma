// ===========================================================================
// EMAIL INTEGRATION — unified inbox over a Mailbox abstraction with per-provider
// adapters. GMAIL/OUTLOOK are implemented now; HOSTED (@domain) is reserved for
// a future self-hosted mailbox and must plug in WITHOUT touching the router/UI.
// ===========================================================================

enum MailboxType {
  GMAIL
  OUTLOOK
  HOSTED // reserved — not implemented
}

// A connected email account. `credentials` holds the AES-256-GCM ciphertext of
// the OAuth refresh token (NEVER plaintext, NEVER sent to the client). Decryption
// happens server-side only, in the adapter layer.
model Mailbox {
  id             String      @id @default(cuid())
  organizationId String      @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  userId         String
  type           MailboxType
  emailAddress   String
  displayName    String?
  credentials    String // AES-256-GCM ciphertext of the OAuth refresh token
  status         String      @default("active")
  lastSyncedAt   DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages EmailMessage[]

  @@index([userId])
  @@index([organizationId])
  @@map("mailboxes")
}

// A synced message belonging to a Mailbox. Provider-agnostic shape; bodies are
// backfilled lazily on first open to keep the initial inbox paint fast.
model EmailMessage {
  id                String   @id @default(cuid())
  organizationId    String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  mailboxId         String
  providerMessageId String
  threadId          String?
  fromAddr          String
  toAddrs           Json
  ccAddrs           Json?
  subject           String?
  snippet           String?
  bodyHtml          String?
  bodyText          String?
  isRead            Boolean  @default(false)
  hasAttachments    Boolean  @default(false)
  sentAt            DateTime
  createdAt         DateTime @default(now())

  mailbox Mailbox @relation(fields: [mailboxId], references: [id], onDelete: Cascade)

  @@unique([mailboxId, providerMessageId])
  @@index([mailboxId, sentAt])
  @@index([organizationId])
  @@map("email_messages")
}

// ===========================================================================
// PLATFORM CONTROL PLANE — commercial, tenant configuration, identity and ops
// ===========================================================================

model Organization {
  id                  String                     @id @default(cuid())
  slug                String                     @unique
  legalName           String
  displayName         String
  status              OrganizationStatus         @default(ONBOARDING)
  deploymentMode      OrganizationDeploymentMode @default(SHARED)
  packageId           String?
  timezone            String                     @default("UTC")
  locale              String                     @default("en")
  currency            String                     @default("USD")
  seatLimit           Int                        @default(1)
  gracePeriodDays     Int                        @default(0)
  activatedAt         DateTime?
  suspendedAt         DateTime?
  terminatedAt        DateTime?
  purgeScheduledAt    DateTime?
  dataResidency       String?
  primaryContactName  String?
  primaryContactEmail String?
  notes               String?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  package                PlatformPackage?                 @relation(fields: [packageId], references: [id], onDelete: SetNull)
  users                  User[]
  roles                  OrganizationRole[]
  permissionOverrides    UserPermissionOverride[]
  modules                OrganizationModule[]
  limits                 OrganizationLimit[]
  usageCounters          OrganizationUsageCounter[]
  brand                  OrganizationBrand?
  emailSettings          OrganizationEmailSettings?
  domains                OrganizationDomain[]
  identityConnections    OrganizationIdentityConnection[]
  scimTokens             OrganizationScimToken[]
  scimEvents             OrganizationScimEvent[]
  accounts               PlatformAccount[]
  convertedOpportunities PlatformOpportunity[]
  contracts              PlatformContract[]
  invoices               PlatformInvoice[]
  payments               PlatformPayment[]
  renewals               PlatformRenewal[]
  deployments            OrganizationDeployment[]
  jobs                   PlatformJob[]
  lifecycleEvents        OrganizationLifecycleEvent[]
  supportSessions        PlatformSupportSession[]
  auditLogs              PlatformAuditLog[]

  @@index([status])
  @@index([deploymentMode])
  @@index([packageId])
  @@map("organizations")
}

model PlatformUser {
  id           String       @id @default(cuid())
  name         String
  email        String       @unique
  passwordHash String
  role         PlatformRole @default(AUDITOR)
  active       Boolean      @default(true)
  mfaRequired  Boolean      @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([role, active])
  @@map("platform_users")
}

model PlatformModule {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  category    String
  routePrefix String?
  icon        String?
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  packageLinks  PlatformPackageModule[]
  organizations OrganizationModule[]
  contracts     PlatformContractModule[]

  @@index([category, active])
  @@map("platform_modules")
}

model PlatformPackage {
  id           String   @id @default(cuid())
  key          String   @unique
  name         String
  description  String?
  version      Int      @default(1)
  active       Boolean  @default(true)
  defaultSeats Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  moduleLinks   PlatformPackageModule[]
  organizations Organization[]

  @@index([active])
  @@map("platform_packages")
}

model PlatformPackageModule {
  id        String  @id @default(cuid())
  packageId String
  moduleId  String
  enabled   Boolean @default(true)
  limits    Json?

  package PlatformPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  module  PlatformModule  @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([packageId, moduleId])
  @@index([moduleId])
  @@map("platform_package_modules")
}

model OrganizationModule {
  id             String                   @id @default(cuid())
  organizationId String                   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  moduleId       String
  status         OrganizationModuleStatus @default(ENABLED)
  seatLimit      Int?
  startsAt       DateTime                 @default(now())
  expiresAt      DateTime?
  overrides      Json?
  reason         String?
  changedById    String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  module       PlatformModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([organizationId, moduleId])
  @@index([organizationId, status])
  @@index([moduleId])
  @@map("organization_modules")
}

model OrganizationLimit {
  id             String    @id @default(cuid())
  organizationId String    @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  key            String
  value          Int
  period         String?
  source         String    @default("CONTRACT")
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@index([organizationId])
  @@map("organization_limits")
}

model OrganizationUsageCounter {
  id             String   @id @default(cuid())
  organizationId String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  key            String
  periodStart    DateTime
  periodEnd      DateTime
  value          BigInt   @default(0)
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key, periodStart, periodEnd])
  @@index([organizationId, key])
  @@map("organization_usage_counters")
}

model OrganizationRole {
  id             String   @id @default(cuid())
  organizationId String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  key            String
  name           String
  description    String?
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions  OrganizationRolePermission[]
  users        User[]

  @@unique([organizationId, key])
  @@index([organizationId])
  @@map("organization_roles")
}

model OrganizationRolePermission {
  id                 String           @id @default(cuid())
  organizationId     String           @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  organizationRoleId String
  capability         String
  effect             PermissionEffect @default(ALLOW)
  createdAt          DateTime         @default(now())

  role OrganizationRole @relation(fields: [organizationRoleId], references: [id], onDelete: Cascade)

  @@unique([organizationRoleId, capability])
  @@index([organizationId])
  @@map("organization_role_permissions")
}

model UserPermissionOverride {
  id             String           @id @default(cuid())
  organizationId String           @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  userId         String
  capability     String
  effect         PermissionEffect
  reason         String
  expiresAt      DateTime?
  createdById    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, capability])
  @@index([organizationId])
  @@map("user_permission_overrides")
}

model PlatformAccount {
  id             String   @id @default(cuid())
  organizationId String?
  name           String
  legalName      String?
  website        String?
  industry       String?
  country        String?
  ownerId        String?
  status         String   @default("PROSPECT")
  source         String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization?         @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  contacts      PlatformContact[]
  leads         PlatformLead[]
  opportunities PlatformOpportunity[]
  followUps     PlatformFollowUp[]

  @@index([organizationId])
  @@index([status])
  @@map("platform_accounts")
}

model PlatformLead {
  id          String     @id @default(cuid())
  accountId   String?
  name        String
  email       String?
  phone       String?
  companyName String?
  status      LeadStatus @default(NEW)
  source      String?
  ownerId     String?
  notes       String?
  convertedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  account   PlatformAccount?   @relation(fields: [accountId], references: [id], onDelete: SetNull)
  followUps PlatformFollowUp[]

  @@index([status, createdAt])
  @@index([accountId])
  @@map("platform_leads")
}

model PlatformContact {
  id        String   @id @default(cuid())
  accountId String
  name      String
  email     String?
  phone     String?
  title     String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account PlatformAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("platform_contacts")
}

model PlatformOpportunity {
  id                      String           @id @default(cuid())
  accountId               String
  convertedOrganizationId String?
  name                    String
  stage                   OpportunityStage @default(DISCOVERY)
  estimatedValue          Decimal?         @db.Decimal(14, 2)
  currency                String           @default("USD")
  probability             Int              @default(10)
  ownerId                 String?
  expectedCloseAt         DateTime?
  wonAt                   DateTime?
  lostAt                  DateTime?
  lossReason              String?
  notes                   String?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  account               PlatformAccount                 @relation(fields: [accountId], references: [id], onDelete: Cascade)
  convertedOrganization Organization?                   @relation(fields: [convertedOrganizationId], references: [id], onDelete: SetNull)
  stageEvents           PlatformOpportunityStageEvent[]
  proposals             PlatformProposal[]
  followUps             PlatformFollowUp[]
  contracts             PlatformContract[]

  @@index([accountId, stage])
  @@index([convertedOrganizationId])
  @@index([expectedCloseAt])
  @@map("platform_opportunities")
}

model PlatformOpportunityStageEvent {
  id            String            @id @default(cuid())
  opportunityId String
  fromStage     OpportunityStage?
  toStage       OpportunityStage
  reason        String?
  changedById   String?
  createdAt     DateTime          @default(now())

  opportunity PlatformOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([opportunityId, createdAt])
  @@map("platform_opportunity_stage_events")
}

model PlatformProposal {
  id            String         @id @default(cuid())
  opportunityId String
  number        String         @unique
  title         String
  status        ProposalStatus @default(DRAFT)
  currency      String         @default("USD")
  total         Decimal        @db.Decimal(14, 2)
  lineItems     Json
  validUntil    DateTime?
  fileUrl       String?
  sentAt        DateTime?
  acceptedAt    DateTime?
  createdById   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  opportunity PlatformOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([opportunityId, status])
  @@map("platform_proposals")
}

model PlatformFollowUp {
  id            String         @id @default(cuid())
  accountId     String?
  leadId        String?
  opportunityId String?
  ownerId       String?
  title         String
  notes         String?
  dueAt         DateTime
  status        FollowUpStatus @default(OPEN)
  completedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  account     PlatformAccount?     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  lead        PlatformLead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  opportunity PlatformOpportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([ownerId, status, dueAt])
  @@index([accountId])
  @@index([leadId])
  @@index([opportunityId])
  @@map("platform_follow_ups")
}

model PlatformContract {
  id              String                   @id @default(cuid())
  organizationId  String
  opportunityId   String?
  number          String                   @unique
  title           String
  status          CommercialContractStatus @default(DRAFT)
  currency        String                   @default("USD")
  value           Decimal                  @db.Decimal(14, 2)
  billingInterval BillingInterval          @default(ANNUAL)
  seatLimit       Int                      @default(1)
  startDate       DateTime
  endDate         DateTime
  graceUntil      DateTime?
  autoRenew       Boolean                  @default(false)
  signedAt        DateTime?
  ownerId         String?
  notes           String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  opportunity  PlatformOpportunity?     @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  modules      PlatformContractModule[]
  invoices     PlatformInvoice[]
  renewals     PlatformRenewal[]

  @@index([organizationId, status])
  @@index([endDate])
  @@map("platform_contracts")
}

model PlatformContractModule {
  id         String @id @default(cuid())
  contractId String
  moduleId   String
  seatLimit  Int?
  limits     Json?

  contract PlatformContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  module   PlatformModule   @relation(fields: [moduleId], references: [id], onDelete: Restrict)

  @@unique([contractId, moduleId])
  @@index([moduleId])
  @@map("platform_contract_modules")
}

model PlatformInvoice {
  id             String                @id @default(cuid())
  organizationId String
  contractId     String?
  number         String                @unique
  status         PlatformInvoiceStatus @default(DRAFT)
  currency       String                @default("USD")
  subtotal       Decimal               @db.Decimal(14, 2)
  tax            Decimal               @default(0) @db.Decimal(14, 2)
  total          Decimal               @db.Decimal(14, 2)
  lineItems      Json
  issuedAt       DateTime?
  dueAt          DateTime
  paidAt         DateTime?
  notes          String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  contract     PlatformContract? @relation(fields: [contractId], references: [id], onDelete: SetNull)
  payments     PlatformPayment[]

  @@index([organizationId, status])
  @@index([contractId])
  @@index([dueAt])
  @@map("platform_invoices")
}

model PlatformPayment {
  id             String                @id @default(cuid())
  organizationId String
  invoiceId      String
  status         PlatformPaymentStatus @default(PENDING)
  amount         Decimal               @db.Decimal(14, 2)
  currency       String                @default("USD")
  method         String?
  externalRef    String?
  idempotencyKey String?               @unique
  paidAt         DateTime?
  failureReason  String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  invoice      PlatformInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([organizationId, status])
  @@index([invoiceId])
  @@map("platform_payments")
}

model PlatformRenewal {
  id             String        @id @default(cuid())
  organizationId String
  contractId     String
  status         RenewalStatus @default(UPCOMING)
  dueAt          DateTime
  ownerId        String?
  proposedValue  Decimal?      @db.Decimal(14, 2)
  proposedSeats  Int?
  notes          String?
  completedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  contract     PlatformContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([dueAt])
  @@map("platform_renewals")
}

model OrganizationBrand {
  id             String   @id @default(cuid())
  organizationId String   @unique
  logoUrl        String?
  markUrl        String?
  primaryColor   String   @default("#111110")
  accentColor    String   @default("#FF684F")
  supportEmail   String?
  fromName       String?
  faviconUrl     String?
  tokens         Json?
  customCss      String?
  updatedById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_brands")
}

model OrganizationEmailSettings {
  id               String    @id @default(cuid())
  organizationId   String    @unique
  provider         String    @default("PLATFORM")
  fromName         String?
  fromAddress      String?
  replyTo          String?
  encryptedApiKey  String?
  domainVerifiedAt DateTime?
  configuration    Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_email_settings")
}

model OrganizationDomain {
  id                 String                   @id @default(cuid())
  organizationId     String
  host               String                   @unique
  kind               String                   @default("APP")
  verificationStatus DomainVerificationStatus @default(PENDING)
  verificationToken  String                   @unique
  isPrimary          Boolean                  @default(false)
  verifiedAt         DateTime?
  lastCheckedAt      DateTime?
  failureReason      String?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, verificationStatus])
  @@map("organization_domains")
}

model OrganizationIdentityConnection {
  id                    String                   @id @default(cuid())
  organizationId        String
  name                  String
  protocol              IdentityProtocol
  status                IdentityConnectionStatus @default(DRAFT)
  issuer                String?
  clientId              String?
  encryptedClientSecret String?
  discoveryUrl          String?
  ssoUrl                String?
  entityId              String?
  certificate           String?
  domains               String[]                 @default([])
  allowJit              Boolean                  @default(true)
  enforceSso            Boolean                  @default(false)
  roleMappings          Json?
  configuration         Json?
  lastTestedAt          DateTime?
  lastError             String?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  scimEvents   OrganizationScimEvent[]

  @@index([organizationId, status])
  @@map("organization_identity_connections")
}

model OrganizationScimToken {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  prefix         String
  tokenHash      String    @unique
  expiresAt      DateTime?
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([prefix])
  @@map("organization_scim_tokens")
}

model OrganizationScimEvent {
  id                   String   @id @default(cuid())
  organizationId       String
  identityConnectionId String?
  externalId           String?
  idempotencyKey       String?  @unique
  operation            String
  resourceType         String
  status               String
  payload              Json?
  error                String?
  createdAt            DateTime @default(now())

  organization       Organization                    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  identityConnection OrganizationIdentityConnection? @relation(fields: [identityConnectionId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([externalId])
  @@map("organization_scim_events")
}

model OrganizationDeployment {
  id             String                     @id @default(cuid())
  organizationId String
  environment    String                     @default("production")
  mode           OrganizationDeploymentMode
  status         DeploymentStatus           @default(PENDING)
  provider       String                     @default("VERCEL")
  projectId      String?
  region         String?
  url            String?
  databaseRef    String?
  edgeConfigRef  String?
  version        String?
  health         Json?
  lastHealthyAt  DateTime?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, environment])
  @@index([status])
  @@map("organization_deployments")
}

model PlatformJob {
  id             String            @id @default(cuid())
  organizationId String?
  type           PlatformJobType
  status         PlatformJobStatus @default(QUEUED)
  payload        Json?
  result         Json?
  error          String?
  attempts       Int               @default(0)
  maxAttempts    Int               @default(3)
  idempotencyKey String?           @unique
  requestedById  String?
  scheduledAt    DateTime          @default(now())
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([status, scheduledAt])
  @@index([organizationId])
  @@map("platform_jobs")
}

model OrganizationLifecycleEvent {
  id             String              @id @default(cuid())
  organizationId String
  action         LifecycleAction
  fromStatus     OrganizationStatus?
  toStatus       OrganizationStatus
  reason         String
  metadata       Json?
  actorId        String?
  createdAt      DateTime            @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@map("organization_lifecycle_events")
}

model PlatformSupportSession {
  id             String               @id @default(cuid())
  organizationId String
  platformUserId String
  tenantUserId   String?
  reason         String
  status         SupportSessionStatus @default(ACTIVE)
  expiresAt      DateTime
  endedAt        DateTime?
  createdAt      DateTime             @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([platformUserId, status])
  @@map("platform_support_sessions")
}

model PlatformAuditLog {
  id                  String   @id @default(cuid())
  organizationId      String?
  actorPlatformUserId String?
  actorTenantUserId   String?
  action              String
  targetType          String?
  targetId            String?
  before              Json?
  after               Json?
  metadata            Json?
  requestId           String?
  reason              String?
  success             Boolean  @default(true)
  error               String?
  ip                  String?
  userAgent           String?
  createdAt           DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([actorPlatformUserId, createdAt])
  @@index([action, createdAt])
  @@index([requestId])
  @@map("platform_audit_logs")
}
