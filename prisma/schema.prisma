/// INV-02 / §8A invariant 5: the evidence a non-FEFO selection leaves behind.
/// Append-only.
model PharmacyAllocationOverride {
  id               String   @id @default(cuid())
  organizationId   String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  branchId         String
  actorId          String
  reason           String
  approvalPolicy   String
  recommendedLotId String
  selectedLotId    String
  createdAt        DateTime @default(now())

  recommendedLot PharmacyInventoryLot    @relation("PharmacyAllocationRecommended", fields: [organizationId, branchId, recommendedLotId], references: [organizationId, branchId, id], onDelete: Restrict)
  selectedLot    PharmacyInventoryLot    @relation("PharmacyAllocationSelected", fields: [organizationId, branchId, selectedLotId], references: [organizationId, branchId, id], onDelete: Restrict)
  movements      PharmacyStockMovement[]

  @@unique([organizationId, id], map: "pharmacy_allocation_overrides_org_id_key")
  @@index([organizationId, branchId, createdAt], map: "pharmacy_allocation_overrides_org_branch_created_idx")
  @@map("pharmacy_allocation_overrides")
}

/// INV-01: the append-only ledger. `quantityUnits` is a SIGNED integer count of
/// canonical base units whose sign is fixed by `kind`; `sealedPackDelta` and
/// `looseUnitDelta` carry the physical arrangement so a BREAK_PACK (INV-04) is
/// an explicit movement with a zero canonical total.
model PharmacyStockMovement {
  id                   String                    @id @default(cuid())
  organizationId       String                    @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  branchId             String
  inventoryLotId       String
  stockLocationId      String
  kind                 PharmacyStockMovementKind
  disposition          PharmacyStockDisposition
  quantityUnits        Int
  sealedPackDelta      Int                       @default(0)
  looseUnitDelta       Int                       @default(0)
  actorId              String
  reason               String?
  idempotencyKey       String
  allocationOverrideId String?
  /// PUR-04 / §8A invariant 8: a correction is a linked compensating movement,
  /// never an edit. A reversal must be the exact negation of the movement it
  /// names, in the same lot, location and disposition, and each posting can be
  /// reversed at most once.
  reversesMovementId   String?
  occurredAt           DateTime                  @default(now())
  createdAt            DateTime                  @default(now())

  lot      PharmacyInventoryLot        @relation(fields: [organizationId, branchId, inventoryLotId], references: [organizationId, branchId, id], onDelete: Restrict)
  location PharmacyStockLocation       @relation(fields: [organizationId, stockLocationId], references: [organizationId, id], onDelete: Restrict)
  override PharmacyAllocationOverride? @relation(fields: [organizationId, allocationOverrideId], references: [organizationId, id], onDelete: Restrict)
  reverses PharmacyStockMovement?      @relation("PharmacyMovementReversal", fields: [organizationId, reversesMovementId], references: [organizationId, id], onDelete: Restrict, map: "pharmacy_stock_movements_reverses_fkey")
  reversal PharmacyStockMovement[]     @relation("PharmacyMovementReversal")

  @@unique([organizationId, id], map: "pharmacy_stock_movements_org_id_key")
  @@unique([organizationId, idempotencyKey], map: "pharmacy_stock_movements_org_idempotency_key")
  @@index([organizationId, branchId, inventoryLotId, occurredAt], map: "pharmacy_stock_movements_org_branch_lot_idx")
  @@map("pharmacy_stock_movements")
}

/// INV-01 acceptance ("product quantity is a projection"). Derived state,
/// maintained only by the ledger trigger and constrained non-negative, so a
/// negative balance is unrepresentable. Never written by application code.
model PharmacyStockBalance {
  organizationId  String
  branchId        String
  inventoryLotId  String
  stockLocationId String
  disposition     PharmacyStockDisposition
  onHandUnits     Int
  sealedPacks     Int
  looseUnits      Int
  updatedAt       DateTime                 @default(now())

  lot      PharmacyInventoryLot  @relation(fields: [organizationId, branchId, inventoryLotId], references: [organizationId, branchId, id], onDelete: Restrict)
  location PharmacyStockLocation @relation(fields: [organizationId, stockLocationId], references: [organizationId, id], onDelete: Restrict)

  @@id([organizationId, inventoryLotId, stockLocationId, disposition], map: "pharmacy_stock_balances_pkey")
  @@index([organizationId, branchId, disposition], map: "pharmacy_stock_balances_org_branch_idx")
  @@map("pharmacy_stock_balances")
}

/// §8A invariant 6: what the emergency path records instead of driving a
/// balance below zero. Append-only; closure belongs to INV-06.
model PharmacyStockDiscrepancy {
  id              String   @id @default(cuid())
  organizationId  String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  branchId        String
  inventoryLotId  String?
  stockLocationId String?
  requestedUnits  Int
  allocatedUnits  Int
  shortfallUnits  Int
  actorId         String
  reason          String
  createdAt       DateTime @default(now())

  lot      PharmacyInventoryLot?  @relation(fields: [organizationId, branchId, inventoryLotId], references: [organizationId, branchId, id], onDelete: Restrict)
  location PharmacyStockLocation? @relation(fields: [organizationId, stockLocationId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id], map: "pharmacy_stock_discrepancies_org_id_key")
  @@index([organizationId, branchId, createdAt], map: "pharmacy_stock_discrepancies_org_branch_created_idx")
  @@map("pharmacy_stock_discrepancies")
}

