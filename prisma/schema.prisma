/// POS-01: one counter operator's configurable shortcut map. Organization- and
/// user-scoped rather than branch-scoped, because muscle memory belongs to the
/// cashier and follows them between counters. `overrides` is a JSON map from
/// counter action to chord; it is validated by `resolveCounterKeymap` before it
/// is stored, so an unknown action or a duplicate chord never reaches a row.
model PharmacyCounterKeymapPreference {
  id               String       @id @default(cuid())
  organizationId   String       @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  userId           String
  preset           String       @default("devfathom")
  overrides        Json         @default("{}")
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  visibilityAnchor Organization @relation("PharmacyCounterKeymapPreferenceVisibilityAnchor", fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "pharmacy_counter_keymap_preferences_visibility_fkey")

  @@unique([organizationId, id])
  @@unique([organizationId, userId])
  @@map("pharmacy_counter_keymap_preferences")
}

model PharmacySaleLine {
  id                        String                       @id @default(cuid())
  organizationId            String                       @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  branchId                  String
  saleId                    String
  medicineId                String
  presentationId            String
  packLevelId               String
  saleUnit                  PharmacySaleUnit
  quantity                  Int
  canonicalUnitsPerSaleUnit Int
  canonicalUnits            Int
  unitPriceMinor            Int
  proRataCeilingMinor       Int
  unitCostMinor             Int
  discountKind              PharmacyDiscountKind?
  discountMinor             Int                          @default(0)
  approvalPolicy            String?
  approvedByUserId          String?
  prescriptionLineId        String?
  prescriptionPatientId     String?
  idempotencyKey            String
  createdAt                 DateTime                     @default(now())
  sale                      PharmacySale                 @relation(fields: [organizationId, branchId, saleId], references: [organizationId, branchId, id], onDelete: Restrict)
  medicine                  Medicine                     @relation(fields: [medicineId], references: [id], onDelete: Restrict)
  presentation              Presentation                 @relation(fields: [presentationId], references: [id], onDelete: Restrict)
  packLevel                 PackLevel                    @relation(fields: [packLevelId], references: [id], onDelete: Restrict)
  prescriptionLine          PrescriptionLine?            @relation(fields: [organizationId, prescriptionLineId], references: [organizationId, id], onDelete: Restrict)
  allocations               PharmacySaleLineAllocation[]
  returnLines               PharmacySaleReturnLine[]
  unidentifiedReturnHolds   PharmacyUnidentifiedReturnHold[]

  @@unique([organizationId, id])
  @@unique([organizationId, branchId, id])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, branchId, saleId])
  @@map("pharmacy_sale_lines")
}

model PharmacySaleLineAllocation {
  id              String               @id @default(cuid())
  organizationId  String               @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  branchId        String
  saleLineId      String
