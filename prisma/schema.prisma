  @@unique([organizationId, branchId, id], map: "catering_order_money_scope_key")
  @@unique([organizationId, id])
  @@index([organizationId, branchId, bookingStartsAt, bookingEndsAt], map: "catering_booking_overlap")
  @@index([organizationId, branchId, eventDate])
  @@index([organizationId, status])
  @@index([customerId])
  @@map("restaurant_catering_orders")
}

