model PharmacySale {
  id                        String                       @id @default(cuid())
  organizationId            String                       @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  branchId                  String
  status                    PharmacySaleStatus           @default(OPEN)
  originalSaleId            String?
  createdByUserId           String
  completedAt               DateTime?
  receiptNumber             Int?
  receiptDeviceId           String?
  businessDate              DateTime?                    @db.Date
  customerId                String?
  createdAt                 DateTime                     @default(now())
  updatedAt                 DateTime                     @updatedAt
  originalSale              PharmacySale?                @relation("PharmacySaleOriginal", fields: [organizationId, branchId, originalSaleId], references: [organizationId, branchId, id], onDelete: Restrict)
  relatedSales              PharmacySale[]               @relation("PharmacySaleOriginal")
  lines                     PharmacySaleLine[]
  events                    PharmacySaleEvent[]
  returns                   PharmacySaleReturn[]         @relation("PharmacySaleReturns")
  demandEvents              UnfulfilledDemandEvent[]
  recoveredRestockInterests PharmacyRestockInterest[]    @relation("PharmacyRestockRecoverySale")
  tenders                   PharmacyTender[]
  refunds                   PharmacyRefund[]
  customer                  PharmacyCustomer?            @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: Restrict)
  loyaltyEntries            PharmacyLoyaltyPointsEntry[]
  customerOrder             PharmacyCustomerOrder?
  visibilityAnchor          PharmacyBranch               @relation("PharmacySaleVisibilityAnchor", fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "pharmacy_sales_visibility_fkey")

  @@unique([organizationId, id])
  @@unique([organizationId, branchId, id])
  @@index([organizationId, branchId, status, createdAt])
  @@map("pharmacy_sales")
}

/// CRM-L01 retail identity. Clinical identity remains in PharmacyPatient and is
/// joined only server-side after a current LOYALTY consent check.
model PharmacyCustomer {
  whatsappMessages PharmacyMessageLog[]
  id               String               @id @default(cuid())
  organizationId   String               @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  patientId        String
  displayName      String
  phoneLast4       String?
  creditLimitMinor Int                  @default(0)
  active           Boolean              @default(true)
  userId           String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  patient                PharmacyPatient              @relation(fields: [organizationId, patientId], references: [organizationId, id], onDelete: Restrict)
  sales                  PharmacySale[]
  pointsEntries          PharmacyLoyaltyPointsEntry[]
  paidFamilyAccounts     PharmacyFamilyAccount[]      @relation("PharmacyFamilyPayer")
  familyMemberships      PharmacyFamilyMember[]
  user                   User?                        @relation("PharmacyCustomerUser", fields: [organizationId, userId], references: [organizationId, id], onDelete: Restrict)
  orders                 PharmacyCustomerOrder[]
  whatsappOptIn          Boolean?
  whatsappOptInChangedAt DateTime?                    @db.Timestamp(3)

  @@unique([organizationId, id])
  @@unique([organizationId, patientId])
  @@unique([organizationId, userId])
  @@index([organizationId, displayName])
  @@map("pharmacy_customers")
}

enum PharmacyKhataEventKind {
  CHARGE
  PAYMENT
  DISHONOURED_CHEQUE
}

enum PharmacyKhataLimitDecisionKind {
  ACCEPTED
  OVERRIDDEN
}

/// CRM-L02 retail payer grouping. Clinical records remain attached to each
/// member's PharmacyPatient and are never copied onto this account.
model PharmacyFamilyAccount {
  id               String   @id @default(cuid())
  organizationId   String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  branchId         String
  payerCustomerId  String
  displayName      String
  creditLimitMinor Int      @default(0)
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  payer          PharmacyCustomer             @relation("PharmacyFamilyPayer", fields: [organizationId, payerCustomerId], references: [organizationId, id], onDelete: Restrict)
  members        PharmacyFamilyMember[]
  khataEvents    PharmacyKhataEvent[]
  limitDecisions PharmacyKhataLimitDecision[]

  @@unique([organizationId, branchId, id])
  @@index([organizationId, branchId, payerCustomerId])
  @@map("pharmacy_family_accounts")
}

model PharmacyFamilyMember {
  id              String   @id @default(cuid())
  organizationId  String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  branchId        String
  familyAccountId String
  customerId      String
  createdAt       DateTime @default(now())

  familyAccount PharmacyFamilyAccount @relation(fields: [organizationId, branchId, familyAccountId], references: [organizationId, branchId, id], onDelete: Restrict)
  customer      PharmacyCustomer      @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: Restrict)
  khataEvents   PharmacyKhataEvent[]

  @@unique([organizationId, branchId, familyAccountId, customerId])
  @@unique([organizationId, branchId, id])
  @@index([organizationId, customerId])
  @@map("pharmacy_family_members")
}

/// Append-only history used for both the balance and explainable score.
model PharmacyKhataEvent {
  id              String                 @id @default(cuid())
  organizationId  String                 @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  branchId        String
  familyAccountId String
  memberId        String?
  kind            PharmacyKhataEventKind
  amountMinor     Int
  occurredAt      DateTime               @default(now())
  dueAt           DateTime?
  settlesChargeId String?
  actorId         String
  note            String?

  familyAccount PharmacyFamilyAccount @relation(fields: [organizationId, branchId, familyAccountId], references: [organizationId, branchId, id], onDelete: Restrict)
  member        PharmacyFamilyMember? @relation(fields: [organizationId, branchId, memberId], references: [organizationId, branchId, id], onDelete: Restrict)

  @@unique([organizationId, branchId, id])
  @@index([organizationId, branchId, familyAccountId, occurredAt])
  @@map("pharmacy_khata_events")
}

/// Human owner decision. Score calculation never mutates the account limit.
model PharmacyKhataLimitDecision {
  id                  String                         @id @default(cuid())
  organizationId      String                         @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  branchId            String
  familyAccountId     String
  kind                PharmacyKhataLimitDecisionKind
  score               Int
  method              String
  windowStart         DateTime
  windowEnd           DateTime
  suggestedLimitMinor Int
  appliedLimitMinor   Int
  reasons             Json
  ownerActorId        String
  createdAt           DateTime                       @default(now())

  familyAccount PharmacyFamilyAccount @relation(fields: [organizationId, branchId, familyAccountId], references: [organizationId, branchId, id], onDelete: Restrict)

  @@unique([organizationId, branchId, id])
  @@index([organizationId, branchId, familyAccountId, createdAt])
  @@map("pharmacy_khata_limit_decisions")
}

/// Append-only, signed whole-point ledger. Branch is stamped at posting time;
/// sale and idempotency constraints make settlement replay safe.
model PharmacyLoyaltyPointsEntry {
  id              String                   @id @default(cuid())
  organizationId  String                   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  branchId        String
  customerId      String
  saleId          String
  tenderId        String?
  refundId        String?
  kind            PharmacyLoyaltyEntryKind
  points          Int
  requestedPoints Int?
  netPaidMinor    Int?
  actorId         String
  idempotencyKey  String
  occurredAt      DateTime                 @default(now())

  customer PharmacyCustomer @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: Restrict)
  sale     PharmacySale     @relation(fields: [organizationId, branchId, saleId], references: [organizationId, branchId, id], onDelete: Restrict)
  tender   PharmacyTender?  @relation(fields: [organizationId, tenderId], references: [organizationId, id], onDelete: Restrict)
  refund   PharmacyRefund?  @relation(fields: [organizationId, refundId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, branchId, customerId, occurredAt])
  @@index([organizationId, saleId])
  @@index([organizationId, refundId])
  @@map("pharmacy_loyalty_points_entries")
}

