model User {
  id                 String     @id @default(cuid())
  organizationId     String     @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  organizationRoleId String?
  name               String
  email              String
  password           String?
  role               Role       @default(EMPLOYEE)
  department         String
  title              String
  avatar             String?
  phone              String?
  bio                String?
  skills             String[]   @default([])
  startDate          DateTime   @default(now())
  status             UserStatus @default(ACTIVE)
  lastActiveAt       DateTime?
  // AUTH-01 / IMP-AUTH-03: bumped on password change, admin reset, and lay-off so
  // all other live JWT sessions are invalidated on the next jwt() revalidation.
  // "Sign out everywhere" bumps it too. passwordChangedAt is kept for display/audit.
  tokenVersion       Int        @default(0)
  passwordChangedAt  DateTime?
  /// Set when an administrator chooses the password. Cleared when the member sets their own.
  mustChangePassword Boolean    @default(false)
  // IMP-DASH-02: per-user dashboard widget layout/visibility prefs (JSON blob).
  preferences        Json?
  // IMP-AUTH-04: per-type/channel notification opt-outs, honored by notify().
  notificationPrefs  Json?
  // IMP-AUTH-02: TOTP 2FA. Secret is base32; enabledAt null = 2FA off (the secret
  // may exist transiently during enrolment before the first verify).
  twoFactorSecret    String?
  twoFactorEnabledAt DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  // Relations
  organization                Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationDepartment      OrganizationDepartment         @relation(fields: [organizationId, department], references: [organizationId, key])
  organizationRole            OrganizationRole?              @relation(fields: [organizationRoleId], references: [id], onDelete: SetNull)
  permissionOverrides         UserPermissionOverride[]
  projectMembers              ProjectMember[]
  assignedTasks               TaskAssignee[]
  taskComments                TaskComment[]
  createdTasks                Task[]                         @relation("TaskCreator")
  sentMessages                Message[]
  channelMembers              ChannelMember[]
  createdChannels             Channel[]
  messageMentions             MessageMention[]
  pinnedMessages              PinnedMessage[]
  savedMessages               SavedMessage[]
  leaveRequests               LeaveRequest[]                 @relation("LeaveRequester")
  approvedLeaves              LeaveRequest[]                 @relation("LeaveApprover")
  performanceNotes            PerformanceNote[]              @relation("NoteSubject")
  writtenNotes                PerformanceNote[]              @relation("NoteAuthor")
  activities                  Activity[]
  notifications               Notification[]
  pharmacyOwnerDigestSettings PharmacyOwnerDigestSetting[]
  pharmacyOwnerDigestCaptures PharmacyOwnerDigestCapture[]
  uploadedFiles               ProjectFile[]
  uploadedDocs                Document[]
  timeEntries                 TimeEntry[]
  meetingAttendees            MeetingAttendee[]
  apiTokens                   ApiToken[]
  authoredNotes               Note[]                         @relation("NoteAuthor")
  noteShares                  NoteShare[]
  columnDefaults              ColumnDefaultAssignee[]
  attendanceLog               MeetingAttendanceLog[]
  invitation                  Invitation?                    @relation("UserInvitation")
  invitationsSent             Invitation[]                   @relation("InvitationsSent")
  passwordResetTokens         PasswordResetToken[]
  // IMP-HR-04 performance reviews + IMP-NOTE-02 note mentions
  reviewCyclesCreated         ReviewCycle[]                  @relation("ReviewCycleCreator")
  reviewsAbout                Review[]                       @relation("ReviewSubject")
  reviewsWritten              Review[]                       @relation("ReviewReviewer")
  noteMentions                NoteMention[]
  // Big Bets: NOTE-01 versioning, HR-01 leave balances, AUTH-02 recovery codes
  noteRevisions               NoteRevision[]                 @relation("NoteRevisionEditor")
  leaveBalances               LeaveBalance[]                 @relation("UserLeaveBalances")
  recoveryCodes               TwoFactorRecoveryCode[]
  webhooksCreated             Webhook[]                      @relation("WebhookCreator")
  auditLogs                   AuditLog[]                     @relation("UserAuditLogs")
  resignations                Resignation[]                  @relation("UserResignations")
  resignationsReviewed        Resignation[]                  @relation("ResignationsReviewed")
  // Email integration: connected Gmail/Outlook mailboxes feeding the unified inbox.
  mailboxes                   Mailbox[]
  ssoTickets                  TenantSsoTicket[]
  // MEET-01
  meetingParticipants         MeetingParticipant[]
  meetingAdmissions           MeetingOccurrenceParticipant[]
  meetingSessions             MeetingParticipantSession[]
  // §4.1: restaurant branch assignments (branch-level authorization seam).
  restaurantBranchAssignments RestaurantBranchAssignment[]
  // M2-L1/C3: optional one-way link from an operator staff profile back to a
  // web-login User. A User may back zero or many staff profiles; a staff
  // profile need not have one at all.
  restaurantStaffProfiles     RestaurantStaffProfile[]       @relation("RestaurantStaffUser")
  pharmacyCustomer            PharmacyCustomer?              @relation("PharmacyCustomerUser")
  pharmacyOrdersPlaced        PharmacyCustomerOrder[]        @relation("PharmacyOrderPlacedBy")
  pharmacyOrdersRun           PharmacyCustomerOrder[]        @relation("PharmacyOrderRunner")
  pharmacyOrderEvents         PharmacyCustomerOrderEvent[]   @relation("PharmacyOrderEventActor")

  pharmacyDeliveryEvidence PharmacyOrderDeliveryEvidence[] @relation("PharmacyDeliveryEvidenceActor")

  hotelPropertyAssignments HotelPropertyAssignment[]
  pharmacyBranchAssignments PharmacyBranchAssignment[]

  @@unique([organizationId, id])
  @@unique([organizationId, email])
  @@index([organizationId])
  @@map("users")
}

// A self-service "quit the company" request. An employee submits one (reason +
// proposed last working day); it sits PENDING until an HR or ADMIN reviewer
// approves/declines it. Approval records the confirmed lastWorkingDay but does
// NOT itself deactivate the account — offboarding happens on/after that day
// (e.g. via the Lay-off action), so access is not pulled out from under someone
// who is still working their notice period.
model Resignation {
  id              String            @id @default(cuid())
  organizationId  String            @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  userId          String
  reason          String
  proposedLastDay DateTime
  status          ResignationStatus @default(PENDING)
  reviewedById    String?
  reviewedAt      DateTime?
  reviewNote      String?
  lastWorkingDay  DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user       User  @relation("UserResignations", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("ResignationsReviewed", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([userId])
  @@index([organizationId])
  @@map("resignations")
}

// A pending invitation for a User created in the INVITED state. The raw token is
// emailed to the invitee; only its SHA-256 hash is stored here. Accepting the
// invite sets the user's password, flips status to ACTIVE, and stamps acceptedAt.
model Invitation {
  id             String    @id @default(cuid())
  organizationId String    @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  userId         String    @unique
  user           User      @relation("UserInvitation", fields: [userId], references: [id], onDelete: Cascade)
  email          String
  tokenHash      String    @unique
  invitedById    String?
  invitedBy      User?     @relation("InvitationsSent", fields: [invitedById], references: [id], onDelete: SetNull)
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId])
  @@map("invitations")
}

// IMP-AUTH-01: self-service password reset. Single-use, expiring token; only the
// SHA-256 hash is stored (raw token is emailed once), mirroring Invitation.
model PasswordResetToken {
  id             String    @id @default(cuid())
  organizationId String    @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  userId         String
  tokenHash      String    @unique
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
  @@map("password_reset_tokens")
}

// IMP-HR-04: a real performance-review process (cycles + per-subject reviews),
// distinct from the freeform PerformanceNote table.
model ReviewCycle {
  id             String   @id @default(cuid())
  organizationId String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  name           String
  startDate      DateTime
  endDate        DateTime
  status         String   @default("OPEN") // OPEN | CLOSED
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  createdBy User     @relation("ReviewCycleCreator", fields: [createdById], references: [id])
  reviews   Review[]

  @@index([organizationId])
  @@map("review_cycles")
}

model Review {
  id             String    @id @default(cuid())
  organizationId String    @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  cycleId        String
  subjectId      String
  reviewerId     String
  rating         Int? // 1..5
  strengths      String?
  improvements   String?
  comments       String?
  status         String    @default("DRAFT") // DRAFT | SUBMITTED
  submittedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  cycle    ReviewCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  subject  User        @relation("ReviewSubject", fields: [subjectId], references: [id], onDelete: Cascade)
  reviewer User        @relation("ReviewReviewer", fields: [reviewerId], references: [id], onDelete: Cascade)

  @@unique([cycleId, subjectId, reviewerId])
  @@index([subjectId])
  @@index([reviewerId])
  @@index([organizationId])
