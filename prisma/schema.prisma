enum PharmacyStockLocationKind {
  STORE
  RACK_BIN
  FRIDGE
  SAFE
  QUARANTINE
  TRANSIT
  RETURNS
}

enum PharmacyBatchState {
  ACTIVE
  RECALLED
  QUARANTINED
}

