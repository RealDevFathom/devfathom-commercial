  @@unique([organizationId, saleLineId])
  @@index([organizationId, patientId, medicineId, createdAt])
  @@map("pharmacy_emergency_rx_follow_ups")
}

/// PUR-02 receiving / PUR-05 — the document that turns an order or a supplier
/// invoice into stock. It holds no quantity of its own: posting it writes an
/// inventory lot and RECEIPT movements into the PH-INV ledger, which stays the
/// only on-hand truth. `directPurchase` is the PUR-05 path — no order, and a
/// named bypass reason and approver instead.
model PharmacyGoodsReceipt {
  id                     String                     @id @default(cuid())
  organizationId         String                     @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  branchId               String
  reference              String
  status                 PharmacyGoodsReceiptStatus @default(DRAFT)
  supplierId             String
  purchaseOrderId        String?
  /// PUR-02: the source-invoice and warranty evidence without which the goods
  /// are not saleable. Required on the row, not only at the router.
  supplierInvoiceRef     String
  supplierInvoiceDate    DateTime
  warrantyEvidenceRef    String
  receivedByUserId       String
  receivedAt             DateTime
  directPurchase         Boolean                    @default(false)
  bypassReason           String?
  bypassApprovedByUserId String?
  bypassApprovedAt       DateTime?
  postedAt               DateTime?
  reversedAt             DateTime?
  reversedByUserId       String?
  reversalReason         String?
  note                   String?
  /// Signs a controlled-medicine purchase in the register. Not the receiver.
  qualifiedPersonUserId  String?
  /// AI-03: document-level OCR proposals and their source boxes.
  ocrDraftEvidence       Json?
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt

  supplier      PharmacySupplier             @relation(fields: [organizationId, supplierId], references: [organizationId, id], onDelete: Restrict, map: "pharmacy_goods_receipts_supplier_fkey")
  purchaseOrder PharmacyPurchaseOrder?       @relation(fields: [organizationId, purchaseOrderId], references: [organizationId, id], onDelete: Restrict, map: "pharmacy_goods_receipts_order_fkey")
  lines         PharmacyGoodsReceiptLine[]
  exceptions    PharmacyReceivingException[]

  @@unique([organizationId, id], map: "pharmacy_goods_receipts_org_id_key")
  @@unique([organizationId, branchId, id], map: "pharmacy_goods_receipts_org_branch_id_key")
  @@unique([organizationId, reference], map: "pharmacy_goods_receipts_org_reference_key")
  @@unique([organizationId, supplierId, supplierInvoiceRef], map: "pharmacy_goods_receipts_org_invoice_key")
  @@index([organizationId, branchId, status, receivedAt], map: "pharmacy_goods_receipts_org_branch_status_idx")
  @@index([organizationId, purchaseOrderId], map: "pharmacy_goods_receipts_org_order_idx")
  @@map("pharmacy_goods_receipts")
}

/// PUR-02 receiving — what actually arrived, at batch granularity. Every field
/// the PH-INV lot needs is here, because the lot is built from this row: a lot
/// that could not name its batch, expiry, printed MRP or pack conversion would
/// be stock nobody may sell (§8A invariants 2, 18). `acceptedCanonicalUnits`
/// and `rejectedCanonicalUnits` are the PUR-04 split; rejected units post to a
/// QUARANTINE or RETURNS location and never to AVAILABLE.
model PharmacyGoodsReceiptLine {
  id                        String                  @id @default(cuid())
  organizationId            String                  @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  branchId                  String
  goodsReceiptId            String
  lineNumber                Int
  /// Null on the PUR-05 direct path: there is no ordered line to match against.
  purchaseOrderLineId       String?
  medicineId                String
  packLevelId               String
  batchNumber               String
  printedExpiry             DateTime
  expiryPrecision           PharmacyExpiryPrecision
  printedMrpMinor           Int
  canonicalUnitsPerPack     Int
  receivedPacks             Int
  bonusPacks                Int                     @default(0)
  receivedCanonicalUnits    Int
  bonusCanonicalUnits       Int                     @default(0)
  acceptedCanonicalUnits    Int
  rejectedCanonicalUnits    Int                     @default(0)
  rejectionReason           String?
  invoicedPricePerPackMinor Int
  discountBps               Int                     @default(0)
  taxBps                    Int                     @default(0)
  taxCreditable             Boolean                 @default(false)
  /// Landed cost of one canonical unit, carried onto the lot. Bonus units
  /// divide the same money over more units and never add any (PUR-03).
  unitCostMinor             Int
  stockLocationId           String
  quarantineLocationId      String?
  /// Stamped when the receipt posts; the join from this document to the ledger.
  inventoryLotId            String?
  /// AI-03 / MED-04: confidence and source box for every extracted field.
  ocrFieldEvidence          Json?
  /// A human, never OCR confidence, confirms the regulated facts before posting.
  ocrRegulatedConfirmedAt   DateTime?
  ocrRegulatedConfirmedById String?
  /// DRAP 2D stock-in. Null when the pack was typed by hand.
  gtin                      String?
  /// Case-preserved serial from AI 21.
  serialNumber              String?
  /// Uppercase serial. Duplicate stock-in is rejected per organization and GTIN.
  serialKey                 String?
  gs1Warnings               String[]                @default([])
  createdAt                 DateTime                @default(now())

  goodsReceipt       PharmacyGoodsReceipt         @relation(fields: [organizationId, branchId, goodsReceiptId], references: [organizationId, branchId, id], onDelete: Restrict, map: "pharmacy_grl_receipt_fkey")
  purchaseOrderLine  PharmacyPurchaseOrderLine?   @relation(fields: [organizationId, purchaseOrderLineId], references: [organizationId, id], onDelete: Restrict, map: "pharmacy_grl_order_line_fkey")
  medicine           Medicine                     @relation(fields: [organizationId, medicineId], references: [organizationId, id], onDelete: Restrict, map: "pharmacy_grl_medicine_fkey")
  packLevel          PackLevel                    @relation(fields: [organizationId, packLevelId], references: [organizationId, id], onDelete: Restrict, map: "pharmacy_grl_pack_level_fkey")
  stockLocation      PharmacyStockLocation        @relation("PharmacyReceiptStock", fields: [organizationId, stockLocationId], references: [organizationId, id], onDelete: Restrict, map: "pharmacy_grl_location_fkey")
  quarantineLocation PharmacyStockLocation?       @relation("PharmacyReceiptQuarantine", fields: [organizationId, quarantineLocationId], references: [organizationId, id], onDelete: Restrict, map: "pharmacy_grl_quarantine_fkey")
  inventoryLot       PharmacyInventoryLot?        @relation(fields: [organizationId, branchId, inventoryLotId], references: [organizationId, branchId, id], onDelete: Restrict, map: "pharmacy_grl_lot_fkey")
  exceptions         PharmacyReceivingException[]

  @@unique([organizationId, id], map: "pharmacy_grl_org_id_key")
  @@unique([organizationId, branchId, id], map: "pharmacy_grl_org_branch_id_key")
  @@unique([organizationId, goodsReceiptId, lineNumber], map: "pharmacy_grl_org_receipt_line_key")
  @@index([organizationId, goodsReceiptId], map: "pharmacy_grl_org_receipt_idx")
  @@index([organizationId, purchaseOrderLineId], map: "pharmacy_grl_org_order_line_idx")
  @@index([organizationId, medicineId], map: "pharmacy_grl_org_medicine_idx")
  @@index([organizationId, gtin, serialKey], map: "pharmacy_grl_org_gtin_serial_idx")
  @@map("pharmacy_goods_receipt_lines")
}

/// PUR-04 — the three-way match result a human still has to close. Raised at
/// posting and OPEN, and therefore visible, until somebody records who resolved
/// it and why. Only the resolution columns may ever change (trigger), so a
/// shortage cannot shrink on its way to being closed.
model PharmacyReceivingException {
  id                  String                           @id @default(cuid())
  organizationId      String                           @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  branchId            String
  goodsReceiptId      String
  goodsReceiptLineId  String
  purchaseOrderLineId String?
  kind                PharmacyReceivingExceptionKind
  status              PharmacyReceivingExceptionStatus @default(OPEN)
  detail              String
  /// Quantity terms for SHORTAGE/OVERAGE/DAMAGE and for a pack conflict; money
  /// terms for a price conflict.
  expectedUnits       Int?
  observedUnits       Int?
  expectedMinor       Int?
  observedMinor       Int?
  raisedAt            DateTime                         @default(now())
  resolvedAt          DateTime?
  resolvedByUserId    String?
  resolutionNote      String?

  goodsReceipt      PharmacyGoodsReceipt       @relation(fields: [organizationId, branchId, goodsReceiptId], references: [organizationId, branchId, id], onDelete: Restrict, map: "pharmacy_rex_receipt_fkey")
  goodsReceiptLine  PharmacyGoodsReceiptLine   @relation(fields: [organizationId, branchId, goodsReceiptLineId], references: [organizationId, branchId, id], onDelete: Restrict, map: "pharmacy_rex_line_fkey")
  purchaseOrderLine PharmacyPurchaseOrderLine? @relation(fields: [organizationId, purchaseOrderLineId], references: [organizationId, id], onDelete: Restrict, map: "pharmacy_rex_order_line_fkey")

  @@unique([organizationId, id], map: "pharmacy_rex_org_id_key")
  @@unique([organizationId, goodsReceiptLineId, kind], map: "pharmacy_rex_org_line_kind_key")
  @@index([organizationId, branchId, status, raisedAt], map: "pharmacy_rex_org_branch_status_idx")
  @@index([organizationId, goodsReceiptId], map: "pharmacy_rex_org_receipt_idx")
  @@map("pharmacy_receiving_exceptions")
}

// ===========================================================================
// PH-PUR/PH-INV — supplier returns and the stock action centre
// (PRD §6.3 PUR-06, PUR-07; §8A invariants 9 and 29)
// ===========================================================================

/// PUR-06 — why stock is going back. The two kinds share one document because
/// they share one settlement path; they differ only in what opened the return
/// window (a commercial agreement vs the printed expiry).
enum PharmacyPurchaseReturnKind {
  PURCHASE_RETURN
  EXPIRY_CLAIM
}

/// PUR-06 / §8A invariant 29. DRAFT holds nothing: it neither reserves stock nor
/// moves it, which is what makes it safe for a one-click signal action. SUBMITTED
/// takes the INV-09 reservation, so the quantity stops being saleable. DISPATCHED
/// posts the RETURN_TO_SUPPLIER movements. SETTLED means credit has been
/// allocated against every debit note the return raised.
enum PharmacyPurchaseReturnStatus {
  DRAFT
  SUBMITTED
  DISPATCHED
  SETTLED
  CANCELLED
}

enum PharmacyDebitNoteStatus {
  OPEN
  PARTIALLY_SETTLED
  SETTLED
  CANCELLED
}

/// PUR-06 — the return or claim document. Branch-scoped like the rest of PH-INV;
/// the pharmacy branch entity itself lands with PLAT-03, so `branchId` carries no
/// foreign key and `organizationId` under FORCE RLS remains the tenant boundary.
model PharmacyPurchaseReturn {
  id                 String                       @id @default(cuid())
  organizationId     String                       @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  branchId           String
  supplierId         String
  kind               PharmacyPurchaseReturnKind
  status             PharmacyPurchaseReturnStatus @default(DRAFT)
  reference          String
  note               String?
  createdByUserId    String
  submittedByUserId  String?
  submittedAt        DateTime?
  dispatchedByUserId String?
  dispatchedAt       DateTime?
  settledAt          DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt

  supplier      PharmacySupplier             @relation(fields: [organizationId, supplierId], references: [organizationId, id], onDelete: Restrict)
  lines         PharmacyPurchaseReturnLine[]
  debitNotes    PharmacyDebitNote[]
  signalActions PharmacyStockSignalAction[]

  @@unique([organizationId, id], map: "pharmacy_purchase_returns_org_id_key")
  @@unique([organizationId, branchId, id], map: "pharmacy_purchase_returns_org_branch_id_key")
  @@unique([organizationId, reference], map: "pharmacy_purchase_returns_org_reference_key")
  @@index([organizationId, branchId, status], map: "pharmacy_purchase_returns_org_branch_status_idx")
  @@index([organizationId, supplierId, status], map: "pharmacy_purchase_returns_org_supplier_status_idx")
  @@map("pharmacy_purchase_returns")
}

/// PUR-06 — one lot going back. `quantityUnits` is an integer count of canonical
/// base units (§8A invariant 1). `returnWindowEndsAt` is the supplier's deadline;
/// `expectedCreditMinor` is what the pharmacy expects to be credited, which is
/// deliberately separate from what a supplier eventually pays.
model PharmacyPurchaseReturnLine {
  id                  String   @id @default(cuid())
  organizationId      String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  branchId            String
  purchaseReturnId    String
  lineNumber          Int
  inventoryLotId      String
  stockLocationId     String
  quantityUnits       Int
  reason              String
  returnWindowEndsAt  DateTime
  expectedCreditMinor Int
  /// The INV-09 reservation this line takes at submission. Null while the line
  /// is still on a DRAFT return, which is precisely why a draft holds no stock.
  supplierClaimId     String?
  createdAt           DateTime @default(now())

  purchaseReturn PharmacyPurchaseReturn @relation(fields: [organizationId, branchId, purchaseReturnId], references: [organizationId, branchId, id], onDelete: Restrict)
  lot            PharmacyInventoryLot   @relation(fields: [organizationId, branchId, inventoryLotId], references: [organizationId, branchId, id], onDelete: Restrict)
  location       PharmacyStockLocation  @relation(fields: [organizationId, stockLocationId], references: [organizationId, id], onDelete: Restrict)
  supplierClaim  PharmacySupplierClaim? @relation(fields: [organizationId, supplierClaimId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id], map: "pharmacy_purchase_return_lines_org_id_key")
  @@unique([organizationId, purchaseReturnId, lineNumber], map: "pharmacy_purchase_return_lines_org_return_line_key")
  @@index([organizationId, branchId, inventoryLotId], map: "pharmacy_purchase_return_lines_org_branch_lot_idx")
  @@map("pharmacy_purchase_return_lines")
}

/// PUR-06 — the pharmacy's claim on the supplier's account. `expectedCreditMinor`
/// is frozen from the return lines at issue time; what actually arrives is the
/// sum of the credit allocations beneath it, so expected and received are two
/// separately sourced numbers that can be compared rather than one that has been
/// overwritten (§8A invariant 27).
model PharmacyDebitNote {
  id                  String                  @id @default(cuid())
  organizationId      String                  @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  branchId            String
  supplierId          String
  purchaseReturnId    String
  reference           String
  status              PharmacyDebitNoteStatus @default(OPEN)
  expectedCreditMinor Int
  issuedByUserId      String
  issuedAt            DateTime                @default(now())
  cancelledAt         DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  supplier       PharmacySupplier                   @relation(fields: [organizationId, supplierId], references: [organizationId, id], onDelete: Restrict)
  purchaseReturn PharmacyPurchaseReturn             @relation(fields: [organizationId, branchId, purchaseReturnId], references: [organizationId, branchId, id], onDelete: Restrict)
  allocations    PharmacySupplierCreditAllocation[]

  @@unique([organizationId, id], map: "pharmacy_debit_notes_org_id_key")
  @@unique([organizationId, reference], map: "pharmacy_debit_notes_org_reference_key")
  @@unique([organizationId, purchaseReturnId], map: "pharmacy_debit_notes_org_return_key")
  @@index([organizationId, branchId, status], map: "pharmacy_debit_notes_org_branch_status_idx")
  @@index([organizationId, supplierId, status], map: "pharmacy_debit_notes_org_supplier_status_idx")
  @@map("pharmacy_debit_notes")
}

/// PUR-06 — a credit note the supplier actually issued. Recorded once, then
/// allocated across debit notes; the credit itself is never edited down.
model PharmacySupplierCredit {
  id               String   @id @default(cuid())
  organizationId   String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  branchId         String
  supplierId       String
  reference        String
  amountMinor      Int
  receivedAt       DateTime
  recordedByUserId String
  createdAt        DateTime @default(now())

  supplier    PharmacySupplier                   @relation(fields: [organizationId, supplierId], references: [organizationId, id], onDelete: Restrict)
  allocations PharmacySupplierCreditAllocation[]

  @@unique([organizationId, id], map: "pharmacy_supplier_credits_org_id_key")
  @@unique([organizationId, supplierId, reference], map: "pharmacy_supplier_credits_org_supplier_reference_key")
  @@index([organizationId, branchId, receivedAt], map: "pharmacy_supplier_credits_org_branch_received_idx")
  @@map("pharmacy_supplier_credits")
}

/// PUR-06 — settlement. Append-only (trigger): reallocating money is a new
/// allocation, never a rewritten one (§8A invariant 15).
model PharmacySupplierCreditAllocation {
  id                String   @id @default(cuid())
  organizationId    String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  supplierCreditId  String
  debitNoteId       String
  amountMinor       Int
  allocatedByUserId String
  createdAt         DateTime @default(now())

  credit    PharmacySupplierCredit @relation(fields: [organizationId, supplierCreditId], references: [organizationId, id], onDelete: Restrict)
  debitNote PharmacyDebitNote      @relation(fields: [organizationId, debitNoteId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id], map: "pharmacy_credit_allocations_org_id_key")
  @@unique([organizationId, supplierCreditId, debitNoteId], map: "pharmacy_credit_allocations_org_credit_note_key")
  @@index([organizationId, debitNoteId], map: "pharmacy_credit_allocations_org_note_idx")
  @@map("pharmacy_supplier_credit_allocations")
}

// ── PUR-07 — deterministic stock action centre ──────────────────────────────

enum PharmacyStockSignalKind {
  LOW_STOCK
  STOCKOUT
  PROJECTED_STOCKOUT
  INBOUND_COVERAGE
  NEAR_EXPIRY
  RETURN_WINDOW
  RECALL
  QUARANTINE
  COLD_CHAIN
  COUNT_VARIANCE
}

/// STALE is not a human decision — it is what the freshness policy does to a
/// signal whose evidence has aged out, so the operator is never asked to act on
/// a number the evaluator can no longer vouch for.
enum PharmacyStockSignalStatus {
  OPEN
  ACKNOWLEDGED
  SNOOZED
  DISMISSED
  CLOSED
  STALE
}

/// EXACT when every input behind the signal is settled ledger fact. PARTIAL when
/// an open count or an unresolved discrepancy means the on-hand number is itself
/// still in dispute — a deterministic statement about the inputs, not a forecast.
enum PharmacyStockSignalConfidence {
  EXACT
  PARTIAL
}

enum PharmacyStockSignalEventKind {
  RAISED
  REFRESHED
  ACKNOWLEDGED
  SNOOZED
  DISMISSED
  CLOSED
  MARKED_STALE
  DRAFT_ACTION
}

/// §8A invariant 29 — the complete set of things a one-click action may create.
/// Every member is a draft document; none of them is an order or a movement.
enum PharmacyStockSignalActionKind {
  DRAFT_REQUISITION
  DRAFT_TRANSFER
  DRAFT_CLAIM
}

/// PUR-07 — the approved replenishment policy a signal is measured against.
/// A signal that needs a safety-stock number is not raised at all until an
/// approved one exists, so the evaluator never invents a threshold.
model PharmacySafetyStock {
  id               String   @id @default(cuid())
  organizationId   String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  branchId         String
  medicineId       String
  safetyStockUnits Int
  /// The deterministic projection horizon in days: how far ahead expiry-driven
  /// depletion is looked at. Not a forecast — PUR-09 is out of scope here.
  coverageDays     Int      @default(30)
  approvedByUserId String
  approvedAt       DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  medicine Medicine @relation(fields: [organizationId, medicineId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id], map: "pharmacy_safety_stocks_org_id_key")
  @@unique([organizationId, branchId, medicineId], map: "pharmacy_safety_stocks_org_branch_medicine_key")
  @@map("pharmacy_safety_stocks")
}

/// PUR-07 — one deduplicated call to act. `dedupKey` is the (kind, product,
/// location, cause) identity the evaluator recomputes on every run; a partial
/// unique index keeps at most one live signal per key, so re-evaluating refreshes
/// the existing row instead of burying the operator in duplicates.
///
/// `neededUnits` / `onHandUnits` / `inboundUnits` are the exact numbers the
/// explanation was written from, kept so the decision stays auditable after the
/// underlying ledger has moved on (§8A invariant 29).
model PharmacyStockSignal {
  id                   String                        @id @default(cuid())
  organizationId       String                        @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  branchId             String
  kind                 PharmacyStockSignalKind
  dedupKey             String
  status               PharmacyStockSignalStatus     @default(OPEN)
  medicineId           String
  stockLocationId      String?
  inventoryLotId       String?
  cause                String
  ownerUserId          String
  dueAt                DateTime
  explanation          String
  dataWindowStart      DateTime
  dataWindowEnd        DateTime
  /// The newest ledger fact the evaluator read for this signal.
  sourceObservedAt     DateTime
  /// The freshness policy in force when the signal was computed, in seconds. The
  /// signal becomes STALE once `computedAt` is older than this.
  freshnessSeconds     Int
  confidence           PharmacyStockSignalConfidence
  neededUnits          Int
  onHandUnits          Int
  inboundUnits         Int
  computedAt           DateTime
  acknowledgedAt       DateTime?
  acknowledgedByUserId String?
  snoozedUntil         DateTime?
  snoozeReason         String?
  dismissedAt          DateTime?
  dismissedByUserId    String?
  dismissReason        String?
  closedAt             DateTime?
  markedStaleAt        DateTime?
  createdAt            DateTime                      @default(now())
  updatedAt            DateTime                      @updatedAt

  medicine Medicine                    @relation(fields: [organizationId, medicineId], references: [organizationId, id], onDelete: Restrict)
  location PharmacyStockLocation?      @relation(fields: [organizationId, stockLocationId], references: [organizationId, id], onDelete: Restrict)
  events   PharmacyStockSignalEvent[]
  actions  PharmacyStockSignalAction[]

  @@unique([organizationId, id], map: "pharmacy_stock_signals_org_id_key")
  @@unique([organizationId, branchId, id], map: "pharmacy_stock_signals_org_branch_id_key")
  @@index([organizationId, branchId, status, dueAt], map: "pharmacy_stock_signals_org_branch_status_due_idx")
  @@index([organizationId, ownerUserId, status, dueAt], map: "pharmacy_stock_signals_org_owner_status_due_idx")
  @@index([organizationId, branchId, kind, status], map: "pharmacy_stock_signals_org_branch_kind_idx")
  @@map("pharmacy_stock_signals")
}

/// PUR-07 / §8A invariant 29 — the audit trail behind every human decision on a
/// signal. Append-only (trigger).
model PharmacyStockSignalEvent {
  id             String                       @id @default(cuid())
  organizationId String                       @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  branchId       String
  signalId       String
  kind           PharmacyStockSignalEventKind
  actorId        String
  reason         String?
  detail         String?
  createdAt      DateTime                     @default(now())

  signal PharmacyStockSignal @relation(fields: [organizationId, branchId, signalId], references: [organizationId, branchId, id], onDelete: Restrict)

  @@unique([organizationId, id], map: "pharmacy_stock_signal_events_org_id_key")
  @@index([organizationId, branchId, signalId, createdAt], map: "pharmacy_stock_signal_events_org_signal_idx")
  @@map("pharmacy_stock_signal_events")
}

/// PUR-07 / §8A invariant 29 — the link from a signal to the DRAFT document one
/// click created. Exactly one of the three references is set, and all three point
/// at documents that are inert until a human advances them. Append-only.
model PharmacyStockSignalAction {
  id               String                        @id @default(cuid())
  organizationId   String                        @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  branchId         String
  signalId         String
  kind             PharmacyStockSignalActionKind
  actorId          String
  requisitionId    String?
  transferId       String?
  purchaseReturnId String?
  /// Nullable only for pre-identity historical actions; new drafts always bind both.
  idempotencyKey   String?
  payloadHash      String?
  createdAt        DateTime                      @default(now())

  signal         PharmacyStockSignal          @relation(fields: [organizationId, branchId, signalId], references: [organizationId, branchId, id], onDelete: Restrict)
  requisition    PharmacyRequisition?         @relation(fields: [organizationId, requisitionId], references: [organizationId, id], onDelete: Restrict)
  transfer       PharmacyInterbranchTransfer? @relation(fields: [organizationId, transferId], references: [organizationId, id], onDelete: Restrict)
  purchaseReturn PharmacyPurchaseReturn?      @relation(fields: [organizationId, purchaseReturnId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id], map: "pharmacy_stock_signal_actions_org_id_key")
  @@unique([organizationId, branchId, idempotencyKey], map: "pharmacy_stock_signal_actions_org_branch_intent_key")
  @@index([organizationId, branchId, signalId, createdAt], map: "pharmacy_stock_signal_actions_org_signal_idx")
  @@map("pharmacy_stock_signal_actions")
}

// ============================================
// PH-MIG — opening stock, parallel run and cutover
// (PRD §6.10 MIG-03, MIG-04, MIG-05)
//
// References to tables owned by earlier lanes (branches, migration batches and
// rows, manufacturing batches, stock locations, inventory lots, stock movements)
// are composite `(organizationId, …)` foreign keys declared in the migration SQL
// only, matching the SQL-only composite tenant foreign keys already used across
// this schema. Modelling them as Prisma relations would add relation scalars to
// models this lane does not own.
// ============================================

enum PharmacyOpeningSessionStatus {
  DRAFT
  COUNTED
  POSTED
  SIGNED_OFF
}

/// A line is READY only once every attribute an opening lot needs is present.
/// EXCEPTION is the state MIG-02's "never silently defaulted" rule produces: the
/// missing value stays NULL and the line cannot post.
enum PharmacyOpeningLineStatus {
  PENDING
  READY
  EXCEPTION
  POSTED
}

enum PharmacyOpeningExceptionBucket {
  MISSING_BATCH
  MISSING_EXPIRY
  MISSING_MRP
  MISSING_COST
  MISSING_LOCATION
  MISSING_SOURCE_REF
  MISSING_COUNT
}

enum PharmacyOpeningLedgerAccount {
  ACCOUNTS_PAYABLE
  ACCOUNTS_RECEIVABLE
  CASH
  BANK
}

enum PharmacyParallelRunStatus {
  OPEN
  CLOSED
}

enum PharmacyParallelRunMetric {
  SALES
  CASH
  STOCK_VALUE
}

enum PharmacyCutoverEventKind {
  CUTOVER
  ROLLBACK
}

/// Who owns receipt numbering. Absent any cutover event the incumbent still owns
/// it, so the resolved default is LEGACY rather than a stored row.
enum PharmacySequenceOwner {
  LEGACY
  DEVFATHOM
}

/// MIG-03 / MIG-05 decision D05 — the contract materiality threshold. Unset is
/// not "no threshold": with no row the resolved threshold is 0, so every variance
/// is material until the contract sets one.
model PharmacyMaterialityThreshold {
  id             String   @id @default(cuid())
  organizationId String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  branchId       String
  thresholdMinor BigInt   @default(0)
  thresholdUnits Int      @default(0)
  setByActorId   String
  setAt          DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, id], map: "pharmacy_materiality_thresholds_org_id_key")
  @@unique([organizationId, branchId], map: "pharmacy_materiality_thresholds_org_branch_key")
  @@map("pharmacy_materiality_thresholds")
}

/// MIG-03 — one opening-stock reconciliation for one branch: the mapped
/// migration rows on one side, a physical count on the other. Modelled on the
/// INV-06 count session (expected / counted / variance per line, threshold on
/// the session, co-authored sign-off) because an opening count IS a count — the
/// difference is only that its expected side comes from the incumbent's export
/// rather than from a balance this system already holds.
model PharmacyOpeningSession {
  id               String                       @id @default(cuid())
  organizationId   String                       @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  branchId         String
  migrationBatchId String?
  /// The instant the opening position is taken. Becomes the lot `receivedAt` and
  /// the movement `occurredAt`, so opening stock is receivable and movable.
  openingAt        DateTime
  status           PharmacyOpeningSessionStatus @default(DRAFT)
  createdByActorId String
  postedByActorId  String?
  postedAt         DateTime?
  signedOffBy      String?
  signedOffAt      DateTime?
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt

  lines      PharmacyOpeningStockLine[]
  exceptions PharmacyOpeningException[]
  totals     PharmacyOpeningTotal[]
  ledgers    PharmacyOpeningLedgerEntry[]

  @@unique([organizationId, id], map: "pharmacy_opening_sessions_org_id_key")
  @@unique([organizationId, branchId, id], map: "pharmacy_opening_sessions_org_branch_id_key")
  @@index([organizationId, branchId, status], map: "pharmacy_opening_sessions_org_branch_status_idx")
  @@map("pharmacy_opening_sessions")
}

/// One opening lot candidate. Every attribute an opening lot needs — batch,
/// expiry, printed MRP, cost, location, source ref — is NULLABLE and has NO
/// default: a value the incumbent did not supply stays missing and raises an
/// exception. A CHECK forbids POSTED while any of them is still NULL, so the
/// "never defaulted" rule survives a caller that skips the service.
model PharmacyOpeningStockLine {
  id                   String                    @id @default(cuid())
  organizationId       String                    @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  sessionId            String
  branchId             String
  migrationRowId       String?
  sourceRef            String?
  manufacturingBatchId String?
  batchNumber          String?
  expiryDate           DateTime?                 @db.Date
  expiryPrecision      PharmacyExpiryPrecision?
  printedMrpMinor      Int?
  unitCostMinor        Int?
  stockLocationId      String?
  packLevelId          String?
  unitsPerPack         Int?
  /// The incumbent's quantity for this lot, in canonical base units.
  expectedUnits        Int?
  /// What the physical count found, in canonical base units.
  countedUnits         Int?
  /// countedUnits - expectedUnits. The counted side is what posts.
  varianceUnits        Int?
  /// Why the variance is accepted. A material variance without one is
  /// UNEXPLAINED and blocks sign-off.
  varianceNote         String?
  status               PharmacyOpeningLineStatus @default(PENDING)
  postedLotId          String?
  postedMovementId     String?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  session    PharmacyOpeningSession     @relation(fields: [organizationId, sessionId], references: [organizationId, id], onDelete: Restrict)
  exceptions PharmacyOpeningException[]

  @@unique([organizationId, id], map: "pharmacy_opening_stock_lines_org_id_key")
  @@index([organizationId, sessionId, status], map: "pharmacy_opening_stock_lines_org_session_status_idx")
  @@index([organizationId, branchId], map: "pharmacy_opening_stock_lines_org_branch_idx")
  @@map("pharmacy_opening_stock_lines")
}

/// MIG-03 — the gap that stopped a line posting. Written in the same transaction
/// as the line it describes, so a line can never carry a gap without the
/// exception naming it. Resolution is one-way and never writes a value into the
/// line: a gap is repaired by re-stating the line from better source data.
model PharmacyOpeningException {
  id             String                         @id @default(cuid())
  organizationId String                         @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  sessionId      String
  lineId         String?
  bucket         PharmacyOpeningExceptionBucket
  detail         String
  resolvedBy     String?
  resolvedAt     DateTime?
  resolutionNote String?
  createdAt      DateTime                       @default(now())
  updatedAt      DateTime                       @updatedAt

  session PharmacyOpeningSession    @relation(fields: [organizationId, sessionId], references: [organizationId, id], onDelete: Restrict)
  line    PharmacyOpeningStockLine? @relation(fields: [organizationId, lineId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id], map: "pharmacy_opening_exceptions_org_id_key")
  @@index([organizationId, sessionId, bucket], map: "pharmacy_opening_exceptions_org_session_bucket_idx")
  @@index([organizationId, lineId], map: "pharmacy_opening_exceptions_org_line_idx")
  @@map("pharmacy_opening_exceptions")
}

/// MIG-03 — the signed opening totals for one branch: what quantity and what
/// value this branch opened with. Signed, because a correcting opening session
/// may open a branch with a negative adjustment. Append-only: an opening total
/// is what was posted, not what is currently believed.
model PharmacyOpeningTotal {
  id              String   @id @default(cuid())
  organizationId  String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  branchId        String
  sessionId       String
  totalUnits      Int
  totalValueMinor BigInt
  lineCount       Int
  actorId         String
  postedAt        DateTime @default(now())
  createdAt       DateTime @default(now())

  session PharmacyOpeningSession @relation(fields: [organizationId, sessionId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id], map: "pharmacy_opening_totals_org_id_key")
  @@unique([organizationId, sessionId], map: "pharmacy_opening_totals_org_session_key")
  @@index([organizationId, branchId, postedAt], map: "pharmacy_opening_totals_org_branch_idx")
  @@map("pharmacy_opening_totals")
}

/// MIG-03 — opening AP / AR / cash / bank as signed totals with actor and time.
/// The FIN lane reads these through the exported opening-ledger interface rather
/// than forking its own opening-balance path; this table is the interface's
/// storage, not a second chart of accounts.
model PharmacyOpeningLedgerEntry {
  id             String                       @id @default(cuid())
  organizationId String                       @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  branchId       String
  sessionId      String
  account        PharmacyOpeningLedgerAccount
  /// Signed minor units: a credit balance is negative, a debit balance positive.
  balanceMinor   BigInt
  sourceRef      String
  actorId        String
  postedAt       DateTime                     @default(now())
  createdAt      DateTime                     @default(now())

  session PharmacyOpeningSession @relation(fields: [organizationId, sessionId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id], map: "pharmacy_opening_ledger_entries_org_id_key")
  @@unique([organizationId, sessionId, account], map: "pharmacy_opening_ledger_entries_org_session_account_key")
  @@index([organizationId, branchId, account], map: "pharmacy_opening_ledger_entries_org_branch_account_idx")
  @@map("pharmacy_opening_ledger_entries")
}

/// MIG-04 — the window during which the branch enters every transaction into
/// both systems and this one is read-only evidence.
model PharmacyParallelRunWindow {
  id              String                    @id @default(cuid())
  organizationId  String                    @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  branchId        String
  startDate       DateTime                  @db.Date
  endDate         DateTime                  @db.Date
  status          PharmacyParallelRunStatus @default(OPEN)
  openedByActorId String
  closedByActorId String?
  closedAt        DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  entries     PharmacyParallelRunDailyEntry[]
  comparisons PharmacyParallelRunComparison[]

  @@unique([organizationId, id], map: "pharmacy_parallel_run_windows_org_id_key")
  @@unique([organizationId, branchId, startDate], map: "pharmacy_parallel_run_windows_org_branch_start_key")
  @@index([organizationId, branchId, status], map: "pharmacy_parallel_run_windows_org_branch_status_idx")
  @@map("pharmacy_parallel_run_windows")
}

/// MIG-04 — the incumbent's totals for one business date, typed in by the
/// operator. This is the only side of the comparison a human supplies, so it
/// carries its own actor and time and is never derived.
model PharmacyParallelRunDailyEntry {
  id                    String   @id @default(cuid())
  organizationId        String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  branchId              String
  windowId              String
  businessDate          DateTime @db.Date
  legacySalesMinor      BigInt
  legacyCashMinor       BigInt
  legacyStockValueMinor BigInt
  enteredByActorId      String
  enteredAt             DateTime @default(now())
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  window PharmacyParallelRunWindow @relation(fields: [organizationId, windowId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id], map: "pharmacy_parallel_run_daily_entries_org_id_key")
  @@unique([organizationId, windowId, businessDate], map: "pharmacy_parallel_run_daily_entries_org_window_date_key")
  @@index([organizationId, branchId, businessDate], map: "pharmacy_parallel_run_daily_entries_org_branch_date_idx")
  @@map("pharmacy_parallel_run_daily_entries")
}

/// MIG-04 — one metric compared for one business date. `diffMinor` is stored
/// rather than derived on read so the comparison a human explained is the
/// comparison that stays explained. `explained` is only meaningful when the diff
/// is material; an immaterial diff needs no note.
model PharmacyParallelRunComparison {
  id             String                    @id @default(cuid())
  organizationId String                    @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  branchId       String
  windowId       String
  businessDate   DateTime                  @db.Date
  metric         PharmacyParallelRunMetric
  devfathomMinor BigInt
  legacyMinor    BigInt
  diffMinor      BigInt
  thresholdMinor BigInt
  material       Boolean
  explained      Boolean                   @default(false)
  note           String?
  actorId        String
  comparedAt     DateTime                  @default(now())
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  window PharmacyParallelRunWindow @relation(fields: [organizationId, windowId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id], map: "pharmacy_parallel_run_comparisons_org_id_key")
  @@unique([organizationId, windowId, businessDate, metric], map: "pharmacy_parallel_run_comparisons_org_window_date_metric_key")
  @@index([organizationId, branchId, businessDate], map: "pharmacy_parallel_run_comparisons_org_branch_date_idx")
  @@map("pharmacy_parallel_run_comparisons")
}

/// MIG-04 — the immutable reference to the incumbent's archived data. The bytes
/// are NOT stored: the hash proves the archive handed over is the archive
/// referenced, exactly as MIG-01 treats a profiled source.
model PharmacyLegacyArchive {
  id                String   @id @default(cuid())
  organizationId    String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  branchId          String
  label             String
  /// SHA-256 of the archive, lowercase hex.
  contentHash       String
  /// Where the archive physically lives — a URI, a vault path, a shelf.
  storageLocation   String
  byteSize          BigInt
  archivedByActorId String
  archivedAt        DateTime @default(now())
  createdAt         DateTime @default(now())

  cutoverEvents PharmacyCutoverEvent[]

  @@unique([organizationId, id], map: "pharmacy_legacy_archives_org_id_key")
  @@unique([organizationId, contentHash], map: "pharmacy_legacy_archives_org_hash_key")
  @@index([organizationId, branchId, archivedAt], map: "pharmacy_legacy_archives_org_branch_idx")
  @@map("pharmacy_legacy_archives")
}

/// MIG-04 — cutover and rollback as APPEND-ONLY events. Ownership of receipt
/// numbering is the LATEST event's `sequenceOwner`, never a mutable flag: that is
/// what makes "rollback loses no cutover-window transactions" structural rather
/// than procedural. A rollback adds a row returning ownership to LEGACY; it
/// deletes nothing, rewinds no sequence, and the sales issued while DevFathom
/// owned the sequence keep their numbers.
model PharmacyCutoverEvent {
  id               String                   @id @default(cuid())
  organizationId   String                   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  branchId         String
  kind             PharmacyCutoverEventKind
  sequenceOwner    PharmacySequenceOwner
  effectiveAt      DateTime
  /// Only a CUTOVER defines one: the instant after which rollback is refused.
  rollbackDeadline DateTime?
  /// A ROLLBACK names the CUTOVER it reverses.
  cutoverEventId   String?
  legacyArchiveId  String?
  actorId          String
  reason           String
  createdAt        DateTime                 @default(now())

  legacyArchive PharmacyLegacyArchive? @relation(fields: [organizationId, legacyArchiveId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id], map: "pharmacy_cutover_events_org_id_key")
  @@index([organizationId, branchId, effectiveAt], map: "pharmacy_cutover_events_org_branch_effective_idx")
  @@map("pharmacy_cutover_events")
}

