// ============================================
// AUTH & USERS
// ============================================

model User {
  id                 String     @id @default(cuid())
  organizationId     String     @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  organizationRoleId String?
  name               String
  email              String     @unique
  password           String?
  role               Role       @default(EMPLOYEE)
  department         Department
  title              String
  avatar             String?
  phone              String?
  bio                String?
  skills             String[]   @default([])
  startDate          DateTime   @default(now())
  status             UserStatus @default(ACTIVE)
  lastActiveAt       DateTime?
  // AUTH-01 / IMP-AUTH-03: bumped on password change, admin reset, and lay-off so
  // all other live JWT sessions are invalidated on the next jwt() revalidation.
  // "Sign out everywhere" bumps it too. passwordChangedAt is kept for display/audit.
  tokenVersion       Int        @default(0)
  passwordChangedAt  DateTime?
  // IMP-DASH-02: per-user dashboard widget layout/visibility prefs (JSON blob).
  preferences        Json?
  // IMP-AUTH-04: per-type/channel notification opt-outs, honored by notify().
  notificationPrefs  Json?
  // IMP-AUTH-02: TOTP 2FA. Secret is base32; enabledAt null = 2FA off (the secret
  // may exist transiently during enrolment before the first verify).
  twoFactorSecret    String?
  twoFactorEnabledAt DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  // Relations
  organization         Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationRole     OrganizationRole?        @relation(fields: [organizationRoleId], references: [id], onDelete: SetNull)
  permissionOverrides  UserPermissionOverride[]
  projectMembers       ProjectMember[]
  assignedTasks        TaskAssignee[]
  taskComments         TaskComment[]
  createdTasks         Task[]                   @relation("TaskCreator")
  sentMessages         Message[]
  channelMembers       ChannelMember[]
  createdChannels      Channel[]
  messageMentions      MessageMention[]
  pinnedMessages       PinnedMessage[]
  savedMessages        SavedMessage[]
  leaveRequests        LeaveRequest[]           @relation("LeaveRequester")
  approvedLeaves       LeaveRequest[]           @relation("LeaveApprover")
  performanceNotes     PerformanceNote[]        @relation("NoteSubject")
  writtenNotes         PerformanceNote[]        @relation("NoteAuthor")
  activities           Activity[]
  notifications        Notification[]
  uploadedFiles        ProjectFile[]
  uploadedDocs         Document[]
  timeEntries          TimeEntry[]
  meetingAttendees     MeetingAttendee[]
  apiTokens            ApiToken[]
  authoredNotes        Note[]                   @relation("NoteAuthor")
  noteShares           NoteShare[]
  columnDefaults       ColumnDefaultAssignee[]
  attendanceLog        MeetingAttendanceLog[]
  invitation           Invitation?              @relation("UserInvitation")
  invitationsSent      Invitation[]             @relation("InvitationsSent")
  passwordResetTokens  PasswordResetToken[]
  // IMP-HR-04 performance reviews + IMP-NOTE-02 note mentions
  reviewCyclesCreated  ReviewCycle[]            @relation("ReviewCycleCreator")
  reviewsAbout         Review[]                 @relation("ReviewSubject")
  reviewsWritten       Review[]                 @relation("ReviewReviewer")
  noteMentions         NoteMention[]
  // Big Bets: NOTE-01 versioning, HR-01 leave balances, AUTH-02 recovery codes
  noteRevisions        NoteRevision[]           @relation("NoteRevisionEditor")
  leaveBalances        LeaveBalance[]           @relation("UserLeaveBalances")
  recoveryCodes        TwoFactorRecoveryCode[]
  webhooksCreated      Webhook[]                @relation("WebhookCreator")
  auditLogs            AuditLog[]               @relation("UserAuditLogs")
  resignations         Resignation[]            @relation("UserResignations")
  resignationsReviewed Resignation[]            @relation("ResignationsReviewed")
  // Email integration: connected Gmail/Outlook mailboxes feeding the unified inbox.
  mailboxes            Mailbox[]

  @@index([organizationId])
  @@map("users")
}

// A self-service "quit the company" request. An employee submits one (reason +
// proposed last working day); it sits PENDING until an HR or ADMIN reviewer
// approves/declines it. Approval records the confirmed lastWorkingDay but does
// NOT itself deactivate the account — offboarding happens on/after that day
// (e.g. via the Lay-off action), so access is not pulled out from under someone
// who is still working their notice period.
model Resignation {
  id              String            @id @default(cuid())
  organizationId  String            @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  userId          String
  reason          String
  proposedLastDay DateTime
  status          ResignationStatus @default(PENDING)
  reviewedById    String?
  reviewedAt      DateTime?
  reviewNote      String?
  lastWorkingDay  DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user       User  @relation("UserResignations", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("ResignationsReviewed", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([userId])
  @@index([organizationId])
  @@map("resignations")
}

// A pending invitation for a User created in the INVITED state. The raw token is
// emailed to the invitee; only its SHA-256 hash is stored here. Accepting the
// invite sets the user's password, flips status to ACTIVE, and stamps acceptedAt.
model Invitation {
  id             String    @id @default(cuid())
  organizationId String    @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  userId         String    @unique
  user           User      @relation("UserInvitation", fields: [userId], references: [id], onDelete: Cascade)
  email          String
  tokenHash      String    @unique
  invitedById    String?
  invitedBy      User?     @relation("InvitationsSent", fields: [invitedById], references: [id], onDelete: SetNull)
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId])
  @@map("invitations")
}

// IMP-AUTH-01: self-service password reset. Single-use, expiring token; only the
// SHA-256 hash is stored (raw token is emailed once), mirroring Invitation.
model PasswordResetToken {
  id             String    @id @default(cuid())
  organizationId String    @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  userId         String
  tokenHash      String    @unique
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
  @@map("password_reset_tokens")
}

// IMP-HR-04: a real performance-review process (cycles + per-subject reviews),
// distinct from the freeform PerformanceNote table.
model ReviewCycle {
  id             String   @id @default(cuid())
  organizationId String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  name           String
  startDate      DateTime
  endDate        DateTime
  status         String   @default("OPEN") // OPEN | CLOSED
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  createdBy User     @relation("ReviewCycleCreator", fields: [createdById], references: [id])
  reviews   Review[]

  @@index([organizationId])
  @@map("review_cycles")
}

model Review {
  id             String    @id @default(cuid())
  organizationId String    @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  cycleId        String
  subjectId      String
  reviewerId     String
  rating         Int? // 1..5
  strengths      String?
  improvements   String?
  comments       String?
  status         String    @default("DRAFT") // DRAFT | SUBMITTED
  submittedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  cycle    ReviewCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  subject  User        @relation("ReviewSubject", fields: [subjectId], references: [id], onDelete: Cascade)
  reviewer User        @relation("ReviewReviewer", fields: [reviewerId], references: [id], onDelete: Cascade)

  @@unique([cycleId, subjectId, reviewerId])
  @@index([subjectId])
  @@index([reviewerId])
  @@index([organizationId])
  @@map("reviews")
}

// ============================================
// CLIENTS
// ============================================

model Client {
  id             String       @id @default(cuid())
  organizationId String       @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  name           String
  logo           String?
  website        String?
  industry       String?
  location       String?
  timezone       String?
  notes          String?
  status         ClientStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Relations
  contacts     ClientContact[]
  projects     Project[]
  invoices     Invoice[]
  documents    Document[]
  transactions Transaction[]
  richNotes    Note[]
  contracts    Contract[]

  @@index([organizationId])
  @@map("clients")
}

model ClientContact {
  id             String   @id @default(cuid())
  organizationId String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  clientId       String
  name           String
  email          String?
  phone          String?
  role           String?
  isPrimary      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("client_contacts")
}

model Contract {
  id             String         @id @default(cuid())
  organizationId String         @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  clientId       String
  title          String
  fileUrl        String? // link to the signed document
  value          Decimal?       @db.Decimal(12, 2)
  currency       Currency       @default(USD)
  status         ContractStatus @default(DRAFT)
  startDate      DateTime?
  endDate        DateTime?
  signedAt       DateTime?
  notes          String?
  // IMP-CLI-05: optionally tie a contract to the delivery project it funds.
  projectId      String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  client  Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([status])
  @@index([projectId])
  @@index([organizationId])
  @@map("contracts")
}

// ============================================
// PROJECTS
// ============================================

model Project {
  id             String        @id @default(cuid())
  organizationId String        @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  name           String
  description    String?
  status         ProjectStatus @default(ACTIVE)
  type           ProjectType
  startDate      DateTime?
  endDate        DateTime?
  techStack      String[]      @default([])
  budget         Decimal?      @db.Decimal(12, 2)
  clientId       String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Relations
  client       Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  members      ProjectMember[]
  boards       Board[]
  milestones   Milestone[]
  files        ProjectFile[]
  invoices     Invoice[]
  transactions Transaction[]
  timeEntries  TimeEntry[]
  notes        Note[]
  contracts    Contract[] // IMP-CLI-05: contracts linked to this delivery project

  @@index([organizationId])
  @@map("projects")
}

model ProjectMember {
  id             String @id @default(cuid())
  organizationId String @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  projectId      String
  userId         String
  role           String @default("MEMBER") // LEAD, MEMBER

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@index([organizationId])
  @@map("project_members")
}

// ============================================
// KANBAN BOARDS
// ============================================

model Board {
  id             String   @id @default(cuid())
  organizationId String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  name           String
  description    String?
  projectId      String
  trelloBoardId  String?  @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  project Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  columns Column[]
  labels  Label[]

  @@index([organizationId])
  @@map("boards")
}

model Column {
  id             String   @id @default(cuid())
  organizationId String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  name           String
  boardId        String
  order          Int
  // IMP-PROJ-07: optional work-in-progress limit; the board warns/blocks past it.
  wipLimit       Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  board            Board                   @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks            Task[]
  defaultAssignees ColumnDefaultAssignee[]

  @@index([organizationId])
  @@map("columns")
}

// When a task enters this column (created here or moved in), each user in
// this list is added to the task's assignees (additively, via skipDuplicates).
model ColumnDefaultAssignee {
  id             String   @id @default(cuid())
  organizationId String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  columnId       String
  userId         String
  createdAt      DateTime @default(now())

  column Column @relation(fields: [columnId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([columnId, userId])
  @@index([userId])
  @@index([organizationId])
  @@map("column_default_assignees")
}

model Label {
  id             String @id @default(cuid())
  organizationId String @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  name           String
  color          String // hex color
  boardId        String

  // Relations
  board Board       @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks TaskLabel[]

  @@index([organizationId])
  @@map("labels")
}

model Task {
  id             String    @id @default(cuid())
  organizationId String    @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  title          String
  description    String?
  columnId       String
  order          Int
  priority       Priority  @default(MEDIUM)
  dueDate        DateTime?
  createdById    String
  // IMP-PROJ-06: optional parent for subtasks (self-relation).
  parentId       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  column      Column           @relation(fields: [columnId], references: [id], onDelete: Cascade)
  createdBy   User             @relation("TaskCreator", fields: [createdById], references: [id])
  parent      Task?            @relation("TaskSubtasks", fields: [parentId], references: [id], onDelete: SetNull)
  subtasks    Task[]           @relation("TaskSubtasks")
  blockedBy   TaskBlocker[]    @relation("BlockedTask")
  blocking    TaskBlocker[]    @relation("BlockingTask")
  assignees   TaskAssignee[]
  labels      TaskLabel[]
  checklists  TaskChecklist[]
  comments    TaskComment[]
  attachments TaskAttachment[]
  timeEntries TimeEntry[]

  @@index([columnId, order])
  @@index([createdById])
  @@index([parentId])
  @@index([organizationId])
  @@map("tasks")
}

// IMP-PROJ-06: a "blocked-by" edge between two tasks. Cycle prevention lives in
// the router (reject an edge that would close a loop), not the DB.
model TaskBlocker {
  id             String   @id @default(cuid())
  organizationId String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  blockedTaskId  String
  blockingTaskId String
  createdAt      DateTime @default(now())

  blockedTask  Task @relation("BlockedTask", fields: [blockedTaskId], references: [id], onDelete: Cascade)
  blockingTask Task @relation("BlockingTask", fields: [blockingTaskId], references: [id], onDelete: Cascade)

  @@unique([blockedTaskId, blockingTaskId])
  @@index([blockingTaskId])
  @@index([organizationId])
  @@map("task_blockers")
}

model TaskAssignee {
  id             String @id @default(cuid())
  organizationId String @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  taskId         String
  userId         String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([userId])
  @@index([organizationId])
  @@map("task_assignees")
}

model TaskLabel {
  id             String @id @default(cuid())
  organizationId String @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  taskId         String
  labelId        String

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@unique([taskId, labelId])
  @@index([organizationId])
  @@map("task_labels")
}

model TaskChecklist {
  id             String @id @default(cuid())
  organizationId String @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  name           String
  taskId         String
  order          Int    @default(0)

  task  Task                @relation(fields: [taskId], references: [id], onDelete: Cascade)
  items TaskChecklistItem[]

  @@index([organizationId])
  @@map("task_checklists")
}

model TaskChecklistItem {
  id             String  @id @default(cuid())
  organizationId String  @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  text           String
  completed      Boolean @default(false)
  checklistId    String
  order          Int     @default(0)

  checklist TaskChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("task_checklist_items")
}

model TaskComment {
  id             String   @id @default(cuid())
  organizationId String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  content        String
  taskId         String
  userId         String
  parentId       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  task    Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id])
  parent  TaskComment?  @relation("CommentThread", fields: [parentId], references: [id])
  replies TaskComment[] @relation("CommentThread")

  @@index([taskId])
  @@index([userId, createdAt])
  @@index([organizationId])
  @@map("task_comments")
}

model TaskAttachment {
  id             String   @id @default(cuid())
  organizationId String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  name           String
  url            String
  type           String?
  size           Int?
  taskId         String
  createdAt      DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("task_attachments")
}

// ============================================
// TIME TRACKING
// ============================================

model TimeEntry {
  id             String   @id @default(cuid())
  organizationId String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  userId         String
  taskId         String?
  projectId      String
  description    String?
  hours          Decimal  @db.Decimal(5, 2)
  date           DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  task    Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("time_entries")
}

// ============================================
// FINANCE
// ============================================

model Invoice {
  id             String        @id @default(cuid())
  organizationId String        @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  invoiceNumber  String        @unique
  clientId       String
  projectId      String?
