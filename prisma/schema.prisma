/// RX-07: a patient-context, capture-only refill reminder draft. The immutable
/// row snapshots the dispensed quantity and reviewed bilingual directions so a
/// later card never drifts from what the pharmacist approved. No delivery state
/// exists here; CRM-W03 owns delivery in a separate purpose boundary.
model PharmacyRefillReminderCapture {
  id                   String                            @id @default(cuid())
  organizationId       String                            @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  branchId             String
  prescriptionFillId   String
  patientId            String
  channel              PatientConsentChannel
  consentEventId       String
  pharmacistDecisionId String?
  medicineName         String
  strength             String
  dosageForm           String
  directionsEnglish    String
  directionsUrdu       String
  quantityDispensed    Int
  dosesPerDay          Decimal                           @db.Decimal(10, 4)
  expectedExhaustionAt DateTime
  reminderAt           DateTime
  status               String                            @default("CAPTURED")
  captureMode          Boolean                           @default(true)
  capturedByUserId     String
  capturedAt           DateTime                          @default(now())
  idempotencyKey       String
  branch               PharmacyBranch                    @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)
  fill                 PrescriptionFill                  @relation(fields: [organizationId, prescriptionFillId], references: [organizationId, id], onDelete: Restrict)
  patient              PharmacyPatient                   @relation(fields: [organizationId, patientId], references: [organizationId, id], onDelete: Restrict)
  consentEvent         PatientConsent                    @relation(fields: [organizationId, consentEventId], references: [organizationId, id], onDelete: Restrict)
  pharmacistDecision   PharmacyPharmacistReviewDecision? @relation(fields: [organizationId, pharmacistDecisionId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, prescriptionFillId])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, branchId, reminderAt])
  @@index([organizationId, patientId, capturedAt])
  @@map("pharmacy_refill_reminder_captures")
}

