// ============================================
// DevFathom — Complete Database Schema
// All models for all modules
// ============================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// CAM-L1 camera registry. Kept separate from RestaurantRegisteredDevice so a
// camera gateway cannot participate in POS/KDS trust relations.
model RestaurantCameraGateway {
  id                String    @id @default(cuid())
  organizationId    String    @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  branchId          String
  name              String
  gatewaySecretHash String    @unique
  status            String    @default("ACTIVE")
  revokedAt         DateTime?
  lastSeenAt        DateTime?
  baseUrl           String
  retentionDays     Int       @default(7)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([organizationId, branchId])
  @@map("restaurant_camera_gateways")
}

model RestaurantCameraCredential {
  id             String    @id @default(cuid())
  organizationId String    @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  sealedValue    String
  version        Int       @default(1)
  rotatedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId])
  @@map("restaurant_camera_credentials")
}

model RestaurantCamera {
  id             String        @id @default(cuid())
  organizationId String        @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  gatewayId      String
  branchId       String
  credentialId   String
  name           String
  sourceRef      String
  enabled        Boolean       @default(true)
  /// CAM-3: KITCHEN or COUNTER only (CHECK in the migration).
  preset         CameraPreset?
  lastSeenAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId, branchId])
  @@index([gatewayId])
  @@map("restaurant_cameras")
}

model RestaurantCameraStreamGrant {
  id             String    @id @default(cuid())
  organizationId String    @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  cameraId       String
  viewerId       String
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  @@index([organizationId, cameraId, viewerId])
  @@index([expiresAt])
  @@map("restaurant_camera_stream_grants")
}

model PlatformCameraBrandPreset {
  id                     String   @id @default(cuid())
  key                    String   @unique
  familyName             String
  aliases                String[]
  iconKey                String
  rtspPort               Int      @default(554)
  onvifPort              Int      @default(80)
  mainStreamPathTemplate String
  subStreamPathTemplate  String
  authSchemeHint         String
  defaultUsernameHint    String?
  credentialNote         String
  setupNote              String
  active                 Boolean  @default(true)
  sortOrder              Int      @default(0)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([active, sortOrder])
  @@map("platform_camera_brand_presets")
}

datasource db {
  provider = "postgresql"
}

enum PharmacyProductFamily {
  PHARMACEUTICAL
  BIOLOGICAL
  DEVICE
  ALTERNATIVE
  FRONT_SHOP
}

enum MedicineProvenanceStatus {
  UNREVIEWED
  ACCEPTED
  CORRECTED
  REJECTED
  SUPERSEDED
}

/// SAFE-01: platform-owned, effective-dated jurisdiction configuration. The
/// JSON rule fields retain per-value provenance (`provisional` + `toConfirm`)
/// instead of turning unconfirmed counsel assumptions into permissive enums.
model JurisdictionRuleSet {
  id                        String    @id @default(cuid())
  code                      String
  version                   Int
  effectiveFrom             DateTime
  effectiveTo               DateTime?
  licenceCategories         Json
  permittedSchedules        Json
  prescriptionOnlyClasses   Json
  prescriptionRetentionDays Json
  controlledRegisterFlags   Json
  pharmacistCoverageRule    Json
  recordRetentionByClass    Json
  createdAt                 DateTime  @default(now())
  isPlaceholder             Boolean   @default(false)

  regulatoryProfiles BranchRegulatoryProfile[]

  @@unique([code, version])
  @@index([code, effectiveFrom, effectiveTo])
  @@map("pharmacy_jurisdiction_rule_sets")
}

/// PLAT-02: an immutable effective-dated snapshot for one branch. PLAT-04 turns
/// `branchId` from a bare scope seam into a foreign key onto {@link PharmacyBranch};
/// it is still never accepted without the tenant-scoped organizationId.
model BranchRegulatoryProfile {
  id                               String    @id @default(cuid())
  organizationId                   String    @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  branchId                         String
  version                          Int
  effectiveFrom                    DateTime
  effectiveTo                      DateTime?
  provinceCode                     String
  jurisdictionRuleSetId            String
  premises                         Json
  licenceCategory                  String
  licenceNumber                    String
  licenceIssuingAuthority          String?
  licenceValidFrom                 DateTime
  licenceValidTo                   DateTime
  licenceExpiryLabel               String?
  licenceEvidenceFileRef           String
  permittedSchedules               String[]
  qualifiedPersonRegistration      String
  qualifiedPersonValidFrom         DateTime
  qualifiedPersonValidTo           DateTime
  qualifiedPersonCoverageRosterRef String
  ntn                              String?
  strn                             String?
  fiscalStatus                     String
  retentionPolicy                  Json
  createdAt                        DateTime  @default(now())
  isPlaceholder                    Boolean   @default(false)

  jurisdictionRuleSet JurisdictionRuleSet @relation(fields: [jurisdictionRuleSetId], references: [id], onDelete: Restrict)
  branch              PharmacyBranch      @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, branchId, version])
  @@index([organizationId, branchId, effectiveFrom, effectiveTo])
  @@index([jurisdictionRuleSetId])
  @@map("pharmacy_branch_regulatory_profiles")
}

/// PLAT-04 — the pharmacy branch aggregate. Every branch-owned pharmacy record
/// (regulatory profile, stock location, inventory lot, requisition, purchase
/// order) references it by the composite (organizationId, id), so a branch id
/// borrowed from another tenant fails the foreign key in the database rather
/// than being filtered out by a router that might forget the predicate.
/// `organizationId` remains the tenant boundary under FORCE row-level security;
/// the branch is a scope *inside* that boundary, never a substitute for it.
model PharmacyBranch {
  whatsappMessageLogs    PharmacyMessageLog[]
  receiptLayout          Json?
  receiptLayoutRevision  Int                  @default(0)
  id                     String               @id @default(cuid())
  organizationId         String               @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  code                   String
  name                   String
  addressLine            String
  city                   String
  provinceCode           String
  active                 Boolean              @default(true)
  /// The stock location a branch-scoped operation defaults to. Nullable because
  /// a branch is created before its locations exist. The database constrains it
  /// to a location of *this* branch, via a composite foreign key on
  /// (organizationId, id, defaultStockLocationId) — expressed in SQL only,
  /// because modelling it as a Prisma relation would make `id` a relation
  /// scalar of this model and break ordinary writes to it.
  defaultStockLocationId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  regulatoryProfiles                       BranchRegulatoryProfile[]
  stockLocations                           PharmacyStockLocation[]           @relation("PharmacyBranchStockLocations")
  inventoryLots                            PharmacyInventoryLot[]
  requisitions                             PharmacyRequisition[]
  purchaseOrders                           PharmacyPurchaseOrder[]
  onboardingGates                          PharmacyOnboardingGateState[]
  registeredDevices                        PharmacyRegisteredDevice[]
  ownerDigestSettings                      PharmacyOwnerDigestSetting[]
  ownerDigestCaptures                      PharmacyOwnerDigestCapture[]
  refillReminderCaptures                   PharmacyRefillReminderCapture[]
  pharmacovigilanceReports                 PharmacyPharmacovigilanceReport[]
  customerOrders                           PharmacyCustomerOrder[]
  visibilityPharmacyAccountingPeriod       PharmacyAccountingPeriod[]        @relation("PharmacyAccountingPeriodVisibilityAnchor")
  visibilityPharmacyBankStatementLine      PharmacyBankStatementLine[]       @relation("PharmacyBankStatementLineVisibilityAnchor")
  visibilityPharmacyBookkeepingTransaction PharmacyBookkeepingTransaction[]  @relation("PharmacyBookkeepingTransactionVisibilityAnchor")
  visibilityPharmacyDailyClose             PharmacyDailyClose[]              @relation("PharmacyDailyCloseVisibilityAnchor")
  visibilityPharmacyDrawerSession          PharmacyDrawerSession[]           @relation("PharmacyDrawerSessionVisibilityAnchor")
  visibilityPharmacyReceiptNumberSequence  PharmacyReceiptNumberSequence[]   @relation("PharmacyReceiptNumberSequenceVisibilityAnchor")
  visibilityPharmacySale                   PharmacySale[]                    @relation("PharmacySaleVisibilityAnchor")
  visibilityPharmacySettlementBatch        PharmacySettlementBatch[]         @relation("PharmacySettlementBatchVisibilityAnchor")
  visibilityPharmacyTaxProfileVersion      PharmacyTaxProfileVersion[]       @relation("PharmacyTaxProfileVersionVisibilityAnchor")
  visibilityUnfulfilledDemandEvent         UnfulfilledDemandEvent[]          @relation("UnfulfilledDemandEventVisibilityAnchor")
  visibilityPharmacyRestockInterest        PharmacyRestockInterest[]         @relation("PharmacyRestockInterestVisibilityAnchor")
  branchAssignments                        PharmacyBranchAssignment[]

  @@unique([organizationId, id], map: "pharmacy_branches_org_id_key")
  @@unique([organizationId, code], map: "pharmacy_branches_org_code_key")
  @@index([organizationId, active], map: "pharmacy_branches_org_active_idx")
  @@map("pharmacy_branches")
}

/// Active assignment of a tenant user to one pharmacy branch. Receipt reads use
/// this table, never restaurant staff profiles. An empty set is not a grant.
model PharmacyBranchAssignment {
  id             String   @id @default(cuid())
  organizationId String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  branchId       String
  userId         String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  branch PharmacyBranch @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Cascade)
  user   User           @relation(fields: [organizationId, userId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, branchId, userId], map: "pharmacy_branch_assignments_org_branch_user_key")
  @@index([organizationId, userId, active])
  @@map("pharmacy_branch_assignments")
}

/// INV-10 — the deliberately narrow doorway into the chain purchasing view.
/// A null branch grants this user the organization view; a non-null branch
/// grants only that branch. It is not consulted by any other pharmacy screen.
model PharmacyCentralPurchasingAccess {
  id             String   @id @default(cuid())
  organizationId String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  userId         String
  branchId       String?
  grantedById    String
  createdAt      DateTime @default(now())

  @@unique([organizationId, id], map: "pharmacy_central_purchasing_access_org_id_key")
  @@index([organizationId, userId, branchId], map: "pharmacy_central_purchasing_access_scope_idx")
  @@map("pharmacy_central_purchasing_access")
}

/// INV-10 — allocation evidence only. Physical custody remains exclusively in
/// the INV-07 transfer and stock-movement tables named here.
model PharmacyCentralPurchaseAllocation {
  id                  String   @id @default(cuid())
  organizationId      String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  sourceBranchId      String
  destinationBranchId String
  goodsReceiptLineId  String
  transferId          String
  transferLineId      String
  quantityUnits       Int
  allocatedById       String
  createdAt           DateTime @default(now())

  @@unique([organizationId, id], map: "pharmacy_central_purchase_allocations_org_id_key")
  @@unique([organizationId, goodsReceiptLineId, destinationBranchId], map: "pharmacy_central_purchase_allocations_once_key")
  @@index([organizationId, sourceBranchId, createdAt], map: "pharmacy_central_purchase_allocations_source_idx")
  @@index([organizationId, destinationBranchId, createdAt], map: "pharmacy_central_purchase_allocations_destination_idx")
  @@map("pharmacy_central_purchase_allocations")
}

/// PLAT-03 — the twelve onboarding steps of PRD §6.1, in the order the operator
/// walks them.
enum PharmacyOnboardingGate {
  ORG_TYPE
  LEGAL_BUSINESS
  LAUNCH_JURISDICTION
  PREMISES_AND_LICENCES
  BRANCHES_AND_LOCATIONS
  COMMERCIAL_PACKAGE
  OWNER_AND_ROLE_TEMPLATES
  MEDICINE_CATALOG_READINESS
  OPENING_STOCK_READINESS
  PARTIES_AND_BALANCES
  DEVICES_AND_DOCUMENTS
  READINESS_AND_PARALLEL_RUN
}

enum PharmacyOnboardingGateStatus {
  NOT_STARTED
  IN_PROGRESS
  PASSED
  FAILED
}

/// PLAT-03 — one onboarding record per organization. The row itself carries no
/// readiness verdict: readiness is always recomputed by
/// `evaluatePharmacyReadiness`, so a stored row can never assert a readiness the
/// underlying data does not support.
model PharmacyOnboardingState {
  id             String   @id @default(cuid())
  organizationId String   @unique @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  startedAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  gates        PharmacyOnboardingGateState[]
  events       PharmacyOnboardingEvent[]

  @@map("pharmacy_onboarding_states")
}

/// PLAT-03 — the latest recorded status of one gate. This is a *claim*, not a
/// verdict: `evaluatePharmacyReadiness` downgrades any PASSED claim the evidence
/// does not support, which is what stops seed or bootstrap data faking readiness.
model PharmacyOnboardingGateState {
  id             String                       @id @default(cuid())
  organizationId String                       @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  gate           PharmacyOnboardingGate
  status         PharmacyOnboardingGateStatus @default(NOT_STARTED)
  /// Where the operator's evidence for this claim lives. Required for a PASSED
  /// claim on a gate the platform cannot verify from data.
  evidenceRef    String?
  /// The branch a branch-specific gate was recorded against, if any.
  branchId       String?
  actorId        String?
  recordedAt     DateTime?
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt

  state  PharmacyOnboardingState @relation(fields: [organizationId], references: [organizationId], onDelete: Cascade)
  branch PharmacyBranch?         @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, gate], map: "pharmacy_onboarding_gate_states_org_gate_key")
  @@index([organizationId, status], map: "pharmacy_onboarding_gate_states_org_status_idx")
  @@map("pharmacy_onboarding_gate_states")
}

/// PLAT-03 — the append-only transition log. Enforced append-only by trigger, so
/// an onboarding history cannot be rewritten to look cleaner than it was.
model PharmacyOnboardingEvent {
  id             String                        @id @default(cuid())
  organizationId String                        @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  gate           PharmacyOnboardingGate
  fromStatus     PharmacyOnboardingGateStatus?
  toStatus       PharmacyOnboardingGateStatus
  evidenceRef    String?
  actorId        String
  note           String?
  occurredAt     DateTime                      @default(now())

  state PharmacyOnboardingState @relation(fields: [organizationId], references: [organizationId], onDelete: Cascade)

  @@index([organizationId, gate, occurredAt], map: "pharmacy_onboarding_events_org_gate_occurred_idx")
  @@map("pharmacy_onboarding_events")
}

enum MedicineProvenanceSourceType {
  REGULATOR
  MANUFACTURER
  SCRAPED
  USER
  IMPORT
}

enum MedicineBarcodeType {
  GTIN
  MANUFACTURER
  INTERNAL
}

enum MedicineAliasType {
  BRAND
  GENERIC
  URDU
  TRANSLITERATION
  LEGACY_CODE
}

enum MedicineReviewAction {
  ACCEPT
  CORRECT
  SPLIT
  MERGE
  REJECT
  DEFER
}

enum MedicinePublicationBatchStatus {
  DRAFT
  PUBLISHED
  SUPERSEDED
}

enum PharmacyReferenceConnectorAdapter {
  MANUAL_FILE
}

enum PharmacyReferenceConnectorRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum PharmacyReferenceProposalStatus {
  PENDING
  CONFIRMED
  REJECTED
}

model Ingredient {
  id             String                      @id @default(cuid())
  organizationId String                      @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  name           String
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt
  strengths      MedicineStrengthComponent[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("pharmacy_ingredients")
}

model Medicine {
  id                           String                               @id @default(cuid())
  organizationId               String                               @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  productName                  String
  brandName                    String?
  manufacturer                 String?
  marketingAuthorizationHolder String?
  drapRegistrationNumber       String?
  drapRegistrationStatus       String?
  drapRegisteredAt             DateTime?
  productFamily                PharmacyProductFamily
  rx                           Boolean                              @default(false)
  otc                          Boolean                              @default(false)
  restricted                   Boolean                              @default(false)
  controlled                   Boolean                              @default(false)
  highAlert                    Boolean                              @default(false)
  lasa                         Boolean                              @default(false)
  coldChain                    Boolean                              @default(false)
  saleable                     Boolean                              @default(false)
  createdAt                    DateTime                             @default(now())
  updatedAt                    DateTime                             @updatedAt
  strengths                    MedicineStrengthComponent[]
  presentations                Presentation[]
  provenance                   MedicineProvenance[]
  requisitionLines             PharmacyRequisitionLine[]
  purchaseOrderLines           PharmacyPurchaseOrderLine[]
  prescriptionLines            PrescriptionLine[]
  aliases                      MedicineAlias[]
  // PH-INV/INV-01: the manufacturing batches this medicine has been supplied in.
  batches                      PharmacyManufacturingBatch[]
  // PUR-02 receiving: the receipt lines this medicine has arrived on.
  goodsReceiptLines            PharmacyGoodsReceiptLine[]
  saleLines                    PharmacySaleLine[]
  unfulfilledDemandEvents      UnfulfilledDemandEvent[]
  // PUR-07: the approved replenishment policy and the signals it produces.
  safetyStocks                 PharmacySafetyStock[]
  stockSignals                 PharmacyStockSignal[]
  pharmacovigilanceReports     PharmacyPharmacovigilanceReport[]
  controlledRegisterEntries    PharmacyControlledRegisterEntry[]
  priceChangeProposals         PharmacyPriceChangeProposal[]
  connectorProposals           PharmacyReferenceConnectorProposal[]
  customerOrderLines           PharmacyCustomerOrderLine[]

  @@unique([organizationId, id], map: "pharmacy_medicines_org_id_key")
  @@index([organizationId, productName])
  @@map("pharmacy_medicines")
}

model MedicineStrengthComponent {
  id             String     @id @default(cuid())
  organizationId String     @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  medicineId     String
  ingredientId   String
  value          Decimal    @db.Decimal(18, 6)
  unit           String
  createdAt      DateTime   @default(now())
  medicine       Medicine   @relation(fields: [medicineId], references: [id], onDelete: Restrict)
  ingredient     Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@unique([medicineId, ingredientId, value, unit])
  @@index([organizationId, medicineId])
  @@map("pharmacy_medicine_strength_components")
}

model Presentation {
  id                 String                      @id @default(cuid())
  organizationId     String                      @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  medicineId         String
  dosageForm         String?
  route              String?
  presentation       String
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  medicine           Medicine                    @relation(fields: [medicineId], references: [id], onDelete: Restrict)
  packLevels         PackLevel[]
  barcodes           MedicineBarcode[]
  prescriptionLines  PrescriptionLine[]
  pharmacySaleLines  PharmacySaleLine[]
  customerOrderLines PharmacyCustomerOrderLine[]

  @@index([organizationId, medicineId])
  @@map("pharmacy_presentations")
}

model PackLevel {
  id                    String                      @id @default(cuid())
  organizationId        String                      @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  presentationId        String
  parentPackLevelId     String?
  versionGroupId        String
  version               Int
  level                 String
  unitsPerParent        Int
  effectiveFrom         DateTime
  effectiveTo           DateTime?
  referencedAt          DateTime?
  supersedesPackLevelId String?
  createdAt             DateTime                    @default(now())
  presentation          Presentation                @relation(fields: [presentationId], references: [id], onDelete: Restrict)
  parent                PackLevel?                  @relation("PackHierarchy", fields: [parentPackLevelId], references: [id], onDelete: Restrict)
  children              PackLevel[]                 @relation("PackHierarchy")
  supersedes            PackLevel?                  @relation("PackVersions", fields: [supersedesPackLevelId], references: [id], onDelete: Restrict)
  supersededBy          PackLevel[]                 @relation("PackVersions")
  printedMrps           MedicinePackMrp[]
  requisitionLines      PharmacyRequisitionLine[]
  purchaseOrderLines    PharmacyPurchaseOrderLine[]
  goodsReceiptLines     PharmacyGoodsReceiptLine[]
  barcodes              MedicineBarcode[]
  // PH-INV/INV-01: receiving a lot against this conversion is what stamps
  // `referencedAt` and freezes it (MED-02, §8A invariant 2).
  inventoryLots         PharmacyInventoryLot[]
  saleLines             PharmacySaleLine[]
  customerOrderLines    PharmacyCustomerOrderLine[]

  @@unique([organizationId, id], map: "pharmacy_pack_levels_org_id_key")
  @@unique([organizationId, versionGroupId, version])
  @@index([organizationId, presentationId])
  @@map("pharmacy_pack_levels")
}

model MedicinePackMrp {
  id                     String    @id @default(cuid())
  organizationId         String    @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  packLevelId            String
  batchReference         String
  printedMrpMinor        Int
  roundingIncrementMinor Int       @default(1)
  createdAt              DateTime  @default(now())
  packLevel              PackLevel @relation(fields: [packLevelId], references: [id], onDelete: Restrict)

  @@unique([organizationId, packLevelId, batchReference])
  @@index([organizationId, batchReference])
  @@map("pharmacy_medicine_pack_mrps")
}

model MedicineProvenance {
  id                 String                       @id @default(cuid())
  organizationId     String                       @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  medicineId         String
  field              String
  source             String
  sourceType         MedicineProvenanceSourceType
  retrievedAt        DateTime
  confidence         Decimal?                     @db.Decimal(5, 4)
  reviewer           String?
  status             MedicineProvenanceStatus
  supersedesId       String?
  assertedValue      Json?
  createdAt          DateTime                     @default(now())
  medicine           Medicine                     @relation(fields: [medicineId], references: [id], onDelete: Restrict)
  supersedes         MedicineProvenance?          @relation("ProvenanceVersions", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy       MedicineProvenance[]         @relation("ProvenanceVersions")
  publicationEntries MedicinePublicationEntry[]

  @@index([organizationId, medicineId, field])
  @@map("pharmacy_medicine_provenance")
}

model MedicineBarcode {
  id             String              @id @default(cuid())
  organizationId String              @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  presentationId String
  packLevelId    String?
  type           MedicineBarcodeType
  code           String
  normalizedCode String
  createdAt      DateTime            @default(now())
  presentation   Presentation        @relation(fields: [presentationId], references: [id], onDelete: Restrict)
  packLevel      PackLevel?          @relation(fields: [packLevelId], references: [id], onDelete: Restrict)

  @@unique([organizationId, normalizedCode])
  @@index([organizationId, presentationId])
  @@map("pharmacy_medicine_barcodes")
}

model MedicineAlias {
  id              String            @id @default(cuid())
  organizationId  String            @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  medicineId      String
  type            MedicineAliasType
  value           String
  normalizedValue String
  createdAt       DateTime          @default(now())
  medicine        Medicine          @relation(fields: [medicineId], references: [id], onDelete: Restrict)

  @@unique([organizationId, medicineId, type, normalizedValue])
  @@index([organizationId, normalizedValue])
  @@map("pharmacy_medicine_aliases")
}

model MedicineReviewDecision {
  id             String               @id @default(cuid())
  organizationId String               @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  duplicateKey   String
  action         MedicineReviewAction
  medicineIds    String[]
  payload        Json?
  reviewerId     String
  createdAt      DateTime             @default(now())

  @@index([organizationId, duplicateKey, createdAt])
  @@map("pharmacy_medicine_review_decisions")
}

model MedicinePublicationBatch {
  id             String                         @id @default(cuid())
  organizationId String                         @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  status         MedicinePublicationBatchStatus @default(DRAFT)
  publishedBy    String?
  publishedAt    DateTime?
  supersedesId   String?
  createdAt      DateTime                       @default(now())
  entries        MedicinePublicationEntry[]
  supersedes     MedicinePublicationBatch?      @relation("PublicationBatchVersions", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy   MedicinePublicationBatch[]     @relation("PublicationBatchVersions")

  @@index([organizationId, createdAt])
  @@map("pharmacy_medicine_publication_batches")
}

model MedicinePublicationEntry {
  id               String                   @id @default(cuid())
  organizationId   String                   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  batchId          String
  assertionId      String
  priorAssertionId String?
  createdAt        DateTime                 @default(now())
  batch            MedicinePublicationBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  assertion        MedicineProvenance       @relation(fields: [assertionId], references: [id], onDelete: Restrict)

  @@unique([organizationId, batchId, assertionId])
  @@index([organizationId, batchId])
  @@map("pharmacy_medicine_publication_entries")
}

model PharmacyReferenceConnector {
  id             String                               @id @default(cuid())
  organizationId String                               @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  key            String
  label          String
  adapter        PharmacyReferenceConnectorAdapter    @default(MANUAL_FILE)
  enabled        Boolean                              @default(true)
  schedule       Json
  cursor         Json?
  lastRunState   PharmacyReferenceConnectorRunStatus?
  lastRunAt      DateTime?
  createdBy      String
  createdAt      DateTime                             @default(now())
  updatedAt      DateTime                             @updatedAt
  runs           PharmacyReferenceConnectorRun[]

  @@unique([organizationId, id], map: "pharmacy_reference_connectors_org_id_key")
  @@unique([organizationId, key], map: "pharmacy_reference_connectors_org_key_key")
  @@index([organizationId, enabled], map: "pharmacy_reference_connectors_org_enabled_idx")
  @@map("pharmacy_reference_connectors")
}

model PharmacyReferenceConnectorRun {
  id                      String                               @id @default(cuid())
  organizationId          String                               @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  connectorId             String
  inputDigest             String
  batchId                 String
  fileName                String
  status                  PharmacyReferenceConnectorRunStatus  @default(RUNNING)
  triggerKind             String
  triggeredBy             String
  replayOfRunId           String?
  cursorStart             Int                                  @default(0)
  cursorEnd               Int                                  @default(0)
  rowsSeen                Int                                  @default(0)
  rowsApplied             Int                                  @default(0)
  rowsSkipped             Int                                  @default(0)
  rowsRejected            Int                                  @default(0)
  directFieldsApplied     Int                                  @default(0)
  regulatedFieldsProposed Int                                  @default(0)
  rejectionReasons        Json                                 @default("[]")
  error                   String?
  startedAt               DateTime                             @default(now())
  completedAt             DateTime?
  connector               PharmacyReferenceConnector           @relation(fields: [organizationId, connectorId], references: [organizationId, id], onDelete: Restrict)
  proposals               PharmacyReferenceConnectorProposal[]

  @@unique([organizationId, id], map: "pharmacy_reference_connector_runs_org_id_key")
  @@index([organizationId, connectorId, startedAt], map: "ph_ref_runs_org_connector_started_idx")
  @@index([organizationId, connectorId, inputDigest, status], map: "ph_ref_runs_org_connector_digest_status_idx")
  @@map("pharmacy_reference_connector_runs")
}

model PharmacyReferenceConnectorProposal {
  id               String                          @id @default(cuid())
  organizationId   String                          @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  runId            String
  connectorId      String
  inputDigest      String
  rowSourceKey     String
  targetMedicineId String?
  payload          Json
  status           PharmacyReferenceProposalStatus @default(PENDING)
  decidedBy        String?
  decidedAt        DateTime?
  createdAt        DateTime                        @default(now())
  run              PharmacyReferenceConnectorRun   @relation(fields: [organizationId, runId], references: [organizationId, id], onDelete: Restrict)
  targetMedicine   Medicine?                       @relation(fields: [organizationId, targetMedicineId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, connectorId, inputDigest, rowSourceKey], map: "ph_ref_proposals_input_row_key")
  @@index([organizationId, status, createdAt], map: "ph_ref_proposals_org_status_created_idx")
  @@index([organizationId, targetMedicineId], map: "ph_ref_proposals_org_medicine_idx")
  @@map("pharmacy_reference_connector_proposals")
}

