/// FIN-01: the accounts the posting adapters use. Deliberately the smallest set
/// that lets every event listed in FIN-01 balance and every FIN-03 read be a
/// query rather than a special case — there is no account here that no adapter
/// posts to.
enum FinanceAccountCode {
  /// Asset. Perpetual stock value, carried per lot and location.
  INVENTORY
  /// Asset. Stock that has left a branch and not yet been received.
  INVENTORY_IN_TRANSIT
  /// Liability. Goods received and owed for; FIN-02 settles it.
  GOODS_RECEIVED_ACCRUAL
  /// Asset. What the sale is owed, before FIN-02 tender/khata settlement.
  SALES_CLEARING
  /// Income. Recognised GROSS, so a discount never hides inside revenue.
  SALES_REVENUE
  /// Contra-revenue. The explicit commercial treatment of a discount,
  /// promotion or complimentary line.
  SALES_DISCOUNT
  /// Expense. Recognised at the exact landed cost of the allocated lot.
  COST_OF_GOODS_SOLD
  /// Expense. Expiry and damage.
  INVENTORY_WRITE_OFF
  /// Expense (or gain, when counted stock exceeds the book). Count variance.
  INVENTORY_SHRINKAGE
  OPERATING_EXPENSE
  /// Asset. Value claimed back from a supplier for returned goods.
  SUPPLIER_CLAIM_RECEIVABLE
  CASH
  BANK
  ACCOUNTS_RECEIVABLE
  LOYALTY_REDEMPTION
  ACCOUNTS_PAYABLE
  CASH_OVER_SHORT
  OPENING_BALANCE_EQUITY
}

