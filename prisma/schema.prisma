enum PharmacyControlledRegisterKind {
  SALE
  PURCHASE
  CORRECTION
}

/// RX-05: append-only controlled-drug register. Sales, purchases and corrections
/// are new rows. Nothing in the row is edited or deleted.
model PharmacyControlledRegisterEntry {
  id                     String                          @id @default(cuid())
  organizationId         String                          @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  branchId               String
  serial                 Int
  entryKind              PharmacyControlledRegisterKind  @default(SALE)
  prescriptionId         String?
  prescriptionLineId     String?
  patientId              String?
  prescriberId           String?
  /// Snapshots so a later edit of the prescriber record does not rewrite history.
  prescriberName         String?
  prescriberRegNo        String?
  patientAddress         String?
  medicineId             String?
  manufacturer           String?
  inventoryLotId         String
  stockMovementId        String?
  batchNumber            String
  quantityCanonicalUnits Int
  /// Signed change in the sellable balance. Sales store the units removed,
  /// purchases store the units accepted, and a correction stores the
  /// server-derived difference from the original quantity.
  balanceDelta           Int                             @default(0)
  runningBalance         Int
  recordedByUserId       String
  witnessedByUserId      String
  signatureRef           String?
  rxSerialWritten        Boolean                         @default(false)
  emergency              Boolean                         @default(false)
  counterpartyName       String?
  correctionReason       String?
  correctsEntryId        String?
  /// Stock-backed void/return; null identifies a manual quantity correction.
  restorationMovementId  String?
  refEntryId             String?
  createdAt              DateTime                        @default(now())
  prescription           Prescription?                   @relation(fields: [organizationId, prescriptionId], references: [organizationId, id], onDelete: Restrict, map: "pharmacy_controlled_register_prescription_fkey")
  line                   PrescriptionLine?               @relation(fields: [organizationId, prescriptionLineId], references: [organizationId, id], onDelete: Restrict, map: "pharmacy_controlled_register_line_fkey")
  patient                PharmacyPatient?                @relation(fields: [organizationId, patientId], references: [organizationId, id], onDelete: Restrict)
  prescriber             PharmacyPrescriber?             @relation(fields: [organizationId, prescriberId], references: [organizationId, id], onDelete: Restrict, map: "pharmacy_controlled_register_prescriber_fkey")
  medicine               Medicine?                       @relation(fields: [organizationId, medicineId], references: [organizationId, id], onDelete: Restrict, map: "pharmacy_controlled_register_medicine_fkey")
  correctsEntry          PharmacyControlledRegisterEntry?  @relation("RegisterCorrection", fields: [organizationId, correctsEntryId], references: [organizationId, id], onDelete: Restrict)
  corrections            PharmacyControlledRegisterEntry[] @relation("RegisterCorrection")
  refEntry               PharmacyControlledRegisterEntry?  @relation("RegisterRepeat", fields: [organizationId, refEntryId], references: [organizationId, id], onDelete: Restrict)
  repeats                PharmacyControlledRegisterEntry[] @relation("RegisterRepeat")
  incidents              PharmacyRegisterIncident[]

  @@unique([organizationId, id])
  @@unique([organizationId, branchId, serial])
  @@unique([organizationId, stockMovementId])
  @@index([organizationId, branchId, inventoryLotId, createdAt], map: "pharmacy_controlled_register_lot_idx")
  @@index([organizationId, branchId, entryKind, serial], map: "pharmacy_controlled_register_kind_idx")
  @@map("pharmacy_controlled_register_entries")
}

