  identityConnectionId String?
  externalId           String?
  idempotencyKey       String?  @unique
  operation            String
  resourceType         String
  status               String
  payload              Json?
  error                String?
  createdAt            DateTime @default(now())

  organization       Organization                    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  identityConnection OrganizationIdentityConnection? @relation(fields: [identityConnectionId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([externalId])
  @@map("organization_scim_events")
}

model OrganizationDeployment {
  id             String                     @id @default(cuid())
  organizationId String
  environment    String                     @default("production")
  mode           OrganizationDeploymentMode
  status         DeploymentStatus           @default(PENDING)
  provider       String                     @default("VERCEL")
  projectId      String?
  region         String?
  url            String?
  databaseRef    String?
  edgeConfigRef  String?
  version        String?
  health         Json?
  lastHealthyAt  DateTime?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, environment])
  @@index([status])
  @@map("organization_deployments")
}

model PlatformJob {
  id             String            @id @default(cuid())
  organizationId String?
  type           PlatformJobType
  status         PlatformJobStatus @default(QUEUED)
  payload        Json?
  result         Json?
  error          String?
  attempts       Int               @default(0)
  maxAttempts    Int               @default(3)
  idempotencyKey String?           @unique
  requestedById  String?
  scheduledAt    DateTime          @default(now())
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([status, scheduledAt])
  @@index([organizationId])
  @@map("platform_jobs")
}

model OrganizationLifecycleEvent {
  id             String              @id @default(cuid())
  organizationId String
  action         LifecycleAction
  fromStatus     OrganizationStatus?
  toStatus       OrganizationStatus
  reason         String
  metadata       Json?
  actorId        String?
  createdAt      DateTime            @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@map("organization_lifecycle_events")
}

model PlatformSupportSession {
  id              String               @id @default(cuid())
  organizationId  String
  platformUserId  String
  tenantUserId    String?
  tokenHash       String               @unique
  tokenCiphertext String?              @db.Text
  launchTokenHash String?              @unique
  launchUsedAt    DateTime?
  reason          String
  status          SupportSessionStatus @default(ACTIVE)
  expiresAt       DateTime
  endedAt         DateTime?
  createdAt       DateTime             @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, status])
  @@index([platformUserId, status])
  @@map("platform_support_sessions")
}

model PlatformAuditLog {
  id                  String   @id @default(cuid())
  organizationId      String?
  actorPlatformUserId String?
  actorTenantUserId   String?
  action              String
  targetType          String?
  targetId            String?
  before              Json?
  after               Json?
  metadata            Json?
  requestId           String?
  reason              String?
  success             Boolean  @default(true)
  error               String?
  ip                  String?
  userAgent           String?
  createdAt           DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([actorPlatformUserId, createdAt])
  @@index([action, createdAt])
  @@index([requestId])
  @@map("platform_audit_logs")
}

// ============================================
// PH-MIG — pharmacy migration (PRD §6.10 MIG-01, MIG-02)
// ============================================

enum PharmacyMigrationSourceKind {
  ABUZAR
  EXCEL_CSV
}

enum PharmacyMigrationBatchStatus {
  PROFILING
  PROFILED
  FAILED
}

enum PharmacyMigrationExceptionBucket {
  MISSING_BATCH
  MISSING_EXPIRY
  MISSING_MRP
  UNIT_AMBIGUOUS
  DUPLICATE_PRODUCT
  PARTY_UNMATCHED
  BALANCE_MISMATCH
}

enum PharmacyMigrationExceptionSeverity {
  BLOCKING
  WARNING
}

enum PharmacyMigrationExceptionStatus {
  OPEN
  SIGNED_OFF
}

/// MIG-01 — immutable evidence of one incumbent export. The file bytes are NOT
/// stored; `contentHash` proves the profiled bytes are the handed-over bytes.
/// A trigger and SELECT/INSERT-only policies both forbid UPDATE and DELETE.
model PharmacyMigrationSource {
  id             String                      @id @default(cuid())
  organizationId String                      @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  kind           PharmacyMigrationSourceKind
  fileName       String
  byteSize       BigInt
  contentHash    String
  capturedAt     DateTime                    @default(now())
  createdAt      DateTime                    @default(now())

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  batches      PharmacyMigrationBatch[]

  @@unique([organizationId, id])
  @@unique([organizationId, contentHash])
  @@index([organizationId, kind, capturedAt])
  @@map("pharmacy_migration_sources")
}

/// One profiling pass over a source. Re-profiling creates a NEW batch; rows are
/// never edited in place.
model PharmacyMigrationBatch {
  id              String                       @id @default(cuid())
  organizationId  String                       @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  sourceId        String
  label           String
  status          PharmacyMigrationBatchStatus @default(PROFILING)
  rowCount        Int                          @default(0)
  exceptionCount  Int                          @default(0)
  profilerVersion String
  profiledAt      DateTime?
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt

  source     PharmacyMigrationSource      @relation(fields: [organizationId, sourceId], references: [organizationId, id], onDelete: Restrict)
  rows       PharmacyMigrationRow[]
  exceptions PharmacyMigrationException[]

  @@unique([organizationId, id])
  @@index([organizationId, sourceId, status])
  @@map("pharmacy_migration_batches")
}

/// MIG-01 — every imported row keeps its incumbent source key and its import
/// batch. Every parsed column is nullable and has NO default: a value the
/// incumbent did not supply stays missing and raises an exception instead.
model PharmacyMigrationRow {
  id                String    @id @default(cuid())
  organizationId    String    @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  batchId           String
  sourceKey         String
  rowNumber         Int
  rawPayload        Json
  targetModelKey    String
  targetNaturalKey  String?
  productName       String?
  packLabel         String?
  packFactor        BigInt?
  barcode           String?
  batchNumber       String?
  expiryDate        DateTime? @db.Date
  mrpMinor          BigInt?
  costMinor         BigInt?
  quantityCanonical BigInt?
  supplierName      String?
  customerName      String?
  balanceMinor      BigInt?
  createdAt         DateTime  @default(now())

  batch      PharmacyMigrationBatch       @relation(fields: [organizationId, batchId], references: [organizationId, id], onDelete: Restrict)
  exceptions PharmacyMigrationException[]

  @@unique([organizationId, id])
  @@unique([organizationId, batchId, sourceKey])
  @@index([organizationId, batchId, targetModelKey])
  @@index([organizationId, targetModelKey, targetNaturalKey])
  @@map("pharmacy_migration_rows")
}

/// MIG-02 — the exception workbench. Identity is immutable and sign-off is
/// one-way, both DB-enforced. `signedOffByUserId` carries a composite tenant
/// foreign key onto `users` declared in the migration, matching the existing
/// SQL-only composite tenant foreign keys elsewhere in this schema.
model PharmacyMigrationException {
  id                String                             @id @default(cuid())
  organizationId    String                             @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  batchId           String
  rowId             String?
  bucket            PharmacyMigrationExceptionBucket
  severity          PharmacyMigrationExceptionSeverity
  status            PharmacyMigrationExceptionStatus   @default(OPEN)
  detail            String
  signedOffByUserId String?
  signedOffAt       DateTime?
  signOffNote       String?
  createdAt         DateTime                           @default(now())
  updatedAt         DateTime                           @updatedAt

  batch PharmacyMigrationBatch @relation(fields: [organizationId, batchId], references: [organizationId, id], onDelete: Restrict)
  row   PharmacyMigrationRow?  @relation(fields: [organizationId, rowId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, batchId, bucket])
  @@index([organizationId, batchId, status, severity])
  @@index([organizationId, rowId])
  @@map("pharmacy_migration_exceptions")
}

// ============================================
// PH-PUR — pharmacy procurement (PRD §6.3 PUR-01, PUR-02, PUR-03)
// ============================================

enum PharmacyRequisitionStatus {
  DRAFT
  SUBMITTED
  APPROVED
  CANCELLED
}

/// PUR-02: DRAFT → SUBMITTED → APPROVED → SENT → RECEIVING. RECEIVING is the
/// hand-off point; the receipt itself belongs to the PH-INV ledger lane.
enum PharmacyPurchaseOrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  SENT
  RECEIVING
  CANCELLED
}

enum PharmacyApprovalDecision {
  APPROVED
  REJECTED
}

/// PUR-02 receiving / PUR-04. DRAFT → POSTED → REVERSED, with cancellation
/// available only while the receipt has posted nothing. A posted receipt is
/// corrected by reversal, never by being moved back to DRAFT (§8A invariant 8).
enum PharmacyGoodsReceiptStatus {
  DRAFT
  POSTED
  REVERSED
  CANCELLED
}

/// PUR-04 — the three-way match failures that become review exceptions.
enum PharmacyReceivingExceptionKind {
  SHORTAGE
  OVERAGE
  DAMAGE
  PRICE_CONFLICT
  PACK_CONFLICT
}

enum PharmacyReceivingExceptionStatus {
  OPEN
  RESOLVED
}

/// PUR-01 — a licensed supplier or distributor. `authorized` is the operator's
/// standing decision to trade; the licence evidence beneath decides whether
/// that decision is currently usable. Both are checked before a PO is created
/// and again before it is sent, because either can lapse in between.
model PharmacySupplier {
  id               String   @id @default(cuid())
  organizationId   String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  name             String
  legalName        String?
  authorized       Boolean  @default(false)
  /// Free-text districts/cities this distributor delivers to.
  serviceArea      String?
  contactName      String?
  contactPhone     String?
  /// Net payment terms in days; 0 is cash on delivery.
  paymentTermsDays Int      @default(0)
  creditLimitMinor Int      @default(0)
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  licences        PharmacySupplierLicence[]
  quotes          PharmacyQuote[]
  purchaseOrders  PharmacyPurchaseOrder[]
  goodsReceipts   PharmacyGoodsReceipt[]
  purchaseReturns PharmacyPurchaseReturn[]
  debitNotes      PharmacyDebitNote[]
  credits         PharmacySupplierCredit[]
  relationships   PharmacySupplierRelationship[]

  @@unique([organizationId, id])
  @@unique([organizationId, name])
  @@index([organizationId, authorized, active])
  @@map("pharmacy_suppliers")
}

/// PUR-01 — licence evidence. Append-only (trigger): a licence filing is a
/// regulated record, so a correction supersedes rather than rewrites.
model PharmacySupplierLicence {
  id               String    @id @default(cuid())
  organizationId   String    @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  supplierId       String
  licenceType      String
  licenceNumber    String
  issuingAuthority String
  issuedAt         DateTime
  expiresAt        DateTime
  /// Where the scanned licence lives; evidence, not the licence itself.
  evidenceUri      String?
  verifiedAt       DateTime?
  verifiedByUserId String?
  supersedesId     String?
  createdAt        DateTime  @default(now())

  supplier     PharmacySupplier          @relation(fields: [organizationId, supplierId], references: [organizationId, id], onDelete: Restrict)
  supersedes   PharmacySupplierLicence?  @relation("SupplierLicenceVersions", fields: [organizationId, supersedesId], references: [organizationId, id], onDelete: Restrict)
  supersededBy PharmacySupplierLicence[] @relation("SupplierLicenceVersions")

  @@unique([organizationId, id])
  @@index([organizationId, supplierId, expiresAt])
  @@map("pharmacy_supplier_licences")
}

/// PUR-02 — the demand that starts the cycle. `branchId` is the branch-owned
/// scope seam required by PLAT-04; the pharmacy branch entity itself lands with
/// PLAT-03, so the column carries no foreign key yet and the tenant boundary
/// remains `organizationId` under forced RLS.
model PharmacyRequisition {
  id                String                    @id @default(cuid())
  organizationId    String                    @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  branchId          String?
  reference         String
  status            PharmacyRequisitionStatus @default(DRAFT)
  requestedByUserId String
  neededBy          DateTime?
  note              String?
  submittedAt       DateTime?
  approvedAt        DateTime?
  approvedByUserId  String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  branch         PharmacyBranch?             @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)
  lines          PharmacyRequisitionLine[]
  quotes         PharmacyQuote[]
  purchaseOrders PharmacyPurchaseOrder[]
  signalActions  PharmacyStockSignalAction[]

  @@unique([organizationId, id])
  @@unique([organizationId, reference])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, branchId, status], map: "pharmacy_requisitions_org_branch_status_idx")
  @@map("pharmacy_requisitions")
}

model PharmacyRequisitionLine {
  id                    String   @id @default(cuid())
  organizationId        String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  requisitionId         String
  lineNumber            Int
  medicineId            String
  packLevelId           String
  /// Demand is stated at a pack level and mirrored in integer canonical units.
  quantityPacks         Int
  canonicalUnitsPerPack Int
  canonicalUnits        Int
  note                  String?
  createdAt             DateTime @default(now())

  requisition PharmacyRequisition @relation(fields: [organizationId, requisitionId], references: [organizationId, id], onDelete: Restrict)
  medicine    Medicine            @relation(fields: [medicineId], references: [id], onDelete: Restrict)
  packLevel   PackLevel           @relation(fields: [packLevelId], references: [id], onDelete: Restrict)
  quoteLines  PharmacyQuoteLine[]

  @@unique([organizationId, id])
  @@unique([organizationId, requisitionId, lineNumber])
  @@index([organizationId, medicineId])
  @@map("pharmacy_requisition_lines")
}

/// PUR-02 — one supplier's offer against one requisition. Quotes are compared
/// and explained, never auto-awarded.
model PharmacyQuote {
  id             String   @id @default(cuid())
  organizationId String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  requisitionId  String
  supplierId     String
  reference      String?
  quotedAt       DateTime
  validUntil     DateTime
  note           String?
  createdAt      DateTime @default(now())

  requisition    PharmacyRequisition     @relation(fields: [organizationId, requisitionId], references: [organizationId, id], onDelete: Restrict)
  supplier       PharmacySupplier        @relation(fields: [organizationId, supplierId], references: [organizationId, id], onDelete: Restrict)
  lines          PharmacyQuoteLine[]
  purchaseOrders PharmacyPurchaseOrder[]

  @@unique([organizationId, id])
  @@unique([organizationId, requisitionId, supplierId])
  @@index([organizationId, supplierId, validUntil])
  @@map("pharmacy_quotes")
}

model PharmacyQuoteLine {
  id                    String   @id @default(cuid())
  organizationId        String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  quoteId               String
  requisitionLineId     String
  pricePerPackMinor     Int
  /// Buy `schemeBuyPacks`, get `schemeFreePacks` free. Both zero = no scheme.
  schemeBuyPacks        Int      @default(0)
  schemeFreePacks       Int      @default(0)
  discountBps           Int      @default(0)
  moqPacks              Int      @default(1)
  leadTimeDays          Int      @default(0)
  /// Shortest remaining shelf life the supplier will ship, in days.
  minimumExpiryDays     Int      @default(0)
  canonicalUnitsPerPack Int
  createdAt             DateTime @default(now())

  quote           PharmacyQuote           @relation(fields: [organizationId, quoteId], references: [organizationId, id], onDelete: Restrict)
  requisitionLine PharmacyRequisitionLine @relation(fields: [organizationId, requisitionLineId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, quoteId, requisitionLineId])
  @@map("pharmacy_quote_lines")
}

/// PUR-02/PUR-03 — the order itself. Batch, expiry and printed MRP are absent
/// by design: they are unknown until the goods are received, and inventing them
/// here would let unreceived stock look saleable.
model PharmacyPurchaseOrder {
  id                 String                      @id @default(cuid())
  organizationId     String                      @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  branchId           String?
  reference          String
  status             PharmacyPurchaseOrderStatus @default(DRAFT)
  supplierId         String
  requisitionId      String?
  quoteId            String?
  createdByUserId    String
  expectedDeliveryAt DateTime?
  freightMinor       Int                         @default(0)
  otherChargesMinor  Int                         @default(0)
  note               String?
  submittedAt        DateTime?
  approvedAt         DateTime?
  approvedByUserId   String?
  sentAt             DateTime?
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt

  goodsReceipts       PharmacyGoodsReceipt[]
  supplier            PharmacySupplier                @relation(fields: [organizationId, supplierId], references: [organizationId, id], onDelete: Restrict)
  requisition         PharmacyRequisition?            @relation(fields: [organizationId, requisitionId], references: [organizationId, id], onDelete: Restrict)
  quote               PharmacyQuote?                  @relation(fields: [organizationId, quoteId], references: [organizationId, id], onDelete: Restrict)
  branch              PharmacyBranch?                 @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)
  lines               PharmacyPurchaseOrderLine[]
  approvals           PharmacyPurchaseOrderApproval[]
  supplierActionLinks PharmacySupplierActionLink[]

  @@unique([organizationId, id])
  @@unique([organizationId, reference])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, supplierId, status])
  @@index([organizationId, branchId, status], map: "pharmacy_purchase_orders_org_branch_status_idx")
  @@map("pharmacy_purchase_orders")
}

/// PUR-03 — money terms in the order they are applied: list → discount →
/// rebate → tax, with freight allocated at the order level. `bonusPacks` is a
/// quantity term only and never appears in a money column, so scheme units
/// lower the landed unit cost and can never create revenue.
model PharmacyPurchaseOrderLine {
  id                    String   @id @default(cuid())
  organizationId        String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  purchaseOrderId       String
  lineNumber            Int
  medicineId            String
  packLevelId           String
  orderedPacks          Int
  bonusPacks            Int      @default(0)
  canonicalUnitsPerPack Int
  orderedCanonicalUnits Int
  bonusCanonicalUnits   Int      @default(0)
  listPricePerPackMinor Int
  discountBps           Int      @default(0)
  rebateBps             Int      @default(0)
  taxBps                Int      @default(0)
  /// A creditable input tax is recovered and so is not stock cost.
  taxCreditable         Boolean  @default(false)
  createdAt             DateTime @default(now())

  purchaseOrder       PharmacyPurchaseOrder        @relation(fields: [organizationId, purchaseOrderId], references: [organizationId, id], onDelete: Restrict)
  medicine            Medicine                     @relation(fields: [medicineId], references: [id], onDelete: Restrict)
  packLevel           PackLevel                    @relation(fields: [packLevelId], references: [id], onDelete: Restrict)
  goodsReceiptLines   PharmacyGoodsReceiptLine[]
  receivingExceptions PharmacyReceivingException[]

  @@unique([organizationId, id])
  @@unique([organizationId, purchaseOrderId, lineNumber])
  @@index([organizationId, medicineId])
  @@map("pharmacy_purchase_order_lines")
}

/// PUR-02 — the approval event. Append-only (trigger): who decided, under which
/// policy, and between which two states. A rejection is recorded, not erased.
model PharmacyPurchaseOrderApproval {
  id              String                      @id @default(cuid())
  organizationId  String                      @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  purchaseOrderId String
  actorUserId     String
  policy          String
  decision        PharmacyApprovalDecision
  fromStatus      PharmacyPurchaseOrderStatus
  toStatus        PharmacyPurchaseOrderStatus
  reason          String?
  createdAt       DateTime                    @default(now())

  purchaseOrder PharmacyPurchaseOrder @relation(fields: [organizationId, purchaseOrderId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, purchaseOrderId, createdAt])
  @@map("pharmacy_purchase_order_approvals")
}

enum PharmacySupplierSubmissionKind {
  ACKNOWLEDGEMENT
  REJECTION
  PARTIAL_ACCEPTANCE
  ETA
  SUBSTITUTION_PROPOSAL
  DOCUMENT
}

enum PharmacySupplierSubmissionSource {
  SIGNED_LINK
  PHONE
  WHATSAPP
}

/// SUP-01/SUP-03 — the active commercial relationship is the supplier's entire
/// external authorization boundary. It is deliberately narrower than Supplier.
model PharmacySupplierRelationship {
  id                     String    @id @default(cuid())
  organizationId         String    @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  branchId               String
  supplierId             String
  active                 Boolean   @default(true)
  createdAt              DateTime  @default(now())
  revokedAt              DateTime?
  /// AI-02: number of days before printed expiry when this supplier accepts an
  /// expiry claim. Null means the relationship has no recorded return window.
  expiryReturnWindowDays Int?

  supplier PharmacySupplier             @relation(fields: [organizationId, supplierId], references: [organizationId, id], onDelete: Restrict)
  links    PharmacySupplierActionLink[]

  @@unique([organizationId, id])
  @@unique([organizationId, branchId, supplierId])
  @@index([organizationId, branchId, active])
  @@map("pharmacy_supplier_relationships")
}

/// Raw link secrets are never stored. A link grants access to exactly one
/// relationship/PO pair and remains independently expirable and revocable.
model PharmacySupplierActionLink {
  id                     String    @id @default(cuid())
  organizationId         String    @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  branchId               String
  supplierRelationshipId String
  purchaseOrderId        String
  tokenHash              String    @unique
  expiresAt              DateTime
  revokedAt              DateTime?
  createdByUserId        String
  createdAt              DateTime  @default(now())

  relationship  PharmacySupplierRelationship @relation(fields: [organizationId, supplierRelationshipId], references: [organizationId, id], onDelete: Restrict)
  purchaseOrder PharmacyPurchaseOrder        @relation(fields: [organizationId, purchaseOrderId], references: [organizationId, id], onDelete: Restrict)
  submissions   PharmacySupplierSubmission[]

  @@unique([organizationId, id])
  @@unique([organizationId, supplierRelationshipId, purchaseOrderId])
  @@index([organizationId, branchId, expiresAt])
  @@map("pharmacy_supplier_action_links")
}

/// Every inbound answer is append-only evidence/a proposal. Corrections link
/// to the prior version; pharmacy approval is a separate event below.
model PharmacySupplierSubmission {
  id             String                           @id @default(cuid())
  organizationId String                           @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  branchId       String
  actionLinkId   String
  versionGroupId String
  version        Int
  supersedesId   String?
  kind           PharmacySupplierSubmissionKind
  source         PharmacySupplierSubmissionSource
  idempotencyKey String
  payload        Json
  sourceEvidence String?
  submittedAt    DateTime                         @default(now())

  actionLink   PharmacySupplierActionLink           @relation(fields: [organizationId, actionLinkId], references: [organizationId, id], onDelete: Restrict)
  supersedes   PharmacySupplierSubmission?          @relation("PharmacySupplierSubmissionVersions", fields: [organizationId, supersedesId], references: [organizationId, id], onDelete: Restrict)
  supersededBy PharmacySupplierSubmission[]         @relation("PharmacySupplierSubmissionVersions")
  documents    PharmacySupplierDocument[]
  approvals    PharmacySupplierSubmissionApproval[]

  @@unique([organizationId, id])
  @@unique([organizationId, actionLinkId, idempotencyKey])
  @@unique([organizationId, versionGroupId, version])
  @@index([organizationId, branchId, submittedAt])
  @@map("pharmacy_supplier_submissions")
}

model PharmacySupplierDocument {
  id             String   @id @default(cuid())
  organizationId String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  branchId       String
  submissionId   String
  fileName       String
  mimeType       String
  byteSize       Int
  sha256         String
  storageUri     String
  scanMode       String
  malwareChecked Boolean  @default(false)
  createdAt      DateTime @default(now())

  submission PharmacySupplierSubmission @relation(fields: [organizationId, submissionId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, submissionId, sha256])
  @@index([organizationId, branchId, createdAt])
  @@map("pharmacy_supplier_documents")
}

model PharmacySupplierSubmissionApproval {
  id             String   @id @default(cuid())
  organizationId String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  branchId       String
  submissionId   String
  actorUserId    String
  approved       Boolean
  reason         String?
  createdAt      DateTime @default(now())

  submission PharmacySupplierSubmission @relation(fields: [organizationId, submissionId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, branchId, submissionId, createdAt])
  @@map("pharmacy_supplier_submission_approvals")
}

