// ============================================
// AUDIT LOG
// ============================================

/// Extreme-granular, admin-only audit trail. Every mutation (tRPC + REST),
/// every authentication event, and every sensitive read appends one immutable
/// row here. Actor identity is *snapshotted* (name/email/role) so the trail
/// stays meaningful even after the user is deleted (actor relation is SetNull).
/// Sensitive input fields (passwords, tokens) are redacted before storage.
model AuditLog {
  id             String   @id @default(cuid())
  organizationId String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  createdAt      DateTime @default(now()) // WHEN

  // WHO — snapshotted at the time of the action for durability
  actorType           AuditActorType @default(USER)
  actorId             String? // the acting User (FK -> users). null for anonymous (e.g. failed login)
  // A restaurant terminal operator is a staff profile, NOT a User (C2/C3), so its
  // audit rows attribute here instead of `actorId` — the two are mutually exclusive
  // and a RESTAURANT_OPERATOR row must set this one (enforced by a DB CHECK). Used
  // by the M2 terminal mutations (unlock/switch/co-authorize/lock).
  actorStaffProfileId String? // the acting RestaurantStaffProfile, when actorType = RESTAURANT_OPERATOR
  actorName           String?
  actorEmail          String?
  actorRole           String?
  tokenId             String? // the ApiToken used, when actorType = API_TOKEN
  tokenName           String?

  // WHAT
  source      AuditSource
  category    String // TEAM, FINANCE, PROJECT, TASK, CLIENT, CHAT, NOTE, MEETING, API_TOKEN, AUTH, SYSTEM
  operation   AuditOperation @default(OTHER)
  action      String // "team.updateMember", "POST /api/v1/tasks", "auth.login"
  description String?

  // WHAT WAS ACTED ON
  targetType  String? // Project, Task, User, Invoice, ...
  targetId    String?
  targetLabel String? // human-readable name snapshot

  // HOW (full payloads — redacted)
  input    Json? // the request arguments / body
  changes  Json? // field-level before -> after diff, where instrumented
  result   Json? // a summary of what was returned/created
  metadata Json? // any extra structured context

  // WHERE / CONTEXT
  ip         String?
  userAgent  String?
  httpMethod String?
  path       String?
  statusCode Int?

  // OUTCOME
  outcome      AuditOutcome @default(SUCCESS)
  errorCode    String?
  errorMessage String?
  durationMs   Int?

  actor             User?                   @relation("UserAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)
  actorStaffProfile RestaurantStaffProfile? @relation("StaffProfileAuditLogs", fields: [actorStaffProfileId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([actorStaffProfileId, createdAt])
  @@index([category, createdAt])
  @@index([source, createdAt])
  @@index([operation, createdAt])
  @@index([outcome, createdAt])
  @@index([action])
  @@index([targetType, targetId])
  @@index([organizationId])
  @@map("audit_logs")
}

// ============================================
// MEETINGS
// ============================================

/// A meeting SERIES. `startTime`/`endTime` describe the first instance and the
/// duration; every joinable instance is a MeetingOccurrence. A Meeting has no
/// public identifier on purpose — see MeetingOccurrence.publicId.
model Meeting {
  id                  String    @id @default(cuid())
  organizationId      String    @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  title               String
  description         String?
  startTime           DateTime
  endTime             DateTime
  location            String? // "Google Meet", "Office", URL, etc.
  /// DEPRECATED (MEET-01): superseded by `recurrenceRule`. Still written and
  /// read during the migration window so a rollback to pre-MEET-01 application
  /// code keeps working; it drops in a later PR once nothing reads it.
  recurrence          String? // "daily", "weekly", "biweekly", "monthly", null = one-time
  /// RFC 5545 RRULE, without the "RRULE:" prefix — e.g. "FREQ=WEEKLY;INTERVAL=2".
  /// Null means a one-time meeting. Interpreted in `timezone`.
  recurrenceRule      String?
  /// IANA zone the series recurs in, validated against pg_timezone_names by a
  /// CHECK constraint. A recurring series is anchored to wall-clock time, so
  /// the zone — not a UTC offset — is what survives a DST transition.
  ///
  /// The empty-string default is a placeholder, never a stored value: a
  /// BEFORE INSERT OR UPDATE trigger replaces a blank zone with the owning
  /// organization's, or raises. It exists so Prisma treats the field as
  /// optional, which is what lets MEET-01 add a NOT NULL column without
  /// editing the callers that create meetings today. Deriving beats
  /// defaulting — UTC is not a safe guess for a recurring series.
  timezone            String    @default(dbgenerated("''"))
  /// Watermark for lazy occurrence materialisation: every instance up to this
  /// instant already exists as a row. Null means nothing is materialised yet.
  /// The materialiser only ever advances this to now() + the rolling window
  /// (see MeetingOccurrence) so a daily series never expands unbounded.
  materializedThrough DateTime?
  createdById         String
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  attendees     MeetingAttendee[]
  attendanceLog MeetingAttendanceLog[]
  occurrences   MeetingOccurrence[]
  participants  MeetingParticipant[]
  entityLinks   MeetingEntityLink[]

  @@index([startTime])
  @@index([organizationId])
  @@index([organizationId, materializedThrough])
  @@map("meetings")
}

model MeetingAttendee {
  id             String    @id @default(cuid())
  organizationId String    @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  meetingId      String
  userId         String
  // DEPRECATED: kept for backwards-compat during rollout. Real attendance
  // tracking is in MeetingAttendanceLog, which records per-occurrence joins.
  // This field will be removed in a future change.
  joinedAt       DateTime?

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([meetingId, userId])
  @@index([userId, joinedAt])
  @@index([organizationId])
  @@map("meeting_attendees")
}

/// Per-occurrence attendance. For a recurring meeting, each occurrence the
/// user attends gets its own row keyed by occurrenceStart (the wall-clock
/// start of that specific instance). Single-shot meetings get exactly one
/// row per user-who-joined.
model MeetingAttendanceLog {
  id              String    @id @default(cuid())
  organizationId  String    @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  meetingId       String
  userId          String
  occurrenceStart DateTime
  joinedAt        DateTime
  // Stamped when the user leaves the in-app video call (videoConferenceLeft /
  // readyToClose). Null while the call is still open or for joins recorded
  // outside the embedded call.
  leftAt          DateTime?
  createdAt       DateTime  @default(now())

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([meetingId, userId, occurrenceStart])
  @@index([userId, occurrenceStart])
  @@index([meetingId, occurrenceStart])
  @@index([organizationId])
  @@map("meeting_attendance_log")
}

/// One materialised instance of a meeting series — the unit people actually
/// join, and the unit every piece of evidence hangs off.
///
/// MATERIALISATION IS LAZY AND BOUNDED. Occurrences are never expanded for a
/// whole series: the materialiser walks the RRULE forward only to
/// now() + MEETING_MATERIALISATION_WINDOW (30 days) and records how far it got
/// in Meeting.materializedThrough. An infinite RRULE therefore produces a
/// bounded, rolling set of rows. The window is a database-independent constant
/// consumed by the materialiser; the schema enforces the *shape* (one row per
/// series slot) rather than the horizon.
///
/// EXCEPTIONS LIVE HERE, NOT ON THE SERIES. `seriesSlotStart` is the instant
/// the RRULE produced and never changes, so it is the stable identity of this
/// instance. A reschedule moves `scheduledStart`/`scheduledEnd` away from it;
/// a cancellation sets the cancellation columns; a one-off retitle sets
/// `titleOverride`. Editing the series can therefore never silently rewrite
/// what already happened.
///
/// MATERIALISATION MUST NEVER DELETE A HISTORICAL OCCURRENCE. This table is
/// NOT "the set the current RRULE generates". It is that set UNION every
/// instant historical attendance has already named. The MEET-01 backfill
/// produced 215 occurrences from 210 meetings precisely because five
/// attendance rows named an instant the series' recurrence rule does not
/// generate; those five rows are durable evidence that a meeting happened,
/// not drift to be reconciled away.
///
/// A materialiser reconciling this table against a series may therefore only
/// ADD missing slots, and may only mark a FUTURE slot cancelled when it leaves
/// the rule. It must never DELETE a row, and must never treat a past
/// occurrence that no longer matches the current RRULE as garbage to collect:
/// changing a recurrence rule does not un-happen the meetings already held,
/// and the sessions hanging off such an occurrence are the only record that
/// they were.
model MeetingOccurrence {
  id             String @id @default(cuid())
  organizationId String @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  meetingId      String

  /// GLOBALLY unique, cryptographically random UUIDv4 (PostgreSQL
  /// gen_random_uuid()). This is the third anonymous tenant-resolution key
  /// alongside Invitation.tokenHash and PasswordResetToken.tokenHash: the
  /// shared public join URL supplies no tenant context by product design, so
  /// publicId must resolve exactly one organization before tenant scope is
  /// entered — hence global, not per-tenant, uniqueness. See
  /// src/lib/auth/anonymous-tenant.ts.
  ///
  /// It is a LOCATOR, NOT AUTHORIZATION. Holding it proves nothing; the guest
  /// credential lives on MeetingOccurrenceParticipant. It lives on the
  /// occurrence and not on the series because a series-level identifier would
  /// be an indefinitely reusable join link, and would force the application to
  /// guess which instance a joiner meant.
  publicId String @unique @default(dbgenerated("gen_random_uuid()::text"))

  /// The RRULE instant that identifies this instance within the series.
  /// Immutable — a reschedule changes `scheduledStart`, never this.
  seriesSlotStart DateTime
  scheduledStart  DateTime
  scheduledEnd    DateTime
  /// First and last media activity, stamped from provider webhooks.
  actualStart     DateTime?
  actualEnd       DateTime?

  status MeetingOccurrenceStatus @default(SCHEDULED)

  /// `mtg_` + 26 base32 characters over 16 CSPRNG bytes, defaulted in the
  /// database so it cannot be forgotten by a caller. Deliberately DISTINCT
  /// from and underivable from `publicId`: if the room name could be computed
  /// from the join link, a link-holder could address the media room directly
  /// and bypass the lobby.
  providerRoomName String @unique @default(dbgenerated("meeting_provider_room_name()"))

  /// Join window. Outside it the occurrence is not joinable regardless of
  /// credential; enforced by the join path, bounded here so the bound is data.
  joinOpensAt  DateTime
  joinClosesAt DateTime

  /// Per-occurrence exceptions.
  titleOverride      String?
  cancelledAt        DateTime?
  cancelledById      String?
  cancellationReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  meeting        Meeting                        @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  participants   MeetingOccurrenceParticipant[]
  sessions       MeetingParticipantSession[]
  providerEvents MeetingProviderEvent[]

  @@unique([meetingId, seriesSlotStart])
  @@index([organizationId])
  @@index([organizationId, scheduledStart])
  @@index([organizationId, status, scheduledStart])
  @@index([meetingId, scheduledStart])
  @@map("meeting_occurrences")
}

/// SERIES-LEVEL INVITEE METADATA ONLY.
///
/// This row says "these people are on the invite list for this series". It is
/// NOT a guest identity and MUST NOT gain a token hash, secret, expiry, or any
/// other credential column: nothing credential-bearing may span a recurring
/// series, because a secret that outlives one occurrence is a permanent key to
/// every future one. Guest credentials live on
/// MeetingOccurrenceParticipant, occurrence-scoped. scripts/verify-tenant-isolation.ts
/// asserts this table has no credential-shaped column, because it is a
/// boundary that will otherwise erode.
model MeetingParticipant {
  id             String @id @default(cuid())
  organizationId String @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  meetingId      String

  /// Exactly one contact reference must be present (CHECK constraint):
  /// an internal user, a client contact, or a bare email for an outsider.
  userId          String?
  clientContactId String?
  email           String?

  displayName      String
  defaultRole      MeetingParticipantRole @default(ATTENDEE)
  invitationStatus MeetingInviteStatus    @default(PENDING)
  respondedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  meeting       Meeting                        @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user          User?                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientContact ClientContact?                 @relation(fields: [clientContactId], references: [id], onDelete: Cascade)
  occurrences   MeetingOccurrenceParticipant[]

  @@unique([meetingId, userId])
  @@unique([meetingId, clientContactId])
  @@unique([meetingId, email])
  @@index([organizationId])
  @@index([organizationId, userId])
  @@map("meeting_participants")
}

/// The occurrence-scoped access grant: admission state for one person at one
/// instance, AND the only place a guest credential may live. Everything here
/// expires with the occurrence it belongs to.
model MeetingOccurrenceParticipant {
  id             String  @id @default(cuid())
  organizationId String  @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  occurrenceId   String
  /// Null for someone who joined without being on the series invite list.
  participantId  String?
  userId         String?
  displayName    String

  lobbyStatus  MeetingLobbyStatus      @default(NOT_REQUIRED)
  roleOverride MeetingParticipantRole?

  /// Tri-state: null = never asked, true/false = the recorded answer.
  recordingConsent   Boolean?
  recordingConsentAt DateTime?

  admittedAt   DateTime?
  admittedById String?
  removedAt    DateTime?
  removedById  String?

  /// GUEST CREDENTIAL — occurrence-scoped, never series-scoped. SHA-256 of a
  /// token handed out once, mirroring Invitation.tokenHash. Globally unique so
  /// a stray collision is a database error rather than a cross-tenant hit.
  /// A CHECK constraint requires an expiry whenever a hash is present: a guest
  /// credential with no expiry is a permanent one.
  guestTokenHash      String?   @unique
  guestTokenExpiresAt DateTime?
  guestTokenRevokedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  occurrence  MeetingOccurrence           @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  participant MeetingParticipant?         @relation(fields: [participantId], references: [id], onDelete: SetNull)
  user        User?                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions    MeetingParticipantSession[]

  @@unique([occurrenceId, participantId])
  @@unique([occurrenceId, userId])
  @@index([organizationId])
  @@index([organizationId, occurrenceId, lobbyStatus])
  @@index([guestTokenExpiresAt])
  @@map("meeting_occurrence_participants")
}

/// One connection to the media room. A person who drops and rejoins produces
/// two rows; this is the join/leave ledger, not a presence flag.
model MeetingParticipantSession {
  id                      String  @id @default(cuid())
  organizationId          String  @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  occurrenceId            String
  occurrenceParticipantId String?
  userId                  String?

  /// The media provider's participant SID. Null on rows that predate webhook
  /// verification — always paired with source = LEGACY_CLIENT.
  providerParticipantSid String?
  /// Provenance. Backfilled rows are LEGACY_CLIENT and can never be mistaken
  /// for webhook-verified evidence.
  source                 MeetingSessionSource

  joinedAt         DateTime
  leftAt           DateTime?
  disconnectReason String?

  /// Provider event IDs that produced the join and the leave, so a session can
  /// be traced back to the signed webhook that asserted it.
  joinEventId  String?
  leaveEventId String?

  createdAt DateTime @default(now())

  occurrence            MeetingOccurrence             @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  occurrenceParticipant MeetingOccurrenceParticipant? @relation(fields: [occurrenceParticipantId], references: [id], onDelete: SetNull)
  user                  User?                         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, providerParticipantSid])
  @@index([organizationId])
  @@index([occurrenceId, joinedAt])
  @@index([userId, joinedAt])
  @@map("meeting_participant_sessions")
}

/// Raw provider webhook receipts, for idempotency and for auditing what the
/// provider actually said.
model MeetingProviderEvent {
  id             String  @id @default(cuid())
  organizationId String  @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  occurrenceId   String?

  /// The provider's own event identifier. Unique PER TENANT, deliberately not
  /// globally: a global unique key would let one tenant's insert fail because
  /// another tenant had already received that event id, which leaks the
  /// existence of another tenant's event.
  providerEventId String
  eventType       String
  payload         Json

  receivedAt    DateTime  @default(now())
  processedAt   DateTime?
  /// Set when handling failed; kept so a poison event is visible instead of
  /// silently retried forever.
  failureReason String?

  occurrence MeetingOccurrence? @relation(fields: [occurrenceId], references: [id], onDelete: SetNull)

  @@unique([organizationId, providerEventId])
  @@index([organizationId, receivedAt])
  @@index([occurrenceId, receivedAt])
  @@map("meeting_provider_events")
}

/// Links a meeting series to whatever else it is about. Typed nullable columns
/// rather than a polymorphic (type, id) pair, so every link carries a real
/// foreign key and a composite same-organization constraint. A CHECK requires
/// exactly one target.
model MeetingEntityLink {
  id             String @id @default(cuid())
  organizationId String @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  meetingId      String

  projectId String?
  clientId  String?
  channelId String?
  noteId    String?
  taskId    String?

  createdById String?
  createdAt   DateTime @default(now())

  meeting Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  client  Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  channel Channel? @relation(fields: [channelId], references: [id], onDelete: Cascade)
  note    Note?    @relation(fields: [noteId], references: [id], onDelete: Cascade)
  task    Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([meetingId, projectId])
  @@unique([meetingId, clientId])
  @@unique([meetingId, channelId])
  @@unique([meetingId, noteId])
  @@unique([meetingId, taskId])
  @@index([organizationId])
  @@index([projectId])
  @@index([clientId])
  @@index([channelId])
  @@index([noteId])
  @@index([taskId])
  @@map("meeting_entity_links")
}

// ============================================
// API TOKENS
// ============================================

model ApiToken {
  id             String    @id @default(cuid())
  organizationId String    @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  name           String
  prefix         String // First 12 chars for display, e.g. "df_a1b2c3d4"
  tokenHash      String    @unique // bcrypt hash of the full token
  scopes         String[]  @default([]) // ["tasks:read", "finance:write", etc.]
  userId         String // The user this token acts on behalf of
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([prefix])
  @@index([organizationId])
  @@map("api_tokens")
}

// ============================================
// NOTES (Obsidian-style with backlinks)
// ============================================

model Note {
  id             String         @id @default(cuid())
  organizationId String         @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  title          String
  contentJson    Json // Tiptap JSON document
  contentText    String         @default("") // Plain text extract for search
  authorId       String
  visibility     NoteVisibility @default(PRIVATE)
  projectId      String? // Optional: attach to a project
  clientId       String? // Optional: attach to a client
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  author       User                @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  project      Project?            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  client       Client?             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  shares       NoteShare[]
  linksFrom    NoteLink[]          @relation("LinksFrom") // outgoing links from this note
  linksTo      NoteLink[]          @relation("LinksTo") // incoming backlinks to this note
  mentions     NoteMention[] // IMP-NOTE-02: @mentioned people on this note
  revisions    NoteRevision[] // IMP-NOTE-01: version history
  meetingLinks MeetingEntityLink[]

  @@index([authorId])
  @@index([projectId])
  @@index([clientId])
  @@index([updatedAt])
  @@index([organizationId])
  @@map("notes")
}

// IMP-NOTE-01: an immutable snapshot of a note taken before each edit, so changes
// can be diffed and restored. Bounded retention is enforced in the router.
model NoteRevision {
  id             String   @id @default(cuid())
  organizationId String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  noteId         String
  title          String
  contentJson    Json
  contentText    String   @default("")
  editedById     String?
  createdAt      DateTime @default(now())

  note     Note  @relation(fields: [noteId], references: [id], onDelete: Cascade)
  editedBy User? @relation("NoteRevisionEditor", fields: [editedById], references: [id], onDelete: SetNull)

  @@index([noteId])
  @@index([organizationId])
  @@map("note_revisions")
}

// IMP-HR-01: per-user, per-year, per-type leave entitlement. "Used" days are
// derived from APPROVED LeaveRequests; this stores the allowance to compare against.
model LeaveBalance {
  id             String    @id @default(cuid())
  organizationId String    @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  userId         String
  year           Int
  type           LeaveType
  entitledDays   Int
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation("UserLeaveBalances", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year, type])
  @@index([userId])
  @@index([organizationId])
  @@map("leave_balances")
}

// IMP-REST-03: outbound webhook subscription. `secret` signs the payload (HMAC).
model Webhook {
  id             String   @id @default(cuid())
  organizationId String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  url            String
  secret         String
  events         String[] @default([]) // e.g. ["invoice.paid", "task.created"]
  active         Boolean  @default(true)
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  createdBy  User              @relation("WebhookCreator", fields: [createdById], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([organizationId])
  @@map("webhooks")
}

// IMP-REST-03: a single delivery attempt for an event → webhook (for observability).
model WebhookDelivery {
  id             String   @id @default(cuid())
  organizationId String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  webhookId      String
  event          String
  payload        Json
  statusCode     Int?
  success        Boolean  @default(false)
  error          String?
  attemptedAt    DateTime @default(now())

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId])
  @@index([organizationId])
  @@map("webhook_deliveries")
}

// IMP-AUTH-02: single-use TOTP recovery codes. Only the hash is stored.
model TwoFactorRecoveryCode {
  id             String    @id @default(cuid())
  organizationId String    @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  userId         String
  codeHash       String
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
  @@map("two_factor_recovery_codes")
}

// IMP-NOTE-02: a person @mentioned in a note (scoped to the note's visibility),
// used to notify them and surface "notes that mention me".
model NoteMention {
  id             String   @id @default(cuid())
  organizationId String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  noteId         String
  userId         String
  createdAt      DateTime @default(now())

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([noteId, userId])
  @@index([userId])
  @@index([organizationId])
  @@map("note_mentions")
}

model NoteShare {
  id             String         @id @default(cuid())
  organizationId String         @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  noteId         String
  userId         String
  permission     NotePermission @default(VIEW)
  createdAt      DateTime       @default(now())

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([noteId, userId])
  @@index([organizationId])
  @@map("note_shares")
}

model NoteLink {
  id             String   @id @default(cuid())
  organizationId String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  fromNoteId     String
  toNoteId       String
  createdAt      DateTime @default(now())

  fromNote Note @relation("LinksFrom", fields: [fromNoteId], references: [id], onDelete: Cascade)
  toNote   Note @relation("LinksTo", fields: [toNoteId], references: [id], onDelete: Cascade)

  @@unique([fromNoteId, toNoteId])
  @@index([toNoteId])
  @@index([organizationId])
  @@map("note_links")
}

// ===========================================================================
// EMAIL INTEGRATION — unified inbox over a Mailbox abstraction with per-provider
// adapters. GMAIL/OUTLOOK are implemented now; HOSTED (@domain) is reserved for
// a future self-hosted mailbox and must plug in WITHOUT touching the router/UI.
// ===========================================================================

enum MailboxType {
  GMAIL
  OUTLOOK
  HOSTED // reserved — not implemented
}

// A connected email account. `credentials` holds the AES-256-GCM ciphertext of
// the OAuth refresh token (NEVER plaintext, NEVER sent to the client). Decryption
// happens server-side only, in the adapter layer.
model Mailbox {
  id             String      @id @default(cuid())
  organizationId String      @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  userId         String
  type           MailboxType
  emailAddress   String
  displayName    String?
  credentials    String // AES-256-GCM ciphertext of the OAuth refresh token
  status         String      @default("active")
  lastSyncedAt   DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages EmailMessage[]

  @@index([userId])
  @@index([organizationId])
  @@map("mailboxes")
}

// A synced message belonging to a Mailbox. Provider-agnostic shape; bodies are
// backfilled lazily on first open to keep the initial inbox paint fast.
model EmailMessage {
  id                String   @id @default(cuid())
  organizationId    String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  mailboxId         String
  providerMessageId String
  threadId          String?
  fromAddr          String
  toAddrs           Json
  ccAddrs           Json?
  subject           String?
  snippet           String?
  bodyHtml          String?
  bodyText          String?
  isRead            Boolean  @default(false)
  hasAttachments    Boolean  @default(false)
  sentAt            DateTime
  createdAt         DateTime @default(now())

  mailbox Mailbox @relation(fields: [mailboxId], references: [id], onDelete: Cascade)

  @@unique([mailboxId, providerMessageId])
  @@index([mailboxId, sentAt])
  @@index([organizationId])
  @@map("email_messages")
}

// ===========================================================================
// PLATFORM CONTROL PLANE — commercial, tenant configuration, identity and ops
// ===========================================================================

/// §2: the operating model an organization runs under. Deliberately a two-value
/// enum, not a generic vertical builder — a new vertical still needs purpose-built
/// routes, models, authorization, and dashboards. Existing organizations and
/// packages are migrated to AGENCY (§2.2). The single server-owned catalog in
/// src/lib/vertical-catalog.ts (§2.3) — not per-screen conditionals — decides
/// package/module/route compatibility from this enum.
enum OrganizationVertical {
  AGENCY
  RESTAURANT
  PHARMACY
  HOSPITALITY
}

enum PlatformModuleBand {
  BASELINE
  PLATFORM
  VERTICAL_CORE
  VERTICAL_OPTIONAL
}

enum RestaurantActivationAcknowledgementKind {
  TAX
  PAYMENT
  DEVICE
  OPERATOR
}

model Organization {
  pharmacyMigrationSources PharmacyMigrationSource[]
  pharmacyMessageLogs      PharmacyMessageLog[]
  id                       String                     @id @default(cuid())
  slug                     String                     @unique
  legalName                String
  displayName              String
  vertical                 OrganizationVertical       @default(AGENCY)
  status                   OrganizationStatus         @default(ONBOARDING)
  deploymentMode           OrganizationDeploymentMode @default(SHARED)
  packageId                String?
  timezone                 String                     @default("UTC")
  locale                   String                     @default("en")
  currency                 String                     @default("USD")
  seatLimit                Int                        @default(1)
  isDemo                   Boolean                    @default(false)
  askFathomEnabled         Boolean                    @default(true)
  lastDemoResetAt          DateTime?
  gracePeriodDays          Int                        @default(0)
  activatedAt              DateTime?
  suspendedAt              DateTime?
  terminatedAt             DateTime?
  purgeScheduledAt         DateTime?
  dataResidency            String?
  primaryContactName       String?
  primaryContactEmail      String?
  notes                    String?
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt

  package                                   PlatformPackage?                      @relation(fields: [packageId], references: [id], onDelete: SetNull)
  users                                     User[]
  roles                                     OrganizationRole[]
  departments                               OrganizationDepartment[]
  pharmacyOnboarding                        PharmacyOnboardingState?
  permissionOverrides                       UserPermissionOverride[]
  modules                                   OrganizationModule[]
  limits                                    OrganizationLimit[]
  usageCounters                             OrganizationUsageCounter[]
  brand                                     OrganizationBrand?
  emailSettings                             OrganizationEmailSettings?
  domains                                   OrganizationDomain[]
  identityConnections                       OrganizationIdentityConnection[]
  scimTokens                                OrganizationScimToken[]
  scimEvents                                OrganizationScimEvent[]
  accounts                                  PlatformAccount[]
  convertedOpportunities                    PlatformOpportunity[]
  contracts                                 PlatformContract[]
  invoices                                  PlatformInvoice[]
  payments                                  PlatformPayment[]
  renewals                                  PlatformRenewal[]
  deployments                               OrganizationDeployment[]
  jobs                                      PlatformJob[]
  lifecycleEvents                           OrganizationLifecycleEvent[]
  supportSessions                           PlatformSupportSession[]
  auditLogs                                 PlatformAuditLog[]
  ssoStates                                 OrganizationSsoState[]
  ssoTickets                                TenantSsoTicket[]
  insightLoyaltyLiabilities                 InsightLoyaltyLiability[]
  restaurantNotificationWebhook             RestaurantNotificationWebhook?
  restaurantActivationAcknowledgements      RestaurantActivationAcknowledgement[]
  pharmacyOwnerDigestSettings               PharmacyOwnerDigestSetting[]
  pharmacyOwnerDigestCaptures               PharmacyOwnerDigestCapture[]
  visibilityFinanceJournalEntry             FinanceJournalEntry[]                 @relation("FinanceJournalEntryVisibilityAnchor")
  visibilityPharmacyMoneyIdempotencyKey     PharmacyMoneyIdempotencyKey[]         @relation("PharmacyMoneyIdempotencyKeyVisibilityAnchor")
  visibilityRestaurantTaxOfficialSource     RestaurantTaxOfficialSource[]         @relation("RestaurantTaxOfficialSourceVisibilityAnchor")
  visibilityPharmacyCounterKeymapPreference PharmacyCounterKeymapPreference[]     @relation("PharmacyCounterKeymapPreferenceVisibilityAnchor")

  @@index([status])
  @@index([deploymentMode])
  @@index([packageId])
  @@index([vertical])
  @@index([isDemo])
  @@map("organizations")
}

model RestaurantActivationAcknowledgement {
  id               String                                  @id @default(cuid())
  organizationId   String
  kind             RestaurantActivationAcknowledgementKind
  policyReference  String
  acknowledgedById String
  acknowledgedAt   DateTime                                @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  acknowledgedBy PlatformUser @relation(fields: [acknowledgedById], references: [id], onDelete: Restrict)

  @@unique([organizationId, kind])
  @@index([organizationId, acknowledgedAt])
  @@index([acknowledgedById, acknowledgedAt])
  @@map("restaurant_activation_acknowledgements")
}

/// §4/§4.1: branch-first schema. A restaurant company is one organization; its
/// operating locations are branches beneath it. Modeled from the first restaurant
/// release even when a package allows one branch only. Tenant-scoped exactly like
/// the operational tables (bare RLS-guarded organizationId, no cross-org
/// aggregation — D09); a partial unique index enforces one default branch per org.
model RestaurantBranch {
  printers RestaurantPrinter[]
  cateringCapacities RestaurantCateringBranchCapacity[]

  id                    String   @id @default(cuid())
  organizationId        String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  name                  String
  /// Stable operator-facing identifier. Database ids remain internal.
  code                  String   @default(dbgenerated("('BR-'::text || nextval('restaurant_branch_code_seq'::regclass)::text)"))
  timezone              String   @default("UTC")
  // M4-L1/C5: the branch-local wall-clock time (24h "HH:MM") at which one
  // business day rolls into the next. Additive with a conservative "00:00"
  // default (midnight = calendar day); the order business date is resolved from
  // timezone + this cutoff (src/lib/restaurant/business-date.ts) and stamped
  // explicitly, never recomputed later from UTC (§11.1 / BUILD-ASSUMPTIONS).
  businessDayCutoff     String   @default("00:00")
  // Completion wave: when true, an operator may only sign in at this branch's
  // terminals while holding an active, eligible `RestaurantShift`. Opt-in with a
  // conservative `false` default so a branch that does not roster keeps its
  // existing M2 sign-in behaviour untouched.
  shiftSignInEnforced   Boolean  @default(false)
  /// Shared receipt designer v1; null uses domain defaults. Existing branch RLS applies.
  receiptLayout         Json?
  receiptLayoutRevision Int      @default(0)
  address               String?
  active                Boolean  @default(true)
  isDefault             Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  assignments                 RestaurantBranchAssignment[]
  // M2-L1: staff pinned to this branch as their primary, and devices registered
  // to this branch. Both are org-scoped and branch-scoped seams (§4.1/D12).
  staffProfiles               RestaurantStaffProfile[]               @relation("RestaurantStaffPrimaryBranch")
  registeredDevices           RestaurantRegisteredDevice[]
  // M3-L1: branch-menu publications binding this branch to a brand-owned menu
  // (§6.3). Publications are the only branch-linked catalog surface (C2); the
  // canonical catalog itself carries no branchId.
  menuPublications            RestaurantBranchMenuPublication[]
  // M4-L1: floor/service, section, kitchen-station, order, and number-sequence
  // aggregates hanging off the branch (all org-scoped under forced RLS, C1).
  floors                      RestaurantFloor[]
  serverSections              RestaurantServerSection[]
  kitchenStations             RestaurantKitchenStation[]
  orders                      RestaurantOrder[]
  orderNumberSequences        RestaurantOrderNumberSequence[]
  bills                       RestaurantBill[]
  drawerSessions              RestaurantDrawerSession[]
  dailyCloses                 RestaurantDailyClose[]
  receiptNumberSequences      RestaurantReceiptNumberSequence[]
  // M6-L1: branch-scoped inventory stock locations and the purchasing surfaces
  // (POs, receipts) delivered to this branch. All org-scoped under forced RLS.
  stockLocations              RestaurantStockLocation[]
  purchaseOrders              RestaurantPurchaseOrder[]
  purchaseReceipts            RestaurantPurchaseReceipt[]
  // M7-L1: branch-scoped SOP assignments/occurrences, branch-scoped escalation
  // policies, and branch-scoped notifications + channel-setting overrides. All
  // org-scoped under forced RLS.
  sopAssignments              RestaurantSopAssignment[]
  sopOccurrences              RestaurantSopOccurrence[]
  sopEscalationPolicies       RestaurantSopEscalationPolicy[]
  notifications               RestaurantNotification[]
  notificationChannelSettings RestaurantNotificationChannelSetting[]
  customerInteractions        CustomerInteraction[]
  insightDailyRollups         InsightDailyRollup[]
  insightItemMixRollups       InsightItemMixRollup[]
  labourCostFacts             LabourCostFact[]
  // Completion wave: the branch's rostered shifts (scheduling only).
  shifts                      RestaurantShift[]
  taxProfileVersions          RestaurantTaxProfileVersion[]
  serviceChargePolicyVersions RestaurantServiceChargePolicyVersion[]
  taxTransactionSnapshots     RestaurantTaxTransactionSnapshot[]
  // SOP-1: job-role holdings and direct capability grants are branch-scoped.
  staffJobRoles               RestaurantStaffJobRole[]
  staffCapabilityGrants       RestaurantStaffCapabilityGrant[]
  // B1/WHA-285: so is the append-only trail of per-person overrides.
  staffCapabilityAudits       RestaurantStaffCapabilityAudit[]
  terminalProviderConfigs     RestaurantTerminalProviderConfig[]
  terminalReconciliations     RestaurantTerminalReconciliation[]
  printRoutes                 RestaurantPrintRoute[]
  printJobs                   RestaurantPrintJob[]
  deliveryZones               RestaurantDeliveryZone[]
  deliveryFulfillments        RestaurantDeliveryFulfillment[]
  cateringOrders              RestaurantCateringOrder[]

  walletEnrollmentLinks WalletEnrollmentLink[]
  walletEnrollmentAttempts WalletEnrollmentAttempt[]

  @@unique([organizationId, id])
  @@index([organizationId])
  @@map("restaurant_branches")

}

enum RestaurantTaxVersionStatus {
  DRAFT
  PUBLISHED
  SUPERSEDED
}

enum RestaurantTaxPriceMode {
  EXCLUSIVE
  INCLUSIVE
}

enum RestaurantTaxDiscountTreatment {
  BEFORE_TAX
  AFTER_TAX
}

/// Jurisdiction-neutral, immutable evidence describing the official source used
/// to author a tax rule. This lane intentionally contains synthetic data only.
model RestaurantTaxOfficialSource {
  id             String    @id @default(cuid())
  organizationId String    @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  authorityCode  String
  documentTitle  String
  sourceUrl      String
  contentHash    String
  retrievedAt    DateTime
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())

  rules            RestaurantTaxRuleVersion[]
  visibilityAnchor Organization               @relation("RestaurantTaxOfficialSourceVisibilityAnchor", fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "restaurant_tax_official_sources_visibility_fkey")

  @@unique([organizationId, contentHash])
  @@unique([organizationId, id])
  @@index([organizationId])
  @@map("restaurant_tax_official_sources")
}

model RestaurantTaxProfileVersion {
  id                       String                     @id @default(cuid())
  organizationId           String                     @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  branchId                 String
  versionNumber            Int
  status                   RestaurantTaxVersionStatus @default(DRAFT)
  effectiveFrom            DateTime
  effectiveTo              DateTime?
  approvalReference        String?
  approvedAt               DateTime?
  publishedAt              DateTime?
  presetId                 String?
  activationIdempotencyKey String?
  activationPayloadHash    String?
  eligibilityEvidence      Json?
  profileName              String?
  jurisdictionCode         String?
  priceMode                RestaurantTaxPriceMode?
  evidenceKind             String?
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt

  branch               RestaurantBranch                   @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Cascade)
  rules                RestaurantTaxRuleVersion[]
  transactionSnapshots RestaurantTaxTransactionSnapshot[]

  @@unique([branchId, versionNumber])
  @@unique([organizationId, activationIdempotencyKey], map: "restaurant_tax_profiles_org_activation_key")
  @@unique([organizationId, branchId, effectiveFrom], map: "restaurant_tax_profiles_org_branch_effective_key")
  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([branchId, status, effectiveFrom])
  @@map("restaurant_tax_profile_versions")
}

model RestaurantTaxRuleVersion {
  id                String                         @id @default(cuid())
  organizationId    String                         @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  profileVersionId  String
  officialSourceId  String
  ruleCode          String
  paymentCategory   String
  priceMode         RestaurantTaxPriceMode
  discountTreatment RestaurantTaxDiscountTreatment @default(BEFORE_TAX)
  rate              Decimal                        @db.Decimal(9, 6)
  status            RestaurantTaxVersionStatus     @default(DRAFT)
  effectiveFrom     DateTime
  effectiveTo       DateTime?
  approvalReference String?
  approvedAt        DateTime?
  publishedAt       DateTime?
  createdAt         DateTime                       @default(now())
  updatedAt         DateTime                       @updatedAt

  profile        RestaurantTaxProfileVersion       @relation(fields: [organizationId, profileVersionId], references: [organizationId, id], onDelete: Cascade)
  officialSource RestaurantTaxOfficialSource       @relation(fields: [organizationId, officialSourceId], references: [organizationId, id], onDelete: Restrict)
  buckets        RestaurantTaxRateBucketSnapshot[]

  @@unique([profileVersionId, ruleCode])
  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([profileVersionId, paymentCategory, effectiveFrom])
  @@map("restaurant_tax_rule_versions")
}

model RestaurantTaxTransactionSnapshot {
  id                      String   @id @default(cuid())
  organizationId          String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  branchId                String
  billId                  String?
  transactionReference    String
  profileVersionId        String
  currency                String
  subtotal                Decimal  @db.Decimal(12, 2)
  discountTotal           Decimal  @default(0) @db.Decimal(12, 2)
  serviceChargeTotal      Decimal  @default(0) @db.Decimal(12, 2)
  taxTotal                Decimal  @db.Decimal(12, 2)
  grandTotal              Decimal  @db.Decimal(12, 2)
  settledAt               DateTime
  reversesSnapshotId      String?
  reversalReason          String?
  promotionEvaluationId   String?
  promotionEvaluationHash String?
  evidenceVersion         Int      @default(0)
  evidencePayload         Json?
  createdAt               DateTime @default(now())

  branch             RestaurantBranch                        @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)
  bill               RestaurantBill?                         @relation(fields: [organizationId, billId], references: [organizationId, id], onDelete: Restrict)
  profile            RestaurantTaxProfileVersion             @relation(fields: [organizationId, profileVersionId], references: [organizationId, id], onDelete: Restrict)
  reversedSnapshot   RestaurantTaxTransactionSnapshot?       @relation("TaxSnapshotReversal", fields: [organizationId, reversesSnapshotId], references: [organizationId, id], onDelete: Restrict)
  reversals          RestaurantTaxTransactionSnapshot[]      @relation("TaxSnapshotReversal")
  fullReversalRefund RestaurantRefund?                       @relation("TaxRefundFullReversal")
  buckets            RestaurantTaxRateBucketSnapshot[]
  tenderAllocations  RestaurantTaxTenderAllocationSnapshot[]

  @@unique([organizationId, transactionReference])
  @@unique([organizationId, id])
  @@unique([organizationId, id, billId])
  @@index([organizationId])
  @@index([reversesSnapshotId])
  @@map("restaurant_tax_transaction_snapshots")
}

model RestaurantTaxRateBucketSnapshot {
  id                      String                 @id @default(cuid())
  organizationId          String                 @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  snapshotId              String
  ruleVersionId           String
  paymentCategory         String
  priceMode               RestaurantTaxPriceMode
  rate                    Decimal                @db.Decimal(9, 6)
  taxableAmount           Decimal                @db.Decimal(12, 2)
  taxAmount               Decimal                @db.Decimal(12, 2)
  grossAmount             Decimal                @db.Decimal(12, 2)
  preDiscountGrossAmount  Decimal                @default(0) @db.Decimal(12, 2)
  beforeTaxDiscountAmount Decimal                @default(0) @db.Decimal(12, 2)
  afterTaxDiscountAmount  Decimal                @default(0) @db.Decimal(12, 2)
  evidenceVersion         Int                    @default(0)
  allocationKind          String?
  billLineId              String?
  unitOrdinal             Int?
  createdAt               DateTime               @default(now())

  snapshot          RestaurantTaxTransactionSnapshot        @relation(fields: [organizationId, snapshotId], references: [organizationId, id], onDelete: Restrict)
  rule              RestaurantTaxRuleVersion                @relation(fields: [organizationId, ruleVersionId], references: [organizationId, id], onDelete: Restrict)
  tenderAllocations RestaurantTaxTenderAllocationSnapshot[]

  // Legacy-v0 and per-unit-v1 uniqueness are partial migration-managed indexes.
  @@unique([organizationId, snapshotId, id])
  @@index([organizationId])
  @@map("restaurant_tax_rate_bucket_snapshots")
}

/// Immutable v1 evidence assigning each frozen tax-rate bucket's cents to the
/// original tender that funded them. Bucket allocationKind/billLineId/unitOrdinal
/// retain the authoritative merchandise-unit versus service-charge semantics.
model RestaurantTaxTenderAllocationSnapshot {
  id                   String               @id @default(cuid())
  organizationId       String               @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  snapshotId           String
  billId               String
  rateBucketSnapshotId String
  originalTenderId     String
  paymentCategory      RestaurantTenderType
  cents                BigInt
  createdAt            DateTime             @default(now())

  snapshot          RestaurantTaxTransactionSnapshot @relation(fields: [organizationId, snapshotId, billId], references: [organizationId, id, billId], onDelete: Restrict, map: "restaurant_tax_tender_allocation_snapshot_bill_fkey")
  rateBucket        RestaurantTaxRateBucketSnapshot  @relation(fields: [organizationId, snapshotId, rateBucketSnapshotId], references: [organizationId, snapshotId, id], onDelete: Restrict, map: "restaurant_tax_tender_allocation_bucket_fkey")
  originalTender    RestaurantTender                 @relation(fields: [organizationId, billId, originalTenderId, paymentCategory], references: [organizationId, billId, id, type], onDelete: Restrict, map: "restaurant_tax_tender_allocation_tender_bill_category_fkey")
  refundAllocations RestaurantTaxRefundAllocation[]

  @@unique([snapshotId, rateBucketSnapshotId, originalTenderId])
  @@unique([organizationId, billId, originalTenderId, paymentCategory, snapshotId, rateBucketSnapshotId, id])
  @@index([organizationId])
  @@index([originalTenderId])
  @@index([snapshotId])
  @@map("restaurant_tax_tender_allocation_snapshots")
}

/// Append-only refund cents bound to one exact frozen tender-allocation fact.
model RestaurantTaxRefundAllocation {
  id                           String               @id @default(cuid())
  organizationId               String               @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  billId                       String
  refundId                     String
  originalTenderId             String
  paymentCategory              RestaurantTenderType
  originalSnapshotId           String
  originalRateBucketSnapshotId String
  originalTenderAllocationId   String
  cents                        BigInt
  createdAt                    DateTime             @default(now())

  refund             RestaurantRefund                      @relation(fields: [organizationId, billId, originalTenderId, refundId], references: [organizationId, billId, originalTenderId, id], onDelete: Restrict, map: "restaurant_tax_refund_allocation_refund_fkey")
  originalAllocation RestaurantTaxTenderAllocationSnapshot @relation(fields: [organizationId, billId, originalTenderId, paymentCategory, originalSnapshotId, originalRateBucketSnapshotId, originalTenderAllocationId], references: [organizationId, billId, originalTenderId, paymentCategory, snapshotId, rateBucketSnapshotId, id], onDelete: Restrict, map: "restaurant_tax_refund_allocation_original_fkey")

  @@unique([refundId, originalTenderAllocationId])
  @@index([organizationId])
  @@index([originalTenderAllocationId])
  @@map("restaurant_tax_refund_allocations")
}

model RestaurantTerminalProviderConfig {
  id                 String                         @id @default(cuid())
  organizationId     String                         @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  branchId           String
  source             String
  externalTerminalId String
  deviceId           String
  mode               RestaurantTerminalProviderMode @default(DISABLED)
  createdAt          DateTime                       @default(now())
  updatedAt          DateTime                       @updatedAt

  branch          RestaurantBranch                   @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Cascade)
  device          RestaurantRegisteredDevice         @relation(fields: [organizationId, deviceId], references: [organizationId, id], onDelete: Restrict)
  reconciliations RestaurantTerminalReconciliation[]

  @@unique([organizationId, source, externalTerminalId])
  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([branchId])
  @@map("restaurant_terminal_provider_configs")
}

model RestaurantTerminalReconciliation {
  id                String                        @id @default(cuid())
  organizationId    String                        @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  configId          String
  branchId          String
  externalEventId   String
  source            String
  eventStatus       RestaurantTerminalEventStatus
  externalReference String
  amount            Decimal                       @db.Decimal(12, 2)
  tipAmount         Decimal                       @default(0) @db.Decimal(12, 2)
  billId            String?
  paymentId         String?
  tenderId          String?
  outcome           String
  failureReason     String?
  processedAt       DateTime                      @default(now())
  createdAt         DateTime                      @default(now())

  config  RestaurantTerminalProviderConfig @relation(fields: [organizationId, configId], references: [organizationId, id], onDelete: Restrict)
  branch  RestaurantBranch                 @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)
  bill    RestaurantBill?                  @relation(fields: [organizationId, billId], references: [organizationId, id], onDelete: Restrict)
  payment RestaurantPayment?               @relation(fields: [organizationId, paymentId], references: [organizationId, id], onDelete: Restrict)
  tender  RestaurantTender?                @relation(fields: [organizationId, tenderId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, source, externalEventId])
  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([branchId, processedAt])
  @@map("restaurant_terminal_reconciliations")
}

/// §4.1/§8/D12: branch authorization is an additional boundary above organization
/// RLS, expressed as explicit user-to-branch assignment rows enforced server-side.
/// The branchId column and this table are the policy-ready seams for a later
/// branch-scope DB decision (D12); no branch-level DB policy is invented here.
model RestaurantBranchAssignment {
  id             String   @id @default(cuid())
  organizationId String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  branchId       String
  userId         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  branch RestaurantBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([branchId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("restaurant_branch_assignments")
}

// ===========================================================================
// M2 — Restaurant staff, operator credentials, devices, terminal sessions and
// co-authorization. Every model below is org-scoped under forced RLS (C1); the
// credential/token/secret material is stored hashed-at-rest only (C2/C4/C5);
// the co-authorization record is the C7 evidence primitive shared by the L2
// back-office and L3 terminal paths.
// ===========================================================================

/// M2/C4/§9: lifecycle of a staff operator profile. A profile is never a User —
/// suspension and archival gate operator sign-in without touching any web login.
enum RestaurantStaffStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

/// M2/C4: the two operator credential kinds. PIN is a short numeric secret;
/// BADGE is a scanned/tapped token. Both are stored only as a salted slow hash.
/// No WebAuthn/biometric kind exists (C4 — deferred).
enum RestaurantOperatorCredentialType {
  PIN
  BADGE
}

/// M2/C5: a registered device is either trusted (ACTIVE) or de-authorized
/// (REVOKED). Revocation is re-checked in the DB on every terminal call.
enum RestaurantRegisteredDeviceStatus {
  ACTIVE
  REVOKED
}

/// §4.1/§9/C3: a restaurant staff operator. Deliberately NOT a `User`: an
/// operator can exist with no web-login identity at all, so `userId` is an
/// optional, one-way link and `email` is optional (unique within the
/// organization only when present — a partial unique index enforces that in the
/// migration, since Prisma cannot express a filtered unique). Org-scoped under
/// forced RLS; the operator's credentials and sessions hang off this row.
model RestaurantStaffProfile {
  cateringMoneyEvidence CateringMoneyEvidence[]

  cateringDispositions RestaurantCateringDisposition[]

  cateringQuoteApprovals RestaurantCateringQuoteApproval[]

  cateringQuoteRevisions RestaurantCateringQuoteRevision[]

  id              String                @id @default(cuid())
  organizationId  String                @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  userId          String?
  email           String?
  displayName     String
  primaryBranchId String?
  status          RestaurantStaffStatus @default(ACTIVE)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  user                   User?                               @relation("RestaurantStaffUser", fields: [userId], references: [id], onDelete: SetNull)
  primaryBranch          RestaurantBranch?                   @relation("RestaurantStaffPrimaryBranch", fields: [primaryBranchId], references: [id], onDelete: SetNull)
  credentials            RestaurantOperatorCredential[]
  terminalSessions       RestaurantTerminalSession[]         @relation("TerminalSessionActiveStaff")
  actingCoAuths          RestaurantCoAuthorization[]         @relation("CoAuthActingStaff")
  approvingCoAuths       RestaurantCoAuthorization[]         @relation("CoAuthApprovingStaff")
  auditLogs              AuditLog[]                          @relation("StaffProfileAuditLogs")
  // M4-L1: section assignments (per business date) and order/kitchen attribution
  // (the operator who opened an order, the assigned server, and the acting
  // operator on an order event). Attribution is preserved on archival (§11.6).
  sectionAssignments     RestaurantServerSectionAssignment[]
  ordersOpened           RestaurantOrder[]                   @relation("OrderOpeningStaff")
  ordersServed           RestaurantOrder[]                   @relation("OrderServerStaff")
  actedOrderEvents       RestaurantOrderEvent[]              @relation("OrderEventActorStaff")
  billsOpened            RestaurantBill[]
  payments               RestaurantPayment[]
  tenders                RestaurantTender[]
  refunds                RestaurantRefund[]
  drawerSessions         RestaurantDrawerSession[]
  drawerMovements        RestaurantDrawerMovement[]
  dailyClosesCut         RestaurantDailyClose[]
  // M6-L1: best-effort inventory attribution (nullable on the child rows) — the
  // operator who posted a movement, ran a count/transfer or received goods, and
  // the creator/approver of a purchase order.
  stockMovements         RestaurantStockMovement[]
  stockCounts            RestaurantStockCount[]
  stockTransfers         RestaurantStockTransfer[]
  purchaseReceipts       RestaurantPurchaseReceipt[]
  purchaseOrdersCreated  RestaurantPurchaseOrder[]           @relation("PurchaseOrderCreatedBy")
  purchaseOrdersApproved RestaurantPurchaseOrder[]           @relation("PurchaseOrderApprovedBy")
  // M7-L1: best-effort SOP attribution (nullable on the child rows) — the
  // operator who completed a step, uploaded evidence, verified an occurrence, or
  // is named on an escalation event — plus the operator a notification is for.
  sopStepsCompleted      RestaurantSopOccurrenceStep[]
  sopEvidenceUploaded    RestaurantSopEvidence[]
  sopVerifications       RestaurantSopVerification[]
  sopEscalationEvents    RestaurantSopEscalationEvent[]
  notifications          RestaurantNotification[]
  // SOP-1: branch-scoped job-role holdings (many-to-many), the direct capability
  // grants that union with them, the append-only membership audit (as subject,
  // actor, or grantor), and the two SOP assignee paths — a PERSON-target
  // assignment, an occurrence assigned directly, and an occurrence this operator
  // claimed out of a role pool.
  jobRoles               RestaurantStaffJobRole[]            @relation("StaffJobRoleHolder")
  jobRolesGranted        RestaurantStaffJobRole[]            @relation("StaffJobRoleGrantor")
  directCapabilityGrants RestaurantStaffCapabilityGrant[]    @relation("StaffDirectCapabilityGrant")
  jobRoleAudits          RestaurantStaffJobRoleAudit[]       @relation("StaffJobRoleAuditSubject")
  jobRoleAuditsActed     RestaurantStaffJobRoleAudit[]       @relation("StaffJobRoleAuditActor")
  // B1/WHA-285: the append-only trail of this person's capability overrides, and
  // the ones they set on somebody else.
  capabilityAudits       RestaurantStaffCapabilityAudit[]    @relation("StaffCapabilityAuditSubject")
  capabilityAuditsActed  RestaurantStaffCapabilityAudit[]    @relation("StaffCapabilityAuditActor")
  sopAssignmentsTargeted RestaurantSopAssignment[]           @relation("SopAssignmentAssignee")
  sopOccurrencesAssigned RestaurantSopOccurrence[]           @relation("SopOccurrenceAssignee")
  sopOccurrencesClaimed  RestaurantSopOccurrence[]           @relation("SopOccurrenceClaimer")
  cateringOrdersCreated  RestaurantCateringOrder[]           @relation("CateringOrderCreator")
  cateringDeliveries     RestaurantCateringDelivery[]        @relation("CateringDeliveryDriver")
  cateringEvents         RestaurantCateringEvent[]           @relation("CateringEventActor")

  // Completion wave: rostered shifts for this operator. A profile may hold many
  // shifts in different roles; they may never overlap in time (shifts.ts).
  shifts                RestaurantShift[]
  shiftSwapRequests     RestaurantShiftSwapRequest[] @relation("ShiftSwapRequester")
  shiftSwapReplacements RestaurantShiftSwapRequest[] @relation("ShiftSwapReplacement")

  @@unique([organizationId, id], map: "catering_money_staff_scope_key")
  @@index([organizationId])
  @@index([userId])
  @@index([primaryBranchId])
  @@map("restaurant_staff_profiles")
}

/// §9/C2/C4: an operator credential. Structurally unreachable from web login —
/// it references a staff profile, never a `User`, and carries no plaintext
/// column: only `credentialHash` (a salted slow hash) is stored. `deviceId` is
/// the optional device scope (null = valid across the organization's terminals
/// for this operator). The lockout counters (`failedAttempts`, `lockedUntil`)
/// and `revokedAt` are durable on the row (C4 — never a per-instance cache);
/// exactly one active (non-revoked) credential may exist per
/// (organization, staff, type, device) — enforced by a partial unique index in
/// the migration.
model RestaurantOperatorCredential {
  id             String                           @id @default(cuid())
  organizationId String                           @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  staffProfileId String
  deviceId       String?
  type           RestaurantOperatorCredentialType
  credentialHash String
  failedAttempts Int                              @default(0)
  lockedUntil    DateTime?
  revokedAt      DateTime?
  createdAt      DateTime                         @default(now())
  updatedAt      DateTime                         @updatedAt

  staffProfile RestaurantStaffProfile      @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  device       RestaurantRegisteredDevice? @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([staffProfileId])
  @@index([deviceId])
  @@map("restaurant_operator_credentials")
}

/// §5/C5: a device trusted to act as a POS/KDS terminal. Enrollment mints a
/// high-entropy device secret; only its hash (`deviceSecretHash`, globally
/// unique like other secret hashes) is stored. A device belongs to one branch;
/// `status`/`revokedAt` are re-checked in the DB on every terminal call so a
/// revoked device cannot keep operating from a stale client cache.
model RestaurantRegisteredDevice {
  printers RestaurantPrinter[]
  printBridgeEnrollmentCodes RestaurantPrintBridgeEnrollmentCode[]
  cateringMoneyEvidence CateringMoneyEvidence[]

  id               String                           @id @default(cuid())
  organizationId   String                           @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  branchId         String
  name             String
  deviceSecretHash String                           @unique
  status           RestaurantRegisteredDeviceStatus @default(ACTIVE)
  // M4-L1 (additive): what kind of terminal this device acts as. Defaults to POS
  // so every M2-enrolled device keeps its existing behaviour; a KDS device is
  // bound to exactly one kitchen station via the nullable `stationId` seam (C8).
  kind             RestaurantDeviceKind             @default(POS)
  stationId        String?
  lastSeenAt       DateTime?
  revokedAt        DateTime?
  createdAt        DateTime                         @default(now())
  updatedAt        DateTime                         @updatedAt

  branch                    RestaurantBranch                    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  station                   RestaurantKitchenStation?           @relation(fields: [stationId], references: [id], onDelete: SetNull)
  credentials               RestaurantOperatorCredential[]
  terminalSessions          RestaurantTerminalSession[]
  coAuthorizations          RestaurantCoAuthorization[]
  // M4-L1: orders opened from this terminal, order events attributed to it, and
  // the device-scoped idempotency keys guarding its command replays (C7).
  ordersOpened              RestaurantOrder[]                   @relation("OrderOpeningDevice")
  actedOrderEvents          RestaurantOrderEvent[]              @relation("OrderEventActorDevice")
  idempotencyKeys           RestaurantOrderIdempotencyKey[]
  bills                     RestaurantBill[]
  payments                  RestaurantPayment[]
  tenders                   RestaurantTender[]
  terminalProviderConfigs   RestaurantTerminalProviderConfig[]
  refunds                   RestaurantRefund[]
  drawerSessions            RestaurantDrawerSession[]
  drawerMovements           RestaurantDrawerMovement[]
  dailyCloses               RestaurantDailyClose[]
  moneyIdempotencyKeys      RestaurantMoneyIdempotencyKey[]
  // M6-L1: terminal-attributed inventory movements/receipts and the separate
  // inventory idempotency-key replay domain (all nullable device refs).
  stockMovements            RestaurantStockMovement[]
  inventoryPurchaseReceipts RestaurantPurchaseReceipt[]
  inventoryIdempotencyKeys  RestaurantInventoryIdempotencyKey[]

  @@unique([organizationId, branchId, id], map: "catering_money_device_scope_key")
  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([branchId])
  @@index([status])
  @@index([stationId])
  @@map("restaurant_registered_devices")
}

/// §5/C5: an established terminal session on a registered device. The session
/// token is stored only as a hash (`tokenHash`, globally unique for lookup).
/// `activeStaffProfileId` is nullable — a terminal can be established and locked
/// with no operator bound. Validity is re-derived in the DB every call from the
/// device status, session end state, and credential revocation; client time is
/// never trusted (C5).
model RestaurantTerminalSession {
  id                   String    @id @default(cuid())
  organizationId       String    @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  deviceId             String
  activeStaffProfileId String?
  tokenHash            String    @unique
  establishedAt        DateTime  @default(now())
  lastActivityAt       DateTime  @default(now())
  endedAt              DateTime?
  updatedAt            DateTime  @updatedAt

  device             RestaurantRegisteredDevice  @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  activeStaffProfile RestaurantStaffProfile?     @relation("TerminalSessionActiveStaff", fields: [activeStaffProfileId], references: [id], onDelete: SetNull)
  coAuthorizations   RestaurantCoAuthorization[]

  @@index([organizationId])
  @@index([deviceId])
  @@index([activeStaffProfileId])
  @@index([endedAt])
  @@map("restaurant_terminal_sessions")
}

/// C6/C7: the co-authorization evidence record. A sensitive action taken by the
/// acting operator is authorized by a distinct approving manager — approval
/// ADDS the manager's identity, it never replaces the actor (C6). The record
/// pins both staff identities, the capability/action, the target, the reason,
/// the device and terminal session (present for the L3 terminal path, null for
/// the L2 back-office path), and a SERVER timestamp (`createdAt` — client time
/// is untrusted). The two staff foreign keys use ON DELETE RESTRICT so this
/// evidence cannot be silently erased by deleting a profile (archival is the
/// intended path). Append-only by contract; L1 owns no mutation of it.
model RestaurantCoAuthorization {
  id                      String   @id @default(cuid())
  organizationId          String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  actingStaffProfileId    String
  approvingStaffProfileId String
  capability              String
  targetType              String?
  targetId                String?
  reason                  String
  deviceId                String?
  terminalSessionId       String?
  createdAt               DateTime @default(now())

  actingStaffProfile    RestaurantStaffProfile      @relation("CoAuthActingStaff", fields: [actingStaffProfileId], references: [id], onDelete: Restrict)
  approvingStaffProfile RestaurantStaffProfile      @relation("CoAuthApprovingStaff", fields: [approvingStaffProfileId], references: [id], onDelete: Restrict)
  device                RestaurantRegisteredDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  terminalSession       RestaurantTerminalSession?  @relation(fields: [terminalSessionId], references: [id], onDelete: SetNull)
  billVoids             RestaurantBill[]
  billLineComps         RestaurantBillLine[]
  refunds               RestaurantRefund[]
  dailyCloses           RestaurantDailyClose[]
  // M7-L1: co-authorization optionally pinned on a sensitive SOP verification
  // (VERIFY/REJECT/WAIVE) — single-column FK, the M5 refund/close precedent.
  sopVerifications      RestaurantSopVerification[]

  @@index([organizationId])
  @@index([actingStaffProfileId])
  @@index([approvingStaffProfileId])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("restaurant_co_authorizations")
}

// ===========================================================================
// M3-L1 — Brands, canonical catalog, recipes/BOM, effective-dated pricing,
// brand-owned menus and branch-menu publications for the Restaurant vertical.
//
// Binding design constraints realised in this model set:
//   C1  Every table is org-scoped (bare RLS-guarded organizationId defaulting
//       from the transaction-local setting) and gets forced org RLS in the
//       migration.
//   C2  Structural shadow-copy prevention: canonical tables (brand, category,
//       product, variant, modifier group/option, combo seam, unit, conversion,
//       ingredient, allergen, recipe + versions + lines, price list + versions
//       + entries, menu + sections + items) carry NO branchId. Branch linkage
//       lives only on the publication side, which references canonical rows by
//       FK. Override rows carry only availability + price — never content.
//   C3  Versioned records (recipe versions, price-list versions) are immutable
//       once ACTIVE; editing forks a new version (DRAFT -> ACTIVE -> SUPERSEDED)
//       and superseded versions stay readable forever. The transition/immutability
//       primitives live in src/lib/restaurant/effective-dating.ts.
//   C4  All monetary values are Decimal(12,2); no floats in catalog pricing.
//   C5  Availability windows are branch-local wall-clock (minutes-of-day + a
//       day-of-week set) evaluated server-side against RestaurantBranch.timezone;
//       exception rows are branch-local calendar dates. Channel is an additive
//       enum (D06 seam).
//   C6  Exactly one default RestaurantBrand per organization (partial unique
//       index in the migration); the default brand is ensured lazily by the
//       catalog server (no onboarding edit, no SQL backfill).
// ===========================================================================

/// M3/C6: brand lifecycle. Archived brands are retained (history), not deleted.
enum RestaurantBrandStatus {
  ACTIVE
  ARCHIVED
}

/// M3: a product is a simple ITEM or a COMBO (whose component structure lives in
/// RestaurantComboComponentGroup). Additive enum (A08 seam).
enum RestaurantProductType {
  ITEM
  COMBO
}

/// M3: product lifecycle. A referenced product is ARCHIVED, never hard-deleted.
enum RestaurantProductStatus {
  ACTIVE
  ARCHIVED
}

/// M3/C3: shared lifecycle for immutable versioned records (recipe versions and
/// price-list versions). A version is editable only while DRAFT; activation makes
/// it immutable; a new active version SUPERSEDES the prior one, which stays
/// readable forever (GOV-2).
enum RestaurantVersionStatus {
  DRAFT
  ACTIVE
  SUPERSEDED
}

/// M3/§6.3: branch-menu publication lifecycle. RETIRED publications keep their
/// history (GOV-2).
enum RestaurantBranchMenuPublicationStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

/// M3/C5/D06: order-channel dimension for publications and availability. Additive
/// seam — extended, never renumbered.
enum RestaurantOrderChannel {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum RestaurantDeliveryPaymentMode {
  PREPAID
  COD
}

enum RestaurantDeliveryFulfillmentStatus {
  PENDING
  DISPATCHED
  DELIVERED
  CANCELLED
  FAILED
}

/// M3/C6: a customer-facing restaurant/virtual brand. A brand owns menus (§6.3);
/// the canonical catalog itself is organization-owned, not brand-owned. Exactly
/// one default brand exists per organization (a partial unique index enforces it
/// in the migration, since Prisma cannot express a filtered unique); the catalog
/// server ensures the default lazily and idempotently.
model RestaurantBrand {
  id             String                @id @default(cuid())
  organizationId String                @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  name           String
  nameLocalized  Json?
  status         RestaurantBrandStatus @default(ACTIVE)
  isDefault      Boolean               @default(false)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  menus RestaurantMenu[]

  @@index([organizationId])
  @@map("restaurant_brands")
}

/// M3: a catalog category. `parentId` is a nullable self-reference for
/// subcategories; deleting a parent detaches (SetNull), it does not cascade a
/// subtree away. Organization-owned — NO branchId (C2).
model RestaurantCategory {
  id             String   @id @default(cuid())
  organizationId String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  parentId       String?
  name           String
  nameLocalized  Json?
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  parent              RestaurantCategory?            @relation("RestaurantCategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children            RestaurantCategory[]           @relation("RestaurantCategoryTree")
  products            RestaurantProduct[]
  // M4-L1: station routing rules that target this category (category-level
  // routing is the fallback below a product-level rule, above the branch default).
  stationRoutingRules RestaurantStationRoutingRule[]

  @@index([organizationId])
  @@index([parentId])
  @@map("restaurant_categories")
}

/// M3: a sellable catalog product. `type` distinguishes a simple ITEM from a
/// COMBO (whose component structure lives in RestaurantComboComponentGroup).
/// Customer-facing text carries D20 locale-keyed JSON companions
/// (`nameLocalized`, `descriptionLocalized`). Organization-owned — NO branchId
/// (C2). Products are archived (status ARCHIVED), not deleted, once referenced.
model RestaurantProduct {
  id                   String                  @id @default(cuid())
  organizationId       String                  @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  categoryId           String?
  type                 RestaurantProductType   @default(ITEM)
  status               RestaurantProductStatus @default(ACTIVE)
  name                 String
  nameLocalized        Json?
  description          String?
  descriptionLocalized Json?
  sortOrder            Int                     @default(0)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  category              RestaurantCategory?              @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants              RestaurantProductVariant[]
  modifierGroups        RestaurantProductModifierGroup[]
  comboComponentGroups  RestaurantComboComponentGroup[]
  comboUsages           RestaurantComboComponentOption[]
  allergens             RestaurantProductAllergen[]
  recipes               RestaurantRecipe[]
  menuItems             RestaurantMenuItem[]
  priceListEntries      RestaurantPriceListEntry[]
  // M4-L1: order items snapshotted from this product, and station routing rules
  // that target it (product-level routing outranks category-level, C-list).
  orderItems            RestaurantOrderItem[]
  stationRoutingRules   RestaurantStationRoutingRule[]
  insightItemMixRollups InsightItemMixRollup[]
  cateringLines         RestaurantCateringOrderLine[]

  @@index([organizationId])
  @@index([categoryId])
  @@index([type])
  @@index([status])
  @@map("restaurant_products")
}

/// M3: a size/variant of a product (e.g. Small/Large). Carries no price — the
/// price of a (product, variant) pair lives in effective-dated price-list
/// entries (C4). Organization-owned — NO branchId (C2).
model RestaurantProductVariant {
  id             String   @id @default(cuid())
  organizationId String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  productId      String
  name           String
  nameLocalized  Json?
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  product          RestaurantProduct                @relation(fields: [productId], references: [id], onDelete: Cascade)
  priceListEntries RestaurantPriceListEntry[]
  menuItems        RestaurantMenuItem[]
  comboUsages      RestaurantComboComponentOption[]
  recipes          RestaurantRecipe[]
  // M4-L1: order items snapshotted from this variant.
  orderItems       RestaurantOrderItem[]

  @@index([organizationId])
  @@index([productId])
  @@map("restaurant_product_variants")
}

/// M3: a modifier group (e.g. "Choose a sauce") with min/max selection rules
/// (`maxSelect` null = unbounded). Attached to products via the join table.
/// Organization-owned — NO branchId (C2).
model RestaurantModifierGroup {
  id             String   @id @default(cuid())
  organizationId String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  name           String
  nameLocalized  Json?
  minSelect      Int      @default(0)
  maxSelect      Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  options            RestaurantModifierOption[]
  productAttachments RestaurantProductModifierGroup[]

  @@index([organizationId])
  @@map("restaurant_modifier_groups")
}

/// M3: an option within a modifier group, with a Decimal price delta (C4).
model RestaurantModifierOption {
  id              String   @id @default(cuid())
  organizationId  String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  modifierGroupId String
  name            String
  nameLocalized   Json?
  priceDelta      Decimal  @default(0) @db.Decimal(12, 2)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  modifierGroup      RestaurantModifierGroup       @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)
  // M4-L1: order-item modifier snapshots that were selected from this option.
  // The snapshot copies name + price delta; the option link is a nullable
  // convenience ref (SetNull) — the frozen snapshot is authoritative (C4).
  orderItemModifiers RestaurantOrderItemModifier[]

  @@index([organizationId])
  @@index([modifierGroupId])
  @@map("restaurant_modifier_options")
}

/// M3: attachment of a modifier group to a product (many-to-many with ordering).
model RestaurantProductModifierGroup {
  id              String   @id @default(cuid())
  organizationId  String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  productId       String
  modifierGroupId String
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  product       RestaurantProduct       @relation(fields: [productId], references: [id], onDelete: Cascade)
  modifierGroup RestaurantModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  @@unique([productId, modifierGroupId])
  @@index([organizationId])
  @@index([modifierGroupId])
  @@map("restaurant_product_modifier_groups")
}

/// M3/A08 (combo seam — schema + minimal CRUD only, no UI): a choose-group on a
/// COMBO product (e.g. "Choose a side", choose 1..N).
model RestaurantComboComponentGroup {
  id             String   @id @default(cuid())
  organizationId String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  comboProductId String
  name           String
  nameLocalized  Json?
  minChoose      Int      @default(1)
  maxChoose      Int?
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  comboProduct RestaurantProduct                @relation(fields: [comboProductId], references: [id], onDelete: Cascade)
  options      RestaurantComboComponentOption[]

  @@index([organizationId])
  @@index([comboProductId])
  @@map("restaurant_combo_component_groups")
}

/// M3/A08: a selectable component within a combo group, referencing a component
/// product (and optional variant) with a Decimal price delta (C4). Referenced
/// catalog rows are protected from deletion (Restrict); archival is the path.
model RestaurantComboComponentOption {
  id               String   @id @default(cuid())
  organizationId   String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  componentGroupId String
  productId        String
  variantId        String?
  priceDelta       Decimal  @default(0) @db.Decimal(12, 2)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  componentGroup RestaurantComboComponentGroup @relation(fields: [componentGroupId], references: [id], onDelete: Cascade)
  product        RestaurantProduct             @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant        RestaurantProductVariant?     @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([componentGroupId])
  @@index([productId])
  @@map("restaurant_combo_component_options")
}

/// M3: a unit of measure (e.g. gram, each). Conversions between units are
/// separate rows. Organization-owned.
model RestaurantUnit {
  id             String   @id @default(cuid())
  organizationId String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  name           String
  abbreviation   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  conversionsFrom      RestaurantUnitConversion[]      @relation("RestaurantUnitConversionFrom")
  conversionsTo        RestaurantUnitConversion[]      @relation("RestaurantUnitConversionTo")
  ingredients          RestaurantIngredient[]
  recipeLines          RestaurantRecipeLine[]
  recipeVersions       RestaurantRecipeVersion[]
  // M6-L1: canonical stock unit for stock items, and the ordering/receiving units
  // recorded on purchase-order / receipt lines (converted to canonical at post).
  stockItems           RestaurantStockItem[]
  purchaseOrderLines   RestaurantPurchaseOrderLine[]
  purchaseReceiptLines RestaurantPurchaseReceiptLine[]

  @@index([organizationId])
  @@map("restaurant_units")
}

/// M3: a directed unit conversion (`factor` such that 1 fromUnit = factor toUnit),
/// stored as a high-precision Decimal. The consistency/cycle guard is server-side
/// (L2). One row per ordered (fromUnit, toUnit) pair.
model RestaurantUnitConversion {
  id             String   @id @default(cuid())
  organizationId String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  fromUnitId     String
  toUnitId       String
  factor         Decimal  @db.Decimal(18, 6)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  fromUnit RestaurantUnit @relation("RestaurantUnitConversionFrom", fields: [fromUnitId], references: [id], onDelete: Cascade)
  toUnit   RestaurantUnit @relation("RestaurantUnitConversionTo", fields: [toUnitId], references: [id], onDelete: Cascade)

  @@unique([fromUnitId, toUnitId])
  @@index([organizationId])
  @@index([toUnitId])
  @@map("restaurant_unit_conversions")
}

/// M3: an allergen the organization tracks. Attached to products and ingredients
/// via join tables.
model RestaurantAllergen {
  id             String   @id @default(cuid())
  organizationId String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  name           String
  nameLocalized  Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  productAllergens    RestaurantProductAllergen[]
  ingredientAllergens RestaurantIngredientAllergen[]

  @@index([organizationId])
  @@map("restaurant_allergens")
}

/// M3: product-to-allergen link (declared allergens on a product).
model RestaurantProductAllergen {
  id             String   @id @default(cuid())
  organizationId String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  productId      String
  allergenId     String
  createdAt      DateTime @default(now())

  product  RestaurantProduct  @relation(fields: [productId], references: [id], onDelete: Cascade)
  allergen RestaurantAllergen @relation(fields: [allergenId], references: [id], onDelete: Cascade)

  @@unique([productId, allergenId])
  @@index([organizationId])
  @@index([allergenId])
  @@map("restaurant_product_allergens")
}

/// M3: ingredient-to-allergen link (allergens carried by an ingredient).
model RestaurantIngredientAllergen {
  id             String   @id @default(cuid())
  organizationId String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  ingredientId   String
  allergenId     String
  createdAt      DateTime @default(now())

  ingredient RestaurantIngredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  allergen   RestaurantAllergen   @relation(fields: [allergenId], references: [id], onDelete: Cascade)

  @@unique([ingredientId, allergenId])
  @@index([organizationId])
  @@index([allergenId])
  @@map("restaurant_ingredient_allergens")
}

/// M3: a catalog-side ingredient identity. `referenceCost` is a nullable Decimal
/// seam only (theoretical costing arrives with the Inventory/Purchasing
/// milestone); NO stock fields (movements/counts/batches) exist here.
model RestaurantIngredient {
  id             String   @id @default(cuid())
  organizationId String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  name           String
  nameLocalized  Json?
  baseUnitId     String
  referenceCost  Decimal? @db.Decimal(12, 4)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  baseUnit              RestaurantUnit                   @relation(fields: [baseUnitId], references: [id], onDelete: Restrict)
  allergens             RestaurantIngredientAllergen[]
  recipeLines           RestaurantRecipeLine[]
  recipeLineSubstitutes RestaurantRecipeLineSubstitute[]
  // M6-L1: the ingredient's stockable identity (one per ingredient). NO stock
  // columns land on the ingredient itself — inventory lives on RestaurantStockItem.
  stockItem             RestaurantStockItem?

  @@index([organizationId])
  @@index([baseUnitId])
  @@map("restaurant_ingredients")
}

/// M3/C3: a recipe attached to a product (nullable variant seam). Its content
/// lives in immutable versions; the recipe row is the stable identity that
/// versions hang off. Sub-recipe references from other recipes' lines point at
/// this row.
model RestaurantRecipe {
  id             String   @id @default(cuid())
  organizationId String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  productId      String
  variantId      String?
  name           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  product        RestaurantProduct             @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant        RestaurantProductVariant?     @relation(fields: [variantId], references: [id], onDelete: SetNull)
  versions       RestaurantRecipeVersion[]
  subRecipeLines RestaurantRecipeLine[]        @relation("RecipeLineSubRecipe")
  cateringLines  RestaurantCateringOrderLine[]

  @@index([organizationId])
  @@index([productId])
  @@index([variantId])
  @@map("restaurant_recipes")
}

/// M3/C3: an immutable-once-ACTIVE recipe version. Editing an ACTIVE version
/// forks a new DRAFT (see effective-dating.ts); a partial unique index in the
/// migration enforces at most one ACTIVE version per recipe. Superseded versions
/// remain readable forever (GOV-2).
model RestaurantRecipeVersion {
  id             String                  @id @default(cuid())
  organizationId String                  @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  recipeId       String
  versionNumber  Int
  status         RestaurantVersionStatus @default(DRAFT)
  yieldQuantity  Decimal?                @db.Decimal(12, 3)
  yieldUnitId    String?
  portionCount   Int?
  notes          String?
  activatedAt    DateTime?
  supersededAt   DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  recipe    RestaurantRecipe       @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  yieldUnit RestaurantUnit?        @relation(fields: [yieldUnitId], references: [id], onDelete: SetNull)
  lines     RestaurantRecipeLine[]

  @@unique([recipeId, versionNumber])
  @@index([organizationId])
  @@index([recipeId])
  @@index([status])
  @@map("restaurant_recipe_versions")
}

/// M3/C3: a version-owned bill-of-materials line. Exactly one of `ingredientId`
/// or `subRecipeId` is set (a CHECK enforces the XOR in the migration); cycle
/// detection over sub-recipes is server-side (L2). Quantity + unit are the BOM
/// measure.
model RestaurantRecipeLine {
  id              String   @id @default(cuid())
  organizationId  String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  recipeVersionId String
  ingredientId    String?
  subRecipeId     String?
  quantity        Decimal  @db.Decimal(12, 4)
  unitId          String
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  recipeVersion       RestaurantRecipeVersion          @relation(fields: [recipeVersionId], references: [id], onDelete: Cascade)
  ingredient          RestaurantIngredient?            @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  subRecipe           RestaurantRecipe?                @relation("RecipeLineSubRecipe", fields: [subRecipeId], references: [id], onDelete: Restrict)
  unit                RestaurantUnit                   @relation(fields: [unitId], references: [id], onDelete: Restrict)
  approvedSubstitutes RestaurantRecipeLineSubstitute[]

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([recipeVersionId])
  @@index([ingredientId])
  @@index([subRecipeId])
  @@map("restaurant_recipe_lines")
}

/// Approved ingredient alternatives for an ingredient-backed recipe line. This
/// is configuration only: fulfilment, costing, and allergen consequences remain
/// server-owned by the later order-execution seam.
model RestaurantRecipeLineSubstitute {
  id                     String   @id @default(cuid())
  organizationId         String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  recipeLineId           String
  substituteIngredientId String
  createdAt              DateTime @default(now())

  recipeLine           RestaurantRecipeLine @relation(fields: [recipeLineId], references: [id], onDelete: Cascade)
  substituteIngredient RestaurantIngredient @relation(fields: [substituteIngredientId], references: [id], onDelete: Restrict)

  @@unique([recipeLineId, substituteIngredientId])
  @@index([organizationId])
  @@index([substituteIngredientId])
  @@map("restaurant_recipe_line_substitutes")
}

/// M3/C4: a named price list. `isDefault` marks the organization's base list
/// (the fallback in the winning-price precedence item override > publication
/// price list > base list); a partial unique index enforces one default per org.
model RestaurantPriceList {
  id             String   @id @default(cuid())
  organizationId String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  name           String
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  versions     RestaurantPriceListVersion[]
  publications RestaurantBranchMenuPublication[]

  @@index([organizationId])
  @@map("restaurant_price_lists")
}

/// M3/C3/C4: an effective-dated, immutable-once-ACTIVE price-list version. The
/// active version at an instant T is the ACTIVE version with the greatest
/// `effectiveFrom <= T` (see effective-dating.ts); superseded versions remain
/// readable. One version per (list, effectiveFrom).
model RestaurantPriceListVersion {
  id             String                  @id @default(cuid())
  organizationId String                  @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  priceListId    String
  versionNumber  Int
  effectiveFrom  DateTime
  status         RestaurantVersionStatus @default(DRAFT)
  activatedAt    DateTime?
  supersededAt   DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  priceList RestaurantPriceList        @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  entries   RestaurantPriceListEntry[]
  // M4-L1/C4: orders that snapshotted this price-list version as the price
  // configuration used for calculation (§11.1). SetNull on removal — the item
  // unit-price snapshots are authoritative, never rewritten by later edits.
  orders    RestaurantOrder[]

  @@unique([priceListId, effectiveFrom])
  @@index([organizationId])
  @@index([priceListId])
  @@index([status])
  @@map("restaurant_price_list_versions")
}

/// M3/C4: a version-owned price for a (product, optional variant) pair. Money is
/// Decimal(12,2). A migration-only COALESCE unique index enforces one entry per
/// (version, product, variant) including the null-variant (base) row.
model RestaurantPriceListEntry {
  id                 String   @id @default(cuid())
  organizationId     String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  priceListVersionId String
  productId          String
  variantId          String?
  price              Decimal  @db.Decimal(12, 2)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  priceListVersion RestaurantPriceListVersion @relation(fields: [priceListVersionId], references: [id], onDelete: Cascade)
  product          RestaurantProduct          @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant          RestaurantProductVariant?  @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([priceListVersionId])
  @@index([productId])
  @@map("restaurant_price_list_entries")
}

/// M3/§6.3: a brand-owned menu. Sections and items are its canonical structure;
/// branches publish a menu via RestaurantBranchMenuPublication. NO branchId (C2).
model RestaurantMenu {
  id             String   @id @default(cuid())
  organizationId String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  brandId        String
  name           String
  nameLocalized  Json?
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  brand        RestaurantBrand                   @relation(fields: [brandId], references: [id], onDelete: Cascade)
  sections     RestaurantMenuSection[]
  publications RestaurantBranchMenuPublication[]

  @@index([organizationId])
  @@index([brandId])
  @@map("restaurant_menus")
}

/// M3: a section within a menu (ordered grouping of items).
model RestaurantMenuSection {
  id             String   @id @default(cuid())
  organizationId String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  menuId         String
  name           String
  nameLocalized  Json?
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  menu  RestaurantMenu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  items RestaurantMenuItem[]

  @@index([organizationId])
  @@index([menuId])
  @@map("restaurant_menu_sections")
}

/// M3: a menu item scoping a product (and optional variant) into a section.
/// `displayName`/`nameLocalized` are optional menu-specific naming; the referenced
/// product is protected from deletion (Restrict).
model RestaurantMenuItem {
  id             String   @id @default(cuid())
  organizationId String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  sectionId      String
  productId      String
  variantId      String?
  displayName    String?
  nameLocalized  Json?
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  section   RestaurantMenuSection              @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  product   RestaurantProduct                  @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant   RestaurantProductVariant?          @relation(fields: [variantId], references: [id], onDelete: Restrict)
  windows   RestaurantMenuAvailabilityWindow[]
  overrides RestaurantBranchMenuItemOverride[]

  @@index([organizationId])
  @@index([sectionId])
  @@index([productId])
  @@map("restaurant_menu_items")
}

/// M3/§6.3/C5: a publication binding one branch to one brand-owned menu, with an
/// optional price-list reference and a set of order channels (D06). Its status
/// lifecycle is DRAFT -> PUBLISHED -> RETIRED; retired publications keep their
/// history (GOV-2). Availability windows/exceptions and item overrides hang off
/// it — the only branch-linked catalog surface (C2).
model RestaurantBranchMenuPublication {
  id             String                                @id @default(cuid())
  organizationId String                                @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  branchId       String
  menuId         String
  priceListId    String?
  status         RestaurantBranchMenuPublicationStatus @default(DRAFT)
  channels       RestaurantOrderChannel[]              @default([])
  publishedAt    DateTime?
  retiredAt      DateTime?
  createdAt      DateTime                              @default(now())
  updatedAt      DateTime                              @updatedAt

  branch        RestaurantBranch                      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  menu          RestaurantMenu                        @relation(fields: [menuId], references: [id], onDelete: Cascade)
  priceList     RestaurantPriceList?                  @relation(fields: [priceListId], references: [id], onDelete: SetNull)
  windows       RestaurantMenuAvailabilityWindow[]
  exceptions    RestaurantMenuAvailabilityException[]
  itemOverrides RestaurantBranchMenuItemOverride[]
  // M4-L1/C4: orders that snapshotted this publication as the effective-menu
  // source used for calculation (§11.1). SetNull keeps the order if the
  // publication is later retired/removed — the snapshot columns are authoritative.
  orders        RestaurantOrder[]

  @@index([organizationId])
  @@index([branchId])
  @@index([menuId])
  @@index([status])
  @@map("restaurant_branch_menu_publications")
}

/// M3/C5: a publication-owned availability window. Stored as branch-local
/// wall-clock minutes-of-day (`startMinutes`/`endMinutes`) plus a day-of-week set
/// (`daysOfWeek`, 0=Sunday..6=Saturday); a cross-midnight window has
/// endMinutes <= startMinutes. Evaluated server-side against the branch timezone
/// (client time is untrusted). Optional `menuItemId` scopes the window to a single
/// item; null = whole publication.
model RestaurantMenuAvailabilityWindow {
  id             String   @id @default(cuid())
  organizationId String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  publicationId  String
  menuItemId     String?
  label          String?
  daysOfWeek     Int[]    @default([])
  startMinutes   Int
  endMinutes     Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  publication RestaurantBranchMenuPublication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  menuItem    RestaurantMenuItem?             @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([publicationId])
  @@index([menuItemId])
  @@map("restaurant_menu_availability_windows")
}

/// M3/C5: a publication-owned exception for a single branch-local calendar date.
/// `isClosed` true closes an otherwise-open date; false opens an otherwise-closed
/// one. One exception per (publication, date).
model RestaurantMenuAvailabilityException {
  id             String   @id @default(cuid())
  organizationId String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  publicationId  String
  date           DateTime @db.Date
  isClosed       Boolean  @default(true)
  label          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  publication RestaurantBranchMenuPublication @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  @@unique([publicationId, date])
  @@index([organizationId])
  @@index([publicationId])
  @@map("restaurant_menu_availability_exceptions")
}

/// M3/C2: a per-publication override of a menu item. Carries ONLY an availability
/// flag and a nullable Decimal price override — never content (name/composition).
/// One override per (publication, menuItem).
model RestaurantBranchMenuItemOverride {
  id             String   @id @default(cuid())
  organizationId String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  publicationId  String
  menuItemId     String
  isAvailable    Boolean  @default(true)
  priceOverride  Decimal? @db.Decimal(12, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  publication RestaurantBranchMenuPublication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  menuItem    RestaurantMenuItem              @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([publicationId, menuItemId])
  @@index([organizationId])
  @@index([publicationId])
  @@index([menuItemId])
  @@map("restaurant_branch_menu_item_overrides")
}

// ===========================================================================
// M4-L1 — Orders, kitchen (KOT/KDS), floor & service sections/stations, the
// append-only order event ledger + transactional outbox, device idempotency,
// and per-branch business-day order numbering for the Restaurant vertical
// (restaurant/m4).
//
// Binding design constraints realised in this model set:
//   C1  Every table is org-scoped (bare RLS-guarded organizationId defaulting
//       from the transaction-local setting) and gets forced org RLS in the
//       migration. No M4 table lives outside tenant RLS.
//   C2  Ledger-first: every order/item state change appends a
//       RestaurantOrderEvent (append-only, per-order monotonic `sequence`) and a
//       RestaurantEventOutbox row in the SAME transaction as the change (see
//       src/lib/restaurant/outbox.ts). KOT/KDS read models derive from durable
//       rows (events + tickets + item states), never from process-local
//       emission. The outbox dispatcher is a seam (interface + PENDING/
//       DISPATCHED/DEAD + attempt fields); no external consumer ships in M4.
//   C3  Single-authority state machines: the exact RestaurantOrderStatus and
//       RestaurantOrderItemStatus enums live here; transition maps + §11.1
//       invariants live in src/lib/restaurant/order-state-machine.ts; only the
//       L2 command layer writes the status columns. No stored aggregate/total on
//       the order — order aggregates are derived (governance-testable).
//   C4  Snapshot-on-write: an order item freezes name, unit
//       price, quantity, and tax/service-charge fields (structurally present,
//       zero-valued until the tax milestone), plus the publication +
//       price-list-version references used. All money is Decimal; no floats.
//       Modifier selections snapshot name + price delta. A nullable seatNumber
//       is the §11.2 seat seam.
//   C5  Business date is stamped explicitly at creation from branch timezone +
//       businessDayCutoff (Intl-based, DST-safe); the human order number is
//       allocated transactionally from a per-(branch, businessDate) sequence
//       row (uniqueness + monotonicity guaranteed; gap-free NOT promised). Order
//       numbers are not receipt numbers.
//   C6  Attribution: every order/item command records the acting operator
//       (staffProfileId) and terminal (deviceId); server time (createdAt) is
//       authoritative. Post-preparation void / cancel-with-prepared-items
//       require a co-authorization (M2 primitive) + reason + wastage
//       disposition; the disposition is recorded with NO inventory mutation in
//       M4 (BUILD-ASSUMPTIONS).
//   C7  Every terminal-submitted mutating command carries a device-scoped
//       idempotency key (unique (deviceId, key)); replays return the original
//       result and create nothing.
// ===========================================================================

/// M4/C3/§11.1: the EXACT order status domain (no additions, renames, or
/// omissions). The four kitchen-facing states (SENT/IN_PREPARATION/READY/SERVED)
/// are DERIVED from item facts by the single derivation function in
/// order-state-machine.ts and written only by the L2 command layer.
enum RestaurantOrderStatus {
  DRAFT
  OPEN
  SENT
  IN_PREPARATION
  READY
  SERVED
  PAYMENT_PENDING
  CLOSED
  CANCELLED
}

/// M4/C3/§11.1: the EXACT order-item status domain. VOIDED is the single
/// terminal state; KDS display statuses are a fixed mapping onto these
/// (order-state-machine.ts), never a third authoritative machine.
enum RestaurantOrderItemStatus {
  HELD
  QUEUED
  FIRING
  PREPARED
  SERVED
  REMAKE_REQUESTED
  VOIDED
}

/// M4/C6: the stock policy hook recorded on a post-preparation void/waste. The
/// disposition + outbox event are persisted; NO inventory mutation exists until
/// the inventory milestone (BUILD-ASSUMPTIONS). NONE = no stock effect recorded.
enum RestaurantWastageDisposition {
  WASTE
  RESTOCK
  NONE
}

/// M4/§11.2: why a table was linked to an order — the guest was seated, an order
/// was moved to a different table, or two tables were merged under one order.
enum RestaurantOrderTableLinkReason {
  SEATED
  MOVE
  MERGE
}

/// M4/C2: transactional-outbox dispatch lifecycle. PENDING awaits dispatch,
/// DISPATCHED has been handed to a consumer, DEAD has exhausted its attempts
/// (dead-letter). The dispatcher itself is a seam in M4 — no external consumer
/// ships (§12.2 debt flagged, not claimed).
enum RestaurantOutboxStatus {
  PENDING
  DISPATCHED
  DEAD
}

/// M4/C8: what role a registered device plays. POS is a register/terminal; KDS
/// is a kitchen display bound to one station. Additive seam — extended, never
/// renumbered.
enum RestaurantDeviceKind {
  POS
  KDS
  PRINT_BRIDGE
}

/// M4/§4: a physical floor/area within a branch that holds tables. Org-scoped
/// under forced RLS (C1).
model RestaurantFloor {
  id             String   @id @default(cuid())
  organizationId String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  branchId       String
  name           String
  sortOrder      Int      @default(0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  branch RestaurantBranch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tables RestaurantTable[]

  @@index([organizationId])
  @@index([branchId])
  @@map("restaurant_floors")
}

/// M4/§4: a table on a floor. `code` is the human table label, unique within its
/// floor. `capacity` is the seat count. Org-scoped under forced RLS (C1).
model RestaurantTable {
  id             String   @id @default(cuid())
  organizationId String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  floorId        String
  code           String
  capacity       Int
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  floor        RestaurantFloor                @relation(fields: [floorId], references: [id], onDelete: Cascade)
  sectionLinks RestaurantServerSectionTable[]
  orderLinks   RestaurantOrderTable[]

  @@unique([floorId, code])
  @@index([organizationId])
  @@index([floorId])
  @@map("restaurant_tables")
}

/// M4 (Restaurant Core): a server section — a grouping of tables assigned to a
/// server. Membership is a join table; per-business-date staffing is a separate
/// assignment table. Org-scoped under forced RLS (C1).
model RestaurantServerSection {
  id             String   @id @default(cuid())
  organizationId String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  branchId       String
  name           String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  branch      RestaurantBranch                    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tableLinks  RestaurantServerSectionTable[]
  assignments RestaurantServerSectionAssignment[]
  orders      RestaurantOrder[]

  @@index([organizationId])
  @@index([branchId])
  @@map("restaurant_server_sections")
}

/// M4: section ↔ table membership. One row per (section, table).
model RestaurantServerSectionTable {
  id             String   @id @default(cuid())
  organizationId String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  sectionId      String
  tableId        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  section RestaurantServerSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  table   RestaurantTable         @relation(fields: [tableId], references: [id], onDelete: Cascade)

  // Membership is a plain join (no (sectionId, tableId) unique): a section may be
  // re-seeded and L2 dedups at the command layer; the batteries probe a second
  // membership row referencing the same parents.
  @@index([organizationId])
  @@index([sectionId])
  @@index([tableId])
  @@map("restaurant_server_section_tables")
}

/// M4: the staff operator assigned to a section for a given business date. Shift
/// granularity is deferred (BUILD-ASSUMPTIONS); one assignment per
/// (section, staff, businessDate).
model RestaurantServerSectionAssignment {
  id             String   @id @default(cuid())
  organizationId String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  sectionId      String
  staffProfileId String
  businessDate   DateTime @db.Date
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  section      RestaurantServerSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  staffProfile RestaurantStaffProfile  @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)

  @@unique([sectionId, staffProfileId, businessDate])
  @@index([organizationId])
  @@index([sectionId])
  @@index([staffProfileId])
  @@index([businessDate])
  @@map("restaurant_server_section_assignments")
}

/// M4 (Restaurant Core): a kitchen/prep station (grill, bar, expo). Exactly one
/// default station per branch is enforced by a partial unique index in the
/// migration (Prisma cannot express a filtered unique). Order items route to a
/// station via the routing rules; unmatched items fall through to the default.
model RestaurantKitchenStation {
  id             String   @id @default(cuid())
  organizationId String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  branchId       String
  name           String
  active         Boolean  @default(true)
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  branch       RestaurantBranch               @relation(fields: [branchId], references: [id], onDelete: Cascade)
  routingRules RestaurantStationRoutingRule[]
  tickets      RestaurantKitchenTicket[]
  devices      RestaurantRegisteredDevice[]
  printRoutes  RestaurantPrintRoute[]

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([branchId])
  @@map("restaurant_kitchen_stations")
}

enum RestaurantPrintDocumentType {
  KITCHEN_TICKET
  BAR_TICKET
  RECEIPT
}

enum RestaurantPrintJobStatus {
  PENDING
  OFFLINE
  NO_PRINTER
  PRINTED
}

/// Durable, vendor-neutral branch/station/document routing. Printer identifiers
/// are opaque adapter inputs; no hardware vendor contract is persisted here.
model RestaurantPrintRoute {
  id             String                      @id @default(cuid())
  organizationId String                      @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  branchId       String
  stationId      String?
  documentType   RestaurantPrintDocumentType
  printerId      String
  enabled        Boolean                     @default(true)
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  branch  RestaurantBranch          @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Cascade)
  station RestaurantKitchenStation? @relation(fields: [organizationId, stationId], references: [organizationId, id], onDelete: Cascade)

  registeredPrinterId String?
  registeredPrinter RestaurantPrinter? @relation(fields: [organizationId, branchId, registeredPrinterId], references: [organizationId, branchId, id], onDelete: Restrict, onUpdate: NoAction, map: "restaurant_print_routes_registered_printer_fkey")

  @@index([organizationId, branchId, registeredPrinterId], map: "restaurant_print_routes_org_branch_registered_printer_idx")
  @@unique([organizationId, branchId, stationId, documentType])
  @@index([organizationId, branchId])
  @@map("restaurant_print_routes")
}

/// Append-only print intent and retry state. The unique tenant/branch key is the
/// durable replay boundary; attempts update only delivery state, never payload.
model RestaurantPrintJob {
  id             String                      @id @default(cuid())
  organizationId String                      @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  branchId       String
  stationId      String?
  idempotencyKey String
  documentType   RestaurantPrintDocumentType
  document       Json
  status         RestaurantPrintJobStatus    @default(PENDING)
  printerId      String?
  byteCount      Int?
  attemptCount   Int                         @default(0)
  lastAttemptAt  DateTime?
  printedAt      DateTime?
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  branch RestaurantBranch @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)

  registeredPrinterId String?
  registeredPrinter RestaurantPrinter? @relation(fields: [organizationId, branchId, registeredPrinterId], references: [organizationId, branchId, id], onDelete: Restrict, onUpdate: NoAction, map: "restaurant_print_jobs_registered_printer_fkey")

  @@index([organizationId, branchId, registeredPrinterId], map: "restaurant_print_jobs_org_branch_registered_printer_idx")
  @@unique([organizationId, branchId, idempotencyKey])
  @@index([organizationId, status, createdAt])
  @@map("restaurant_print_jobs")
}

/// M4: a routing rule targeting a station. Exactly one of `productId` or
/// `categoryId` is set (a CHECK enforces the XOR in the migration). Resolution is
/// most-specific-wins (product rule > category rule > branch default) with
/// `priority` breaking ties within a level (src/lib/restaurant/station-routing.ts).
model RestaurantStationRoutingRule {
  id             String   @id @default(cuid())
  organizationId String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  stationId      String
  productId      String?
  categoryId     String?
  priority       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  station  RestaurantKitchenStation @relation(fields: [stationId], references: [id], onDelete: Cascade)
  product  RestaurantProduct?       @relation(fields: [productId], references: [id], onDelete: Cascade)
  category RestaurantCategory?      @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([stationId])
  @@index([productId])
  @@index([categoryId])
  @@map("restaurant_station_routing_rules")
}

/// M4/§11.1: an order — the kitchen & fulfilment scope (the financial Bill/Check
/// scope is a later milestone). Immutable `id`; the human `orderNumber` is
/// allocated per (branch, businessDate); `businessDate` is stamped explicitly
/// (C5). The opening operator + terminal are recorded (C6); the effective-menu
/// publication and price-list-version used for calculation are snapshotted (C4).
/// There is NO stored total/aggregate column — aggregates are derived (C3).
model RestaurantOrder {
  id                           String                 @id @default(cuid())
  organizationId               String                 @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  branchId                     String
  orderNumber                  Int
  businessDate                 DateTime               @db.Date
  status                       RestaurantOrderStatus  @default(DRAFT)
  channel                      RestaurantOrderChannel
  coverCount                   Int?
  sectionId                    String?
  serverStaffProfileId         String?
  staffProfileId               String
  deviceId                     String
  publicationId                String?
  priceListVersionId           String?
  serviceChargePolicyVersionId String?
  customerId                   String?
  openedAt                     DateTime?
  closedAt                     DateTime?
  cancelledAt                  DateTime?
  createdAt                    DateTime               @default(now())
  updatedAt                    DateTime               @updatedAt

  branch                     RestaurantBranch                      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  section                    RestaurantServerSection?              @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  serverStaff                RestaurantStaffProfile?               @relation("OrderServerStaff", fields: [serverStaffProfileId], references: [id], onDelete: SetNull)
  openingStaff               RestaurantStaffProfile                @relation("OrderOpeningStaff", fields: [staffProfileId], references: [id], onDelete: Restrict)
  openingDevice              RestaurantRegisteredDevice            @relation("OrderOpeningDevice", fields: [deviceId], references: [id], onDelete: Restrict)
  publication                RestaurantBranchMenuPublication?      @relation(fields: [publicationId], references: [id], onDelete: SetNull)
  priceListVersion           RestaurantPriceListVersion?           @relation(fields: [priceListVersionId], references: [id], onDelete: SetNull)
  serviceChargePolicyVersion RestaurantServiceChargePolicyVersion? @relation(fields: [organizationId, serviceChargePolicyVersionId], references: [organizationId, id], onDelete: Restrict)
  customer                   RestaurantCustomer?                   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items                      RestaurantOrderItem[]
  orderTables                RestaurantOrderTable[]
  events                     RestaurantOrderEvent[]
  kitchenTickets             RestaurantKitchenTicket[]
  bills                      RestaurantBill[]
  // M6-L1: RECIPE_CONSUMPTION / SALE_REVERSAL movements posted at order close and
  // for post-close corrections reference the originating order (nullable, SetNull).
  stockMovements             RestaurantStockMovement[]
  customerInteractions       CustomerInteraction[]
  deliveryFulfillment        RestaurantDeliveryFulfillment?

  @@unique([branchId, businessDate, orderNumber])
  @@unique([organizationId, branchId, id])
  @@index([organizationId])
  @@index([branchId])
  @@index([status])
  @@index([businessDate])
  @@index([sectionId])
  @@index([serverStaffProfileId])
  @@index([staffProfileId])
  @@index([deviceId])
  @@index([customerId])
  @@map("restaurant_orders")
}

/// M4/C4/§11.1: an order item with SNAPSHOT columns frozen at add time —
/// `name`, `unitPrice`, `quantity`, and zero-valued tax/service-charge
/// fields (structurally present; the tax milestone fills them). `course` and the
/// nullable `seatNumber` (§11.2 seat seam) support hold-and-fire table service.
/// `remakeOfItemId` keeps a remake linked to its original (must resolve before
/// the order's terminal condition, §11.1). Post-preparation void records the
/// post-prep flag, wastage disposition (C6 — no stock mutation in M4), the
/// co-authorization reference, and a reason.
model RestaurantOrderItem {
  id                    String                        @id @default(cuid())
  organizationId        String                        @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  orderId               String
  course                Int                           @default(1)
  seatNumber            Int?
  productId             String
  variantId             String?
  name                  String
  unitPrice             Decimal                       @db.Decimal(12, 2)
  quantity              Int                           @default(1)
  taxAmount             Decimal                       @default(0) @db.Decimal(12, 2)
  serviceChargeAmount   Decimal                       @default(0) @db.Decimal(12, 2)
  status                RestaurantOrderItemStatus     @default(HELD)
  remakeOfItemId        String?
  voidedPostPrep        Boolean                       @default(false)
  wastageDisposition    RestaurantWastageDisposition?
  voidCoAuthorizationId String?
  voidReason            String?
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt

  order       RestaurantOrder               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     RestaurantProduct             @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant     RestaurantProductVariant?     @relation(fields: [variantId], references: [id], onDelete: SetNull)
  remakeOf    RestaurantOrderItem?          @relation("OrderItemRemake", fields: [remakeOfItemId], references: [id], onDelete: SetNull)
  remakes     RestaurantOrderItem[]         @relation("OrderItemRemake")
  modifiers   RestaurantOrderItemModifier[]
  ticketItems RestaurantKitchenTicketItem[]
  billLines   RestaurantBillLine[]

  @@index([organizationId])
  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@index([status])
  @@index([remakeOfItemId])
  @@map("restaurant_order_items")
}

/// M4/C4: an item-owned modifier SNAPSHOT. Copies the option's name
/// (`name`) and `priceDelta` at add time; the `modifierOptionId` link is
/// a nullable convenience reference (SetNull) — the snapshot is authoritative and
/// is never rewritten by later catalog edits. (No composite tenant FK: the M3
/// modifier-option table carries no (organizationId, id) unique and is consumed,
/// never modified — C9.)
model RestaurantOrderItemModifier {
  id               String   @id @default(cuid())
  organizationId   String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  orderItemId      String
  modifierOptionId String?
  name             String
  priceDelta       Decimal  @db.Decimal(12, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  orderItem      RestaurantOrderItem       @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  modifierOption RestaurantModifierOption? @relation(fields: [modifierOptionId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([orderItemId])
  @@index([modifierOptionId])
  @@map("restaurant_order_item_modifiers")
}

/// M4/§11.2: order ↔ table link history. `active` marks the current link; the
/// `linkReason` records why it was made (seated, moved, merged). Merge = several
/// active table links under one order; combining two OPEN orders into one is
/// deferred (BUILD-ASSUMPTIONS). At most one active link per (order, table) is
/// enforced by a partial unique index in the migration.
model RestaurantOrderTable {
  id             String                         @id @default(cuid())
  organizationId String                         @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  orderId        String
  tableId        String
  active         Boolean                        @default(true)
  linkReason     RestaurantOrderTableLinkReason @default(SEATED)
  linkedAt       DateTime                       @default(now())
  unlinkedAt     DateTime?
  createdAt      DateTime                       @default(now())
  updatedAt      DateTime                       @updatedAt

  order RestaurantOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  table RestaurantTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([orderId])
  @@index([tableId])
  @@map("restaurant_order_tables")
}

/// M4/C2/§12.1: the append-only order event ledger. Each order/item state change
/// appends one row with a per-order monotonically increasing `sequence` (unique
/// (orderId, sequence)) inside the same transaction as the change. The acting
/// operator/terminal are recorded; server `createdAt` is authoritative. This
/// model has no updatedAt — rows are append-only by contract (L1 owns no
/// mutation of it); the KDS read model is derived from these rows + tickets +
/// item states, never from process-local emission.
model RestaurantOrderEvent {
  id                  String   @id @default(cuid())
  organizationId      String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  orderId             String
  sequence            Int
  eventType           String
  actorStaffProfileId String?
  actorDeviceId       String?
  payload             Json
  createdAt           DateTime @default(now())

  order       RestaurantOrder             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actorStaff  RestaurantStaffProfile?     @relation("OrderEventActorStaff", fields: [actorStaffProfileId], references: [id], onDelete: SetNull)
  actorDevice RestaurantRegisteredDevice? @relation("OrderEventActorDevice", fields: [actorDeviceId], references: [id], onDelete: SetNull)

  @@unique([orderId, sequence])
  @@index([organizationId])
  @@index([orderId])
  @@index([actorStaffProfileId])
  @@index([actorDeviceId])
  @@map("restaurant_order_events")
}

/// M4/C2/§12.1: the transactional event outbox. Written in the same transaction
/// as the durable state change it advertises; a dispatcher (a SEAM in M4 — no
/// external consumer ships) later moves PENDING rows to DISPATCHED or, after
/// exhausting attempts, DEAD (dead-letter). `aggregateType`/`aggregateId` are a
/// soft reference (the outbox outlives its aggregate and spans aggregate kinds);
/// `nextAttemptAt` carries the backoff schedule.
model RestaurantEventOutbox {
  id             String                 @id @default(cuid())
  organizationId String                 @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  eventType      String
  aggregateType  String
  aggregateId    String
  payload        Json
  status         RestaurantOutboxStatus @default(PENDING)
  attempts       Int                    @default(0)
  nextAttemptAt  DateTime?
  lastError      String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([organizationId])
  @@index([status, nextAttemptAt])
  @@index([aggregateType, aggregateId])
  @@map("restaurant_event_outbox")
}

/// M4/C7/§12.1: a device-scoped idempotency key. A terminal-submitted mutating
/// command carries a `key`; the first occurrence records the `commandType` and
/// the `resultRef` of what it created, and any replay of the same (deviceId, key)
/// returns that original result and creates nothing. Unique (deviceId, key).
model RestaurantOrderIdempotencyKey {
  id             String   @id @default(cuid())
  organizationId String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  deviceId       String
  key            String
  commandType    String
  resultRef      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  device RestaurantRegisteredDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, key])
  @@index([organizationId])
  @@index([deviceId])
  @@map("restaurant_order_idempotency_keys")
}

/// M4 (KOT): a kitchen ticket routed to one station for one order. `ticketNumber`
/// is sequential per (station, businessDate). The KDS read model derives its
/// display from these tickets + the linked item states (C2/§12.5); realtime is
/// only a nudge to read this durable state — no external channel ships in M4.
model RestaurantKitchenTicket {
  id             String   @id @default(cuid())
  organizationId String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  orderId        String
  stationId      String
  businessDate   DateTime @db.Date
  ticketNumber   Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  order   RestaurantOrder               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  station RestaurantKitchenStation      @relation(fields: [stationId], references: [id], onDelete: Restrict)
  items   RestaurantKitchenTicketItem[]

  @@unique([stationId, businessDate, ticketNumber])
  @@index([organizationId])
  @@index([orderId])
  @@index([stationId])
  @@map("restaurant_kitchen_tickets")
}

/// M4 (KOT): a ticket line linking a kitchen ticket to an order item with the
/// quantity fired to that station. One line per (ticket, orderItem).
model RestaurantKitchenTicketItem {
  id             String   @id @default(cuid())
  organizationId String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  ticketId       String
  orderItemId    String
  quantity       Int
  createdAt      DateTime @default(now())

  ticket    RestaurantKitchenTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  orderItem RestaurantOrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  // Plain ticket line (no (ticketId, orderItemId) unique): a fired quantity may
  // be split across lines and L2 composes them; the batteries probe a second
  // line referencing the same ticket + item.
  @@index([organizationId])
  @@index([ticketId])
  @@index([orderItemId])
  @@map("restaurant_kitchen_ticket_items")
}

/// M4/C5: the per-(branch, businessDate) order-number sequence. `nextNumber`
/// holds the most recently allocated number; allocation is a transactional
/// row-locked upsert (INSERT … ON CONFLICT DO UPDATE SET nextNumber = nextNumber
/// + 1 RETURNING) — see src/lib/restaurant/order-numbers.ts. Uniqueness +
/// monotonicity are guaranteed; gap-free is NOT promised (BUILD-ASSUMPTIONS).
model RestaurantOrderNumberSequence {
  id             String   @id @default(cuid())
  organizationId String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  branchId       String
  businessDate   DateTime @db.Date
  nextNumber     Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  branch RestaurantBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, businessDate])
  @@index([organizationId])
  @@index([branchId])
  @@map("restaurant_order_number_sequences")
}

// ===========================================================================
// M5-L1 — Money: bills & splits, tenders & tips, a capability-shaped MOCK
// payment adapter, refunds, register drawer sessions, the immutable daily
// close, and the receipt-number seam for the Restaurant vertical
// (restaurant/m5-money).
//
// Additive and org-scoped. Every new table carries a bare, RLS-guarded
// organizationId (defaulting from the transaction-local setting) and gets
// forced org-level RLS with the exact clause used since M1-L1. No pre-M5 table
// gains a column; the only edits to earlier models are virtual back-relation
// fields (which emit no DDL), matching the M4 precedent.
//
// Binding design constraints (WHA-52 plan) realised here:
//   C1  Forced org RLS on ALL 12 new tables.
//   C2  Every monetary column is Decimal(12,2); ALL arithmetic goes through
//       src/lib/restaurant/money.ts (no floats anywhere).
//   C3  Append-only ledgers — restaurant_tenders, restaurant_payment_events,
//       restaurant_refunds, restaurant_drawer_movements, restaurant_daily_closes,
//       restaurant_daily_close_tender_totals — are DB-enforced append-only: the
//       migration grants them SELECT+INSERT RLS policies ONLY (no UPDATE/DELETE
//       policy ⇒ forced RLS denies mutation). These six models carry NO
//       updatedAt. Corrections are NEW records referencing the original.
//   C4  A bill belongs to exactly one order; split kinds NONE|BY_ITEM|BY_SEAT|
//       FRACTIONAL; a comp nets a line to zero via compAmount while retaining the
//       original snapshot price. Totals snapshot at bill-cut time.
//   C5  tipAmount lives on tenders/refunds only, never merged into the
//       (still-zero) service-charge snapshot; the close reports tipTotal and
//       serviceChargeTotal separately.
//   C10 Receipt numbers allocate from restaurant_receipt_number_sequences,
//       unique (branchId, businessDate) — a seam SEPARATE from order numbers.
//   C11 Money commands carry a device-scoped idempotency key in
//       restaurant_money_idempotency_keys (unique (deviceId, key)); every money
//       record carries operator (staffProfile) + device attribution.
// ===========================================================================

/// M5/C4: bill lifecycle. OPEN checks accept splits/comps/tenders; a bill flips
/// to SETTLED (receipt allocated) once covered, or VOID (reason + co-auth). A
/// financial amount is never rewritten after SETTLED — corrections are new
/// records (C3).
enum RestaurantBillStatus {
  OPEN
  SETTLED
  VOID
}

/// M5/C4/§11.2: how an order's items/total are divided into bills. NONE = one
/// bill for the whole order; BY_ITEM/BY_SEAT allocate whole non-voided items to
/// bills (per-quantity fractioning deferred — BUILD-ASSUMPTIONS); FRACTIONAL
/// divides the order total by integer fraction pairs via the money.ts
/// largest-remainder allocation.
enum RestaurantBillSplitKind {
  NONE
  BY_ITEM
  BY_SEAT
  FRACTIONAL
}

/// M5/§11.2: the settlement channel of a tender. CASH carries change + a drawer
/// movement; CARD carries a payment (adapter) reference; OTHER is the seam for
/// non-cash/non-card (gift/voucher/loyalty deferred).
enum RestaurantTenderType {
  CASH
  CARD
  OTHER
}

/// M5/C6: the payment adapter provider registry — MOCK only in M5 (no real PSP
/// network I/O; D23 not built).
enum RestaurantPaymentProvider {
  MOCK
  TERMINAL
}

enum RestaurantTerminalProviderMode {
  DISABLED
  SIMULATION
  WEBHOOK
}

enum RestaurantTerminalEventStatus {
  INITIATED
  APPROVED
  DECLINED
  VOIDED
}

/// M5/C6: the capability set a provider declares and an operation exercises. The
/// MOCK provider implements all six.
enum RestaurantPaymentCapability {
  SALE
  AUTH
  CAPTURE
  ADJUST
  VOID
  REFUND
}

/// M5/C6: the normalized payment status the adapter maps every provider outcome
/// onto. Transitions run through the command layer (C3); a settled amount is
/// never rewritten.
enum RestaurantPaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  VOIDED
  REFUNDED
  PARTIALLY_REFUNDED
  DECLINED
  FAILED
}

/// M5/C7: a refund is a NEW record referencing the original tender. REFUND is a
/// post-capture return; VOID_REVERSAL reverses an uncaptured/same-day full
/// tender via the adapter VOID path.
enum RestaurantRefundKind {
  REFUND
  VOID_REVERSAL
}

/// M5/C8: a register drawer session is OPEN (one per register) or CLOSED
/// (counted cash + variance written once at close).
enum RestaurantDrawerSessionStatus {
  OPEN
  CLOSED
}

/// M5/C8: the append-only drawer ledger kinds. expectedCash is DERIVED by
/// folding these: opening float + cash sales − cash refunds + paid-ins −
/// paid-outs − drops.
enum RestaurantDrawerMovementKind {
  OPENING_FLOAT
  CASH_SALE
  CASH_REFUND
  PAID_IN
  PAID_OUT
  DROP
  CLOSING_COUNT
}

/// M5/C4/§11.2: a bill (check) cut from exactly one order. Totals are SNAPSHOT
/// columns frozen at bill-cut time from the order-item snapshots (tax/service
/// charge carry through structurally at zero until the tax milestone; discounts
/// are zero in M5). `splitKind` records how the order was divided;
/// `fractionNumerator`/`fractionDenominator` are set only for FRACTIONAL bills.
/// `roundingAdjustment` records this bill's share of the deterministic
/// largest-remainder remainder so Σ(grandTotal) ≡ the order derived total
/// exactly (C4). A settled bill receives its `receiptNumber` exactly once, from
/// the separate receipt seam (C10); uniqueness lives on a partial unique
/// (branchId, businessDate, receiptNumber) in the migration. Void records a
/// reason + co-authorization (C4). Opener operator + device attribute the cut.
model RestaurantBill {
  id                           String                  @id @default(cuid())
  organizationId               String                  @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  orderId                      String
  branchId                     String
  businessDate                 DateTime                @db.Date
  status                       RestaurantBillStatus    @default(OPEN)
  splitKind                    RestaurantBillSplitKind @default(NONE)
  fractionNumerator            Int?
  fractionDenominator          Int?
  subtotal                     Decimal                 @default(0) @db.Decimal(12, 2)
  taxTotal                     Decimal                 @default(0) @db.Decimal(12, 2)
  serviceChargeTotal           Decimal                 @default(0) @db.Decimal(12, 2)
  deliveryFeeTotal             Decimal                 @default(0) @db.Decimal(12, 2)
  serviceChargePolicyVersionId String?
  serviceChargeRate            Decimal?                @db.Decimal(9, 6)
  serviceChargeBasis           Decimal                 @default(0) @db.Decimal(12, 2)
  serviceChargeTaxTreatment    String?                 @db.VarChar(24)
  compTotal                    Decimal                 @default(0) @db.Decimal(12, 2)
  discountTotal                Decimal                 @default(0) @db.Decimal(12, 2)
  roundingAdjustment           Decimal                 @default(0) @db.Decimal(12, 2)
  grandTotal                   Decimal                 @default(0) @db.Decimal(12, 2)
  receiptNumber                Int?
  settledAt                    DateTime?
  voidReason                   String?
  voidCoAuthorizationId        String?
  openerStaffProfileId         String
  deviceId                     String
  createdAt                    DateTime                @default(now())
  updatedAt                    DateTime                @updatedAt

  order                      RestaurantOrder                       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  branch                     RestaurantBranch                      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  openerStaff                RestaurantStaffProfile                @relation(fields: [openerStaffProfileId], references: [id], onDelete: Restrict)
  device                     RestaurantRegisteredDevice            @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  voidCoAuthorization        RestaurantCoAuthorization?            @relation(fields: [voidCoAuthorizationId], references: [id], onDelete: SetNull)
  lines                      RestaurantBillLine[]
  payments                   RestaurantPayment[]
  tenders                    RestaurantTender[]
  refunds                    RestaurantRefund[]
  loyaltyPointsEntries       LoyaltyPointsEntry[]
  terminalReconciliations    RestaurantTerminalReconciliation[]
  taxTransactionSnapshots    RestaurantTaxTransactionSnapshot[]
  serviceChargePolicyVersion RestaurantServiceChargePolicyVersion? @relation(fields: [organizationId, serviceChargePolicyVersionId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([orderId])
  @@index([branchId])
  @@index([status])
  @@index([businessDate])
  @@map("restaurant_bills")
}

/// M5/C4: a bill line places ONE non-voided order item on ONE bill and SNAPSHOTS
/// its charge (name, unitPrice, quantity, line totals; tax/service-charge carry
/// through at zero). A comp retains the original `unitPrice`/`lineSubtotal` and
/// records `compAmount` (bringing the effective `lineTotal` to zero) with a
/// reason + co-authorization (C4). No DB unique on orderItemId: void-and-recut
/// leaves old lines behind; the command layer (L2) asserts the one-bill-per-item
/// partition across a bill set's OPEN bills.
model RestaurantBillLine {
  id                    String   @id @default(cuid())
  organizationId        String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  billId                String
  orderItemId           String
  name                  String
  quantity              Int      @default(1)
  unitPrice             Decimal  @db.Decimal(12, 2)
  lineSubtotal          Decimal  @db.Decimal(12, 2)
  taxAmount             Decimal  @default(0) @db.Decimal(12, 2)
  serviceChargeAmount   Decimal  @default(0) @db.Decimal(12, 2)
  compAmount            Decimal  @default(0) @db.Decimal(12, 2)
  lineTotal             Decimal  @db.Decimal(12, 2)
  compReason            String?
  compCoAuthorizationId String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  bill                RestaurantBill             @relation(fields: [billId], references: [id], onDelete: Cascade)
  orderItem           RestaurantOrderItem        @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  compCoAuthorization RestaurantCoAuthorization? @relation(fields: [compCoAuthorizationId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([billId])
  @@index([orderItemId])
  @@map("restaurant_bill_lines")
}

/// M5/C6: the adapter-side payment record for a CARD tender. `provider` is MOCK;
/// `capability` records which operation opened it; `status` is the normalized
/// outcome (transitions via the command layer). `tipAmount` is DISTINCT from any
/// service charge (C5). `providerRef` holds the provider's reference only — never
/// PAN/CVV/track data (C6). The event trail is append-only.
model RestaurantPayment {
  id             String                      @id @default(cuid())
  organizationId String                      @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  billId         String
  provider       RestaurantPaymentProvider   @default(MOCK)
  capability     RestaurantPaymentCapability
  status         RestaurantPaymentStatus     @default(PENDING)
  amount         Decimal                     @db.Decimal(12, 2)
  tipAmount      Decimal                     @default(0) @db.Decimal(12, 2)
  providerRef    String?
  staffProfileId String
  deviceId       String
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  bill                    RestaurantBill                     @relation(fields: [billId], references: [id], onDelete: Cascade)
  staff                   RestaurantStaffProfile             @relation(fields: [staffProfileId], references: [id], onDelete: Restrict)
  device                  RestaurantRegisteredDevice         @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  events                  RestaurantPaymentEvent[]
  tenders                 RestaurantTender[]
  refunds                 RestaurantRefund[]
  terminalReconciliations RestaurantTerminalReconciliation[]

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([billId])
  @@index([status])
  @@index([providerRef])
  @@map("restaurant_payments")
}

/// M5/C3/C6: the APPEND-ONLY payment event trail. Every adapter operation appends
/// one row (capability, eventType, optional amount, providerRef, sanitized
/// payload — never PAN/CVV/track data). No updatedAt; DB-enforced append-only
/// (SELECT+INSERT RLS only). Corrections are new events/records, never edits.
model RestaurantPaymentEvent {
  id             String                      @id @default(cuid())
  organizationId String                      @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  paymentId      String
  capability     RestaurantPaymentCapability
  eventType      String
  amount         Decimal?                    @db.Decimal(12, 2)
  providerRef    String?
  payload        Json
  createdAt      DateTime                    @default(now())

  payment RestaurantPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([paymentId])
  @@map("restaurant_payment_events")
}

/// M5/C3/§11.2: an APPEND-ONLY tender applied to a bill. CASH carries
/// `cashReceived`/`changeGiven` and a `drawerSessionId` (required-for-CASH at the
/// command layer) with a paired CASH_SALE drawer movement in the SAME
/// transaction; CARD carries a `paymentId` (required-for-CARD). `tipAmount` is
/// recorded here, distinct from service charges (C5). No updatedAt; DB-enforced
/// append-only. Business date + operator + device are stamped server-side.
model RestaurantTender {
  id              String               @id @default(cuid())
  organizationId  String               @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  billId          String
  type            RestaurantTenderType
  amount          Decimal              @db.Decimal(12, 2)
  tipAmount       Decimal              @default(0) @db.Decimal(12, 2)
  cashReceived    Decimal?             @db.Decimal(12, 2)
  changeGiven     Decimal?             @db.Decimal(12, 2)
  drawerSessionId String?
  paymentId       String?
  businessDate    DateTime             @db.Date
  staffProfileId  String
  deviceId        String
  createdAt       DateTime             @default(now())

  bill                    RestaurantBill                          @relation(fields: [billId], references: [id], onDelete: Cascade)
  drawerSession           RestaurantDrawerSession?                @relation(fields: [drawerSessionId], references: [id], onDelete: SetNull)
  payment                 RestaurantPayment?                      @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  staff                   RestaurantStaffProfile                  @relation(fields: [staffProfileId], references: [id], onDelete: Restrict)
  device                  RestaurantRegisteredDevice              @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  refunds                 RestaurantRefund[]
  drawerMovements         RestaurantDrawerMovement[]
  terminalReconciliations RestaurantTerminalReconciliation[]
  taxAllocations          RestaurantTaxTenderAllocationSnapshot[]

  @@unique([organizationId, id])
  @@unique([organizationId, id, type])
  @@unique([organizationId, billId, id, type])
  @@index([organizationId])
  @@index([billId])
  @@index([businessDate])
  @@index([drawerSessionId])
  @@index([paymentId])
  @@index([type])
  @@map("restaurant_tenders")
}

/// M5/C3/C7: an APPEND-ONLY refund referencing the original tender (and bill).
/// Requires a reason + manager co-authorization; the command layer caps
/// Σ(refunds) ≤ the tender amount. `businessDate` is the PROCESSING date — a
/// cross-business-date correction posts to the current day and NEVER mutates a
/// prior day's close (C7). Cash refunds carry a `drawerSessionId` + a CASH_REFUND
/// movement; card refunds carry a `paymentId`. No updatedAt; DB-enforced
/// append-only.
model RestaurantRefund {
  id                        String               @id @default(cuid())
  organizationId            String               @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  originalTenderId          String
  billId                    String
  amount                    Decimal              @db.Decimal(12, 2)
  tipRefundAmount           Decimal              @default(0) @db.Decimal(12, 2)
  serviceChargeRefundAmount Decimal              @default(0) @db.Decimal(12, 2)
  deliveryFeeRefundAmount   Decimal              @default(0) @db.Decimal(12, 2)
  taxRefundAmount           Decimal              @default(0) @db.Decimal(12, 2)
  kind                      RestaurantRefundKind
  businessDate              DateTime             @db.Date
  reason                    String
  coAuthorizationId         String
  drawerSessionId           String?
  paymentId                 String?
  staffProfileId            String
  deviceId                  String
  fullReversalSnapshotId    String?              @unique
  createdAt                 DateTime             @default(now())

  originalTender       RestaurantTender                  @relation(fields: [originalTenderId], references: [id], onDelete: Cascade)
  bill                 RestaurantBill                    @relation(fields: [billId], references: [id], onDelete: Cascade)
  coAuthorization      RestaurantCoAuthorization         @relation(fields: [coAuthorizationId], references: [id], onDelete: Restrict)
  drawerSession        RestaurantDrawerSession?          @relation(fields: [drawerSessionId], references: [id], onDelete: SetNull)
  payment              RestaurantPayment?                @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  staff                RestaurantStaffProfile            @relation(fields: [staffProfileId], references: [id], onDelete: Restrict)
  device               RestaurantRegisteredDevice        @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  drawerMovements      RestaurantDrawerMovement[]
  loyaltyPointsEntries LoyaltyPointsEntry[]
  taxAllocations       RestaurantTaxRefundAllocation[]
  fullReversalSnapshot RestaurantTaxTransactionSnapshot? @relation("TaxRefundFullReversal", fields: [organizationId, billId, fullReversalSnapshotId], references: [organizationId, billId, id], onDelete: Restrict, map: "restaurant_refund_full_reversal_snapshot_fkey")

  @@unique([organizationId, billId, originalTenderId, id])
  @@unique([organizationId, billId, fullReversalSnapshotId])
  @@index([organizationId])
  @@index([originalTenderId])
  @@index([billId])
  @@index([businessDate])
  @@index([drawerSessionId])
  @@index([paymentId])
  @@map("restaurant_refunds")
}

/// Immutable, branch-scoped v1 DINE_IN service-charge configuration. Published
/// intervals are migration-constrained not to overlap; tax treatment is frozen
/// to NON_TAXABLE by the database.
model RestaurantServiceChargePolicyVersion {
  id                 String    @id @default(cuid())
  organizationId     String    @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  branchId           String
  rate               Decimal   @db.Decimal(9, 6)
  effectiveFrom      DateTime
  effectiveTo        DateTime?
  acknowledgedAt     DateTime
  acknowledgementRef String
  idempotencyKey     String
  payloadHash        String
  endIdempotencyKey  String?
  endPayloadHash     String?
  createdAt          DateTime  @default(now())

  branch RestaurantBranch  @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)
  orders RestaurantOrder[]
  bills  RestaurantBill[]

  @@unique([organizationId, id], map: "restaurant_service_charge_policy_org_id_key")
  @@unique([organizationId, idempotencyKey], map: "restaurant_service_charge_policy_org_idem_key")
  @@unique([organizationId, endIdempotencyKey], map: "restaurant_service_charge_policy_org_end_idem_key")
  @@index([organizationId])
  @@index([branchId, effectiveFrom])
  @@map("restaurant_service_charge_policy_versions")
}

/// M5/C8: a register(device) × operator × business-date drawer session. At most
/// one OPEN session per register (partial unique in the migration). Opened with
/// an opening float (and an OPENING_FLOAT movement); `expectedCash` is DERIVED by
/// folding the movement ledger; close writes `countedCash`/`variance` once. This
/// row legitimately transitions OPEN→CLOSED, so it keeps UPDATE (it is NOT one of
/// the append-only ledgers) — but a settled/closed session's counts are written
/// exactly once by the command layer.
model RestaurantDrawerSession {
  id             String                        @id @default(cuid())
  organizationId String                        @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  branchId       String
  deviceId       String
  staffProfileId String
  businessDate   DateTime                      @db.Date
  status         RestaurantDrawerSessionStatus @default(OPEN)
  openedAt       DateTime                      @default(now())
  closedAt       DateTime?
  openingFloat   Decimal                       @db.Decimal(12, 2)
  expectedCash   Decimal?                      @db.Decimal(12, 2)
  countedCash    Decimal?                      @db.Decimal(12, 2)
  variance       Decimal?                      @db.Decimal(12, 2)
  createdAt      DateTime                      @default(now())
  updatedAt      DateTime                      @updatedAt

  branch    RestaurantBranch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  device    RestaurantRegisteredDevice @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  operator  RestaurantStaffProfile     @relation(fields: [staffProfileId], references: [id], onDelete: Restrict)
  movements RestaurantDrawerMovement[]
  tenders   RestaurantTender[]
  refunds   RestaurantRefund[]

  @@index([organizationId])
  @@index([branchId])
  @@index([deviceId])
  @@index([staffProfileId])
  @@index([businessDate])
  @@index([status])
  @@map("restaurant_drawer_sessions")
  @@index([organizationId, branchId, businessDate, id], map: "qa144_drawer_report_idx")
}

/// M5/C3/C8: the APPEND-ONLY drawer ledger. Every cash event writes exactly one
/// movement (OPENING_FLOAT/CASH_SALE/CASH_REFUND/PAID_IN/PAID_OUT/DROP/
/// CLOSING_COUNT); paid-in/out require a reason (+ cash:adjust). `amount` is a
/// non-negative magnitude — the fold in daily-close/drawer code applies the sign
/// by `kind`. Optional `tenderId`/`refundId` link the movement to the money
/// record that produced it. No updatedAt; DB-enforced append-only.
model RestaurantDrawerMovement {
  cateringMoneyEvidence CateringMoneyEvidence[]

  id              String                       @id @default(cuid())
  organizationId  String                       @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  drawerSessionId String
  kind            RestaurantDrawerMovementKind
  amount          Decimal                      @db.Decimal(12, 2)
  reason          String?
  tenderId        String?
  refundId        String?
  staffProfileId  String
  deviceId        String
  createdAt       DateTime                     @default(now())

  drawerSession RestaurantDrawerSession    @relation(fields: [drawerSessionId], references: [id], onDelete: Cascade)
  tender        RestaurantTender?          @relation(fields: [tenderId], references: [id], onDelete: SetNull)
  refund        RestaurantRefund?          @relation(fields: [refundId], references: [id], onDelete: SetNull)
  staff         RestaurantStaffProfile     @relation(fields: [staffProfileId], references: [id], onDelete: Restrict)
  device        RestaurantRegisteredDevice @relation(fields: [deviceId], references: [id], onDelete: Restrict)

  @@unique([organizationId, id], map: "catering_money_movement_scope_key")
  @@index([organizationId])
  @@index([drawerSessionId])
  @@index([tenderId])
  @@index([refundId])
  @@index([kind])
  @@map("restaurant_drawer_movements")
}

/// M5/C3/C9/§11.3: the IMMUTABLE daily close — a branch × businessDate snapshot
/// of gross/net sales, tax, service charge, tips, comps, discounts
/// (structurally-zero in M5), refunds, voids, and cash expectation/counted/
/// variance. Cutting requires every drawer session for the date CLOSED and every
/// bill SETTLED or VOID. Once cut the row is immutable (append-only,
/// SELECT+INSERT RLS only, no updatedAt). "Reopen"/correction = a NEW row with
/// `supersedesCloseId` + `correctionReason` + manager co-authorization; the chain
/// tip is authoritative in every read.
model RestaurantDailyClose {
  id                  String   @id @default(cuid())
  organizationId      String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  branchId            String
  businessDate        DateTime @db.Date
  supersedesCloseId   String?
  correctionReason    String?
  coAuthorizationId   String?
  cutByStaffProfileId String
  deviceId            String?
  grossSales          Decimal  @default(0) @db.Decimal(12, 2)
  netSales            Decimal  @default(0) @db.Decimal(12, 2)
  deliveryFeeSales    Decimal  @default(0) @db.Decimal(12, 2)
  deliveryFeeRefunds  Decimal  @default(0) @db.Decimal(12, 2)
  taxTotal            Decimal  @default(0) @db.Decimal(12, 2)
  serviceChargeTotal  Decimal  @default(0) @db.Decimal(12, 2)
  tipTotal            Decimal  @default(0) @db.Decimal(12, 2)
  compTotal           Decimal  @default(0) @db.Decimal(12, 2)
  discountTotal       Decimal  @default(0) @db.Decimal(12, 2)
  refundTotal         Decimal  @default(0) @db.Decimal(12, 2)
  voidTotal           Decimal  @default(0) @db.Decimal(12, 2)
  cashExpected        Decimal  @default(0) @db.Decimal(12, 2)
  cashCounted         Decimal  @default(0) @db.Decimal(12, 2)
  cashVariance        Decimal  @default(0) @db.Decimal(12, 2)
  createdAt           DateTime @default(now())

  branch                RestaurantBranch                  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  supersedesClose       RestaurantDailyClose?             @relation("DailyCloseSupersede", fields: [supersedesCloseId], references: [id], onDelete: SetNull)
  supersededBy          RestaurantDailyClose[]            @relation("DailyCloseSupersede")
  coAuthorization       RestaurantCoAuthorization?        @relation(fields: [coAuthorizationId], references: [id], onDelete: SetNull)
  cutByStaff            RestaurantStaffProfile            @relation(fields: [cutByStaffProfileId], references: [id], onDelete: Restrict)
  device                RestaurantRegisteredDevice?       @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  tenderTotals          RestaurantDailyCloseTenderTotal[]
  insightDailyRollups   InsightDailyRollup[]
  insightItemMixRollups InsightItemMixRollup[]

  @@index([organizationId])
  @@index([branchId])
  @@index([businessDate])
  @@index([supersedesCloseId])
  @@map("restaurant_daily_closes")
  @@index([organizationId, branchId, businessDate, createdAt, id], map: "qa144_close_report_idx")
}

/// M5/C3/C9: the APPEND-ONLY per-tender-type child of a daily close (amount,
/// tips, count per CASH/CARD/OTHER). No updatedAt; DB-enforced append-only.
model RestaurantDailyCloseTenderTotal {
  id             String               @id @default(cuid())
  organizationId String               @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  dailyCloseId   String
  tenderType     RestaurantTenderType
  amount         Decimal              @default(0) @db.Decimal(12, 2)
  tipAmount      Decimal              @default(0) @db.Decimal(12, 2)
  count          Int                  @default(0)
  createdAt      DateTime             @default(now())

  dailyClose RestaurantDailyClose @relation(fields: [dailyCloseId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([dailyCloseId])
  @@map("restaurant_daily_close_tender_totals")
}

/// M5/C10/§11.1: the per-(branch, businessDate) receipt-number sequence — a seam
/// SEPARATE from restaurant_order_number_sequences. `nextNumber` holds the most
/// recently allocated receipt number; allocation is a transactional row-locked
/// upsert (see src/lib/restaurant/receipt-numbers.ts). Uniqueness + monotonicity
/// are guaranteed; gap-free is NOT promised; non-fiscal (BUILD-ASSUMPTIONS).
model RestaurantReceiptNumberSequence {
  id             String   @id @default(cuid())
  organizationId String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  branchId       String
  businessDate   DateTime @db.Date
  nextNumber     Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  branch RestaurantBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, businessDate])
  @@index([organizationId])
  @@index([branchId])
  @@map("restaurant_receipt_number_sequences")
}

/// M5/C11: a device-scoped idempotency key for money commands — a SEPARATE replay
/// domain from restaurant_order_idempotency_keys. The first occurrence records
/// the commandType + resultRef; any replay of the same (deviceId, key) returns
/// that original result and creates nothing. Unique (deviceId, key).
model RestaurantMoneyIdempotencyKey {
  id                   String    @id @default(cuid())
  organizationId       String    @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  deviceId             String
  key                  String
  commandType          String
  resultRef            String?
  canonicalPayloadHash String?
  resultPayload        Json?
  completedAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  device RestaurantRegisteredDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, key])
  @@index([organizationId])
  @@index([deviceId])
  @@map("restaurant_money_idempotency_keys")
}

// ===========================================================================
// M6 — Inventory & purchasing (restaurant/m6-inventory-purchasing). Every model
// below is org-scoped under forced RLS (C1) with a bare, RLS-guarded
// organizationId that defaults from the transaction-local setting. Quantities
// and costs are Decimal (never float). The single source of stock truth is the
// APPEND-ONLY movement ledger (RestaurantStockMovement, DB-enforced SELECT+INSERT
// RLS only); NO model carries a mutable on-hand balance column — balances are
// DERIVED by folding the ledger (D07). Costing is read-time weighted-average from
// intrinsic-cost movements; negative derived stock is permitted and flagged, not
// blocked at posting (D07 conservative defaults — BUILD-ASSUMPTIONS §M6).
// ===========================================================================

/// M6/§11.4: the ten canonical stock-movement reasons — the CLOSED set of ways a
/// signed quantity enters or leaves a (stockItem, location). Intrinsic-cost
/// movements (PURCHASE_RECEIPT, SUPPLIER_RETURN) carry a `unitCost` that feeds the
/// read-time weighted-average cost; the rest carry none (D07). RECIPE_CONSUMPTION
/// posts transactionally at order close; SALE_REVERSAL covers post-close
/// corrections.
enum RestaurantStockMovementReason {
  PURCHASE_RECEIPT
  RECIPE_CONSUMPTION
  SALE_REVERSAL
  TRANSFER
  PHYSICAL_COUNT_ADJUSTMENT
  WASTAGE
  SPOILAGE
  STAFF_MEAL
  SUPPLIER_RETURN
  MANUAL_CORRECTION
}

/// M6/§11.4: a physical stock count's lifecycle. DRAFT accumulates counted lines;
/// SUBMITTED freezes the counted quantities + derived snapshot; POSTED writes the
/// PHYSICAL_COUNT_ADJUSTMENT movements that reconcile derived to counted.
enum RestaurantStockCountStatus {
  DRAFT
  SUBMITTED
  POSTED
}

/// M6/§6.4: an inter-location stock transfer's lifecycle. DRAFT accumulates lines;
/// DISPATCHED posts the out-of-source TRANSFER movements; RECEIVED posts the
/// into-destination TRANSFER movements; CANCELLED abandons a DRAFT.
enum RestaurantStockTransferStatus {
  DRAFT
  DISPATCHED
  RECEIVED
  CANCELLED
}

/// M6/§6.5/§11.4: a purchase order's lifecycle. DRAFT while edited, SUBMITTED for
/// approval, APPROVED to order, PARTIALLY_RECEIVED / RECEIVED as goods arrive,
/// CLOSED when done, or CANCELLED. Received quantity is DERIVED from receipt
/// lines — never stored as a mutable column on the line.
enum RestaurantPurchaseOrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PARTIALLY_RECEIVED
  RECEIVED
  CLOSED
  CANCELLED
}

/// M6/§6.5: a goods-receiving discrepancy category. SHORTAGE/OVERAGE record a
/// received-vs-expected quantity mismatch; DAMAGED/EXPIRED/REJECTED record
/// unusable goods; OTHER + a note is the escape hatch. The signed correction to
/// stock is always a movement, never a mutation of this evidence row.
enum RestaurantReceivingDiscrepancyKind {
  SHORTAGE
  OVERAGE
  DAMAGED
  EXPIRED
  REJECTED
  OTHER
}

/// M6/§6.4: a physical stock-holding location inside a branch (kitchen line, dry
/// store, walk-in, bar…). Branch-scoped (§8 "transfers within the branch");
/// balances are derived per (stockItem, location) from the movement ledger. The
/// `inventory.stockLocations.max` limit key lives in vertical-catalog (untouched).
model RestaurantStockLocation {
  id             String   @id @default(cuid())
  organizationId String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  branchId       String
  name           String
  code           String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  branch           RestaurantBranch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  movements        RestaurantStockMovement[]
  lowStockRules    RestaurantLowStockRule[]
  counts           RestaurantStockCount[]
  transfersFrom    RestaurantStockTransfer[]   @relation("StockTransferSource")
  transfersTo      RestaurantStockTransfer[]   @relation("StockTransferDestination")
  purchaseOrders   RestaurantPurchaseOrder[]
  purchaseReceipts RestaurantPurchaseReceipt[]

  @@index([organizationId])
  @@index([branchId])
  @@map("restaurant_stock_locations")
}

/// M6/§6.4: the stockable identity of a catalog ingredient (M3 seam) — one per
/// ingredient. `canonicalUnitId` is the unit every movement quantity is stored in
/// (ordering/receiving units are converted to it by the L1 ledger primitive).
/// `trackBatches` toggles the optional batch/lot seam (D07 — recordable, never
/// enforced). NO on-hand balance column: balances are derived from the ledger.
model RestaurantStockItem {
  id              String   @id @default(cuid())
  organizationId  String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  ingredientId    String   @unique
  canonicalUnitId String
  isActive        Boolean  @default(true)
  trackBatches    Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  ingredient           RestaurantIngredient             @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  canonicalUnit        RestaurantUnit                   @relation(fields: [canonicalUnitId], references: [id], onDelete: Restrict)
  movements            RestaurantStockMovement[]
  batches              RestaurantStockBatch[]
  countLines           RestaurantStockCountLine[]
  transferLines        RestaurantStockTransferLine[]
  lowStockRules        RestaurantLowStockRule[]
  purchaseOrderLines   RestaurantPurchaseOrderLine[]
  purchaseReceiptLines RestaurantPurchaseReceiptLine[]
  discrepancies        RestaurantReceivingDiscrepancy[]

  @@index([organizationId])
  @@index([canonicalUnitId])
  @@map("restaurant_stock_items")
}

/// M6/§11.4: the APPEND-ONLY stock movement ledger — the SINGLE source of stock
/// truth. Every row is a signed `quantity` (canonical unit; positive = in,
/// negative = out) at a (stockItem, location) for one of the ten reasons.
/// Intrinsic-cost movements carry `unitCost` (weighted-average cost is derived at
/// read time; D07). `occurredAt` is the economic time (backdatable); `recordedAt`
/// is the immutable system record time. Nullable refs tie a movement to the
/// order/receipt/transfer/count/batch that produced it. Actor attribution is
/// best-effort (nullable) — system postings (recipe consumption at order close)
/// carry the order's operator when known. No updatedAt; DB-enforced append-only
/// (SELECT+INSERT RLS only) — a correction is a NEW movement, never an edit.
model RestaurantStockMovement {
  cateringResultDispositions RestaurantCateringDisposition[] @relation("CateringDispositionResult")

  cateringSourceDispositions RestaurantCateringDisposition[] @relation("CateringDispositionSource")

  id             String                        @id @default(cuid())
  organizationId String                        @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  stockItemId    String
  locationId     String
  reason         RestaurantStockMovementReason
  quantity       Decimal                       @db.Decimal(18, 6)
  unitCost       Decimal?                      @db.Decimal(18, 6)
  occurredAt     DateTime                      @default(now())
  recordedAt     DateTime                      @default(now())
  orderId        String?
  receiptId      String?
  transferId     String?
  countId        String?
  batchId        String?
  staffProfileId String?
  deviceId       String?

  stockItem RestaurantStockItem         @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  location  RestaurantStockLocation     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  order     RestaurantOrder?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  receipt   RestaurantPurchaseReceipt?  @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  transfer  RestaurantStockTransfer?    @relation(fields: [transferId], references: [id], onDelete: SetNull)
  count     RestaurantStockCount?       @relation(fields: [countId], references: [id], onDelete: SetNull)
  batch     RestaurantStockBatch?       @relation(fields: [batchId], references: [id], onDelete: SetNull)
  staff     RestaurantStaffProfile?     @relation(fields: [staffProfileId], references: [id], onDelete: SetNull)
  device    RestaurantRegisteredDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([stockItemId, locationId])
  @@index([locationId])
  @@index([reason])
  @@index([occurredAt])
  @@index([locationId, occurredAt, stockItemId], map: "restaurant_stock_movements_location_occurred_item_idx")
  @@index([reason, occurredAt, locationId], map: "restaurant_stock_movements_reason_occurred_location_idx")
  @@index([orderId])
  @@index([receiptId])
  @@index([transferId])
  @@index([countId])
  @@index([batchId])
  @@map("restaurant_stock_movements")
}

/// M6/§6.4/D07: an optional batch/lot recorded at receiving (`code`, expiry) and
/// referenced by movements. Seam only — recordable, never enforced (no expiry
/// gating, no FEFO). One code per stock item.
model RestaurantStockBatch {
  id             String    @id @default(cuid())
  organizationId String    @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  stockItemId    String
  receiptId      String?
  code           String
  expiryDate     DateTime? @db.Date
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  stockItem    RestaurantStockItem             @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  receipt      RestaurantPurchaseReceipt?      @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  movements    RestaurantStockMovement[]
  receiptLines RestaurantPurchaseReceiptLine[]

  @@unique([stockItemId, code])
  @@index([organizationId])
  @@index([stockItemId])
  @@index([receiptId])
  @@map("restaurant_stock_batches")
}

/// M6/§6.4/§11.4: a physical stock count at a location. DRAFT→SUBMITTED→POSTED;
/// posting writes the reconciling PHYSICAL_COUNT_ADJUSTMENT movements. Counted vs
/// derived and the variance live on the lines (a frozen snapshot, not a live
/// balance).
model RestaurantStockCount {
  id             String                     @id @default(cuid())
  organizationId String                     @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  locationId     String
  status         RestaurantStockCountStatus @default(DRAFT)
  reference      String?
  countedAt      DateTime?
  submittedAt    DateTime?
  postedAt       DateTime?
  staffProfileId String?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  location  RestaurantStockLocation    @relation(fields: [locationId], references: [id], onDelete: Cascade)
  staff     RestaurantStaffProfile?    @relation(fields: [staffProfileId], references: [id], onDelete: SetNull)
  lines     RestaurantStockCountLine[]
  movements RestaurantStockMovement[]

  @@index([organizationId])
  @@index([locationId])
  @@index([status])
  @@map("restaurant_stock_counts")
}

/// M6/§11.4: one counted line of a stock count. `countedQuantity` is physically
/// counted; `snapshotQuantity` is the derived on-hand FROZEN at submit time (the
/// counted-vs-derived pairing); `varianceQuantity` = counted − snapshot. All are
/// immutable snapshots (evidence), never a live balance. One line per stock item.
model RestaurantStockCountLine {
  id               String   @id @default(cuid())
  organizationId   String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  stockCountId     String
  stockItemId      String
  countedQuantity  Decimal  @db.Decimal(18, 6)
  snapshotQuantity Decimal  @db.Decimal(18, 6)
  varianceQuantity Decimal  @db.Decimal(18, 6)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  stockCount RestaurantStockCount @relation(fields: [stockCountId], references: [id], onDelete: Cascade)
  stockItem  RestaurantStockItem  @relation(fields: [stockItemId], references: [id], onDelete: Restrict)

  @@unique([stockCountId, stockItemId])
  @@index([organizationId])
  @@index([stockCountId])
  @@index([stockItemId])
  @@map("restaurant_stock_count_lines")
}

/// M6/§6.4: an inter-location stock transfer within a branch. DRAFT→DISPATCHED→
/// RECEIVED (or CANCELLED). Dispatch posts negative TRANSFER movements at the
/// source; receipt posts positive TRANSFER movements at the destination. Source
/// and destination must differ (DB CHECK).
model RestaurantStockTransfer {
  id                    String                        @id @default(cuid())
  organizationId        String                        @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  sourceLocationId      String
  destinationLocationId String
  status                RestaurantStockTransferStatus @default(DRAFT)
  reference             String?
  dispatchedAt          DateTime?
  receivedAt            DateTime?
  staffProfileId        String?
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt

  sourceLocation      RestaurantStockLocation       @relation("StockTransferSource", fields: [sourceLocationId], references: [id], onDelete: Cascade)
  destinationLocation RestaurantStockLocation       @relation("StockTransferDestination", fields: [destinationLocationId], references: [id], onDelete: Cascade)
  staff               RestaurantStaffProfile?       @relation(fields: [staffProfileId], references: [id], onDelete: SetNull)
  lines               RestaurantStockTransferLine[]
  movements           RestaurantStockMovement[]

  @@index([organizationId])
  @@index([sourceLocationId])
  @@index([destinationLocationId])
  @@index([status])
  @@map("restaurant_stock_transfers")
}

/// M6/§6.4: one line of a stock transfer — a positive `quantity` (canonical unit)
/// of a stock item to move. The signed source/destination movements are derived
/// from this at dispatch/receipt.
model RestaurantStockTransferLine {
  id              String   @id @default(cuid())
  organizationId  String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  stockTransferId String
  stockItemId     String
  quantity        Decimal  @db.Decimal(18, 6)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  stockTransfer RestaurantStockTransfer @relation(fields: [stockTransferId], references: [id], onDelete: Cascade)
  stockItem     RestaurantStockItem     @relation(fields: [stockItemId], references: [id], onDelete: Restrict)

  @@unique([stockTransferId, stockItemId])
  @@index([organizationId])
  @@index([stockTransferId])
  @@index([stockItemId])
  @@map("restaurant_stock_transfer_lines")
}

/// M6/§6.4: a low-stock threshold for a (stockItem, location). When the derived
/// on-hand falls below `threshold` (canonical unit) the item is surfaced as
/// low/reorder in reads. One rule per (item, location).
model RestaurantLowStockRule {
  id             String   @id @default(cuid())
  organizationId String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  stockItemId    String
  locationId     String
  threshold      Decimal  @db.Decimal(18, 6)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  stockItem RestaurantStockItem     @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  location  RestaurantStockLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([stockItemId, locationId])
  @@index([organizationId])
  @@index([stockItemId])
  @@index([locationId])
  @@map("restaurant_low_stock_rules")
}

/// M6/§6.5: a purchasing supplier — the identity POs and receipts reference.
/// Contacts/item-mappings/price-history are downstream seams. Supplier payment
/// execution stays in Finance (§6.5) — no accounts-payable ledger here.
model RestaurantSupplier {
  id             String   @id @default(cuid())
  organizationId String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  name           String
  code           String?
  contactName    String?
  contactEmail   String?
  contactPhone   String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  purchaseOrders   RestaurantPurchaseOrder[]
  purchaseReceipts RestaurantPurchaseReceipt[]

  @@index([organizationId])
  @@map("restaurant_suppliers")
}

/// M6/§6.5/§11.4: a purchase order to a supplier, delivered to a branch, with the
/// §11.4 lifecycle. Received quantity is DERIVED from receipt lines — never a
/// mutable column. `locationId` is the default receiving-location seam.
model RestaurantPurchaseOrder {
  id                       String                        @id @default(cuid())
  organizationId           String                        @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  supplierId               String
  branchId                 String
  locationId               String?
  status                   RestaurantPurchaseOrderStatus @default(DRAFT)
  reference                String?
  expectedDate             DateTime?                     @db.Date
  submittedAt              DateTime?
  approvedAt               DateTime?
  closedAt                 DateTime?
  cancelledAt              DateTime?
  createdByStaffProfileId  String?
  approvedByStaffProfileId String?
  createdAt                DateTime                      @default(now())
  updatedAt                DateTime                      @updatedAt

  supplier        RestaurantSupplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  branch          RestaurantBranch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  location        RestaurantStockLocation?      @relation(fields: [locationId], references: [id], onDelete: SetNull)
  createdByStaff  RestaurantStaffProfile?       @relation("PurchaseOrderCreatedBy", fields: [createdByStaffProfileId], references: [id], onDelete: SetNull)
  approvedByStaff RestaurantStaffProfile?       @relation("PurchaseOrderApprovedBy", fields: [approvedByStaffProfileId], references: [id], onDelete: SetNull)
  lines           RestaurantPurchaseOrderLine[]
  receipts        RestaurantPurchaseReceipt[]

  @@index([organizationId])
  @@index([supplierId])
  @@index([branchId])
  @@index([locationId])
  @@index([status])
  @@map("restaurant_purchase_orders")
}

/// M6/§6.5: one ordered line of a purchase order — `orderedQuantity` in `unit`
/// (converted to the item's canonical unit at receipt) at an expected `unitCost`.
/// Received quantity is DERIVED from the receipt lines that reference this line.
model RestaurantPurchaseOrderLine {
  id              String   @id @default(cuid())
  organizationId  String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  purchaseOrderId String
  stockItemId     String
  orderedQuantity Decimal  @db.Decimal(18, 6)
  unitId          String
  unitCost        Decimal  @db.Decimal(18, 6)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  purchaseOrder RestaurantPurchaseOrder         @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  stockItem     RestaurantStockItem             @relation(fields: [stockItemId], references: [id], onDelete: Restrict)
  unit          RestaurantUnit                  @relation(fields: [unitId], references: [id], onDelete: Restrict)
  receiptLines  RestaurantPurchaseReceiptLine[]

  @@index([organizationId])
  @@index([purchaseOrderId])
  @@index([stockItemId])
  @@index([unitId])
  @@map("restaurant_purchase_order_lines")
}

/// M6/§6.5: a goods-receiving event (against a PO or ad-hoc) into a location. Its
/// lines drive the PURCHASE_RECEIPT movements (carrying `unitCost` → weighted-
/// average cost) in one transaction; discrepancies and batches hang off it.
/// Receiving retries are idempotent via RestaurantInventoryIdempotencyKey.
model RestaurantPurchaseReceipt {
  id              String   @id @default(cuid())
  organizationId  String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  purchaseOrderId String?
  supplierId      String
  branchId        String
  locationId      String
  reference       String?
  receivedAt      DateTime @default(now())
  staffProfileId  String?
  deviceId        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  purchaseOrder RestaurantPurchaseOrder?         @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  supplier      RestaurantSupplier               @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  branch        RestaurantBranch                 @relation(fields: [branchId], references: [id], onDelete: Cascade)
  location      RestaurantStockLocation          @relation(fields: [locationId], references: [id], onDelete: Restrict)
  staff         RestaurantStaffProfile?          @relation(fields: [staffProfileId], references: [id], onDelete: SetNull)
  device        RestaurantRegisteredDevice?      @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  lines         RestaurantPurchaseReceiptLine[]
  movements     RestaurantStockMovement[]
  batches       RestaurantStockBatch[]
  discrepancies RestaurantReceivingDiscrepancy[]

  @@index([organizationId])
  @@index([purchaseOrderId])
  @@index([supplierId])
  @@index([branchId])
  @@index([locationId])
  @@map("restaurant_purchase_receipts")
}

/// M6/§6.5: one received line — `receivedQuantity` in `unit` at the actual
/// `unitCost` (the intrinsic cost that feeds weighted-average costing via the
/// PURCHASE_RECEIPT movement). Optionally links its PO line and a batch.
model RestaurantPurchaseReceiptLine {
  id                  String   @id @default(cuid())
  organizationId      String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  purchaseReceiptId   String
  purchaseOrderLineId String?
  stockItemId         String
  receivedQuantity    Decimal  @db.Decimal(18, 6)
  unitId              String
  unitCost            Decimal  @db.Decimal(18, 6)
  batchId             String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  purchaseReceipt   RestaurantPurchaseReceipt        @relation(fields: [purchaseReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderLine RestaurantPurchaseOrderLine?     @relation(fields: [purchaseOrderLineId], references: [id], onDelete: SetNull)
  stockItem         RestaurantStockItem              @relation(fields: [stockItemId], references: [id], onDelete: Restrict)
  unit              RestaurantUnit                   @relation(fields: [unitId], references: [id], onDelete: Restrict)
  batch             RestaurantStockBatch?            @relation(fields: [batchId], references: [id], onDelete: SetNull)
  discrepancies     RestaurantReceivingDiscrepancy[]

  @@index([organizationId])
  @@index([purchaseReceiptId])
  @@index([purchaseOrderLineId])
  @@index([stockItemId])
  @@index([unitId])
  @@index([batchId])
  @@map("restaurant_purchase_receipt_lines")
}

/// M6/§6.5: a goods-receiving discrepancy (shortage/overage/damaged/…) recorded
/// against a receipt (and optionally a line). Evidence only — the signed stock
/// correction is always a movement, never a mutation of this row.
model RestaurantReceivingDiscrepancy {
  id                    String                             @id @default(cuid())
  organizationId        String                             @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  purchaseReceiptId     String
  purchaseReceiptLineId String?
  stockItemId           String
  kind                  RestaurantReceivingDiscrepancyKind
  expectedQuantity      Decimal                            @db.Decimal(18, 6)
  receivedQuantity      Decimal                            @db.Decimal(18, 6)
  note                  String?
  createdAt             DateTime                           @default(now())
  updatedAt             DateTime                           @updatedAt

  purchaseReceipt     RestaurantPurchaseReceipt      @relation(fields: [purchaseReceiptId], references: [id], onDelete: Cascade)
  purchaseReceiptLine RestaurantPurchaseReceiptLine? @relation(fields: [purchaseReceiptLineId], references: [id], onDelete: SetNull)
  stockItem           RestaurantStockItem            @relation(fields: [stockItemId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([purchaseReceiptId])
  @@index([purchaseReceiptLineId])
  @@index([stockItemId])
  @@map("restaurant_receiving_discrepancies")
}

/// M6/§11.4: an idempotency key for inventory/purchasing commands (receiving,
/// transfers, count posting, adjustments) — the M5 money-key pattern applied to a
/// SEPARATE replay domain. Org-scoped (not device-scoped): inventory commands
/// include back-office flows with no device. A replay of the same (org, key)
/// returns the original result and creates nothing. Unique (organizationId, key).
model RestaurantInventoryIdempotencyKey {
  id             String   @id @default(cuid())
  organizationId String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  key            String
  commandType    String
  resultRef      String?
  deviceId       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  device RestaurantRegisteredDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@unique([organizationId, key])
  @@index([organizationId])
  @@index([deviceId])
  @@map("restaurant_inventory_idempotency_keys")
}

// ===========================================================================
// M7-L1 — Scheduler primitive, SOP compliance engine, and notifications for the
// Restaurant vertical (restaurant/m7-scheduler-sop-notifications).
//
// Binding design constraints realised in this model set:
//   C1  Every table is org-scoped (a bare, RLS-guarded organizationId defaulting
//       from the transaction-local setting) and gets forced org RLS in the
//       migration. No pre-M7 table is altered except additive back-relations.
//   C-append-only  Five tables are DB-enforced APPEND-ONLY (SELECT+INSERT RLS
//       policies only, no UPDATE/DELETE) — RestaurantJobExecution,
//       RestaurantSopEvidence, RestaurantSopVerification,
//       RestaurantSopEscalationEvent, RestaurantNotificationDelivery. A
//       correction is a NEW row, never an edit (the M5/M6 ledger pattern).
//   C-scheduler   RestaurantJob is the org-scoped durable work queue; the
//       scheduler primitive (src/lib/restaurant/scheduler.ts) claims due jobs
//       with FOR UPDATE SKIP LOCKED and appends one immutable
//       RestaurantJobExecution per attempt. Bounded retries with backoff move a
//       terminally-failing job to DEAD (D13).
//   UTC   Every timestamp is stored UTC; branch-local rendering (SOP due windows,
//       quiet hours) is derived at read time from the branch timezone
//       (business-date.ts) — never recomputed from a stored local value.
// ===========================================================================

/// M7/D13: a durable background job's lifecycle. QUEUED is claimable when due;
/// RUNNING is claimed by a worker; SUCCEEDED is a completed attempt; FAILED is a
/// permanent (handler-declared, non-retryable) failure; DEAD is the terminal
/// state once maxAttempts bounded retries are exhausted.
enum RestaurantJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  DEAD
}

/// M7/D13: the immutable outcome of ONE job attempt in the append-only execution
/// history. SUCCEEDED/FAILED describe that single attempt, not the job.
enum RestaurantJobExecutionOutcome {
  SUCCEEDED
  FAILED
}

/// M7/D21: verification state of an inbound webhook payload. PENDING until the
/// signature is checked; VERIFIED once the source signature validates; FAILED
/// when it does not (the payload is retained for audit, never processed).
enum RestaurantWebhookVerificationStatus {
  PENDING
  VERIFIED
  FAILED
}

/// M7/D21: processing state of an inbound webhook envelope, independent of its
/// signature verification. Dedup is by (organization, source, externalEventId).
enum RestaurantWebhookInboxStatus {
  PENDING
  PROCESSED
  FAILED
  DISCARDED
}

/// M7/§11.5: an SOP template VERSION's lifecycle. DRAFT is editable; PUBLISHED is
/// immutable and the only version an assignment may pin; RETIRED is withdrawn
/// from new assignments but retained (occurrences that pinned it stay readable).
enum RestaurantSopTemplateStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

/// M7/§11.5: the EXACTLY eight occurrence states. SCHEDULED (generated, not yet
/// worked); IN_PROGRESS (an operator began); SUBMITTED (completed, awaiting
/// verification); VERIFIED / REJECTED (a verifier's decision); LATE (submitted
/// past the due window); MISSED (window elapsed with no submission); WAIVED.
enum RestaurantSopOccurrenceStatus {
  SCHEDULED
  IN_PROGRESS
  SUBMITTED
  VERIFIED
  REJECTED
  LATE
  MISSED
  WAIVED
}

/// M7/§11.5: a verifier's decision on a submitted occurrence. VERIFY accepts;
/// REJECT sends it back; WAIVE excuses it. A sensitive decision may pin an M2
/// co-authorization record (co-auth field) — additive, never enforced at L1.
enum RestaurantSopVerificationAction {
  VERIFY
  REJECT
  WAIVE
}

/// M7/§11.5: how an assignment recurs. ONCE is a single dated occurrence; DAILY /
/// WEEKLY / MONTHLY generate occurrences on a branch-local schedule. DST is
/// handled by generating against the branch wall-clock, never a fixed UTC offset.
enum RestaurantSopRecurrenceFrequency {
  ONCE
  DAILY
  WEEKLY
  MONTHLY
  INTERVAL
}

/// SOP-1: how an assignment names WHO owes the work. PERSON pins one named staff
/// profile (`assigneeStaffProfileId`) and every generated occurrence is assigned
/// directly. ROLE pins one job role (`assigneeJobRoleId`) and every generated
/// occurrence becomes an unclaimed, branch-scoped POOL item any eligible holder
/// of that role may claim. A CHECK constraint in the migration enforces that
/// exactly the matching column is set, so the two modes never overlap on one
/// assignment row. The modes coexist ACROSS assignments: the same template may
/// carry a ROLE assignment and a PERSON assignment on the same branch, and the
/// per-staff resolver unions and de-duplicates the two paths.
enum RestaurantSopAssigneeTargetType {
  PERSON
  ROLE
}

/// SOP-1: an audited job-role membership change. GRANTED adds a (staff, role,
/// branch) holding; REVOKED removes it. Both are appended to an append-only
/// trail so an immediately-effective multi-select edit stays reconstructible
/// after the membership row itself is gone.
enum RestaurantStaffJobRoleChangeKind {
  GRANTED
  REVOKED
}

/// B1/WHA-285: the direction of a per-person capability override. ALLOW adds a
/// capability the person's roles did not grant; DENY removes one they did — for
/// that person only, leaving the role untouched. DENY is evaluated LAST, so it
/// beats both the role union and any direct ALLOW.
enum RestaurantStaffCapabilityEffect {
  ALLOW
  DENY
}

/// B1/WHA-285: an audited per-person capability-override change. ALLOWED and
/// DENIED name the effect the override was set to; CLEARED means the override
/// itself was removed and the person fell back to what their roles grant.
enum RestaurantStaffCapabilityAuditKind {
  ALLOWED
  DENIED
  CLEARED
}

/// M7/§11.5: the scope an escalation policy applies to. ORG applies org-wide;
/// BRANCH narrows to one branch (branchId set).
enum RestaurantSopEscalationScope {
  ORG
  BRANCH
}

/// M7/§11.5: an append-only escalation-event kind. FIRED when a step triggers;
/// ACKNOWLEDGED when a recipient responds; STOPPED when a stop condition ends the
/// chain. Each is an immutable record; the current state is folded from events.
enum RestaurantSopEscalationEventKind {
  FIRED
  ACKNOWLEDGED
  STOPPED
}

/// M7/D21: notification delivery channels. IN_APP is real; EMAIL / SMS / PUSH /
/// WHATSAPP are STUBBED adapters in M7 (recorded, never actually sent).
enum RestaurantNotificationChannel {
  IN_APP
  WEBHOOK
  EMAIL
  SMS
  PUSH
  WHATSAPP
}

/// M7/D21: the append-only outcome of one delivery attempt on one channel.
/// DELIVERED_IN_APP is the real in-app delivery; STUBBED records a non-in-app
/// channel whose adapter is a stub; FAILED records an attempt that errored.
enum RestaurantNotificationDeliveryStatus {
  DELIVERED_IN_APP
  DELIVERED_WEBHOOK
  STUBBED
  FAILED
}

/// M7/D13: the org-scoped durable work queue. A job is claimed when QUEUED and
/// `nextAttemptAt <= now` via FOR UPDATE SKIP LOCKED; the scheduler primitive
/// increments `attempts`, stamps `claimedAt`/`claimedBy`, and appends one
/// immutable execution row per attempt. `idempotencyKey` deduplicates enqueues
/// within the organization (a null key is never deduplicated). `payload` is an
/// opaque handler input; the handler type is a plain string resolved through the
/// job-handlers registry so later lanes register independently.
model RestaurantJob {
  id             String              @id @default(cuid())
  organizationId String              @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  type           String
  payload        Json                @default("{}")
  status         RestaurantJobStatus @default(QUEUED)
  attempts       Int                 @default(0)
  maxAttempts    Int                 @default(5)
  scheduledAt    DateTime            @default(now())
  nextAttemptAt  DateTime            @default(now())
  claimedAt      DateTime?
  claimedBy      String?
  lastError      String?
  idempotencyKey String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  executions RestaurantJobExecution[]

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId])
  @@index([status, nextAttemptAt])
  @@map("restaurant_jobs")
}

/// M7/D13: the APPEND-ONLY execution history of the job queue — one immutable row
/// per attempt (DB-enforced SELECT+INSERT RLS; no updatedAt). `workerId` is the
/// claimer that ran the attempt; `outcome` is that attempt's result. Exact
/// counts of these rows are the concurrency battery's exactly-once evidence.
model RestaurantJobExecution {
  id             String                        @id @default(cuid())
  organizationId String                        @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  jobId          String
  workerId       String
  attempt        Int
  startedAt      DateTime
  finishedAt     DateTime
  outcome        RestaurantJobExecutionOutcome
  error          String?
  createdAt      DateTime                      @default(now())

  job RestaurantJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([jobId])
  @@map("restaurant_job_executions")
}

/// M7/D21: an inbound webhook envelope, deduplicated by (organization, source,
/// externalEventId). `verificationStatus` records the signature check; `status`
/// records processing. The raw `payload` is retained for audit; a failed
/// verification is never processed. This is the ingress seam a provider adapter
/// consumes — no provider-specific columns are invented here.
model RestaurantWebhookInbox {
  id                 String                              @id @default(cuid())
  organizationId     String                              @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  source             String
  externalEventId    String
  eventType          String?
  payload            Json                                @default("{}")
  verificationStatus RestaurantWebhookVerificationStatus @default(PENDING)
  status             RestaurantWebhookInboxStatus        @default(PENDING)
  attempts           Int                                 @default(0)
  lastError          String?
  receivedAt         DateTime                            @default(now())
  processedAt        DateTime?
  createdAt          DateTime                            @default(now())
  updatedAt          DateTime                            @updatedAt

  @@unique([organizationId, source, externalEventId])
  @@index([organizationId])
  @@index([status])
  @@map("restaurant_webhook_inbox")
}

/// M7/§11.5: an SOP template FAMILY (the unit counted by `sop.templates.max` in
/// vertical-catalog — not immutable historical versions). Content lives on the
/// versions; a family is org-scoped and carries no branchId (branch binding lives
/// on the assignment, mirroring the M3 catalog/publication split).
model RestaurantSopTemplate {
  id             String   @id @default(cuid())
  organizationId String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  name           String
  description    String?
  category       String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  versions    RestaurantSopTemplateVersion[]
  assignments RestaurantSopAssignment[]

  @@index([organizationId])
  @@map("restaurant_sop_templates")
}

/// M7/§11.5: an immutable-once-PUBLISHED template version. DRAFT is editable;
/// PUBLISHED freezes the step set and is the only version an assignment may pin;
/// RETIRED withdraws it from new assignments. Occurrences pin a specific version
/// so a later edit never rewrites recorded compliance history (C3-style).
model RestaurantSopTemplateVersion {
  id             String                      @id @default(cuid())
  organizationId String                      @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  templateId     String
  versionNumber  Int
  status         RestaurantSopTemplateStatus @default(DRAFT)
  publishedAt    DateTime?
  retiredAt      DateTime?
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  template    RestaurantSopTemplate       @relation(fields: [templateId], references: [id], onDelete: Cascade)
  steps       RestaurantSopTemplateStep[]
  occurrences RestaurantSopOccurrence[]

  @@unique([templateId, versionNumber])
  @@index([organizationId])
  @@index([templateId])
  @@index([status])
  @@map("restaurant_sop_template_versions")
}

/// M7/§11.5: one ordered step of a template version, with per-step evidence
/// requirement flags (photo / signature / note). Steps are frozen when the
/// version is PUBLISHED; occurrence steps reference them by FK.
model RestaurantSopTemplateStep {
  id                String   @id @default(cuid())
  organizationId    String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  templateVersionId String
  stepOrder         Int
  title             String
  instructions      String?
  requiresPhoto     Boolean  @default(false)
  requiresSignature Boolean  @default(false)
  requiresNote      Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  templateVersion RestaurantSopTemplateVersion  @relation(fields: [templateVersionId], references: [id], onDelete: Cascade)
  occurrenceSteps RestaurantSopOccurrenceStep[]

  @@unique([templateVersionId, stepOrder])
  @@index([organizationId])
  @@index([templateVersionId])
  @@map("restaurant_sop_template_steps")
}

/// M7/§11.5: a branch-scoped recurring assignment of a template. Recurrence is
/// expressed as a frequency + interval (+ daysOfWeek for WEEKLY, monthDay for
/// MONTHLY, or an inclusive branch-local start/end time for INTERVAL) over the
/// effective-date window [startDate, endDate], with a due/completion window.
/// The occurrence generator (an L-domain lane) folds this into dated occurrences;
/// L1 only stores the recurrence seam and pins nothing about a specific version.
model RestaurantSopAssignment {
  id                     String                           @id @default(cuid())
  organizationId         String                           @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  branchId               String
  templateId             String
  frequency              RestaurantSopRecurrenceFrequency @default(DAILY)
  interval               Int                              @default(1)
  daysOfWeek             Int[]
  monthDay               Int?
  startDate              DateTime                         @db.Date
  endDate                DateTime?                        @db.Date
  dueTimeMinutes         Int                              @default(0)
  intervalEndTimeMinutes Int?
  windowMinutes          Int                              @default(1440)
  graceMinutes           Int                              @default(0)
  active                 Boolean                          @default(true)
  supersedesAssignmentId String?                          @unique
  supersededAt           DateTime?
  createdAt              DateTime                         @default(now())
  updatedAt              DateTime                         @updatedAt

  // SOP-1: the assignee target. Exactly one of the two id columns is set, and it
  // must be the one matching `assigneeTargetType` — a CHECK constraint in the
  // migration enforces both halves, so an inconsistent row cannot exist even if
  // a caller bypasses the domain module. Pre-existing rows migrate to a PERSON
  // target only when they already name a person; the backfill defaults them to
  // ROLE with a seeded fallback role so no row is left violating the CHECK.
  assigneeTargetType     RestaurantSopAssigneeTargetType @default(ROLE)
  assigneeStaffProfileId String?
  assigneeJobRoleId      String?

  branch          RestaurantBranch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  template        RestaurantSopTemplate     @relation(fields: [templateId], references: [id], onDelete: Cascade)
  assigneeStaff   RestaurantStaffProfile?   @relation("SopAssignmentAssignee", fields: [assigneeStaffProfileId], references: [id], onDelete: Cascade)
  assigneeJobRole RestaurantJobRole?        @relation(fields: [assigneeJobRoleId], references: [id], onDelete: Cascade)
  occurrences     RestaurantSopOccurrence[]
  supersedes      RestaurantSopAssignment?  @relation("SopAssignmentSuccessors", fields: [supersedesAssignmentId], references: [id], onDelete: Restrict)
  supersededBy    RestaurantSopAssignment?  @relation("SopAssignmentSuccessors")

  @@index([organizationId])
  @@index([branchId])
  @@index([templateId])
  @@index([active])
  @@index([assigneeStaffProfileId])
  @@index([assigneeJobRoleId])
  @@index([supersededAt])
  @@map("restaurant_sop_assignments")
}

/// M7/§11.5: one dated instance of an assignment, pinning the template VERSION it
/// was generated against (immutable history). `businessDate` is the branch-local
/// business day (business-date.ts); `dueAt`/`windowEndsAt` are the derived UTC
/// instants. `status` is exactly one of the eight §11.5 states. A unique
/// (assignment, dueAt) slot makes generation idempotent while allowing
/// INTERVAL assignments to materialize multiple occurrences per business date.
model RestaurantSopOccurrence {
  id                String                        @id @default(cuid())
  organizationId    String                        @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  assignmentId      String
  templateVersionId String
  branchId          String
  businessDate      DateTime                      @db.Date
  status            RestaurantSopOccurrenceStatus @default(SCHEDULED)
  dueAt             DateTime
  windowEndsAt      DateTime
  startedAt         DateTime?
  submittedAt       DateTime?
  resolvedAt        DateTime?
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt

  // SOP-1: WHO owes this occurrence, frozen at generation time so a later edit to
  // the assignment never rewrites recorded history (the same C3 rule the pinned
  // templateVersionId follows).
  //   PERSON target → `assignedStaffProfileId` is set and `poolJobRoleId` is null.
  //   ROLE   target → `poolJobRoleId` is set and the occurrence starts UNCLAIMED.
  // The first claim is an atomic conditional UPDATE guarded by
  // `claimedByStaffProfileId IS NULL`, so exactly one concurrent claimer wins;
  // re-claiming by the same holder is idempotent rather than an error.
  assignedStaffProfileId  String?
  poolJobRoleId           String?
  claimedByStaffProfileId String?
  claimedAt               DateTime?

  assignment       RestaurantSopAssignment        @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  templateVersion  RestaurantSopTemplateVersion   @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)
  branch           RestaurantBranch               @relation(fields: [branchId], references: [id], onDelete: Cascade)
  assignedStaff    RestaurantStaffProfile?        @relation("SopOccurrenceAssignee", fields: [assignedStaffProfileId], references: [id], onDelete: SetNull)
  poolJobRole      RestaurantJobRole?             @relation(fields: [poolJobRoleId], references: [id], onDelete: SetNull)
  claimedBy        RestaurantStaffProfile?        @relation("SopOccurrenceClaimer", fields: [claimedByStaffProfileId], references: [id], onDelete: SetNull)
  steps            RestaurantSopOccurrenceStep[]
  evidence         RestaurantSopEvidence[]
  verifications    RestaurantSopVerification[]
  escalationEvents RestaurantSopEscalationEvent[]

  @@unique([assignmentId, dueAt])
  @@index([organizationId])
  @@index([assignmentId])
  @@index([templateVersionId])
  @@index([branchId])
  @@index([status])
  @@index([businessDate])
  @@index([dueAt])
  @@index([assignedStaffProfileId])
  @@index([claimedByStaffProfileId])
  // The pool query: unclaimed ROLE-target occurrences for one role at one branch.
  @@index([poolJobRoleId, branchId, claimedByStaffProfileId])
  @@map("restaurant_sop_occurrences")
  @@index([organizationId, branchId, businessDate], map: "qa144_sop_report_idx")
}

/// M7/§11.5: per-step completion state of an occurrence, referencing the pinned
/// template step. `completedBy` is best-effort operator attribution (nullable).
/// Evidence hangs off the occurrence and (optionally) a specific step.
model RestaurantSopOccurrenceStep {
  id                        String    @id @default(cuid())
  organizationId            String    @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  occurrenceId              String
  templateStepId            String
  completed                 Boolean   @default(false)
  completedAt               DateTime?
  completedByStaffProfileId String?
  note                      String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  occurrence   RestaurantSopOccurrence   @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  templateStep RestaurantSopTemplateStep @relation(fields: [templateStepId], references: [id], onDelete: Restrict)
  completedBy  RestaurantStaffProfile?   @relation(fields: [completedByStaffProfileId], references: [id], onDelete: SetNull)
  evidence     RestaurantSopEvidence[]

  @@unique([occurrenceId, templateStepId])
  @@index([organizationId])
  @@index([occurrenceId])
  @@index([templateStepId])
  @@index([completedByStaffProfileId])
  @@map("restaurant_sop_occurrence_steps")
}

/// M7/§11.5: APPEND-ONLY evidence captured for an occurrence (and optionally a
/// specific step). `contentHash` + `storageRef` are the content-addressed seam
/// (storageRef is nullable until a blob store is wired). `sizeBytes` is a
/// non-negative magnitude (CHECK). DB-enforced append-only (SELECT+INSERT RLS,
/// no updatedAt) — evidence is never edited, only superseded by new evidence.
model RestaurantSopEvidence {
  id                     String   @id @default(cuid())
  organizationId         String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  occurrenceId           String
  occurrenceStepId       String?
  contentHash            String
  mimeType               String
  sizeBytes              Int
  storageRef             String?
  uploaderStaffProfileId String?
  capturedAt             DateTime @default(now())
  createdAt              DateTime @default(now())

  occurrence     RestaurantSopOccurrence      @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  occurrenceStep RestaurantSopOccurrenceStep? @relation(fields: [occurrenceStepId], references: [id], onDelete: SetNull)
  uploader       RestaurantStaffProfile?      @relation(fields: [uploaderStaffProfileId], references: [id], onDelete: SetNull)

  @@unique([organizationId, occurrenceId, occurrenceStepId, uploaderStaffProfileId, contentHash, mimeType], map: "restaurant_sop_evidence_retry_identity_key")
  @@index([organizationId])
  @@index([occurrenceId])
  @@index([occurrenceStepId])
  @@index([contentHash])
  @@index([uploaderStaffProfileId])
  @@map("restaurant_sop_evidence")
}

/// M7/§11.5: APPEND-ONLY verification decision on a submitted occurrence. `action`
/// is VERIFY/REJECT/WAIVE; `actor` is the deciding operator (nullable, best
/// effort); `coAuthorization` optionally pins an M2 co-authorization record for a
/// sensitive decision (single-column FK, the M5 precedent). DB-enforced
/// append-only (SELECT+INSERT RLS) — the occurrence status is folded from these.
model RestaurantSopVerification {
  id                  String                          @id @default(cuid())
  organizationId      String                          @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  occurrenceId        String
  action              RestaurantSopVerificationAction
  actorStaffProfileId String?
  coAuthorizationId   String?
  reason              String?
  createdAt           DateTime                        @default(now())

  occurrence      RestaurantSopOccurrence    @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  actor           RestaurantStaffProfile?    @relation(fields: [actorStaffProfileId], references: [id], onDelete: SetNull)
  coAuthorization RestaurantCoAuthorization? @relation(fields: [coAuthorizationId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([occurrenceId])
  @@index([actorStaffProfileId])
  @@index([coAuthorizationId])
  @@map("restaurant_sop_verifications")
}

/// M7/§11.5: an escalation policy — a scope (ORG or a specific BRANCH), stop
/// conditions, and optional branch-local quiet hours. Its ordered steps fire on a
/// delay when an occurrence is overdue; L1 stores the policy seam only.
model RestaurantSopEscalationPolicy {
  id                     String                       @id @default(cuid())
  organizationId         String                       @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  name                   String
  scope                  RestaurantSopEscalationScope @default(ORG)
  branchId               String?
  stopOnAcknowledged     Boolean                      @default(true)
  stopOnVerified         Boolean                      @default(true)
  quietHoursStartMinutes Int?
  quietHoursEndMinutes   Int?
  active                 Boolean                      @default(true)
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt

  branch RestaurantBranch?             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  steps  RestaurantSopEscalationStep[]

  @@index([organizationId])
  @@index([branchId])
  @@index([active])
  @@map("restaurant_sop_escalation_policies")
}

/// M7/§11.5: one ordered step of an escalation policy — a delay, a target
/// (role/operator/address string), a channel, and a bounded attempt count. Events
/// reference the step that fired them.
model RestaurantSopEscalationStep {
  id             String                        @id @default(cuid())
  organizationId String                        @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  policyId       String
  stepOrder      Int
  delayMinutes   Int                           @default(0)
  target         String
  channel        RestaurantNotificationChannel @default(IN_APP)
  maxAttempts    Int                           @default(1)
  createdAt      DateTime                      @default(now())
  updatedAt      DateTime                      @updatedAt

  policy RestaurantSopEscalationPolicy  @relation(fields: [policyId], references: [id], onDelete: Cascade)
  events RestaurantSopEscalationEvent[]

  @@unique([policyId, stepOrder])
  @@index([organizationId])
  @@index([policyId])
  @@map("restaurant_sop_escalation_steps")
}

/// M7/§11.5: APPEND-ONLY escalation event — FIRED/ACKNOWLEDGED/STOPPED against an
/// occurrence (and the step that fired, when applicable). `actor` is nullable
/// (system-fired events carry none). DB-enforced append-only (SELECT+INSERT RLS);
/// the live escalation state is folded from these immutable rows.
model RestaurantSopEscalationEvent {
  id                  String                           @id @default(cuid())
  organizationId      String                           @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  occurrenceId        String
  escalationStepId    String?
  kind                RestaurantSopEscalationEventKind
  actorStaffProfileId String?
  detail              String?
  createdAt           DateTime                         @default(now())

  occurrence     RestaurantSopOccurrence      @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  escalationStep RestaurantSopEscalationStep? @relation(fields: [escalationStepId], references: [id], onDelete: SetNull)
  actor          RestaurantStaffProfile?      @relation(fields: [actorStaffProfileId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([occurrenceId])
  @@index([escalationStepId])
  @@index([actorStaffProfileId])
  @@map("restaurant_sop_escalation_events")
}

/// SOP-1: a restaurant JOB ROLE (barista, cashier, kitchen, manager, …) as a
/// first-class record. This is deliberately a SEPARATE concept from the platform
/// `OrganizationRole`, and the audit that produced it is recorded here rather
/// than repeated in prose: `OrganizationRole` is keyed to a `User` through the
/// SINGULAR `User.organizationRoleId` column, so it can express neither "this
/// operator has no web login" (C3 — a staff profile need not be a `User`) nor
/// "this person is a barista AND a cashier". Job roles are therefore keyed to the
/// STAFF PROFILE and held many-to-many, per branch. There is still exactly ONE
/// role concept for restaurant job duties — this one; nothing else grants a
/// restaurant job role, and the platform role continues to govern back-office
/// web permissions untouched.
model RestaurantJobRole {
  id             String   @id @default(cuid())
  organizationId String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  key            String
  name           String
  description    String?
  isSystem       Boolean  @default(false)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  capabilities    RestaurantJobRoleCapability[]
  holdings        RestaurantStaffJobRole[]
  auditEntries    RestaurantStaffJobRoleAudit[]
  sopAssignments  RestaurantSopAssignment[]
  poolOccurrences RestaurantSopOccurrence[]

  @@unique([organizationId, key])
  @@index([organizationId])
  @@index([active])
  @@map("restaurant_job_roles")
}

/// SOP-1: one capability granted by a job role. A staff profile's effective
/// capability set is the UNION over every role they hold (in scope) plus their
/// direct per-staff grants — never the intersection, and never "the last role
/// wins". A capability appearing on several held roles resolves once.
model RestaurantJobRoleCapability {
  id             String   @id @default(cuid())
  organizationId String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  jobRoleId      String
  capability     String
  createdAt      DateTime @default(now())

  jobRole RestaurantJobRole @relation(fields: [jobRoleId], references: [id], onDelete: Cascade)

  @@unique([jobRoleId, capability])
  @@index([organizationId])
  @@index([jobRoleId])
  @@map("restaurant_job_role_capabilities")
}

/// SOP-1: the many-to-many holding — this staff profile holds this job role AT
/// THIS BRANCH. `branchId` is NOT NULL on purpose: a nullable "all branches"
/// sentinel would defeat the unique index (PostgreSQL treats NULLs as distinct,
/// so the same org-wide holding could be inserted twice). Org-wide duty is
/// expressed as one holding per branch, which keeps pool eligibility a plain
/// branch-equality lookup.
model RestaurantStaffJobRole {
  id               String   @id @default(cuid())
  organizationId   String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  staffProfileId   String
  jobRoleId        String
  branchId         String
  grantedByStaffId String?
  grantedAt        DateTime @default(now())

  staffProfile RestaurantStaffProfile  @relation("StaffJobRoleHolder", fields: [staffProfileId], references: [id], onDelete: Cascade)
  jobRole      RestaurantJobRole       @relation(fields: [jobRoleId], references: [id], onDelete: Cascade)
  branch       RestaurantBranch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  grantedBy    RestaurantStaffProfile? @relation("StaffJobRoleGrantor", fields: [grantedByStaffId], references: [id], onDelete: SetNull)

  @@unique([staffProfileId, jobRoleId, branchId])
  @@index([organizationId])
  @@index([staffProfileId])
  @@index([jobRoleId])
  @@index([branchId])
  @@index([jobRoleId, branchId])
  @@map("restaurant_staff_job_roles")
}

/// SOP-1 + B1: a per-person capability OVERRIDE at one branch, outside any role.
///
/// `effect = ALLOW` is the original "plus direct grants" half of resolution: it
/// unions on top of the held-role capabilities. `effect = DENY` (B1/WHA-285) is
/// its subtractive twin: it removes an INHERITED capability from one person
/// without touching the role, so the role keeps meaning what it means for
/// everyone else who holds it.
///
/// The table keeps its `..._grants` name on purpose. Renaming it would be a
/// breaking DDL across every existing reference for zero functional gain; the
/// `effect` discriminant carries the meaning instead.
///
/// PRECEDENCE IS STRUCTURAL, NOT A RUNTIME TIEBREAK. The unique index is
/// (staffProfileId, branchId, capability) with NO `effect` in it, so one person
/// cannot simultaneously hold an ALLOW and a DENY for the same capability at the
/// same branch — the ambiguity is impossible to store, not merely resolved late.
/// What remains is a single ordering: DENY beats what a ROLE inherited.
model RestaurantStaffCapabilityGrant {
  id             String                          @id @default(cuid())
  organizationId String                          @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  staffProfileId String
  branchId       String
  capability     String
  effect         RestaurantStaffCapabilityEffect @default(ALLOW)
  createdAt      DateTime                        @default(now())
  updatedAt      DateTime                        @default(now()) @updatedAt

  staffProfile RestaurantStaffProfile @relation("StaffDirectCapabilityGrant", fields: [staffProfileId], references: [id], onDelete: Cascade)
  branch       RestaurantBranch       @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([staffProfileId, branchId, capability])
  @@index([organizationId])
  @@index([staffProfileId])
  @@index([branchId])
  @@map("restaurant_staff_capability_grants")
}

/// B1/WHA-285: the APPEND-ONLY audit trail for per-person capability overrides,
/// the exact counterpart of `restaurant_staff_job_role_audits` for the other half
/// of resolution. It is a SEPARATE table rather than extra rows in the membership
/// trail because that trail's subject is a (role, branch) holding and its
/// `jobRoleKey` is NOT NULL; overloading it would have meant relaxing a live
/// invariant to store a different subject.
///
/// ALLOWED/DENIED record the effect an override was set to; CLEARED records its
/// removal, and is written BEFORE the delete so "this person stopped being denied
/// refunds on the 4th" survives the row it removed.
model RestaurantStaffCapabilityAudit {
  id                  String                             @id @default(cuid())
  organizationId      String                             @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  staffProfileId      String
  branchId            String
  capability          String
  change              RestaurantStaffCapabilityAuditKind
  actorStaffProfileId String?
  createdAt           DateTime                           @default(now())

  staffProfile RestaurantStaffProfile  @relation("StaffCapabilityAuditSubject", fields: [staffProfileId], references: [id], onDelete: Cascade)
  branch       RestaurantBranch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  actor        RestaurantStaffProfile? @relation("StaffCapabilityAuditActor", fields: [actorStaffProfileId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([staffProfileId])
  @@index([branchId])
  @@index([createdAt])
  @@map("restaurant_staff_capability_audits")
}

/// SOP-1: the APPEND-ONLY audit trail for job-role membership. The migration
/// grants SELECT + INSERT policies only (the M5/M6 append-only pattern — UPDATE
/// and DELETE are denied by policy omission under FORCE RLS), so a revoke can
/// never be erased. `jobRoleId` is `SetNull` rather than `Cascade` because
/// deleting a role must not delete the record that people once held it; the
/// denormalised `jobRoleKey` keeps the entry readable afterwards.
model RestaurantStaffJobRoleAudit {
  id                  String                           @id @default(cuid())
  organizationId      String                           @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  staffProfileId      String
  jobRoleId           String?
  jobRoleKey          String
  branchId            String
  change              RestaurantStaffJobRoleChangeKind
  actorStaffProfileId String?
  createdAt           DateTime                         @default(now())

  staffProfile RestaurantStaffProfile  @relation("StaffJobRoleAuditSubject", fields: [staffProfileId], references: [id], onDelete: Cascade)
  jobRole      RestaurantJobRole?      @relation(fields: [jobRoleId], references: [id], onDelete: SetNull)
  actor        RestaurantStaffProfile? @relation("StaffJobRoleAuditActor", fields: [actorStaffProfileId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([staffProfileId])
  @@index([jobRoleId])
  @@index([branchId])
  @@index([createdAt])
  @@map("restaurant_staff_job_role_audits")
}

/// M7/D21: an in-app notification addressed to a staff operator, optionally
/// scoped to a branch and tied to a source entity (entityType/entityId — a loose
/// reference, never a cross-table FK). `isRead`/`readAt` track read state; the
/// per-channel delivery record is append-only (below).
model RestaurantNotification {
  id                      String    @id @default(cuid())
  organizationId          String    @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  recipientStaffProfileId String
  branchId                String?
  category                String
  title                   String
  body                    String?
  entityType              String?
  entityId                String?
  isRead                  Boolean   @default(false)
  readAt                  DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  recipient  RestaurantStaffProfile           @relation(fields: [recipientStaffProfileId], references: [id], onDelete: Cascade)
  branch     RestaurantBranch?                @relation(fields: [branchId], references: [id], onDelete: Cascade)
  deliveries RestaurantNotificationDelivery[]

  @@index([organizationId])
  @@index([recipientStaffProfileId])
  @@index([branchId])
  @@index([category])
  @@index([isRead])
  @@map("restaurant_notifications")
}

/// M7/D21: the event-category × channel delivery matrix. A row enables/disables a
/// channel for a category; a null `branchId` is the org default, a set `branchId`
/// is a branch override (the L-domain lane resolves the branch-override-then-org
/// precedence in app code).
model RestaurantNotificationChannelSetting {
  id             String                        @id @default(cuid())
  organizationId String                        @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  branchId       String?
  category       String
  channel        RestaurantNotificationChannel
  enabled        Boolean                       @default(true)
  createdAt      DateTime                      @default(now())
  updatedAt      DateTime                      @updatedAt

  branch RestaurantBranch? @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([organizationId, branchId, category, channel])
  @@index([organizationId])
  @@index([branchId])
  @@map("restaurant_notification_channel_settings")
}

/// One tenant-owned outbound SOP webhook. The signing secret is envelope
/// encrypted by the application and is never selected by public read contracts.
model RestaurantNotificationWebhook {
  id                     String    @id @default(cuid())
  organizationId         String    @unique @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  endpointUrl            String
  encryptedSigningSecret String
  enabled                Boolean   @default(false)
  lastSuccessAt          DateTime?
  lastFailureAt          DateTime?
  lastFailure            String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("restaurant_notification_webhooks")
}

/// M7/D21: APPEND-ONLY record of ONE delivery attempt of a notification on ONE
/// channel. DELIVERED_IN_APP is the real in-app delivery; STUBBED records a
/// non-in-app channel whose adapter is a stub; FAILED records an errored attempt.
/// DB-enforced append-only (SELECT+INSERT RLS, no updatedAt).
model RestaurantNotificationDelivery {
  id             String                               @id @default(cuid())
  organizationId String                               @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  notificationId String
  channel        RestaurantNotificationChannel
  status         RestaurantNotificationDeliveryStatus
  attempt        Int                                  @default(1)
  error          String?
  createdAt      DateTime                             @default(now())

  notification RestaurantNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([notificationId])
  @@index([channel])
  @@map("restaurant_notification_deliveries")
}

// ===========================================================================
// M8 — Restaurant customers, loyalty and insight read models. Customer PII is
// isolated from agency Client records; consent and loyalty history are event
// ledgers; insight rows are rebuildable projections. Every model is org-scoped
// under forced RLS in the M8 migration.
// ===========================================================================

enum CustomerIdentifierKind {
  EMAIL
  PHONE
  WALLET
}

enum CustomerConsentChannel {
  EMAIL
  SMS
  PHONE
  WHATSAPP
  PUSH
}

enum LoyaltyPointsEntryKind {
  EARN
  REDEEM
  REVERSAL
  EXPIRY
  ADJUSTMENT
}

/// D08: the organization-owned restaurant customer surrogate. Contact identity
/// lives in CustomerIdentifier, never agency Client. Anonymization clears the
/// nullable profile fields and stamps anonymizedAt while retained history keeps
/// referencing this non-PII surrogate.
model RestaurantCustomer {
  id             String    @id @default(cuid())
  organizationId String    @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  displayName    String?
  givenName      String?
  familyName     String?
  birthDate      DateTime? @db.Date
  notes          String?
  anonymizedAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  identifiers          CustomerIdentifier[]
  interactions         CustomerInteraction[]
  tagAssignments       CustomerTagAssignment[]
  consentEvents        CustomerConsent[]
  loyaltyAccount       LoyaltyAccount?
  orders               RestaurantOrder[]
  addresses            RestaurantCustomerAddress[]
  deliveryFulfillments RestaurantDeliveryFulfillment[]
  cateringOrders       RestaurantCateringOrder[]

  walletPasses WalletPass[]

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([anonymizedAt])
  @@map("restaurant_customers")

}

/// Direct-delivery configuration owned by one branch. The fee is authoritative
/// server data; clients may identify a zone, but fulfillment creation validates
/// the active zone and copies these values into historical snapshots.
model RestaurantDeliveryZone {
  id              String   @id @default(cuid())
  organizationId  String   @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  branchId        String
  name            String
  active          Boolean  @default(true)
  fixedFee        Decimal  @db.Decimal(12, 2)
  minimumSubtotal Decimal  @default(0) @db.Decimal(12, 2)
  promisedMinutes Int
  sortOrder       Int      @default(0)
  areaPostalLabel String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  branch RestaurantBranch @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, branchId, id])
  @@index([organizationId, branchId, active, sortOrder])
  @@map("restaurant_delivery_zones")
}

/// Reusable restaurant-customer address. Soft deletion preserves prior records;
/// completed deliveries retain independent snapshots rather than referring here.
model RestaurantCustomerAddress {
  id                 String    @id @default(cuid())
  organizationId     String    @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  customerId         String
  label              String
  recipientName      String
  normalizedPhone    String
  addressLine1       String
  addressLine2       String?
  locality           String
  administrativeArea String?
  postalCode         String?
  countryCode        String
  latitude           Decimal?  @db.Decimal(9, 6)
  longitude          Decimal?  @db.Decimal(9, 6)
  isDefault          Boolean   @default(false)
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  customer       RestaurantCustomer        @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: Cascade)
  cateringOrders RestaurantCateringOrder[]

  @@unique([organizationId, customerId, id])
  @@index([organizationId, customerId, deletedAt])
  @@map("restaurant_customer_addresses")
}

enum RestaurantCateringOrderStatus {
  DRAFT
  QUOTED
  CONFIRMED
  IN_PRODUCTION
  READY
  DELIVERED
  CLOSED
  CANCELLED
}

enum RestaurantCateringExtraCostKind {
  LABOUR
  TRANSPORT
  RENTAL
  OTHER
}

model RestaurantCateringOrder {
  cateringMoneyEvidence CateringMoneyEvidence[]

  commands RestaurantCateringCommand[]

  dispositions RestaurantCateringDisposition[]

  confirmedQuote RestaurantCateringQuoteRevision? @relation("CateringConfirmedQuote", fields: [organizationId, id, confirmedQuoteRevisionId], references: [organizationId, orderId, id], onDelete: Restrict, onUpdate: NoAction, map: "catering_confirmed_quote_fk")

  approvedQuote RestaurantCateringQuoteRevision? @relation("CateringApprovedQuote", fields: [organizationId, id, approvedQuoteRevisionId], references: [organizationId, orderId, id], onDelete: Restrict, onUpdate: NoAction, map: "catering_approved_quote_fk")

  quoteRevisions RestaurantCateringQuoteRevision[] @relation("CateringQuoteHistory")

  // Insert inside RestaurantCateringOrder during central composition.
  bookingStartsAt          DateTime? @db.Timestamptz(6)
  bookingEndsAt            DateTime? @db.Timestamptz(6)
  fulfillmentMode          String?
  stockLocationId          String?
  revision                 Int       @default(0)
  approvedQuoteRevisionId  String?
  confirmedQuoteRevisionId String?

  id                String                        @id @default(cuid())
  organizationId    String                        @default(dbgenerated("current_setting('app.current_organization_id', true)"))
  branchId          String
  customerId        String?
  eventName         String
  eventDate         DateTime                      @db.Date
  serviceTime       DateTime?                     @db.Time(0)
  headcount         Int
  venueAddress      String?
  deliveryAddressId String?
  status            RestaurantCateringOrderStatus @default(DRAFT)
  quotedTotal       Decimal?                      @db.Decimal(12, 2)
  depositAmount     Decimal?                      @db.Decimal(12, 2)
  notes             String?
  createdByStaffId  String?
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt

  branch          RestaurantBranch              @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)
  customer        RestaurantCustomer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  deliveryAddress RestaurantCustomerAddress?    @relation(fields: [deliveryAddressId], references: [id], onDelete: SetNull)
  createdBy       RestaurantStaffProfile?       @relation("CateringOrderCreator", fields: [createdByStaffId], references: [id], onDelete: SetNull)
