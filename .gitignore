# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.perf/

# legacy next.js
/.next/
/out/

# nuxt
/.nuxt/
/.output/

# python
__pycache__/
*.py[cod]
/.venv/
.ruff_cache/
.pytest_cache/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the sanitized template (names + placeholders only, no real values) is
# tracked so onboarding has an accurate reference. Runtime behavior is unchanged;
# real secrets still live only in `.env` (ignored) and the platform secret store.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# Local email/render previews
.preview/

# RT-05: authenticated local upload storage (dev)
private-uploads/

# Enhancement filing temp body files
scripts/.enh-*.md
scripts/.enh-gh-map.json
scripts/.enh-internal-map.json

# Playwright MCP scratch (screenshots saved to docs/ instead)
.playwright-mcp/
