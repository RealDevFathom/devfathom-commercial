# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
# Amazon RDS public CA bundle (certificates only), pinned in infra/aws.
!infra/aws/rds-global-bundle.pem

# debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# Local email/render previews
.preview/

# RT-05: authenticated local upload storage (dev)
private-uploads/

# Enhancement filing temp body files
scripts/.enh-*.md
scripts/.enh-gh-map.json
scripts/.enh-internal-map.json

# Playwright MCP scratch (screenshots saved to docs/ instead)
.playwright-mcp/

# MEET-02: locally generated LiveKit development credentials
docker/livekit/livekit.dev.keys.yaml

# Playwright output
/test-results/
/playwright-artifacts/
/playwright-report/

# codex cloud CLI log (may contain account metadata)
/error.log

# scratch QA output, never commit
.qa-run/
