@@ -0,0 +1,5 @@
+/** The only active-line rule. Historical lines without a tombstone remain active. */
+export const ACTIVE_SALE_LINE = { removedAt: null } as const;
+export function isActiveSaleLine(line: { removedAt?: Date | string | null }): boolean {
+  return line.removedAt == null;
+}
