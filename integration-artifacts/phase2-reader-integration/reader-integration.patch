+test('release competing with real removal restores stock at most once', async () => {
+  const f = await cart([100], [3]);
+  const [reduction, removal] = await Promise.allSettled([
+    tenant((db) =>
+      reduceSaleLineQuantity(db, scope, {
+        saleId: f.sale.id,
+        saleLineId: f.line.id,
+        fromQuantity: 3,
+        toQuantity: 2,
+        idempotencyKey: randomUUID(),
+      })
+    ),
+    tenant((db) =>
+      removeSaleLine(db, scope, {
+        saleId: f.sale.id,
+        saleLineId: f.line.id,
+        reason: 'concurrent removal',
+      })
+    ),
+  ]);
+  expect(removal.status).toBe('fulfilled');
+  expect(['fulfilled', 'rejected']).toContain(reduction.status);
+  const balance = await tenant((db) =>
+    db.pharmacyStockBalance.findFirstOrThrow({
+      where: { organizationId: org, inventoryLotId: f.lots[0]!.id, disposition: 'AVAILABLE' },
+    })
+  );
+  expect(balance.onHandUnits).toBe(3);
+});
