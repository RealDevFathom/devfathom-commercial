+import { beforeEach, describe, expect, it, vi } from 'vitest';
+import type { ScopedDb } from '@/lib/tenancy/scoped-db';
+const mocks = vi.hoisted(() => ({ residual: vi.fn(), reverse: vi.fn() }));
+vi.mock('./restore-allocation-residual', () => ({ restoreAllocationResidual: mocks.residual }));
+vi.mock('./stock-ledger', () => ({ reverseMovements: mocks.reverse }));
+import { restoreSaleAllocations } from './restore-sale-allocations';
+const scope = { organizationId: 'org', branchId: 'branch', actorId: 'actor' };
+const rows = [
+  { id: 'a', saleLineId: 'line', stockMovementId: 'm1', quantityUnits: -10 },
+  { id: 'b', saleLineId: 'line', stockMovementId: 'm2', quantityUnits: -8 },
+  { id: 'c', saleLineId: 'line', stockMovementId: 'm3', quantityUnits: -5 },
+];
+const input = { saleId: 'sale', operation: 'void' as const, reason: 'voided' };
+function fake(complete = true) {
+  const query = vi.fn().mockResolvedValueOnce(rows).mockResolvedValueOnce([{ complete }]);
+  return { query, db: { $queryRaw: query } as unknown as ScopedDb };
+}
+describe('restoring sale allocations', () => {
+  beforeEach(() => {
+    vi.resetAllMocks();
+  });
+  it('restores residuals separately, reverses untouched movements once, and checks every active allocation', async () => {
+    mocks.residual
+      .mockResolvedValueOnce({ kind: 'RESTORED', stockMovementId: 'r1', replayed: false })
+      .mockResolvedValueOnce({ kind: 'FULL_REVERSAL_REQUIRED' })
+      .mockResolvedValueOnce({ kind: 'ALREADY_RELEASED' });
+    mocks.reverse.mockResolvedValue([{ id: 'reverse-m2', reversesMovementId: 'm2' }]);
+    const { db, query } = fake();
+    await expect(restoreSaleAllocations(db, scope, input)).resolves.toEqual([
+      {
+        sourceMovementId: 'm2',
+        restorationMovementId: 'reverse-m2',
+        quantityCanonicalUnits: 8,
+        restoreSellable: true,
+      },
+    ]);
+    expect(mocks.reverse.mock.calls[0]![2].movementIds).toEqual(['m2']);
+    expect(mocks.residual).toHaveBeenCalledTimes(3);
+    expect(query).toHaveBeenCalledTimes(2);
+  });
+  it('fails the transaction if any allocation lacks complete restoration', async () => {
+    mocks.residual.mockResolvedValue({ kind: 'ALREADY_RELEASED' });
+    mocks.reverse.mockResolvedValue([]);
+    const { db } = fake(false);
+    await expect(restoreSaleAllocations(db, scope, input)).rejects.toThrow(
+      'RESTORATION_INCOMPLETE'
+    );
+  });
+  it('fails if a claimed full reversal is missing', async () => {
+    mocks.residual.mockResolvedValue({ kind: 'FULL_REVERSAL_REQUIRED' });
+    mocks.reverse.mockResolvedValue([]);
+    const { db } = fake();
+    await expect(restoreSaleAllocations(db, scope, input)).rejects.toThrow(
+      'RESTORATION_EVIDENCE_MISSING'
+    );
+  });
+});
diff --git a/src/lib/pharmacy/effective-sale-allocation.ts b/src/lib/pharmacy/effective-sale-allocation.ts
new file mode 100644
--- /dev/null
+++ b/src/lib/pharmacy/effective-sale-allocation.ts
@@ -0,0 +1,101 @@
+/**
+ * Project immutable allocation and release evidence into the units and gross
+ * still on a sale line. Callers must load all releases in the same transaction
+ * and hold the sale lock when using this projection for a mutation or issuance.
+ */
+export type AllocationEvidence = {
+  id: string;
+  organizationId: string;
+  branchId: string;
+  canonicalUnits: number;
+  grossMinor: number | null;
+  priceEvidence: null | {
+    organizationId: string;
+    branchId: string;
+    allocationId: string;
+    originalUnits: number;
+    priceNumerator: number;
+    denominator: number;
+    remainder: number;
+    grossMinor: number;
+  };
+  releases: readonly {
+    organizationId: string;
+    branchId: string;
+    allocationId: string;
+    canonicalUnits: number;
+    grossMinor: number;
+  }[];
+};
+
+export class InvalidAllocationEvidence extends Error {
+  constructor() {
+    super('INVALID_ALLOCATION_EVIDENCE');
+  }
+}
+
+const nonnegative = (n: number) => Number.isSafeInteger(n) && n >= 0;
+
+/** Returns null when no units remain; never changes the historical input rows. */
+export function effectiveSaleAllocation<T extends AllocationEvidence>(
+  allocation: T,
+  scope: { organizationId: string; branchId: string }
+): (T & { canonicalUnits: number; grossMinor: number | null }) | null {
+  const fail = (): never => {
+    throw new InvalidAllocationEvidence();
+  };
+  const scoped = (row: { organizationId: string; branchId: string }) =>
+    row.organizationId === scope.organizationId && row.branchId === scope.branchId;
+  if (
+    !scoped(allocation) ||
+    !Number.isSafeInteger(allocation.canonicalUnits) ||
+    allocation.canonicalUnits <= 0 ||
+    (allocation.grossMinor !== null && !nonnegative(allocation.grossMinor))
+  )
+    fail();
+  const evidence = allocation.priceEvidence;
+  if (!evidence) {
+    if (allocation.releases.length) fail();
+    return { ...allocation };
+  }
+  if (
+    !scoped(evidence) ||
+    evidence.allocationId !== allocation.id ||
+    evidence.originalUnits !== allocation.canonicalUnits ||
+    !nonnegative(evidence.priceNumerator) ||
+    !Number.isSafeInteger(evidence.denominator) ||
+    evidence.denominator <= 0 ||
+    !nonnegative(evidence.remainder) ||
+    evidence.remainder >= evidence.denominator ||
+    !nonnegative(evidence.grossMinor) ||
+    evidence.grossMinor !== allocation.grossMinor
+  )
+    fail();
+  const gross = (units: number) =>
+    (BigInt(evidence.remainder) + BigInt(units) * BigInt(evidence.priceNumerator)) /
+    BigInt(evidence.denominator);
+  if (gross(evidence.originalUnits) !== BigInt(evidence.grossMinor)) fail();
+  let units = evidence.originalUnits;
+  let releasedGross = BigInt(0);
+  for (const release of allocation.releases) {
+    if (
+      !scoped(release) ||
+      release.allocationId !== allocation.id ||
+      !Number.isSafeInteger(release.canonicalUnits) ||
+      release.canonicalUnits <= 0 ||
+      !nonnegative(release.grossMinor) ||
+      release.canonicalUnits > units
+    )
+      fail();
+    units -= release.canonicalUnits;
+    releasedGross += BigInt(release.grossMinor);
+  }
+  const remainingGross = gross(units);
+  if (
+    releasedGross !== BigInt(evidence.grossMinor) - remainingGross ||
+    remainingGross > BigInt(Number.MAX_SAFE_INTEGER)
+  )
+    fail();
+  if (!units) return null;
+  return { ...allocation, canonicalUnits: units, grossMinor: Number(remainingGross) };
+}
diff --git a/src/lib/pharmacy/read-effective-sale-allocations.ts b/src/lib/pharmacy/read-effective-sale-allocations.ts
new file mode 100644
--- /dev/null
+++ b/src/lib/pharmacy/read-effective-sale-allocations.ts
@@ -0,0 +1,74 @@
+import { Prisma } from '@/generated/prisma/client';
+import { apportionDiscount } from './sale-line-money';
+import type { ScopedDb } from '@/lib/tenancy/scoped-db';
+import {
+  effectiveSaleAllocation,
+  InvalidAllocationEvidence,
+  type AllocationEvidence,
+} from './effective-sale-allocation';
+
+/** Call within the caller's tenant transaction; mutations/issuance also hold the sale lock. */
+export async function readEffectiveSaleAllocations(
+  db: ScopedDb,
+  scope: { organizationId: string; branchId: string },
+  saleId: string
+) {
+  const rows = await db.$queryRaw<
+    Array<AllocationEvidence & { saleLineId: string; lineEdited: boolean }>
+  >(Prisma.sql`
+    SELECT a.id,a."organizationId",a."branchId",a."saleLineId",a."canonicalUnits",a."grossMinor",
+      EXISTS (SELECT 1 FROM pharmacy_sale_line_edit_requests q WHERE q."organizationId"=a."organizationId"
+        AND q."branchId"=a."branchId" AND q."saleLineId"=a."saleLineId") AS "lineEdited",
+      CASE WHEN e."allocationId" IS NULL THEN NULL ELSE jsonb_build_object(
+        'organizationId',e."organizationId",'branchId',e."branchId",'allocationId',e."allocationId",
+        'originalUnits',e."originalUnits",'priceNumerator',e."priceNumerator",'denominator',e.denominator,
+        'remainder',e.remainder,'grossMinor',e."grossMinor") END AS "priceEvidence",
+      COALESCE((SELECT jsonb_agg(jsonb_build_object('organizationId',r."organizationId",'branchId',r."branchId",
+        'allocationId',r."allocationId",'canonicalUnits',r."canonicalUnits",'grossMinor',r."grossMinor") ORDER BY r."createdAt",r.id)
+        FROM pharmacy_allocation_partial_releases r WHERE r."organizationId"=a."organizationId"
+          AND r."branchId"=a."branchId" AND r."allocationId"=a.id),'[]'::jsonb) AS releases
+    FROM pharmacy_sale_line_allocations a JOIN pharmacy_sale_lines l ON l."organizationId"=a."organizationId"
+      AND l."branchId"=a."branchId" AND l.id=a."saleLineId"
+    LEFT JOIN pharmacy_allocation_price_evidence e ON e."organizationId"=a."organizationId" AND e."branchId"=a."branchId" AND e."allocationId"=a.id
+    WHERE a."organizationId"=${scope.organizationId} AND a."branchId"=${scope.branchId}
+      AND l."saleId"=${saleId} AND l."removedAt" IS NULL
+    ORDER BY a."saleLineId",a."createdAt",a.id`);
+  return new Map(rows.map((row) => [row.id, effectiveSaleAllocation(row, scope)]));
+}
+
+/** Preserve rich allocation objects while replacing only effective quantity and gross. */
+export function projectSaleAllocations<
+  T extends { id: string; canonicalUnits: number; grossMinor: number | null },
+>(
+  rows: readonly T[],
+  projected: Awaited<ReturnType<typeof readEffectiveSaleAllocations>>,
+  expectedUnits: number,
+  lineDiscount: number = 0
+): T[] {
+  const result: T[] = [];
+  for (const row of rows) {
+    if (!projected.has(row.id)) throw new InvalidAllocationEvidence();
+    const effective = projected.get(row.id);
+    if (effective)
+      result.push({
+        ...row,
+        canonicalUnits: effective.canonicalUnits,
+        grossMinor: effective.grossMinor,
+      });
+  }
+  if (result.reduce((sum, row) => sum + row.canonicalUnits, 0) !== expectedUnits)
+    throw new InvalidAllocationEvidence();
+  const edited = rows.some((row) => projected.get(row.id)?.lineEdited);
+  if (!edited) return result;
+  if (
+    !Number.isSafeInteger(lineDiscount) ||
+    lineDiscount < 0 ||
+    result.some((row) => row.grossMinor === null)
+  )
+    throw new InvalidAllocationEvidence();
+  const gross = result.map((row) => row.grossMinor!);
+  if (lineDiscount > gross.reduce((sum, amount) => sum + amount, 0))
+    throw new InvalidAllocationEvidence();
+  const discounts = apportionDiscount(lineDiscount, gross);
+  return result.map((row, index) => ({ ...row, discountMinor: discounts[index]! }));
