+test('effective reader enforces tenant and branch isolation under a restricted database role', async () => {
+  const f = await cart([100], [2]);
+  await tenant((db) =>
+    reduceSaleLineQuantity(db, scope, {
+      saleId: f.sale.id,
+      saleLineId: f.line.id,
+      fromQuantity: 2,
+      toQuantity: 1,
+      idempotencyKey: randomUUID(),
+    })
+  );
+  const same = await tenant(async (db) => {
+    await db.$executeRawUnsafe('SET LOCAL ROLE phase2_reader_runtime');
+    return readEffectiveSaleAllocations(db, scope, f.sale.id);
+  });
+  expect(same.size).toBe(1);
+  const branch = await tenant(async (db) => {
+    await db.$executeRawUnsafe('SET LOCAL ROLE phase2_reader_runtime');
+    return readEffectiveSaleAllocations(
+      db,
+      { ...scope, branchId: scope.branchId + '_other' },
+      f.sale.id
+    );
+  });
+  expect(branch.size).toBe(0);
+  const foreign = await withTenantDb(`${org}_other`, async (db) => {
+    await db.$executeRawUnsafe('SET LOCAL ROLE phase2_reader_runtime');
+    return readEffectiveSaleAllocations(db, scope, f.sale.id);
+  });
+  expect(foreign.size).toBe(0);
+});
