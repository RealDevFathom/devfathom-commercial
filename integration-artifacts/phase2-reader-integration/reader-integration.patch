diff --git a/src/lib/pharmacy/restore-sale-allocations.ts b/src/lib/pharmacy/restore-sale-allocations.ts
new file mode 100644
--- /dev/null
+++ b/src/lib/pharmacy/restore-sale-allocations.ts
@@ -0,0 +1,62 @@
+import { Prisma } from '@/generated/prisma/client';
+import type { ScopedDb } from '@/lib/tenancy/scoped-db';
+import { restoreAllocationResidual } from './restore-allocation-residual';
+import { reverseMovements, type LedgerScope } from './stock-ledger';
+
+/** Caller owns the transaction and holds the scoped sale lock until finalization. */
+export async function restoreSaleAllocations(
+  db: ScopedDb,
+  scope: LedgerScope,
+  input: { saleId: string; saleLineId?: string; operation: 'void' | 'remove'; reason: string }
+) {
+  const allocations = await db.$queryRaw<
+    Array<{ id: string; saleLineId: string; stockMovementId: string; quantityUnits: number }>
+  >(Prisma.sql`
+    SELECT a.id,a."saleLineId",a."stockMovementId",m."quantityUnits"
+    FROM pharmacy_sale_line_allocations a
+    JOIN pharmacy_sale_lines l ON l."organizationId"=a."organizationId" AND l."branchId"=a."branchId" AND l.id=a."saleLineId"
+    JOIN pharmacy_stock_movements m ON m."organizationId"=a."organizationId" AND m."branchId"=a."branchId" AND m.id=a."stockMovementId"
+    WHERE a."organizationId"=${scope.organizationId} AND a."branchId"=${scope.branchId}
+      AND l."saleId"=${input.saleId} AND l."removedAt" IS NULL
+      AND (${input.saleLineId ?? null}::text IS NULL OR l.id=${input.saleLineId ?? null})
+    ORDER BY a."inventoryLotId",a."stockLocationId",a.id
+  `);
+  const full = [] as typeof allocations;
+  for (const allocation of allocations) {
+    const result = await restoreAllocationResidual(db, scope, {
+      saleId: input.saleId,
+      saleLineId: allocation.saleLineId,
+      allocationId: allocation.id,
+      idempotencyKey: `${input.operation}:${input.saleLineId ?? input.saleId}`,
+      reason: input.reason,
+    });
+    if (result.kind === 'FULL_REVERSAL_REQUIRED') full.push(allocation);
+  }
+  const reversals = await reverseMovements(db, scope, {
+    movementIds: full.map((a) => a.stockMovementId),
+    reason: input.reason,
+    at: new Date(),
+  });
+  const [check] = await db.$queryRaw<Array<{ complete: boolean }>>(Prisma.sql`
+    SELECT NOT EXISTS (
+      SELECT 1 FROM pharmacy_sale_lines l
+      WHERE l."organizationId"=${scope.organizationId} AND l."branchId"=${scope.branchId}
+        AND l."saleId"=${input.saleId} AND l."removedAt" IS NULL
+        AND (${input.saleLineId ?? null}::text IS NULL OR l.id=${input.saleLineId ?? null})
+        AND (NOT EXISTS (SELECT 1 FROM pharmacy_sale_line_allocations a WHERE a."organizationId"=l."organizationId" AND a."branchId"=l."branchId" AND a."saleLineId"=l.id)
+          OR EXISTS (SELECT 1 FROM pharmacy_sale_line_allocations a WHERE a."organizationId"=l."organizationId" AND a."branchId"=l."branchId" AND a."saleLineId"=l.id
+            AND NOT pharmacy_allocation_restoration_complete(a."organizationId",a."branchId",a.id)))
+    ) AS complete
+  `);
+  if (!check?.complete) throw new Error('RESTORATION_INCOMPLETE');
+  return full.map((a) => {
+    const reversal = reversals.find((r) => r.reversesMovementId === a.stockMovementId);
+    if (!reversal) throw new Error('RESTORATION_EVIDENCE_MISSING');
+    return {
+      sourceMovementId: a.stockMovementId,
+      restorationMovementId: reversal.id,
+      quantityCanonicalUnits: -a.quantityUnits,
+      restoreSellable: true,
+    };
+  });
+}
