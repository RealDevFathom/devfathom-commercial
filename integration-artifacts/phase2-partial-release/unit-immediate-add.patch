+async function packCart(printedMrpMinor = 200, stockUnits = 4) {
+  return tenant(async (db) => {
+    const medicine = await db.medicine.create({
+      data: {
+        organizationId: org,
+        productName: randomUUID(),
+        productFamily: 'PHARMACEUTICAL',
+        saleable: true,
+        otc: true,
+        presentations: { create: { organizationId: org, presentation: 'Two-unit pack' } },
+      },
+      include: { presentations: true },
+    });
+    const presentation = medicine.presentations[0]!;
+    const root = await db.packLevel.create({
+      data: {
+        organizationId: org,
+        presentationId: presentation.id,
+        versionGroupId: randomUUID(),
+        version: 1,
+        level: 'BOX',
+        unitsPerParent: 1,
+        effectiveFrom: new Date('2020-01-01'),
+      },
+    });
+    const unit = await db.packLevel.create({
+      data: {
+        organizationId: org,
+        presentationId: presentation.id,
+        parentPackLevelId: root.id,
+        versionGroupId: randomUUID(),
+        version: 1,
+        level: 'UNIT',
+        unitsPerParent: 2,
+        effectiveFrom: new Date('2020-01-01'),
+      },
+    });
+    const batch = await db.pharmacyManufacturingBatch.create({
+      data: {
+        organizationId: org,
+        medicineId: medicine.id,
+        batchNumber: randomUUID(),
+        expiresAt: new Date('2031-01-01'),
+        expiryPrecision: 'DAY',
+      },
+    });
+    const { lot } = await receiveLot(db, scope, {
+      manufacturingBatchId: batch.id,
+      packLevelId: root.id,
+      stockLocationId: locationId,
+      unitsPerPack: 2,
+      supplierName: 'QA',
+      supplierInvoiceRef: randomUUID(),
+      unitCostMinor: 1,
+      printedMrpMinor,
+      receivedExpiresAt: batch.expiresAt,
+      receivedExpiryPrecision: 'DAY',
+      quantityUnits: stockUnits,
+      idempotencyKey: randomUUID(),
+      receivedAt: new Date('2020-01-01'),
+    });
+    const sale = await createSale(db, scope);
+    const { line } = await addSaleLine(db, scope, {
+      saleId: sale.id,
+      medicineId: medicine.id,
+      presentationId: presentation.id,
+      packLevelId: root.id,
+      saleUnit: 'PACK',
+      quantity: 1,
+      canonicalUnitsPerSaleUnit: 2,
+      idempotencyKey: randomUUID(),
+    });
+    return { sale, line, root, unit, lot };
+  });
+}
