+-- Internal immediate-add request evidence. No router is enabled here.
+CREATE TABLE pharmacy_immediate_add_requests (
+ "organizationId" TEXT NOT NULL, "branchId" TEXT NOT NULL, "saleId" TEXT NOT NULL, "saleLineId" TEXT NOT NULL,
+ "idempotencyKey" TEXT NOT NULL CHECK(length("idempotencyKey") BETWEEN 1 AND 160),
+ "actorId" TEXT NOT NULL, "medicineId" TEXT NOT NULL, "presentationId" TEXT NOT NULL, "packLevelId" TEXT NOT NULL,
+ "saleUnit" TEXT NOT NULL CHECK("saleUnit" IN ('PACK','STRIP','UNIT')), "unitsPerSaleUnit" INTEGER NOT NULL CHECK("unitsPerSaleUnit">0),
+ "resultQuantity" INTEGER NOT NULL CHECK("resultQuantity">0), "source" TEXT NOT NULL CHECK(source IN ('NEW','INCREASE')),
+ "underlyingKey" TEXT NOT NULL, "createdAt" TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP,
+ PRIMARY KEY ("organizationId","idempotencyKey"),
+ FOREIGN KEY ("organizationId","saleLineId") REFERENCES pharmacy_sale_lines("organizationId",id) ON DELETE RESTRICT
+);
+ALTER TABLE pharmacy_immediate_add_requests ENABLE ROW LEVEL SECURITY;
+ALTER TABLE pharmacy_immediate_add_requests FORCE ROW LEVEL SECURITY;
+CREATE POLICY tenant_isolation ON pharmacy_immediate_add_requests
+ USING ("organizationId"=current_setting('app.current_organization_id',true))
+ WITH CHECK ("organizationId"=current_setting('app.current_organization_id',true));
+CREATE TRIGGER pharmacy_immediate_add_immutable BEFORE UPDATE OR DELETE ON pharmacy_immediate_add_requests
+ FOR EACH ROW EXECUTE FUNCTION pharmacy_reject_mutation();
+
+CREATE FUNCTION pharmacy_guard_immediate_add_request() RETURNS trigger LANGUAGE plpgsql AS $$
+DECLARE line RECORD; bill RECORD;
+BEGIN
+ PERFORM pharmacy_assert_no_payment_attempt(NEW."organizationId",NEW."branchId",NEW."saleId");
+ SELECT * INTO bill FROM pharmacy_sales WHERE "organizationId"=NEW."organizationId" AND "branchId"=NEW."branchId" AND id=NEW."saleId" FOR UPDATE;
+ SELECT *,xmin::text::bigint AS insert_xid INTO line FROM pharmacy_sale_lines WHERE "organizationId"=NEW."organizationId"
+  AND "branchId"=NEW."branchId" AND "saleId"=NEW."saleId" AND id=NEW."saleLineId" FOR UPDATE;
+ IF line.id IS NULL OR bill.status::text<>'OPEN' OR bill."receiptNumber" IS NOT NULL OR bill."completedAt" IS NOT NULL OR
+  line."removedAt" IS NOT NULL OR line.insert_xid<>(txid_current()%4294967296) OR
+  NULLIF(current_setting('app.current_user_id',true),'') IS DISTINCT FROM NEW."actorId" OR
+  line."medicineId"<>NEW."medicineId" OR line."presentationId"<>NEW."presentationId" OR line."packLevelId"<>NEW."packLevelId" OR
+  line."saleUnit"::text<>NEW."saleUnit" OR line."canonicalUnitsPerSaleUnit"<>NEW."unitsPerSaleUnit" OR line.quantity<>NEW."resultQuantity" OR
+  EXISTS(SELECT 1 FROM pharmacy_tenders WHERE "organizationId"=NEW."organizationId" AND "saleId"=NEW."saleId") OR
+  EXISTS(SELECT 1 FROM pharmacy_refunds WHERE "organizationId"=NEW."organizationId" AND "saleId"=NEW."saleId") OR
+  EXISTS(SELECT 1 FROM pharmacy_customer_orders WHERE "organizationId"=NEW."organizationId" AND "counterSaleId"=NEW."saleId") OR
+  EXISTS(SELECT 1 FROM pharmacy_medicines WHERE "organizationId"=NEW."organizationId" AND id=NEW."medicineId" AND (NOT otc OR rx OR restricted OR controlled OR "highAlert")) OR
+  EXISTS(SELECT 1 FROM pharmacy_sale_line_allocations a LEFT JOIN LATERAL
+    (SELECT coalesce(sum("canonicalUnits"),0) units FROM pharmacy_allocation_partial_releases WHERE "organizationId"=a."organizationId" AND "allocationId"=a.id) r ON true
+    WHERE a."organizationId"=NEW."organizationId" AND a."saleLineId"=NEW."saleLineId" AND a."canonicalUnits">r.units AND
+      NOT pharmacy_lot_supports_sale_unit(a."organizationId",a."branchId",a."inventoryLotId",NEW."presentationId",NEW."packLevelId",NEW."saleUnit",NEW."unitsPerSaleUnit")) OR
+  (NEW.source='NEW' AND (line."idempotencyKey"<>NEW."underlyingKey" OR NEW."resultQuantity"<>1)) OR
+  (NEW.source='INCREASE' AND NOT EXISTS(SELECT 1 FROM pharmacy_sale_line_edit_requests q WHERE q."organizationId"=NEW."organizationId"
+    AND q."idempotencyKey"=NEW."underlyingKey" AND q."branchId"=NEW."branchId" AND q."saleId"=NEW."saleId"
+    AND q."saleLineId"=NEW."saleLineId" AND q."actorId"=NEW."actorId" AND q."toQuantity"=NEW."resultQuantity"
+    AND q."fromQuantity"=NEW."resultQuantity"-1 AND q.xmin::text::bigint=(txid_current()%4294967296)))
+ THEN RAISE EXCEPTION 'IMMEDIATE_ADD_EVIDENCE_INVALID'; END IF;
+ RETURN NEW;
+END $$;
+CREATE TRIGGER pharmacy_immediate_add_guard BEFORE INSERT ON pharmacy_immediate_add_requests
+ FOR EACH ROW EXECUTE FUNCTION pharmacy_guard_immediate_add_request();
