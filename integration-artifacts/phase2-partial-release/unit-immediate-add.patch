diff --git a/src/lib/pharmacy/immediate-add-sale-line.ts b/src/lib/pharmacy/immediate-add-sale-line.ts
new file mode 100644
index 00000000..614c0900
--- /dev/null
+++ b/src/lib/pharmacy/immediate-add-sale-line.ts
@@ -0,0 +1,193 @@
+import { createHash } from 'node:crypto';
+import { Prisma } from '@/generated/prisma/client';
+import type { ScopedDb } from '@/lib/tenancy/scoped-db';
+import type { LedgerScope } from './stock-ledger';
+import { addSaleLine } from './sales';
+import { increaseSaleLineQuantity } from './increase-sale-line-quantity';
+import { saleUnitOptions } from './counter-pricing';
+import { immediateAddLineSchema, type ImmediateAddLineInput } from './counter-line-command';
+
+/** Internal contract for a UI adapter. The caller must authorize counter/branch
+ * access and own the transaction; do not expose a route until pack and active
+ * allocation reader integrations are complete. Clinical selections fail closed. */
+export async function immediateAddSaleLine(
+  db: ScopedDb,
+  scope: LedgerScope,
+  rawInput: ImmediateAddLineInput
+) {
+  const input = immediateAddLineSchema.parse(rawInput);
+  if (
+    !input.idempotencyKey.trim() ||
+    input.idempotencyKey.length > 160 ||
+    !Number.isSafeInteger(input.canonicalUnitsPerSaleUnit) ||
+    input.canonicalUnitsPerSaleUnit < 1 ||
+    input.canonicalUnitsPerSaleUnit > 2_147_483_647
+  )
+    throw new Error('INVALID_IMMEDIATE_ADD');
+  await db.$executeRaw(
+    Prisma.sql`SELECT pharmacy_assert_no_payment_attempt(${scope.organizationId},${scope.branchId},${input.saleId})`
+  );
+  await db.$queryRaw(Prisma.sql`SELECT set_config('app.current_user_id',${scope.actorId},true)`);
+  const sale = await db.pharmacySale.findFirst({
+    where: { id: input.saleId, organizationId: scope.organizationId, branchId: scope.branchId },
+    include: { tenders: true, refunds: true, customerOrder: true },
+  });
+  if (
+    !sale ||
+    sale.status !== 'OPEN' ||
+    sale.receiptNumber ||
+    sale.completedAt ||
+    sale.tenders.length ||
+    sale.refunds.length ||
+    sale.customerOrder
+  )
+    throw new Error('SALE_NOT_EDITABLE');
+  const [previous] = await db.$queryRaw<
+    Array<{
+      branchId: string;
+      saleId: string;
+      saleLineId: string;
+      actorId: string;
+      medicineId: string;
+      presentationId: string;
+      packLevelId: string;
+      saleUnit: string;
+      unitsPerSaleUnit: number;
+      resultQuantity: number;
+      source: 'NEW' | 'INCREASE';
+    }>
+  >(Prisma.sql`
+    SELECT "branchId","saleId","saleLineId","actorId","medicineId","presentationId","packLevelId","saleUnit",
+      "unitsPerSaleUnit","resultQuantity",source FROM pharmacy_immediate_add_requests
+    WHERE "organizationId"=${scope.organizationId} AND "idempotencyKey"=${input.idempotencyKey}`);
+  if (previous) {
+    if (
+      previous.branchId !== scope.branchId ||
+      previous.saleId !== input.saleId ||
+      previous.actorId !== scope.actorId ||
+      previous.medicineId !== input.medicineId ||
+      previous.presentationId !== input.presentationId ||
+      previous.packLevelId !== input.packLevelId ||
+      previous.saleUnit !== input.saleUnit ||
+      previous.unitsPerSaleUnit !== input.canonicalUnitsPerSaleUnit
+    )
+      throw new Error('IMMEDIATE_ADD_IDEMPOTENCY_CONFLICT');
+    return {
+      saleLineId: previous.saleLineId,
+      quantity: previous.resultQuantity,
+      source: previous.source,
+      replayed: true as const,
+    };
+  }
+  await db.$queryRaw(Prisma.sql`SELECT id FROM pharmacy_medicines
+    WHERE "organizationId"=${scope.organizationId} AND id=${input.medicineId} FOR SHARE`);
+  const medicine = await db.medicine.findFirst({
+    where: { organizationId: scope.organizationId, id: input.medicineId, saleable: true },
+    select: { otc: true, rx: true, restricted: true, controlled: true, highAlert: true },
+  });
+  if (
+    !medicine ||
+    !medicine.otc ||
+    medicine.rx ||
+    medicine.restricted ||
+    medicine.controlled ||
+    medicine.highAlert
+  )
+    throw new Error('CLINICAL_FLOW_REQUIRED');
+  const presentation = await db.presentation.findFirst({
+    where: {
+      organizationId: scope.organizationId,
+      id: input.presentationId,
+      medicineId: input.medicineId,
+    },
+    select: { id: true },
+  });
+  if (!presentation) throw new Error('PRESENTATION_NOT_FOUND');
+  const matches = await db.$queryRaw<
+    Array<{
+      id: string;
+      quantity: number;
+      presentationId: string;
+      packLevelId: string;
+      canonicalUnitsPerSaleUnit: number;
+    }>
+  >(Prisma.sql`
+    SELECT id,quantity,"presentationId","packLevelId","canonicalUnitsPerSaleUnit" FROM pharmacy_sale_lines
+    WHERE "organizationId"=${scope.organizationId} AND "branchId"=${scope.branchId} AND "saleId"=${input.saleId}
+      AND "medicineId"=${input.medicineId} AND "saleUnit"::text=${input.saleUnit} AND "removedAt" IS NULL FOR UPDATE`);
+  if (matches.length > 1) throw new Error('AMBIGUOUS_EXISTING_LINE');
+  const key =
+    'immediate:' +
+    createHash('sha256')
+      .update(JSON.stringify([scope.organizationId, input.idempotencyKey]))
+      .digest('hex');
+  let saleLineId: string, quantity: number, source: 'NEW' | 'INCREASE';
+  if (matches.length) {
+    const line = matches[0]!;
+    if (
+      line.presentationId !== input.presentationId ||
+      line.packLevelId !== input.packLevelId ||
+      line.canonicalUnitsPerSaleUnit !== input.canonicalUnitsPerSaleUnit
+    )
+      throw new Error('EXISTING_LINE_CONFIGURATION_MISMATCH');
+    const increased = await increaseSaleLineQuantity(db, scope, {
+      saleId: input.saleId,
+      saleLineId: line.id,
+      fromQuantity: line.quantity,
+      toQuantity: line.quantity + 1,
+      idempotencyKey: key,
+    });
+    saleLineId = increased.saleLineId;
+    quantity = increased.quantity;
+    source = 'INCREASE';
+  } else {
+    const added = await addSaleLine(db, scope, {
+      saleId: input.saleId,
+      medicineId: input.medicineId,
+      presentationId: input.presentationId,
+      packLevelId: input.packLevelId,
+      saleUnit: input.saleUnit,
+      quantity: 1,
+      canonicalUnitsPerSaleUnit: input.canonicalUnitsPerSaleUnit,
+      idempotencyKey: key,
+    });
+    const lots = await db.pharmacyInventoryLot.findMany({
+      where: {
+        organizationId: scope.organizationId,
+        branchId: scope.branchId,
+        id: { in: added.allocation.allocations.map((part) => part.inventoryLotId) },
+      },
+    });
+    const levels = await db.packLevel.findMany({
+      where: { organizationId: scope.organizationId, presentationId: input.presentationId },
+      select: { id: true, level: true, parentPackLevelId: true, unitsPerParent: true },
+    });
+    if (
+      lots.length !==
+        new Set(added.allocation.allocations.map((part) => part.inventoryLotId)).size ||
+      lots.some(
+        (lot) =>
+          !saleUnitOptions({
+            packLevels: levels,
+            rootPackLevelId: lot.packLevelId,
+            unitsPerPack: lot.unitsPerPack,
+          }).some(
+            (option) =>
+              option.kind === input.saleUnit &&
+              option.packLevelId === input.packLevelId &&
+              option.canonicalUnitsPerSaleUnit === input.canonicalUnitsPerSaleUnit
+          )
+      )
+    )
+      throw new Error('UNIT_NOT_SOLD');
+    saleLineId = added.line.id;
+    quantity = added.line.quantity;
+    source = 'NEW';
+  }
+  await db.$executeRaw(Prisma.sql`INSERT INTO pharmacy_immediate_add_requests
+    ("organizationId","branchId","saleId","saleLineId","idempotencyKey","actorId","medicineId","presentationId","packLevelId",
+     "saleUnit","unitsPerSaleUnit","resultQuantity",source,"underlyingKey")
+    VALUES (${scope.organizationId},${scope.branchId},${input.saleId},${saleLineId},${input.idempotencyKey},${scope.actorId},${input.medicineId},
+      ${input.presentationId},${input.packLevelId},${input.saleUnit},${input.canonicalUnitsPerSaleUnit},${quantity},${source},${key})`);
+  return { saleLineId, quantity, source, replayed: false as const };
+}
