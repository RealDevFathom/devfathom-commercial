+import { describe, expect, it } from 'vitest';
+import { planReleaseArrangement } from './bill-line-release-arrangement';
+
+describe('physical allocation release', () => {
+  it('restores the original loose and sealed arrangement', () => {
+    expect(planReleaseArrangement({ unitsPerPack: 10, sealedPacks: 2, looseUnits: 3 }, 13))
+      .toEqual({ sealedPacks: 1, looseUnits: 3 });
+    expect(planReleaseArrangement({ unitsPerPack: 10, sealedPacks: 2, looseUnits: 3 }, 23))
+      .toEqual({ sealedPacks: 2, looseUnits: 3 });
+  });
+
+  it('refuses to open a sealed pack or return more than was allocated', () => {
+    const remaining = { unitsPerPack: 10, sealedPacks: 1, looseUnits: 0 };
+    expect(() => planReleaseArrangement(remaining, 1)).toThrow('INVALID_RELEASE_ARRANGEMENT');
+    expect(() => planReleaseArrangement(remaining, 20)).toThrow('INVALID_RELEASE_ARRANGEMENT');
+    expect(() => planReleaseArrangement(remaining, 0)).toThrow('INVALID_RELEASE_ARRANGEMENT');
+  });
+
+  it('uses the remaining arrangement after previous releases', () => {
+    const first = planReleaseArrangement({ unitsPerPack: 10, sealedPacks: 2, looseUnits: 13 }, 13);
+    const second = planReleaseArrangement({ unitsPerPack: 10, sealedPacks: 2, looseUnits: 0 }, 20);
+    expect(first).toEqual({ sealedPacks: 0, looseUnits: 13 });
+    expect(second).toEqual({ sealedPacks: 2, looseUnits: 0 });
+  });
+});
