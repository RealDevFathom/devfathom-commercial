@@ -0,0 +1,64 @@
+import { describe, expect, it } from 'vitest';
+import {
+  changeLineQuantitySchema,
+  changeLineUnitSchema,
+  counterLineCommandSchema,
+  immediateAddLineSchema,
+} from './counter-line-command';
+
+describe('counter line command validation', () => {
+  it('requires a scoped command and rejects spoofed actor fields', () => {
+    const command = {
+      kind: 'quantity',
+      branchId: 'branch',
+      saleId: 'sale',
+      saleLineId: 'line',
+      fromQuantity: 2,
+      toQuantity: 1,
+      idempotencyKey: 'request',
+    };
+    expect(counterLineCommandSchema.safeParse(command).success).toBe(true);
+    expect(counterLineCommandSchema.safeParse({ ...command, actorId: 'other' }).success).toBe(
+      false
+    );
+    expect(counterLineCommandSchema.safeParse({ ...command, kind: 'remove' }).success).toBe(false);
+  });
+  it('rejects malformed sale units, arbitrary fields and unsafe quantities', () => {
+    const add = {
+      saleId: 'sale',
+      medicineId: 'medicine',
+      presentationId: 'presentation',
+      packLevelId: 'pack',
+      saleUnit: 'PACK',
+      canonicalUnitsPerSaleUnit: 1,
+      idempotencyKey: 'request',
+    };
+    expect(immediateAddLineSchema.safeParse(add).success).toBe(true);
+    expect(immediateAddLineSchema.safeParse({ ...add, saleUnit: 'CASE' }).success).toBe(false);
+    expect(immediateAddLineSchema.safeParse({ ...add, actorId: 'spoofed' }).success).toBe(false);
+    expect(
+      immediateAddLineSchema.safeParse({ ...add, canonicalUnitsPerSaleUnit: 2_147_483_648 }).success
+    ).toBe(false);
+    expect(
+      changeLineQuantitySchema.safeParse({
+        saleId: 'sale',
+        saleLineId: 'line',
+        fromQuantity: 1,
+        toQuantity: 0,
+        idempotencyKey: 'request',
+      }).success
+    ).toBe(false);
+    expect(
+      changeLineUnitSchema.safeParse({
+        saleId: 'sale',
+        saleLineId: 'line',
+        fromQuantity: 1,
+        fromUnit: 'PACK',
+        fromPackLevelId: 'pack',
+        toUnit: 'UNIT',
+        toPackLevelId: '',
+        idempotencyKey: 'request',
+      }).success
+    ).toBe(false);
+  });
+});
