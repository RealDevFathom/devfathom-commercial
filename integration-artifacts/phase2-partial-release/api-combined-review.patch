@@ -0,0 +1,57 @@
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+import type { ScopedDb } from '@/lib/tenancy/scoped-db';
+const mocks = vi.hoisted(() => ({ residual: vi.fn(), reverse: vi.fn() }));
+vi.mock('./restore-allocation-residual', () => ({ restoreAllocationResidual: mocks.residual }));
+vi.mock('./stock-ledger', () => ({ reverseMovements: mocks.reverse }));
+import { restoreSaleAllocations } from './restore-sale-allocations';
+const scope = { organizationId: 'org', branchId: 'branch', actorId: 'actor' };
+const rows = [
+  { id: 'a', saleLineId: 'line', stockMovementId: 'm1', quantityUnits: -10 },
+  { id: 'b', saleLineId: 'line', stockMovementId: 'm2', quantityUnits: -8 },
+  { id: 'c', saleLineId: 'line', stockMovementId: 'm3', quantityUnits: -5 },
+];
+const input = { saleId: 'sale', operation: 'void' as const, reason: 'voided' };
+function fake(complete = true) {
+  const query = vi.fn().mockResolvedValueOnce(rows).mockResolvedValueOnce([{ complete }]);
+  return { query, db: { $queryRaw: query } as unknown as ScopedDb };
+}
+describe('restoring sale allocations', () => {
+  beforeEach(() => {
+    vi.resetAllMocks();
+  });
+  it('restores residuals separately, reverses untouched movements once, and checks every active allocation', async () => {
+    mocks.residual
+      .mockResolvedValueOnce({ kind: 'RESTORED', stockMovementId: 'r1', replayed: false })
+      .mockResolvedValueOnce({ kind: 'FULL_REVERSAL_REQUIRED' })
+      .mockResolvedValueOnce({ kind: 'ALREADY_RELEASED' });
+    mocks.reverse.mockResolvedValue([{ id: 'reverse-m2', reversesMovementId: 'm2' }]);
+    const { db, query } = fake();
+    await expect(restoreSaleAllocations(db, scope, input)).resolves.toEqual([
+      {
+        sourceMovementId: 'm2',
+        restorationMovementId: 'reverse-m2',
+        quantityCanonicalUnits: 8,
+        restoreSellable: true,
+      },
+    ]);
+    expect(mocks.reverse.mock.calls[0]![2].movementIds).toEqual(['m2']);
+    expect(mocks.residual).toHaveBeenCalledTimes(3);
+    expect(query).toHaveBeenCalledTimes(2);
+  });
+  it('fails the transaction if any allocation lacks complete restoration', async () => {
+    mocks.residual.mockResolvedValue({ kind: 'ALREADY_RELEASED' });
+    mocks.reverse.mockResolvedValue([]);
+    const { db } = fake(false);
+    await expect(restoreSaleAllocations(db, scope, input)).rejects.toThrow(
+      'RESTORATION_INCOMPLETE'
+    );
+  });
+  it('fails if a claimed full reversal is missing', async () => {
+    mocks.residual.mockResolvedValue({ kind: 'FULL_REVERSAL_REQUIRED' });
+    mocks.reverse.mockResolvedValue([]);
+    const { db } = fake();
+    await expect(restoreSaleAllocations(db, scope, input)).rejects.toThrow(
+      'RESTORATION_EVIDENCE_MISSING'
+    );
+  });
+});
