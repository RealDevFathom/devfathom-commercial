+-- Review-only until all readers and the active-line contract are integrated.
+-- Requires pharmacy_assert_no_payment_attempt and the active-line migration.
+CREATE TABLE pharmacy_sale_line_edit_requests (
+  "organizationId" TEXT NOT NULL,
+  "branchId" TEXT NOT NULL,
+  "saleId" TEXT NOT NULL,
+  "saleLineId" TEXT NOT NULL,
+  "idempotencyKey" TEXT NOT NULL CHECK(length("idempotencyKey") BETWEEN 1 AND 160),
+  "actorId" TEXT NOT NULL,
+  "fromQuantity" INTEGER NOT NULL CHECK("fromQuantity">0),
+  "toQuantity" INTEGER NOT NULL CHECK("toQuantity">0 AND "toQuantity"<"fromQuantity"),
+  "createdAt" TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP,
+  PRIMARY KEY ("organizationId", "idempotencyKey"),
+  FOREIGN KEY ("organizationId", "saleLineId") REFERENCES pharmacy_sale_lines ("organizationId", id) ON DELETE RESTRICT
+);
+ALTER TABLE pharmacy_sale_line_edit_requests ENABLE ROW LEVEL SECURITY;
+ALTER TABLE pharmacy_sale_line_edit_requests FORCE ROW LEVEL SECURITY;
+CREATE POLICY tenant_isolation ON pharmacy_sale_line_edit_requests
+ USING ("organizationId"=current_setting('app.current_organization_id',true))
+ WITH CHECK ("organizationId"=current_setting('app.current_organization_id',true));
+CREATE TRIGGER pharmacy_line_edit_request_immutable BEFORE UPDATE OR DELETE ON pharmacy_sale_line_edit_requests
+ FOR EACH ROW EXECUTE FUNCTION pharmacy_reject_mutation();
+
+CREATE TABLE pharmacy_allocation_partial_releases (
+  id TEXT PRIMARY KEY,
+  "organizationId" TEXT NOT NULL,
+  "branchId" TEXT NOT NULL,
+  "allocationId" TEXT NOT NULL,
+  "stockMovementId" TEXT NOT NULL,
+  "requestKey" TEXT NOT NULL,
+  "idempotencyKey" TEXT NOT NULL CHECK (length("idempotencyKey") BETWEEN 1 AND 160),
+  "actorId" TEXT NOT NULL CHECK (length("actorId") > 0),
+  "canonicalUnits" INTEGER NOT NULL CHECK ("canonicalUnits" > 0),
+  "grossMinor" INTEGER NOT NULL CHECK ("grossMinor" >= 0),
+  "createdAt" TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP,
+  UNIQUE ("organizationId", "idempotencyKey"),
+  UNIQUE ("organizationId", "stockMovementId"),
+  FOREIGN KEY ("organizationId", "allocationId") REFERENCES
+    pharmacy_allocation_price_evidence ("organizationId", "allocationId") ON DELETE RESTRICT,
+  FOREIGN KEY ("organizationId", "requestKey") REFERENCES
+    pharmacy_sale_line_edit_requests ("organizationId", "idempotencyKey") ON DELETE RESTRICT DEFERRABLE INITIALLY DEFERRED,
+  FOREIGN KEY ("organizationId", "stockMovementId") REFERENCES
+    pharmacy_stock_movements ("organizationId", id) ON DELETE RESTRICT
+);
+CREATE INDEX pharmacy_partial_release_allocation ON pharmacy_allocation_partial_releases ("organizationId", "allocationId");
+ALTER TABLE pharmacy_allocation_partial_releases ENABLE ROW LEVEL SECURITY;
+ALTER TABLE pharmacy_allocation_partial_releases FORCE ROW LEVEL SECURITY;
+CREATE POLICY tenant_isolation ON pharmacy_allocation_partial_releases
+ USING ("organizationId"=current_setting('app.current_organization_id',true))
+ WITH CHECK ("organizationId"=current_setting('app.current_organization_id',true));
+
+CREATE FUNCTION pharmacy_guard_allocation_partial_release() RETURNS trigger LANGUAGE plpgsql AS $$
+DECLARE a RECORD; snap RECORD; original RECORD; correction RECORD; line RECORD; bill RECORD;
+  already_units bigint; already_sealed bigint; already_loose bigint; remaining bigint; released_gross bigint;
+BEGIN
+ SELECT * INTO a FROM pharmacy_sale_line_allocations WHERE "organizationId"=NEW."organizationId" AND id=NEW."allocationId";
+ IF NOT FOUND OR a."branchId"<>NEW."branchId" THEN RAISE EXCEPTION 'RELEASE_SCOPE_INVALID'; END IF;
+ SELECT * INTO line FROM pharmacy_sale_lines WHERE "organizationId"=NEW."organizationId" AND "branchId"=NEW."branchId" AND id=a."saleLineId";
+ IF NOT FOUND THEN RAISE EXCEPTION 'RELEASE_LINE_INVALID'; END IF;
+ PERFORM pharmacy_assert_no_payment_attempt(NEW."organizationId",NEW."branchId",line."saleId");
+ SELECT * INTO bill FROM pharmacy_sales WHERE "organizationId"=NEW."organizationId" AND "branchId"=NEW."branchId" AND id=line."saleId" FOR UPDATE;
+ SELECT * INTO line FROM pharmacy_sale_lines WHERE "organizationId"=NEW."organizationId" AND "branchId"=NEW."branchId" AND id=a."saleLineId" FOR UPDATE;
+ -- Paid and partially settled sales remain blocked even when the attempt gate succeeds.
+ IF bill.status::text<>'OPEN' OR bill."receiptNumber" IS NOT NULL OR bill."completedAt" IS NOT NULL OR line."removedAt" IS NOT NULL OR
+    EXISTS(SELECT 1 FROM pharmacy_tenders WHERE "organizationId"=NEW."organizationId" AND "saleId"=bill.id) OR
+    EXISTS(SELECT 1 FROM pharmacy_refunds WHERE "organizationId"=NEW."organizationId" AND "saleId"=bill.id) OR
+    EXISTS(SELECT 1 FROM pharmacy_customer_orders WHERE "organizationId"=NEW."organizationId" AND "counterSaleId"=bill.id) OR
+    EXISTS(SELECT 1 FROM pharmacy_medicines WHERE "organizationId"=NEW."organizationId" AND id=line."medicineId" AND (rx OR restricted OR controlled OR "highAlert")) OR
+    EXISTS(SELECT 1 FROM pharmacy_sale_return_lines WHERE "organizationId"=NEW."organizationId" AND "saleLineId"=line.id) OR
+    EXISTS(SELECT 1 FROM pharmacy_unidentified_return_holds WHERE "organizationId"=NEW."organizationId" AND "saleLineId"=line.id) OR
+    EXISTS(SELECT 1 FROM pharmacy_pharmacist_review_items WHERE "organizationId"=NEW."organizationId" AND "saleLineId"=line.id) OR
+    EXISTS(SELECT 1 FROM pharmacy_substitution_records WHERE "organizationId"=NEW."organizationId" AND "saleLineId"=line.id) OR
+    EXISTS(SELECT 1 FROM pharmacy_prescription_fills WHERE "organizationId"=NEW."organizationId" AND "idempotencyKey" IN ('rx-reference:'||line.id,'controlled:'||line.id)) OR
+    line."prescriptionLineId" IS NOT NULL THEN
+   RAISE EXCEPTION 'RELEASE_NOT_ALLOWED';
+ END IF;
+ IF NULLIF(current_setting('app.current_user_id',true),'') IS DISTINCT FROM NEW."actorId" THEN RAISE EXCEPTION 'RELEASE_ACTOR_INVALID'; END IF;
+ SELECT * INTO snap FROM pharmacy_allocation_price_evidence WHERE "organizationId"=NEW."organizationId" AND "allocationId"=a.id;
+ IF NOT FOUND THEN RAISE EXCEPTION 'RELEASE_PRICE_EVIDENCE_MISSING'; END IF;
+ SELECT * INTO original FROM pharmacy_stock_movements WHERE "organizationId"=NEW."organizationId" AND "branchId"=NEW."branchId" AND id=a."stockMovementId";
+ SELECT *, xmin::text::bigint AS insert_xid INTO correction FROM pharmacy_stock_movements WHERE "organizationId"=NEW."organizationId" AND "branchId"=NEW."branchId" AND id=NEW."stockMovementId";
+ IF original.id IS NULL OR correction.id IS NULL OR original.kind::text<>'SALE' OR original.disposition::text<>'AVAILABLE' OR
+    original."inventoryLotId"<>a."inventoryLotId" OR original."stockLocationId"<>a."stockLocationId" OR
+    original."quantityUnits"<>-a."canonicalUnits" OR correction.kind::text<>'ADJUSTMENT' OR correction."reversesMovementId" IS NOT NULL OR
+    correction."inventoryLotId"<>original."inventoryLotId" OR correction."stockLocationId"<>original."stockLocationId" OR
+    correction.disposition<>original.disposition OR correction."quantityUnits"<>NEW."canonicalUnits" OR
+    correction.insert_xid <> (txid_current() % 4294967296) OR
+    correction."idempotencyKey"<>('partial-release:'||NEW."idempotencyKey") OR
+    correction."sealedPackDelta"<0 OR correction."looseUnitDelta"<0 OR correction."actorId"<>NEW."actorId" OR
+    EXISTS(SELECT 1 FROM pharmacy_stock_movements WHERE "organizationId"=NEW."organizationId" AND "reversesMovementId"=original.id) THEN
+   RAISE EXCEPTION 'RELEASE_MOVEMENT_INVALID';
+ END IF;
+ SELECT coalesce(sum(r."canonicalUnits"),0),coalesce(sum(m."sealedPackDelta"),0),coalesce(sum(m."looseUnitDelta"),0)
+ INTO already_units,already_sealed,already_loose FROM pharmacy_allocation_partial_releases r
+ JOIN pharmacy_stock_movements m ON m."organizationId"=r."organizationId" AND m.id=r."stockMovementId"
+ WHERE r."organizationId"=NEW."organizationId" AND r."allocationId"=a.id;
+ remaining:=snap."originalUnits"-already_units;
+ IF NEW."canonicalUnits">remaining OR already_sealed+correction."sealedPackDelta">-original."sealedPackDelta" OR
+    already_loose+correction."looseUnitDelta">-original."looseUnitDelta" THEN RAISE EXCEPTION 'RELEASE_EXCEEDS_ALLOCATION'; END IF;
+ IF EXISTS(SELECT 1 FROM pharmacy_allocation_price_evidence later
+   JOIN pharmacy_sale_line_allocations la ON la."organizationId"=later."organizationId" AND la.id=later."allocationId"
+   WHERE later."organizationId"=NEW."organizationId" AND la."saleLineId"=line.id AND later.ordinal>snap.ordinal
+     AND later."originalUnits">coalesce((SELECT sum(r."canonicalUnits") FROM pharmacy_allocation_partial_releases r WHERE r."organizationId"=later."organizationId" AND r."allocationId"=later."allocationId"),0))
+ THEN RAISE EXCEPTION 'RELEASE_ORDER_INVALID'; END IF;
+ released_gross:=((snap.remainder::bigint+remaining*snap."priceNumerator")/snap.denominator)-
+   ((snap.remainder::bigint+(remaining-NEW."canonicalUnits")*snap."priceNumerator")/snap.denominator);
+ IF NEW."grossMinor"<>released_gross THEN RAISE EXCEPTION 'RELEASE_MONEY_INVALID'; END IF;
+ RETURN NEW;
+END $$;
+CREATE TRIGGER pharmacy_partial_release_guard BEFORE INSERT ON pharmacy_allocation_partial_releases
+ FOR EACH ROW EXECUTE FUNCTION pharmacy_guard_allocation_partial_release();
+CREATE TRIGGER pharmacy_partial_release_immutable BEFORE UPDATE OR DELETE ON pharmacy_allocation_partial_releases
+ FOR EACH ROW EXECUTE FUNCTION pharmacy_reject_mutation();
+
+CREATE FUNCTION pharmacy_guard_line_edit_request() RETURNS trigger LANGUAGE plpgsql AS $$
+DECLARE line RECORD; released bigint;
+BEGIN
+ SELECT * INTO line FROM pharmacy_sale_lines WHERE "organizationId"=NEW."organizationId" AND "branchId"=NEW."branchId"
+   AND "saleId"=NEW."saleId" AND id=NEW."saleLineId";
+ SELECT coalesce(sum(r."canonicalUnits"),0) INTO released FROM pharmacy_allocation_partial_releases r
+ JOIN pharmacy_sale_line_allocations a ON a."organizationId"=r."organizationId" AND a.id=r."allocationId"
+ WHERE r."organizationId"=NEW."organizationId" AND r."branchId"=NEW."branchId" AND r."requestKey"=NEW."idempotencyKey"
+   AND r."actorId"=NEW."actorId" AND a."saleLineId"=NEW."saleLineId";
+ IF line.id IS NULL OR line.quantity<>NEW."toQuantity" OR
+    NULLIF(current_setting('app.current_user_id',true),'') IS DISTINCT FROM NEW."actorId" OR
+    released<>(NEW."fromQuantity"-NEW."toQuantity")::bigint*line."canonicalUnitsPerSaleUnit" THEN
+   RAISE EXCEPTION 'LINE_EDIT_REQUEST_MISMATCH';
+ END IF;
+ RETURN NEW;
+END $$;
+CREATE TRIGGER pharmacy_line_edit_request_guard BEFORE INSERT ON pharmacy_sale_line_edit_requests
+ FOR EACH ROW EXECUTE FUNCTION pharmacy_guard_line_edit_request();
+
+-- A release may only commit with a line whose canonical units and undiscounted
+-- gross match the remaining snapshot evidence. The mutation clears approval.
+CREATE FUNCTION pharmacy_check_release_line_at_commit() RETURNS trigger LANGUAGE plpgsql AS $$
+DECLARE line RECORD; totals RECORD;
+BEGIN
+ SELECT l.* INTO line FROM pharmacy_sale_lines l JOIN pharmacy_sale_line_allocations a ON a."organizationId"=l."organizationId" AND a."saleLineId"=l.id
+   WHERE a."organizationId"=NEW."organizationId" AND a.id=NEW."allocationId";
+ SELECT coalesce(sum(e."originalUnits"-coalesce(r.units,0)),0) AS units,
+   coalesce(sum((e.remainder::bigint+(e."originalUnits"-coalesce(r.units,0))*e."priceNumerator")/e.denominator),0) AS gross,
+   count(*) AS snapshots
+ INTO totals FROM pharmacy_sale_line_allocations a JOIN pharmacy_allocation_price_evidence e ON e."organizationId"=a."organizationId" AND e."allocationId"=a.id
+ LEFT JOIN LATERAL (SELECT sum("canonicalUnits") AS units FROM pharmacy_allocation_partial_releases WHERE "organizationId"=a."organizationId" AND "allocationId"=a.id) r ON true
+ WHERE a."organizationId"=NEW."organizationId" AND a."saleLineId"=line.id;
+ IF NOT EXISTS(SELECT 1 FROM pharmacy_sale_line_edit_requests q WHERE q."organizationId"=NEW."organizationId"
+    AND q."idempotencyKey"=NEW."requestKey" AND q."branchId"=NEW."branchId" AND q."saleId"=line."saleId"
+    AND q."saleLineId"=line.id AND q."actorId"=NEW."actorId") OR
+    totals.snapshots<>(SELECT count(*) FROM pharmacy_sale_line_allocations WHERE "organizationId"=NEW."organizationId" AND "saleLineId"=line.id) OR
+    totals.units<>line."canonicalUnits" OR totals.gross<>line."grossMinor" OR line."discountMinor"<>0 OR
+    line.quantity <= 0 OR line."canonicalUnitsPerSaleUnit" <= 0 OR
+    line.quantity::bigint * line."canonicalUnitsPerSaleUnit" <> line."canonicalUnits" OR
+    line."unitPriceMinor" <> (line."grossMinor" / line.quantity) OR
+    line."discountKind" IS NOT NULL OR line."approvedByUserId" IS NOT NULL OR line."approvalPolicy" IS NOT NULL THEN
+   RAISE EXCEPTION 'RELEASE_LINE_MISMATCH';
+ END IF;
+ RETURN NULL;
+END $$;
+CREATE CONSTRAINT TRIGGER pharmacy_release_line_consistency AFTER INSERT ON pharmacy_allocation_partial_releases
+ DEFERRABLE INITIALLY DEFERRED FOR EACH ROW EXECUTE FUNCTION pharmacy_check_release_line_at_commit();
