+-- Review-only prerequisite for integrating void/removal after partial release.
+CREATE TABLE pharmacy_allocation_residual_restorations (
+ id TEXT PRIMARY KEY, "organizationId" TEXT NOT NULL, "branchId" TEXT NOT NULL,
+ "allocationId" TEXT NOT NULL, "stockMovementId" TEXT NOT NULL,
+ "idempotencyKey" TEXT NOT NULL CHECK(length("idempotencyKey") BETWEEN 1 AND 160),
+ "actorId" TEXT NOT NULL CHECK(length("actorId")>0), "reason" TEXT NOT NULL CHECK(length(trim("reason")) BETWEEN 1 AND 500),
+ "canonicalUnits" INTEGER NOT NULL CHECK("canonicalUnits">0), "grossMinor" INTEGER NOT NULL CHECK("grossMinor">=0),
+ "createdAt" TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP,
+ UNIQUE ("organizationId","allocationId"), UNIQUE ("organizationId","stockMovementId"), UNIQUE ("organizationId","idempotencyKey"),
+ FOREIGN KEY ("organizationId","allocationId") REFERENCES pharmacy_allocation_price_evidence("organizationId","allocationId") ON DELETE RESTRICT,
+ FOREIGN KEY ("organizationId","stockMovementId") REFERENCES pharmacy_stock_movements("organizationId",id) ON DELETE RESTRICT
+);
+ALTER TABLE pharmacy_allocation_residual_restorations ENABLE ROW LEVEL SECURITY;
+ALTER TABLE pharmacy_allocation_residual_restorations FORCE ROW LEVEL SECURITY;
+CREATE POLICY tenant_isolation ON pharmacy_allocation_residual_restorations
+ USING ("organizationId"=current_setting('app.current_organization_id',true))
+ WITH CHECK ("organizationId"=current_setting('app.current_organization_id',true));
+CREATE TRIGGER pharmacy_residual_restoration_immutable BEFORE UPDATE OR DELETE ON pharmacy_allocation_residual_restorations
+ FOR EACH ROW EXECUTE FUNCTION pharmacy_reject_mutation();
+
+CREATE FUNCTION pharmacy_guard_residual_restoration() RETURNS trigger LANGUAGE plpgsql AS $$
+DECLARE a RECORD; line RECORD; bill RECORD; snap RECORD; original RECORD; correction RECORD; released RECORD;
+BEGIN
+ SELECT * INTO a FROM pharmacy_sale_line_allocations WHERE "organizationId"=NEW."organizationId" AND id=NEW."allocationId";
+ IF NOT FOUND OR a."branchId"<>NEW."branchId" THEN RAISE EXCEPTION 'RESIDUAL_SCOPE_INVALID'; END IF;
+ SELECT * INTO line FROM pharmacy_sale_lines WHERE "organizationId"=NEW."organizationId" AND "branchId"=NEW."branchId" AND id=a."saleLineId";
+ IF NOT FOUND THEN RAISE EXCEPTION 'RESIDUAL_LINE_INVALID'; END IF;
+ PERFORM pharmacy_assert_no_payment_attempt(NEW."organizationId",NEW."branchId",line."saleId");
+ SELECT * INTO bill FROM pharmacy_sales WHERE "organizationId"=NEW."organizationId" AND "branchId"=NEW."branchId" AND id=line."saleId" FOR UPDATE;
+ SELECT * INTO line FROM pharmacy_sale_lines WHERE "organizationId"=NEW."organizationId" AND "branchId"=NEW."branchId" AND id=a."saleLineId" FOR UPDATE;
+ IF bill.status::text<>'OPEN' OR bill."receiptNumber" IS NOT NULL OR bill."completedAt" IS NOT NULL OR line."removedAt" IS NOT NULL OR
+   EXISTS(SELECT 1 FROM pharmacy_tenders WHERE "organizationId"=NEW."organizationId" AND "saleId"=bill.id) OR
+   EXISTS(SELECT 1 FROM pharmacy_refunds WHERE "organizationId"=NEW."organizationId" AND "saleId"=bill.id) OR
+   EXISTS(SELECT 1 FROM pharmacy_customer_orders WHERE "organizationId"=NEW."organizationId" AND "counterSaleId"=bill.id) OR
+   EXISTS(SELECT 1 FROM pharmacy_medicines WHERE "organizationId"=NEW."organizationId" AND id=line."medicineId" AND (rx OR restricted OR controlled OR "highAlert")) OR
+   EXISTS(SELECT 1 FROM pharmacy_pharmacist_review_items WHERE "organizationId"=NEW."organizationId" AND "saleLineId"=line.id) OR
+   EXISTS(SELECT 1 FROM pharmacy_substitution_records WHERE "organizationId"=NEW."organizationId" AND "saleLineId"=line.id) OR
+   EXISTS(SELECT 1 FROM pharmacy_prescription_fills WHERE "organizationId"=NEW."organizationId" AND "idempotencyKey" IN ('rx-reference:'||line.id,'controlled:'||line.id)) OR
+   EXISTS(SELECT 1 FROM pharmacy_sale_return_lines WHERE "organizationId"=NEW."organizationId" AND "saleLineId"=line.id) OR
+   EXISTS(SELECT 1 FROM pharmacy_unidentified_return_holds WHERE "organizationId"=NEW."organizationId" AND "saleLineId"=line.id) OR
+   line."prescriptionLineId" IS NOT NULL THEN RAISE EXCEPTION 'RESIDUAL_NOT_ALLOWED'; END IF;
+ IF NULLIF(current_setting('app.current_user_id',true),'') IS DISTINCT FROM NEW."actorId" THEN RAISE EXCEPTION 'RESIDUAL_ACTOR_INVALID'; END IF;
+ SELECT * INTO snap FROM pharmacy_allocation_price_evidence WHERE "organizationId"=NEW."organizationId" AND "allocationId"=a.id;
+ SELECT * INTO original FROM pharmacy_stock_movements WHERE "organizationId"=NEW."organizationId" AND "branchId"=NEW."branchId" AND id=a."stockMovementId";
+ SELECT *,xmin::text::bigint AS insert_xid INTO correction FROM pharmacy_stock_movements WHERE "organizationId"=NEW."organizationId" AND "branchId"=NEW."branchId" AND id=NEW."stockMovementId";
+ SELECT coalesce(sum(r."canonicalUnits"),0) units,coalesce(sum(r."grossMinor"),0) gross,
+   coalesce(sum(m."sealedPackDelta"),0) sealed,coalesce(sum(m."looseUnitDelta"),0) loose
+ INTO released FROM pharmacy_allocation_partial_releases r JOIN pharmacy_stock_movements m ON m."organizationId"=r."organizationId" AND m.id=r."stockMovementId"
+ WHERE r."organizationId"=NEW."organizationId" AND r."allocationId"=a.id;
+ IF snap."allocationId" IS NULL OR original.id IS NULL OR correction.id IS NULL OR released.units<=0 OR
+   original.kind::text<>'SALE' OR original.disposition::text<>'AVAILABLE' OR original."quantityUnits"<>-a."canonicalUnits" OR
+   original."inventoryLotId"<>a."inventoryLotId" OR original."stockLocationId"<>a."stockLocationId" OR
+   EXISTS(SELECT 1 FROM pharmacy_stock_movements WHERE "organizationId"=NEW."organizationId" AND "reversesMovementId"=original.id) OR
+   NEW."canonicalUnits"<>a."canonicalUnits"-released.units OR NEW."grossMinor"<>snap."grossMinor"-released.gross OR
+   correction.kind::text<>'ADJUSTMENT' OR correction."reversesMovementId" IS NOT NULL OR
+   correction."inventoryLotId"<>original."inventoryLotId" OR correction."stockLocationId"<>original."stockLocationId" OR
+   correction.disposition<>original.disposition OR correction."quantityUnits"<>NEW."canonicalUnits" OR
+   correction."sealedPackDelta"<>-original."sealedPackDelta"-released.sealed OR correction."looseUnitDelta"<>-original."looseUnitDelta"-released.loose OR
+   correction."sealedPackDelta"<0 OR correction."looseUnitDelta"<0 OR correction."actorId"<>NEW."actorId" OR correction.reason IS DISTINCT FROM NEW.reason OR
+   correction."idempotencyKey"<>('residual-restoration:'||NEW."idempotencyKey") OR correction.insert_xid<>(txid_current()%4294967296)
+ THEN RAISE EXCEPTION 'RESIDUAL_EVIDENCE_INVALID'; END IF;
+ RETURN NEW;
+END $$;
+CREATE TRIGGER pharmacy_residual_restoration_guard BEFORE INSERT ON pharmacy_allocation_residual_restorations
+ FOR EACH ROW EXECUTE FUNCTION pharmacy_guard_residual_restoration();
+
+-- A restoration must be committed with a void or line tombstone; it cannot be
+-- used to return stock while the same units are still payable on the bill.
+CREATE FUNCTION pharmacy_check_residual_finalization() RETURNS trigger LANGUAGE plpgsql AS $$
+DECLARE final_sale RECORD;
+BEGIN
+ IF NOT EXISTS(SELECT 1 FROM pharmacy_sale_line_allocations a JOIN pharmacy_sale_lines l ON l."organizationId"=a."organizationId" AND l.id=a."saleLineId"
+   JOIN pharmacy_sales s ON s."organizationId"=l."organizationId" AND s."branchId"=l."branchId" AND s.id=l."saleId"
+   WHERE a."organizationId"=NEW."organizationId" AND a.id=NEW."allocationId" AND (l."removedAt" IS NOT NULL OR s.status::text='VOID'))
+ THEN RAISE EXCEPTION 'RESIDUAL_FINALIZATION_REQUIRED'; END IF;
+ SELECT s.* INTO final_sale FROM pharmacy_sale_line_allocations a JOIN pharmacy_sale_lines l ON l."organizationId"=a."organizationId" AND l.id=a."saleLineId"
+   JOIN pharmacy_sales s ON s."organizationId"=l."organizationId" AND s."branchId"=l."branchId" AND s.id=l."saleId"
+   WHERE a."organizationId"=NEW."organizationId" AND a.id=NEW."allocationId";
+ IF final_sale.status::text='VOID' AND EXISTS(SELECT 1 FROM pharmacy_sale_lines l WHERE l."organizationId"=NEW."organizationId"
+   AND l."branchId"=NEW."branchId" AND l."saleId"=final_sale.id AND l."removedAt" IS NULL AND
+   (NOT EXISTS(SELECT 1 FROM pharmacy_sale_line_allocations a WHERE a."organizationId"=l."organizationId" AND a."saleLineId"=l.id) OR
+    EXISTS(SELECT 1 FROM pharmacy_sale_line_allocations a WHERE a."organizationId"=l."organizationId" AND a."saleLineId"=l.id
+      AND NOT pharmacy_allocation_restoration_complete(a."organizationId",a."branchId",a.id))))
+ THEN RAISE EXCEPTION 'VOID_RESTORATION_INCOMPLETE'; END IF;
+ RETURN NULL;
+END $$;
+CREATE CONSTRAINT TRIGGER pharmacy_residual_finalization AFTER INSERT ON pharmacy_allocation_residual_restorations
+ DEFERRABLE INITIALLY DEFERRED FOR EACH ROW EXECUTE FUNCTION pharmacy_check_residual_finalization();
+
+CREATE FUNCTION pharmacy_allocation_restoration_complete(org TEXT,branch TEXT,allocation TEXT) RETURNS BOOLEAN
+ LANGUAGE sql STABLE AS $$
+ SELECT coalesce((SELECT CASE WHEN coalesce(r.units,0)=0 THEN
+   EXISTS(SELECT 1 FROM pharmacy_stock_movements m WHERE m."organizationId"=a."organizationId" AND m."branchId"=a."branchId" AND m."reversesMovementId"=a."stockMovementId")
+ ELSE
+   NOT EXISTS(SELECT 1 FROM pharmacy_stock_movements m WHERE m."organizationId"=a."organizationId" AND m."reversesMovementId"=a."stockMovementId")
+   AND (r.units=a."canonicalUnits" OR EXISTS(SELECT 1 FROM pharmacy_allocation_residual_restorations x
+     WHERE x."organizationId"=a."organizationId" AND x."branchId"=a."branchId" AND x."allocationId"=a.id
+       AND x."canonicalUnits"=a."canonicalUnits"-r.units))
+ END FROM pharmacy_sale_line_allocations a
+ LEFT JOIN LATERAL (SELECT sum("canonicalUnits") units FROM pharmacy_allocation_partial_releases
+   WHERE "organizationId"=a."organizationId" AND "allocationId"=a.id) r ON true
+ WHERE a."organizationId"=org AND a."branchId"=branch AND a.id=allocation),false)
+$$;
+
+-- Reconcile the active-line tombstone guard with residual evidence without
+-- weakening the controlled-register checks for untouched allocations.
+CREATE OR REPLACE FUNCTION pharmacy_removed_line_guard() RETURNS TRIGGER LANGUAGE plpgsql AS $$
+DECLARE bill RECORD; actor TEXT;
+BEGIN
+ IF TG_OP='INSERT' THEN IF NEW."removedAt" IS NOT NULL THEN RAISE EXCEPTION 'REMOVAL_REQUIRES_EXISTING_LINE'; END IF; RETURN NEW; END IF;
+ IF OLD."removedAt" IS NOT NULL THEN RAISE EXCEPTION 'REMOVED_LINE_IMMUTABLE'; END IF;
+ IF TG_OP='DELETE' THEN RAISE EXCEPTION 'SALE_LINE_EVIDENCE_IMMUTABLE'; END IF;
+ IF NEW."removedAt" IS NULL THEN RETURN NEW; END IF;
+ IF (to_jsonb(NEW)-ARRAY['removedAt','removedByUserId','removalReason']) IS DISTINCT FROM
+    (to_jsonb(OLD)-ARRAY['removedAt','removedByUserId','removalReason']) THEN RAISE EXCEPTION 'REMOVAL_CANNOT_REPRICE'; END IF;
+ PERFORM pharmacy_assert_no_payment_attempt(OLD."organizationId",OLD."branchId",OLD."saleId");
+ SELECT * INTO bill FROM pharmacy_sales WHERE "organizationId"=OLD."organizationId" AND "branchId"=OLD."branchId" AND id=OLD."saleId" FOR UPDATE;
+ IF bill.status::text<>'OPEN' OR bill."receiptNumber" IS NOT NULL OR bill."completedAt" IS NOT NULL OR
+    EXISTS(SELECT 1 FROM pharmacy_tenders WHERE "organizationId"=OLD."organizationId" AND "saleId"=OLD."saleId") OR
+    EXISTS(SELECT 1 FROM pharmacy_refunds WHERE "organizationId"=OLD."organizationId" AND "saleId"=OLD."saleId") OR
+    EXISTS(SELECT 1 FROM pharmacy_customer_orders WHERE "organizationId"=OLD."organizationId" AND "counterSaleId"=OLD."saleId")
+ THEN RAISE EXCEPTION 'REMOVAL_REQUIRES_UNPAID_OPEN_SALE'; END IF;
+ actor:=NULLIF(current_setting('app.current_user_id',true),'');
+ IF actor IS NULL OR actor<>NEW."removedByUserId" THEN RAISE EXCEPTION 'REMOVAL_ACTOR_REQUIRED'; END IF;
+ IF NOT EXISTS(SELECT 1 FROM pharmacy_sale_line_allocations WHERE "organizationId"=OLD."organizationId" AND "saleLineId"=OLD.id) OR
+    EXISTS(SELECT 1 FROM pharmacy_sale_line_allocations a WHERE a."organizationId"=OLD."organizationId" AND a."saleLineId"=OLD.id
+      AND NOT pharmacy_allocation_restoration_complete(a."organizationId",a."branchId",a.id))
+ THEN RAISE EXCEPTION 'REMOVAL_REVERSAL_REQUIRED'; END IF;
+ IF EXISTS(SELECT 1 FROM pharmacy_medicines WHERE id=OLD."medicineId" AND controlled) AND EXISTS(
+   SELECT 1 FROM pharmacy_sale_line_allocations a WHERE a."organizationId"=OLD."organizationId" AND a."saleLineId"=OLD.id AND NOT EXISTS(
+    SELECT 1 FROM pharmacy_controlled_register_entries src JOIN pharmacy_controlled_register_entries correction ON correction."organizationId"=src."organizationId" AND correction."correctsEntryId"=src.id
+    JOIN pharmacy_stock_movements r ON r."organizationId"=a."organizationId" AND r."reversesMovementId"=a."stockMovementId"
+    WHERE src."organizationId"=a."organizationId" AND src."stockMovementId"=a."stockMovementId" AND src."entryKind"::text='SALE' AND correction."restorationMovementId"=r.id))
+ THEN RAISE EXCEPTION 'CONTROLLED_REMOVAL_RESTORATION_REQUIRED'; END IF;
+ RETURN NEW;
+END $$;
