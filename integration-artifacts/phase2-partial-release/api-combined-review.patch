+      db.$queryRaw<Array<{ paymentRevision: number }>>(
+        Prisma.sql`SELECT "paymentRevision" FROM pharmacy_sales WHERE "organizationId"=${org} AND id=${f.sale.id}`
+      )
+    );
+    const input = {
+      saleId: f.sale.id,
+      medicineId: f.line.medicineId,
+      presentationId: f.line.presentationId,
+      packLevelId: f.root.id,
+      saleUnit: 'PACK' as const,
+      canonicalUnitsPerSaleUnit: 2,
+      idempotencyKey: randomUUID(),
+    };
+    const add = (db: ScopedDb) => immediateAddSaleLine(db, scope, input);
+    const prepare = (db: ScopedDb) =>
+      db.$executeRaw(Prisma.sql`
+      INSERT INTO pharmacy_payment_attempts (id,"organizationId","branchId","saleId","deviceId","requestKey","requestHash",method,currency,"amountMinor","billRevision","createdByUserId")
+      SELECT ${randomUUID()},${org},${scope.branchId},${f.sale.id},${randomUUID()},${randomUUID()},${'a'.repeat(64)},'JAZZCASH',o.currency,200,${revision!.paymentRevision},${scope.actorId}
+      FROM organizations o WHERE o.id=${org}`);
+    let unlock!: () => void, signal!: () => void;
+    const held = new Promise<void>((resolve) => {
+      unlock = resolve;
+    });
+    const ready = new Promise<void>((resolve) => {
+      signal = resolve;
+    });
+    const winner = tenant(async (db) => {
+      if (first === 'add') await add(db);
+      else await prepare(db);
+      signal();
+      await held;
+    });
+    await ready;
+    const loser = tenant(async (db) => {
+      if (first === 'add') await prepare(db);
+      else await add(db);
+    });
+    const observed = loser.then(
+      () => 'finished',
+      () => 'finished'
+    );
+    expect(
+      await Promise.race([
+        observed,
+        new Promise((resolve) => setTimeout(() => resolve('blocked'), 50)),
+      ])
+    ).toBe('blocked');
+    unlock();
+    await winner;
+    await expect(loser).rejects.toThrow(
+      first === 'add' ? /PAYMENT_BILL_CHANGED/ : /PAYMENT_ATTEMPT_UNRESOLVED/
+    );
+  }
+});
