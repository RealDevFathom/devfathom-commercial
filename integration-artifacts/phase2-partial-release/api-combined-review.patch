new file mode 100644
index 00000000..edbee930
--- /dev/null
+++ b/src/lib/pharmacy/counter-line-command-executor.ts
@@ -0,0 +1,55 @@
+import type { ScopedDb } from '@/lib/tenancy/scoped-db';
+import type { LedgerScope } from './stock-ledger';
+import type { CounterLineCommand } from './counter-line-command';
+import { immediateAddSaleLine } from './immediate-add-sale-line';
+import { increaseSaleLineQuantity } from './increase-sale-line-quantity';
+import { reduceSaleLineQuantity } from './edit-sale-line-quantity';
+import { changeSaleLineUnit } from './change-sale-line-unit';
+
+/** Internal dispatcher only. The caller must authorize and own the transaction.
+ * The public route is hard-disabled pending pack and reader integration. */
+export async function executeCounterLineCommand(
+  db: ScopedDb,
+  scope: LedgerScope,
+  input: CounterLineCommand
+) {
+  if (input.branchId !== scope.branchId) throw new Error('BRANCH_SCOPE_MISMATCH');
+  switch (input.kind) {
+    case 'immediateAdd': {
+      return immediateAddSaleLine(db, scope, {
+        saleId: input.saleId,
+        medicineId: input.medicineId,
+        presentationId: input.presentationId,
+        packLevelId: input.packLevelId,
+        saleUnit: input.saleUnit,
+        canonicalUnitsPerSaleUnit: input.canonicalUnitsPerSaleUnit,
+        idempotencyKey: input.idempotencyKey,
+      });
+    }
+    case 'quantity': {
+      const command = {
+        saleId: input.saleId,
+        saleLineId: input.saleLineId,
+        fromQuantity: input.fromQuantity,
+        toQuantity: input.toQuantity,
+        idempotencyKey: input.idempotencyKey,
+      };
+      if (command.toQuantity === command.fromQuantity) throw new Error('INVALID_LINE_EDIT');
+      return command.toQuantity > command.fromQuantity
+        ? increaseSaleLineQuantity(db, scope, command)
+        : reduceSaleLineQuantity(db, scope, command);
+    }
+    case 'unit': {
+      return changeSaleLineUnit(db, scope, {
+        saleId: input.saleId,
+        saleLineId: input.saleLineId,
+        fromQuantity: input.fromQuantity,
+        fromUnit: input.fromUnit,
+        fromPackLevelId: input.fromPackLevelId,
+        toUnit: input.toUnit,
+        toPackLevelId: input.toPackLevelId,
+        idempotencyKey: input.idempotencyKey,
+      });
+    }
+  }
+}
diff --git a/src/lib/pharmacy/counter-line-command.test.ts b/src/lib/pharmacy/counter-line-command.test.ts
