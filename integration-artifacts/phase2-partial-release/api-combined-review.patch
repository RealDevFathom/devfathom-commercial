+-- Internal unit conversion evidence. No router is enabled by this migration.
+CREATE TABLE pharmacy_sale_line_unit_changes (
+ "organizationId" TEXT NOT NULL, "branchId" TEXT NOT NULL, "saleId" TEXT NOT NULL, "saleLineId" TEXT NOT NULL,
+ "idempotencyKey" TEXT NOT NULL CHECK(length("idempotencyKey") BETWEEN 1 AND 160), "actorId" TEXT NOT NULL,
+ "fromUnit" TEXT NOT NULL CHECK("fromUnit" IN ('PACK','STRIP','UNIT')), "fromPackLevelId" TEXT NOT NULL,
+ "fromQuantity" INTEGER NOT NULL CHECK("fromQuantity">0), "fromUnitsPerSaleUnit" INTEGER NOT NULL CHECK("fromUnitsPerSaleUnit">0),
+ "toUnit" TEXT NOT NULL CHECK("toUnit" IN ('PACK','STRIP','UNIT')), "toPackLevelId" TEXT NOT NULL,
+ "toQuantity" INTEGER NOT NULL CHECK("toQuantity">0), "toUnitsPerSaleUnit" INTEGER NOT NULL CHECK("toUnitsPerSaleUnit">0),
+ "canonicalUnits" INTEGER NOT NULL CHECK("canonicalUnits">0), "grossMinor" INTEGER NOT NULL CHECK("grossMinor">=0),
+ "createdAt" TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP,
+ PRIMARY KEY ("organizationId","idempotencyKey"),
+ FOREIGN KEY ("organizationId","saleLineId") REFERENCES pharmacy_sale_lines("organizationId",id) ON DELETE RESTRICT,
+ CHECK("fromQuantity"::bigint*"fromUnitsPerSaleUnit"="canonicalUnits" AND "toQuantity"::bigint*"toUnitsPerSaleUnit"="canonicalUnits")
+);
+ALTER TABLE pharmacy_sale_line_unit_changes ENABLE ROW LEVEL SECURITY;
+ALTER TABLE pharmacy_sale_line_unit_changes FORCE ROW LEVEL SECURITY;
+CREATE POLICY tenant_isolation ON pharmacy_sale_line_unit_changes
+ USING ("organizationId"=current_setting('app.current_organization_id',true))
+ WITH CHECK ("organizationId"=current_setting('app.current_organization_id',true));
+CREATE TRIGGER pharmacy_unit_change_immutable BEFORE UPDATE OR DELETE ON pharmacy_sale_line_unit_changes
+ FOR EACH ROW EXECUTE FUNCTION pharmacy_reject_mutation();
+
+CREATE FUNCTION pharmacy_guard_unit_change_evidence() RETURNS trigger LANGUAGE plpgsql AS $$
+DECLARE line RECORD; bill RECORD;
+BEGIN
+ PERFORM pharmacy_assert_no_payment_attempt(NEW."organizationId",NEW."branchId",NEW."saleId");
+ SELECT * INTO bill FROM pharmacy_sales WHERE "organizationId"=NEW."organizationId" AND "branchId"=NEW."branchId" AND id=NEW."saleId" FOR UPDATE;
+ SELECT * INTO line FROM pharmacy_sale_lines WHERE "organizationId"=NEW."organizationId" AND "branchId"=NEW."branchId" AND "saleId"=NEW."saleId" AND id=NEW."saleLineId" FOR UPDATE;
+ IF line.id IS NULL OR bill.status::text<>'OPEN' OR bill."receiptNumber" IS NOT NULL OR bill."completedAt" IS NOT NULL OR
+  line."removedAt" IS NOT NULL OR NULLIF(current_setting('app.current_user_id',true),'') IS DISTINCT FROM NEW."actorId" OR
+  line."saleUnit"::text<>NEW."fromUnit" OR line."packLevelId"<>NEW."fromPackLevelId" OR line.quantity<>NEW."fromQuantity" OR
+  line."canonicalUnitsPerSaleUnit"<>NEW."fromUnitsPerSaleUnit" OR line."canonicalUnits"<>NEW."canonicalUnits" OR line."grossMinor"<>NEW."grossMinor" OR
+  (NEW."toUnit",NEW."toPackLevelId",NEW."toUnitsPerSaleUnit") IS NOT DISTINCT FROM (NEW."fromUnit",NEW."fromPackLevelId",NEW."fromUnitsPerSaleUnit")
+ THEN RAISE EXCEPTION 'UNIT_CHANGE_EVIDENCE_INVALID'; END IF;
+ RETURN NEW;
+END $$;
+CREATE TRIGGER pharmacy_unit_change_evidence_guard BEFORE INSERT ON pharmacy_sale_line_unit_changes
+ FOR EACH ROW EXECUTE FUNCTION pharmacy_guard_unit_change_evidence();
+
+CREATE FUNCTION pharmacy_check_unit_change_evidence() RETURNS trigger LANGUAGE plpgsql AS $$
+BEGIN
+ IF NOT EXISTS(SELECT 1 FROM pharmacy_sale_lines l WHERE l."organizationId"=NEW."organizationId" AND l."branchId"=NEW."branchId"
+   AND l."saleId"=NEW."saleId" AND l.id=NEW."saleLineId" AND l."saleUnit"::text=NEW."toUnit"
+   AND l."packLevelId"=NEW."toPackLevelId" AND l.quantity=NEW."toQuantity" AND l."canonicalUnitsPerSaleUnit"=NEW."toUnitsPerSaleUnit"
+   AND l."canonicalUnits"=NEW."canonicalUnits" AND l."grossMinor"=NEW."grossMinor"
+   AND l.xmin::text::bigint=(txid_current()%4294967296)) THEN RAISE EXCEPTION 'UNIT_CHANGE_FINALIZATION_REQUIRED'; END IF;
+ RETURN NULL;
+END $$;
+CREATE CONSTRAINT TRIGGER pharmacy_unit_change_evidence_finalization AFTER INSERT ON pharmacy_sale_line_unit_changes
+ DEFERRABLE INITIALLY DEFERRED FOR EACH ROW EXECUTE FUNCTION pharmacy_check_unit_change_evidence();
+
+-- Recheck the retained lot's linear pack hierarchy in the database rather
+-- than trusting a client-provided target unit or conversion factor.
+CREATE FUNCTION pharmacy_lot_supports_sale_unit(org TEXT, branch TEXT, lot_id TEXT, presentation TEXT,
+  target TEXT, target_kind TEXT, target_units INTEGER) RETURNS BOOLEAN LANGUAGE plpgsql STABLE AS $$
+DECLARE lot RECORD; node RECORD; child RECORD; child_count INTEGER; canonical bigint; depth INTEGER:=0;
+  visited TEXT[]:=ARRAY[]::TEXT[]; matched BOOLEAN:=false; kind TEXT;
+BEGIN
+ SELECT * INTO lot FROM pharmacy_inventory_lots WHERE "organizationId"=org AND "branchId"=branch AND id=lot_id;
+ IF NOT FOUND OR lot."unitsPerPack"<=0 THEN RETURN false; END IF;
+ SELECT * INTO node FROM pharmacy_pack_levels WHERE "organizationId"=org AND "presentationId"=presentation AND id=lot."packLevelId";
+ IF NOT FOUND THEN RETURN false; END IF;
+ canonical:=lot."unitsPerPack";
+ LOOP
+   IF node.id=ANY(visited) OR depth>64 THEN RETURN false; END IF;
+   visited:=array_append(visited,node.id);
+   SELECT count(*) INTO child_count FROM pharmacy_pack_levels WHERE "organizationId"=org AND "presentationId"=presentation AND "parentPackLevelId"=node.id;
+   IF child_count>1 THEN RETURN false; END IF;
+   kind:=CASE WHEN depth=0 THEN 'PACK' WHEN child_count=0 THEN 'UNIT' ELSE 'STRIP' END;
+   IF node.id=target AND kind=target_kind AND canonical=target_units THEN matched:=true; END IF;
+   IF child_count=0 THEN
+     IF depth=0 THEN
+       IF (node."parentPackLevelId" IS NULL AND node."unitsPerParent"<>lot."unitsPerPack") OR
+          (node."parentPackLevelId" IS NOT NULL AND lot."unitsPerPack"<>1) THEN RETURN false; END IF;
+     ELSIF canonical<>1 THEN RETURN false; END IF;
+     RETURN matched;
+   END IF;
+   SELECT * INTO child FROM pharmacy_pack_levels WHERE "organizationId"=org AND "presentationId"=presentation AND "parentPackLevelId"=node.id;
+   IF child."unitsPerParent"<=0 OR canonical%child."unitsPerParent"<>0 THEN RETURN false; END IF;
+   canonical:=canonical/child."unitsPerParent";
+   node:=child; depth:=depth+1;
+ END LOOP;
+END $$;
+
+-- The scoped sale lock serializes the change with payment, release and pack work.
+CREATE FUNCTION pharmacy_guard_unit_change_line() RETURNS trigger LANGUAGE plpgsql AS $$
+DECLARE bill RECORD; units bigint; gross bigint; snapshots bigint; price_cap bigint;
+BEGIN
+ IF (NEW."saleUnit",NEW."packLevelId",NEW."canonicalUnitsPerSaleUnit") IS NOT DISTINCT FROM
+    (OLD."saleUnit",OLD."packLevelId",OLD."canonicalUnitsPerSaleUnit") THEN RETURN NEW; END IF;
+ PERFORM pharmacy_assert_no_payment_attempt(OLD."organizationId",OLD."branchId",OLD."saleId");
+ SELECT * INTO bill FROM pharmacy_sales WHERE "organizationId"=OLD."organizationId" AND "branchId"=OLD."branchId" AND id=OLD."saleId" FOR UPDATE;
+ SELECT count(*),coalesce(sum(e."originalUnits"-coalesce(r.units,0)),0),
+  coalesce(sum((e.remainder::bigint+(e."originalUnits"-coalesce(r.units,0))*e."priceNumerator")/e.denominator),0),
+  coalesce(max(CASE WHEN e."originalUnits"-coalesce(r.units,0)>0 THEN (e."priceNumerator"::bigint*NEW."canonicalUnitsPerSaleUnit")/e.denominator ELSE 0 END),0)
+ INTO snapshots,units,gross,price_cap FROM pharmacy_sale_line_allocations a JOIN pharmacy_allocation_price_evidence e ON e."organizationId"=a."organizationId" AND e."allocationId"=a.id
+ LEFT JOIN LATERAL (SELECT sum("canonicalUnits") units FROM pharmacy_allocation_partial_releases WHERE "organizationId"=a."organizationId" AND "allocationId"=a.id) r ON true
+ WHERE a."organizationId"=OLD."organizationId" AND a."saleLineId"=OLD.id;
+ IF bill.status::text<>'OPEN' OR bill."receiptNumber" IS NOT NULL OR bill."completedAt" IS NOT NULL OR OLD."removedAt" IS NOT NULL OR
+   EXISTS(SELECT 1 FROM pharmacy_tenders WHERE "organizationId"=OLD."organizationId" AND "saleId"=OLD."saleId") OR
+   EXISTS(SELECT 1 FROM pharmacy_refunds WHERE "organizationId"=OLD."organizationId" AND "saleId"=OLD."saleId") OR
+   EXISTS(SELECT 1 FROM pharmacy_customer_orders WHERE "organizationId"=OLD."organizationId" AND "counterSaleId"=OLD."saleId") OR
+   EXISTS(SELECT 1 FROM pharmacy_medicines WHERE "organizationId"=OLD."organizationId" AND id=OLD."medicineId" AND (rx OR restricted OR controlled OR "highAlert")) OR
+   EXISTS(SELECT 1 FROM pharmacy_sale_return_lines WHERE "organizationId"=OLD."organizationId" AND "saleLineId"=OLD.id) OR
+   EXISTS(SELECT 1 FROM pharmacy_unidentified_return_holds WHERE "organizationId"=OLD."organizationId" AND "saleLineId"=OLD.id) OR
+   EXISTS(SELECT 1 FROM pharmacy_pharmacist_review_items WHERE "organizationId"=OLD."organizationId" AND "saleLineId"=OLD.id) OR
+   EXISTS(SELECT 1 FROM pharmacy_substitution_records WHERE "organizationId"=OLD."organizationId" AND "saleLineId"=OLD.id) OR
+   EXISTS(SELECT 1 FROM pharmacy_prescription_fills WHERE "organizationId"=OLD."organizationId" AND "idempotencyKey" IN ('rx-reference:'||OLD.id,'controlled:'||OLD.id)) OR
+   OLD."prescriptionLineId" IS NOT NULL OR
+   snapshots=0 OR snapshots<>(SELECT count(*) FROM pharmacy_sale_line_allocations WHERE "organizationId"=OLD."organizationId" AND "saleLineId"=OLD.id) OR
+   units<>OLD."canonicalUnits" OR gross<>OLD."grossMinor" OR NEW."canonicalUnits"<>OLD."canonicalUnits" OR
+   NOT EXISTS(SELECT 1 FROM pharmacy_pack_levels WHERE "organizationId"=OLD."organizationId" AND "presentationId"=OLD."presentationId" AND id=NEW."packLevelId") OR
+   EXISTS(SELECT 1 FROM pharmacy_sale_line_allocations a LEFT JOIN LATERAL
+     (SELECT coalesce(sum("canonicalUnits"),0) units FROM pharmacy_allocation_partial_releases WHERE "organizationId"=a."organizationId" AND "allocationId"=a.id) r ON true
+     WHERE a."organizationId"=OLD."organizationId" AND a."saleLineId"=OLD.id AND a."canonicalUnits">r.units AND
+       NOT pharmacy_lot_supports_sale_unit(a."organizationId",a."branchId",a."inventoryLotId",OLD."presentationId",NEW."packLevelId",NEW."saleUnit"::text,NEW."canonicalUnitsPerSaleUnit")) OR
+   NEW."proRataCeilingMinor"<>price_cap OR NEW."grossMinor"::bigint>price_cap*NEW.quantity OR
+   NEW."grossMinor"<>OLD."grossMinor" OR NEW.quantity<=0 OR NEW."canonicalUnitsPerSaleUnit"<=0 OR
+   NEW.quantity::bigint*NEW."canonicalUnitsPerSaleUnit"<>OLD."canonicalUnits" OR
+   NEW."unitPriceMinor"<>NEW."grossMinor"/NEW.quantity OR NEW."discountMinor"<>0 OR NEW."discountKind" IS NOT NULL OR
+   NEW."approvedByUserId" IS NOT NULL OR NEW."approvalPolicy" IS NOT NULL THEN RAISE EXCEPTION 'UNIT_CHANGE_NOT_ALLOWED'; END IF;
+ RETURN NEW;
+END $$;
+CREATE TRIGGER pharmacy_unit_change_line_guard BEFORE UPDATE ON pharmacy_sale_lines
+ FOR EACH ROW EXECUTE FUNCTION pharmacy_guard_unit_change_line();
+
+CREATE FUNCTION pharmacy_check_unit_change_audit() RETURNS trigger LANGUAGE plpgsql AS $$
+BEGIN
+ IF (NEW."saleUnit",NEW."packLevelId",NEW."canonicalUnitsPerSaleUnit") IS NOT DISTINCT FROM
+    (OLD."saleUnit",OLD."packLevelId",OLD."canonicalUnitsPerSaleUnit") THEN RETURN NULL; END IF;
+ IF NOT EXISTS(SELECT 1 FROM pharmacy_sale_line_unit_changes c WHERE c."organizationId"=OLD."organizationId" AND c."branchId"=OLD."branchId"
+   AND c."saleId"=OLD."saleId" AND c."saleLineId"=OLD.id AND c."actorId"=NULLIF(current_setting('app.current_user_id',true),'')
+   AND c."fromUnit"=OLD."saleUnit"::text AND c."fromPackLevelId"=OLD."packLevelId" AND c."fromQuantity"=OLD.quantity
+   AND c."fromUnitsPerSaleUnit"=OLD."canonicalUnitsPerSaleUnit" AND c."toUnit"=NEW."saleUnit"::text
+   AND c."toPackLevelId"=NEW."packLevelId" AND c."toQuantity"=NEW.quantity AND c."toUnitsPerSaleUnit"=NEW."canonicalUnitsPerSaleUnit"
+   AND c."canonicalUnits"=OLD."canonicalUnits" AND c."grossMinor"=OLD."grossMinor"
+   AND c.xmin::text::bigint=(txid_current()%4294967296)) THEN RAISE EXCEPTION 'UNIT_CHANGE_AUDIT_REQUIRED'; END IF;
+ RETURN NULL;
+END $$;
+CREATE CONSTRAINT TRIGGER pharmacy_unit_change_audit AFTER UPDATE ON pharmacy_sale_lines
+ DEFERRABLE INITIALLY DEFERRED FOR EACH ROW EXECUTE FUNCTION pharmacy_check_unit_change_audit();
