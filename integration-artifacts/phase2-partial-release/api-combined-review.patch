index 00000000..946fce92
--- /dev/null
+++ b/src/lib/pharmacy/remove-sale-line.ts
@@ -0,0 +1,132 @@
+import { Prisma } from '@/generated/prisma/client';
+import type { ScopedDb } from '@/lib/tenancy/scoped-db';
+import type { LedgerScope } from './stock-ledger';
+import { restoreSaleAllocations } from './restore-sale-allocations';
+import {
+  authorizeControlledRestoration,
+  type ControlledRestorationPin,
+} from './controlled-restoration-authorization';
+import { appendControlledRestorations } from './controlled-register';
+
+export class SaleLineRemovalError extends Error {}
+/** Caller supplies an authorized scope and owns the transaction through COMMIT. */
+export async function removeSaleLine(
+  db: ScopedDb,
+  scope: LedgerScope,
+  input: {
+    saleId: string;
+    saleLineId: string;
+    reason: string;
+    controlledWitness?: ControlledRestorationPin;
+  }
+) {
+  const reason = input.reason.trim();
+  if (!reason || reason.length > 500) throw new SaleLineRemovalError('Enter a removal reason.');
+  await db.$executeRaw(
+    Prisma.sql`SELECT pharmacy_assert_no_payment_attempt(${scope.organizationId},${scope.branchId},${input.saleId})`
+  );
+  const sale = await db.pharmacySale.findFirst({
+    where: { id: input.saleId, organizationId: scope.organizationId, branchId: scope.branchId },
+    include: { tenders: true, refunds: true, customerOrder: true },
+  });
+  if (
+    !sale ||
+    sale.status !== 'OPEN' ||
+    sale.receiptNumber !== null ||
+    sale.completedAt !== null ||
+    sale.tenders.length ||
+    sale.refunds.length ||
+    sale.customerOrder
+  )
+    throw new SaleLineRemovalError('Only an unpaid open counter bill can be changed.');
+  const line = await db.pharmacySaleLine.findFirst({
+    where: {
+      id: input.saleLineId,
+      saleId: input.saleId,
+      organizationId: scope.organizationId,
+      branchId: scope.branchId,
+    },
+    include: {
+      medicine: true,
+      allocations: true,
+      returnLines: true,
+      unidentifiedReturnHolds: true,
+    },
+  });
+  if (!line) throw new SaleLineRemovalError('That line is not on this bill.');
+  // The sale lock serializes retries. Tombstones are stable, never a second stock reversal.
+  if (line.removedAt) return { saleLineId: line.id, removed: true as const, replayed: true };
+  if (!line.allocations.length || line.returnLines.length || line.unidentifiedReturnHolds.length)
+    throw new SaleLineRemovalError('This line needs review before it can be removed.');
+  const witness = line.medicine.controlled
+    ? await authorizeControlledRestoration(db, scope, input.controlledWitness)
+    : undefined;
+  const movements = await db.pharmacyStockMovement.findMany({
+    where: {
+      organizationId: scope.organizationId,
+      branchId: scope.branchId,
+      id: { in: line.allocations.map((a) => a.stockMovementId) },
+    },
+    orderBy: [{ inventoryLotId: 'asc' }, { stockLocationId: 'asc' }, { id: 'asc' }],
+  });
+  const [effective] = await db.$queryRaw<Array<{ units: number }>>(Prisma.sql`
+    SELECT COALESCE(SUM(a."canonicalUnits" - COALESCE(r.units,0)),0)::int AS units
+    FROM pharmacy_sale_line_allocations a
+    LEFT JOIN LATERAL (SELECT SUM(x."canonicalUnits") units FROM pharmacy_allocation_partial_releases x
+      WHERE x."organizationId"=a."organizationId" AND x."branchId"=a."branchId" AND x."allocationId"=a.id) r ON true
+    WHERE a."organizationId"=${scope.organizationId} AND a."branchId"=${scope.branchId} AND a."saleLineId"=${line.id}
+  `);
+  if (
+    movements.length !== line.allocations.length ||
+    movements.some((m) => {
+      const allocation = line.allocations.find((a) => a.stockMovementId === m.id);
+      return (
+        !allocation ||
+        m.kind !== 'SALE' ||
+        m.disposition !== 'AVAILABLE' ||
+        allocation.canonicalUnits <= 0 ||
+        m.quantityUnits !== -allocation.canonicalUnits ||
+        m.inventoryLotId !== allocation.inventoryLotId ||
+        m.stockLocationId !== allocation.stockLocationId
+      );
+    }) ||
+    effective?.units !== line.canonicalUnits
+  )
+    throw new SaleLineRemovalError('This line has inconsistent stock evidence.');
+  if (line.medicine.controlled) {
+    const entries = await db.pharmacyControlledRegisterEntry.findMany({
+      where: {
+        organizationId: scope.organizationId,
+        branchId: scope.branchId,
+        entryKind: 'SALE',
+        stockMovementId: { in: movements.map((m) => m.id) },
+      },
+    });
+    if (
+      movements.some(
+        (m) => !entries.some((e) => e.stockMovementId === m.id && e.medicineId === line.medicineId)
+      )
+    )
+      throw new SaleLineRemovalError('Controlled stock evidence needs pharmacist review.');
+  }
+  const restorationLines = await restoreSaleAllocations(db, scope, {
+    saleId: input.saleId,
+    saleLineId: line.id,
+    operation: 'remove',
+    reason,
+  });
+  await appendControlledRestorations(db, {
+    organizationId: scope.organizationId,
+    branchId: scope.branchId,
+    recordedByUserId: scope.actorId,
+    witness,
+    reason,
+    lines: restorationLines,
+  });
+  await db.$queryRaw(Prisma.sql`SELECT set_config('app.current_user_id',${scope.actorId},true)`);
+  await db.pharmacySaleLine.update({
+    where: { organizationId_id: { organizationId: scope.organizationId, id: line.id } },
+    data: { removedAt: new Date(), removedByUserId: scope.actorId, removalReason: reason },
+  });
+  return { saleLineId: line.id, removed: true as const, replayed: false };
+}
