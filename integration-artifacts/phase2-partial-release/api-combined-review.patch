@@ -0,0 +1,95 @@
+-- Requires the payment-attempt migrations through 20261106070000.
+ALTER TYPE "PharmacySaleEventKind" ADD VALUE 'LINE_REMOVED';
+ALTER TABLE pharmacy_sale_lines ADD COLUMN "removedAt" TIMESTAMP(3), ADD COLUMN "removedByUserId" TEXT, ADD COLUMN "removalReason" TEXT;
+ALTER TABLE pharmacy_sale_lines ADD CONSTRAINT pharmacy_line_removal_complete CHECK (
+  ("removedAt" IS NULL AND "removedByUserId" IS NULL AND "removalReason" IS NULL) OR
+  ("removedAt" IS NOT NULL AND length(trim("removedByUserId"))>0 AND length(trim("removalReason")) BETWEEN 1 AND 500));
+CREATE INDEX pharmacy_active_sale_lines ON pharmacy_sale_lines("organizationId","branchId","saleId") WHERE "removedAt" IS NULL;
+CREATE FUNCTION pharmacy_removed_line_guard() RETURNS TRIGGER LANGUAGE plpgsql AS $$
+DECLARE bill RECORD; actor TEXT;
+BEGIN
+ IF TG_OP='INSERT' THEN
+   IF NEW."removedAt" IS NOT NULL THEN RAISE EXCEPTION 'REMOVAL_REQUIRES_EXISTING_LINE'; END IF;
+   RETURN NEW;
+ END IF;
+ IF OLD."removedAt" IS NOT NULL THEN RAISE EXCEPTION 'REMOVED_LINE_IMMUTABLE'; END IF;
+ IF TG_OP='DELETE' THEN RAISE EXCEPTION 'SALE_LINE_EVIDENCE_IMMUTABLE'; END IF;
+ IF NEW."removedAt" IS NULL THEN RETURN NEW; END IF;
+ IF (to_jsonb(NEW)-ARRAY['removedAt','removedByUserId','removalReason']) IS DISTINCT FROM
+    (to_jsonb(OLD)-ARRAY['removedAt','removedByUserId','removalReason']) THEN RAISE EXCEPTION 'REMOVAL_CANNOT_REPRICE'; END IF;
+ PERFORM pharmacy_assert_no_payment_attempt(OLD."organizationId",OLD."branchId",OLD."saleId");
+ SELECT * INTO bill FROM pharmacy_sales WHERE "organizationId"=OLD."organizationId" AND "branchId"=OLD."branchId" AND id=OLD."saleId" FOR UPDATE;
+ IF bill.status::text<>'OPEN' OR bill."receiptNumber" IS NOT NULL OR bill."completedAt" IS NOT NULL OR
+    EXISTS(SELECT 1 FROM pharmacy_tenders WHERE "organizationId"=OLD."organizationId" AND "saleId"=OLD."saleId") OR
+    EXISTS(SELECT 1 FROM pharmacy_refunds WHERE "organizationId"=OLD."organizationId" AND "saleId"=OLD."saleId") OR
+    EXISTS(SELECT 1 FROM pharmacy_customer_orders WHERE "organizationId"=OLD."organizationId" AND "counterSaleId"=OLD."saleId")
+ THEN RAISE EXCEPTION 'REMOVAL_REQUIRES_UNPAID_OPEN_SALE'; END IF;
+ actor:=NULLIF(current_setting('app.current_user_id',true),'');
+ IF actor IS NULL OR actor<>NEW."removedByUserId" THEN RAISE EXCEPTION 'REMOVAL_ACTOR_REQUIRED'; END IF;
+ -- Stock must have been reversed exactly once before the tombstone is written.
+ IF NOT EXISTS(SELECT 1 FROM pharmacy_sale_line_allocations WHERE "organizationId"=OLD."organizationId" AND "saleLineId"=OLD.id) OR
+    EXISTS(SELECT 1 FROM pharmacy_sale_line_allocations a WHERE a."organizationId"=OLD."organizationId" AND a."saleLineId"=OLD.id AND NOT EXISTS(
+      SELECT 1 FROM pharmacy_stock_movements r WHERE r."organizationId"=a."organizationId" AND r."branchId"=OLD."branchId" AND r."reversesMovementId"=a."stockMovementId"))
+ THEN RAISE EXCEPTION 'REMOVAL_REVERSAL_REQUIRED'; END IF;
+ IF EXISTS(SELECT 1 FROM pharmacy_medicines WHERE id=OLD."medicineId" AND controlled) AND EXISTS(
+   SELECT 1 FROM pharmacy_sale_line_allocations a WHERE a."organizationId"=OLD."organizationId" AND a."saleLineId"=OLD.id AND NOT EXISTS(
+    SELECT 1 FROM pharmacy_controlled_register_entries src JOIN pharmacy_controlled_register_entries correction ON correction."organizationId"=src."organizationId" AND correction."correctsEntryId"=src.id
+    JOIN pharmacy_stock_movements r ON r."organizationId"=a."organizationId" AND r."reversesMovementId"=a."stockMovementId"
+    WHERE src."organizationId"=a."organizationId" AND src."stockMovementId"=a."stockMovementId" AND src."entryKind"::text='SALE' AND correction."restorationMovementId"=r.id))
+ THEN RAISE EXCEPTION 'CONTROLLED_REMOVAL_RESTORATION_REQUIRED'; END IF;
+ RETURN NEW;
+END $$;
+CREATE TRIGGER pharmacy_removed_line BEFORE INSERT OR UPDATE OR DELETE ON pharmacy_sale_lines FOR EACH ROW EXECUTE FUNCTION pharmacy_removed_line_guard();
+-- Preparation's authoritative remaining balance uses the same predicate: removedAt IS NULL.
+CREATE OR REPLACE FUNCTION pharmacy_payment_attempt_prepare_guard() RETURNS TRIGGER LANGUAGE plpgsql AS $$
+DECLARE bill RECORD; remaining BIGINT;
+BEGIN
+ SELECT s.*,o.currency AS "billCurrency" INTO bill FROM pharmacy_sales s JOIN organizations o ON o.id=s."organizationId"
+ JOIN pharmacy_branches b ON b.id=s."branchId" AND b."organizationId"=s."organizationId" AND b.active
+ WHERE s.id=NEW."saleId" AND s."organizationId"=NEW."organizationId" AND s."branchId"=NEW."branchId" FOR UPDATE OF s;
+ IF NOT FOUND OR (NEW.source<>'LEGACY_CAPTURE' AND bill.status::text<>'OPEN') THEN RAISE EXCEPTION 'PAYMENT_SALE_NOT_OPEN'; END IF;
+ IF NEW."billRevision"<>bill."paymentRevision" OR NEW.currency<>bill."billCurrency" OR NEW.state<>(CASE WHEN NEW.source='LEGACY_CAPTURE' THEN 'UNKNOWN' ELSE 'PREPARED' END) THEN RAISE EXCEPTION 'PAYMENT_BILL_CHANGED'; END IF;
+ SELECT coalesce((SELECT sum("grossMinor"::bigint-"discountMinor") FROM pharmacy_sale_lines WHERE "organizationId"=NEW."organizationId" AND "branchId"=NEW."branchId" AND "saleId"=NEW."saleId" AND "removedAt" IS NULL),0)
+ -coalesce((SELECT sum("amountMinor"::bigint) FROM pharmacy_tenders WHERE "organizationId"=NEW."organizationId" AND "branchId"=NEW."branchId" AND "saleId"=NEW."saleId"),0) INTO remaining;
+ IF NEW.source='PRECOLLECTION' AND NEW."amountMinor">remaining THEN RAISE EXCEPTION 'PAYMENT_AMOUNT_EXCEEDS_BALANCE'; END IF;
+ RETURN NEW;
+END $$;
+-- New clinical actions on removed lines are rejected under the same sale lock.
+CREATE FUNCTION pharmacy_review_active_line_guard() RETURNS TRIGGER LANGUAGE plpgsql AS $$
+DECLARE line_id TEXT; linked RECORD;
+BEGIN
+ IF TG_TABLE_NAME='pharmacy_pharmacist_review_decisions' THEN
+   SELECT "saleLineId" INTO line_id FROM pharmacy_pharmacist_review_items WHERE "organizationId"=NEW."organizationId" AND id=NEW."reviewItemId";
+ ELSE line_id:=NEW."saleLineId"; END IF;
+ SELECT "saleId","branchId" INTO linked FROM pharmacy_sale_lines WHERE "organizationId"=NEW."organizationId" AND id=line_id;
+ IF NOT FOUND THEN RAISE EXCEPTION 'REVIEW_LINE_NOT_FOUND'; END IF;
+ PERFORM 1 FROM pharmacy_sales WHERE "organizationId"=NEW."organizationId" AND "branchId"=linked."branchId" AND id=linked."saleId" FOR UPDATE;
+ IF NOT EXISTS(SELECT 1 FROM pharmacy_sale_lines WHERE "organizationId"=NEW."organizationId" AND id=line_id AND "removedAt" IS NULL) THEN RAISE EXCEPTION 'REVIEW_LINE_REMOVED'; END IF;
+ RETURN NEW;
+END $$;
+CREATE TRIGGER pharmacy_review_active_line BEFORE INSERT ON pharmacy_pharmacist_review_items FOR EACH ROW EXECUTE FUNCTION pharmacy_review_active_line_guard();
+CREATE TRIGGER pharmacy_review_active_line BEFORE INSERT ON pharmacy_pharmacist_review_decisions FOR EACH ROW EXECUTE FUNCTION pharmacy_review_active_line_guard();
+CREATE TRIGGER pharmacy_substitution_active_line BEFORE INSERT ON pharmacy_substitution_records FOR EACH ROW EXECUTE FUNCTION pharmacy_review_active_line_guard();
+
+CREATE FUNCTION pharmacy_audit_removed_line() RETURNS TRIGGER LANGUAGE plpgsql AS $$
+BEGIN
+ IF OLD."removedAt" IS NULL AND NEW."removedAt" IS NOT NULL THEN
+ INSERT INTO pharmacy_sale_events(id,"organizationId","branchId","saleId",kind,"actorId",reason,payload,"occurredAt")
+ VALUES(gen_random_uuid()::text,NEW."organizationId",NEW."branchId",NEW."saleId",'LINE_REMOVED',NEW."removedByUserId",NEW."removalReason",jsonb_build_object('saleLineId',NEW.id),NEW."removedAt");
+ END IF; RETURN NEW;
+END $$;
+CREATE TRIGGER pharmacy_audit_removed_line AFTER UPDATE ON pharmacy_sale_lines FOR EACH ROW EXECUTE FUNCTION pharmacy_audit_removed_line();
+-- Sale-linked fills keep their evidence, but no new fill may consume a removed line.
+CREATE FUNCTION pharmacy_fill_active_line_guard() RETURNS TRIGGER LANGUAGE plpgsql AS $$
+DECLARE line_id TEXT; linked RECORD;
+BEGIN
+ IF NEW."idempotencyKey" LIKE 'rx-reference:%' THEN line_id:=substr(NEW."idempotencyKey",14);
+ ELSIF NEW."idempotencyKey" LIKE 'controlled:%' THEN line_id:=substr(NEW."idempotencyKey",12);
+ ELSE RETURN NEW; END IF;
+ SELECT "saleId","branchId" INTO linked FROM pharmacy_sale_lines WHERE "organizationId"=NEW."organizationId" AND id=line_id;
+ IF NOT FOUND THEN RAISE EXCEPTION 'FILL_LINE_NOT_FOUND'; END IF;
+ PERFORM 1 FROM pharmacy_sales WHERE "organizationId"=NEW."organizationId" AND "branchId"=linked."branchId" AND id=linked."saleId" FOR UPDATE;
+ IF NOT EXISTS(SELECT 1 FROM pharmacy_sale_lines WHERE "organizationId"=NEW."organizationId" AND id=line_id AND "removedAt" IS NULL) THEN RAISE EXCEPTION 'FILL_LINE_REMOVED'; END IF;
+ RETURN NEW;
+END $$;
+CREATE TRIGGER pharmacy_fill_active_line BEFORE INSERT ON pharmacy_prescription_fills FOR EACH ROW EXECUTE FUNCTION pharmacy_fill_active_line_guard();
diff --git a/prisma/migrations/20261106110000_pharmacy_allocation_price_evidence/migration.sql b/prisma/migrations/20261106110000_pharmacy_allocation_price_evidence/migration.sql
