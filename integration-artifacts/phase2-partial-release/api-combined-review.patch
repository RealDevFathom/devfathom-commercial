diff --git a/src/lib/pharmacy/immediate-add-sale-line.ts b/src/lib/pharmacy/immediate-add-sale-line.ts
new file mode 100644
index 00000000..614c0900
--- /dev/null
+++ b/src/lib/pharmacy/immediate-add-sale-line.ts
@@ -0,0 +1,193 @@
+import { createHash } from 'node:crypto';
+import { Prisma } from '@/generated/prisma/client';
+import type { ScopedDb } from '@/lib/tenancy/scoped-db';
+import type { LedgerScope } from './stock-ledger';
+import { addSaleLine } from './sales';
+import { increaseSaleLineQuantity } from './increase-sale-line-quantity';
+import { saleUnitOptions } from './counter-pricing';
+import { immediateAddLineSchema, type ImmediateAddLineInput } from './counter-line-command';
+
+/** Internal contract for a UI adapter. The caller must authorize counter/branch
+ * access and own the transaction; do not expose a route until pack and active
+ * allocation reader integrations are complete. Clinical selections fail closed. */
+export async function immediateAddSaleLine(
+  db: ScopedDb,
+  scope: LedgerScope,
+  rawInput: ImmediateAddLineInput
+) {
+  const input = immediateAddLineSchema.parse(rawInput);
+  if (
+    !input.idempotencyKey.trim() ||
+    input.idempotencyKey.length > 160 ||
+    !Number.isSafeInteger(input.canonicalUnitsPerSaleUnit) ||
+    input.canonicalUnitsPerSaleUnit < 1 ||
+    input.canonicalUnitsPerSaleUnit > 2_147_483_647
+  )
+    throw new Error('INVALID_IMMEDIATE_ADD');
+  await db.$executeRaw(
+    Prisma.sql`SELECT pharmacy_assert_no_payment_attempt(${scope.organizationId},${scope.branchId},${input.saleId})`
+  );
+  await db.$queryRaw(Prisma.sql`SELECT set_config('app.current_user_id',${scope.actorId},true)`);
+  const sale = await db.pharmacySale.findFirst({
+    where: { id: input.saleId, organizationId: scope.organizationId, branchId: scope.branchId },
+    include: { tenders: true, refunds: true, customerOrder: true },
+  });
+  if (
+    !sale ||
+    sale.status !== 'OPEN' ||
+    sale.receiptNumber ||
+    sale.completedAt ||
+    sale.tenders.length ||
+    sale.refunds.length ||
+    sale.customerOrder
+  )
+    throw new Error('SALE_NOT_EDITABLE');
+  const [previous] = await db.$queryRaw<
+    Array<{
+      branchId: string;
+      saleId: string;
+      saleLineId: string;
+      actorId: string;
+      medicineId: string;
+      presentationId: string;
+      packLevelId: string;
+      saleUnit: string;
+      unitsPerSaleUnit: number;
+      resultQuantity: number;
+      source: 'NEW' | 'INCREASE';
+    }>
+  >(Prisma.sql`
+    SELECT "branchId","saleId","saleLineId","actorId","medicineId","presentationId","packLevelId","saleUnit",
+      "unitsPerSaleUnit","resultQuantity",source FROM pharmacy_immediate_add_requests
+    WHERE "organizationId"=${scope.organizationId} AND "idempotencyKey"=${input.idempotencyKey}`);
+  if (previous) {
+    if (
+      previous.branchId !== scope.branchId ||
+      previous.saleId !== input.saleId ||
+      previous.actorId !== scope.actorId ||
+      previous.medicineId !== input.medicineId ||
+      previous.presentationId !== input.presentationId ||
+      previous.packLevelId !== input.packLevelId ||
+      previous.saleUnit !== input.saleUnit ||
+      previous.unitsPerSaleUnit !== input.canonicalUnitsPerSaleUnit
+    )
+      throw new Error('IMMEDIATE_ADD_IDEMPOTENCY_CONFLICT');
+    return {
+      saleLineId: previous.saleLineId,
+      quantity: previous.resultQuantity,
+      source: previous.source,
+      replayed: true as const,
+    };
+  }
+  await db.$queryRaw(Prisma.sql`SELECT id FROM pharmacy_medicines
+    WHERE "organizationId"=${scope.organizationId} AND id=${input.medicineId} FOR SHARE`);
+  const medicine = await db.medicine.findFirst({
+    where: { organizationId: scope.organizationId, id: input.medicineId, saleable: true },
+    select: { otc: true, rx: true, restricted: true, controlled: true, highAlert: true },
+  });
+  if (
+    !medicine ||
+    !medicine.otc ||
+    medicine.rx ||
+    medicine.restricted ||
+    medicine.controlled ||
+    medicine.highAlert
+  )
+    throw new Error('CLINICAL_FLOW_REQUIRED');
+  const presentation = await db.presentation.findFirst({
+    where: {
+      organizationId: scope.organizationId,
+      id: input.presentationId,
+      medicineId: input.medicineId,
+    },
+    select: { id: true },
+  });
+  if (!presentation) throw new Error('PRESENTATION_NOT_FOUND');
+  const matches = await db.$queryRaw<
+    Array<{
+      id: string;
+      quantity: number;
+      presentationId: string;
+      packLevelId: string;
+      canonicalUnitsPerSaleUnit: number;
+    }>
+  >(Prisma.sql`
+    SELECT id,quantity,"presentationId","packLevelId","canonicalUnitsPerSaleUnit" FROM pharmacy_sale_lines
+    WHERE "organizationId"=${scope.organizationId} AND "branchId"=${scope.branchId} AND "saleId"=${input.saleId}
+      AND "medicineId"=${input.medicineId} AND "saleUnit"::text=${input.saleUnit} AND "removedAt" IS NULL FOR UPDATE`);
+  if (matches.length > 1) throw new Error('AMBIGUOUS_EXISTING_LINE');
+  const key =
+    'immediate:' +
+    createHash('sha256')
+      .update(JSON.stringify([scope.organizationId, input.idempotencyKey]))
+      .digest('hex');
+  let saleLineId: string, quantity: number, source: 'NEW' | 'INCREASE';
+  if (matches.length) {
+    const line = matches[0]!;
+    if (
+      line.presentationId !== input.presentationId ||
+      line.packLevelId !== input.packLevelId ||
+      line.canonicalUnitsPerSaleUnit !== input.canonicalUnitsPerSaleUnit
+    )
+      throw new Error('EXISTING_LINE_CONFIGURATION_MISMATCH');
+    const increased = await increaseSaleLineQuantity(db, scope, {
+      saleId: input.saleId,
+      saleLineId: line.id,
+      fromQuantity: line.quantity,
+      toQuantity: line.quantity + 1,
+      idempotencyKey: key,
+    });
+    saleLineId = increased.saleLineId;
+    quantity = increased.quantity;
+    source = 'INCREASE';
+  } else {
+    const added = await addSaleLine(db, scope, {
+      saleId: input.saleId,
+      medicineId: input.medicineId,
+      presentationId: input.presentationId,
+      packLevelId: input.packLevelId,
+      saleUnit: input.saleUnit,
+      quantity: 1,
+      canonicalUnitsPerSaleUnit: input.canonicalUnitsPerSaleUnit,
+      idempotencyKey: key,
+    });
+    const lots = await db.pharmacyInventoryLot.findMany({
+      where: {
+        organizationId: scope.organizationId,
+        branchId: scope.branchId,
+        id: { in: added.allocation.allocations.map((part) => part.inventoryLotId) },
+      },
+    });
+    const levels = await db.packLevel.findMany({
+      where: { organizationId: scope.organizationId, presentationId: input.presentationId },
+      select: { id: true, level: true, parentPackLevelId: true, unitsPerParent: true },
+    });
+    if (
+      lots.length !==
+        new Set(added.allocation.allocations.map((part) => part.inventoryLotId)).size ||
+      lots.some(
+        (lot) =>
+          !saleUnitOptions({
+            packLevels: levels,
+            rootPackLevelId: lot.packLevelId,
+            unitsPerPack: lot.unitsPerPack,
+          }).some(
+            (option) =>
+              option.kind === input.saleUnit &&
+              option.packLevelId === input.packLevelId &&
+              option.canonicalUnitsPerSaleUnit === input.canonicalUnitsPerSaleUnit
+          )
+      )
+    )
+      throw new Error('UNIT_NOT_SOLD');
+    saleLineId = added.line.id;
+    quantity = added.line.quantity;
+    source = 'NEW';
+  }
+  await db.$executeRaw(Prisma.sql`INSERT INTO pharmacy_immediate_add_requests
+    ("organizationId","branchId","saleId","saleLineId","idempotencyKey","actorId","medicineId","presentationId","packLevelId",
+     "saleUnit","unitsPerSaleUnit","resultQuantity",source,"underlyingKey")
+    VALUES (${scope.organizationId},${scope.branchId},${input.saleId},${saleLineId},${input.idempotencyKey},${scope.actorId},${input.medicineId},
+      ${input.presentationId},${input.packLevelId},${input.saleUnit},${input.canonicalUnitsPerSaleUnit},${quantity},${source},${key})`);
+  return { saleLineId, quantity, source, replayed: false as const };
+}
diff --git a/src/lib/pharmacy/increase-sale-line-quantity.ts b/src/lib/pharmacy/increase-sale-line-quantity.ts
new file mode 100644
index 00000000..ac922d56
--- /dev/null
+++ b/src/lib/pharmacy/increase-sale-line-quantity.ts
@@ -0,0 +1,238 @@
+import { Prisma } from '@/generated/prisma/client';
+import type { ScopedDb } from '@/lib/tenancy/scoped-db';
+import type { LedgerScope } from './stock-ledger';
+import { allocateForSale } from './stock-ledger';
+import { planAllocationReduction } from './bill-line-allocation-plan';
+import { priceFromLot } from './medicine';
+import { saleUnitOptions } from './counter-pricing';
+import { changeLineQuantitySchema, type ChangeLineQuantityInput } from './counter-line-command';
+
+type Existing = {
+  allocationId: string;
+  originalUnits: number;
+  remainingUnits: number;
+  priceNumerator: number;
+  denominator: number;
+  remainder: number;
+  grossMinor: number;
+  unitCostMinor: number;
+};
+
+/** Internal, same-unit increase. Caller authorizes scope and owns the transaction.
+ * Never expose until active-allocation readers and pack binding are integrated. */
+export async function increaseSaleLineQuantity(
+  db: ScopedDb,
+  scope: LedgerScope,
+  rawInput: ChangeLineQuantityInput
+) {
+  const input = changeLineQuantitySchema.parse(rawInput);
+  if (
+    !Number.isSafeInteger(input.fromQuantity) ||
+    !Number.isSafeInteger(input.toQuantity) ||
+    input.fromQuantity < 1 ||
+    input.toQuantity <= input.fromQuantity ||
+    !input.idempotencyKey.trim() ||
+    input.idempotencyKey.length > 160
+  )
+    throw new Error('INVALID_LINE_EDIT');
+  await db.$executeRaw(
+    Prisma.sql`SELECT pharmacy_assert_no_payment_attempt(${scope.organizationId},${scope.branchId},${input.saleId})`
+  );
+  await db.$queryRaw(Prisma.sql`SELECT set_config('app.current_user_id',${scope.actorId},true)`);
+  const sale = await db.pharmacySale.findFirst({
+    where: {
+      id: input.saleId,
+      organizationId: scope.organizationId,
+      branchId: scope.branchId,
+    },
+    include: { tenders: true, refunds: true, customerOrder: true },
+  });
+  if (
+    !sale ||
+    sale.status !== 'OPEN' ||
+    sale.receiptNumber ||
+    sale.completedAt ||
+    sale.tenders.length ||
+    sale.refunds.length ||
+    sale.customerOrder
+  )
+    throw new Error('SALE_NOT_EDITABLE');
+  const previous = await db.$queryRaw<
+    Array<{
+      branchId: string;
+      saleId: string;
+      saleLineId: string;
+      actorId: string;
+      fromQuantity: number;
+      toQuantity: number;
+    }>
+  >(Prisma.sql`
+    SELECT "branchId","saleId","saleLineId","actorId","fromQuantity","toQuantity"
+    FROM pharmacy_sale_line_edit_requests WHERE "organizationId"=${scope.organizationId} AND "idempotencyKey"=${input.idempotencyKey}`);
+  if (previous.length) {
+    const p = previous[0]!;
+    if (
+      p.branchId !== scope.branchId ||
+      p.saleId !== input.saleId ||
+      p.saleLineId !== input.saleLineId ||
+      p.actorId !== scope.actorId ||
+      p.fromQuantity !== input.fromQuantity ||
+      p.toQuantity !== input.toQuantity
+    )
+      throw new Error('EDIT_IDEMPOTENCY_CONFLICT');
+    return { saleLineId: input.saleLineId, quantity: input.toQuantity, replayed: true as const };
+  }
+  const [active] = await db.$queryRaw<Array<{ id: string }>>(Prisma.sql`
+    SELECT id FROM pharmacy_sale_lines WHERE "organizationId"=${scope.organizationId} AND "branchId"=${scope.branchId}
+      AND "saleId"=${input.saleId} AND id=${input.saleLineId} AND "removedAt" IS NULL FOR UPDATE`);
+  if (!active) throw new Error('LINE_NOT_EDITABLE');
+  await db.$queryRaw(Prisma.sql`SELECT m.id FROM pharmacy_medicines m JOIN pharmacy_sale_lines l
+    ON l."organizationId"=m."organizationId" AND l."medicineId"=m.id
+    WHERE l."organizationId"=${scope.organizationId} AND l."branchId"=${scope.branchId} AND l.id=${input.saleLineId} FOR SHARE OF m`);
+  const line = await db.pharmacySaleLine.findFirstOrThrow({
+    where: {
+      id: input.saleLineId,
+      organizationId: scope.organizationId,
+      branchId: scope.branchId,
+      saleId: input.saleId,
+    },
+    include: { medicine: true, returnLines: true, unidentifiedReturnHolds: true },
+  });
+  if (
+    line.quantity !== input.fromQuantity ||
+    line.medicine.rx ||
+    line.medicine.restricted ||
+    line.medicine.controlled ||
+    line.medicine.highAlert ||
+    line.prescriptionLineId ||
+    line.returnLines.length ||
+    line.unidentifiedReturnHolds.length
+  )
+    throw new Error('LINE_NOT_EDITABLE');
+  const addedUnits = (input.toQuantity - input.fromQuantity) * line.canonicalUnitsPerSaleUnit;
+  const targetUnits = input.toQuantity * line.canonicalUnitsPerSaleUnit;
+  if (
+    !Number.isSafeInteger(addedUnits) ||
+    !Number.isSafeInteger(targetUnits) ||
+    targetUnits > 2_147_483_647
+  )
+    throw new Error('INVALID_LINE_EDIT');
+  const evidence = await db.$queryRaw<Existing[]>(Prisma.sql`
+    SELECT e."allocationId",e."originalUnits",(e."originalUnits"-coalesce(r.units,0))::int AS "remainingUnits",
+      e."priceNumerator",e.denominator,e.remainder,e."grossMinor",lot."unitCostMinor"
+    FROM pharmacy_sale_line_allocations a JOIN pharmacy_allocation_price_evidence e ON e."organizationId"=a."organizationId" AND e."allocationId"=a.id
+    JOIN pharmacy_inventory_lots lot ON lot."organizationId"=a."organizationId" AND lot.id=a."inventoryLotId"
+    LEFT JOIN LATERAL (SELECT sum(x."canonicalUnits") AS units FROM pharmacy_allocation_partial_releases x
+      WHERE x."organizationId"=a."organizationId" AND x."allocationId"=a.id) r ON true
+    WHERE a."organizationId"=${scope.organizationId} AND a."branchId"=${scope.branchId} AND a."saleLineId"=${line.id} ORDER BY e.ordinal`);
+  const count = await db.pharmacySaleLineAllocation.count({
+    where: { organizationId: scope.organizationId, saleLineId: line.id },
+  });
+  if (
+    !count ||
+    evidence.length !== count ||
+    evidence.reduce((n, x) => n + x.remainingUnits, 0) !== line.canonicalUnits ||
+    planAllocationReduction(evidence, line.canonicalUnits).retainedGrossMinor !== line.grossMinor
+  )
+    throw new Error('ALLOCATION_EVIDENCE_MISSING');
+  const allocation = await allocateForSale(db, scope, {
+    medicineId: line.medicineId,
+    requiredUnits: addedUnits,
+    at: new Date(),
+    idempotencyKeyPrefix: `sale:${line.idempotencyKey}`,
+    movementStartIndex: count,
+  });
+  const lots = await db.pharmacyInventoryLot.findMany({
+    where: {
+      organizationId: scope.organizationId,
+      branchId: scope.branchId,
+      id: { in: allocation.allocations.map((x) => x.inventoryLotId) },
+    },
+  });
+  const levels = await db.packLevel.findMany({
+    where: { organizationId: scope.organizationId, presentationId: line.presentationId },
+    select: { id: true, level: true, parentPackLevelId: true, unitsPerParent: true },
+  });
+  let remainder = 0,
+    addedGross = 0;
+  let totalCost = evidence.reduce((n, x) => n + x.remainingUnits * x.unitCostMinor, 0);
+  let ceiling = line.proRataCeilingMinor;
+  const priced = allocation.allocations.map((part) => {
+    const lot = lots.find((x) => x.id === part.inventoryLotId);
+    if (!lot) throw new Error('ALLOCATION_EVIDENCE_MISSING');
+    if (
+      !saleUnitOptions({
+        packLevels: levels,
+        rootPackLevelId: lot.packLevelId,
+        unitsPerPack: lot.unitsPerPack,
+      }).some(
+        (option) =>
+          option.kind === line.saleUnit &&
+          option.packLevelId === line.packLevelId &&
+          option.canonicalUnitsPerSaleUnit === line.canonicalUnitsPerSaleUnit
+      )
+    )
+      throw new Error('UNIT_NOT_SOLD');
+    const price = priceFromLot({
+      printedMrpMinor: lot.printedMrpMinor,
+      canonicalUnitsInPack: lot.unitsPerPack,
+      canonicalUnitsPerSaleUnit: line.canonicalUnitsPerSaleUnit,
+    });
+    const numerator = remainder + part.units * price.unitPriceMinor;
+    if (!Number.isSafeInteger(numerator)) throw new Error('INVALID_LINE_EDIT');
+    const grossMinor = Math.floor(numerator / line.canonicalUnitsPerSaleUnit);
+    const before = remainder;
+    remainder = numerator % line.canonicalUnitsPerSaleUnit;
+    addedGross += grossMinor;
+    totalCost += part.units * lot.unitCostMinor;
+    ceiling = Math.max(ceiling, price.proRataCeilingMinor);
+    return { part, price: price.unitPriceMinor, grossMinor, remainder: before };
+  });
+  const gross = line.grossMinor + addedGross;
+  if (
+    !Number.isSafeInteger(gross) ||
+    gross > 2_147_483_647 ||
+    !Number.isSafeInteger(totalCost) ||
+    Math.ceil(totalCost / input.toQuantity) > 2_147_483_647
+  )
+    throw new Error('INVALID_LINE_EDIT');
+  // Updating the line first lets the database prove the new snapshots were captured in this transaction.
+  await db.pharmacySaleLine.update({
+    where: { organizationId_id: { organizationId: scope.organizationId, id: line.id } },
+    data: {
+      quantity: input.toQuantity,
+      canonicalUnits: targetUnits,
+      grossMinor: gross,
+      unitPriceMinor: Math.floor(gross / input.toQuantity),
+      unitCostMinor: Math.ceil(totalCost / input.toQuantity),
+      proRataCeilingMinor: ceiling,
+      discountMinor: 0,
+      discountKind: null,
+      approvedByUserId: null,
+      approvalPolicy: null,
+    },
+  });
+  for (const [index, row] of priced.entries()) {
+    const recorded = await db.pharmacySaleLineAllocation.create({
+      data: {
+        organizationId: scope.organizationId,
+        branchId: scope.branchId,
+        saleLineId: line.id,
+        inventoryLotId: row.part.inventoryLotId,
+        stockLocationId: row.part.stockLocationId,
+        canonicalUnits: row.part.units,
+        grossMinor: row.grossMinor,
+        discountMinor: 0,
+        stockMovementId: allocation.movementIds[index]!,
+      },
+    });
+    await db.$executeRaw(Prisma.sql`INSERT INTO pharmacy_allocation_price_evidence
+      ("organizationId","branchId","allocationId",ordinal,"originalUnits","priceNumerator",denominator,remainder,"grossMinor","requestKey")
+      VALUES (${scope.organizationId},${scope.branchId},${recorded.id},${count + index},${row.part.units},${row.price},
+        ${line.canonicalUnitsPerSaleUnit},${row.remainder},${row.grossMinor},${input.idempotencyKey})`);
+  }
+  await db.$executeRaw(Prisma.sql`INSERT INTO pharmacy_sale_line_edit_requests
+    ("organizationId","branchId","saleId","saleLineId","idempotencyKey","actorId","fromQuantity","toQuantity")
+    VALUES (${scope.organizationId},${scope.branchId},${input.saleId},${input.saleLineId},${input.idempotencyKey},${scope.actorId},${input.fromQuantity},${input.toQuantity})`);
+  return { saleLineId: input.saleLineId, quantity: input.toQuantity, replayed: false as const };
+}
