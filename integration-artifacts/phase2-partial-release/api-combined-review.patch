@@ -0,0 +1,54 @@
+import { z } from 'zod';
+
+// These client/server command schemas validate shape only. A future router must
+// still check counter authorization, branch assignment and integrated safety.
+const id = z.string().trim().min(1).max(128);
+const idempotencyKey = z.string().trim().min(1).max(160);
+const quantity = z.number().int().positive().max(2_147_483_647);
+const saleUnit = z.enum(['PACK', 'STRIP', 'UNIT']);
+
+export const immediateAddLineSchema = z
+  .object({
+    saleId: id,
+    medicineId: id,
+    presentationId: id,
+    packLevelId: id,
+    saleUnit,
+    canonicalUnitsPerSaleUnit: quantity,
+    idempotencyKey,
+  })
+  .strict();
+export type ImmediateAddLineInput = z.infer<typeof immediateAddLineSchema>;
+
+export const changeLineQuantitySchema = z
+  .object({
+    saleId: id,
+    saleLineId: id,
+    fromQuantity: quantity,
+    toQuantity: quantity,
+    idempotencyKey,
+  })
+  .strict();
+export type ChangeLineQuantityInput = z.infer<typeof changeLineQuantitySchema>;
+
+export const changeLineUnitSchema = z
+  .object({
+    saleId: id,
+    saleLineId: id,
+    fromQuantity: quantity,
+    fromUnit: saleUnit,
+    fromPackLevelId: id,
+    toUnit: saleUnit,
+    toPackLevelId: id,
+    idempotencyKey,
+  })
+  .strict();
+export type ChangeLineUnitInput = z.infer<typeof changeLineUnitSchema>;
+
+/** Shape for a future authenticated counter endpoint. This does not enable it. */
+export const counterLineCommandSchema = z.discriminatedUnion('kind', [
+  immediateAddLineSchema.extend({ kind: z.literal('immediateAdd'), branchId: id }).strict(),
+  changeLineQuantitySchema.extend({ kind: z.literal('quantity'), branchId: id }).strict(),
+  changeLineUnitSchema.extend({ kind: z.literal('unit'), branchId: id }).strict(),
+]);
+export type CounterLineCommand = z.infer<typeof counterLineCommandSchema>;
