diff --git a/src/lib/pharmacy/change-sale-line-unit.ts b/src/lib/pharmacy/change-sale-line-unit.ts
new file mode 100644
index 00000000..614787e0
--- /dev/null
+++ b/src/lib/pharmacy/change-sale-line-unit.ts
@@ -0,0 +1,204 @@
+import { Prisma } from '@/generated/prisma/client';
+import type { ScopedDb } from '@/lib/tenancy/scoped-db';
+import type { LedgerScope } from './stock-ledger';
+import { saleUnitOptions } from './counter-pricing';
+import { planAllocationReduction } from './bill-line-allocation-plan';
+import { changeLineUnitSchema, type ChangeLineUnitInput } from './counter-line-command';
+
+type UnitEvidence = {
+  allocationId: string;
+  originalUnits: number;
+  remainingUnits: number;
+  priceNumerator: number;
+  denominator: number;
+  remainder: number;
+  grossMinor: number;
+  unitCostMinor: number;
+  rootPackLevelId: string;
+  unitsPerPack: number;
+};
+
+/** Internal only: caller authorizes actor and branch and owns the transaction.
+ * No route may expose this until pack and active-allocation readers are integrated. */
+export async function changeSaleLineUnit(
+  db: ScopedDb,
+  scope: LedgerScope,
+  rawInput: ChangeLineUnitInput
+) {
+  const input = changeLineUnitSchema.parse(rawInput);
+  if (
+    !Number.isSafeInteger(input.fromQuantity) ||
+    input.fromQuantity < 1 ||
+    !input.idempotencyKey.trim() ||
+    input.idempotencyKey.length > 160 ||
+    !input.fromPackLevelId ||
+    !input.toPackLevelId
+  )
+    throw new Error('INVALID_UNIT_CHANGE');
+  await db.$executeRaw(
+    Prisma.sql`SELECT pharmacy_assert_no_payment_attempt(${scope.organizationId},${scope.branchId},${input.saleId})`
+  );
+  await db.$queryRaw(Prisma.sql`SELECT set_config('app.current_user_id',${scope.actorId},true)`);
+  const sale = await db.pharmacySale.findFirst({
+    where: { id: input.saleId, organizationId: scope.organizationId, branchId: scope.branchId },
+    include: { tenders: true, refunds: true, customerOrder: true },
+  });
+  if (
+    !sale ||
+    sale.status !== 'OPEN' ||
+    sale.receiptNumber ||
+    sale.completedAt ||
+    sale.tenders.length ||
+    sale.refunds.length ||
+    sale.customerOrder
+  )
+    throw new Error('SALE_NOT_EDITABLE');
+  const [previous] = await db.$queryRaw<
+    Array<{
+      branchId: string;
+      saleId: string;
+      saleLineId: string;
+      actorId: string;
+      fromQuantity: number;
+      fromUnit: string;
+      fromPackLevelId: string;
+      toUnit: string;
+      toPackLevelId: string;
+      toQuantity: number;
+      toUnitsPerSaleUnit: number;
+    }>
+  >(Prisma.sql`
+    SELECT "branchId","saleId","saleLineId","actorId","fromQuantity","fromUnit","fromPackLevelId",
+      "toUnit","toPackLevelId","toQuantity","toUnitsPerSaleUnit" FROM pharmacy_sale_line_unit_changes
+    WHERE "organizationId"=${scope.organizationId} AND "idempotencyKey"=${input.idempotencyKey}`);
+  if (previous) {
+    if (
+      previous.branchId !== scope.branchId ||
+      previous.saleId !== input.saleId ||
+      previous.saleLineId !== input.saleLineId ||
+      previous.actorId !== scope.actorId ||
+      previous.fromQuantity !== input.fromQuantity ||
+      previous.fromUnit !== input.fromUnit ||
+      previous.fromPackLevelId !== input.fromPackLevelId ||
+      previous.toUnit !== input.toUnit ||
+      previous.toPackLevelId !== input.toPackLevelId
+    )
+      throw new Error('UNIT_CHANGE_IDEMPOTENCY_CONFLICT');
+    return {
+      saleLineId: input.saleLineId,
+      quantity: previous.toQuantity,
+      canonicalUnitsPerSaleUnit: previous.toUnitsPerSaleUnit,
+      replayed: true as const,
+    };
+  }
+  const [active] = await db.$queryRaw<Array<{ id: string }>>(Prisma.sql`
+    SELECT id FROM pharmacy_sale_lines WHERE "organizationId"=${scope.organizationId} AND "branchId"=${scope.branchId}
+      AND "saleId"=${input.saleId} AND id=${input.saleLineId} AND "removedAt" IS NULL FOR UPDATE`);
+  if (!active) throw new Error('LINE_NOT_EDITABLE');
+  await db.$queryRaw(Prisma.sql`SELECT m.id FROM pharmacy_medicines m JOIN pharmacy_sale_lines l
+    ON l."organizationId"=m."organizationId" AND l."medicineId"=m.id
+    WHERE l."organizationId"=${scope.organizationId} AND l."branchId"=${scope.branchId} AND l.id=${input.saleLineId} FOR SHARE OF m`);
+  const line = await db.pharmacySaleLine.findFirstOrThrow({
+    where: {
+      organizationId: scope.organizationId,
+      branchId: scope.branchId,
+      saleId: input.saleId,
+      id: input.saleLineId,
+    },
+    include: { medicine: true, returnLines: true, unidentifiedReturnHolds: true },
+  });
+  if (
+    line.quantity !== input.fromQuantity ||
+    line.saleUnit !== input.fromUnit ||
+    line.packLevelId !== input.fromPackLevelId ||
+    line.medicine.rx ||
+    line.medicine.restricted ||
+    line.medicine.controlled ||
+    line.medicine.highAlert ||
+    line.prescriptionLineId ||
+    line.returnLines.length ||
+    line.unidentifiedReturnHolds.length
+  )
+    throw new Error('LINE_NOT_EDITABLE');
+  const rows = await db.$queryRaw<UnitEvidence[]>(Prisma.sql`
+    SELECT e."allocationId",e."originalUnits",(e."originalUnits"-coalesce(r.units,0))::int AS "remainingUnits",
+      e."priceNumerator",e.denominator,e.remainder,e."grossMinor",lot."unitCostMinor",
+      lot."packLevelId" AS "rootPackLevelId",lot."unitsPerPack"
+    FROM pharmacy_sale_line_allocations a JOIN pharmacy_allocation_price_evidence e ON e."organizationId"=a."organizationId" AND e."allocationId"=a.id
+    JOIN pharmacy_inventory_lots lot ON lot."organizationId"=a."organizationId" AND lot.id=a."inventoryLotId"
+    LEFT JOIN LATERAL (SELECT sum(x."canonicalUnits") units FROM pharmacy_allocation_partial_releases x
+      WHERE x."organizationId"=a."organizationId" AND x."allocationId"=a.id) r ON true
+    WHERE a."organizationId"=${scope.organizationId} AND a."branchId"=${scope.branchId} AND a."saleLineId"=${line.id} ORDER BY e.ordinal`);
+  const count = await db.pharmacySaleLineAllocation.count({
+    where: { organizationId: scope.organizationId, saleLineId: line.id },
+  });
+  if (
+    !count ||
+    rows.length !== count ||
+    rows.reduce((sum, row) => sum + row.remainingUnits, 0) !== line.canonicalUnits ||
+    planAllocationReduction(rows, line.canonicalUnits).retainedGrossMinor !== line.grossMinor
+  )
+    throw new Error('ALLOCATION_EVIDENCE_MISSING');
+  const levels = await db.packLevel.findMany({
+    where: { organizationId: scope.organizationId, presentationId: line.presentationId },
+    select: { id: true, level: true, parentPackLevelId: true, unitsPerParent: true },
+  });
+  let targetUnits: number | null = null;
+  let ceiling = 0,
+    totalCost = 0;
+  for (const row of rows.filter((x) => x.remainingUnits > 0)) {
+    const option = saleUnitOptions({
+      packLevels: levels,
+      rootPackLevelId: row.rootPackLevelId,
+      unitsPerPack: row.unitsPerPack,
+    }).find((x) => x.kind === input.toUnit && x.packLevelId === input.toPackLevelId);
+    if (!option || (targetUnits !== null && targetUnits !== option.canonicalUnitsPerSaleUnit))
+      throw new Error('UNIT_NOT_SOLD');
+    targetUnits = option.canonicalUnitsPerSaleUnit;
+    const cap = (BigInt(row.priceNumerator) * BigInt(targetUnits)) / BigInt(row.denominator);
+    if (cap > BigInt(2_147_483_647)) throw new Error('INVALID_UNIT_CHANGE');
+    ceiling = Math.max(ceiling, Number(cap));
+    totalCost += row.remainingUnits * row.unitCostMinor;
+  }
+  if (!targetUnits || line.canonicalUnits % targetUnits !== 0 || !Number.isSafeInteger(totalCost))
+    throw new Error('UNIT_NOT_DIVISIBLE');
+  const toQuantity = line.canonicalUnits / targetUnits;
+  if (
+    BigInt(line.grossMinor) > BigInt(ceiling) * BigInt(toQuantity) ||
+    Math.ceil(totalCost / toQuantity) > 2_147_483_647
+  )
+    throw new Error('UNIT_PRICE_CEILING');
+  if (
+    input.toUnit === line.saleUnit &&
+    input.toPackLevelId === line.packLevelId &&
+    targetUnits === line.canonicalUnitsPerSaleUnit
+  )
+    throw new Error('UNIT_UNCHANGED');
+  await db.$executeRaw(Prisma.sql`INSERT INTO pharmacy_sale_line_unit_changes
+    ("organizationId","branchId","saleId","saleLineId","idempotencyKey","actorId","fromUnit","fromPackLevelId","fromQuantity","fromUnitsPerSaleUnit",
+     "toUnit","toPackLevelId","toQuantity","toUnitsPerSaleUnit","canonicalUnits","grossMinor")
+    VALUES (${scope.organizationId},${scope.branchId},${input.saleId},${line.id},${input.idempotencyKey},${scope.actorId},${line.saleUnit},${line.packLevelId},
+     ${line.quantity},${line.canonicalUnitsPerSaleUnit},${input.toUnit},${input.toPackLevelId},${toQuantity},${targetUnits},${line.canonicalUnits},${line.grossMinor})`);
+  await db.pharmacySaleLine.update({
+    where: { organizationId_id: { organizationId: scope.organizationId, id: line.id } },
+    data: {
+      saleUnit: input.toUnit,
+      packLevelId: input.toPackLevelId,
+      quantity: toQuantity,
+      canonicalUnitsPerSaleUnit: targetUnits,
+      unitPriceMinor: Math.floor(line.grossMinor / toQuantity),
+      proRataCeilingMinor: ceiling,
+      unitCostMinor: Math.ceil(totalCost / toQuantity),
+      discountMinor: 0,
+      discountKind: null,
+      approvedByUserId: null,
+      approvalPolicy: null,
+    },
+  });
+  return {
+    saleLineId: line.id,
+    quantity: toQuantity,
+    canonicalUnitsPerSaleUnit: targetUnits,
+    replayed: false as const,
+  };
+}
