+-- Additive capture grouping for quantity increases; readers may keep using
+-- ordinal and the snapshot/release fields from the preceding migration.
+ALTER TABLE pharmacy_sale_line_edit_requests DROP CONSTRAINT pharmacy_sale_line_edit_requests_check;
+ALTER TABLE pharmacy_sale_line_edit_requests ADD CONSTRAINT pharmacy_line_edit_quantity_change
+ CHECK ("toQuantity">0 AND "toQuantity"<>"fromQuantity");
+ALTER TABLE pharmacy_allocation_price_evidence ADD COLUMN "requestKey" TEXT;
+ALTER TABLE pharmacy_allocation_price_evidence ADD CONSTRAINT pharmacy_price_evidence_request_fk
+ FOREIGN KEY ("organizationId","requestKey") REFERENCES pharmacy_sale_line_edit_requests ("organizationId","idempotencyKey")
+ ON DELETE RESTRICT DEFERRABLE INITIALLY DEFERRED;
+
+CREATE OR REPLACE FUNCTION pharmacy_guard_allocation_price_evidence() RETURNS trigger LANGUAGE plpgsql AS $$
+DECLARE allocation RECORD; line RECORD; lot RECORD; movement RECORD; previous_count bigint; group_weight bigint;
+BEGIN
+ SELECT a.*,a.xmin::text::bigint AS insert_xid INTO allocation FROM pharmacy_sale_line_allocations a
+ WHERE a."organizationId"=NEW."organizationId" AND a.id=NEW."allocationId";
+ IF NOT FOUND OR allocation."branchId"<>NEW."branchId" OR allocation.insert_xid<>(txid_current()%4294967296) OR
+    allocation."canonicalUnits"<>NEW."originalUnits" OR allocation."grossMinor" IS DISTINCT FROM NEW."grossMinor" THEN
+   RAISE EXCEPTION 'ALLOCATION_PRICE_EVIDENCE_INVALID' USING ERRCODE='23514'; END IF;
+ SELECT *,xmin::text::bigint AS insert_xid INTO line FROM pharmacy_sale_lines
+ WHERE "organizationId"=NEW."organizationId" AND "branchId"=NEW."branchId" AND id=allocation."saleLineId" FOR UPDATE;
+ SELECT * INTO lot FROM pharmacy_inventory_lots WHERE "organizationId"=NEW."organizationId" AND "branchId"=NEW."branchId" AND id=allocation."inventoryLotId" FOR SHARE;
+ SELECT * INTO movement FROM pharmacy_stock_movements WHERE "organizationId"=NEW."organizationId" AND "branchId"=NEW."branchId" AND id=allocation."stockMovementId";
+ SELECT count(*),coalesce(sum(CASE WHEN e."requestKey" IS NOT DISTINCT FROM NEW."requestKey" THEN e."originalUnits"::bigint*e."priceNumerator" ELSE 0 END),0)
+ INTO previous_count,group_weight FROM pharmacy_allocation_price_evidence e JOIN pharmacy_sale_line_allocations a
+ ON a."organizationId"=e."organizationId" AND a.id=e."allocationId" WHERE e."organizationId"=NEW."organizationId" AND a."saleLineId"=line.id;
+ IF line.id IS NULL OR lot.id IS NULL OR movement.id IS NULL OR line.insert_xid<>(txid_current()%4294967296) OR
+    movement.kind::text<>'SALE' OR movement."inventoryLotId"<>allocation."inventoryLotId" OR
+    movement."stockLocationId"<>allocation."stockLocationId" OR movement."quantityUnits"<>-allocation."canonicalUnits" OR
+    previous_count<>NEW.ordinal OR NEW.remainder<>group_weight%NEW.denominator OR
+    movement."idempotencyKey"<>('sale:'||line."idempotencyKey"||':'||NEW.ordinal::text) OR
+    NEW.denominator<>line."canonicalUnitsPerSaleUnit" OR NEW.denominator>lot."unitsPerPack" OR
+    NEW."priceNumerator"<>(lot."printedMrpMinor"::bigint*NEW.denominator/lot."unitsPerPack") THEN
+   RAISE EXCEPTION 'ALLOCATION_PRICE_EVIDENCE_INVALID' USING ERRCODE='23514'; END IF;
+ RETURN NEW;
+END $$;
+
+CREATE OR REPLACE FUNCTION pharmacy_guard_line_edit_request() RETURNS trigger LANGUAGE plpgsql AS $$
+DECLARE line RECORD; bill RECORD; changed_units bigint; other_units bigint;
+BEGIN
+ SELECT * INTO line FROM pharmacy_sale_lines WHERE "organizationId"=NEW."organizationId" AND "branchId"=NEW."branchId"
+   AND "saleId"=NEW."saleId" AND id=NEW."saleLineId";
+ IF NOT FOUND THEN RAISE EXCEPTION 'LINE_EDIT_REQUEST_MISMATCH'; END IF;
+ PERFORM pharmacy_assert_no_payment_attempt(NEW."organizationId",NEW."branchId",NEW."saleId");
+ SELECT * INTO bill FROM pharmacy_sales WHERE "organizationId"=NEW."organizationId" AND "branchId"=NEW."branchId" AND id=NEW."saleId" FOR UPDATE;
+ SELECT * INTO line FROM pharmacy_sale_lines WHERE "organizationId"=NEW."organizationId" AND "branchId"=NEW."branchId" AND id=NEW."saleLineId" FOR UPDATE;
+ IF bill.status::text<>'OPEN' OR bill."receiptNumber" IS NOT NULL OR bill."completedAt" IS NOT NULL OR line."removedAt" IS NOT NULL OR
+    EXISTS(SELECT 1 FROM pharmacy_tenders WHERE "organizationId"=NEW."organizationId" AND "saleId"=NEW."saleId") OR
+    EXISTS(SELECT 1 FROM pharmacy_refunds WHERE "organizationId"=NEW."organizationId" AND "saleId"=NEW."saleId") OR
+    EXISTS(SELECT 1 FROM pharmacy_customer_orders WHERE "organizationId"=NEW."organizationId" AND "counterSaleId"=NEW."saleId") OR
+    EXISTS(SELECT 1 FROM pharmacy_medicines WHERE "organizationId"=NEW."organizationId" AND id=line."medicineId" AND (rx OR restricted OR controlled OR "highAlert")) OR
+    EXISTS(SELECT 1 FROM pharmacy_sale_return_lines WHERE "organizationId"=NEW."organizationId" AND "saleLineId"=line.id) OR
+    EXISTS(SELECT 1 FROM pharmacy_unidentified_return_holds WHERE "organizationId"=NEW."organizationId" AND "saleLineId"=line.id) OR
+    EXISTS(SELECT 1 FROM pharmacy_pharmacist_review_items WHERE "organizationId"=NEW."organizationId" AND "saleLineId"=line.id) OR
+    EXISTS(SELECT 1 FROM pharmacy_substitution_records WHERE "organizationId"=NEW."organizationId" AND "saleLineId"=line.id) OR
+    EXISTS(SELECT 1 FROM pharmacy_prescription_fills WHERE "organizationId"=NEW."organizationId" AND "idempotencyKey" IN ('rx-reference:'||line.id,'controlled:'||line.id)) OR
+    line."prescriptionLineId" IS NOT NULL THEN RAISE EXCEPTION 'LINE_EDIT_NOT_ALLOWED'; END IF;
+ IF NEW."toQuantity"<NEW."fromQuantity" THEN
+   SELECT coalesce(sum(r."canonicalUnits"),0) INTO changed_units FROM pharmacy_allocation_partial_releases r
+   JOIN pharmacy_sale_line_allocations a ON a."organizationId"=r."organizationId" AND a.id=r."allocationId"
+   WHERE r."organizationId"=NEW."organizationId" AND r."branchId"=NEW."branchId" AND r."requestKey"=NEW."idempotencyKey"
+     AND r."actorId"=NEW."actorId" AND a."saleLineId"=NEW."saleLineId";
+   SELECT count(*) INTO other_units FROM pharmacy_allocation_price_evidence WHERE "organizationId"=NEW."organizationId" AND "requestKey"=NEW."idempotencyKey";
+ ELSE
+   SELECT coalesce(sum(e."originalUnits"),0) INTO changed_units FROM pharmacy_allocation_price_evidence e
+   JOIN pharmacy_sale_line_allocations a ON a."organizationId"=e."organizationId" AND a.id=e."allocationId"
+   WHERE e."organizationId"=NEW."organizationId" AND e."branchId"=NEW."branchId" AND e."requestKey"=NEW."idempotencyKey" AND a."saleLineId"=NEW."saleLineId";
+   SELECT count(*) INTO other_units FROM pharmacy_allocation_partial_releases WHERE "organizationId"=NEW."organizationId" AND "requestKey"=NEW."idempotencyKey";
+ END IF;
+ IF line.id IS NULL OR line.quantity<>NEW."toQuantity" OR other_units<>0 OR
+    NULLIF(current_setting('app.current_user_id',true),'') IS DISTINCT FROM NEW."actorId" OR
+    changed_units<>abs(NEW."fromQuantity"-NEW."toQuantity")::bigint*line."canonicalUnitsPerSaleUnit" THEN
+   RAISE EXCEPTION 'LINE_EDIT_REQUEST_MISMATCH'; END IF;
+ RETURN NEW;
+END $$;
+
+-- At commit, added evidence must belong to the request and the final line
+-- must reflect every retained and newly allocated unit at its captured price.
+CREATE FUNCTION pharmacy_check_added_price_evidence() RETURNS trigger LANGUAGE plpgsql AS $$
+DECLARE line RECORD; totals RECORD;
+BEGIN
+ IF NEW."requestKey" IS NULL THEN RETURN NULL; END IF;
+ SELECT l.* INTO line FROM pharmacy_sale_lines l JOIN pharmacy_sale_line_allocations a ON a."organizationId"=l."organizationId" AND a."saleLineId"=l.id
+ WHERE a."organizationId"=NEW."organizationId" AND a.id=NEW."allocationId";
+ SELECT coalesce(sum(e."originalUnits"-coalesce(r.units,0)),0) AS units,
+ coalesce(sum((e.remainder::bigint+(e."originalUnits"-coalesce(r.units,0))*e."priceNumerator")/e.denominator),0) AS gross,count(*) AS snapshots
+ INTO totals FROM pharmacy_sale_line_allocations a JOIN pharmacy_allocation_price_evidence e ON e."organizationId"=a."organizationId" AND e."allocationId"=a.id
+ LEFT JOIN LATERAL (SELECT sum("canonicalUnits") AS units FROM pharmacy_allocation_partial_releases WHERE "organizationId"=a."organizationId" AND "allocationId"=a.id) r ON true
+ WHERE a."organizationId"=NEW."organizationId" AND a."saleLineId"=line.id;
+ IF NOT EXISTS(SELECT 1 FROM pharmacy_sale_line_edit_requests q WHERE q."organizationId"=NEW."organizationId" AND q."idempotencyKey"=NEW."requestKey"
+   AND q."branchId"=NEW."branchId" AND q."saleId"=line."saleId" AND q."saleLineId"=line.id AND q."toQuantity">q."fromQuantity"
+   AND q.xmin::text::bigint=(txid_current()%4294967296)) OR
+ totals.snapshots<>(SELECT count(*) FROM pharmacy_sale_line_allocations WHERE "organizationId"=NEW."organizationId" AND "saleLineId"=line.id) OR
+ totals.units<>line."canonicalUnits" OR totals.gross<>line."grossMinor" OR line.quantity<=0 OR
+ line.quantity::bigint*line."canonicalUnitsPerSaleUnit"<>line."canonicalUnits" OR line."unitPriceMinor"<>line."grossMinor"/line.quantity OR
+ line."discountMinor"<>0 OR line."discountKind" IS NOT NULL OR line."approvedByUserId" IS NOT NULL OR line."approvalPolicy" IS NOT NULL THEN
+ RAISE EXCEPTION 'INCREASE_LINE_MISMATCH'; END IF;
+ RETURN NULL;
+END $$;
+CREATE CONSTRAINT TRIGGER pharmacy_added_price_consistency AFTER INSERT ON pharmacy_allocation_price_evidence
+ DEFERRABLE INITIALLY DEFERRED FOR EACH ROW EXECUTE FUNCTION pharmacy_check_added_price_evidence();
+
+-- A request cannot be reused in a later transaction to attach a new release.
+CREATE OR REPLACE FUNCTION pharmacy_check_release_line_at_commit() RETURNS trigger LANGUAGE plpgsql AS $$
+DECLARE line RECORD; totals RECORD;
+BEGIN
+ SELECT l.* INTO line FROM pharmacy_sale_lines l JOIN pharmacy_sale_line_allocations a ON a."organizationId"=l."organizationId" AND a."saleLineId"=l.id
+ WHERE a."organizationId"=NEW."organizationId" AND a.id=NEW."allocationId";
+ SELECT coalesce(sum(e."originalUnits"-coalesce(r.units,0)),0) AS units,
+ coalesce(sum((e.remainder::bigint+(e."originalUnits"-coalesce(r.units,0))*e."priceNumerator")/e.denominator),0) AS gross,count(*) AS snapshots
+ INTO totals FROM pharmacy_sale_line_allocations a JOIN pharmacy_allocation_price_evidence e ON e."organizationId"=a."organizationId" AND e."allocationId"=a.id
+ LEFT JOIN LATERAL (SELECT sum("canonicalUnits") AS units FROM pharmacy_allocation_partial_releases WHERE "organizationId"=a."organizationId" AND "allocationId"=a.id) r ON true
+ WHERE a."organizationId"=NEW."organizationId" AND a."saleLineId"=line.id;
+ IF NOT EXISTS(SELECT 1 FROM pharmacy_sale_line_edit_requests q WHERE q."organizationId"=NEW."organizationId" AND q."idempotencyKey"=NEW."requestKey"
+   AND q."branchId"=NEW."branchId" AND q."saleId"=line."saleId" AND q."saleLineId"=line.id AND q."actorId"=NEW."actorId"
+   AND q."toQuantity"<q."fromQuantity" AND q.xmin::text::bigint=(txid_current()%4294967296)) OR
+ totals.snapshots<>(SELECT count(*) FROM pharmacy_sale_line_allocations WHERE "organizationId"=NEW."organizationId" AND "saleLineId"=line.id) OR
+ totals.units<>line."canonicalUnits" OR totals.gross<>line."grossMinor" OR line."discountMinor"<>0 OR line.quantity<=0 OR
+ line."canonicalUnitsPerSaleUnit"<=0 OR line.quantity::bigint*line."canonicalUnitsPerSaleUnit"<>line."canonicalUnits" OR
+ line."unitPriceMinor"<>line."grossMinor"/line.quantity OR line."discountKind" IS NOT NULL OR
+ line."approvedByUserId" IS NOT NULL OR line."approvalPolicy" IS NOT NULL THEN RAISE EXCEPTION 'RELEASE_LINE_MISMATCH'; END IF;
+ RETURN NULL;
+END $$;
