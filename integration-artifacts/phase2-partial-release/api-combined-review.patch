+++ b/prisma/migrations/20261106110000_pharmacy_allocation_price_evidence/migration.sql
@@ -0,0 +1,69 @@
+-- Additive evidence only. It does not enable bill-line editing or stock release.
+-- Existing allocations are intentionally not backfilled from mutable lot data.
+CREATE TABLE "pharmacy_allocation_price_evidence" (
+  "organizationId" TEXT NOT NULL,
+  "branchId" TEXT NOT NULL,
+  "allocationId" TEXT NOT NULL,
+  "ordinal" INTEGER NOT NULL CHECK ("ordinal" >= 0),
+  "originalUnits" INTEGER NOT NULL CHECK ("originalUnits" > 0),
+  "priceNumerator" INTEGER NOT NULL CHECK ("priceNumerator" >= 0),
+  "denominator" INTEGER NOT NULL CHECK ("denominator" > 0),
+  "remainder" INTEGER NOT NULL CHECK ("remainder" >= 0 AND "remainder" < "denominator"),
+  "grossMinor" INTEGER NOT NULL CHECK ("grossMinor" >= 0),
+  "createdAt" TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP,
+  PRIMARY KEY ("organizationId", "allocationId"),
+  FOREIGN KEY ("organizationId", "allocationId")
+    REFERENCES "pharmacy_sale_line_allocations" ("organizationId", "id") ON DELETE RESTRICT,
+  CHECK ((("remainder"::bigint + "originalUnits"::bigint * "priceNumerator") / "denominator") = "grossMinor")
+);
+
+ALTER TABLE "pharmacy_allocation_price_evidence" ENABLE ROW LEVEL SECURITY;
+ALTER TABLE "pharmacy_allocation_price_evidence" FORCE ROW LEVEL SECURITY;
+CREATE POLICY tenant_isolation ON "pharmacy_allocation_price_evidence"
+  USING ("organizationId" = current_setting('app.current_organization_id', true))
+  WITH CHECK ("organizationId" = current_setting('app.current_organization_id', true));
+
+CREATE FUNCTION pharmacy_guard_allocation_price_evidence() RETURNS trigger LANGUAGE plpgsql AS $$
+DECLARE allocation RECORD; line RECORD; lot RECORD; movement RECORD; previous_count bigint; previous_weight bigint;
+BEGIN
+  -- Snapshot only in the allocating transaction: later reconstruction would
+  -- guess at historical prices or at rounding that was never recorded.
+  SELECT a.*, a.xmin::text::bigint AS insert_xid INTO allocation
+    FROM pharmacy_sale_line_allocations a
+    WHERE a."organizationId" = NEW."organizationId" AND a."id" = NEW."allocationId";
+  IF NOT FOUND OR allocation."branchId" <> NEW."branchId" OR
+     allocation.insert_xid <> (txid_current() % 4294967296) OR
+     allocation."canonicalUnits" <> NEW."originalUnits" OR
+     allocation."grossMinor" IS DISTINCT FROM NEW."grossMinor" THEN
+    RAISE EXCEPTION 'ALLOCATION_PRICE_EVIDENCE_INVALID' USING ERRCODE = '23514';
+  END IF;
+  SELECT *, xmin::text::bigint AS insert_xid INTO line FROM pharmacy_sale_lines
+    WHERE "organizationId" = NEW."organizationId" AND "branchId" = NEW."branchId"
+      AND id = allocation."saleLineId" FOR UPDATE;
+  SELECT * INTO lot FROM pharmacy_inventory_lots
+    WHERE "organizationId" = NEW."organizationId" AND "branchId" = NEW."branchId"
+      AND id = allocation."inventoryLotId" FOR SHARE;
+  SELECT * INTO movement FROM pharmacy_stock_movements WHERE "organizationId" = NEW."organizationId"
+    AND "branchId" = NEW."branchId" AND id = allocation."stockMovementId";
+  SELECT count(*), coalesce(sum(e."originalUnits"::bigint * e."priceNumerator"), 0)
+    INTO previous_count, previous_weight FROM pharmacy_allocation_price_evidence e
+    JOIN pharmacy_sale_line_allocations a ON a."organizationId" = e."organizationId" AND a.id = e."allocationId"
+    WHERE e."organizationId" = NEW."organizationId" AND a."saleLineId" = line.id;
+  IF line.id IS NULL OR lot.id IS NULL OR movement.id IS NULL OR
+     line.insert_xid <> (txid_current() % 4294967296) OR
+     previous_count <> NEW."ordinal" OR
+     NEW."remainder" <> previous_weight % NEW."denominator" OR
+     movement."idempotencyKey" <> ('sale:' || line."idempotencyKey" || ':' || NEW."ordinal"::text) OR
+     NEW."denominator" <> line."canonicalUnitsPerSaleUnit" OR
+     NEW."denominator" > lot."unitsPerPack" OR
+     NEW."priceNumerator" <> (lot."printedMrpMinor"::bigint * NEW."denominator" / lot."unitsPerPack") THEN
+    RAISE EXCEPTION 'ALLOCATION_PRICE_EVIDENCE_INVALID' USING ERRCODE = '23514';
+  END IF;
+  RETURN NEW;
+END $$;
+CREATE TRIGGER pharmacy_allocation_price_evidence_guard
+  BEFORE INSERT ON pharmacy_allocation_price_evidence
+  FOR EACH ROW EXECUTE FUNCTION pharmacy_guard_allocation_price_evidence();
+CREATE TRIGGER pharmacy_allocation_price_evidence_immutable
+  BEFORE UPDATE OR DELETE ON pharmacy_allocation_price_evidence
+  FOR EACH ROW EXECUTE FUNCTION pharmacy_reject_mutation();
