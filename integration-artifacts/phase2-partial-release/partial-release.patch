@@ -0,0 +1,31 @@
+/** Remaining physical arrangement from the original sale movement. */
+export type ReleaseableArrangement = {
+  unitsPerPack: number;
+  sealedPacks: number;
+  looseUnits: number;
+};
+
+/**
+ * Return only physical stock represented by the original sale movement, less
+ * any prior releases. Never break a sealed pack implicitly. The caller must
+ * verify and lock the original movement and prior release evidence, then post
+ * the resulting adjustment and release record in one guarded transaction.
+ */
+export function planReleaseArrangement(
+  remaining: ReleaseableArrangement,
+  units: number
+): { sealedPacks: number; looseUnits: number } {
+  const valid = (n: number, min: number) => Number.isSafeInteger(n) && n >= min;
+  if (!valid(remaining.unitsPerPack, 1) || !valid(remaining.sealedPacks, 0) ||
+      !valid(remaining.looseUnits, 0) || !valid(units, 1)) {
+    throw new Error('INVALID_RELEASE_ARRANGEMENT');
+  }
+  const remainder = units % remaining.unitsPerPack;
+  const maxLoose = Math.min(units, remaining.looseUnits);
+  if (maxLoose < remainder) throw new Error('INVALID_RELEASE_ARRANGEMENT');
+  const looseUnits = remainder +
+    Math.floor((maxLoose - remainder) / remaining.unitsPerPack) * remaining.unitsPerPack;
+  const sealedPacks = (units - looseUnits) / remaining.unitsPerPack;
+  if (sealedPacks > remaining.sealedPacks) throw new Error('INVALID_RELEASE_ARRANGEMENT');
+  return { sealedPacks, looseUnits };
+}
diff --git a/src/lib/pharmacy/edit-sale-line-quantity.ts b/src/lib/pharmacy/edit-sale-line-quantity.ts
new file mode 100644
index 00000000..1b4b4049
--- /dev/null
+++ b/src/lib/pharmacy/edit-sale-line-quantity.ts
@@ -0,0 +1,199 @@
+import { createHash, randomUUID } from 'node:crypto';
+import { Prisma } from '@/generated/prisma/client';
+import type { ScopedDb } from '@/lib/tenancy/scoped-db';
+import type { LedgerScope } from './stock-ledger';
+import { planAllocationReduction } from './bill-line-allocation-plan';
+import { planReleaseArrangement } from './bill-line-release-arrangement';
+
+type Evidence = {
+  allocationId: string;
+  originalUnits: number;
+  remainingUnits: number;
+  priceNumerator: number;
+  denominator: number;
+  remainder: number;
+  grossMinor: number;
+  inventoryLotId: string;
+  stockLocationId: string;
+  disposition: 'AVAILABLE';
+  originalSealed: number;
+  originalLoose: number;
+  releasedSealed: number;
+  releasedLoose: number;
+  unitsPerPack: number;
+};
+
+/**
+ * Internal reduction slice. The caller owns the transaction and must already
+ * have checked counter capability and branch assignment. It is intentionally
+ * not exposed by a router: active-allocation readers and pack scan binding must
+ * be integrated before any stock release can be enabled.
+ */
+export async function reduceSaleLineQuantity(
+  db: ScopedDb,
+  scope: LedgerScope,
+  input: {
+    saleId: string;
+    saleLineId: string;
+    fromQuantity: number;
+    toQuantity: number;
+    idempotencyKey: string;
+  }
+) {
+  if (
+    !Number.isSafeInteger(input.fromQuantity) ||
+    !Number.isSafeInteger(input.toQuantity) ||
+    input.toQuantity < 1 ||
+    input.toQuantity >= input.fromQuantity ||
+    !input.idempotencyKey.trim() ||
+    input.idempotencyKey.length > 160
+  )
+    throw new Error('INVALID_LINE_EDIT');
+  await db.$executeRaw(
+    Prisma.sql`SELECT pharmacy_assert_no_payment_attempt(${scope.organizationId},${scope.branchId},${input.saleId})`
+  );
+  await db.$queryRaw(Prisma.sql`SELECT set_config('app.current_user_id',${scope.actorId},true)`);
+  const sale = await db.pharmacySale.findFirst({
+    where: {
+      id: input.saleId,
+      organizationId: scope.organizationId,
+      branchId: scope.branchId,
+    },
+    include: { tenders: true, refunds: true, customerOrder: true },
+  });
+  if (
+    !sale ||
+    sale.status !== 'OPEN' ||
+    sale.receiptNumber ||
+    sale.completedAt ||
+    sale.tenders.length ||
+    sale.refunds.length ||
+    sale.customerOrder
+  )
+    throw new Error('SALE_NOT_EDITABLE');
+  const previous = await db.$queryRaw<
+    Array<{
+      branchId: string;
+      saleId: string;
+      saleLineId: string;
+      actorId: string;
+      fromQuantity: number;
+      toQuantity: number;
+    }>
+  >(Prisma.sql`
+    SELECT "branchId","saleId","saleLineId","actorId","fromQuantity","toQuantity"
+    FROM pharmacy_sale_line_edit_requests WHERE "organizationId"=${scope.organizationId} AND "idempotencyKey"=${input.idempotencyKey}
+  `);
+  if (previous.length) {
+    const p = previous[0]!;
+    if (
+      p.branchId !== scope.branchId ||
+      p.saleId !== input.saleId ||
+      p.saleLineId !== input.saleLineId ||
+      p.actorId !== scope.actorId ||
+      p.fromQuantity !== input.fromQuantity ||
+      p.toQuantity !== input.toQuantity
+    )
+      throw new Error('EDIT_IDEMPOTENCY_CONFLICT');
+    return { saleLineId: input.saleLineId, quantity: input.toQuantity, replayed: true as const };
+  }
+  const [active] = await db.$queryRaw<Array<{ id: string }>>(Prisma.sql`
+    SELECT id FROM pharmacy_sale_lines WHERE "organizationId"=${scope.organizationId} AND "branchId"=${scope.branchId}
+      AND "saleId"=${input.saleId} AND id=${input.saleLineId} AND "removedAt" IS NULL FOR UPDATE
+  `);
+  if (!active) throw new Error('LINE_NOT_EDITABLE');
+  const line = await db.pharmacySaleLine.findFirstOrThrow({
+    where: {
+      id: input.saleLineId,
+      organizationId: scope.organizationId,
+      branchId: scope.branchId,
+      saleId: input.saleId,
+    },
+    include: { medicine: true, returnLines: true, unidentifiedReturnHolds: true },
+  });
+  if (
+    line.quantity !== input.fromQuantity ||
+    line.medicine.rx ||
+    line.medicine.restricted ||
+    line.medicine.controlled ||
+    line.medicine.highAlert ||
+    line.prescriptionLineId ||
+    line.returnLines.length ||
+    line.unidentifiedReturnHolds.length
+  )
+    throw new Error('LINE_NOT_EDITABLE');
+  const targetUnits = input.toQuantity * line.canonicalUnitsPerSaleUnit;
+  if (!Number.isSafeInteger(targetUnits)) throw new Error('INVALID_LINE_EDIT');
+  const evidence = await db.$queryRaw<Evidence[]>(Prisma.sql`
+    SELECT e."allocationId",e."originalUnits",(e."originalUnits"-coalesce(r.units,0))::int AS "remainingUnits",
+      e."priceNumerator",e.denominator,e.remainder,e."grossMinor",a."inventoryLotId",a."stockLocationId",m.disposition,
+      -m."sealedPackDelta" AS "originalSealed",-m."looseUnitDelta" AS "originalLoose",
+      coalesce(r.sealed,0)::int AS "releasedSealed",coalesce(r.loose,0)::int AS "releasedLoose",lot."unitsPerPack"
+    FROM pharmacy_sale_line_allocations a JOIN pharmacy_allocation_price_evidence e ON e."organizationId"=a."organizationId" AND e."allocationId"=a.id
+    JOIN pharmacy_stock_movements m ON m."organizationId"=a."organizationId" AND m.id=a."stockMovementId"
+    JOIN pharmacy_inventory_lots lot ON lot."organizationId"=a."organizationId" AND lot.id=a."inventoryLotId"
+    LEFT JOIN LATERAL (SELECT sum(x."canonicalUnits") AS units,sum(sm."sealedPackDelta") AS sealed,sum(sm."looseUnitDelta") AS loose
+      FROM pharmacy_allocation_partial_releases x JOIN pharmacy_stock_movements sm ON sm."organizationId"=x."organizationId" AND sm.id=x."stockMovementId"
+      WHERE x."organizationId"=a."organizationId" AND x."allocationId"=a.id) r ON true
+    WHERE a."organizationId"=${scope.organizationId} AND a."branchId"=${scope.branchId} AND a."saleLineId"=${line.id} ORDER BY e.ordinal
+  `);
+  const count = await db.pharmacySaleLineAllocation.count({
+    where: { organizationId: scope.organizationId, saleLineId: line.id },
+  });
+  if (
+    evidence.length !== count ||
+    evidence.reduce((n, x) => n + x.remainingUnits, 0) !== line.canonicalUnits
+  )
+    throw new Error('ALLOCATION_EVIDENCE_MISSING');
+  const plan = planAllocationReduction(evidence, targetUnits);
+  for (const [index, part] of plan.releases.entries()) {
+    const row = evidence.find((x) => x.allocationId === part.allocationId)!;
+    if (row.disposition !== 'AVAILABLE') throw new Error('INVALID_STOCK_EVIDENCE');
+    const arrangement = planReleaseArrangement(
+      {
+        unitsPerPack: row.unitsPerPack,
+        sealedPacks: row.originalSealed - row.releasedSealed,
+        looseUnits: row.originalLoose - row.releasedLoose,
+      },
+      part.units
+    );
+    const key = createHash('sha256')
+      .update(JSON.stringify([scope.organizationId, input.idempotencyKey, index]))
+      .digest('hex');
+    const movement = await db.pharmacyStockMovement.create({
+      data: {
+        organizationId: scope.organizationId,
+        branchId: scope.branchId,
+        inventoryLotId: row.inventoryLotId,
+        stockLocationId: row.stockLocationId,
+        kind: 'ADJUSTMENT',
+        disposition: 'AVAILABLE',
+        quantityUnits: part.units,
+        sealedPackDelta: arrangement.sealedPacks,
+        looseUnitDelta: arrangement.looseUnits,
+        actorId: scope.actorId,
+        idempotencyKey: `partial-release:${key}`,
+      },
+    });
+    await db.$executeRaw(Prisma.sql`INSERT INTO pharmacy_allocation_partial_releases
+      (id,"organizationId","branchId","allocationId","stockMovementId","requestKey","idempotencyKey","actorId","canonicalUnits","grossMinor")
+      VALUES (${randomUUID()},${scope.organizationId},${scope.branchId},${part.allocationId},${movement.id},${input.idempotencyKey},${key},${scope.actorId},${part.units},${part.grossMinor})`);
+  }
+  await db.pharmacySaleLine.update({
+    where: { organizationId_id: { organizationId: scope.organizationId, id: line.id } },
+    data: {
+      quantity: input.toQuantity,
+      canonicalUnits: targetUnits,
+      grossMinor: plan.retainedGrossMinor,
+      unitPriceMinor: Math.floor(plan.retainedGrossMinor / input.toQuantity),
+      discountMinor: 0,
+      discountKind: null,
+      approvedByUserId: null,
+      approvalPolicy: null,
+    },
+  });
+  await db.$executeRaw(Prisma.sql`INSERT INTO pharmacy_sale_line_edit_requests
+    ("organizationId","branchId","saleId","saleLineId","idempotencyKey","actorId","fromQuantity","toQuantity")
+    VALUES (${scope.organizationId},${scope.branchId},${input.saleId},${input.saleLineId},${input.idempotencyKey},${scope.actorId},${input.fromQuantity},${input.toQuantity})`);
+  return { saleLineId: input.saleLineId, quantity: input.toQuantity, replayed: false as const };
+}
