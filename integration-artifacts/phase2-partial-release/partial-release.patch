diff --git a/src/lib/pharmacy/bill-line-allocation-plan.test.ts b/src/lib/pharmacy/bill-line-allocation-plan.test.ts
new file mode 100644
index 00000000..a7cec351
--- /dev/null
+++ b/src/lib/pharmacy/bill-line-allocation-plan.test.ts
@@ -0,0 +1,64 @@
+import { describe, expect, it } from 'vitest';
+import { planAllocationReduction } from './bill-line-allocation-plan';
+
+describe('bill-line allocation reduction planning', () => {
+  const rows = [
+    { allocationId: 'first', originalUnits: 3, remainingUnits: 3, priceNumerator: 100,
+      denominator: 3, remainder: 0, grossMinor: 100 },
+    { allocationId: 'second', originalUnits: 3, remainingUnits: 3, priceNumerator: 121,
+      denominator: 3, remainder: 0, grossMinor: 121 },
+  ];
+
+  it('releases newest units first and retains each lot’s original price', () => {
+    expect(planAllocationReduction(rows, 4)).toEqual({
+      releases: [{ allocationId: 'second', units: 2, grossMinor: 81 }],
+      retainedGrossMinor: 140,
+    });
+    expect(planAllocationReduction(rows, 2)).toEqual({
+      releases: [
+        { allocationId: 'second', units: 3, grossMinor: 121 },
+        { allocationId: 'first', units: 1, grossMinor: 34 },
+      ],
+      retainedGrossMinor: 66,
+    });
+  });
+
+  it('accounts for a prior partial release and the original rounding remainder', () => {
+    const row = { allocationId: 'a', originalUnits: 2, remainingUnits: 1,
+      priceNumerator: 4, denominator: 3, remainder: 2, grossMinor: 3 };
+    expect(planAllocationReduction([row], 1)).toEqual({ releases: [], retainedGrossMinor: 2 });
+  });
+
+  it('preserves money across successive partial reductions', () => {
+    const initial = planAllocationReduction(rows, 4);
+    const later = planAllocationReduction(
+      [rows[0]!, { ...rows[1]!, remainingUnits: 1 }],
+      2
+    );
+    const released = [...initial.releases, ...later.releases]
+      .reduce((sum, item) => sum + item.grossMinor, 0);
+    expect(released + later.retainedGrossMinor).toBe(221);
+    expect(later.releases).toEqual([
+      { allocationId: 'second', units: 1, grossMinor: 40 },
+      { allocationId: 'first', units: 1, grossMinor: 34 },
+    ]);
+  });
+
+  it('fails closed on invalid or incomplete price evidence and duplicate IDs', () => {
+    expect(() => planAllocationReduction([{ ...rows[0]!, grossMinor: 99 }], 1))
+      .toThrow('PRICE_EVIDENCE_INVALID');
+    expect(() => planAllocationReduction([rows[0]!, rows[0]!], 1))
+      .toThrow('PRICE_EVIDENCE_INVALID');
+    expect(() => planAllocationReduction(rows, 7)).toThrow('INVALID_TARGET');
+    expect(() => planAllocationReduction(rows, 0)).toThrow('INVALID_TARGET');
+  });
+
+  it('requires the original price snapshot because a rounded allocation total is ambiguous', () => {
+    const common = { allocationId: 'a', originalUnits: 3, remainingUnits: 3,
+      denominator: 10, remainder: 0, grossMinor: 1 };
+    const priceFour = planAllocationReduction([{ ...common, priceNumerator: 4 }], 2);
+    const priceFive = planAllocationReduction([{ ...common, priceNumerator: 5 }], 2);
+    expect(priceFour.retainedGrossMinor).toBe(0);
+    expect(priceFive.retainedGrossMinor).toBe(1);
+  });
+});
diff --git a/src/lib/pharmacy/bill-line-allocation-plan.ts b/src/lib/pharmacy/bill-line-allocation-plan.ts
new file mode 100644
index 00000000..fdfd4945
--- /dev/null
+++ b/src/lib/pharmacy/bill-line-allocation-plan.ts
@@ -0,0 +1,73 @@
+/** Immutable pricing evidence for an allocation, ordered from oldest to newest.
+ * `remainder` is the cumulative pricing numerator modulo `denominator` at
+ * the start of this allocation. All values describe the original sale price,
+ * not the current catalogue or lot price.
+ */
+export type AllocationPriceEvidence = {
+  allocationId: string;
+  remainingUnits: number;
+  originalUnits: number;
+  priceNumerator: number;
+  denominator: number;
+  remainder: number;
+  grossMinor: number;
+};
+
+export type AllocationRelease = { allocationId: string; units: number; grossMinor: number };
+
+function whole(value: number, min: number): boolean {
+  return Number.isSafeInteger(value) && value >= min;
+}
+
+function grossForPrefix(row: AllocationPriceEvidence, units: number): number {
+  const value =
+    (BigInt(row.remainder) + BigInt(units) * BigInt(row.priceNumerator)) /
+    BigInt(row.denominator);
+  if (value > BigInt(Number.MAX_SAFE_INTEGER)) throw new Error('PRICE_EVIDENCE_INVALID');
+  return Number(value);
+}
+
+/**
+ * Plan a reduction without modifying the ledger. The caller must hold the sale
+ * lock, load authoritative evidence in allocation order, persist the releases
+ * atomically and verify stock, clinical and payment guards. This is not a sale
+ * mutation and must not be used to infer payment or authorization state.
+ */
+export function planAllocationReduction(
+  allocations: readonly AllocationPriceEvidence[],
+  targetCanonicalUnits: number
+): { releases: AllocationRelease[]; retainedGrossMinor: number } {
+  if (!whole(targetCanonicalUnits, 1) || !allocations.length)
+    throw new Error('INVALID_TARGET');
+  const ids = new Set<string>();
+  let currentUnits = 0;
+  for (const row of allocations) {
+    if (
+      !row.allocationId || ids.has(row.allocationId) || !whole(row.originalUnits, 1) ||
+      !whole(row.remainingUnits, 0) || row.remainingUnits > row.originalUnits ||
+      !whole(row.priceNumerator, 0) || !whole(row.denominator, 1) ||
+      !whole(row.remainder, 0) || row.remainder >= row.denominator ||
+      !whole(row.grossMinor, 0) || grossForPrefix(row, row.originalUnits) !== row.grossMinor
+    ) throw new Error('PRICE_EVIDENCE_INVALID');
+    ids.add(row.allocationId);
+    currentUnits += row.remainingUnits;
+    if (!Number.isSafeInteger(currentUnits)) throw new Error('INVALID_TARGET');
+  }
+  if (targetCanonicalUnits > currentUnits) throw new Error('INVALID_TARGET');
+  let toRelease = currentUnits - targetCanonicalUnits;
+  let retainedGrossMinor = 0;
+  const releases: AllocationRelease[] = [];
+  for (const row of [...allocations].reverse()) {
+    const released = Math.min(row.remainingUnits, toRelease);
+    const retained = row.remainingUnits - released;
+    if (released) releases.push({
+      allocationId: row.allocationId,
+      units: released,
+      grossMinor: grossForPrefix(row, row.remainingUnits) - grossForPrefix(row, retained),
+    });
+    retainedGrossMinor += grossForPrefix(row, retained);
+    if (!Number.isSafeInteger(retainedGrossMinor)) throw new Error('PRICE_EVIDENCE_INVALID');
+    toRelease -= released;
+  }
+  return { releases, retainedGrossMinor };
+}
