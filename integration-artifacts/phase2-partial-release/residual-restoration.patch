+        saleId: f.sale.id,
+        saleLineId: f.line.id,
+        allocationId: allocation.id,
+        reason: 'Synthetic void or removal',
+        idempotencyKey: 'race-' + allocation.id,
+      });
+      await db.pharmacySale.update({
+        where: { organizationId_id: { organizationId: org, id: f.sale.id } },
+        data: { status: 'VOID' },
