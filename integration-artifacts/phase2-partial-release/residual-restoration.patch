+import { createHash, randomUUID } from 'node:crypto';
+import { Prisma } from '@/generated/prisma/client';
+import type { ScopedDb } from '@/lib/tenancy/scoped-db';
+import type { LedgerScope } from './stock-ledger';
+
+/**
+ * Internal void/removal building block. Caller checks actor/branch permission,
+ * owns the transaction and must complete the void or tombstone before commit.
+ * Untouched allocations still require the existing full-reversal path.
+ * This is intentionally not exposed through a router.
+ */
+export async function restoreAllocationResidual(
+  db: ScopedDb,
+  scope: LedgerScope,
+  input: {
+    saleId: string;
+    saleLineId: string;
+    allocationId: string;
+    idempotencyKey: string;
+    reason: string;
+  }
+) {
+  const reason = input.reason.trim();
+  if (
+    !input.idempotencyKey.trim() ||
+    input.idempotencyKey.length > 160 ||
+    !reason ||
+    reason.length > 500
+  )
+    throw new Error('INVALID_RESIDUAL_REQUEST');
+  await db.$executeRaw(
+    Prisma.sql`SELECT pharmacy_assert_no_payment_attempt(${scope.organizationId},${scope.branchId},${input.saleId})`
+  );
+  await db.$queryRaw(Prisma.sql`SELECT set_config('app.current_user_id',${scope.actorId},true)`);
+  const [row] = await db.$queryRaw<
+    Array<{
+      allocationId: string;
+      stockMovementId: string;
+      canonicalUnits: number;
+      grossMinor: number | null;
+      inventoryLotId: string;
+      stockLocationId: string;
+      saleStatus: string;
+      receiptNumber: string | null;
+      completedAt: Date | null;
+      removedAt: Date | null;
+      quantityUnits: number;
+      sealedPackDelta: number;
+      looseUnitDelta: number;
+      disposition: string;
+      releasedUnits: number;
+      releasedGross: number;
+      releasedSealed: number;
+      releasedLoose: number;
+    }>
+  >(Prisma.sql`
+    SELECT a.id AS "allocationId",a."stockMovementId",a."canonicalUnits",e."grossMinor",a."inventoryLotId",a."stockLocationId",
+      s.status::text AS "saleStatus",s."receiptNumber",s."completedAt",l."removedAt",m."quantityUnits",m."sealedPackDelta",m."looseUnitDelta",m.disposition::text,
+      coalesce(r.units,0)::int AS "releasedUnits",coalesce(r.gross,0)::int AS "releasedGross",
+      coalesce(r.sealed,0)::int AS "releasedSealed",coalesce(r.loose,0)::int AS "releasedLoose"
+    FROM pharmacy_sale_line_allocations a JOIN pharmacy_sale_lines l ON l."organizationId"=a."organizationId" AND l.id=a."saleLineId"
+    JOIN pharmacy_sales s ON s."organizationId"=l."organizationId" AND s."branchId"=l."branchId" AND s.id=l."saleId"
+    JOIN pharmacy_stock_movements m ON m."organizationId"=a."organizationId" AND m.id=a."stockMovementId"
+    LEFT JOIN pharmacy_allocation_price_evidence e ON e."organizationId"=a."organizationId" AND e."allocationId"=a.id
+    LEFT JOIN LATERAL (SELECT sum(x."canonicalUnits") units,sum(x."grossMinor") gross,
+      sum(sm."sealedPackDelta") sealed,sum(sm."looseUnitDelta") loose
+      FROM pharmacy_allocation_partial_releases x JOIN pharmacy_stock_movements sm ON sm."organizationId"=x."organizationId" AND sm.id=x."stockMovementId"
+      WHERE x."organizationId"=a."organizationId" AND x."allocationId"=a.id) r ON true
+    WHERE a."organizationId"=${scope.organizationId} AND a."branchId"=${scope.branchId}
+      AND a.id=${input.allocationId} AND l.id=${input.saleLineId} AND s.id=${input.saleId}
+  `);
+  if (!row) throw new Error('RESIDUAL_SCOPE_INVALID');
+  const key = createHash('sha256')
+    .update(JSON.stringify([scope.organizationId, input.idempotencyKey, input.allocationId]))
+    .digest('hex');
+  const [prior] = await db.$queryRaw<
+    Array<{ idempotencyKey: string; actorId: string; stockMovementId: string; reason: string }>
+  >(Prisma.sql`
+    SELECT "idempotencyKey","actorId","stockMovementId",reason FROM pharmacy_allocation_residual_restorations
+    WHERE "organizationId"=${scope.organizationId} AND "branchId"=${scope.branchId} AND "allocationId"=${input.allocationId}`);
+  if (prior) {
+    if (prior.idempotencyKey !== key || prior.actorId !== scope.actorId || prior.reason !== reason)
+      throw new Error('RESIDUAL_IDEMPOTENCY_CONFLICT');
+    return {
+      kind: 'RESTORED' as const,
+      replayed: true as const,
+      stockMovementId: prior.stockMovementId,
+    };
+  }
+  const sale = await db.pharmacySale.findFirstOrThrow({
+    where: {
+      id: input.saleId,
+      organizationId: scope.organizationId,
+      branchId: scope.branchId,
+    },
+    include: { tenders: true, refunds: true, customerOrder: true },
+  });
+  if (
+    row.saleStatus !== 'OPEN' ||
+    row.removedAt ||
+    row.receiptNumber ||
+    row.completedAt ||
+    sale.tenders.length ||
+    sale.refunds.length ||
+    sale.customerOrder
+  )
+    throw new Error('SALE_NOT_EDITABLE');
+  if (row.releasedUnits === 0) return { kind: 'FULL_REVERSAL_REQUIRED' as const };
+  if (
+    row.grossMinor === null ||
+    row.quantityUnits !== -row.canonicalUnits ||
+    row.disposition !== 'AVAILABLE' ||
+    row.releasedUnits > row.canonicalUnits
+  )
+    throw new Error('RESIDUAL_EVIDENCE_INVALID');
+  const units = row.canonicalUnits - row.releasedUnits;
+  const sealed = -row.sealedPackDelta - row.releasedSealed;
+  const loose = -row.looseUnitDelta - row.releasedLoose;
+  const gross = row.grossMinor - row.releasedGross;
+  if (units === 0) {
+    if (sealed !== 0 || loose !== 0 || gross !== 0) throw new Error('RESIDUAL_EVIDENCE_INVALID');
+    return { kind: 'ALREADY_RELEASED' as const };
+  }
+  if (sealed < 0 || loose < 0 || gross < 0) throw new Error('RESIDUAL_EVIDENCE_INVALID');
+  const movement = await db.pharmacyStockMovement.create({
+    data: {
+      organizationId: scope.organizationId,
+      branchId: scope.branchId,
+      inventoryLotId: row.inventoryLotId,
+      stockLocationId: row.stockLocationId,
+      kind: 'ADJUSTMENT',
+      disposition: 'AVAILABLE',
+      quantityUnits: units,
+      sealedPackDelta: sealed,
+      looseUnitDelta: loose,
+      actorId: scope.actorId,
+      reason,
+      idempotencyKey: `residual-restoration:${key}`,
+    },
+  });
+  await db.$executeRaw(Prisma.sql`INSERT INTO pharmacy_allocation_residual_restorations
+    (id,"organizationId","branchId","allocationId","stockMovementId","idempotencyKey","actorId",reason,"canonicalUnits","grossMinor")
+    VALUES (${randomUUID()},${scope.organizationId},${scope.branchId},${input.allocationId},${movement.id},${key},${scope.actorId},${reason},${units},${gross})`);
+  return { kind: 'RESTORED' as const, replayed: false as const, stockMovementId: movement.id };
+}
