+test('serializes full reversal against partial release in both lock orders', async () => {
+  for (const first of ['release', 'reverse'] as const) {
+    const f = await cart([100], [2]);
+    const allocation = await tenant((db) =>
+      db.pharmacySaleLineAllocation.findFirstOrThrow({
+        where: { organizationId: org, saleLineId: f.line.id },
+      })
+    );
+    const release = (db: ScopedDb) =>
+      reduceSaleLineQuantity(db, scope, {
+        saleId: f.sale.id,
+        saleLineId: f.line.id,
+        fromQuantity: 2,
+        toQuantity: 1,
+        idempotencyKey: randomUUID(),
+      });
+    const reverse = (db: ScopedDb) =>
+      reverseMovements(db, scope, {
+        movementIds: [allocation.stockMovementId],
+        reason: 'synthetic race',
+        at: new Date(),
+      });
+    let unlock!: () => void, signal!: () => void;
+    const held = new Promise<void>((resolve) => {
+      unlock = resolve;
+    });
+    const ready = new Promise<void>((resolve) => {
+      signal = resolve;
+    });
+    const winner = tenant(async (db) => {
+      await (first === 'release' ? release(db) : reverse(db));
+      signal();
+      await held;
+    });
+    await ready;
+    const loser = tenant(async (db) => {
+      if (first === 'release') await reverse(db);
+      else await release(db);
+    });
+    const observed = loser.then(
+      () => 'finished',
+      () => 'finished'
+    );
+    expect(
+      await Promise.race([
+        observed,
+        new Promise((resolve) => setTimeout(() => resolve('blocked'), 50)),
+      ])
+    ).toBe('blocked');
+    unlock();
+    await winner;
+    await expect(loser).rejects.toThrow(
+      first === 'release'
+        ? /PARTIAL_RELEASE_REQUIRES_RESIDUAL_RESTORATION/
+        : /RELEASE_MOVEMENT_INVALID/
+    );
+  }
+});
