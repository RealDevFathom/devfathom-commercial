+++ b/prisma/migrations/20261106140000_pharmacy_release_reversal_guard/migration.sql
@@ -0,0 +1,23 @@
+-- Full reversals are unsafe once a sale movement has a partial release.
+-- The residual-restoration integration must use linked partial evidence; this
+-- guard intentionally fails closed until that path is present.
+CREATE FUNCTION pharmacy_guard_reversal_after_partial_release() RETURNS trigger LANGUAGE plpgsql AS $$
+DECLARE sale_id TEXT; sale_branch TEXT;
+BEGIN
+ IF NEW."reversesMovementId" IS NULL THEN RETURN NEW; END IF;
+ SELECT l."saleId",l."branchId" INTO sale_id,sale_branch
+ FROM pharmacy_sale_line_allocations a JOIN pharmacy_sale_lines l
+   ON l."organizationId"=a."organizationId" AND l.id=a."saleLineId"
+ WHERE a."organizationId"=NEW."organizationId" AND a."stockMovementId"=NEW."reversesMovementId";
+ IF NOT FOUND THEN RETURN NEW; END IF;
+ PERFORM 1 FROM pharmacy_sales WHERE "organizationId"=NEW."organizationId" AND "branchId"=sale_branch AND id=sale_id FOR UPDATE;
+ IF NOT FOUND THEN RAISE EXCEPTION 'PARTIAL_RELEASE_SALE_NOT_FOUND'; END IF;
+ IF EXISTS(SELECT 1 FROM pharmacy_sale_line_allocations a JOIN pharmacy_allocation_partial_releases r
+   ON r."organizationId"=a."organizationId" AND r."allocationId"=a.id
+   WHERE a."organizationId"=NEW."organizationId" AND a."stockMovementId"=NEW."reversesMovementId") THEN
+   RAISE EXCEPTION 'PARTIAL_RELEASE_REQUIRES_RESIDUAL_RESTORATION';
+ END IF;
+ RETURN NEW;
+END $$;
+CREATE TRIGGER pharmacy_reversal_after_partial_release BEFORE INSERT ON pharmacy_stock_movements
+ FOR EACH ROW EXECUTE FUNCTION pharmacy_guard_reversal_after_partial_release();
