{
  "family": "campaign-dashboard",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512",
  "runtimePlatform": {
    "operatingSystemFamily": "LINUX",
    "cpuArchitecture": "X86_64"
  },
  "executionRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/<EXECUTION_ROLE_NAME>",
  "taskRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/<TASK_ROLE_NAME>",
  "containerDefinitions": [
    {
      "name": "campaign-dashboard",
      "image": "<ACCOUNT_ID>.dkr.ecr.eu-north-1.amazonaws.com/campaign-dashboard:<TAG>",
      "essential": true,
      "user": "10001:10001",
      "portMappings": [
        {
          "containerPort": 8080,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "DASH_USER",
          "value": "ops"
        },
        {
          "name": "DATA_DIR",
          "value": "/data"
        },
        {
          "name": "PORT",
          "value": "8080"
        },
        {
          "name": "TRUST_PROXY",
          "value": "1"
        },
        {
          "name": "AI_DAILY_TOKEN_BUDGET",
          "value": "3000000"
        },
        {
          "name": "AI_ANALYSIS_MIN_INTERVAL",
          "value": "900"
        },
        {
          "name": "AI_CHAT_PER_MIN",
          "value": "6"
        },
        {
          "name": "AI_CHAT_MODEL",
          "value": "claude-opus-5-5"
        },
        {
          "name": "AI_CHAT_EFFORT",
          "value": "medium"
        },
        {
          "name": "AI_ANALYSIS_MODEL",
          "value": "claude-opus-5-5"
        },
        {
          "name": "AI_ANALYSIS_EFFORT",
          "value": "high"
        }
      ],
      "secrets": [
        {
          "name": "DASH_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:eu-north-1:<ACCOUNT_ID>:secret:<DASH_PASSWORD_SECRET_NAME>"
        },
        {
          "name": "INGEST_TOKEN",
          "valueFrom": "arn:aws:secretsmanager:eu-north-1:<ACCOUNT_ID>:secret:<INGEST_TOKEN_SECRET_NAME>"
        },
        {
          "name": "ANTHROPIC_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:eu-north-1:<ACCOUNT_ID>:secret:<ANTHROPIC_API_KEY_SECRET_NAME>"
        }
      ],
      "healthCheck": {
        "command": [
          "CMD",
          "python",
          "-c",
          "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8080/healthz', timeout=4).read()==b'ok' else 1)"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 10
      },
      "linuxParameters": {
        "initProcessEnabled": true
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/campaign-dashboard",
          "awslogs-region": "eu-north-1",
          "awslogs-stream-prefix": "dash",
          "awslogs-create-group": "true"
        }
      }
    }
  ]
}
