# /etc/ops-collector.env  (worker)  — chmod 600, owned by root. Placeholders only.
DASH_URL=https://ops-dashboard.example.invalid
INGEST_TOKEN=replace-with-ingest-token-from-secrets-manager

# ~/.config/ops-box-collector.env  (ops box) also uses:
# DASH_URL=https://ops-dashboard.example.invalid
# INGEST_TOKEN=replace-with-ingest-token-from-secrets-manager
# WORKER_INSTANCE_ID=i-0123456789abcdef0
# AWS_REGION=eu-north-1
# GH_REPO=RealDevFathom/devfathom-commercial
# LINEAR_API_KEY=            # optional; leave unset to skip Linear
