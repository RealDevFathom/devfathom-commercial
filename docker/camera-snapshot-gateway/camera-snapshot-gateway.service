# DEV-745 camera snapshot gateway — EXAMPLE unit; the owner reviews before install.
#
# Install: copy server.mjs to /opt/devfathom/camera-snapshot-gateway/server.mjs and
# config.json, tls.crt, tls.key to /etc/devfathom-snapshot/ owned root:devfathom-snapshot,
# mode 0640 (directory 0750). The static group `devfathom-snapshot` (groupadd --system)
# lets the dynamic user read them; nothing there is world-readable. Then
#   systemctl daemon-reload && systemctl enable --now camera-snapshot-gateway
#
# Alternative: LoadCredential=config.json:/etc/devfathom-snapshot/config.json (etc.) and
# point SNAPSHOT_GATEWAY_CONFIG and the config's tls paths at
# /run/credentials/camera-snapshot-gateway.service/.

[Unit]
Description=DevFathom camera snapshot gateway (PNG stills from loopback MediaMTX RTSP)
After=network-online.target mediamtx.service
Wants=network-online.target
# Never stop retrying after a crash loop (RestartSec below paces restarts).
StartLimitIntervalSec=0

[Service]
Type=simple
Environment=SNAPSHOT_GATEWAY_CONFIG=/etc/devfathom-snapshot/config.json
ExecStart=/usr/bin/node /opt/devfathom/camera-snapshot-gateway/server.mjs
Restart=on-failure
RestartSec=5s

DynamicUser=yes
SupplementaryGroups=devfathom-snapshot
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
UMask=0077
ReadOnlyPaths=/etc/devfathom-snapshot /opt/devfathom/camera-snapshot-gateway
# ffmpeg's argv carries the MediaMTX reader credential. ProtectProc= would only
# hide OTHER processes from this service, not this service from other users, so
# it is deliberately NOT set: the service must see the host's /proc and refuses
# to start (PROC_HIDEPID_REQUIRED) unless the host mounts /proc with
# hidepid=invisible (or 2/noaccess). See README "Host /proc".
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
MemoryMax=512M
TasksMax=64
# Network: loopback (MediaMTX RTSP) and the DevFathom app's egress only. This
# enforces "never contact the DVR" even if an ffmpeg decoder were compromised.
# REPLACE 10.0.0.0/32 with the app egress address(es) before installing.
IPAddressDeny=any
IPAddressAllow=127.0.0.1 ::1 10.0.0.0/32
# MemoryDenyWriteExecute is intentionally omitted: ffmpeg's codecs (and Node's
# JIT) need writable+executable memory.
# The listen port must be >1024 (no CAP_NET_BIND_SERVICE is granted).

[Install]
WantedBy=multi-user.target
