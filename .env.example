# =============================================================================
# DevFathom Hub — environment template
# -----------------------------------------------------------------------------
# Copy to `.env` and fill in REAL values locally. NEVER commit `.env`.
# In production, set these in your platform's secret manager (e.g. Vercel
# Environment Variables) — not in a file on disk.
#
# SECURITY: Treat every value you fill in as a credential. If a value is ever
# pasted into a chat, a log, a screenshot, a ticket, or a shared file, ROTATE it.
#
# This file lists variable NAMES and placeholders only — no real values.
# Full catalogue (consumer + failure behavior): docs/reference/ENVIRONMENT-VARIABLES.md
# =============================================================================

# --- Database (PostgreSQL) --------------------------------------------------
# Required. SQLAlchemy async PostgreSQL. Rotate by resetting the DB role password.
DATABASE_URL="REPLACE_WITH_POSTGRES_URL"

# --- FastAPI session signing secret -----------------------------------------
# Required in production. Generate with:
#   openssl rand -base64 33
# Rotating this invalidates all existing sessions (forces re-login).
AUTH_SECRET="REPLACE_WITH_OPENSSL_RAND_BASE64_33"

# --- Ably (managed realtime: chat, typing, presence) ------------------------
# Server-side only. Without it, the token route returns 503 and realtime is off
# (the rest of the app still works). Rotate in the Ably dashboard.
ABLY_API_KEY="REPLACE_ME"

# Production private object storage. If unset outside production, uploads use
# PRIVATE_UPLOAD_DIR and are still delivered only through signed, auth-gated URLs.
BLOB_READ_WRITE_TOKEN=""
PRIVATE_UPLOAD_DIR="private-uploads"

# --- Google Gemini (AI assistant) -------------------------------------------
# Used server-side by FastAPI for Gemini streaming/function calling. Without it,
# /api/assistant returns 503 and the rest of the workspace remains available.
GOOGLE_GENERATIVE_AI_API_KEY="REPLACE_ME"
GEMINI_MODEL="gemini-2.5-flash"   # optional; this is the default

# --- 8x8 JaaS (embedded video meetings) -------------------------------------
# The historical variable name is retained for deployment compatibility, but
# FastAPI reads all three values server-side. Missing any disables video calls.
NEXT_PUBLIC_JAAS_APP_ID=""
JAAS_KID=""
JAAS_PRIVATE_KEY=""   # RSA PEM; \n-escaped newlines are supported

# --- Brevo (transactional email) --------------------------------------------
# Server-side only. Rotate in the Brevo dashboard (SMTP & API > API Keys).
BREVO_API_KEY="REPLACE_ME"
BREVO_SENDER_EMAIL="noreply@example.com"   # must be a verified sender/domain
BREVO_SENDER_NAME="DevFathom"              # optional; defaults to "DevFathom"

# --- Nuxt + FastAPI ---------------------------------------------------------
# NUXT_PUBLIC_API_BASE is embedded into the browser bundle and must be public.
NUXT_PUBLIC_API_BASE="http://localhost:8000"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
ENVIRONMENT="development"
ACCESS_TOKEN_MINUTES="10080"
APP_URL="http://localhost:3000"

# --- Connected-mailbox OAuth -------------------------------------------------
# Optional. Leaving these unset keeps the matching connect button disabled.
# FastAPI uses encrypted, user-bound, 10-minute OAuth state, PKCE, and provider
# profile APIs for mailbox identity (it never trusts an unverified ID token).
#
# EMAIL_TOKEN_ENC_KEY: AES-256-GCM key (32+ chars) encrypting mailbox refresh
# tokens at rest. Generate with: openssl rand -base64 32. Rotating it orphans
# every stored mailbox token.
EMAIL_TOKEN_ENC_KEY=""
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:3000/email/oauth/callback"
MS_OAUTH_CLIENT_ID=""
MS_OAUTH_CLIENT_SECRET=""
MS_OAUTH_REDIRECT_URI="http://localhost:3000/email/oauth/callback"
MS_OAUTH_TENANT="common"

# =============================================================================
# LEGACY — do not use. Kept here only to document that they are dead.
# Realtime is Ably (not Socket.IO); the assistant is Gemini (not Groq). These
# names are referenced by no reachable app code and should be removed from any
# deployment environment. See docs/reference/ENVIRONMENT-VARIABLES.md.
#   NEXT_PUBLIC_SOCKET_URL, FRONTEND_URL, SOCKET_PORT   (Socket.IO)
#   GROQ_API_KEY, GROQ_MODEL                             (Groq; local eval scripts only)
#   ADMIN_EMAIL, ADMIN_PASSWORD, ADMIN_NAME, ADMIN_TITLE,
#   ADMIN_DEPARTMENT, SEED_PASSWORD                      (inactive Prisma scripts)
# =============================================================================
