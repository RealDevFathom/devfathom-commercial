# Core database and authentication
# DATABASE_URL is the running app. It must be NOSUPERUSER and NOBYPASSRLS.
# Production startup (next start) refuses either attribute. bun run dev does not.
# Create the role with the statements in docs/LOCAL_SETUP.md, then grant DML.
DATABASE_URL=postgresql://devfathom_app:replace-with-local-app-password@localhost:5432/devfathom
# Migrations, extension setup, and seed. Prisma CLI prefers this URL.
# The running server never reads it. A local superuser is fine here.
# Seed inserts through RLS and selects MIGRATION_DATABASE_URL when set.
# Keep DATABASE_URL on the restricted application role; run bun run db:seed.
MIGRATION_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/devfathom
# Extension preparation only (prisma/prepare-extensions.ts), before migrations.
# Use an extension object owner, a superuser, or a role with explicit SET
# privilege on every extension object owner; this is not the running app role.
EXTENSION_ADMIN_DATABASE_URL=postgresql://postgres:replace-with-local-extension-admin-password@localhost:5432/devfathom
SHADOW_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/devfathom_shadow
AUTH_SECRET=replace-with-at-least-32-random-bytes
AUTH_URL=http://devfathom.localhost:3000
NEXT_PUBLIC_APP_URL=http://devfathom.localhost:3000

# Platform control plane
PLATFORM_BASE_DOMAIN=localhost
PLATFORM_ENCRYPTION_KEY=replace-with-32-byte-base64-or-64-character-hex-key
CAMERA_CREDENTIAL_KEY=replace-with-32-byte-base64-key
PLATFORM_ADMIN_EMAIL=platform-admin@example.com
PLATFORM_ADMIN_PASSWORD=replace-with-a-strong-bootstrap-password
CRON_SECRET=replace-with-a-long-random-cron-secret

# Seed/bootstrap only
DEFAULT_ORGANIZATION_ID=org_devfathom
SEED_PASSWORD=replace-with-a-local-seed-password
ADMIN_NAME=Workspace Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-bootstrap-password
ADMIN_DEPARTMENT=LEADERSHIP
ADMIN_TITLE=Administrator

# Vercel shared/dedicated provisioning
VERCEL_ACCESS_TOKEN=
VERCEL_TEAM_ID=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
VERCEL_REGION=sin1
VERCEL_GIT_REPO_ORG=
VERCEL_GIT_REPO_NAME=
VERCEL_GIT_REPO_REF=main
BLOB_READ_WRITE_TOKEN=

# HMAC secret for rate-limit bucket keys. Raw client addresses and emails are not stored.
# Production refuses to start when this and AUTH_SECRET are both unset.
# Development and test fall back to an ephemeral process secret.
RATE_LIMIT_HMAC_SECRET=

# Client address used by rate limits. Production startup refuses to run until one
# of these is set. A blank value does not count.
# CLIENT_IP_HEADER is a header the edge overwrites (for example cf-connecting-ip).
# A comma-separated value uses the rightmost address.
# TRUSTED_PROXY_CIDRS walks X-Forwarded-For from the right and skips those proxies.
# The closest hop must be trusted; otherwise the header is ignored.
# IPv4 entries must be plain IPv4 (for example 10.0.0.0/8). ::ffff: addresses are
# unwrapped to IPv4 before the trust check, so a mapped form in this list does not match.
# TRUSTED_PROXY_HOPS is how many rightmost X-Forwarded-For entries a proxy appended.
# Development and test keep working with all three unset: they use a single
# X-Forwarded-For address (the socket address Next copies in when the client did
# not send one). A multi-hop list stays ignored.
CLIENT_IP_HEADER=
TRUSTED_PROXY_CIDRS=
TRUSTED_PROXY_HOPS=

# Optional application integrations
ABLY_API_KEY=
RESEND_API_KEY=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
# Current provider rates as decimal strings; no application-default prices are assumed.
# Example shape: {"currency":"PKR","rates":{"MARKETING":"<current-rate>","UTILITY":"<current-rate>"}}
PHARMACY_WHATSAPP_RATE_CARD=
# Pharmacy WhatsApp. Keep provider=mock until the sender, credentials and approved templates exist.
PHARMACY_WHATSAPP_PROVIDER=mock
# Live Meta sends stay disabled until the owner approves; only the exact value "approved" enables them.
PHARMACY_WHATSAPP_LIVE_SEND=
PHARMACY_WHATSAPP_ORGANIZATION_ID=
PHARMACY_WHATSAPP_PHONE_NUMBER_ID=
# WhatsApp Business Account id whose account_update / quality webhooks alert owners and auto-pause marketing.
PHARMACY_WHATSAPP_BUSINESS_ACCOUNT_ID=
# Optional https link shown to owners for reviewing or appealing a strike; defaults to Meta Business Support.
PHARMACY_WHATSAPP_APPEAL_URL=
# Server-only Meta access token; leave unset for mock sending.
PHARMACY_WHATSAPP_ACCESS_TOKEN=
PHARMACY_WHATSAPP_TEMPLATE_REFILL_REMINDER=
PHARMACY_WHATSAPP_TEMPLATE_LANGUAGE=en
# Approved Khata names are language-specific. Placeholder order accepts only name,balance or balance,name.
PHARMACY_WHATSAPP_TEMPLATE_KHATA_REMINDER_EN=
PHARMACY_WHATSAPP_TEMPLATE_KHATA_REMINDER_EN_PARAMETERS=name,balance
PHARMACY_WHATSAPP_TEMPLATE_KHATA_REMINDER_UR=
PHARMACY_WHATSAPP_TEMPLATE_KHATA_REMINDER_UR_PARAMETERS=
# Pharmacy SMS utility fallback (refill/order-ready/khata only). Gateway adapter is chosen later; only mock exists.
PHARMACY_SMS_PROVIDER=mock
# DRAP recall-alert page fetch (DEV-692). Off unless exactly "true"; operations enable it once
# outbound access to www.dra.gov.pk is approved. Alerts land in a review queue; nothing is recalled
# or quarantined until a person confirms. Optional URL override must be https on dra.gov.pk.
PHARMACY_DRAP_RECALL_FEED_ENABLED=
PHARMACY_DRAP_RECALL_FEED_URL=
PHARMACY_SMS_ORGANIZATION_ID=
# HMAC secret for inbound STOP/START callbacks (X-Sms-Signature: sha256=<hex>).
PHARMACY_SMS_WEBHOOK_SECRET=
EMAIL_DELIVERY_MODE=send
EMAIL_SERVER_HOST=
EMAIL_TOKEN_ENC_KEY=
EMAIL_LOGO_URL=
EDGE_CONFIG=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
MS_OAUTH_CLIENT_ID=
MS_OAUTH_CLIENT_SECRET=
MS_OAUTH_REDIRECT_URI=
MS_OAUTH_TENANT=
# AI providers: docs/ai-providers.md. Empty = off. auto = routed chain (Anthropic, OpenAI, Bedrock).
# anthropic | openai | bedrock put that provider first; disabled is a hard off.
# Legacy, explicit only (never a default or a fallback): groq | google | vertex.
AI_PROVIDER=
# Fallback order of the routed chain.
AI_PROVIDER_ORDER=anthropic,openai,bedrock
# Deployed environments: names of the AWS Secrets Manager secrets that hold the keys, read at
# runtime through the instance/task role. Key values never go in env files.
ANTHROPIC_API_KEY_SECRET_ID=
OPENAI_API_KEY_SECRET_ID=
AI_SECRETS_REGION=ap-southeast-1
# Local development only; ignored when NODE_ENV=production. Never commit a real key.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Bedrock: the AWS default credential chain, no static keys. Setting the region enables it.
# Deployed environments use ap-southeast-1 with the global inference profiles:
# BEDROCK_REGION=ap-southeast-1
BEDROCK_REGION=
# Ask Fathom quick lookups on the small model. Off (false) until it passes evaluation.
AF_HAIKU_LOOKUPS=false
# Optional model per provider and tier: AI_<ANTHROPIC|OPENAI|BEDROCK>_MODEL_<CHEAP|STANDARD|DEEP>.
# AI_BEDROCK_MODEL_STANDARD=global.anthropic.claude-sonnet-5-5
# Optional monthly spend caps in USD (Asia/Karachi month). Defaults: 190, 190, 300.
# AI_ANTHROPIC_MONTHLY_CAP_USD=190
# AI_OPENAI_MONTHLY_CAP_USD=190
# AI_BEDROCK_MONTHLY_CAP_USD=300
# Legacy selectors only: the provider-specific model ID (no runtime default). Routed providers ignore it.
AI_MODEL=
GROQ_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_VERTEX_API_KEY=
GOOGLE_VERTEX_PROJECT=
GOOGLE_VERTEX_LOCATION=

# Uploads are disabled unless an adapter is explicitly configured.
# Production example: STORAGE_ADAPTER=s3, S3_UPLOADS_BUCKET=<private-bucket>, AWS_REGION=<region>.
STORAGE_ADAPTER=disabled
# Required S3 uploads bucket when STORAGE_ADAPTER=s3; credentials come from the runtime role.
S3_UPLOADS_BUCKET=
# Required bucket region when STORAGE_ADAPTER=s3.
AWS_REGION=
# Local storage is permitted only in test/development. Optional absolute directory
# outside public; when unset it defaults to <process.cwd()>/private-uploads.
# LOCAL_UPLOADS_DIR=/absolute/shared/private-uploads
# Self-hosted LiveKit. Public URL is fixed at build time; credentials remain server-only.
NEXT_PUBLIC_LIVEKIT_URL=wss://livekit.example.com
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Additional runtime and operator settings (leave unset unless needed)
# Platform role MFA is enforced unless exactly false; keep enforcement enabled in production.
PLATFORM_MFA_ENFORCE=
# Auth.js host trust override; enable only behind a trusted host/proxy boundary.
AUTH_TRUST_HOST=
# Legacy AUTH_URL fallback in src/lib/email/theme.ts and src/lib/demo/deployment-origin.ts.
NEXTAUTH_URL=
# Comma-separated additional shared application hosts for tenant routing.
SHARED_APP_HOSTS=
# Nonblank access code enables passwordless demo access; keep private.
DEMO_ACCESS_CODE=
# Demo seat count (1–25, default 5); leave commented for default; seeding rejects blank.
# DEMO_SEATS=5
# Absolute capture file path, used only with EMAIL_DELIVERY_MODE=capture.
EMAIL_CAPTURE_FILE=
# Local harness only: exact true, localhost/127.0.0.1:55625, wha1364_business_disposable_20261008[_suffix]; never production.
PHARMACY_PAYMENT_SANDBOX_ADMITTED=
# Shared HMAC secret for timestamped restaurant terminal payment webhooks; missing fails closed.
RESTAURANT_TERMINAL_WEBHOOK_SECRET=
# Unset disables cameras; simulated is dev/test only; mediamtx requires bindings.
# CAMERA_MEDIAMTX_BINDINGS is a server-only JSON secret; pharmacy entries need "vertical": "pharmacy".
CAMERA_GATEWAY_MODE=
# Runtime-role target URL for prisma/prepare-runtime-role.ts; server still uses DATABASE_URL.
APP_DATABASE_URL=
# Tenant target for admin scripts (unset defaults to org_devfathom); required by prisma/production-bootstrap.ts.
# ORGANIZATION_ID=org_devfathom

# Print bridge — scripts/print-bridge.ts runs on the till PC, not the application server.
# HTTPS application URL without credentials, query or fragment.
PRINT_BRIDGE_BASE_URL=
# Short-lived enrollment code for obtaining a dedicated bridge device token.
PRINT_BRIDGE_ENROLLMENT_CODE=
# One allowlisted printer ID for --dry-run only.
PRINT_BRIDGE_PRINTER_ID=
# Required JSON array of exact allowed printer IDs (1–100).
PRINT_BRIDGE_PRINTER_IDS=
# Required persistent absolute private directory; preserve across restarts.
PRINT_BRIDGE_STATE_DIR=
# Dedicated device token injected securely; alternative to token-file enrollment.
PRINT_BRIDGE_TOKEN=
# Absolute owner-only token file on supported POSIX hosts; new file for enrollment.
PRINT_BRIDGE_TOKEN_FILE=

# Dedicated disposable migrated test DB; test:rls never falls back to DATABASE_URL.
TEST_DATABASE_URL=
# Test/e2e settings (TEST_DATABASE_URL, *_TEST_*_DATABASE_URL, PLAYWRIGHT_*, *_E2E_*)
# are documented in docs/LOCAL_SETUP.md and are not exhaustively listed here.
# Empty entries are placeholders: omit optional variables where the consumer needs them unset.
