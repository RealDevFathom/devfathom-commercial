# Core database and authentication
# DATABASE_URL is the running app. It must be NOSUPERUSER and NOBYPASSRLS.
# Production startup (next start) refuses either attribute. bun run dev does not.
# Create the role with the statements in docs/LOCAL_SETUP.md, then grant DML.
DATABASE_URL=postgresql://devfathom_app:replace-with-local-app-password@localhost:5432/devfathom
# Migrations, extension setup, and seed. Prisma CLI prefers this URL.
# The running server never reads it. A local superuser is fine here.
# Seed inserts through RLS, so run it on this URL:
#   DATABASE_URL="$MIGRATION_DATABASE_URL" bun run db:seed
MIGRATION_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/devfathom
SHADOW_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/devfathom_shadow
AUTH_SECRET=replace-with-at-least-32-random-bytes
AUTH_URL=http://devfathom.localhost:3000
NEXT_PUBLIC_APP_URL=http://devfathom.localhost:3000

# Platform control plane
PLATFORM_BASE_DOMAIN=localhost
PLATFORM_ENCRYPTION_KEY=replace-with-32-byte-base64-or-64-character-hex-key
CAMERA_CREDENTIAL_KEY=replace-with-32-byte-base64-key
PLATFORM_ADMIN_EMAIL=platform-admin@example.com
PLATFORM_ADMIN_PASSWORD=replace-with-a-strong-bootstrap-password
CRON_SECRET=replace-with-a-long-random-cron-secret

# Seed/bootstrap only
DEFAULT_ORGANIZATION_ID=org_devfathom
SEED_PASSWORD=replace-with-a-local-seed-password
ADMIN_NAME=Workspace Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-bootstrap-password
ADMIN_DEPARTMENT=LEADERSHIP
ADMIN_TITLE=Administrator

# Vercel shared/dedicated provisioning
VERCEL_ACCESS_TOKEN=
VERCEL_TEAM_ID=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
VERCEL_REGION=sin1
VERCEL_GIT_REPO_ORG=
VERCEL_GIT_REPO_NAME=
VERCEL_GIT_REPO_REF=main
BLOB_READ_WRITE_TOKEN=

# HMAC secret for rate-limit bucket keys. Raw client addresses and emails are not stored.
# Production refuses to start when this and AUTH_SECRET are both unset.
# Development and test fall back to an ephemeral process secret.
RATE_LIMIT_HMAC_SECRET=

# Client address used by rate limits. Production startup refuses to run until one
# of these is set. A blank value does not count.
# CLIENT_IP_HEADER is a header the edge overwrites (for example cf-connecting-ip).
# A comma-separated value uses the rightmost address.
# TRUSTED_PROXY_CIDRS walks X-Forwarded-For from the right and skips those proxies.
# The closest hop must be trusted; otherwise the header is ignored.
# IPv4 entries must be plain IPv4 (for example 10.0.0.0/8). ::ffff: addresses are
# unwrapped to IPv4 before the trust check, so a mapped form in this list does not match.
# TRUSTED_PROXY_HOPS is how many rightmost X-Forwarded-For entries a proxy appended.
# Development and test keep working with all three unset: they use a single
# X-Forwarded-For address (the socket address Next copies in when the client did
# not send one). A multi-hop list stays ignored.
CLIENT_IP_HEADER=
TRUSTED_PROXY_CIDRS=
TRUSTED_PROXY_HOPS=

# Optional application integrations
ABLY_API_KEY=
RESEND_API_KEY=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
EMAIL_DELIVERY_MODE=send
EMAIL_SERVER_HOST=
EMAIL_TOKEN_ENC_KEY=
EMAIL_LOGO_URL=
EDGE_CONFIG=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
MS_OAUTH_CLIENT_ID=
MS_OAUTH_CLIENT_SECRET=
MS_OAUTH_REDIRECT_URI=
MS_OAUTH_TENANT=
# AI provider: azure | groq | google | vertex
AI_PROVIDER=azure
AI_MODEL=ask-fathom-gpt-5-mini
AZURE_OPENAI_RESOURCE_NAME=
GROQ_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_VERTEX_API_KEY=
GOOGLE_VERTEX_PROJECT=
GOOGLE_VERTEX_LOCATION=

# Durable uploads on Azure; unset for local filesystem storage.
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_CONTAINER=uploads
# Self-hosted LiveKit. The URL is public; credentials remain server-only.
NEXT_PUBLIC_LIVEKIT_URL=wss://meet.devfathom.com
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
