# Candidate only: scripts/aws-context.py must admit the composed source first.
# Current accepted source has unresolved imports; see SOURCE_HANDOFF.md.
# Packaging option only; product approval and exact source composition remain pending.
# Linux dependencies are installed here; host node_modules never enters context.
FROM oven/bun:1.4.2-slim AS dependencies
WORKDIR /app
# Existing deployments keep their demo default. Restricted context cannot silently
# switch behavior: explicit production-safe selection is required for this candidate.
ARG AWS_WEB_COMPOSITION=existing-demo
RUN case "$AWS_WEB_COMPOSITION" in \
      production-safe) ;; \
      existing-demo) echo 'Existing demo composition is not supplied by this restricted context' >&2; exit 1 ;; \
      *) echo 'Unsupported AWS web composition' >&2; exit 1 ;; \
    esac
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile --ignore-scripts

FROM node:22-trixie-slim AS builder
WORKDIR /app
ENV NODE_OPTIONS=--max-old-space-size=8192 \
    NEXT_TELEMETRY_DISABLED=1
COPY --from=dependencies /app/node_modules ./node_modules
COPY package.json bun.lock next.config.ts tsconfig.json postcss.config.mjs prisma.config.ts ./
COPY prisma/schema.prisma ./prisma/schema.prisma
COPY scripts/load-local-env.ts ./scripts/load-local-env.ts
COPY src ./src
COPY public ./public
RUN node node_modules/prisma/build/index.js generate \
 && node node_modules/next/dist/bin/next typegen \
 && node node_modules/typescript/bin/tsc --noEmit
ENV NEXT_BUILD_SKIP_TYPECHECK=1
# Inert build-only placeholder; no real environment files or secrets in context.
# NEXT_PUBLIC_* values are inlined into client bundles at build time. Pass per environment,
# e.g. --build-arg NEXT_PUBLIC_APP_URL=https://staging.devfathom.com. Empty keeps the fallback.
ARG NEXT_PUBLIC_APP_URL=
ENV NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL
RUN AUTH_SECRET=container-build-only node node_modules/next/dist/bin/next build

FROM oven/bun:1.4.2-slim AS runner
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    HOSTNAME=0.0.0.0 \
    PORT=3000
# Standalone preserves traced dependencies, including generated Prisma/native files.
# Do not add whole src/scripts/prisma trees or initialization commands here.
COPY --chown=bun:bun --from=builder /app/.next/standalone ./
COPY --chown=bun:bun --from=builder /app/.next/static ./.next/static
COPY --chown=bun:bun --from=builder /app/public ./public
USER bun
EXPOSE 3000
CMD ["bun", "server.js"]
